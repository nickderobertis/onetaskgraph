{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.nx",
      "!**/target",
      "!**/dist",
      "!sdks/typescript/src/generated",
      "!**/.venv",
      "!gh-secrets.json",
      "!scripts/nx-remote-cache.mjs",
      "!scripts/actions-cache-prune.mjs",
      "!scripts/coverage-merge.mjs",
      "!scripts/nx-version-free-inputs.mjs",
      "!crates/onetaskgraph-e2e-support/fixtures/expandable_blocks"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
