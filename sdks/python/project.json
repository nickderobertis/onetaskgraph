{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk-python",
  "projectType": "library",
  "tags": ["lang:python", "layer:sdk", "test-in-coverage:sdk"],
  "implicitDependencies": ["onetaskgraph"],
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash sdks/python/sync.sh"
      },
      "//": "Uncached: it reaches PyPI and writes a .venv outside the cacheable output set. `uv sync --frozen`, leaving the CLI member out where CI asks (sdks/python/sync.sh)."
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "typecheck", "test", "coverage"]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen ruff format .",
        "cwd": "sdks/python"
      },
      "cache": false,
      "//": "Uncached: it rewrites the tree in place."
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen ruff format --check .",
        "cwd": "sdks/python"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen ruff check .",
        "cwd": "sdks/python"
      }
    },
    "generate-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["onetaskgraph:build"],
      "options": {
        "command": "uv run --frozen python generate.py --check",
        "cwd": "sdks/python"
      },
      "//": "The generator executes target/debug/onetaskgraph, which onetaskgraph:build alone may produce; scripts/check-workspace-config.sh holds every spawner to that dependency."
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen ty check",
        "cwd": "sdks/python"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["onetaskgraph:build"],
      "options": {
        "commands": ["uv run --frozen pytest -q --no-cov", "bash check-sync.sh"],
        "parallel": false,
        "cwd": "sdks/python"
      },
      "//": "The tests spawn target/debug/onetaskgraph, on the same terms as generate-check."
    },
    "test-uncovered": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash check-sync.sh",
        "cwd": "sdks/python"
      },
      "cache": false,
      "//": "Uncached: it syncs the lock into a scratch environment, which reads the root workspace's manifests outside this project's inputs. The instrumented pytest run cannot stand in for it on Linux."
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["onetaskgraph:build"],
      "options": {
        "command": "uv run --frozen pytest -q",
        "cwd": "sdks/python"
      },
      "//": "The same tests as `test`, measured."
    }
  }
}
