{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk-typescript",
  "projectType": "library",
  "tags": ["lang:typescript", "layer:sdk"],
  "//": "The generator executes the binary and consumes its emitted schema and command surface.",
  "implicitDependencies": ["onetaskgraph"],
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun install --frozen-lockfile"
      },
      "//": "Uncached: it reaches the npm registry and writes node_modules, which no input in this tree describes."
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "generate-check",
        "build",
        "format-check",
        "lint",
        "typecheck",
        "test",
        "coverage",
        "pack"
      ]
    },
    "generate-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["onetaskgraph:build"],
      "options": {
        "command": "bun run --cwd sdks/typescript generate:check"
      },
      "//": "The generator executes target/debug/onetaskgraph. Depend on the binary's shared build target so this target cannot relink it while Rust integration tests are spawning it."
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "bun run --cwd sdks/typescript build" }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format --write sdks/typescript"
      },
      "cache": false,
      "//": "Uncached: it rewrites the tree in place."
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format sdks/typescript"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome lint --error-on-warnings sdks/typescript"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit -p sdks/typescript/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-check"],
      "options": {
        "command": "bun test",
        "cwd": "sdks/typescript"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-check"],
      "options": {
        "command": "bun test --coverage --coverage-threshold=0.95",
        "cwd": "sdks/typescript"
      }
    },
    "test-live": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test tests/live",
        "cwd": "sdks/typescript"
      },
      "//": "Uncached: a live test reaches a third-party API and reads a credential from the environment, neither of which is an input in this tree."
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "generate-check"],
      "options": { "command": "bash sdks/typescript/scripts/test-packed.sh" }
    }
  }
}
