{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk-typescript",
  "projectType": "library",
  "tags": ["lang:typescript", "layer:sdk", "test-in-coverage:sdk"],
  "//": "The generator executes the binary and consumes its emitted schema and command surface.",
  "implicitDependencies": ["onetaskgraph"],
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun install --frozen-lockfile"
      },
      "//": "Uncached: it reaches the npm registry and writes node_modules, which no input in this tree describes."
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "generate-check",
        "build",
        "format-check",
        "lint",
        "typecheck",
        "test",
        "coverage",
        "pack"
      ]
    },
    "generate-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["onetaskgraph:build"],
      "options": {
        "command": "bun run --cwd sdks/typescript generate:check"
      },
      "//": "The generator executes target/debug/onetaskgraph, which onetaskgraph:build alone may produce; test, coverage and pack reach that build through this target, and scripts/check-workspace-config.sh holds every spawner to it.",
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run --cwd sdks/typescript build"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format --write sdks/typescript"
      },
      "cache": false,
      "//": "Uncached: it rewrites the tree in place."
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format sdks/typescript"
      },
      "inputs": [
        "versionFreeNpm",
        "{workspaceRoot}/.tool-versions",
        "textDefault",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome lint --error-on-warnings sdks/typescript"
      },
      "inputs": [
        "versionFreeNpm",
        "{workspaceRoot}/.tool-versions",
        "textDefault",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit -p sdks/typescript/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-check"],
      "options": {
        "command": "bun scripts/test.ts",
        "cwd": "sdks/typescript"
      },
      "inputs": [
        "versionFreeNpm",
        "{workspaceRoot}/.tool-versions",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem python --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem files --keep-version"
        }
      ]
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-check"],
      "options": {
        "command": "bun scripts/test.ts --coverage --coverage-threshold=0.95",
        "cwd": "sdks/typescript"
      },
      "inputs": [
        "versionFreeNpm",
        "{workspaceRoot}/.tool-versions",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem python --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem files --keep-version"
        }
      ]
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "generate-check"],
      "options": {
        "command": "bash sdks/typescript/scripts/test-packed.sh"
      }
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/package.json",
      "!{projectRoot}/src/index.ts",
      "sharedGlobals",
      "versionFreeNpm",
      "versionFreeFiles"
    ],
    "textDefault": ["{projectRoot}/**/*", "sharedGlobals"]
  }
}
