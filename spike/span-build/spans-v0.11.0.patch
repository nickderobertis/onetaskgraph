diff --git a/crates/onetaskgraph-plugin-api/src/spike_span.rs b/crates/onetaskgraph-plugin-api/src/spike_span.rs
new file mode 100644
index 00000000..54ee499a
--- /dev/null
+++ b/crates/onetaskgraph-plugin-api/src/spike_span.rs
@@ -0,0 +1,105 @@
+//! Timing-only spans for the board-copy-speed spike. Inert unless `SPIKE_SPAN_LOG`
+//! names a file: then each span appends one JSON line with its name, wall-clock start and
+//! end in microseconds since the Unix epoch, and the attributes it was opened with. Nothing
+//! else reads it, and nothing it records is a board's content.
+
+use std::fs::{File, OpenOptions};
+use std::io::Write;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+fn sink() -> Option<&'static Mutex<File>> {
+    static SINK: OnceLock<Option<Mutex<File>>> = OnceLock::new();
+    SINK.get_or_init(|| {
+        let path = std::env::var_os("SPIKE_SPAN_LOG")?;
+        OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+            .ok()
+            .map(Mutex::new)
+    })
+    .as_ref()
+}
+
+fn now_us() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |since| u64::try_from(since.as_micros()).unwrap_or(u64::MAX))
+}
+
+static NEXT: AtomicU64 = AtomicU64::new(1);
+
+/// An open span; it is written when dropped.
+pub struct Span {
+    id: u64,
+    name: &'static str,
+    attrs: Vec<(&'static str, String)>,
+    start: u64,
+}
+
+/// Open a span, or nothing at all when no log is named.
+#[must_use]
+pub fn enter(name: &'static str) -> Option<Span> {
+    sink()?;
+    Some(Span {
+        id: NEXT.fetch_add(1, Ordering::Relaxed),
+        name,
+        attrs: Vec::new(),
+        start: now_us(),
+    })
+}
+
+/// Open a span carrying attributes.
+#[must_use]
+pub fn enter_with(name: &'static str, attrs: &[(&'static str, &str)]) -> Option<Span> {
+    let mut span = enter(name)?;
+    span.attrs = attrs.iter().map(|(k, v)| (*k, (*v).to_owned())).collect();
+    Some(span)
+}
+
+/// Add an attribute to a span already open.
+pub fn attr(span: &mut Option<Span>, key: &'static str, value: &str) {
+    if let Some(span) = span {
+        span.attrs.push((key, value.to_owned()));
+    }
+}
+
+/// The operation name a GraphQL document declares, or `anonymous`.
+#[must_use]
+pub fn operation(document: &str) -> String {
+    let mut words = document
+        .split(|c: char| c.is_whitespace() || c == '(' || c == '{')
+        .filter(|word| !word.is_empty());
+    while let Some(word) = words.next() {
+        if word == "query" || word == "mutation" {
+            return words
+                .next()
+                .map_or_else(|| "anonymous".to_owned(), str::to_owned);
+        }
+    }
+    "anonymous".to_owned()
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        let Some(sink) = sink() else { return };
+        let end = now_us();
+        let attrs: serde_json::Map<String, serde_json::Value> = self
+            .attrs
+            .iter()
+            .map(|(k, v)| ((*k).to_owned(), serde_json::Value::String(v.clone())))
+            .collect();
+        let line = serde_json::json!({
+            "id": self.id,
+            "span": self.name,
+            "start_us": self.start,
+            "end_us": end,
+            "attrs": attrs,
+        });
+        if let Ok(mut file) = sink.lock() {
+            let _ = writeln!(file, "{line}");
+        }
+    }
+}
