#!/usr/bin/env bash
# Run the complete gate before anything leaves this machine.
#
# The six required checks on main are the only thing that can refuse a merge to this
# repository, and each of them costs CI minutes and wall-clock. This catches what they
# would catch, locally, before the push. `just bootstrap` activates it by pointing
# core.hooksPath here.
#
# It runs `just gate`, which SELECTS against the commit the remote already has rather than
# sweeping every project. A sweep here ran the `test` target of every plugin whatever the
# push contained, and two of those targets reach a real API at a fifth of the account's
# hourly GraphQL allowance apiece. scripts/pre-push-base.sh reads that commit out of the
# records git feeds this hook on stdin, so the base is derived rather than guessed — an
# implicit base is how affected selection quietly starts comparing against the wrong
# commit. The supply-chain and distribution stages stay outside selection and still run.
#
# Provisioning comes first, and its refusal is deliberately not spelled like the gate's.
# A fresh worktree has no node_modules and no synced Python environment, so a hook that
# went straight to `just gate` reported an unprovisioned machine as "the gate failed" —
# which reads as this push being rejected for what it contains. It is not: nothing has
# been checked yet. scripts/provision-gate.sh heals what this worktree can heal and names
# what only the machine can supply, and the two refusals below say which happened.
set -euo pipefail

readonly ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v just >/dev/null 2>&1; then
  echo "pre-push: just is not installed, so the gate cannot run." >&2
  echo "pre-push: nothing about this push has been checked — this is a provisioning" >&2
  echo "pre-push: refusal, not a rejection of what you are pushing." >&2
  echo "pre-push: install it (scripts/session-setup.sh does), then push again." >&2
  exit 1
fi

if ! bash scripts/provision-gate.sh; then
  echo "pre-push: this worktree is not provisioned, so the gate did not run." >&2
  echo "pre-push: nothing about this push has been checked — the message above names what" >&2
  echo "pre-push: is missing. Provision it and push again." >&2
  exit 1
fi

# git feeds the ref records on stdin, and this is the only reader of them; `just gate`
# below inherits a stdin that has been consumed, which is what it expects. A base that
# could not be derived comes back empty and leaves NX_BASE unset, so Nx falls back to its
# own defaultBase rather than the push being refused for it.
base="$(bash scripts/pre-push-base.sh)" || base=""
if [ -n "$base" ]; then
  export NX_BASE="$base"
  echo "pre-push: checking what this push adds since $base" >&2
fi

echo "pre-push: running the complete gate (just gate)" >&2
if ! just gate; then
  echo "pre-push: the gate failed — see the output above." >&2
  echo "pre-push: fix it and push again. Bypassing this hook pushes work nothing has" >&2
  echo "pre-push: checked, and the required checks on main will refuse it anyway." >&2
  exit 1
fi
