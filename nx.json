{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/deny.toml",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock"
    ]
  },
  "targetDefaults": {
    "check": {
      "dependsOn": ["format-check", "lint", "typecheck", "test", "coverage"],
      "cache": false
    },
    "format-check": {
      "inputs": [
        "default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "typecheck": {
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "coverage": {
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "test-uncovered": {
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "bootstrap": {
      "cache": false
    }
  },
  "plugins": ["./scripts/nx-remote-cache.mjs"]
}
