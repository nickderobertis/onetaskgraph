{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/deny.toml",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock"
    ]
  },
  "targetDefaults": {
    "check": {
      "dependsOn": ["format-check", "lint", "typecheck", "test", "coverage"],
      "cache": false
    },
    "format-check": { "inputs": ["default"], "cache": true },
    "lint": { "inputs": ["default", "^default"], "cache": true },
    "typecheck": { "inputs": ["default", "^default"], "cache": true },
    "test": { "inputs": ["default", "^default"], "cache": true },
    "coverage": { "inputs": ["default", "^default"], "cache": true },
    "bootstrap": { "cache": false }
  }
}
