{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/Cargo.toml",
      "!{projectRoot}/CHANGELOG.md",
      "sharedGlobals",
      "cargoInputs"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.python-version",
      "{workspaceRoot}/.tool-versions",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/deny.toml",
      "{workspaceRoot}/biome.json",
      "versionFreeNpm"
    ],
    "cargoInputs": [],
    "versionFreeCargo": [
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo"
      }
    ],
    "versionFreeNpm": [
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm"
      }
    ],
    "versionFreePython": [
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem python"
      }
    ],
    "versionFreeFiles": [
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem files"
      }
    ],
    "selectionGlobals": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/deny.toml",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/.python-version",
      "{workspaceRoot}/.tool-versions"
    ]
  },
  "targetDefaults": {
    "check": {
      "dependsOn": ["format-check", "lint", "typecheck", "test", "coverage"],
      "cache": false,
      "inputs": ["selectionGlobals"]
    },
    "format-check": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "lint": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "typecheck": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "test": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "coverage": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "test-uncovered": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "bootstrap": {
      "cache": false
    }
  },
  "plugins": ["./scripts/nx-remote-cache.mjs"]
}
