{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/Cargo.toml",
      "!{projectRoot}/CHANGELOG.md",
      "sharedGlobals",
      "cargoInputs"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.python-version",
      "{workspaceRoot}/.tool-versions",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/deny.toml",
      "{workspaceRoot}/biome.json",
      "versionFreeNpm"
    ],
    "cargoInputs": [],
    "versionFreeCargo": [
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo"
      }
    ],
    "versionFreeNpm": [
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm"
      }
    ],
    "versionFreePython": [
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem python"
      }
    ],
    "versionFreeFiles": [
      {
        "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem files"
      }
    ],
    "selectionGlobals": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/deny.toml",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/.python-version",
      "{workspaceRoot}/.tool-versions"
    ],
    "coverageDependency": ["{projectRoot}/src/**/*", "{projectRoot}/build.rs"],
    "coverageUnit": [
      "{workspaceRoot}/scripts/coverage-unit.sh",
      "{workspaceRoot}/scripts/coverage-merge.mjs",
      "{workspaceRoot}/scripts/rust-coverage.sh",
      {
        "env": "ONETASKGRAPH_TESTS_UNDER_COVERAGE"
      },
      {
        "env": "COVERAGE_UNIT_IGNORE_REGEX"
      },
      {
        "env": "LLVM_PROFDATA"
      },
      {
        "env": "LLVM_COV"
      },
      {
        "runtime": "node -p process.platform"
      },
      {
        "runtime": "bash scripts/coverage-unit.sh --tool-version rustc"
      },
      {
        "runtime": "bash scripts/coverage-unit.sh --tool-version cargo-llvm-cov"
      },
      {
        "runtime": "bash scripts/coverage-unit.sh --tool-version cargo-nextest"
      },
      {
        "runtime": "bash scripts/coverage-unit.sh --tool-version llvm-profdata"
      },
      {
        "runtime": "bash scripts/coverage-unit.sh --tool-version llvm-cov"
      },
      {
        "runtime": "bash scripts/coverage-unit.sh --tool-version llvm-readobj"
      }
    ],
    "coverageSdkSources": [
      "{workspaceRoot}/sdks/python/src/**/*",
      "{workspaceRoot}/sdks/typescript/src/**/*",
      "!{workspaceRoot}/sdks/python/src/onetaskgraph_sdk/__init__.py",
      "!{workspaceRoot}/sdks/typescript/src/index.ts",
      "versionFreePython",
      "versionFreeFiles"
    ]
  },
  "targetDefaults": {
    "check": {
      "dependsOn": ["format-check", "lint", "typecheck", "test", "coverage"],
      "cache": false,
      "inputs": ["selectionGlobals"]
    },
    "format-check": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "lint": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "typecheck": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "test": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "coverage": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "test-uncovered": {
      "inputs": [
        "{workspaceRoot}/.tool-versions",
        "versionFreeNpm",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "bootstrap": {
      "cache": false
    }
  },
  "plugins": ["./scripts/nx-remote-cache.mjs"]
}
