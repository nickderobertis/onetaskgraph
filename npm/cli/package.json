{
  "name": "@onetaskgraph/cli",
  "version": "0.2.0",
  "description": "Platform-selecting launcher for onetaskgraph",
  "x-exit-codes": {
    "64": "unsupported platform",
    "69": "carrier unavailable or could not execute",
    "70": "carrier terminated by signal"
  },
  "license": "MIT",
  "bin": {
    "onetaskgraph": "bin/onetaskgraph.js"
  },
  "files": [
    "bin"
  ],
  "optionalDependencies": {
    "@onetaskgraph/cli-linux-x64": "0.2.0",
    "@onetaskgraph/cli-linux-arm64": "0.2.0",
    "@onetaskgraph/cli-darwin-x64": "0.2.0",
    "@onetaskgraph/cli-darwin-arm64": "0.2.0",
    "@onetaskgraph/cli-win32-x64": "0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
