,filter:$filter){ nodes{ title } } }\",\n+                json!({ \"filter\": filter }),\n+                \"live comparator probe\",\n+            )\n+            .await?;\n         let mut titles = data\n             .pointer(\"/issues/nodes\")\n             .and_then(Value::as_array)\n@@ -1363,14 +1425,23 @@ async fn drive_documents(\n         location: None,\n         created_at: None,\n         updated_at: None,\n-        metadata: [(\"caller.count\".to_owned(), json!(3))]\n-            .into_iter()\n-            .collect(),\n+        metadata: [\n+            (\"caller.count\".to_owned(), json!(3)),\n+            (\"caller.run\".to_owned(), json!(run.stamp_micros)),\n+        ]\n+        .into_iter()\n+        .collect(),\n         repositories: vec![],\n         classification: Default::default(),\n     };\n     let write = |item: Document| ItemWrite {\n-        target: None,\n+        target: if item.title == filed {\n+            run.standing.ids.get(\"filed\")\n+        } else {\n+            run.standing.ids.get(\"loose\")\n+        }\n+        .cloned()\n+        .map(NativeId),\n         item,\n         depends_on: vec![],\n     };\n@@ -1405,6 +1476,11 @@ async fn drive_documents(\n         \"a caller's key did not round-trip with its JSON type: {:?}\",\n         read.metadata\n     );\n+    ensure!(\n+        read.metadata.get(\"caller.run\") == Some(&json!(run.stamp_micros)),\n+        \"the retained document did not reset caller.run to this invocation: {:?}\",\n+        read.metadata.get(\"caller.run\")\n+    );\n     ensure!(\n         read.labels.is_empty(),\n         \"Linear's own document type has no labels, so a read reports none: {:?}\",\n@@ -1499,7 +1575,10 @@ async fn drive_documents(\n \n     // And removed again, which is what lets a copy that could not finish take one back.\n     // The sweep would clear them anyway; driving the verb is what proves it works.\n-    for (id, title) in [(&filed_id, filed), (&loose_id, loose)] {\n+    for (id, title) in [(&filed_id, filed), (&loose_id, loose)]\n+        .into_iter()\n+        .filter(|_| run.document_mode == Mode::Fresh)\n+    {\n         source\n             .delete_document(id)\n             .await\n@@ -1562,6 +1641,39 @@ async fn real_linear_applies_every_declared_capability_and_leaves_no_residue() {\n     let session = Session::open(SESSION_NAME, key, Exclusivity::OneAtATime)\n         .unwrap_or_else(|declined| declined.refuse());\n     let key = session.credential().expose().to_owned();\n+    let document_mode = Mode::read().unwrap_or_else(|e| panic!(\"{e}\"));\n+    let owner = Run::current();\n+    let stamp = onetaskgraph_live::artifact::Stamp::new(owner, now_micros()).to_string();\n+    let team_key = team.to_ascii_uppercase();\n+    let ci = env::var(\"GITHUB_ACTIONS\").as_deref() == Ok(\"true\");\n+    let scope = if ci {\n+        Scope::ci(&team_key).unwrap()\n+    } else {\n+        Scope::local(&team_key, &stamp).unwrap()\n+    };\n+    let effective_mode = document_mode;\n+    if !ci && document_mode == Mode::Initialize {\n+        eprintln!(\n+            \"non-CI creation pass: initialize invocation-owned plugin document slots, exercise reuse assertions, and retire the set\"\n+        );\n+    }\n+    let journal = document_lifecycle::journal::Journal::new(\"plugin\", effective_mode.name())\n+        .durable(\n+            std::env::current_exe()\n+                .unwrap()\n+                .parent()\n+                .unwrap()\n+                .parent()\n+                .unwrap()\n+                .join(\"telemetry/onetaskgraph-linear/live\")\n+                .join(&stamp),\n+        )\n+        .unwrap();\n+    let endpoint = document_lifecycle::observer::start(\n+        \"https://api.linear.app/graphql\",\n+        &key,\n+        journal.clone(),\n+    );\n     // The names the fixture files its issues and projects under are what this source's\n     // `status_mapping` gives `todo` and `done`: Linear has no built-in names, so a source\n     // without a mapping refuses every status write and reads every item as `unknown`.\n@@ -1574,7 +1686,7 @@ async fn real_linear_applies_every_declared_capability_and_leaves_no_residue() {\n     let source = onetaskgraph_linear::Plugin\n         .build(\n             &SourceName::new(\"live\").unwrap(),\n-            &json!({\"team\":team,\"status_mapping\":{\n+            &json!({\"endpoint\":endpoint,\"team\":team,\"status_mapping\":{\n                 \"todo\":{\"task\":open_state,\"project\":project_status},\n                 \"done\":{\"task\":done_state},\n             }}),\n@@ -1623,40 +1735,1383 @@ async fn real_linear_applies_every_declared_capability_and_leaves_no_residue() {\n         .unwrap_or_else(|error| {\n             panic!(\"the Linear live lane cannot reach its scratch team: {error}\")\n         });\n+    // From the first create on, one guard retires what this invocation created: preparation,\n+    // the setup after it and the journey all run inside `guard_plugin_invocation`.\n+    let created = &document_lifecycle::Created::default();\n+    let lane_endpoint = endpoint.clone();\n+    let lane_key = key.clone();\n+    guard_plugin_invocation(\n+        &lane_endpoint,\n+        &lane_key,\n+        &team_key,\n+        &team_id.clone(),\n+        scope,\n+        effective_mode,\n+        created,\n+        |standing| async move {\n+            if ci && document_mode == Mode::Initialize {\n+                journal.finish().unwrap();\n+                return;\n+            }\n+            journal.journey(\"capability-and-follow-up\");\n+            let run = LiveRun {\n+                endpoint,\n+                key: key.clone(),\n+                id: Run::current(),\n+                stamp_micros: now_micros(),\n+                open_state,\n+                done_state,\n+                project_status,\n+                document_mode,\n+                standing,\n+            };\n+            let id = run.id;\n+            // `ensure!` keeps the journey's own checks to `Err`, but anything else that panics\n+            // in it must still reach the cleanup below; the panic is resumed once cleanup ran.\n+            let panicked = std::sync::Mutex::new(None);\n+            let result = run_then_cleanup(\n+                || async {\n+                    match document_lifecycle::unwinding(drive_every_declared_capability(\n+                        &run,\n+                        source.as_ref(),\n+                        &team_id,\n+                    ))\n+                    .await\n+                    {\n+                        Ok(outcome) => outcome,\n+                        Err(panic) => {\n+                            *panicked.lock().unwrap() = Some(panic);\n+                            Err(\"the Linear live journey panicked\".into())\n+                        }\n+                    }\n+                },\n+                || async {\n+                    // The invocation-owned slots by their exact ids first, then this run's\n+                    // own: everything it wrote goes whether the journey passed or failed.\n+                    // Then what an interrupted EARLIER run left, which is a different\n+                    // decision on different evidence — and which is deliberately here, at\n+                    // the end, rather than at the start where it used to be. A sweep before\n+                    // the journey deleted the in-flight issues of any session running beside\n+                    // this one; a sweep after it recovers exactly the same orphans and can\n+                    // reach nothing a live run owns.\n+                    let slots =\n+                        document_lifecycle::retire(&run.endpoint, &key, scope, created).await;\n+                    let mine =\n+                        remove_artifacts(&key, &|prefix, name| is_this_runs(id, prefix, name))\n+                            .await\n+                            .and(slots.map(drop));\n+                    let orphans = sweep_orphans(&key, &Sweep::of(id, now_micros())).await;\n+                    match (mine, orphans) {\n+                        (Ok(()), Ok(())) => Ok(()),\n+                        (Err(mine), Ok(())) => Err(mine),\n+                        (Ok(()), Err(orphans)) => Err(format!(\n+                            \"residue left by an earlier interrupted run could not be \\\n+                             cleared: {orphans}\"\n+                        )),\n+                        (Err(mine), Err(orphans)) => Err(format!(\n+                            \"{mine}; additionally, residue left by an earlier interrupted \\\n+                             run could not be cleared: {orphans}\"\n+                        )),\n+                    }\n+                },\n+            )\n+            .await;\n+            journal.finish().unwrap();\n+            if let Some(panic) = panicked.into_inner().unwrap() {\n+                if let Err(error) = result {\n+                    eprintln!(\"{error}\");\n+                }\n+                std::panic::resume_unwind(panic);\n+            }\n+            result.unwrap_or_else(|error| panic!(\"Linear live capability journey failed: {error}\"));\n+        },\n+    )\n+    .await;\n+}\n+\n+/// The plugin lane's one invocation cleanup guard: it prepares the standing set and runs\n+/// `invocation` — the setup after preparation and the journey — over it, so that a panic at\n+/// any point from the first slot create on, whether inside preparation, straight after it or\n+/// anywhere before the journey's own cleanup ran, retires every slot `created` records before\n+/// the panic leaves the lane. A CI set is standing and is never retired here, and once the\n+/// journey's cleanup has retired the slots the record is empty, so nothing is deleted twice.\n+#[allow(\n+    clippy::too_many_arguments,\n+    reason = \"prepare_owned's lane identities plus the invocation; the offline journey passes \\\n+              each one separately to drive this guard as the live lane does\"\n+)]\n+async fn guard_plugin_invocation<F, Fut>(\n+    endpoint: &str,\n+    key: &str,\n+    team_key: &str,\n+    team_id: &str,\n+    scope: Scope<'_>,\n+    mode: Mode,\n+    created: &document_lifecycle::Created,\n+    invocation: F,\n+) where\n+    F: FnOnce(Standing) -> Fut,\n+    Fut: std::future::Future<Output = ()>,\n+{\n+    let guarded = document_lifecycle::unwinding(async {\n+        let standing = document_lifecycle::prepare_owned(\n+            endpoint,\n+            key,\n+            team_key,\n+            team_id,\n+            scope,\n+            mode,\n+            &[Slot::Filed, Slot::Loose, Slot::FollowUp],\n+            created,\n+        )\n+        .await\n+        .unwrap_or_else(|e| panic!(\"{e}\"));\n+        invocation(standing).await;\n+    })\n+    .await;\n+    if let Err(panic) = guarded {\n+        if let Err(error) = document_lifecycle::retire(endpoint, key, scope, created).await {\n+            eprintln!(\"{error}\");\n+        }\n+        std::panic::resume_unwind(panic);\n+    }\n+}\n+\n+#[path = \"document_lifecycle/replay.rs\"]\n+mod document_replay;\n+\n+fn replay() -> document_replay::Replay {\n+    document_replay::Replay::start(\n+        document_lifecycle::journal::Journal::new(\"plugin\", \"initialize\"),\n+        [\n+            (PROBE.to_owned(), PROBE_STORED.to_owned()),\n+            (MARKDOWN_PROBE.to_owned(), MARKDOWN_PROBE_STORED.to_owned()),\n+        ]\n+        .into_iter()\n+        .collect(),\n+    )\n+}\n+async fn replay_prepare(\n+    replay: &document_replay::Replay,\n+    scope: Scope<'_>,\n+    mode: Mode,\n+) -> Result<document_lifecycle::Standing, String> {\n+    document_lifecycle::prepare(\n+        &replay.endpoint,\n+        \"synthetic\",\n+        \"ENG\",\n+        \"team\",\n+        scope,\n+        mode,\n+        &[Slot::Filed, Slot::Loose, Slot::FollowUp],\n+    )\n+    .await\n+}\n+async fn replay_drive(\n+    replay: &document_replay::Replay,\n+    standing: document_lifecycle::Standing,\n+    mode: Mode,\n+    stamp: u64,\n+) -> Result<(), String> {\n+    replay_drive_at(&replay.endpoint, &replay.journal, standing, mode, stamp).await\n+}\n+async fn replay_drive_at(\n+    endpoint: &str,\n+    journal: &document_lifecycle::journal::Journal,\n+    standing: document_lifecycle::Standing,\n+    mode: Mode,\n+    stamp: u64,\n+) -> Result<(), String> {\n+    let source = onetaskgraph_linear::Plugin.build(&SourceName::new(\"live\").unwrap(),\n+        &json!({\"endpoint\":endpoint,\"team\":\"ENG\",\"status_mapping\":{\"todo\":{\"task\":\"Todo\",\"project\":\"Planned\"},\"done\":{\"task\":\"Done\"}}}),&ReplaySecrets).unwrap();\n+    let parent = if let Some(parent) = &standing.parent {\n+        parent.clone()\n+    } else {\n+        let data = document_lifecycle::send(endpoint, \"synthetic\",\n+            \"mutation($input:ProjectCreateInput!){projectCreate(input:$input){success project{id}}}\",\n+            json!({\"input\":{\"name\":artifact_title(Run::current(), stamp),\"teamIds\":[\"team\"]}})).await?;\n+        data[\"projectCreate\"][\"project\"][\"id\"]\n+            .as_str()\n+            .ok_or(\"fresh parent create omitted id\")?\n+            .to_owned()\n+    };\n     let run = LiveRun {\n-        key: key.clone(),\n+        endpoint: endpoint.to_owned(),\n+        key: \"synthetic\".into(),\n         id: Run::current(),\n-        stamp_micros: now_micros(),\n-        open_state,\n-        done_state,\n-        project_status,\n+        stamp_micros: stamp,\n+        open_state: \"Todo\".into(),\n+        done_state: \"Done\".into(),\n+        project_status: \"Planned\".into(),\n+        document_mode: mode,\n+        standing,\n+    };\n+    drive_document_paths(&run, source.as_ref(), &NativeId(parent), Some(journal)).await\n+}\n+\n+/// One ordinary CI pass through the plugin lane's own invocation guard, recording the\n+/// standing set it ran over.\n+async fn replay_ordinary_ci_pass(\n+    replay: &document_replay::Replay,\n+    stamp: u64,\n+    standing_ids: &std::sync::Mutex<Option<BTreeMap<&'static str, String>>>,\n+) {\n+    guard_plugin_invocation(\n+        &replay.endpoint,\n+        \"synthetic\",\n+        \"ENG\",\n+        \"team\",\n+        Scope::ci(\"ENG\").unwrap(),\n+        Mode::Ordinary,\n+        &document_lifecycle::Created::default(),\n+        |standing| async move {\n+            *standing_ids.lock().unwrap() = Some(standing.ids.clone());\n+            replay_drive(replay, standing, Mode::Ordinary, stamp)\n+                .await\n+                .unwrap();\n+        },\n+    )\n+    .await;\n+}\n+\n+async fn replay_cleanup_documents(replay: &document_replay::Replay) -> usize {\n+    let query = \"query($filter:DocumentFilter!){documents(first:100,filter:$filter){nodes{id title} pageInfo{hasNextPage endCursor}}}\";\n+    let read = || {\n+        document_lifecycle::send(\n+            &replay.endpoint,\n+            \"synthetic\",\n+            query,\n+            json!({\"filter\":{\"title\":{\"containsIgnoreCase\":onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX}}}),\n+        )\n+    };\n+    let listing = read().await.unwrap();\n+    let owned = |row: &Value| {\n+        row[\"title\"].as_str().is_some_and(|title| {\n+            is_this_runs(\n+                Run::current(),\n+                onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX,\n+                title,\n+            )\n+        })\n     };\n-    let id = run.id;\n-    run_then_cleanup(\n-        || drive_every_declared_capability(&run, source.as_ref(), &team_id),\n-        || async {\n-            // This run's own, first: everything it wrote goes whether the journey passed or\n-            // failed. Then what an interrupted EARLIER run left, which is a different\n-            // decision on different evidence — and which is deliberately here, at the end,\n-            // rather than at the start where it used to be. A sweep before the journey\n-            // deleted the in-flight issues of any session running beside this one; a sweep\n-            // after it recovers exactly the same orphans and can reach nothing a live run\n-            // owns.\n-            let mine = remove_artifacts(&key, &|prefix, name| is_this_runs(id, prefix, name)).await;\n-            let orphans = sweep_orphans(&key, &Sweep::of(id, now_micros())).await;\n-            match (mine, orphans) {\n-                (Ok(()), Ok(())) => Ok(()),\n-                (Err(mine), Ok(())) => Err(mine),\n-                (Ok(()), Err(orphans)) => Err(format!(\n-                    \"residue left by an earlier interrupted run could not be cleared: {orphans}\"\n-                )),\n-                (Err(mine), Err(orphans)) => Err(format!(\n-                    \"{mine}; additionally, residue left by an earlier interrupted run could \\\n-                     not be cleared: {orphans}\"\n-                )),\n+    for document in listing[\"documents\"][\"nodes\"]\n+        .as_array()\n+        .unwrap()\n+        .iter()\n+        .filter(|row| owned(row))\n+    {\n+        document_lifecycle::send(\n+            &replay.endpoint,\n+            \"synthetic\",\n+            onetaskgraph_linear::graphql::DOCUMENT_DELETE,\n+            json!({\"id\":document[\"id\"]}),\n+        )\n+        .await\n+        .unwrap();\n+    }\n+    let after = read().await.unwrap();\n+    after[\"documents\"][\"nodes\"]\n+        .as_array()\n+        .unwrap()\n+        .iter()\n+        .filter(|row| owned(row))\n+        .count()\n+}\n+\n+/// Both modes run the same capability and follow-up functions as the credentialed lane.\n+#[tokio::test]\n+async fn document_modes_replay_the_live_plugin_paths_over_http() {\n+    let replay = replay();\n+    let scope = Scope::ci(\"ENG\").unwrap();\n+    // A default non-CI invocation refuses before any create and names the explicit mode,\n+    // which initializes its own set and finds it again on recovery.\n+    let local = Scope::local(\"ENG\", \"1-2-900\").unwrap();\n+    assert!(\n+        replay_prepare(&replay, local, Mode::Ordinary)\n+            .await\n+            .err()\n+            .unwrap()\n+            .contains(\"initialize\")\n+    );\n+    assert_eq!(replay.journal.count(), 0);\n+    let created = document_lifecycle::Created::default();\n+    let standing = document_lifecycle::prepare_owned(\n+        &replay.endpoint,\n+        \"synthetic\",\n+        \"ENG\",\n+        \"team\",\n+        local,\n+        Mode::Initialize,\n+        &[Slot::Filed, Slot::Loose, Slot::FollowUp],\n+        &created,\n+    )\n+    .await\n+    .unwrap();\n+    assert_eq!(\n+        replay.journal.count(),\n+        3,\n+        \"one owned document per missing plugin slot\"\n+    );\n+    let again = replay_prepare(&replay, local, Mode::Initialize)\n+        .await\n+        .unwrap();\n+    assert_eq!(standing.ids, again.ids);\n+    assert_eq!(replay.journal.count(), 3);\n+    replay_drive(&replay, standing, Mode::Ordinary, now_micros())\n+        .await\n+        .unwrap();\n+    assert_eq!(replay.journal.count(), 3);\n+    document_lifecycle::retire(&replay.endpoint, \"synthetic\", local, &created)\n+        .await\n+        .unwrap();\n+    replay.journal.finish().unwrap();\n+    // The CI set is absent: the first ordinary pass rebuilds it through the lane's own guard,\n+    // files the creates as a cold rebuild, and then runs its reuse assertions over the set.\n+    replay.journal.begin(\"ordinary\");\n+    let stamp = now_micros();\n+    let rebuilt = std::sync::Mutex::new(None);\n+    replay_ordinary_ci_pass(&replay, stamp, &rebuilt).await;\n+    let rebuilt = rebuilt.into_inner().unwrap().unwrap();\n+    assert_eq!(rebuilt.len(), 4, \"a parent and three document slots\");\n+    assert_eq!(\n+        replay\n+            .journal\n+            .count_in(document_lifecycle::journal::COLD_REBUILD),\n+        3,\n+        \"exactly the three missing documents, filed as a cold rebuild\"\n+    );\n+    assert_eq!(\n+        replay.journal.count(),\n+        3,\n+        \"the reuse assertions create none\"\n+    );\n+    // A second, warm ordinary pass resets the same retained contents and creates nothing.\n+    let warm = std::sync::Mutex::new(None);\n+    replay_ordinary_ci_pass(&replay, stamp + 1, &warm).await;\n+    assert_eq!(warm.into_inner().unwrap().unwrap(), rebuilt);\n+    assert_eq!(\n+        replay.journal.count(),\n+        3,\n+        \"a warm ordinary pass creates none\"\n+    );\n+    replay.journal.finish().unwrap();\n+    replay.journal.begin(\"fresh\");\n+    let standing = replay_prepare(&replay, scope, Mode::Fresh).await.unwrap();\n+    replay_drive(&replay, standing, Mode::Fresh, stamp + 2)\n+        .await\n+        .unwrap();\n+    assert_eq!(\n+        replay.journal.count(),\n+        3,\n+        \"two document writes and the follow-up document write\"\n+    );\n+    replay.journal.finish().unwrap();\n+    // The original filed/loose deletion assertions ran in drive_documents; retire the\n+    // follow-up using the same documentDelete HTTP boundary as invocation cleanup.\n+    let fresh_ids: Vec<_> = replay\n+        .state\n+        .lock()\n+        .unwrap()\n+        .documents\n+        .iter()\n+        .filter(|(_, row)| {\n+            row[\"title\"].as_str().is_some_and(|t| {\n+                is_this_runs(\n+                    Run::current(),\n+                    onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX,\n+                    t,\n+                )\n+            })\n+        })\n+        .map(|(id, _)| id.clone())\n+        .collect();\n+    assert_eq!(fresh_ids.len(), 1);\n+    for id in fresh_ids {\n+        document_lifecycle::send(\n+            &replay.endpoint,\n+            \"synthetic\",\n+            onetaskgraph_linear::graphql::DOCUMENT_DELETE,\n+            json!({\"id\":id}),\n+        )\n+        .await\n+        .unwrap();\n+    }\n+    assert_eq!(\n+        replay.journal.count(),\n+        3,\n+        \"deletion never removes successful creations from the journal\"\n+    );\n+    replay.journal.begin(\"failure\");\n+    replay.state.lock().unwrap().corrupt_document_create_ack = true;\n+    let standing = replay_prepare(&replay, scope, Mode::Fresh).await.unwrap();\n+    let error = replay_drive(&replay, standing, Mode::Fresh, stamp + 3)\n+        .await\n+        .unwrap_err();\n+    assert!(error.contains(\"visible body\"), \"{error}\");\n+    assert_eq!(\n+        replay.journal.count(),\n+        2,\n+        \"both writes before the assertion failure remain counted\"\n+    );\n+    let residue = replay_cleanup_documents(&replay).await;\n+    assert_eq!(\n+        residue, 0,\n+        \"failed fresh documents retire while standing CI slots survive\"\n+    );\n+    replay.journal.residue(residue);\n+    replay.journal.finish().unwrap();\n+    replay.state.lock().unwrap().corrupt_document_create_ack = false;\n+    let standing = replay_prepare(&replay, scope, Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    replay_drive(&replay, standing, Mode::Ordinary, stamp + 4)\n+        .await\n+        .unwrap();\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n+}\n+\n+#[tokio::test]\n+async fn document_lifecycle_replay_refuses_unsafe_ownership_and_recovers_partial_initialization() {\n+    let replay = replay();\n+    let scope = Scope::ci(\"ENG\").unwrap();\n+    replay.state.lock().unwrap().uncertain = true;\n+    let error = replay_prepare(&replay, scope, Mode::Initialize)\n+        .await\n+        .err()\n+        .unwrap();\n+    assert!(error.contains(\"discover\"), \"{error}\");\n+    assert_eq!(\n+        replay.journal.count(),\n+        1,\n+        \"uncertain acknowledgement still records the stored create\"\n+    );\n+    // The ordinary CI pass resumes that partial initialization as a cold rebuild.\n+    let recovered = replay_prepare(&replay, scope, Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    assert_eq!(\n+        replay.journal.count(),\n+        3,\n+        \"discovery reuses the uncertain first create and fills only missing slots\"\n+    );\n+    assert_eq!(recovered.ids.len(), 4);\n+    let again = replay_prepare(&replay, scope, Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    assert_eq!(again.ids, recovered.ids);\n+    assert_eq!(\n+        replay.journal.count(),\n+        3,\n+        \"a warm pass creates no duplicate\"\n+    );\n+    // A cancelled invocation leaves reusable contents, not missing identities.\n+    replay_drive(&replay, recovered, Mode::Ordinary, now_micros())\n+        .await\n+        .unwrap();\n+    for defect in [\"wrong-team\", \"unverifiable-team\", \"ambiguous\", \"unknown\"] {\n+        let before = {\n+            let mut state = replay.state.lock().unwrap();\n+            state.wrong_team = defect == \"wrong-team\";\n+            state.unverifiable_team = defect == \"unverifiable-team\";\n+            state.ambiguous = defect == \"ambiguous\";\n+            if defect == \"unknown\" {\n+                state.documents.values_mut().next().unwrap()[\"title\"] =\n+                    json!(\"onetaskgraph live cleanup retained-v2 ci ENG filed\");\n+            }\n+            state.requests.len()\n+        };\n+        let error = replay_prepare(&replay, scope, Mode::Ordinary)\n+            .await\n+            .err()\n+            .unwrap();\n+        assert!(\n+            error.contains(\"ownership\") || error.contains(\"membership\"),\n+            \"{defect}: {error}\"\n+        );\n+        let state = replay.state.lock().unwrap();\n+        assert!(\n+            state.requests[before..]\n+                .iter()\n+                .all(|r| !r[\"query\"].as_str().unwrap().contains(\"mutation\")),\n+            \"{defect} sent a write\"\n+        );\n+    }\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n+}\n+\n+/// The transport's own record of a replay: each create and delete mutation it answered.\n+fn replay_mutations(\n+    replay: &document_replay::Replay,\n+    from: usize,\n+) -> BTreeMap<&'static str, usize> {\n+    let state = replay.state.lock().unwrap();\n+    let mut counted = BTreeMap::new();\n+    for request in &state.requests[from..] {\n+        let query = request[\"query\"].as_str().unwrap();\n+        for root in [\n+            \"projectCreate\",\n+            \"documentCreate\",\n+            \"projectDelete\",\n+            \"documentDelete\",\n+        ] {\n+            if query.contains(&format!(\"{root}(\")) {\n+                *counted.entry(root).or_default() += 1;\n             }\n+        }\n+    }\n+    counted\n+}\n+\n+/// A panic straight after each individual slot create of a local initialization — the\n+/// parent project, then each of the three documents — still retires every slot the\n+/// invocation created before the panic leaves the lane, and nothing else.\n+#[tokio::test]\n+async fn a_panic_after_each_local_slot_create_retires_what_the_invocation_created() {\n+    let replay = replay();\n+    let ci = replay_prepare(&replay, Scope::ci(\"ENG\").unwrap(), Mode::Initialize)\n+        .await\n+        .unwrap();\n+    for after in 1..=4 {\n+        let stamp = format!(\"1-2-{after}\");\n+        let scope = Scope::local(\"ENG\", &stamp).unwrap();\n+        let before = replay.state.lock().unwrap().requests.len();\n+        let creates_before = replay.journal.count();\n+        let created = document_lifecycle::Created::panicking_after(after);\n+        let outcome = document_lifecycle::unwinding(document_lifecycle::prepare_owned(\n+            &replay.endpoint,\n+            \"synthetic\",\n+            \"ENG\",\n+            \"team\",\n+            scope,\n+            Mode::Initialize,\n+            &[Slot::Filed, Slot::Loose, Slot::FollowUp],\n+            &created,\n+        ))\n+        .await;\n+        let panic = outcome.err().expect(\"the injected failure panics the lane\");\n+        assert_eq!(\n+            panic.downcast_ref::<String>().map(String::as_str),\n+            Some(format!(\"injected failure after standing create {after}\").as_str())\n+        );\n+        let sent = replay_mutations(&replay, before);\n+        let projects = 1;\n+        let documents = after - projects;\n+        assert_eq!(\n+            sent.get(\"projectCreate\").copied().unwrap_or(0),\n+            projects,\n+            \"after {after}\"\n+        );\n+        assert_eq!(\n+            sent.get(\"documentCreate\").copied().unwrap_or(0),\n+            documents,\n+            \"after {after}\"\n+        );\n+        assert_eq!(\n+            sent.get(\"projectDelete\").copied().unwrap_or(0),\n+            projects,\n+            \"after {after}: the parent created is the parent retired\"\n+        );\n+        assert_eq!(\n+            sent.get(\"documentDelete\").copied().unwrap_or(0),\n+            documents,\n+            \"after {after}: every document created is retired\"\n+        );\n+        assert_eq!(\n+            replay.journal.count() - creates_before,\n+            documents,\n+            \"after {after}: retired documents stay counted as created\"\n+        );\n+        let state = replay.state.lock().unwrap();\n+        assert!(\n+            state\n+                .documents\n+                .values()\n+                .chain(state.projects.values())\n+                .all(|row| !row[\"title\"]\n+                    .as_str()\n+                    .or(row[\"name\"].as_str())\n+                    .unwrap_or(\"\")\n+                    .contains(&stamp)),\n+            \"after {after}: nothing of the invocation's set survives\"\n+        );\n+        assert_eq!(created.len(), 0);\n+    }\n+    let survived = replay_prepare(&replay, Scope::ci(\"ENG\").unwrap(), Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    assert_eq!(survived.ids, ci.ids, \"the standing CI set is untouched\");\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n+}\n+\n+/// A panic straight after a successful local preparation — before any of the journey's\n+/// setup — is caught by the plugin lane's own invocation guard, which retires the parent\n+/// project and all three documents the invocation created; the standing CI set and an\n+/// unrelated document and project survive, and the creations stay journalled.\n+#[tokio::test]\n+async fn a_panic_straight_after_local_preparation_is_retired_by_the_plugin_invocation_guard() {\n+    let replay = replay();\n+    let ci = replay_prepare(&replay, Scope::ci(\"ENG\").unwrap(), Mode::Initialize)\n+        .await\n+        .unwrap();\n+    let unrelated_document = document_lifecycle::send(\n+        &replay.endpoint,\n+        \"synthetic\",\n+        \"mutation($input:DocumentCreateInput!){documentCreate(input:$input){success document{id}}}\",\n+        json!({\"input\":{\"title\":\"Unrelated synthetic document\",\"content\":\"synthetic\",\"teamId\":\"team\"}}),\n+    )\n+    .await\n+    .unwrap()[\"documentCreate\"][\"document\"][\"id\"]\n+        .as_str()\n+        .unwrap()\n+        .to_owned();\n+    let unrelated_project = document_lifecycle::send(\n+        &replay.endpoint,\n+        \"synthetic\",\n+        \"mutation($input:ProjectCreateInput!){projectCreate(input:$input){success project{id}}}\",\n+        json!({\"input\":{\"name\":\"Unrelated synthetic project\",\"teamIds\":[\"team\"]}}),\n+    )\n+    .await\n+    .unwrap()[\"projectCreate\"][\"project\"][\"id\"]\n+        .as_str()\n+        .unwrap()\n+        .to_owned();\n+    let stamp = \"1-2-9\";\n+    let scope = Scope::local(\"ENG\", stamp).unwrap();\n+    let before = replay.state.lock().unwrap().requests.len();\n+    let creates_before = replay.journal.count();\n+    let created = document_lifecycle::Created::default();\n+    let prepared = std::sync::Mutex::new(None);\n+    let outcome = document_lifecycle::unwinding(guard_plugin_invocation(\n+        &replay.endpoint,\n+        \"synthetic\",\n+        \"ENG\",\n+        \"team\",\n+        scope,\n+        Mode::Initialize,\n+        &created,\n+        |standing| {\n+            *prepared.lock().unwrap() = Some(standing.ids.clone());\n+            async {\n+                panic!(\"injected failure straight after local preparation\");\n+            }\n+        },\n+    ))\n+    .await;\n+    let panic = outcome.expect_err(\"the injected failure still fails the lane\");\n+    assert_eq!(\n+        panic.downcast_ref::<&str>().copied(),\n+        Some(\"injected failure straight after local preparation\")\n+    );\n+    let prepared = prepared\n+        .into_inner()\n+        .unwrap()\n+        .expect(\"preparation succeeded first\");\n+    assert_eq!(\n+        prepared.len(),\n+        4,\n+        \"the parent and all three local documents were created\"\n+    );\n+    let sent = replay_mutations(&replay, before);\n+    assert_eq!(sent.get(\"projectCreate\"), Some(&1));\n+    assert_eq!(sent.get(\"documentCreate\"), Some(&3));\n+    assert_eq!(sent.get(\"projectDelete\"), Some(&1), \"the parent is retired\");\n+    assert_eq!(\n+        sent.get(\"documentDelete\"),\n+        Some(&3),\n+        \"every document is retired\"\n+    );\n+    assert_eq!(\n+        replay.journal.count() - creates_before,\n+        3,\n+        \"retired creations stay journalled\"\n+    );\n+    {\n+        let state = replay.state.lock().unwrap();\n+        for id in prepared.values() {\n+            assert!(\n+                !state.documents.contains_key(id) && !state.projects.contains_key(id),\n+                \"{id} survived\"\n+            );\n+        }\n+        assert!(state.documents.contains_key(&unrelated_document));\n+        assert!(state.projects.contains_key(&unrelated_project));\n+    }\n+    assert_eq!(created.len(), 0);\n+    let survived = replay_prepare(&replay, Scope::ci(\"ENG\").unwrap(), Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    assert_eq!(survived.ids, ci.ids, \"the standing CI set is untouched\");\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n+}\n+\n+/// An uncertain local create — stored, but acknowledged without its id — is found by its\n+/// exact identity and retired with the slot created before it; a CI set keeps its slots for\n+/// the discovery recovery requires.\n+#[tokio::test]\n+async fn an_uncertain_local_slot_create_is_discovered_and_retired_before_the_lane_fails() {\n+    let replay = replay();\n+    replay.state.lock().unwrap().uncertain = true;\n+    let created = document_lifecycle::Created::default();\n+    let error = document_lifecycle::prepare_owned(\n+        &replay.endpoint,\n+        \"synthetic\",\n+        \"ENG\",\n+        \"team\",\n+        Scope::local(\"ENG\", \"1-2-3\").unwrap(),\n+        Mode::Initialize,\n+        &[Slot::Filed, Slot::Loose, Slot::FollowUp],\n+        &created,\n+    )\n+    .await\n+    .err()\n+    .unwrap();\n+    assert!(error.contains(\"discover\"), \"{error}\");\n+    let sent = replay_mutations(&replay, 0);\n+    assert_eq!(sent.get(\"projectCreate\"), Some(&1));\n+    assert_eq!(sent.get(\"documentCreate\"), Some(&1));\n+    assert_eq!(sent.get(\"projectDelete\"), Some(&1));\n+    assert_eq!(sent.get(\"documentDelete\"), Some(&1));\n+    assert_eq!(\n+        replay.journal.count(),\n+        1,\n+        \"the retired create stays counted\"\n+    );\n+    {\n+        let state = replay.state.lock().unwrap();\n+        assert!(state.documents.is_empty() && state.projects.is_empty());\n+    }\n+    replay.state.lock().unwrap().uncertain = true;\n+    let before = replay.state.lock().unwrap().requests.len();\n+    document_lifecycle::prepare_owned(\n+        &replay.endpoint,\n+        \"synthetic\",\n+        \"ENG\",\n+        \"team\",\n+        Scope::ci(\"ENG\").unwrap(),\n+        Mode::Initialize,\n+        &[Slot::Filed, Slot::Loose, Slot::FollowUp],\n+        &document_lifecycle::Created::default(),\n+    )\n+    .await\n+    .err()\n+    .unwrap();\n+    let sent = replay_mutations(&replay, before);\n+    assert_eq!(\n+        sent.get(\"projectDelete\"),\n+        None,\n+        \"standing CI slots are never retired\"\n+    );\n+    assert_eq!(\n+        sent.get(\"documentDelete\"),\n+        None,\n+        \"standing CI slots are never retired\"\n+    );\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n+}\n+\n+#[tokio::test]\n+async fn local_document_sets_cannot_resolve_ci_or_another_invocation() {\n+    let replay = replay();\n+    let ci = replay_prepare(&replay, Scope::ci(\"ENG\").unwrap(), Mode::Initialize)\n+        .await\n+        .unwrap();\n+    let first = Scope::local(\"ENG\", \"1-2-3\").unwrap();\n+    let second = Scope::local(\"ENG\", \"1-4-5\").unwrap();\n+    for scope in [first, second] {\n+        assert!(\n+            replay_prepare(&replay, scope, Mode::Ordinary)\n+                .await\n+                .err()\n+                .unwrap()\n+                .contains(\"initialize\")\n+        );\n+    }\n+    let local = replay_prepare(&replay, first, Mode::Initialize)\n+        .await\n+        .unwrap();\n+    let other = replay_prepare(&replay, second, Mode::Initialize)\n+        .await\n+        .unwrap();\n+    for key in [\"filed\", \"loose\", \"follow-up\", \"parent\"] {\n+        assert_ne!(ci.ids[key], local.ids[key]);\n+        assert_ne!(local.ids[key], other.ids[key]);\n+    }\n+    assert_eq!(\n+        replay.journal.count(),\n+        9,\n+        \"each independently owned set has three real document creates\"\n+    );\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n+}\n+#[tokio::test]\n+async fn cancelled_document_initialization_discovers_its_stored_create_before_recovery() {\n+    use std::{sync::atomic::Ordering, time::Duration};\n+    let replay = replay();\n+    replay.state.lock().unwrap().pause_next_create = true;\n+    let endpoint = replay.endpoint.clone();\n+    let initializing = tokio::spawn(async move {\n+        document_lifecycle::prepare(\n+            &endpoint,\n+            \"synthetic\",\n+            \"ENG\",\n+            \"team\",\n+            Scope::ci(\"ENG\").unwrap(),\n+            Mode::Initialize,\n+            &[Slot::Filed, Slot::Loose, Slot::FollowUp],\n+        )\n+        .await\n+    });\n+    tokio::time::timeout(Duration::from_secs(5), async {\n+        while !replay.paused.load(Ordering::Acquire) {\n+            tokio::time::sleep(Duration::from_millis(5)).await;\n+        }\n+    })\n+    .await\n+    .expect(\"create reached HTTP transport before cancellation\");\n+    initializing.abort();\n+    assert!(matches!(initializing.await, Err(error) if error.is_cancelled()));\n+    replay.release.store(true, Ordering::Release);\n+    tokio::time::timeout(Duration::from_secs(5), async {\n+        while replay.journal.count() != 1 {\n+            tokio::time::sleep(Duration::from_millis(5)).await;\n+        }\n+    })\n+    .await\n+    .expect(\"forwarding observer records the upstream acknowledgement after cancellation\");\n+    assert_eq!(\n+        replay.journal.count(),\n+        1,\n+        \"a committed create remains counted after the caller is cancelled\"\n+    );\n+    let scope = Scope::ci(\"ENG\").unwrap();\n+    let restored = replay_prepare(&replay, scope, Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    assert_eq!(\n+        replay.journal.count(),\n+        3,\n+        \"recovery discovers the cancelled create and creates only missing identities\"\n+    );\n+    replay_drive(&replay, restored, Mode::Ordinary, now_micros())\n+        .await\n+        .unwrap();\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n+}\n+\n+/// A child role invoked only by the subprocess seat journey below.\n+#[tokio::test]\n+async fn document_writer_child() {\n+    use std::time::Duration;\n+    let Ok(role) = env::var(\"ONETASKGRAPH_LINEAR_WRITER_CHILD\") else {\n+        return;\n+    };\n+    let root = std::path::PathBuf::from(env::var_os(\"ONETASKGRAPH_LINEAR_WRITER_ROOT\").unwrap());\n+    let session = Session::open(\n+        SESSION_NAME,\n+        Credential::new(\"synthetic\").unwrap(),\n+        Exclusivity::OneAtATime,\n+    );\n+    if role == \"decline\" {\n+        assert!(\n+            session.is_err(),\n+            \"a concurrent writer unexpectedly acquired the Linear seat\"\n+        );\n+        println!(\"declined before HTTP\");\n+        return;\n+    }\n+    let _session = session\n+        .unwrap_or_else(|error| panic!(\"isolated writer could not acquire its seat: {error}\"));\n+    std::fs::write(root.join(\"held\"), b\"held\").unwrap();\n+    tokio::time::timeout(Duration::from_secs(20), async {\n+        while !root.join(\"release\").exists() {\n+            tokio::time::sleep(Duration::from_millis(5)).await;\n+        }\n+    })\n+    .await\n+    .expect(\"parent releases the writer it started\");\n+    let endpoint = env::var(\"ONETASKGRAPH_LINEAR_WRITER_ENDPOINT\").unwrap();\n+    let standing = document_lifecycle::prepare(\n+        &endpoint,\n+        \"synthetic\",\n+        \"ENG\",\n+        \"team\",\n+        Scope::ci(\"ENG\").unwrap(),\n+        Mode::Ordinary,\n+        &[Slot::Filed, Slot::Loose, Slot::FollowUp],\n+    )\n+    .await\n+    .unwrap();\n+    let journal = document_lifecycle::journal::Journal::new(\"plugin\", \"ordinary\");\n+    replay_drive_at(&endpoint, &journal, standing, Mode::Ordinary, now_micros())\n+        .await\n+        .unwrap();\n+}\n+\n+#[tokio::test]\n+async fn document_ci_writers_share_the_real_machine_seat_before_http_updates() {\n+    use std::{\n+        process::{Child, Command, Stdio},\n+        time::Duration,\n+    };\n+    struct HeldChild(Option<Child>);\n+    impl Drop for HeldChild {\n+        fn drop(&mut self) {\n+            if let Some(child) = self.0.as_mut() {\n+                let _ = child.kill();\n+                let _ = child.wait();\n+            }\n+        }\n+    }\n+    let replay = replay();\n+    let standing = replay_prepare(&replay, Scope::ci(\"ENG\").unwrap(), Mode::Initialize)\n+        .await\n+        .unwrap();\n+    replay.journal.begin(\"ordinary\");\n+    let root = env::var_os(\"ONEPIPELINE_NODE_SCRATCH_DIR\")\n+        .map(std::path::PathBuf::from)\n+        .unwrap_or_else(env::temp_dir)\n+        .join(format!(\n+            \"linear-writers-{}-{}\",\n+            std::process::id(),\n+            now_micros()\n+        ));\n+    std::fs::create_dir_all(root.join(\"seats\")).unwrap();\n+    let command = |role: &str| {\n+        let mut command = Command::new(env::current_exe().unwrap());\n+        command\n+            .args([\"--exact\", \"document_writer_child\", \"--nocapture\"])\n+            .env(\"ONETASKGRAPH_LINEAR_WRITER_CHILD\", role)\n+            .env(\"ONETASKGRAPH_LINEAR_WRITER_ROOT\", &root)\n+            .env(\"ONETASKGRAPH_LINEAR_WRITER_ENDPOINT\", &replay.endpoint)\n+            .env(\n+                onetaskgraph_live::SEAT_DIRECTORY_VARIABLE,\n+                root.join(\"seats\"),\n+            )\n+            .env(\n+                onetaskgraph_live::artifact::REGISTRY_DIRECTORY_VARIABLE,\n+                root.join(\"registry\"),\n+            )\n+            .env_remove(\"LINEAR_API_KEY\")\n+            .stdout(Stdio::piped())\n+            .stderr(Stdio::piped());\n+        command\n+    };\n+    let mut first = HeldChild(Some(command(\"hold\").spawn().unwrap()));\n+    tokio::time::timeout(Duration::from_secs(10), async {\n+        while !root.join(\"held\").exists() {\n+            tokio::time::sleep(Duration::from_millis(5)).await;\n+        }\n+    })\n+    .await\n+    .expect(\"first child holds its isolated Linear seat\");\n+    let before = replay.state.lock().unwrap().requests.len();\n+    let declined = command(\"decline\").output().unwrap();\n+    assert!(\n+        declined.status.success(),\n+        \"{}\",\n+        String::from_utf8_lossy(&declined.stderr)\n+    );\n+    assert!(String::from_utf8_lossy(&declined.stdout).contains(\"declined before HTTP\"));\n+    assert_eq!(\n+        replay.state.lock().unwrap().requests.len(),\n+        before,\n+        \"declined writer sends no HTTP operation\"\n+    );\n+    std::fs::write(root.join(\"release\"), b\"release\").unwrap();\n+    let completed = first.0.take().unwrap().wait_with_output().unwrap();\n+    assert!(\n+        completed.status.success(),\n+        \"{}\",\n+        String::from_utf8_lossy(&completed.stdout)\n+    );\n+    assert_eq!(replay.journal.count(), 0);\n+    let requests = replay.state.lock().unwrap().requests[before..].to_vec();\n+    assert!(\n+        requests\n+            .iter()\n+            .filter(|request| request[\"query\"]\n+                .as_str()\n+                .unwrap()\n+                .contains(\"documentUpdate(\"))\n+            .count()\n+            >= 3,\n+        \"admitted child runs the actual shared ordinary document paths\"\n+    );\n+    let after = replay_prepare(&replay, Scope::ci(\"ENG\").unwrap(), Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    assert_eq!(standing.ids, after.ids);\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n+    std::fs::remove_dir_all(root).unwrap();\n+}\n+\n+struct ReplaySecrets;\n+impl SecretResolver for ReplaySecrets {\n+    fn get(&self, _: &str) -> Option<SecretString> {\n+        Some(SecretString::from(\"synthetic\"))\n+    }\n+}\n+\n+#[tokio::test]\n+async fn document_discovery_follows_advancing_http_pages_without_writes() {\n+    let replay = replay();\n+    let scope = Scope::ci(\"ENG\").unwrap();\n+    let initialized = replay_prepare(&replay, scope, Mode::Initialize)\n+        .await\n+        .unwrap();\n+    let before = {\n+        let mut state = replay.state.lock().unwrap();\n+        state.discovery_pagination = Some(\"advance\");\n+        state.requests.len()\n+    };\n+    let discovered = replay_prepare(&replay, scope, Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    assert_eq!(discovered.ids, initialized.ids);\n+    let state = replay.state.lock().unwrap();\n+    let requests = &state.requests[before..];\n+    assert!(\n+        requests\n+            .iter()\n+            .all(|request| !request[\"query\"].as_str().unwrap().contains(\"mutation\"))\n+    );\n+    let cursors: Vec<_> = requests\n+        .iter()\n+        .filter(|request| request[\"query\"].as_str().unwrap().contains(\"documents(\"))\n+        .map(|request| request[\"variables\"][\"after\"].clone())\n+        .collect();\n+    assert_eq!(\n+        cursors,\n+        (0..3)\n+            .flat_map(|_| [Value::Null, json!(\"1\"), json!(\"2\")])\n+            .collect::<Vec<_>>(),\n+        \"each exact slot discovery reads all three actual stored document pages\"\n+    );\n+    assert!(state.schema_errors.is_empty(), \"{:?}\", state.schema_errors);\n+}\n+\n+#[tokio::test]\n+async fn document_discovery_refuses_broken_or_unbounded_http_pagination_before_writes() {\n+    let replay = replay();\n+    let scope = Scope::ci(\"ENG\").unwrap();\n+    replay_prepare(&replay, scope, Mode::Initialize)\n+        .await\n+        .unwrap();\n+    for (fault, expected, pages) in [\n+        (\"missing-cursor\", \"omitted cursor\", 1),\n+        (\"repeated-cursor\", \"did not advance\", 2),\n+        (\"missing-pagination\", \"omitted pagination\", 1),\n+        (\"exhausted\", \"did not terminate\", 50),\n+    ] {\n+        let before = {\n+            let mut state = replay.state.lock().unwrap();\n+            state.discovery_pagination = Some(fault);\n+            state.requests.len()\n+        };\n+        let error = replay_prepare(&replay, scope, Mode::Ordinary)\n+            .await\n+            .err()\n+            .unwrap();\n+        assert!(error.contains(expected), \"{fault}: {error}\");\n+        let state = replay.state.lock().unwrap();\n+        let requests = &state.requests[before..];\n+        assert!(\n+            requests\n+                .iter()\n+                .all(|request| !request[\"query\"].as_str().unwrap().contains(\"mutation\")),\n+            \"{fault} sent a write\"\n+        );\n+        assert_eq!(\n+            requests\n+                .iter()\n+                .filter(|request| request[\"query\"].as_str().unwrap().contains(\"documents(\"))\n+                .count(),\n+            pages,\n+            \"{fault}\"\n+        );\n+        assert!(\n+            state.schema_errors.is_empty(),\n+            \"{fault}: {:?}\",\n+            state.schema_errors\n+        );\n+    }\n+    assert_eq!(\n+        replay.journal.count(),\n+        3,\n+        \"failed ordinary discovery never creates a replacement\"\n+    );\n+}\n+\n+#[tokio::test]\n+async fn document_discovery_requires_well_formed_direct_team_before_project_fallback() {\n+    let replay = replay();\n+    let prepare = |mode| {\n+        document_lifecycle::prepare(\n+            &replay.endpoint,\n+            \"synthetic\",\n+            \"ENG\",\n+            \"team\",\n+            Scope::ci(\"ENG\").unwrap(),\n+            mode,\n+            &[Slot::Filed],\n+        )\n+    };\n+    let initialized = prepare(Mode::Initialize).await.unwrap();\n+    for malformed in [\n+        json!(\"ENG\"),\n+        json!({}),\n+        json!({\"key\":7}),\n+        json!({\"key\":\"OTHER\"}),\n+    ] {\n+        let before = {\n+            let mut state = replay.state.lock().unwrap();\n+            state.direct_team_override = Some(malformed.clone());\n+            state.requests.len()\n+        };\n+        let error = prepare(Mode::Ordinary).await.err().unwrap();\n+        assert!(error.contains(\"membership\"), \"{malformed}: {error}\");\n+        let state = replay.state.lock().unwrap();\n+        assert!(\n+            state.requests[before..]\n+                .iter()\n+                .all(|request| !request[\"query\"].as_str().unwrap().contains(\"mutation\")),\n+            \"{malformed} sent a write\"\n+        );\n+    }\n+    let before = {\n+        let mut state = replay.state.lock().unwrap();\n+        state.direct_team_override = None;\n+        state.omit_direct_team = true;\n+        state.requests.len()\n+    };\n+    assert!(\n+        prepare(Mode::Ordinary)\n+            .await\n+            .err()\n+            .unwrap()\n+            .contains(\"membership\")\n+    );\n+    assert!(\n+        replay.state.lock().unwrap().requests[before..]\n+            .iter()\n+            .all(|request| !request[\"query\"].as_str().unwrap().contains(\"mutation\"))\n+    );\n+    {\n+        let mut state = replay.state.lock().unwrap();\n+        state.omit_direct_team = false;\n+        state.direct_team_override = Some(Value::Null);\n+    }\n+    let recovered = prepare(Mode::Ordinary).await.unwrap();\n+    assert_eq!(\n+        recovered.ids, initialized.ids,\n+        \"explicit null uses the verified complete project membership\"\n+    );\n+    assert_eq!(replay.journal.count(), 1);\n+}\n+\n+#[tokio::test]\n+async fn ordinary_document_run_metadata_reset_is_read_back_and_recovers_after_stale_write() {\n+    let replay = replay();\n+    let scope = Scope::ci(\"ENG\").unwrap();\n+    let first = replay_prepare(&replay, scope, Mode::Initialize)\n+        .await\n+        .unwrap();\n+    replay.journal.begin(\"ordinary\");\n+    let stamp = now_micros();\n+    replay_drive(&replay, first, Mode::Ordinary, stamp)\n+        .await\n+        .unwrap();\n+    replay.state.lock().unwrap().freeze_document_run_metadata = true;\n+    let second = replay_prepare(&replay, scope, Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    let error = replay_drive(&replay, second, Mode::Ordinary, stamp + 1)\n+        .await\n+        .unwrap_err();\n+    assert!(error.contains(\"reset caller.run\"), \"{error}\");\n+    replay.state.lock().unwrap().freeze_document_run_metadata = false;\n+    let recovered = replay_prepare(&replay, scope, Mode::Ordinary)\n+        .await\n+        .unwrap();\n+    replay_drive(&replay, recovered, Mode::Ordinary, stamp + 1)\n+        .await\n+        .unwrap();\n+    assert_eq!(\n+        replay.journal.count(),\n+        0,\n+        \"recovery updates the same retained documents\"\n+    );\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n+}\n+\n+/// The plugin lane's own write of a task naming labels it created, `write_labelled_task`, over\n+/// HTTP to a replay whose label filter holds one label only from its third lookup and never\n+/// holds the other: the first is resolved once held and written with its id, and the second\n+/// ends, once the bound is spent, in the refusal the plugin gives — with no label created and\n+/// no issue written for it.\n+#[tokio::test]\n+async fn a_task_write_naming_a_label_linear_holds_late_resolves_it_and_one_never_held_is_refused() {\n+    const BOUND: Bound = Bound {\n+        reads: 4,\n+        interval: std::time::Duration::from_millis(20),\n+    };\n+    let replay = replay();\n+    let stamp = now_micros();\n+    let late = artifact_label(Run::current(), stamp);\n+    let never = artifact_label(Run::current(), stamp + 1);\n+    {\n+        let mut state = replay.state.lock().unwrap();\n+        state.labels.insert(late.clone(), (\"label-late\".into(), 2));\n+        state\n+            .labels\n+            .insert(never.clone(), (\"label-never\".into(), u32::MAX));\n+    }\n+    let source = onetaskgraph_linear::Plugin\n+        .build(\n+            &SourceName::new(\"live\").unwrap(),\n+            &json!({\"endpoint\":replay.endpoint,\"team\":\"ENG\",\"status_mapping\":{\"todo\":{\"task\":\"Todo\"}}}),\n+            &ReplaySecrets,\n+        )\n+        .unwrap();\n+    let write = |name: &str, offset: u64| -> ItemWrite<Task> {\n+        let mut task: Task = serde_json::from_value(json!({\n+            \"id\":\"authored:labelled\",\"title\":artifact_title(Run::current(), stamp + offset),\n+            \"content\":\"Synthetic labelled task.\",\"status\":{\"category\":\"todo\",\"name\":\"Todo\"},\n+            \"labels\":[],\"project\":null,\"repositories\":[],\"metadata\":{}\n+        }))\n+        .unwrap();\n+        task.labels = vec![label(name)];\n+        ItemWrite {\n+            target: None,\n+            item: task,\n+            depends_on: vec![],\n+        }\n+    };\n+    let creates = |replay: &document_replay::Replay| -> Vec<Value> {\n+        replay\n+            .state\n+            .lock()\n+            .unwrap()\n+            .requests\n+            .iter()\n+            .filter(|request| {\n+                request[\"query\"]\n+                    .as_str()\n+                    .is_some_and(|q| q.contains(\"issueCreate(\"))\n+            })\n+            .map(|request| request[\"variables\"][\"input\"][\"labelIds\"].clone())\n+            .collect()\n+    };\n+\n+    write_labelled_task(BOUND, source.as_ref(), &write(&late, 10))\n+        .await\n+        .expect(\"a label the filter holds within the bound is resolved and written\");\n+    let lookups = |name: &str| replay.state.lock().unwrap().label_lookups[&name.to_lowercase()];\n+    assert_eq!(\n+        lookups(&late),\n+        3,\n+        \"the write asks again until the label is held, and not once more\"\n+    );\n+    assert_eq!(\n+        creates(&replay),\n+        vec![json!([\"label-late\"])],\n+        \"one issue is written, naming the label once it was resolved\"\n+    );\n+\n+    let refusal = write_labelled_task(BOUND, source.as_ref(), &write(&never, 11))\n+        .await\n+        .expect_err(\"a label the filter never holds is refused once the bound is spent\");\n+    assert!(\n+        matches!(&refusal, SourceError::Refused { message }\n+            if *message == format!(\"source live cannot resolve label {never:?}: found 0 matches\")),\n+        \"the refusal past the bound is the plugin's own: {refusal:?}\"\n+    );\n+    assert_eq!(\n+        lookups(&never),\n+        BOUND.reads,\n+        \"the bound is every lookup made\"\n+    );\n+    assert_eq!(\n+        creates(&replay).len(),\n+        1,\n+        \"no issue is written for a label that was never resolved\"\n+    );\n+    let state = replay.state.lock().unwrap();\n+    assert!(\n+        state.requests.iter().all(|request| {\n+            let query = request[\"query\"].as_str().unwrap_or_default();\n+            !query.contains(\"issueLabel\") || query == onetaskgraph_linear::graphql::ISSUE_LABEL\n+        }),\n+        \"a label is only ever looked up, never created, renamed or removed\"\n+    );\n+    assert!(state.schema_errors.is_empty(), \"{:?}\", state.schema_errors);\n+}\n+\n+/// A label a live journey created and has not retired, through a cold ordinary CI pass that\n+/// prepares the standing set and a second pass queued after it: neither pass sends any request\n+/// that creates, renames or removes a label, and the plugin's lookup still resolves it after\n+/// both, so neither can have deleted or hidden it. (Residue clearing is driven over the same\n+/// label in `tests/sweep_gate.rs`.)\n+#[tokio::test]\n+async fn standing_set_preparation_and_a_queued_pass_leave_a_live_journeys_label_resolvable() {\n+    let replay = replay();\n+    let held = artifact_label(Run::current(), now_micros());\n+    replay\n+        .state\n+        .lock()\n+        .unwrap()\n+        .labels\n+        .insert(held.clone(), (\"label-held\".into(), 0));\n+    let standing_ids = std::sync::Mutex::new(None);\n+    replay_ordinary_ci_pass(&replay, now_micros(), &standing_ids).await;\n+    let cold = replay.journal.count();\n+    assert!(cold > 0, \"the first pass prepared the standing set cold\");\n+    replay_ordinary_ci_pass(&replay, now_micros(), &standing_ids).await;\n+    assert_eq!(\n+        replay.journal.count(),\n+        cold,\n+        \"the queued pass reused the standing set\"\n+    );\n+    assert!(\n+        replay\n+            .state\n+            .lock()\n+            .unwrap()\n+            .requests\n+            .iter()\n+            .all(|request| !request[\"query\"]\n+                .as_str()\n+                .unwrap_or_default()\n+                .contains(\"issueLabel\")),\n+        \"preparation and the passes over the standing set touched no label\"\n+    );\n+    let source = onetaskgraph_linear::Plugin\n+        .build(\n+            &SourceName::new(\"live\").unwrap(),\n+            &json!({\"endpoint\":replay.endpoint,\"team\":\"ENG\",\"status_mapping\":{\"todo\":{\"task\":\"Todo\"}}}),\n+            &ReplaySecrets,\n+        )\n+        .unwrap();\n+    let mut task: Task = serde_json::from_value(json!({\n+        \"id\":\"authored:labelled\",\"title\":artifact_title(Run::current(), now_micros()),\n+        \"content\":\"Synthetic labelled task.\",\"status\":{\"category\":\"todo\",\"name\":\"Todo\"},\n+        \"labels\":[],\"project\":null,\"repositories\":[],\"metadata\":{}\n+    }))\n+    .unwrap();\n+    task.labels = vec![label(&held)];\n+    write_labelled_task(\n+        Bound {\n+            reads: 1,\n+            interval: std::time::Duration::ZERO,\n+        },\n+        source.as_ref(),\n+        &ItemWrite {\n+            target: None,\n+            item: task,\n+            depends_on: vec![],\n         },\n     )\n     .await\n-    .unwrap_or_else(|error| panic!(\"Linear live capability journey failed: {error}\"));\n+    .expect(\"the live journey's label still resolves on the first lookup after both passes\");\n+    assert!(replay.state.lock().unwrap().schema_errors.is_empty());\n }"},{"sha":"a09e97b14352f33aca072a552c18cdb919fa97ca","filename":"crates/onetaskgraph-linear/tests/live_artifact.rs","status":"added","additions":121,"deletions":0,"changes":121,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Flive_artifact.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Flive_artifact.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Flive_artifact.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,121 @@\n+use onetaskgraph_linear::live_artifact::{Scope, Slot, classify_retained, retained_title};\n+use onetaskgraph_live::artifact::{Run, Stamp};\n+use std::num::NonZeroU32;\n+\n+#[test]\n+fn retained_identity_round_trips_without_overlapping_scopes() {\n+    for slot in [\n+        Slot::Filed,\n+        Slot::Loose,\n+        Slot::FollowUp,\n+        Slot::Assets,\n+        Slot::Parent,\n+    ] {\n+        for scope in [\n+            Scope::ci(\"TEST\").unwrap(),\n+            Scope::local(\"TEST\", \"1-2-3\").unwrap(),\n+        ] {\n+            let title = retained_title(scope, slot).unwrap();\n+            let found = classify_retained(&title).unwrap();\n+            assert_eq!(found.scope, scope);\n+            assert_eq!(found.slot, slot);\n+            assert_eq!(found.scope.team(), \"TEST\");\n+            assert_eq!(found.scope.is_ci(), found.scope.local_stamp().is_none());\n+        }\n+    }\n+}\n+\n+#[test]\n+fn malformed_ownership_confers_no_authority() {\n+    let good = retained_title(Scope::ci(\"TEST\").unwrap(), Slot::Filed).unwrap();\n+    for bad in [\n+        format!(\"{good} \"),\n+        good.replace(\"retained-v1\", \"retained-v2\"),\n+        good.replace(\"filed\", \"unknown\"),\n+        good.replace(\"TEST\", \"test\"),\n+        format!(\"{good} 1-2-3\"),\n+    ] {\n+        assert!(classify_retained(&bad).is_none(), \"{bad}\");\n+    }\n+    for team in [\"\", \"test\", \"TEST team\", \"TEST\\n\", \"TÉST\"] {\n+        assert!(Scope::ci(team).is_err());\n+        assert!(Scope::local(team, \"1-2-3\").is_err());\n+    }\n+    for stamp in [\n+        \"ci-1-2-3\",\n+        \"+1-2-3\",\n+        \"1-+2-3\",\n+        \"0-2-3\",\n+        \"1-0-3\",\n+        \"1-2-0\",\n+        \"01-2-3\",\n+        \"1-2-3-4\",\n+        \"4294967296-2-3\",\n+    ] {\n+        assert!(Scope::local(\"TEST\", stamp).is_err());\n+    }\n+}\n+\n+#[test]\n+fn local_grammar_matches_canonical_positive_vouched_live_stamps_at_every_boundary() {\n+    // Stamp deliberately also admits unvouched host zero, timestamp zero and padded\n+    // decimal input. Retention requires positive ownership and its exact canonical display.\n+    let runs = [\n+        \"\",\n+        \"0\",\n+        \"1\",\n+        \"01\",\n+        \"4294967295\",\n+        \"4294967296\",\n+        \"18446744073709551615\",\n+        \"+1\",\n+        \"-1\",\n+        \"a\",\n+    ];\n+    let times = [\n+        \"\",\n+        \"0\",\n+        \"1\",\n+        \"01\",\n+        \"18446744073709551615\",\n+        \"18446744073709551616\",\n+        \"+1\",\n+        \"-1\",\n+        \"a\",\n+    ];\n+    for host in runs {\n+        for process in runs {\n+            for micros in times {\n+                let spelling = format!(\"{host}-{process}-{micros}\");\n+                let expected = Stamp::read(&spelling).is_some_and(|stamp| {\n+                    stamp.run().host().is_some()\n+                        && stamp.micros() > 0\n+                        && stamp.to_string() == spelling\n+                });\n+                assert_eq!(\n+                    Scope::local(\"TEST\", &spelling).is_ok(),\n+                    expected,\n+                    \"{spelling}\"\n+                );\n+                let title =\n+                    format!(\"onetaskgraph live cleanup retained-v1 local TEST filed {spelling}\");\n+                assert_eq!(classify_retained(&title).is_some(), expected, \"{spelling}\");\n+            }\n+        }\n+    }\n+    for host in [1, u32::MAX] {\n+        for process in [1, u32::MAX] {\n+            for micros in [1, u64::MAX] {\n+                let stamp = Stamp::new(\n+                    Run::vouched(\n+                        NonZeroU32::new(host).unwrap(),\n+                        NonZeroU32::new(process).unwrap(),\n+                    ),\n+                    micros,\n+                )\n+                .to_string();\n+                assert!(Scope::local(\"TEST\", &stamp).is_ok(), \"{stamp}\");\n+            }\n+        }\n+    }\n+}"},{"sha":"62c350ab13fb694b8ea4577ea87981f10b5b1fde","filename":"crates/onetaskgraph-linear/tests/settle/mod.rs","status":"modified","additions":83,"deletions":9,"changes":92,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fsettle%2Fmod.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fsettle%2Fmod.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fsettle%2Fmod.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -17,7 +17,9 @@\n //! resolve uniquely a label it had created a moment before — so a label the journey creates is\n //! waited for too, through that very lookup. One answer is not enough: a later run's wait saw\n //! the label once, and the plugin's own lookup a moment after it was answered with none, so\n-//! the wait holds out for [`LABEL_STEADY`] answers in a row.\n+//! the wait holds out for [`LABEL_STEADY`] answers in a row. Even that run of answers was once\n+//! followed by the plugin's lookup finding none, so the journey's labelled writes go through\n+//! [`resolving_labels`] too, which sends a write refused for that reason again within a bound.\n //!\n //! A single read lags too: [`token_moved`] reads a task again while its change token has not\n //! yet moved past the read before a change, within [`LINEAR_REPLICA`].\n@@ -27,7 +29,7 @@ use std::future::Future;\n use std::time::{Duration, Instant};\n \n use onetaskgraph_plugin_api::{\n-    DocumentQuery, NativeId, PageRequest, ProjectQuery, Task, TaskQuery, TaskSource,\n+    DocumentQuery, NativeId, PageRequest, ProjectQuery, SourceError, Task, TaskQuery, TaskSource,\n };\n use serde_json::{Value, json};\n \n@@ -274,7 +276,14 @@ pub async fn settled_tasks(\n     .await\n }\n \n-/// [`settled`] over the set a walk in pages of one reaches.\n+/// A walk in pages of one that reaches, in order, exactly what one whole page of fifty reports,\n+/// once that page holds `expected` — read as a pair, again while either disagrees.\n+///\n+/// A walk compared once against a page read once is two listings racing the index: a run\n+/// had a walk settle on all three of its issues and the very next walk come back with none,\n+/// while a whole page between them reported all three. Each attempt therefore reads the\n+/// page and then walks, and passes only when the page holds `expected` and the walk reached\n+/// the page's rows in the page's order. An `Err` names the last pair once `bound` is spent.\n pub async fn settled_walk(\n     bound: Bound,\n     source: &dyn TaskSource,\n@@ -283,12 +292,41 @@ pub async fn settled_walk(\n     what: &str,\n     expected: &[String],\n ) -> Result<(), String> {\n-    settled(bound, what, expected, || async move {\n-        let mut walked = walked_task_titles(source, query, most, what).await?;\n-        walked.sort();\n-        Ok(walked)\n-    })\n-    .await\n+    let mut expected = expected.to_vec();\n+    expected.sort();\n+    let started = Instant::now();\n+    let mut reads = 0;\n+    loop {\n+        let whole = source\n+            .query_tasks(\n+                query,\n+                &PageRequest {\n+                    cursor: None,\n+                    limit: 50,\n+                },\n+            )\n+            .await\n+            .map_err(|error| format!(\"{what} could not read its whole page: {error}\"))?\n+            .items\n+            .into_iter()\n+            .map(|task| task.title)\n+            .collect::<Vec<_>>();\n+        let walked = walked_task_titles(source, query, most, what).await?;\n+        reads += 1;\n+        let mut held = whole.clone();\n+        held.sort();\n+        if held == expected && walked == whole {\n+            return Ok(());\n+        }\n+        if reads >= bound.reads {\n+            return Err(format!(\n+                \"{what} reached {walked:?} where one whole page reports {whole:?} rather than \\\n+                 {expected:?}, still after {reads} reads over {:?}\",\n+                started.elapsed()\n+            ));\n+        }\n+        tokio::time::sleep(bound.interval).await;\n+    }\n }\n \n /// The root field `graphql::ISSUE_LABEL` answers under, whose `nodes` are the labels it found.\n@@ -375,6 +413,42 @@ where\n     }\n }\n \n+/// Whether `error` is the plugin's refusal of a write naming a label its lookup found no match\n+/// for — the one answer index lag gives, and the only one [`resolving_labels`] asks again on.\n+pub fn label_unresolved(error: &SourceError) -> bool {\n+    matches!(\n+        error,\n+        SourceError::Refused { message }\n+            if message.contains(\" cannot resolve label \") && message.ends_with(\": found 0 matches\")\n+    )\n+}\n+\n+/// `write`, sent again while the plugin refuses it as finding no match for a label it names,\n+/// at most `bound.reads` times in all — and that same refusal once the bound is spent.\n+///\n+/// [`settled_label`] waits for [`LABEL_STEADY`] answers in a row before a write names a label,\n+/// and a run's first task write was still refused a moment later with no match for a label the\n+/// lookup had just answered three times: the filter's lag outlasts any run of answers, so the\n+/// write itself waits it out. Asking again is safe because the plugin resolves every label\n+/// before its first mutation, so a refused write sent nothing; a refusal of anything else,\n+/// two matches included, is returned at once, and no label is ever created here.\n+pub async fn resolving_labels<F, Fut, T>(bound: Bound, mut write: F) -> Result<T, SourceError>\n+where\n+    F: FnMut() -> Fut,\n+    Fut: Future<Output = Result<T, SourceError>>,\n+{\n+    let mut attempts = 0;\n+    loop {\n+        attempts += 1;\n+        match write().await {\n+            Err(error) if label_unresolved(&error) && attempts < bound.reads => {\n+                tokio::time::sleep(bound.interval).await;\n+            }\n+            answered => return answered,\n+        }\n+    }\n+}\n+\n /// Wait until a complete listing has exactly this run's expected documents.\n pub async fn settled_documents(\n     bound: Bound,"},{"sha":"f9d1f4e29f12a7fefe4205f147923f73416c5016","filename":"crates/onetaskgraph-linear/tests/settle_gate.rs","status":"modified","additions":87,"deletions":16,"changes":103,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fsettle_gate.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fsettle_gate.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fsettle_gate.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -37,7 +37,7 @@ use serde_json::{Value, json};\n mod settle;\n \n use settle::{\n-    Bound, DocumentListingBudget, LABEL_CONNECTION, LABEL_STEADY, LABEL_VARIABLE,\n+    Bound, DocumentListingBudget, LABEL_CONNECTION, LABEL_STEADY, LABEL_VARIABLE, resolving_labels,\n     settled_document_absent, settled_documents, settled_label, settled_tasks, settled_walk,\n     token_moved,\n };\n@@ -241,6 +241,11 @@ fn after_c1(request: &str) -> bool {\n     variables(request).get(\"after\") == Some(&json!(\"c1\"))\n }\n \n+/// Whether `request` is a page of a walk in pages of one rather than the whole page beside it.\n+fn is_walk(request: &str) -> bool {\n+    variables(request).get(\"first\") == Some(&json!(1))\n+}\n+\n fn under(project: &str) -> TaskQuery {\n     TaskQuery {\n         project: ProjectFilter::Is(NativeId(project.into())),\n@@ -559,15 +564,18 @@ async fn unfiltered_and_orphan_document_listings_read_past_other_documents() {\n \n #[tokio::test]\n async fn a_walk_in_pages_of_one_the_index_catches_up_with_late_passes_without_walking_again() {\n-    // The first walk finds the index empty; every walk after it reaches both issues, one a page.\n+    // The whole page reports both issues from the start; the first walk finds the index empty,\n+    // as a live run's walk did right after an earlier walk had reached all three of its\n+    // issues, and every walk after it reaches both, one a page, in the page's order.\n     let walks = Arc::new(AtomicU32::new(0));\n     let seen = Arc::clone(&walks);\n     let (source, answered) = workspace(move |_, request| {\n-        assert_eq!(\n-            variables(request).get(\"first\"),\n-            Some(&json!(1)),\n-            \"a walk asks for pages of one: {request}\"\n-        );\n+        if !is_walk(request) {\n+            return issues(vec![\n+                issue(\"i1\", \"first\", \"p1\"),\n+                issue(\"i2\", \"second\", \"p1\"),\n+            ]);\n+        }\n         if after_c1(request) {\n             return issues(vec![issue(\"i2\", \"second\", \"p1\")]);\n         }\n@@ -594,16 +602,22 @@ async fn a_walk_in_pages_of_one_the_index_catches_up_with_late_passes_without_wa\n     );\n     assert_eq!(\n         answered.load(Ordering::SeqCst),\n-        3,\n-        \"the empty walk's one page, then both pages of the walk that agrees\"\n+        5,\n+        \"a whole page and the empty walk's one page, then a whole page and both pages of the \\\n+         walk that agrees\"\n     );\n }\n \n #[tokio::test]\n async fn a_walk_that_never_reaches_the_expected_set_fails_within_the_bound_naming_what_it_reached()\n {\n     let (source, answered) = workspace(|_, request| {\n-        if after_c1(request) {\n+        if !is_walk(request) {\n+            issues(vec![\n+                issue(\"i1\", \"first\", \"p1\"),\n+                issue(\"i3\", \"stranger\", \"p2\"),\n+            ])\n+        } else if after_c1(request) {\n             issues(vec![issue(\"i3\", \"stranger\", \"p2\")])\n         } else {\n             issues_then(vec![issue(\"i1\", \"first\", \"p1\")], \"c1\")\n@@ -623,18 +637,52 @@ async fn a_walk_that_never_reaches_the_expected_set_fails_within_the_bound_namin\n     let waited = started.elapsed();\n     assert!(\n         refusal.starts_with(\n-            r#\"a walk in pages of one came back as [\"first\", \"stranger\"] rather than [\"first\", \"second\"], still after 5 reads\"#\n+            r#\"a walk in pages of one reached [\"first\", \"stranger\"] where one whole page reports [\"first\", \"stranger\"] rather than [\"first\", \"second\"], still after 5 reads\"#\n         ),\n-        \"the failure names what the walk reached: {refusal}\"\n+        \"the failure names what the walk and the page reached: {refusal}\"\n     );\n-    assert_eq!(answered.load(Ordering::SeqCst), 2 * BOUND.reads);\n+    assert_eq!(answered.load(Ordering::SeqCst), 3 * BOUND.reads);\n     assert!(\n         waited >= BOUND.interval * (BOUND.reads - 1)\n             && waited < BOUND.interval * BOUND.reads + SLACK,\n         \"a wrong walk fails once the bound is spent, and waited {waited:?}\"\n     );\n }\n \n+#[tokio::test]\n+async fn a_walk_reaching_the_expected_set_out_of_the_whole_pages_order_fails_naming_both() {\n+    // The set agrees, so only the order can refuse it.\n+    let (source, answered) = workspace(|_, request| {\n+        if !is_walk(request) {\n+            issues(vec![\n+                issue(\"i2\", \"second\", \"p1\"),\n+                issue(\"i1\", \"first\", \"p1\"),\n+            ])\n+        } else if after_c1(request) {\n+            issues(vec![issue(\"i2\", \"second\", \"p1\")])\n+        } else {\n+            issues_then(vec![issue(\"i1\", \"first\", \"p1\")], \"c1\")\n+        }\n+    });\n+    let refusal = settled_walk(\n+        BOUND,\n+        source.as_ref(),\n+        &under(\"p1\"),\n+        10,\n+        \"a walk in pages of one\",\n+        &[\"first\".to_owned(), \"second\".to_owned()],\n+    )\n+    .await\n+    .unwrap_err();\n+    assert!(\n+        refusal.starts_with(\n+            r#\"a walk in pages of one reached [\"first\", \"second\"] where one whole page reports [\"second\", \"first\"] rather than [\"first\", \"second\"], still after 5 reads\"#\n+        ),\n+        \"the failure names the walk's order and the page's: {refusal}\"\n+    );\n+    assert_eq!(answered.load(Ordering::SeqCst), 3 * BOUND.reads);\n+}\n+\n #[test]\n fn the_label_wait_names_the_root_field_and_the_variable_of_the_plugins_own_lookup() {\n     use graphql_parser::query;\n@@ -789,6 +837,24 @@ async fn a_label_two_labels_answer_to_is_refused_at_once_with_their_ids() {\n     assert!(started.elapsed() < BOUND.interval + SLACK);\n }\n \n+#[tokio::test]\n+async fn a_write_refused_for_a_duplicate_label_is_not_sent_again() {\n+    // Only the no-match refusal is index lag; two matches never settle, so the write that\n+    // `resolving_labels` wraps is sent once and its refusal returned as it came.\n+    let sent = AtomicU32::new(0);\n+    let duplicate = || {\n+        sent.fetch_add(1, Ordering::SeqCst);\n+        async {\n+            Err::<(), _>(onetaskgraph_plugin_api::SourceError::Refused {\n+                message: r#\"source live cannot resolve label \"otg-live-label\": found 2 matches with ids [\"l1\", \"l2\"]\"#.into(),\n+            })\n+        }\n+    };\n+    let refusal = resolving_labels(BOUND, duplicate).await.unwrap_err();\n+    assert!(refusal.to_string().contains(\"found 2 matches\"), \"{refusal}\");\n+    assert_eq!(sent.load(Ordering::SeqCst), 1);\n+}\n+\n #[tokio::test]\n async fn a_label_lookup_that_cannot_be_read_fails_at_once_rather_than_waiting() {\n     let (url, answered) = serve(|_, _| json!({\"issueLabels\": null}));\n@@ -872,8 +938,9 @@ async fn a_walk_given_more_than_one_row_on_a_page_of_one_fails_at_once() {\n     );\n     assert_eq!(\n         answered.load(Ordering::SeqCst),\n-        1,\n-        \"a page past its limit is not an index catching up, so it is not read again\"\n+        2,\n+        \"the whole page, then a walk page past its limit, which is not an index catching up, \\\n+         so it is not read again\"\n     );\n     assert!(started.elapsed() < BOUND.interval + SLACK);\n }\n@@ -895,7 +962,11 @@ async fn a_walk_that_does_not_end_fails_at_its_page_bound_naming_what_it_reached\n         refusal,\n         r#\"a walk in pages of one had not ended after 3 pages, having reached [\"first\", \"first\", \"first\"]\"#\n     );\n-    assert_eq!(answered.load(Ordering::SeqCst), 3);\n+    assert_eq!(\n+        answered.load(Ordering::SeqCst),\n+        1 + 3,\n+        \"the whole page, then three walk pages\"\n+    );\n }\n \n #[tokio::test]"},{"sha":"4547615312320aa0093156335215a01d9a9c5b5b","filename":"crates/onetaskgraph-linear/tests/sweep_gate.rs","status":"modified","additions":158,"deletions":0,"changes":158,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fsweep_gate.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fsweep_gate.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fsweep_gate.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -540,6 +540,164 @@ async fn this_runs_own_cleanup_removes_everything_it_wrote_and_nothing_else() {\n     );\n }\n \n+fn retained_entities(\n+    scope: onetaskgraph_linear::live_artifact::Scope<'_>,\n+    tag: &str,\n+) -> Vec<Entity> {\n+    use onetaskgraph_linear::live_artifact::{Slot, retained_title};\n+    [\n+        Slot::Filed,\n+        Slot::Loose,\n+        Slot::FollowUp,\n+        Slot::Assets,\n+        Slot::Parent,\n+    ]\n+    .into_iter()\n+    .enumerate()\n+    .map(|(index, slot)| Entity {\n+        kind: if slot == Slot::Parent {\n+            \"project\"\n+        } else {\n+            \"document\"\n+        },\n+        id: format!(\"{tag}-{index}\"),\n+        name: retained_title(scope, slot).unwrap(),\n+    })\n+    .collect()\n+}\n+\n+#[tokio::test]\n+async fn retained_ci_survives_even_broad_cleanup_and_local_sets_retire_by_registration() {\n+    use onetaskgraph_linear::live_artifact::Scope;\n+    let mut beside = LiveRunBeside::start();\n+    let ci = retained_entities(Scope::ci(\"TEST\").unwrap(), \"ci\");\n+    let local_stamp = onetaskgraph_live::artifact::Stamp::new(beside.run, aged(10)).to_string();\n+    let local = retained_entities(Scope::local(\"TEST\", &local_stamp).unwrap(), \"local\");\n+    let unknown = Entity {\n+        kind: \"document\",\n+        id: \"unknown\".into(),\n+        name: \"onetaskgraph live cleanup retained-v2 ci TEST filed\".into(),\n+    };\n+    let drive = Drive::plant(\n+        [ci.clone(), local.clone(), vec![unknown.clone()]].concat(),\n+        vec![],\n+        vec![],\n+    );\n+    cleanup::sweep_orphans(KEY, &sweep_at(NOW)).await.unwrap();\n+    assert_eq!(\n+        drive.left(),\n+        sorted(\n+            [ci.clone(), local.clone(), vec![unknown.clone()]]\n+                .concat()\n+                .into_iter()\n+                .map(|entity| entity.name)\n+                .collect()\n+        )\n+    );\n+    beside.end();\n+    cleanup::sweep_orphans(KEY, &sweep_at(NOW)).await.unwrap();\n+    assert_eq!(\n+        drive.left(),\n+        sorted(\n+            [ci.clone(), vec![unknown.clone()]]\n+                .concat()\n+                .into_iter()\n+                .map(|entity| entity.name)\n+                .collect()\n+        )\n+    );\n+    // A cancellation cleanup naming all stamped objects still cannot retire CI slots.\n+    cleanup::remove_artifacts(KEY, &|_, _| true).await.unwrap();\n+    assert_eq!(\n+        drive.left(),\n+        sorted(\n+            [ci, vec![unknown]]\n+                .concat()\n+                .into_iter()\n+                .map(|entity| entity.name)\n+                .collect()\n+        )\n+    );\n+}\n+\n+#[tokio::test]\n+async fn retained_local_set_retires_at_its_own_invocation_cleanup() {\n+    use onetaskgraph_linear::live_artifact::Scope;\n+    let stamp = onetaskgraph_live::artifact::Stamp::new(RUNS.mine, NOW).to_string();\n+    let mine = retained_entities(Scope::local(\"TEST\", &stamp).unwrap(), \"mine\");\n+    let ci = retained_entities(Scope::ci(\"TEST\").unwrap(), \"ci\");\n+    let drive = Drive::plant([mine, ci.clone()].concat(), vec![], vec![]);\n+    cleanup::remove_artifacts(KEY, &|prefix, name| is_this_runs(RUNS.mine, prefix, name))\n+        .await\n+        .unwrap();\n+    assert_eq!(\n+        drive.left(),\n+        sorted(ci.into_iter().map(|entity| entity.name).collect())\n+    );\n+}\n+\n+#[tokio::test]\n+async fn residue_clearing_and_a_second_pass_never_take_a_live_journeys_label() {\n+    // The label a live journey created and has not retired — stamped three windows ago, so its\n+    // run's live registration and not its age is what must keep it — beside every kind of\n+    // record the residue clearing this branch reworked decides about: an old standing CI set,\n+    // an ended run's local set and an ended run's own label. The clearing at the end of a pass\n+    // and the own-run cleanup of a second pass queued after it both run over it, and the label\n+    // is still there, under the same id and name, so neither deleted, renamed or hid it.\n+    use onetaskgraph_linear::live_artifact::Scope;\n+    let mut beside = LiveRunBeside::start();\n+    let ended = ended_run();\n+    let in_flight = Entity {\n+        kind: \"label\",\n+        id: \"in-flight\".into(),\n+        name: artifact_label(beside.run, aged(3)),\n+    };\n+    let ended_label = Entity {\n+        kind: \"label\",\n+        id: \"ended\".into(),\n+        name: artifact_label(ended, aged(2)),\n+    };\n+    let ci = retained_entities(Scope::ci(\"TEST\").unwrap(), \"ci\");\n+    let ended_stamp = onetaskgraph_live::artifact::Stamp::new(ended, aged(2)).to_string();\n+    let ended_local = retained_entities(Scope::local(\"TEST\", &ended_stamp).unwrap(), \"local\");\n+    let drive = Drive::plant(\n+        [\n+            vec![in_flight.clone(), ended_label],\n+            ci.clone(),\n+            ended_local,\n+        ]\n+        .concat(),\n+        vec![],\n+        vec![],\n+    );\n+    cleanup::sweep_orphans(KEY, &sweep_at(NOW)).await.unwrap();\n+    let run = RUNS.mine;\n+    cleanup::remove_artifacts(KEY, &|prefix, name| is_this_runs(run, prefix, name))\n+        .await\n+        .unwrap();\n+    assert_eq!(\n+        drive.left(),\n+        sorted(\n+            [vec![in_flight.clone()], ci]\n+                .concat()\n+                .into_iter()\n+                .map(|entity| entity.name)\n+                .collect()\n+        ),\n+        \"residue clearing took the live journey's label, or left what an ended run wrote\"\n+    );\n+    assert!(\n+        STANDIN\n+            .lock()\n+            .unwrap_or_else(|poisoned| poisoned.into_inner())\n+            .entities\n+            .iter()\n+            .any(|entity| entity.id == in_flight.id && entity.name == in_flight.name),\n+        \"the live journey's label keeps its id and name\"\n+    );\n+    beside.end();\n+}\n+\n #[tokio::test]\n async fn residue_a_delete_never_takes_fails_the_cleanup_rather_than_passing_quietly() {\n     // The other side of the tolerance, and the side that has to stay sharp. A delete refused"},{"sha":"49ef00f9dff3bcdf610e8c6dc90c689658d7dd84","filename":"crates/onetaskgraph-live-janitor/src/linear.rs","status":"modified","additions":5,"deletions":1,"changes":6,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-live-janitor%2Fsrc%2Flinear.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-live-janitor%2Fsrc%2Flinear.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-live-janitor%2Fsrc%2Flinear.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -15,7 +15,7 @@ use crate::{Clock, GRAPHQL_READ_LIMIT, RealClock, Report, WRITE_INTERVAL, WRITE_\n \n pub use onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX as DOCUMENT_PREFIX;\n pub const DOCUMENT_MAX_AGE: Duration = Duration::from_secs(24 * 60 * 60);\n-pub const DOCUMENTS: &str = \"query($after:String,$filter:DocumentFilter!){documents(first:100,after:$after,filter:$filter){nodes{id title team{key} project{teams(first:100){nodes{key} pageInfo{hasNextPage}}}} pageInfo{hasNextPage endCursor}}}\";\n+pub const DOCUMENTS: &str = \"query($after:String,$filter:DocumentFilter!){documents(first:100,after:$after,filter:$filter){nodes{id title team{key} project{teams(first:2){nodes{key} pageInfo{hasNextPage}}}} pageInfo{hasNextPage endCursor}}}\";\n pub const DELETE_DOCUMENT: &str = \"mutation($id:String!){documentDelete(id:$id){success}}\";\n \n fn valid_text(value: String) -> Result<String, String> {\n@@ -245,6 +245,10 @@ async fn request<V: Serialize, T: DeserializeOwned>(\n }\n \n fn old_test_title(title: &str, now: u64) -> bool {\n+    // Retained sets retire only through their invocation registration, never by age.\n+    if onetaskgraph_linear::live_artifact::classify_retained(title).is_some() {\n+        return false;\n+    }\n     let Some(suffix) = title.strip_prefix(DOCUMENT_PREFIX) else {\n         return false;\n     };"},{"sha":"70e16d5e86a78af076d5ca958aa1f6ece95fae68","filename":"crates/onetaskgraph-live-janitor/tests/linear_journey.py","status":"modified","additions":16,"deletions":1,"changes":17,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-live-janitor%2Ftests%2Flinear_journey.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-live-janitor%2Ftests%2Flinear_journey.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-live-janitor%2Ftests%2Flinear_journey.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -180,7 +180,7 @@ def answer(self, request: Request) -> dict[str, Any]:\n             self.deleted.append(identifier)\n             return json.loads((Path(__file__).parent / 'fixtures/linear-document-delete.json').read_text())\n         assert 'team{key}' in request['query']\n-        assert 'project{teams(first:100)' in request['query']\n+        assert 'project{teams(first:2)' in request['query']\n         # read_request validated the listing shape; Python cannot narrow a TypedDict union by query text.\n         variables = cast(ListingVariables, request['variables'])\n         assert variables['filter']['title']['startsWith'] == 'onetaskgraph live cleanup '\n@@ -323,6 +323,21 @@ def test_stale_test_documents_removed_and_other_documents_preserved(self) -> Non\n         self.assertIn('0 REST reads, 2 GraphQL queries, 3 content writes', result.stdout)\n         self.assertIn('[0, 1000000, 2000000]', result.stdout)\n \n+    def test_retained_sets_never_expire_by_age(self) -> None:\n+        workspace = Workspace()\n+        sample = workspace.pages[0].data.documents.nodes[0]\n+        prefix = 'onetaskgraph live cleanup retained-v1 '\n+        titles = [prefix + 'ci TEST ' + slot for slot in ['filed', 'loose', 'follow-up', 'assets']]\n+        titles += [prefix + 'local TEST filed 1-2-3',\n+                   prefix + 'ci TEST unknown', prefix + 'ci OTHER filed']\n+        workspace.pages[0].data.documents.nodes = [\n+            replace(sample, id=DocumentId(str(index)), title=title)\n+            for index, title in enumerate(titles)]\n+        workspace.pages[1].data.documents.nodes = []\n+        result = self.run_janitor(workspace)\n+        self.assertEqual(result.returncode, 0, result.stderr)\n+        self.assertEqual(workspace.deleted, [])\n+\n     def test_direct_team_precedes_project_and_unvouched_documents_survive(self) -> None:\n         workspace = Workspace()\n         sample = workspace.pages[0].data.documents.nodes[0]"},{"sha":"2fbdec824a32693c76bcb4fa246a74228ed5eaf6","filename":"crates/onetaskgraph-live-janitor/tests/schema.rs","status":"modified","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-live-janitor%2Ftests%2Fschema.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-live-janitor%2Ftests%2Fschema.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-live-janitor%2Ftests%2Fschema.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -235,6 +235,26 @@ fn a_field_github_does_not_have_is_refused() {\n     }\n }\n \n+// The one statement of Linear's complexity model, shared with the Linear lanes' replays; the\n+// janitor depends on that crate, so a change there selects these tests too.\n+#[path = \"../../onetaskgraph-linear/tests/document_lifecycle/complexity.rs\"]\n+mod complexity;\n+\n+/// Schema validation cannot see Linear's complexity cap, which refuses a document over it\n+/// with HTTP 400.\n+#[test]\n+fn linear_documents_stay_under_linears_complexity_cap() {\n+    use onetaskgraph_live_janitor::linear::{DELETE_DOCUMENT, DOCUMENTS};\n+    let variables = serde_json::json!({\"after\":null,\"filter\":{},\"id\":\"d\"});\n+    for document in [DOCUMENTS, DELETE_DOCUMENT] {\n+        assert_eq!(\n+            complexity::refusal(document, &variables),\n+            None,\n+            \"{document}\"\n+        );\n+    }\n+}\n+\n #[test]\n fn linear_documents_match_the_pinned_upstream_schema() {\n     use onetaskgraph_live_janitor::linear::{DELETE_DOCUMENT, DOCUMENTS};"},{"sha":"1a9b478659044cd316ef268ed051abf560ad06d3","filename":"crates/onetaskgraph-live/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-live%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-live%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-live%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -4,7 +4,7 @@ description = \"The one gate every live test in this workspace passes through bef\n # Not published: this is the workspace's own test-support crate, and the plugin crates name\n # it as a path-only dev-dependency, which cargo strips when it packages them.\n # llmlint: ignore[crates_stay_in_one_cargo_workspace] A literal rather than `version.workspace = true` because that is what all eight of this workspace's crate manifests spell, and because the release tooling reads a number here: `scripts/set-version.sh` writes this line through `scripts/product_versions.py`, and `--check` reads it back and refuses any value but the workspace's — a command of `distribution-check`, which is part of the required `check`. So the two cannot drift, and a ninth crate spelling it a second way would be the one manifest that tooling has to learn an exception for.\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n publish = false\n edition.workspace = true\n rust-version.workspace = true"},{"sha":"0017c9e7408a5c206366a4ba7afb0e30920fb330","filename":"crates/onetaskgraph-local-md/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-local-md%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-local-md%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-local-md%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n [package]\n name = \"onetaskgraph-local-md\"\n description = \"A onetaskgraph source over Markdown task files on the local filesystem.\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n edition.workspace = true\n rust-version.workspace = true\n license.workspace = true"},{"sha":"d3b18a9a5aac1471f3eee3274b6a6d2985608cc3","filename":"crates/onetaskgraph-plugin-api/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-plugin-api%2FCHANGELOG.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-plugin-api%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-plugin-api%2FCHANGELOG.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.12.12...onetaskgraph-plugin-api-v0.12.13) - 2026-10-30\n+\n+### Added\n+\n+- project human tasks through existing tracker routing ([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n+\n ## [0.12.11](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.12.10...onetaskgraph-plugin-api-v0.12.11) - 2026-10-29\n \n ### Fixed"},{"sha":"f0eeab7902fc1919c183795d74693fe82fe3f0f0","filename":"crates/onetaskgraph-plugin-api/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-plugin-api%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-plugin-api%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-plugin-api%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n [package]\n name = \"onetaskgraph-plugin-api\"\n description = \"The plugin contract onetaskgraph sources implement: the traits, the work types, and the capability declaration.\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n edition.workspace = true\n rust-version.workspace = true\n license.workspace = true"},{"sha":"0a32992f17b076f067bd8d9ecbb3a272c655ccda","filename":"crates/onetaskgraph-plugin-api/src/source.rs","status":"modified","additions":46,"deletions":0,"changes":46,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-plugin-api%2Fsrc%2Fsource.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-plugin-api%2Fsrc%2Fsource.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-plugin-api%2Fsrc%2Fsource.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -315,6 +315,52 @@ pub trait TaskSource: Send + Sync {\n         false\n     }\n \n+    /// What this source read in this process about where it creates — the node ids of the\n+    /// repository it filed in — under a setup-context token, or `None`.\n+    ///\n+    /// The token is the source's own digest of every input the context depends on: the\n+    /// container's field definitions and options, the repository it creates in, the project it\n+    /// files under and the visibility it was declared. Immutable placement knowledge only: it\n+    /// holds no item's title, content or membership, and nothing that authorizes a versioned\n+    /// write. Defaulted to `None`.\n+    fn placement_context(&self) -> Option<serde_json::Value> {\n+        None\n+    }\n+\n+    /// Hold `context`, which [`placement_context`](Self::placement_context) gave in an earlier\n+    /// process, for the next create to take only if its token still holds — computed from a\n+    /// read that create makes anyway, so taking it adds no request and a changed input is read\n+    /// afresh rather than reused. Answers whether it held it; a context this source cannot read\n+    /// is not held. Defaulted to holding nothing.\n+    fn prime_placement(&self, context: &serde_json::Value) -> bool {\n+        let _ = context;\n+        false\n+    }\n+\n+    /// The ids — never the title or the content — a later process needs to write task `id`,\n+    /// which this process wrote, without reading it first, or `None`. Defaulted to `None`.\n+    fn written_context(&self, id: &NativeId) -> Option<serde_json::Value> {\n+        let _ = id;\n+        None\n+    }\n+\n+    /// Take `context`, which [`written_context`](Self::written_context) gave, with `task`'s\n+    /// fields, as the record of `id` — so the next [`update_task`](Self::update_task) of it\n+    /// sends only its mutations. What the caller holds of the body is never written: an update\n+    /// that changes the body reads it first — in the answer to one of its own mutations where it\n+    /// can — and composes it against what the backend holds now. Answers whether it took them;\n+    /// a context it cannot read is not taken, and the update then reads as it always does.\n+    /// Defaulted to taking nothing.\n+    fn prime_written(\n+        &self,\n+        id: &NativeId,\n+        context: &serde_json::Value,\n+        task: &crate::Task,\n+    ) -> bool {\n+        let _ = (id, context, task);\n+        false\n+    }\n+\n     /// Drop whatever [`prime_write`](Self::prime_write) took for `id`, and the board context\n     /// with it, so the next write of it reads afresh.\n     fn unprime(&self, id: &NativeId) {"},{"sha":"63e47185665c7b589fff299af97d089f6067cf4c","filename":"crates/onetaskgraph-status-options/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-status-options%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-status-options%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-status-options%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n [package]\n name = \"onetaskgraph-status-options\"\n description = \"The guarded GitHub Projects Status-option operation.\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n edition.workspace = true\n rust-version.workspace = true\n license.workspace = true"},{"sha":"11acd3c0353b5c1cf8b98119dd5f023ebf42c017","filename":"crates/onetaskgraph/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph%2FCHANGELOG.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph%2FCHANGELOG.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/v0.12.12...v0.12.13) - 2026-10-30\n+\n+### Added\n+\n+- project human tasks through existing tracker routing ([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n+\n ## [0.12.9](https://github.com/nickderobertis/onetaskgraph/compare/v0.12.8...v0.12.9) - 2026-10-28\n \n ### Added"},{"sha":"db724bd4d0410d764dbbaaee11c969f8ca9da255","filename":"crates/onetaskgraph/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n [package]\n name = \"onetaskgraph\"\n description = \"One interface over the ticketing systems your work lives in.\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n edition.workspace = true\n rust-version.workspace = true\n license.workspace = true"},{"sha":"6106a38be833ca8e849c030b41bc73d4732b73c3","filename":"crates/onetaskgraph/src/cli.rs","status":"modified","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph%2Fsrc%2Fcli.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph%2Fsrc%2Fcli.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph%2Fsrc%2Fcli.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -443,6 +443,25 @@ pub enum TaskCommand {\n     /// Read through the task's source, so it works the same on every store that keeps assets;\n     /// a task holding none writes nothing. Under --json it prints the names it wrote, as a list.\n     Assets(TaskAssetsArgs),\n+    /// Project one human action item into its tracker, idempotently, by its `item_id`.\n+    ///\n+    /// The input is the v1 `HumanTaskProjection` document `onetaskgraph schema` publishes,\n+    /// and the answer the `HumanTaskProjected` one: the task, its canonical issue URL, its\n+    /// project and its source. The item is routed by the source's `purpose: human-task`\n+    /// routes and created at most once — a durable intent under the destination's\n+    /// `task_projection` directory is committed before the create is sent, so a retry after a\n+    /// lost answer binds the same issue or refuses, and never creates a second. A terminal\n+    /// state is written once and a conflicting one refused.\n+    // llmlint: ignore[new_command_or_client_gets_its_own_project] The approved design places the human projection verb in the existing CLI over the existing task-write engine, with no alternate tracker client, and the manager ruled (c-adcfc828) that it stays here rather than in a crate of its own; its journeys stay in the per-plugin e2e projects so selection stays targeted. A drafted follow-up weighs moving it.\n+    ProjectHuman(TaskProjectHumanArgs),\n+}\n+\n+/// `onetaskgraph task project-human`.\n+#[derive(Debug, Args)]\n+pub struct TaskProjectHumanArgs {\n+    /// The file holding the `HumanTaskProjection` request, or `-` for standard input.\n+    #[arg(long, value_name = \"FILE\")]\n+    pub input: std::path::PathBuf,\n }\n \n /// `onetaskgraph task assets`."},{"sha":"9007b8da7eeedab1ae7f80812be9ea068f46e3f0","filename":"crates/onetaskgraph/src/main.rs","status":"modified","additions":105,"deletions":0,"changes":105,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph%2Fsrc%2Fmain.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph%2Fsrc%2Fmain.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph%2Fsrc%2Fmain.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -640,6 +640,9 @@ async fn run(command: &Command, loaded: &Loaded, out: &mut impl Write) -> Result\n         Command::Task {\n             command: TaskCommand::Assets(args),\n         } => task_assets(out, loaded, args).await,\n+        Command::Task {\n+            command: TaskCommand::ProjectHuman(args),\n+        } => project_human(out, loaded, &args.input).await,\n         Command::Project {\n             command: ProjectCommand::Create(args),\n         } => rendered::create_project(out, loaded, args).await,\n@@ -1608,6 +1611,107 @@ async fn locate(\n     Ok(EXIT_OK)\n }\n \n+/// Project one human task from the request at `input`, refused before any source is\n+/// started when the request is not exactly a v1 `HumanTaskProjection`.\n+async fn project_human(\n+    out: &mut impl Write,\n+    loaded: &Loaded,\n+    input: &std::path::Path,\n+) -> Result<u8, Failure> {\n+    let (bytes, from) = if input.as_os_str() == \"-\" {\n+        let mut bytes = Vec::new();\n+        io::Read::read_to_end(&mut io::stdin().lock(), &mut bytes).map_err(|error| {\n+            Failure::decided(\n+                \"projection-input\",\n+                format!(\n+                    \"could not read the projection request from standard input: {error}\\n\\\n+                     next: pass it with --input FILE instead.\"\n+                ),\n+            )\n+        })?;\n+        (bytes, \"standard input\".to_owned())\n+    } else {\n+        let bytes = std::fs::read(input).map_err(|error| {\n+            Failure::decided(\n+                \"projection-input\",\n+                format!(\n+                    \"--input {}: could not read it: {error}\\n\\\n+                     next: name a readable file holding the request.\",\n+                    input.display()\n+                ),\n+            )\n+        })?;\n+        (bytes, format!(\"--input {}\", input.display()))\n+    };\n+    let request: onetaskgraph_core::task_projection::HumanTaskProjection =\n+        serde_json::from_slice(&bytes).map_err(|error| {\n+            Failure::decided(\n+                \"projection-input\",\n+                format!(\n+                    \"{from} is not a v1 HumanTaskProjection request: {error}\\n\\\n+                     next: send exactly the fields `onetaskgraph schema` publishes for \\\n+                     HumanTaskProjection; questions are not projected.\"\n+                ),\n+            )\n+        })?;\n+    let host = current_host().ok_or_else(|| {\n+        Failure::decided(\n+            \"projection-host\",\n+            \"this host's name could not be read\\n\\\n+             next: set ONETASKGRAPH_HOST to the host a source's task_projection names.\"\n+                .to_owned(),\n+        )\n+    })?;\n+    // A host no source names is refused here, from the configuration alone, before any\n+    // source is started: the comparison is the configured spelling against this one, so it\n+    // answers alike whatever the platform's own host-name conventions are.\n+    if !loaded.config.sources().values().any(|source| {\n+        source\n+            .task_projection()\n+            .is_some_and(|projection| projection.host.as_str() == host)\n+    }) {\n+        return Err(Failure::decided(\n+            \"projection-host\",\n+            format!(\n+                \"host {host:?} is not the host any source's task_projection names\\n\\\n+                 next: run this on the host sources.<name>.task_projection.host names, or set \\\n+                 ONETASKGRAPH_HOST to it.\"\n+            ),\n+        ));\n+    }\n+    let engine = engine(loaded);\n+    let projected = engine\n+        .project_human(&request, &host)\n+        .await\n+        .map_err(|error| write_failed(&engine, &error))?;\n+    let rendered = rendering(\n+        loaded,\n+        &projected,\n+        |projected| format!(\"{} {}\", projected.task(), projected.url()),\n+        \"the projection\",\n+    )?;\n+    emit(out, rendered.trim_end(), \"the projection\")?;\n+    Ok(EXIT_OK)\n+}\n+\n+/// The host this process runs on: `ONETASKGRAPH_HOST`, else what the `hostname` command — the\n+/// one spelling every platform this ships for answers alike — prints, trimmed.\n+fn current_host() -> Option<String> {\n+    if let Some(host) = std::env::var(onetaskgraph_core::config::HOST_VARIABLE)\n+        .ok()\n+        .filter(|host| !host.is_empty())\n+    {\n+        return Some(host);\n+    }\n+    std::process::Command::new(\"hostname\")\n+        .output()\n+        .ok()\n+        .filter(|output| output.status.success())\n+        .and_then(|output| String::from_utf8(output.stdout).ok())\n+        .map(|host| host.trim().to_owned())\n+        .filter(|host| !host.is_empty())\n+}\n+\n /// Name every item a copy left unwritten, and say what the exit code will mean: `4`, the\n /// code a copy that landed and could not finish everything exits with, when there is one.\n fn failed_exit(report: &CopyReport) -> u8 {\n@@ -2308,6 +2412,7 @@ mod tests {\n                 \"task render\",\n                 \"task answers\",\n                 \"task assets\",\n+                \"task project-human\",\n                 \"project list\",\n                 \"project show\",\n                 \"project deps\","},{"sha":"2e677b97c4620952bada2bf36f4ca626c1121347","filename":"docs/linear-document-assertion-inventory.md","status":"added","additions":83,"deletions":0,"changes":83,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/docs%2Flinear-document-assertion-inventory.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/docs%2Flinear-document-assertion-inventory.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/docs%2Flinear-document-assertion-inventory.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,83 @@\n+# Linear live document assertion inventory\n+\n+The baseline for old locations below is commit `14e32a47`. Paths are relative to the\n+repository root. `plugin` means `crates/onetaskgraph-linear/tests/live.rs`; `assets`\n+means `crates/onetaskgraph-linear-e2e/tests/e2e/linear_assets.rs`.\n+\n+The manager approved moving fresh document creation and document deletion coverage to\n+one daily fresh pass. Ordinary selected journeys still execute their update, read,\n+filter, metadata, Markdown and asset assertions. Initialization — explicit, or the cold\n+rebuild an ordinary CI pass makes of a missing standing slot — is setup, not a\n+substitute for either pass, and is reported apart from both pass totals. Deleting a document does not restore\n+Linear's retained-trash capacity.\n+\n+| Original sender | Ordinary execution | Fresh daily execution | Initialization |\n+| --- | --- | --- | --- |\n+| `plugin:1364–1367`, `drive_documents`, filed write | Reset the owned filed slot using its target ID | Original targetless write into the disposable project | Create missing filed slot under retained parent only |\n+| `plugin:1368–1371`, `drive_documents`, loose write | Reset the owned loose slot using its target ID | Original targetless write without a project | Create missing loose slot only |\n+| `plugin:1062–1083`, `drive_follow_ups`, metadata probe | Reset the owned follow-up slot using its target ID | Original targetless metadata-bearing write | Create missing follow-up slot only |\n+| `assets:1191–1203`, live asset document copy | Copy into the owned asset destination | Original first copy creates its destination | Create missing asset destination only |\n+\n+These are the four successful document-producing operations in an original complete\n+pass: three plugin documents and one binary destination. `plugin:1153–1174` updates an\n+existing document. `plugin:1412–1424` deliberately refuses unsupported labels before\n+transport; it is not another successful create. The asset loop also creates an issue;\n+issue creation remains in both pass modes and is outside this document inventory.\n+\n+| Original assertion or asserted operation | New execution mode and location |\n+| --- | --- |\n+| `plugin:1364–1371`: both targetless writes succeed | Fresh: `drive_documents`; ordinary instead proves targeted reset succeeds |\n+| `plugin:1375–1379`: filed document readable by its ID | Ordinary and fresh: `drive_documents` |\n+| `plugin:1380–1383`: title round trip | Ordinary and fresh: `drive_documents` |\n+| `plugin:1384–1388`: visible content excludes metadata slot | Ordinary and fresh: `drive_documents` |\n+| `plugin:1389–1393`: numeric `caller.count` retains JSON type | Ordinary and fresh: `drive_documents` |\n+| `plugin:1394–1398`: no document labels | Ordinary and fresh: `drive_documents` |\n+| `plugin:1399–1403`: HTTPS location | Ordinary and fresh: `drive_documents` |\n+| `plugin:1404–1408`: filed document belongs to expected project | Ordinary and fresh: `drive_documents`; ordinary uses retained parent |\n+| `plugin:1412–1424`: labeled write refused by name | Ordinary and fresh: `drive_documents` |\n+| `plugin:1430–1442`: unfiltered listing returns both expected IDs and titles | Ordinary and fresh: `drive_documents`, `settled_documents` |\n+| `plugin:1443–1455`: project filter returns only filed document | Ordinary and fresh: same helpers |\n+| `plugin:1456–1468`: orphan filter returns only loose document | Ordinary and fresh: same helpers |\n+| `plugin:1469–1484`: label filter returns neither document | Ordinary and fresh: same helpers |\n+| `plugin:1488–1493`: delete both documents successfully and wait for absence | Fresh only: `drive_documents`, `settled_document_absent`; retained slots survive ordinary cleanup |\n+| `plugin:1062–1083`: initial metadata-bearing document write succeeds | Fresh: `drive_follow_ups`; ordinary uses targeted reset |\n+| `plugin:1084–1093`: probe readable, metadata and visible content survive | Ordinary and fresh: `drive_follow_ups` |\n+| `plugin:1094–1105`: raw document HTML-comment normalization matches recorded form | Ordinary and fresh: `drive_follow_ups` |\n+| `plugin:1129–1140`: raw document Markdown normalization matches recorded form | Ordinary and fresh: `drive_follow_ups` |\n+| `plugin:1141–1149`: plugin read returns normalized Markdown | Ordinary and fresh: `drive_follow_ups` |\n+| `plugin:1153–1188`: targeted table write succeeds; content and metadata survive together | Ordinary and fresh: `drive_follow_ups` |\n+| `assets:1200–1203`: first copy succeeds and reports destination | Ordinary and fresh: live asset copy/recopy driver; fresh exercises destination creation |\n+| `assets:1204–1210`: destination show succeeds | Ordinary and fresh: same driver |\n+| `assets:1213–1216`: recoverable ownership title retained | Ordinary and fresh: same driver |\n+| `assets:1217–1218`: relative asset links replaced | Ordinary and fresh: same driver |\n+| `assets:1219–1223`: two asset metadata entries; content contains each uploaded URL | Ordinary and fresh: same driver |\n+| `assets:1224–1232`: HTTPS, uploads.linear.app, port 443, no user info or fragment | Ordinary and fresh: same driver |\n+| `assets:1233–1240`: authenticated GET succeeds for each image | Ordinary and fresh: same driver; replay serves synthetic bytes |\n+| `assets:1242–1246`: unchanged recopy succeeds without another fileUpload | Ordinary and fresh: same driver |\n+| `assets:1252–1269`: journal-driven cleanup confirms successful deletes | Fresh disposable objects and invocation-owned local sets; retained CI destination excluded |\n+| `assets:1190,1270–1272`: assertion panic is rethrown after cleanup | Both modes: failure cleanup follows ownership rules; every acknowledged create stays counted |\n+\n+The surrounding follow-up issue assertions remain in both modes: metadata keys and slot\n+spelling (`plugin:993–1006`), comment creation (`1008–1022`), issue/comment HTML probes\n+(`1025–1061`), issue Markdown write/read (`1107–1128`), metadata/origin/priority/activity/\n+case-insensitive content filtering (`1190–1258`), Linear comparator cases (`1260–1299`),\n+and narrow metadata preservation (`1301–1322`). Existing label, state, issue and project\n+capability journeys retain their ordinary execution.\n+\n+Discovery and explicit initialization live in\n+`crates/onetaskgraph-linear/tests/document_lifecycle/mod.rs`. Its `documentCreate`\n+sender creates only missing exact owned slots. An ordinary CI pass with an absent or\n+incomplete standing set reaches that sender for exactly the missing slots, journalled as\n+a cold rebuild; a non-CI ordinary invocation refuses before it and names the explicit\n+initialize mode. Uncertain creation acknowledgements require discovery.\n+The same discovery code supplies both live lanes. Cleanup and orphan sweeping in\n+`crates/onetaskgraph-linear/tests/cleanup/mod.rs`, asset panic cleanup, and the Linear\n+janitor delete or preserve according to ownership; none sends `documentCreate`.\n+\n+The production mutation sender is `graphql::DOCUMENT_CREATE`, selected by the plugin's\n+`write_document` implementation when the target is absent. The HTTP observers and replay\n+handlers matching `documentCreate` are receivers, not additional live senders. Other\n+local fixture document writes exercise offline product behavior and do not reach the\n+nominated real team. Creation journals count acknowledged HTTP operations at transport,\n+including creates subsequently deleted or left by a failed pass. Initialization and\n+failure diagnostics are separate from ordinary and daily pass totals."},{"sha":"7f4d1c308fa10e5eb6e3751751b9fae442cda1f1","filename":"docs/linear-live-cleanup.md","status":"modified","additions":83,"deletions":140,"changes":223,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/docs%2Flinear-live-cleanup.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/docs%2Flinear-live-cleanup.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/docs%2Flinear-live-cleanup.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,140 +1,83 @@\n-# Linear live document residue\n-\n-Hosted run [40741930571, test-linux](https://github.com/nickderobertis/onetaskgraph/actions/runs/40741930571/job/123005634093)\n-is the reported failure: `linear_assets.rs:1194` in\n-`linear_assets::live_disposable_issue_and_document_assets_copy_and_recopy`\n-was refused by Linear's maximum of 1000 documents per team. A refused create\n-cannot return an id for the journey's cleanup journal. This dispatch could not\n-re-fetch the hosted log: `gh run view 40741930571 --log-failed` reported that\n-the run was still in progress and its logs were unavailable.\n-\n-There are two live document producers:\n-\n-- `crates/onetaskgraph-linear/tests/live.rs`: `drive_documents` creates a filed and a\n-  loose document and explicitly deletes both. `drive_follow_ups` creates a third for\n-  metadata/Markdown probes. All three use `artifact_title`, and `run_then_cleanup`\n-  calls `remove_artifacts` for this run's stamped titles even when the journey returns\n-  an error. Updates and the rejected labelled write do not create additional documents.\n-- `crates/onetaskgraph-linear-e2e/tests/e2e/linear_assets.rs`: the live asset journey\n-  copies one document, then recopies it onto the existing destination. `live_observer`\n-  journals ids returned by `documentCreate`, and the journey catches assertion panics,\n-  deletes the journalled items, and rethrows. Previously its title was\n-  `onetaskgraph disposable asset document <timestamp>`, which no orphan sweep recognized.\n-  Its title now carries the same machine/process/time ownership stamp as the other lane.\n-\n-Normal cleanup therefore exists; interrupted-host recovery was missing. A killed process\n-never reaches either cleanup. The Linear lane's local `sweep_orphans` additionally needs\n-positive evidence from the writing machine's registration locks; it cannot recover work\n-from a discarded hosted runner. The scheduled janitor enumerated GitHub artifacts only\n-and explicitly never read Linear. Thus documents from interrupted live journeys could\n-remain indefinitely, and the asset journey's old names were not sweepable even locally.\n-Code and the reported refusal establish those paths, not the exact composition of the team's\n-1000 documents. No credential or captured account listing was available to this dispatch.\n-\n-The scheduled workflow now also invokes `onetaskgraph-live-janitor --linear` with only\n-its Linear credential and test-team nomination. It lists documents before writing and\n-removes only exact stamped test titles older than 24 hours, directly in that team or\n-under a project belonging solely to that team. The expiry deliberately survives the loss\n-of the CI machine; it is independent of the local lock sweep. Fresh documents, malformed\n-or unvouched stamps, legacy asset titles, unstamped documents, unknown/shared ownership,\n-and other teams are protected. Listing errors stop before deletion; deletion refusals\n-fail the invocation. Read and write caps and pacing bound each scheduled pass.\n-\n-Offline subprocess journeys replay schema-derived recorded response fixtures through\n-HTTP, including stale machine/CI/project documents, fresh and unstamped documents, other\n-teams, pagination and delete refusals. Fixture provenance is explicit in\n-`crates/onetaskgraph-live-janitor/tests/fixtures/README.md`; these are not captured account\n-responses. Both GraphQL operations are checked against a pinned official SDK schema.\n-No live assertion was removed or loosened and no journey was skipped.\n-\n-Legacy residue is deliberately not swept by guessing at its title. The manager is taking\n-one-time cleanup of the existing residue to the user separately. The live asset lane\n-remains refused until that cleanup restores document capacity; this code does not claim\n-to have emptied the team or verified a credentialed run.\n-\n-## Verification of the finished change\n-\n-On this branch, the following passed:\n-\n-- The test, lint and formatting targets for the janitor, shared live support, Linear\n-  plugin, Linear e2e, scripts and workflow projects completed all 20 tasks\n-  successfully (two lint tasks used Nx cache). This includes\n-  146 Linear e2e tests, 95 workflow tests, the janitor HTTP journeys and schema checks,\n-  and the script guard journeys. No Linear credential was available; contributor\n-  declines are not evidence of a successful live API run.\n-- Type checking passed for the workflow, janitor, shared live support, Linear plugin\n-  and Linear e2e projects.\n-- The store-fixture and live-janitor guards and the whitespace check passed.\n-- The seven Linear janitor subprocess journeys also passed directly. Temporarily\n-  replacing the stale machine document's ownership title with an ordinary title made\n-  the removal assertion fail because that document was preserved; the fixture was\n-  restored before the full Nx run completed.\n-\n-The previously reported publication assertion at `.github/tests/release-cd.test.mjs:814`\n-did not recur. In a separate detached checkout of `main` at\n-`057b6c30b35314d1c2a70daef1feec3f5b14ef67`, after installing the pinned `.github`\n-dependencies, the release-CD test file passed all 12 tests.\n-The full workflow suite on this branch also passed that publication journey. The\n-separate checkout was removed afterward; no release tooling was changed.\n-\n-## Publication repair verification\n-\n-The shared live-support crate no longer owns the Linear prefix. The Linear plugin\n-exports it, matching the existing GitHub plugin's ownership of its design prefix;\n-the janitor's Cargo and Nx dependencies agree. No GitHub lane depends on that plugin.\n-\n-The repair also validates incoming fixture-server requests, represents advancing\n-pagination with a required cursor, and checks the actual listing filter and recorded\n-delete acknowledgement against the pinned upstream schema. Ten Linear subprocess\n-journeys passed, including direct-team precedence, empty project ownership and a zero\n-ownership timestamp, missing ownership fields, a failure after the first deletion,\n-and real-clock cleanup and listing refusal. Temporarily removing the zero-timestamp guard made the new\n-journey fail on the unexpected deletion; restoring it made the full suite pass.\n-\n-The main-branch release-CD recheck passed all 12 tests at\n-`057b6c30b35314d1c2a70daef1feec3f5b14ef67`. Its local HTTP double emitted connection-reset\n-tracebacks, but the test runner returned success. The earlier publication assertion\n-did not reproduce.\n-\n-Two narrow lint exceptions retain established repository conventions: the scheduled\n-janitor already owns hosted sweeps, so its Cargo and Nx Linear dependency declarations\n-carry `new_command_or_client_gets_its_own_project` markers; the shared fixture guard's\n-central MANIFEST already inventories domain stores, so the Linear listing entry carries\n-`code_lands_in_the_domain_that_owns_it`. The non-store delete-acknowledgement\n-registration carries the same marker because that central table also requires every\n-fixture to be named. The manager confirmed those placements and a\n-follow-up records the rule-applicability question. No lint configuration changed.\n-\n-The parallel verification run hit a packaging race: Maturin could not open its\n-`target/maturin/onetaskgraph` intermediate while script and workflow publication\n-journeys packaged the same tree. The manager confirmed the race is covered by a\n-separate build-lock task. The script, workflow and janitor test, lint, formatting and type-check targets\n-passed serially: all 14 tasks succeeded, including all 95 workflow tests, with two\n-Rust test threads and no committed configuration change. The busy host's load averages were\n-25.67, 37.44 and 31.81; the first Linear e2e run passed all 146 tests in 803.92 seconds.\n-\n-Model lint passed on the repaired implementation: 56 rules, 28 passed, zero failed,\n-11 skipped, two ignored and 15 not relevant (history `20261028T204633Z-ae728`).\n-Static validation also passed. The final changes after that review only record\n-these completed verification results.\n-\n-## Windows formatting repair\n-\n-Publication run [40767548268, check (windows-latest)](https://github.com/nickderobertis/onetaskgraph/actions/runs/40767548268/job/123102092578)\n-failed in `workspace:format-check`: Biome required spaces in the new\n-`linear-document-delete.json` response fixture. Commit `d63eeafb` formats that\n-fixture without changing its JSON value. No enforcement configuration changed.\n-\n-After that repair, `workspace:format-check` passed with Nx cache disabled. A serial,\n-uncached Nx run of `test`, `lint`, `format-check` and `typecheck` for\n-`onetaskgraph-live-janitor`, `onetaskgraph-live`, `onetaskgraph-linear`,\n-`onetaskgraph-linear-e2e`, `scripts` and `github-workflows`, plus their two prerequisite\n-tasks, passed in 79 minutes 17 seconds with `RUST_TEST_THREADS=2`. This includes all\n-146 Linear e2e tests, all 95 workflow tests (including release-CD publication), and\n-the janitor subprocess and schema tests. No credentialed Linear run is claimed.\n-The store-fixture guard and whitespace check passed too.\n-\n-Model lint passed with `LLMLINT_ONEHARNESS_BIN` unset: 56 rules, 30 passed, zero\n-failed, 11 skipped, two ignored and 13 not relevant (history\n-`20261028T213751Z-ce529`). Static validation passed. The only subsequent change is\n-this verification record. Hosted Windows verification still belongs to publication.\n+# Linear live document lifecycle\n+\n+Linear retains deleted documents in trash. Deletion retires test artifacts; it does\n+not restore the team's document quota. The nominated `LINEAR_WRITE_TEAM` is the only\n+team these journeys may mutate. Never replace that nomination by discovering an\n+arbitrary writable team.\n+\n+Ordinary affected CI passes reuse exactly four standing document slots: filed,\n+loose and follow-up probes in the plugin lane, and the asset destination in the\n+binary lane. Their identity is stable within the nominated team, without a process\n+timestamp. Required parent projects persist too. Each invocation resets mutable\n+contents to known run-specific values before asserting updates, reads, filtering,\n+metadata, Markdown, image integrity and unchanged recopy.\n+\n+An ordinary CI pass that finds the standing set absent or incomplete initializes\n+exactly the missing slots itself, under the shared CI concurrency group and the same\n+ownership rules, and then runs its reuse assertions over them. Its journal files those\n+creates as a cold rebuild: reported as detail, never counted in the ordinary-pass total\n+and never read as zero-cost reuse. A warm ordinary pass, every slot present, creates\n+none. Manually dispatching `.github/workflows/linear-documents.yml` remains the\n+explicit initialization and recovery invocation. Either way only missing slots are\n+created; partial initialization discovers existing objects by exact identity. An uncertain\n+create acknowledgement requires discovery before any retry. Unknown, duplicate or\n+ambiguous ownership fails closed. A retained marker alone never authorizes a write:\n+exact recognized ownership and verified nominated-team membership are both required.\n+\n+The same workflow runs one scheduled fresh-creation pass each day. It exercises the\n+original filed and loose writes, follow-up metadata creation, and first document\n+asset copy, with the original deletion/absence assertions and failure cleanup.\n+This deliberately moves fresh-creation coverage to the daily schedule; ordinary\n+selected journeys still run their non-creation assertions. The assertion-by-assertion\n+mapping is in [the coverage inventory](linear-document-assertion-inventory.md).\n+Issue, label and state coverage remains in the live journeys.\n+\n+The document mode environment variable is\n+`ONETASKGRAPH_LINEAR_DOCUMENT_MODE`: `ordinary`, `fresh`, or `initialize`.\n+CI's Linux affected check and the daily/initialization job share the\n+`linear-live-documents` concurrency group with `cancel-in-progress: false` and\n+`queue: max`. This preserves up to 100 pending writers under\n+[GitHub's queue semantics](https://docs.github.com/en/actions/how-tos/write-workflows/choose-when-workflows-run/control-workflow-concurrency).\n+The lock covers the affected gate because its live journeys are embedded in that\n+gate. Other platform checks do not share the Linear lock. Machine-local Session\n+exclusivity remains an additional guard.\n+\n+Local invocations use a separate reusable set containing the existing machine/process\n+ownership stamp and cannot resolve CI slots. Default local `ordinary` refuses before\n+writing when its set is absent. Opt in with `ONETASKGRAPH_LINEAR_DOCUMENT_MODE=initialize`:\n+that invocation initializes its isolated slots, runs the ordinary reuse assertions, and\n+retires the set in the same process. It prints and journals this as an explicit local\n+creation pass, outside typical CI sizing. Normal invocation cleanup\n+retires local slots. A failure or panic at any point after the first slot create,\n+partway through initialization included, retires every slot the invocation created —\n+by the id Linear acknowledged, or for a create acknowledged without one by its exact\n+identity — before the lane fails; those creations stay counted in its journal. After a killed invocation, the existing local registration/orphan\n+sweep may retire them only with positive evidence that their registration is dead;\n+still-active registrations remain protected. There is no global coordination for\n+local invocations.\n+\n+Standing CI slots and their parents survive normal cleanup, cancellation residue\n+cleanup, local orphan sweeping and the hourly janitor regardless of age. Fresh-mode\n+artifacts remain disposable with stamped ownership and expiry safeguards. The janitor\n+must continue protecting unrelated, fresh, malformed, ambiguous and unvouched records.\n+Never infer ownership from a similar title or treat trashing as quota recovery.\n+\n+## Per-pass measurement and privacy\n+\n+The ordinary budget measures one warm affected CI pass of both lanes: zero successful\n+`documentCreate` operations. The daily budget measures one fresh pass of both lanes:\n+three plugin documents and one binary asset document. Retries and pass frequency do\n+not weight either figure. A cold rebuild of the standing set, whether by an ordinary\n+CI pass or the explicit initialization, and failed-pass residue are separate diagnostic\n+detail, not part of either pass total.\n+\n+Offline HTTP replay drives the actual live entry paths and journals successful creates\n+at the transport, including objects subsequently deleted or left by failure. The\n+plugin and binary test targets record their own lane telemetry. The budget report\n+reads those records without replaying journeys; missing or incomplete journals fail,\n+rather than substituting zero. Only onebudgetspec compares the registered thresholds.\n+\n+Fixtures contain synthetic content and schema-validated recorded response shapes,\n+never captured account listings, credentials or private document bodies. Reports\n+contain operation counts and lifecycle outcomes, not workspace content. A contributor\n+run without credentials is a decline, not evidence of a successful real Linear pass."},{"sha":"91cd1eddfe04567af867cb7ba0de0fa45145f60b","filename":"docs/plugin-protocol.md","status":"modified","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/docs%2Fplugin-protocol.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/docs%2Fplugin-protocol.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/docs%2Fplugin-protocol.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -997,6 +997,14 @@ Nor is the repository a create would file its issue in: for a hosted source the\n drives against a board hosted this way. A plugin written against this document implements\n nothing more.\n \n+Nor is what `task project-human` keeps between processes so a later one writes without reading\n+first (`docs/task-projection.md`): for a hosted source the engine\n+answers each by the trait's default — `TaskSource::placement_context` and\n+`TaskSource::written_context` keep nothing, and `TaskSource::prime_placement` and\n+`TaskSource::prime_written` take nothing — so every create and every terminal write of a\n+projection crosses as the plugin's own `write_task` and `update_task`, each reading what it needs\n+as it always does. A plugin written against this document implements nothing more.\n+\n ### 4.9a Image assets on `write_task` and `write_document`\n \n A task's or a document's content references an image **asset** as a Markdown image whose"},{"sha":"792617179acb3af6d6a2309829a40d162299c548","filename":"docs/task-projection.md","status":"added","additions":104,"deletions":0,"changes":104,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/docs%2Ftask-projection.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/docs%2Ftask-projection.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/docs%2Ftask-projection.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,104 @@\n+# Human task projection\n+\n+`onetaskgraph task project-human --input FILE --json` projects one human action item into the\n+tracker its routing selects, idempotently by its `item_id`, and answers where it is. `FILE` is\n+`-` for standard input.\n+\n+## The contract\n+\n+The Rust task-projection domain owns the [request and binding declarations](../crates/onetaskgraph-core/src/task_projection/mod.rs):\n+`HumanTaskProjection` (the v1 request) and `HumanTaskProjected` (the answer — `task`, `url`,\n+`project`, `source`). Their schema roots come from those declarations through `schema_bundle`,\n+and the bundle's versioned golden detects drift; both SDKs generate their models from it. Use\n+the exported schema for accepted fields and values. A request with any other field, version or\n+state — a question included — is refused before any source is started (`projection-input`).\n+\n+## Configuration\n+\n+A source that receives human tasks declares its authority:\n+\n+```yaml\n+sources:\n+  human-public:\n+    plugin: github-projects\n+    config: { ... }\n+    visibility: public\n+    routes:\n+      - { classification: private, purpose: human-task, to: human-private }\n+      - { repositories: [github.com/example-org/*], purpose: human-task, to: example-org }\n+    task_projection:\n+      host: workstation-1          # the one host authoritative over these intents\n+      directory: /abs/path/intents # where the durable intents live\n+      project: PROJECT-1           # the project a planless item is filed under\n+```\n+\n+The request's `source` names where routing starts; only route entries with `purpose:\n+human-task` route a human task, and an entry without one is the legacy route every other\n+writer takes. While the public boundary is active a task is private when any of its\n+repositories is not answered public, and a private task with no private route is refused,\n+never written publicly; a public destination's write is screened by the caller's check. A request's\n+`project` is the plan's project as resolved in the destination — `<source>:<id>` naming\n+another source than the one routing chose is refused — and a planless item takes the\n+destination's `task_projection.project`. The destination must declare `task_projection`.\n+\n+The current host is `ONETASKGRAPH_HOST`, else the machine's name; a process on another host\n+than the destination's `task_projection.host` is refused before anything is written.\n+\n+## The durable intent\n+\n+`IntentStore::new` takes the absolute intent directory, its authoritative host identity and\n+the current host identity; a host mismatch refuses before creating any files. A claim holds an\n+operating-system lock for its source identity — the same digest as the source's local cache —\n+and external item ID, so simultaneous local owners serialize.\n+\n+`begin_create` durably records that a create may reach the tracker before it returns\n+authority to send one. A retry in that phase must reconcile by the recorded origin.\n+`reconcile` accepts exactly one indexed match and verifies its owner, item identity, origin,\n+payload digest, host, project, privacy, title, body, priority and repository set. An absent,\n+multiple or unverifiable match refuses without granting another create. The initial tracker\n+write carries those keys in the issue's own metadata (`human.item_id`, `human.owner`,\n+`human.payload_digest`, `human.host`, `onetaskgraph.origin`), so recovery does not depend on a\n+second mutation landing.\n+\n+`bind` commits the source-qualified task ID and canonical HTTPS URL before they can be\n+acknowledged. The source is derived from the qualified identity and a contradictory response\n+refuses deserialization. An identical binding is a no-op; another ticket cannot replace it. A\n+bound retry answers the binding and sends the tracker nothing.\n+\n+A failed durable commit makes the live claim uncertain: discard it and reopen from disk. The\n+rename may already have installed the transition, so reopening can require positive\n+reconciliation even when the preceding call failed. New Unix directories and files exclude\n+group and other access. The journal holds no task title or body. A create the tracker refuses\n+after the claim was committed stays pending, and is reconciled by hand.\n+\n+## Terminal projections\n+\n+A terminal intent is committed before its write and acknowledged after the tracker confirms\n+it. Terminal intents are immutable: a different state or reason is refused. The state is the\n+issue's own — its status and its closure (completed for `completed`, not planned for\n+`dismissed`; their Linear equivalents) — so a terminal projection writes no body unless the\n+request carries a dismissal `reason`, recorded as `human.reason`; an absent reason stays\n+absent. **No terminal projection writes a body from a stored copy of an earlier one**: a body\n+change is composed only against the body as it stands — on GitHub, the issue the `Status`\n+write's own answer returns. A terminal write whose answer was lost is read once by the retry,\n+which writes nothing the tracker already holds.\n+\n+## Context kept between processes\n+\n+Every projection is its own short-lived process, so two kinds of context are kept, neither\n+holding an item's title or body.\n+\n+- **The written item's ids** (`TaskSource::written_context`) are kept on the binding, so a\n+  terminal write addresses the issue without reading it first.\n+- **The placement** (`TaskSource::placement_context`) — on GitHub the repository's node id — is\n+  kept in the store's per-host local cache for the source, `placement.json` beside\n+  `designator.json` in the directory the cache lives in, whether or not the cache is on. It is\n+  held under a plugin-owned **setup-context token**: the digest of every input it depends on —\n+  the board's field definitions and options, the repository the issue is created in, the\n+  project it is filed under, and the source's declared visibility. A later create recomputes\n+  the token from the read of its project issue that it makes anyway, which carries the board's\n+  whole field list, and takes the kept placement only when the two agree; otherwise it reads\n+  its context afresh and keeps the new one. So the steady state adds no request, and a changed\n+  option, field, repository, project or visibility is never reused. A source whose create\n+  needs no setup beyond the read the token would be computed from keeps none (Linear: its\n+  team resolution is that read)."},{"sha":"445f8e47986bbddb3ff06532db4e5f51826c138b","filename":"justfile","status":"modified","additions":17,"deletions":0,"changes":17,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/justfile","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/justfile","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/justfile?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -83,6 +83,19 @@ script-check:\n distribution-check:\n     @{{nx}} run scripts:distribution-check\n \n+# Prove the Rust cache warmer leaves what a pull request's Linux build reuses: a cold build of\n+# every dependency three ways into a scratch target directory, twenty to thirty minutes on a\n+# hosted runner, so no gate runs it. It is a plain script rather than an Nx target because a\n+# recipe that runs a target by name is a stage every gate has to run\n+# (scripts/check-live-lane-selection.sh holds that), and this one deliberately is not.\n+warm-cache-reuse-check:\n+    @bash scripts/check-warm-rust-cache-reuse.sh\n+\n+# Its cheap half, over the target directory scripts/warm-rust-cache.sh --instrumented has just\n+# filled: the warmer's Linux leg runs it, with no Node toolchain for Nx to run on.\n+warm-cache-reuse-check-warmed:\n+    @bash scripts/check-warm-rust-cache-reuse.sh --warmed\n+\n distribution-test:\n     @{{nx}} run scripts:distribution-test\n \n@@ -260,3 +273,7 @@ github-workflows-bootstrap:\n # Focused workflow graph, required-context and budget proofs.\n github-workflows-check:\n     @{{nx}} run-many -t check --projects github-workflows\n+\n+# Explicit scheduled creation or standing-set recovery; mode comes from the caller.\n+linear-document-creation:\n+    @{{nx}} run-many -t live-documents --projects onetaskgraph-linear,onetaskgraph-linear-e2e --parallel=1"},{"sha":"2025d5827a507a6190c3b8c614b35c4a186863da","filename":"npm/cli/package.json","status":"modified","additions":5,"deletions":5,"changes":10,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fcli%2Fpackage.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fcli%2Fpackage.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/npm%2Fcli%2Fpackage.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n {\n   \"name\": \"@onetaskgraph/cli\",\n   \"//\": \"llmlint: ignore-file[projects_stay_in_one_js_workspace] The launcher and the four carriers it names are published packages, not development ones: each build job of release.yml `npm pack`s its platform's carrier at release time (scripts/release_cd.py), so nothing under npm/ holds a binary here. As workspace members the optionalDependencies below would link four empty local directories, and `workspace:*` names no version an end user's npm can resolve. scripts/set-version.sh and scripts/check-distribution-contract.sh hold the five numbers and this list together. JSON has no comment to scope this to one block.\",\n-  \"version\": \"0.12.12\",\n+  \"version\": \"0.12.13\",\n   \"description\": \"Platform-selecting launcher for onetaskgraph\",\n   \"x-exit-codes\": {\n     \"64\": \"unsupported platform\",\n@@ -16,10 +16,10 @@\n     \"bin\"\n   ],\n   \"optionalDependencies\": {\n-    \"@onetaskgraph/cli-linux-x64\": \"0.12.12\",\n-    \"@onetaskgraph/cli-linux-arm64\": \"0.12.12\",\n-    \"@onetaskgraph/cli-darwin-arm64\": \"0.12.12\",\n-    \"@onetaskgraph/cli-win32-x64\": \"0.12.12\"\n+    \"@onetaskgraph/cli-linux-x64\": \"0.12.13\",\n+    \"@onetaskgraph/cli-linux-arm64\": \"0.12.13\",\n+    \"@onetaskgraph/cli-darwin-arm64\": \"0.12.13\",\n+    \"@onetaskgraph/cli-win32-x64\": \"0.12.13\"\n   },\n   \"publishConfig\": {\n     \"access\": \"public\""},{"sha":"1c562805623d722ff46c9c8a409abe260ddef036","filename":"npm/platforms/darwin-arm64/package.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fplatforms%2Fdarwin-arm64%2Fpackage.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fplatforms%2Fdarwin-arm64%2Fpackage.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/npm%2Fplatforms%2Fdarwin-arm64%2Fpackage.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n {\n   \"name\": \"@onetaskgraph/cli-darwin-arm64\",\n   \"//\": \"llmlint: ignore-file[projects_stay_in_one_js_workspace] This is a publication carrier, not a development package: release.yml copies a freshly built binary in and `npm pack`s it at release time, so this directory holds a manifest and nothing to run. As a workspace member it would resolve the launcher's optionalDependency to an empty local directory. The version is a literal because it is what an end user's npm resolves from the registry; scripts/set-version.sh --check refuses any other. JSON has no comment to scope this more narrowly than the file.\",\n-  \"version\": \"0.12.12\",\n+  \"version\": \"0.12.13\",\n   \"os\": [\n     \"darwin\"\n   ],"},{"sha":"c76aeaab0e392d831c052c6f3a457bc0f9cd4f46","filename":"npm/platforms/linux-arm64/package.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fplatforms%2Flinux-arm64%2Fpackage.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fplatforms%2Flinux-arm64%2Fpackage.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/npm%2Fplatforms%2Flinux-arm64%2Fpackage.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n {\n   \"name\": \"@onetaskgraph/cli-linux-arm64\",\n   \"//\": \"llmlint: ignore-file[projects_stay_in_one_js_workspace] This is a publication carrier, not a development package: release.yml copies a freshly built binary in and `npm pack`s it at release time, so this directory holds a manifest and nothing to run. As a workspace member it would resolve the launcher's optionalDependency to an empty local directory. The version is a literal because it is what an end user's npm resolves from the registry; scripts/set-version.sh --check refuses any other. JSON has no comment to scope this more narrowly than the file.\",\n-  \"version\": \"0.12.12\",\n+  \"version\": \"0.12.13\",\n   \"os\": [\n     \"linux\"\n   ],"},{"sha":"babf63b81905f0635c90f094330f55393926ac01","filename":"npm/platforms/linux-x64/package.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fplatforms%2Flinux-x64%2Fpackage.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fplatforms%2Flinux-x64%2Fpackage.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/npm%2Fplatforms%2Flinux-x64%2Fpackage.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n {\n   \"name\": \"@onetaskgraph/cli-linux-x64\",\n   \"//\": \"llmlint: ignore-file[projects_stay_in_one_js_workspace] This is a publication carrier, not a development package: release.yml copies a freshly built binary in and `npm pack`s it at release time, so this directory holds a manifest and nothing to run. As a workspace member it would resolve the launcher's optionalDependency to an empty local directory. The version is a literal because it is what an end user's npm resolves from the registry; scripts/set-version.sh --check refuses any other. JSON has no comment to scope this more narrowly than the file.\",\n-  \"version\": \"0.12.12\",\n+  \"version\": \"0.12.13\",\n   \"os\": [\n     \"linux\"\n   ],"},{"sha":"47a1ca2b8e4d342b91ce655532beb6860b8f0a85","filename":"npm/platforms/win32-x64/package.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fplatforms%2Fwin32-x64%2Fpackage.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/npm%2Fplatforms%2Fwin32-x64%2Fpackage.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/npm%2Fplatforms%2Fwin32-x64%2Fpackage.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n {\n   \"name\": \"@onetaskgraph/cli-win32-x64\",\n   \"//\": \"llmlint: ignore-file[projects_stay_in_one_js_workspace] This is a publication carrier, not a development package: release.yml copies a freshly built binary in and `npm pack`s it at release time, so this directory holds a manifest and nothing to run. As a workspace member it would resolve the launcher's optionalDependency to an empty local directory. The version is a literal because it is what an end user's npm resolves from the registry; scripts/set-version.sh --check refuses any other. JSON has no comment to scope this more narrowly than the file.\",\n-  \"version\": \"0.12.12\",\n+  \"version\": \"0.12.13\",\n   \"os\": [\n     \"win32\"\n   ],"},{"sha":"8a6f64fe3b111335007f3ef4cd2481cad845a6e9","filename":"package.json","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/package.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/package.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/package.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -9,6 +9,7 @@\n   \"devDependencies\": {\n     \"@biomejs/biome\": \"2.5.10\",\n     \"@onebudgetspec/cli\": \"0.1.5\",\n+    \"@onebudgetspec/sdk\": \"0.1.3\",\n     \"@types/bun\": \"1.3.14\",\n     \"nx\": \"23.1.1\",\n     \"typescript\": \"5.9.3\""},{"sha":"8493673aea114f761defffaf31c69f47824de98f","filename":"pyproject.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/pyproject.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/pyproject.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/pyproject.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,6 +1,6 @@\n [project]\n name = \"onetaskgraph-cli\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n description = \"The onetaskgraph command-line interface.\"\n requires-python = \">=3.9\"\n "},{"sha":"f213d409bb7cc4a2cb7add9a2ff8b4c0fcc3efd8","filename":"scripts/check-guard-path-spelling.sh","status":"modified","additions":38,"deletions":0,"changes":38,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-guard-path-spelling.sh","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-guard-path-spelling.sh","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Fcheck-guard-path-spelling.sh?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -406,6 +406,44 @@ elif ! grep -qF -- \"$FOREIGN_FIXTURE\" <<<\"$OUTPUT\"; then\n fi\n fixture cp \"$ROOT/scripts/$STORE_GUARD\" \"$scratch/store/scripts/$STORE_GUARD\"\n \n+# The reader scripts/check-warm-rust-cache.sh asserts on names a crate's project.json it could\n+# not parse, and has to name it with forward slashes on every platform for that check to match.\n+readonly READER=\"pr-build-commands.sh\"\n+readonly BROKEN=\"crates/broken/project.json\"\n+readonly FOREIGN_BROKEN='crates\\broken\\project.json'\n+fixture mkdir -p \"$scratch/reader/scripts\" \"$scratch/reader/crates/broken\"\n+fixture cp \"$ROOT/scripts/$READER\" \"$scratch/reader/scripts/$READER\"\n+printf '{\"targets\": {\"test\": \\n' >\"$scratch/reader/$BROKEN\" || fatal \\\n+  \"could not write the unparseable fixture at $scratch/reader/$BROKEN\" \\\n+  \"check the permissions of \\$TMPDIR and 'df -h' for free space, then rerun\"\n+\n+run_reader_foreign() {\n+  OUTPUT=\"$(PATH=\"$scratch/bin:$PATH\" bash \"$scratch/reader/scripts/$READER\" 2>&1)\" \\\n+    && STATUS=0 || STATUS=$?\n+}\n+\n+# 9. The reader on a host that spells paths with a backslash names the file as every lane does.\n+run_reader_foreign\n+if [ \"$STATUS\" -eq 0 ] || ! grep -qF -- \"$BROKEN: could not be read as JSON\" <<<\"$OUTPUT\" \\\n+  || grep -qF -- \"$FOREIGN_BROKEN\" <<<\"$OUTPUT\"; then\n+  echo \"check-guard-path-spelling: scripts/$READER did not refuse an unparseable $BROKEN on a\" >&2\n+  echo \"check-guard-path-spelling: backslash-separator host naming it with forward slashes. It said:\" >&2\n+  report_output\n+  failures=$((failures + 1))\n+fi\n+\n+# 10. The control: without the normalisation, the backslash spelling the Windows runner printed\n+#     has to come back, or case 9 proves nothing.\n+substitute \"$scratch/reader/scripts/$READER\" \"path = found.as_posix()\" \"path = str(found)\"\n+run_reader_foreign\n+if ! grep -qF -- \"$FOREIGN_BROKEN\" <<<\"$OUTPUT\"; then\n+  echo \"check-guard-path-spelling: with the path normalisation removed, scripts/$READER did not\" >&2\n+  echo \"check-guard-path-spelling: name '$FOREIGN_BROKEN' on a backslash-separator host, so the\" >&2\n+  echo \"check-guard-path-spelling: simulation is not reproducing that host. It said:\" >&2\n+  report_output\n+  failures=$((failures + 1))\n+fi\n+\n if [ \"$failures\" -ne 0 ]; then\n   echo \"check-guard-path-spelling: $failures case(s) failed.\" >&2\n   echo \"check-guard-path-spelling: repair the reporting in the guard the case names rather than\" >&2"},{"sha":"ec92fd52258e71800414d382b3c656906dcbb65f","filename":"scripts/check-live-lane.sh","status":"modified","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-live-lane.sh","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-live-lane.sh","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Fcheck-live-lane.sh?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -71,6 +71,22 @@ CLEARERS = {\n         \"twice in a scratch copy, on every gate, from outside the affected-selection \"\n         \"fan-out it deliberately sits beyond\"\n     ),\n+    Path(\"scripts/warm-rust-cache.sh\"): (\n+        \"It builds every crate's tests, the live journeys among them, on every push to main for \"\n+        \"the Rust cache warmer, and one edit dropping `--no-run` would run them there\"\n+    ),\n+    Path(\"scripts/check-warm-rust-cache.sh\"): (\n+        \"It drives scripts/warm-rust-cache.sh behind a stand-in cargo, and one edit dropping \"\n+        \"the stand-in from PATH would run that warmer's builds for real, from scripts:test\"\n+    ),\n+    Path(\"scripts/check-warm-rust-cache-reuse-enforced.sh\"): (\n+        \"It drives scripts/check-warm-rust-cache-reuse.sh behind a stand-in cargo, and one edit \"\n+        \"dropping the stand-in from PATH would make that check's builds for real, from scripts:test\"\n+    ),\n+    Path(\"scripts/check-warm-rust-cache-reuse.sh\"): (\n+        \"It builds every crate's tests the way a pull request's Linux job does, on every push to \"\n+        \"main after the Rust cache warmer, and one edit dropping `--no-run` would run them there\"\n+    ),\n }\n DEMAND = \"ONETASKGRAPH_LIVE_REQUIRED\"\n # The one run where the demand is legitimately not made, spelled as GitHub Actions spells"},{"sha":"a30b10db4d501dbdabf666b1016a3f64830e3fa6","filename":"scripts/check-protocol-contract.sh","status":"modified","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-protocol-contract.sh","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-protocol-contract.sh","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Fcheck-protocol-contract.sh?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -158,6 +158,22 @@ NOT_METHODS = {\n         \"not a message: §4.9 says the engine answers it for a hosted source as the trait's \"\n         \"default does\"\n     ),\n+    \"placement_context\": (\n+        \"not a message: §4.9 says the engine answers it for a hosted source as the trait's \"\n+        \"default does, keeping no placement between processes\"\n+    ),\n+    \"prime_placement\": (\n+        \"not a message: §4.9 says the engine answers it for a hosted source as the trait's \"\n+        \"default does, taking nothing, so every create crosses as its own `write_task`\"\n+    ),\n+    \"written_context\": (\n+        \"not a message: §4.9 says the engine answers it for a hosted source as the trait's \"\n+        \"default does, keeping nothing of a task it wrote\"\n+    ),\n+    \"prime_written\": (\n+        \"not a message: §4.9 says the engine answers it for a hosted source as the trait's \"\n+        \"default does, taking nothing, so every update crosses as its own `update_task`\"\n+    ),\n     \"check_status_write\": (\n         \"not a message: §4.9 says the engine answers it for a hosted source as the trait's \"\n         \"default does, and the plugin's own write refuses a status it has no name for\""},{"sha":"b736ab4c42deaf66166f73420615b812ef83fe8b","filename":"scripts/check-warm-rust-cache-reuse-enforced.sh","status":"added","additions":102,"deletions":0,"changes":102,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-warm-rust-cache-reuse-enforced.sh","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-warm-rust-cache-reuse-enforced.sh","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Fcheck-warm-rust-cache-reuse-enforced.sh?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,102 @@\n+#!/usr/bin/env bash\n+# Watch scripts/check-warm-rust-cache-reuse.sh refuse. It runs, unchanged, in a scratch tree\n+# beside the real scripts/pr-build-commands.sh and scripts/rust-coverage.sh, one crate's\n+# project.json, and a stand-in `cargo` that prints what a real one would: `Compiling` lines for\n+# the builds a case names, and `Finished` unless a case silences it. An incomplete warm — a build of the job's\n+# compiling a dependency again — has to fail naming that dependency and the build; a complete\n+# one has to pass, warming first unless given --warmed, which warms nothing; a scan that cannot\n+# see a rebuild, because the control's incomplete warm reports none, and a build whose cargo\n+# output never reached the scan, have to fail.\n+#\n+#   scripts/check-warm-rust-cache-reuse-enforced.sh\n+#\n+# The check proves the Linux leg and skips elsewhere, so this does too. Quiet on success.\n+set -euo pipefail\n+\n+# Nothing here may open a live session; scripts/check-live-lane.sh holds it to that.\n+unset GH_PROJECTS_TOKEN LINEAR_API_KEY ONETASKGRAPH_LIVE_REQUIRED\n+\n+fail() {\n+  echo \"check-warm-rust-cache-reuse-enforced: $1\" >&2\n+  echo \"check-warm-rust-cache-reuse-enforced: next: $2\" >&2\n+  exit 1\n+}\n+\n+if [ \"$(uname -s)\" != Linux ]; then\n+  echo \"check-warm-rust-cache-reuse-enforced: skipped on $(uname -s), as the check it watches is\" >&2\n+  exit 0\n+fi\n+\n+root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n+scratch=\"$(mktemp -d \"${ONEPIPELINE_NODE_SCRATCH_DIR:-${TMPDIR:-/tmp}}/warm-rust-cache-reuse-enforced.XXXXXX\")\" \\\n+  || fail \"could not create a scratch directory\" \"check the permissions of \\$TMPDIR and 'df -h' for free space, then rerun\"\n+trap 'rm -rf \"$scratch\"' EXIT\n+\n+tree=\"$scratch/tree\"\n+mkdir -p \"$tree/scripts\" \"$tree/crates/onetaskgraph-plugin-api\" \"$scratch/bin\" \\\n+  || fail \"could not create the scratch tree in $scratch\" \"check the permissions of \\$TMPDIR and 'df -h' for free space, then rerun\"\n+for script in check-warm-rust-cache-reuse.sh pr-build-commands.sh rust-coverage.sh; do\n+  cp \"$root/scripts/$script\" \"$tree/scripts/\" || fail \"could not copy scripts/$script into $scratch\" \"check the permissions of \\$TMPDIR and 'df -h' for free space, then rerun\"\n+done\n+printf '%s\\n' '#!/usr/bin/env bash' 'echo \"warm $*\" >>\"$WARM_RECORD\"' >\"$tree/scripts/warm-rust-cache.sh\"\n+printf '%s\\n' '#!/usr/bin/env bash' 'echo \"    Finished \\`release\\` profile\"' >\"$tree/scripts/test-distribution.sh\"\n+cat >\"$tree/crates/onetaskgraph-plugin-api/project.json\" <<'JSON'\n+{\"targets\": {\"test\": {\"options\": {\"command\": \"cargo test --quiet -p onetaskgraph-plugin-api --all-features --locked\"}}}}\n+JSON\n+# The stand-in: metadata names the one crate; a build compiles `serde` again when it is the\n+# control's instrumented build into its empty directory, or when it matches $REUSE_REBUILD.\n+cat >\"$scratch/bin/cargo\" <<'STUB'\n+#!/usr/bin/env bash\n+if [ \"$1\" = metadata ]; then\n+  echo '{\"packages\":[{\"name\":\"onetaskgraph-plugin-api\"}]}'\n+  exit 0\n+fi\n+if { [ \"$1\" = llvm-cov ] && [ \"${CARGO_TARGET_DIR##*/}\" = empty ] && [ -z \"${REUSE_BLIND:-}\" ]; } \\\n+  || { [ -n \"${REUSE_REBUILD:-}\" ] && [[ \"$*\" == *\"$REUSE_REBUILD\"* ]]; }; then\n+  echo \"   Compiling serde v1.0.0\" >&2\n+fi\n+[ -n \"${REUSE_SILENT:-}\" ] && [[ \"$*\" == *\"$REUSE_SILENT\"* ]] && exit 0\n+echo \"    Finished \\`test\\` profile\" >&2\n+STUB\n+chmod +x \"$scratch/bin/cargo\"\n+\n+# run <name> [VAR=value...]: run the check in the scratch tree with $REUSE_ARGS, its output in\n+# $scratch/<name>.log and every warmer invocation in $scratch/<name>.warm.\n+run() {\n+  local name=\"$1\"\n+  shift\n+  : >\"$scratch/$name.warm\"\n+  # shellcheck disable=SC2086 # The arguments are the words they spell.\n+  env \"$@\" WARM_RECORD=\"$scratch/$name.warm\" PATH=\"$scratch/bin:$PATH\" \\\n+    bash \"$tree/scripts/check-warm-rust-cache-reuse.sh\" ${REUSE_ARGS:-} >\"$scratch/$name.log\" 2>&1\n+}\n+\n+status=0\n+REUSE_ARGS=--bogus run usage || status=$?\n+[ \"$status\" -eq 2 ] || { cat \"$scratch/usage.log\" >&2; fail \"an unknown argument exited $status, not 2, its usage error\" \"exit 2 on any argument but --warmed alone\"; }\n+\n+run complete || { cat \"$scratch/complete.log\" >&2; fail \"a complete warm was refused\" \"fix what the check reports above\"; }\n+[ \"$(cat \"$scratch/complete.warm\")\" = \"warm --instrumented\" ] \\\n+  || fail \"the check did not warm once, in the Linux leg's mode, before its builds\" \"run scripts/warm-rust-cache.sh --instrumented unless given --warmed\"\n+\n+REUSE_ARGS=--warmed run warmed || { cat \"$scratch/warmed.log\" >&2; fail \"--warmed over a complete warm was refused\" \"fix what the check reports above\"; }\n+[ ! -s \"$scratch/warmed.warm\" ] || fail \"--warmed ran the warmer again\" \"build nothing first under --warmed\"\n+\n+if run incomplete REUSE_REBUILD=llvm-cov; then\n+  fail \"an instrumented build that compiled serde again passed\" \"keep the refusal at the end of scripts/check-warm-rust-cache-reuse.sh\"\n+fi\n+grep -q \"serde (by 'cargo llvm-cov --no-report nextest --package onetaskgraph-plugin-api\" \"$scratch/incomplete.log\" \\\n+  || { cat \"$scratch/incomplete.log\" >&2; fail \"the refusal does not name the dependency and the build that compiled it\" \"list each as '<crate> (by '<build>')'\"; }\n+\n+if run blind REUSE_BLIND=1; then\n+  fail \"a scan that saw no rebuild in the control's incomplete warm passed\" \"keep the control in scripts/check-warm-rust-cache-reuse.sh\"\n+fi\n+grep -q \"an incomplete warm passed\" \"$scratch/blind.log\" \\\n+  || { cat \"$scratch/blind.log\" >&2; fail \"the control's refusal does not say the incomplete warm passed\" \"keep its message\"; }\n+\n+if run silent REUSE_SILENT=\"--package onetaskgraph-plugin-api --all-features --locked -E\"; then\n+  fail \"a build that printed no cargo 'Finished' line passed\" \"keep the Finished check in scripts/check-warm-rust-cache-reuse.sh\"\n+fi\n+grep -q \"printed no cargo 'Finished' line\" \"$scratch/silent.log\" \\\n+  || { cat \"$scratch/silent.log\" >&2; fail \"the refusal of a silent build does not say it printed no Finished line\" \"keep its message\"; }\n+exit 0"},{"sha":"1cbd3432719c6980fdefa2595d770e6f03205412","filename":"scripts/check-warm-rust-cache-reuse.sh","status":"added","additions":126,"deletions":0,"changes":126,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-warm-rust-cache-reuse.sh","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-warm-rust-cache-reuse.sh","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Fcheck-warm-rust-cache-reuse.sh?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,126 @@\n+#!/usr/bin/env bash\n+# Prove the Rust cache warmer leaves what a pull request's Linux build reuses: run the real\n+# scripts/warm-rust-cache.sh in the Linux leg's mode (--instrumented) into a scratch target\n+# directory, then make that job's builds against the same directory, and fail naming every\n+# dependency crate cargo compiled again. rust-cache saves the target directory's dependency\n+# units, so a dependency the second pass rebuilt is one the warmer's save would not have\n+# spared a pull request.\n+#\n+#   scripts/check-warm-rust-cache-reuse.sh [--warmed]\n+#\n+# Exits 0 when nothing was rebuilt (or off Linux), 1 when a build was or a step failed, 2 on\n+# any other argument.\n+#\n+# With --warmed it builds nothing first and checks the target directory cargo already uses,\n+# which the warmer has just filled: .github/workflows/rust-cache-warm.yml runs it so as the\n+# Linux leg's last step, where the job's builds find everything built and cost little, so a\n+# push to main fails the moment the cache it saves stops being one a pull request reuses.\n+#\n+# The job's builds are what scripts/pr-build-commands.sh reads from where each is declared.\n+# A first, cheap control warms one crate incompletely and has to be refused, or a scan that\n+# never matches would read as a pass.\n+#\n+# Without it, a cold build of every dependency three ways, so it is no phase of `check`: run it\n+# by name (`just warm-cache-reuse-check`) when the warmer, the build commands or the toolchain\n+# change.\n+# Linux only, as the leg it proves is; elsewhere it says so and exits 0. Quiet on success.\n+set -euo pipefail\n+\n+# Nothing here may open a live session: it builds the live crates' tests and runs none.\n+unset GH_PROJECTS_TOKEN LINEAR_API_KEY ONETASKGRAPH_LIVE_REQUIRED\n+\n+fail() {\n+  echo \"check-warm-rust-cache-reuse: $1\" >&2\n+  echo \"check-warm-rust-cache-reuse: next: $2\" >&2\n+  exit 1\n+}\n+\n+warmed=false\n+case \"$#:${1:-}\" in\n+  0:) ;;\n+  1:--warmed) warmed=true ;;\n+  *)\n+    echo \"check-warm-rust-cache-reuse: takes no argument or --warmed alone, not '$*'\" >&2\n+    echo \"check-warm-rust-cache-reuse: next: run it with none, or with --warmed after scripts/warm-rust-cache.sh --instrumented\" >&2\n+    exit 2\n+    ;;\n+esac\n+\n+if [ \"$(uname -s)\" != Linux ]; then\n+  echo \"check-warm-rust-cache-reuse: skipped on $(uname -s); it proves the Linux leg, so run it on Linux\" >&2\n+  exit 0\n+fi\n+\n+root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n+cd \"$root\"\n+scratch=\"$(mktemp -d \"${ONEPIPELINE_NODE_SCRATCH_DIR:-${TMPDIR:-/tmp}}/warm-rust-cache-reuse.XXXXXX\")\" \\\n+  || fail \"could not create a scratch directory\" \"check the permissions of \\$TMPDIR and 'df -h' for free space, then rerun\"\n+trap 'rm -rf \"$scratch\"' EXIT\n+\n+python_bin=\"$(command -v python3)\" || fail \"python3 is not on PATH\" \"install python3 and re-run\"\n+\n+members=\"$(cargo metadata --no-deps --format-version 1 --locked \\\n+  | \"$python_bin\" -c 'import json, sys\n+document = json.load(sys.stdin)\n+packages = document.get(\"packages\") if isinstance(document, dict) else None\n+if not isinstance(packages, list) or not packages or not all(\n+    isinstance(package, dict) and isinstance(package.get(\"name\"), str) and package[\"name\"].strip()\n+    for package in packages\n+):\n+    raise SystemExit(\"cargo metadata did not answer with a packages array of named packages\")\n+print(\"\\n\".join(package[\"name\"] for package in packages))\n+' \\\n+  | tr -d '\\r')\" || fail \"could not list the workspace's crates\" \"run 'cargo metadata --no-deps' and fix what it reports\"\n+\n+# rebuilt <log>: the non-workspace crates a build log says cargo compiled, one per line.\n+rebuilt() {\n+  local status=0\n+  sed -n 's/^ *Compiling \\([^ ]*\\) v.*/\\1/p' \"$1\" | tr -d '\\r' | sort -u \\\n+    | grep -vxF -f <(printf '%s\\n' $members) || status=$?\n+  # 1 is grep's \"nothing left\", which is the answer; anything above it is grep failing.\n+  [ \"$status\" -le 1 ] || fail \"grep failed (exit $status) filtering $1\" \"re-run; if it repeats, check the scratch directory is readable\"\n+}\n+\n+# replay <builds> <rebuilt>: make each build, one command per line, over $CARGO_TARGET_DIR,\n+# listing in <rebuilt> every dependency one of them compiled and which.\n+replay() {\n+  local build log=\"$scratch/build.log\"\n+  : >\"$2\"\n+  while IFS= read -r build; do\n+    # shellcheck disable=SC2086 # Each line is the words of one command.\n+    $build </dev/null >\"$log\" 2>&1 || { cat \"$log\" >&2; fail \"'$build' failed\" \"fix what it reports above\"; }\n+    # Cargo's own closing line, so this build's output reached the scan: a command whose cargo\n+    # output went elsewhere would otherwise report nothing compiled and pass.\n+    grep -Eq '^ *Finished ' \"$log\" || { cat \"$log\" >&2; fail \"'$build' printed no cargo 'Finished' line, so this scan cannot see what it compiled\" \"let that command's cargo output reach its standard error\"; }\n+    rebuilt \"$log\" | sed \"s|\\$| (by '$build')|\" >>\"$2\"\n+  done <\"$1\"\n+}\n+\n+bash scripts/pr-build-commands.sh >\"$scratch/builds\"\n+[ -s \"$scratch/builds\" ] || fail \"found no pull-request build to make\" \"keep the crates' test targets' cargo commands in crates/*/project.json\"\n+\n+# The control: an incomplete warm — one crate's plain test units, none instrumented — then\n+# that crate's instrumented build from the job's own list, which has to be refused naming the\n+# dependencies it compiled, or a refusal this check owes would read as a pass.\n+grep -E -- '^cargo llvm-cov .*--package onetaskgraph-plugin-api ' \"$scratch/builds\" >\"$scratch/control.builds\" \\\n+  || fail \"the job's builds hold no instrumented build of onetaskgraph-plugin-api for the control\" \"point the control at a crate scripts/pr-build-commands.sh lists\"\n+CARGO_TARGET_DIR=\"$scratch/empty\" cargo test --no-run --locked --all-features -p onetaskgraph-plugin-api \\\n+  >\"$scratch/control.log\" 2>&1 || { cat \"$scratch/control.log\" >&2; fail \"the control's partial warm failed\" \"fix what cargo reports above\"; }\n+CARGO_TARGET_DIR=\"$scratch/empty\" replay \"$scratch/control.builds\" \"$scratch/control.rebuilt\"\n+[ -s \"$scratch/control.rebuilt\" ] || fail \"an incomplete warm passed: the instrumented build after an uninstrumented one reported no dependency compiled\" \"make rebuilt() match cargo's 'Compiling' lines again\"\n+rm -rf \"$scratch/empty\"\n+\n+if ! \"$warmed\"; then\n+  export CARGO_TARGET_DIR=\"$scratch/target\"\n+  bash scripts/warm-rust-cache.sh --instrumented >\"$scratch/warm.log\" 2>&1 || {\n+    cat \"$scratch/warm.log\" >&2\n+    fail \"scripts/warm-rust-cache.sh --instrumented failed\" \"fix what it reports above\"\n+  }\n+fi\n+\n+replay \"$scratch/builds\" \"$scratch/rebuilt\"\n+if [ -s \"$scratch/rebuilt\" ]; then\n+  cat \"$scratch/rebuilt\" >&2\n+  fail \"the pull-request builds compiled dependencies the warmer had built (listed above)\" \"make scripts/warm-rust-cache.sh build each of those commands' units exactly as the job does\"\n+fi\n+exit 0"},{"sha":"11e72a32922db11787f2b52a2b10bc2beae6deab","filename":"scripts/check-warm-rust-cache.sh","status":"added","additions":183,"deletions":0,"changes":183,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-warm-rust-cache.sh","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fcheck-warm-rust-cache.sh","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Fcheck-warm-rust-cache.sh?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,183 @@\n+#!/usr/bin/env bash\n+# Drive scripts/warm-rust-cache.sh over a scratch copy of itself, behind a stand-in `cargo` that\n+# answers `cargo metadata` with two crates and records every other invocation, and a stand-in\n+# distribution journey that records its arguments. Each leg must build every crate's test units\n+# with every feature and with its defaults, the Linux leg each crate's instrumented units too,\n+# and both the distribution journey's release build alone; any other invocation is refused.\n+# Each build scripts/pr-build-commands.sh reads test-linux making has to be one of those\n+# shapes. A build the warmer stops making leaves every later pull request cold, and nothing\n+# else says so.\n+#\n+#   scripts/check-warm-rust-cache.sh\n+#\n+# Quiet on success.\n+set -euo pipefail\n+\n+# Nothing here may open a live session; scripts/check-live-lane.sh holds it to that.\n+unset GH_PROJECTS_TOKEN LINEAR_API_KEY ONETASKGRAPH_LIVE_REQUIRED\n+\n+fail() {\n+  echo \"check-warm-rust-cache: $1\" >&2\n+  echo \"check-warm-rust-cache: next: $2\" >&2\n+  exit 1\n+}\n+\n+root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n+scratch=\"$(mktemp -d \"${ONEPIPELINE_NODE_SCRATCH_DIR:-${TMPDIR:-/tmp}}/warm-rust-cache.XXXXXX\")\" \\\n+  || fail \"could not create a scratch directory\" \"check the permissions of \\$TMPDIR and 'df -h' for free space, then rerun\"\n+trap 'rm -rf \"$scratch\"' EXIT\n+\n+tree=\"$scratch/tree\"\n+{ mkdir -p \"$tree/scripts\" \"$scratch/bin\" && cp \"$root/scripts/warm-rust-cache.sh\" \"$tree/scripts/\"; } \\\n+  || fail \"could not plant the warmer in $scratch\" \"check the permissions of \\$TMPDIR and 'df -h' for free space, then rerun\"\n+cat >\"$tree/scripts/test-distribution.sh\" <<'STUB'\n+echo \"distribution $*\" >>\"$WARM_RECORD\"\n+STUB\n+cat >\"$scratch/bin/cargo\" <<'STUB'\n+#!/usr/bin/env bash\n+if [ \"$1\" = metadata ]; then\n+  echo '{\"packages\":[{\"name\":\"alpha\"},{\"name\":\"beta\"}]}'\n+else\n+  echo \"cargo $*\" >>\"$WARM_RECORD\"\n+  [ -z \"${WARM_FAIL:-}\" ] || [[ \"$*\" != *\"$WARM_FAIL\"* ]] || exit 101\n+fi\n+STUB\n+chmod +x \"$scratch/bin/cargo\"\n+\n+# leg <name> <arguments...>: run the warmer, leaving what it ran in $scratch/<name>.\n+leg() {\n+  local name=\"$1\"\n+  shift\n+  WARM_RECORD=\"$scratch/$name\" PATH=\"$scratch/bin:$PATH\" bash \"$tree/scripts/warm-rust-cache.sh\" \"$@\" \\\n+    >\"$scratch/$name.log\" 2>&1\n+}\n+expected() {\n+  for crate in alpha beta; do\n+    echo \"cargo test --quiet --no-run --locked --all-features -p $crate\"\n+    echo \"cargo test --quiet --no-run --locked -p $crate\"\n+    [ \"$1\" = plain ] || echo \"cargo llvm-cov --no-report nextest --package $crate --all-features --locked -E none() --no-tests=pass\"\n+  done\n+  echo \"distribution --release-build-only\"\n+}\n+\n+for name in plain instrumented; do\n+  arguments=()\n+  [ \"$name\" = plain ] || arguments=(--instrumented)\n+  : >\"$scratch/$name\"\n+  leg \"$name\" ${arguments[@]+\"${arguments[@]}\"} || { cat \"$scratch/$name.log\" >&2; fail \"the $name leg failed\" \"fix what it reports above\"; }\n+  if ! diff <(expected \"$name\") \"$scratch/$name\" >\"$scratch/$name.diff\"; then\n+    cat \"$scratch/$name.diff\" >&2\n+    fail \"the $name leg built something other than what the pull-request jobs restore (expected '<', ran '>')\" \"keep scripts/warm-rust-cache.sh building every crate's test units, instrumented on Linux, and the release build alone\"\n+  fi\n+done\n+\n+# And every build test-linux makes, read from where each is declared, has to be one the\n+# instrumented leg makes for every crate, up to the crate, the test target and the filter.\n+bash \"$root/scripts/pr-build-commands.sh\" >\"$scratch/pr-builds\" 2>\"$scratch/pr-builds.log\" \\\n+  || { cat \"$scratch/pr-builds.log\" >&2; fail \"scripts/pr-build-commands.sh failed\" \"fix what it reports above\"; }\n+python3 - \"$scratch/instrumented\" \"$scratch/pr-builds\" >\"$scratch/unwarmed\" <<'PY' || fail \"could not compare the warmer's builds with test-linux's\" \"run scripts/pr-build-commands.sh and fix what it reports\"\n+import sys\n+\n+def shape(line):\n+    words = line.split()\n+    if words[:1] != [\"cargo\"]:\n+        return None\n+    kept, skip = [], False\n+    for word in words[1:]:\n+        if skip:\n+            skip = False\n+        elif word in (\"-p\", \"--package\", \"--test\", \"-E\"):\n+            skip = True\n+        elif word not in (\"--quiet\", \"--no-run\", \"--no-tests=pass\"):\n+            kept.append(word)\n+    return (kept[0], tuple(sorted(kept[1:])))\n+\n+warmed = {shape(line) for line in open(sys.argv[1], encoding=\"utf-8\").read().splitlines()}\n+for line in open(sys.argv[2], encoding=\"utf-8\").read().splitlines():\n+    built = shape(line)\n+    if built is not None and built not in warmed:\n+        print(line)\n+PY\n+if [ -s \"$scratch/unwarmed\" ]; then\n+  tr -d '\\r' <\"$scratch/unwarmed\" >&2\n+  fail \"test-linux makes the builds above, which scripts/warm-rust-cache.sh makes in no shape\" \"build each of them in scripts/warm-rust-cache.sh with the same flags\"\n+fi\n+\n+for arguments in \"--bogus\" \"--instrumented extra\"; do\n+  : >\"$scratch/refused\"\n+  status=0\n+  # shellcheck disable=SC2086 # Each case is the words it spells.\n+  leg refused $arguments || status=$?\n+  [ \"$status\" -eq 2 ] || fail \"the warmer exited $status with '$arguments', not 2, its usage error\" \"refuse every argument but --instrumented alone in scripts/warm-rust-cache.sh, exiting 2\"\n+  [ ! -s \"$scratch/refused\" ] || fail \"the warmer built before refusing '$arguments'\" \"refuse its arguments before building anything\"\n+  grep -q \"not '$arguments'\" \"$scratch/refused.log\" || { cat \"$scratch/refused.log\" >&2; fail \"the refusal of '$arguments' does not name it\" \"name the arguments in the refusal\"; }\n+done\n+\n+# A build that fails stops the warmer, exit 1, naming that build and a next action.\n+: >\"$scratch/broken\"\n+status=0\n+WARM_FAIL=\"-p beta\" leg broken --instrumented || status=$?\n+[ \"$status\" -eq 1 ] && grep -q \"building beta's test units with every feature failed\" \"$scratch/broken.log\" \\\n+  && grep -q \"next:\" \"$scratch/broken.log\" && [ \"$(tail -1 \"$scratch/broken\")\" = \"cargo test --quiet --no-run --locked --all-features -p beta\" ] \\\n+  || { cat \"$scratch/broken.log\" >&2; fail \"the warmer exited $status on a failed build of beta, without stopping there naming it and a next action\" \"end each build in scripts/warm-rust-cache.sh with || fatal naming it\"; }\n+\n+# The release build it hands to the distribution journey, driven for real behind a stand-in\n+# `uv`: --release-build-only has to make exactly the journey's maturin build and stop there,\n+# and any other argument has to be refused, exit 2, before anything is built. The journey's\n+# `uv` is spawned by python, and on Windows CreateProcess resolves only `uv.exe`, so the\n+# stand-in is a real executable compiled here by the pinned toolchain — the same harness on\n+# every platform. It records its arguments beside itself, a path no environment translation\n+# between bash and a native process can rewrite.\n+journey=\"$scratch/journey\"\n+journey_bin=\"$scratch/journey-bin\"\n+{ mkdir -p \"$journey/scripts\" \"$journey/crates/onetaskgraph\" \"$journey_bin\" \\\n+  && cp \"$root/scripts/test-distribution.sh\" \"$root/scripts/cli_wheel_lock.py\" \"$journey/scripts/\"; } \\\n+  || fail \"could not plant the distribution journey in $scratch\" \"check the permissions of \\$TMPDIR and 'df -h' for free space, then rerun\"\n+printf '[package]\\nname = \"onetaskgraph\"\\nversion = \"1.2.3\"\\n' >\"$journey/crates/onetaskgraph/Cargo.toml\"\n+cat >\"$scratch/uv.rs\" <<'RUST'\n+use std::io::Write;\n+fn main() {\n+    let record = std::env::current_exe().unwrap().with_file_name(\"uv.record\");\n+    let words: Vec<String> = std::env::args().skip(1).collect();\n+    let mut file = std::fs::OpenOptions::new().create(true).append(true).open(record).unwrap();\n+    writeln!(file, \"uv {}\", words.join(\" \")).unwrap();\n+}\n+RUST\n+exe=\"\"\n+case \"${OS:-}${OSTYPE:-}\" in *Windows_NT* | *msys* | *cygwin* | *win32*) exe=.exe ;; esac\n+# From the root, so rustup reads rust-toolchain.toml rather than wanting a default toolchain.\n+(cd \"$root\" && rustc --edition 2021 -o \"$journey_bin/uv$exe\" \"$scratch/uv.rs\") >\"$scratch/uv-build.log\" 2>&1 \\\n+  || { cat \"$scratch/uv-build.log\" >&2; fail \"could not compile the stand-in uv\" \"fix what rustc reports above\"; }\n+printf '%s\\n' '#!/usr/bin/env bash' 'exit 0' >\"$journey_bin/npm\"\n+chmod +x \"$journey_bin/npm\"\n+: >\"$journey_bin/uv.record\"\n+PATH=\"$journey_bin:$PATH\" bash \"$journey/scripts/test-distribution.sh\" --release-build-only >\"$scratch/journey.log\" 2>&1 \\\n+  || { cat \"$scratch/journey.log\" >&2; fail \"test-distribution.sh --release-build-only failed\" \"fix what it reports above\"; }\n+tr -d '\\r' <\"$journey_bin/uv.record\" >\"$scratch/journey.record\"\n+grep -Eq \"^uv tool run --from maturin>=1\\.9,<2 maturin build --release --locked --target [^ ]+ --out [^ ]+[/\\\\]python-wheel\\$\" \"$scratch/journey.record\" \\\n+  && [ \"$(wc -l <\"$scratch/journey.record\" | tr -d ' ')\" = 1 ] \\\n+  || { cat \"$scratch/journey.record\" >&2; fail \"--release-build-only made something other than the journey's one maturin build (above)\" \"keep it to build_release_wheel in scripts/test-distribution.sh and an exit\"; }\n+: >\"$journey_bin/uv.record\"\n+status=0\n+PATH=\"$journey_bin:$PATH\" bash \"$journey/scripts/test-distribution.sh\" --release-build-only extra >\"$scratch/journey.log\" 2>&1 || status=$?\n+[ \"$status\" -eq 2 ] && [ ! -s \"$journey_bin/uv.record\" ] \\\n+  || { cat \"$scratch/journey.log\" >&2; fail \"test-distribution.sh exited $status for '--release-build-only extra', not 2 before building\" \"refuse it as a usage error before any build\"; }\n+\n+# And scripts/pr-build-commands.sh refuses a file it cannot read naming that file and a next\n+# action, never with a traceback: a crate's project.json that does not parse, and a missing\n+# scripts/rust-coverage.sh.\n+reader=\"$scratch/reader\"\n+{ mkdir -p \"$reader/scripts\" \"$reader/crates/broken\" && cp \"$root/scripts/pr-build-commands.sh\" \"$reader/scripts/\"; } \\\n+  || fail \"could not plant scripts/pr-build-commands.sh in $scratch\" \"check the permissions of \\$TMPDIR and 'df -h' for free space, then rerun\"\n+printf '{\"targets\": {\"test\": \\n' >\"$reader/crates/broken/project.json\"\n+refused_by_reader() {\n+  local status=0\n+  bash \"$reader/scripts/pr-build-commands.sh\" >/dev/null 2>\"$scratch/reader.log\" || status=$?\n+  [ \"$status\" -eq 1 ] && grep -q \"$1\" \"$scratch/reader.log\" && grep -q \"next:\" \"$scratch/reader.log\" \\\n+    && ! grep -q Traceback \"$scratch/reader.log\" \\\n+    || { cat \"$scratch/reader.log\" >&2; fail \"pr-build-commands.sh exited $status for $2, without naming $1 and a next action\" \"refuse it through sys.exit with the file and a next action\"; }\n+}\n+refused_by_reader \"crates/broken/project.json: could not be read as JSON\" \"a project.json that does not parse\"\n+printf '{\"targets\": {\"test\": {\"options\": {\"command\": \"cargo test -p broken\"}}}}\\n' >\"$reader/crates/broken/project.json\"\n+refused_by_reader \"scripts/rust-coverage.sh could not be read\" \"a missing scripts/rust-coverage.sh\"\n+exit 0"},{"sha":"4b4945c102517edde6210d5a4319864915787fdc","filename":"scripts/pr-build-commands.sh","status":"added","additions":81,"deletions":0,"changes":81,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fpr-build-commands.sh","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fpr-build-commands.sh","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Fpr-build-commands.sh?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,81 @@\n+#!/usr/bin/env bash\n+# Print, one command per line, every build test-linux makes of this workspace's Rust units,\n+# read from where each is declared rather than restated: each crate's `test` target's cargo\n+# commands from its project.json, with --no-run; the instrumented run scripts/rust-coverage.sh\n+# makes of each crate, with a filter selecting no test (cargo-llvm-cov refuses --no-report\n+# beside --no-run); and the distribution journey's release build.\n+#\n+#   scripts/pr-build-commands.sh\n+#\n+# scripts/check-warm-rust-cache.sh holds scripts/warm-rust-cache.sh to these shapes, and\n+# scripts/check-warm-rust-cache-reuse.sh runs them over what the warmer built.\n+set -euo pipefail\n+\n+fail() {\n+  echo \"pr-build-commands: $1\" >&2\n+  echo \"pr-build-commands: next: $2\" >&2\n+  exit 1\n+}\n+\n+root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n+cd \"$root\"\n+python_bin=\"$(command -v python3)\" || fail \"python3 is not on PATH\" \"install python3 and re-run\"\n+case $python_bin in\n+  /* | ?:[\\\\/]*) ;;\n+  *) python_bin=$(cd \"$(dirname \"$python_bin\")\" && pwd)/$(basename \"$python_bin\") ;;\n+esac\n+\n+\"$python_bin\" - <<'PY' | tr -d '\\r'\n+import json, pathlib, re, sys\n+\n+def refuse(path, why):\n+    sys.exit(f\"pr-build-commands: {path}: {why}; next: give its `test` target a `cargo test` command, or teach scripts/pr-build-commands.sh the new shape\")\n+\n+out = []\n+# Named with forward slashes on every platform, as every other guard here names a path.\n+for found in sorted(pathlib.Path(\"crates\").glob(\"*/project.json\"), key=lambda found: found.as_posix()):\n+    path = found.as_posix()\n+    try:\n+        with open(found, encoding=\"utf-8\") as handle:\n+            node = json.load(handle)\n+    except (OSError, ValueError) as error:\n+        sys.exit(f\"pr-build-commands: {path}: could not be read as JSON ({error}); next: fix that file so it parses\")\n+    for key in (\"targets\", \"test\", \"options\"):\n+        node = node.get(key) if isinstance(node, dict) else None\n+    if not isinstance(node, dict):\n+        refuse(path, \"has no `targets.test.options` object\")\n+    options = node\n+    commands = options[\"commands\"] if \"commands\" in options else [options.get(\"command\")]\n+    if not isinstance(commands, list) or not commands:\n+        refuse(path, \"its `test` target names no command\")\n+    built = 0\n+    for command in commands:\n+        command = command.get(\"command\") if isinstance(command, dict) else command\n+        if not isinstance(command, str):\n+            refuse(path, f\"its `test` target has a command that is not a string: {command!r}\")\n+        if command.startswith(\"cargo test \"):\n+            out.append(command.replace(\" --quiet\", \"\") + \" --no-run\")\n+            built += 1\n+        # A guard script of this repository drives the units the cargo commands built.\n+        elif not command.startswith(\"bash scripts/check-\"):\n+            refuse(path, f\"its `test` target runs `{command}`, which is neither `cargo test` nor a guard script\")\n+    if not built:\n+        refuse(path, \"its `test` target runs no `cargo test`\")\n+try:\n+    with open(\"scripts/rust-coverage.sh\", encoding=\"utf-8\") as handle:\n+        coverage = handle.read()\n+except (OSError, ValueError) as error:\n+    sys.exit(f\"pr-build-commands: scripts/rust-coverage.sh could not be read ({error}); next: restore it, which holds the instrumented run\")\n+run = re.search(r'run=\"\\$\\((cargo llvm-cov\\b.*?) 2>&1\\)\"', coverage, re.S)\n+if not run or '\"$CRATE\"' not in run.group(1):\n+    sys.exit(\"pr-build-commands: scripts/rust-coverage.sh has no `run=\\\"$(cargo llvm-cov ... \\\"$CRATE\\\" ... 2>&1)\\\"`; next: point this at its instrumented run\")\n+instrumented = \" \".join(run.group(1).replace(\"\\\\\\n\", \" \").split())\n+crates = sorted({m for c in out for m in re.findall(r\"(?:-p|--package) (\\S+)\", c)})\n+if not crates:\n+    sys.exit(\"pr-build-commands: no crate's test target runs `cargo test`; next: restore the crates' test targets\")\n+for crate in crates:\n+    out.append(instrumented.replace('\"$CRATE\"', crate) + \" -E none() --no-tests=pass\")\n+out.append(\"bash scripts/test-distribution.sh --release-build-only\")\n+# llmlint: ignore[tool_output_is_signal] Standard output is this script's machine-read interface: the two checks that call it read one build command per line.\n+print(\"\\n\".join(out))\n+PY"},{"sha":"86479800145a3385ecb9411c4d7cb3226b45acc0","filename":"scripts/project.json","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fproject.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fproject.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Fproject.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -64,7 +64,9 @@\n           \"bash scripts/check-selection-line-endings.sh\",\n           \"bash scripts/check-selection-code-page.sh\",\n           \"bash scripts/check-scoped-release-plz.sh\",\n-          \"python3 scripts/test_cli_wheel_lock.py\"\n+          \"python3 scripts/test_cli_wheel_lock.py\",\n+          \"bash scripts/check-warm-rust-cache.sh\",\n+          \"bash scripts/check-warm-rust-cache-reuse-enforced.sh\"\n         ],\n         \"parallel\": false\n       },"},{"sha":"37defd29a0b719c1e63b4029e6fa0c345f99ee7a","filename":"scripts/test-distribution.sh","status":"modified","additions":13,"deletions":1,"changes":14,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Ftest-distribution.sh","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Ftest-distribution.sh","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Ftest-distribution.sh?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -81,6 +81,18 @@ case \"$(uname -s):$(uname -m)\" in\n   MINGW*:x86_64|MSYS*:x86_64|CYGWIN*:x86_64) target=x86_64-pc-windows-msvc; ext=zip; binary=onetaskgraph.exe;;\n esac\n name=\"onetaskgraph-${tag}-${target}.${ext}\"\n+# The release build this journey packages, in one place: the Rust cache warmer\n+# (.github/workflows/rust-cache-warm.yml) runs it alone, `--release-build-only`, so the units\n+# it leaves for the pull-request jobs to restore are exactly the ones built here.\n+build_release_wheel() {\n+  (cd \"$root\" && \"$python_bin\" scripts/cli_wheel_lock.py uv tool run --from 'maturin>=1.9,<2' maturin build --release --locked --target \"$target\" --out \"$1\")\n+}\n+# Exit 2 is a usage error: any argument but --release-build-only alone.\n+case \"$#:${1:-}\" in\n+  0:) ;;\n+  1:--release-build-only) build_release_wheel \"$tmp/python-wheel\"; exit 0 ;;\n+  *) echo \"distribution test takes no argument or --release-build-only alone, not '$*'; next: run scripts/test-distribution.sh with none\" >&2; exit 2 ;;\n+esac\n # The binary is what onetaskgraph:build produced and this target depends on; nothing here\n # builds it, because a cargo invocation of that package from anywhere else replaces the\n # file while the Rust integration tests are spawning it (scripts/check-workspace-config.sh).\n@@ -366,7 +378,7 @@ for supported in linux:x64 linux:arm64 darwin:arm64 win32:x64; do\n done\n uv run --quiet --locked --package onetaskgraph-sdk onetaskgraph --help | grep -q 'Usage:' || { echo \"Python SDK dependency did not supply the real command; next: inspect the SDK carrier dependency\" >&2; exit 1; }\n mkdir -p \"$tmp/python-wheel\"\n-(cd \"$root\" && \"$python_bin\" scripts/cli_wheel_lock.py uv tool run --from 'maturin>=1.9,<2' maturin build --release --locked --target \"$target\" --out \"$tmp/python-wheel\")\n+build_release_wheel \"$tmp/python-wheel\"\n \"$python_bin\" \"$root/scripts/test-release-products.py\" --wheel-dir \"$tmp/python-wheel\" --target \"$target\"\n cli_wheel=$(find \"$tmp/python-wheel\" -maxdepth 1 -type f -name 'onetaskgraph_cli-*.whl' -print -quit)\n [[ -n $cli_wheel ]] || { echo \"Python CLI build produced no wheel; next: inspect the maturin package configuration\" >&2; exit 1; }"},{"sha":"1bde8390d80928e5643a1eddca833a5bbac4819b","filename":"scripts/warm-rust-cache.sh","status":"added","additions":72,"deletions":0,"changes":72,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fwarm-rust-cache.sh","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/scripts%2Fwarm-rust-cache.sh","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/scripts%2Fwarm-rust-cache.sh?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,72 @@\n+#!/usr/bin/env bash\n+# Build what test-linux and test-windows build, and run nothing.\n+#\n+#   scripts/warm-rust-cache.sh [--instrumented]\n+#\n+# Exits 0 once everything is built, 1 when a build fails, 2 on any other argument.\n+#\n+# .github/workflows/rust-cache-warm.yml runs this on every push to main. The cache keeps\n+# dependency units only, so what matters is that these are the very units the jobs compile —\n+# scripts/check-warm-rust-cache.sh holds them to the shapes scripts/pr-build-commands.sh reads:\n+#\n+#   every workspace crate's test units, with every feature and with its defaults, as the\n+#   crates' `test` targets build them;\n+#   with --instrumented (Linux), the same under cargo-llvm-cov, exactly as\n+#   scripts/rust-coverage.sh builds them, with a filter that selects no test;\n+#   the distribution journey's release build, by its own --release-build-only.\n+set -euo pipefail\n+\n+fatal() {\n+  echo \"warm-rust-cache: $1\" >&2\n+  echo \"warm-rust-cache: next: $2\" >&2\n+  exit 1\n+}\n+\n+instrumented=false\n+case \"$#:${1:-}\" in\n+  0:) ;;\n+  1:--instrumented) instrumented=true ;;\n+  *)\n+    echo \"warm-rust-cache: takes no argument or --instrumented alone, not '$*'\" >&2\n+    echo \"warm-rust-cache: next: run it with none, or with --instrumented on Linux\" >&2\n+    exit 2\n+    ;;\n+esac\n+\n+# Nothing here opens a live session, and nothing may: it builds the live crates' tests.\n+unset GH_PROJECTS_TOKEN LINEAR_API_KEY ONETASKGRAPH_LIVE_REQUIRED\n+\n+ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\" || fatal \\\n+  \"could not resolve this repository's root from ${BASH_SOURCE[0]}\" \\\n+  \"run it from a checkout of this repository\"\n+cd \"$ROOT\"\n+\n+crates=\"$(cargo metadata --no-deps --format-version 1 --locked \\\n+  | python3 -c 'import json, sys\n+document = json.load(sys.stdin)\n+packages = document.get(\"packages\") if isinstance(document, dict) else None\n+if not isinstance(packages, list) or not packages or not all(\n+    isinstance(package, dict) and isinstance(package.get(\"name\"), str) and package[\"name\"].strip()\n+    for package in packages\n+):\n+    raise SystemExit(\"cargo metadata did not answer with a packages array of named packages\")\n+print(\"\\n\".join(package[\"name\"] for package in packages))\n+' \\\n+  | tr -d '\\r')\" || fatal \"could not list the workspace's crates\" \"run 'cargo metadata --no-deps' and fix what it reports\"\n+[ -n \"$crates\" ] || fatal \"the workspace lists no crate\" \"run 'cargo metadata --no-deps' and fix what it reports\"\n+\n+next=\"fix what it reports above, then rerun; the pull-request job it warms would fail the same way\"\n+for crate in $crates; do\n+  cargo test --quiet --no-run --locked --all-features -p \"$crate\" \\\n+    || fatal \"building $crate's test units with every feature failed\" \"$next\"\n+  cargo test --quiet --no-run --locked -p \"$crate\" \\\n+    || fatal \"building $crate's test units with its default features failed\" \"$next\"\n+  if \"$instrumented\"; then\n+    cargo llvm-cov --no-report nextest --package \"$crate\" --all-features --locked \\\n+      -E 'none()' --no-tests=pass \\\n+      || fatal \"building $crate's instrumented test units failed\" \"$next\"\n+  fi\n+done\n+\n+bash scripts/test-distribution.sh --release-build-only \\\n+  || fatal \"the distribution journey's release build failed\" \"$next\""},{"sha":"d92fda5c01baa987def404efedd07de732751eb9","filename":"sdks/python/generate.py","status":"modified","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fgenerate.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fgenerate.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Fgenerate.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -75,6 +75,8 @@\n     \"task_render\": \"Regenerated\",\n     \"task_answers\": \"TemplateAnswers\",\n     \"task_assets\": \"TaskAssetNames\",\n+    # One human task projected idempotently: its task, canonical URL, project and source.\n+    \"task_project_human\": \"HumanTaskProjected\",\n     # A created project as `project show` answers with it.\n     \"project_create\": \"QueryResponseOfQualifiedProject\",\n     \"project_render\": \"Regenerated\",\n@@ -144,6 +146,9 @@\n     \"SourceCacheConfig\",\n     \"CacheUse\",\n     \"ExpectedWrite\",\n+    # The v1 request `task project-human` reads from its input file, which a producer builds\n+    # by name from the one declaration the engine exports.\n+    \"HumanTaskProjection\",\n }\n # Commands that answer in more than one shape, by the plugin of the source they are asked\n # about: each command's RESPONSE_ROOTS entry is one shape, and these are the others. `sources\n@@ -190,6 +195,8 @@ def response_roots() -> set[str]:\n     \"group_by\": \"str\",\n     \"id\": \"str\",\n     \"in_\": \"choices\",\n+    # The file holding a `HumanTaskProjection` request, or `-` for standard input.\n+    \"input\": \"str\",\n     # The issue references a landing closed, each `owner/name#N`.\n     \"issue\": \"list[str] | tuple[str, ...]\",\n     \"kind\": \"choices\",\n@@ -243,6 +250,7 @@ def response_roots() -> set[str]:\n     \"no_link\": None,\n     \"no_counterpart\": None,\n     \"answers\": \"FILE\",\n+    \"input\": \"FILE\",\n     \"asset\": \"PATH\",\n     \"author\": \"NAME\",\n     \"body_file\": \"PATH\",\n@@ -862,6 +870,8 @@ def operands(command: tuple[str, ...]) -> tuple[str, ...]:\n     (\"task\", \"assets\"): (\"output_dir\",),\n     # A locate answers where a copy into one source would land, so it names that source.\n     (\"task\", \"locate\"): (\"to\",),\n+    # A projection has nothing to project without its request.\n+    (\"task\", \"project-human\"): (\"input\",),\n }\n \n # Commands whose required options are keyword-only: named at every call rather than taken by"},{"sha":"7713cc1a650edde3da7fcd1ce8911cfca2c48875","filename":"sdks/python/pyproject.toml","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fpyproject.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fpyproject.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Fpyproject.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,13 +1,13 @@\n [project]\n name = \"onetaskgraph-sdk\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n description = \"The Python SDK for onetaskgraph, generated from the binary's own JSON Schema bundle.\"\n readme = \"README.md\"\n requires-python = \">=3.13\"\n license = \"MIT\"\n authors = [{ name = \"Nick DeRobertis\" }]\n classifiers = [\"Typing :: Typed\"]\n-dependencies = [\"onetaskgraph-cli==0.12.12\", \"pydantic>=2.12\"]\n+dependencies = [\"onetaskgraph-cli==0.12.13\", \"pydantic>=2.12\"]\n \n [project.urls]\n Repository = \"https://github.com/nickderobertis/onetaskgraph\""},{"sha":"163c1dfa5e8c7d8e2bdb2a3a86bd152a55c3f1e7","filename":"sdks/python/src/onetaskgraph_sdk/__init__.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F__init__.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F__init__.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F__init__.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -23,7 +23,7 @@\n \n #: The version this package publishes. `pyproject.toml`, the Cargo workspace and the\n #: TypeScript package must all agree; scripts/check-workspace-config.sh reconciles them.\n-__version__ = \"0.12.12\"\n+__version__ = \"0.12.13\"\n \n if not TYPE_CHECKING:\n "},{"sha":"0603ed815f5ffca2af0162fd7e82ded602ce1d69","filename":"sdks/python/src/onetaskgraph_sdk/_generated/client.py","status":"modified","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fclient.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fclient.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fclient.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -22,6 +22,7 @@\n         EffectiveConfig,\n         FieldsReport,\n         GlobalId,\n+        HumanTaskProjected,\n         IssuesCompleted,\n         LocateReport,\n         MetadataSet,\n@@ -1400,6 +1401,24 @@ async def task_priority_set(\n             term_scope=_strings(\"task_priority_set\", \"term_scope\", term_scope),\n         )\n \n+    async def task_project_human(\n+        self,\n+        input: str,\n+        *,\n+        default_sources: list[str] | tuple[str, ...] | None = None,\n+        page_size: int | None = None,\n+        set: list[str] | tuple[str, ...] | None = None,\n+    ) -> HumanTaskProjected:\n+        \"\"\"Run ``onetaskgraph task project-human``.\"\"\"\n+        return await self._invoke(\n+            [\"task\", \"project-human\"],\n+            _models.HumanTaskProjected,\n+            input=input,\n+            default_sources=default_sources,\n+            page_size=page_size,\n+            set=set,\n+        )\n+\n     async def task_render(\n         self,\n         id: GlobalId | str,"},{"sha":"41ab233fd6453e29f18c7edd15dbd1ef57ae2846","filename":"sdks/python/src/onetaskgraph_sdk/_generated/human_task_projected.py","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fhuman_task_projected.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fhuman_task_projected.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fhuman_task_projected.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,29 @@\n+# ruff: noqa: E501  # Generated descriptions preserve the schema's text.\n+# generated by datamodel-codegen:\n+#   schema root: HumanTaskProjected\n+\n+from __future__ import annotations\n+\n+from typing import Annotated\n+\n+from pydantic import BaseModel, ConfigDict, Field, RootModel\n+\n+\n+class SourceName(RootModel[str]):\n+    root: Annotated[\n+        str,\n+        Field(\n+            description=\"The name a configuration document gives one configured source.\",\n+            pattern=\"^[a-z0-9][a-z0-9-]*$\",\n+        ),\n+    ]\n+\n+\n+class HumanTaskProjected(BaseModel):\n+    model_config = ConfigDict(\n+        extra=\"forbid\",\n+    )\n+    project: Annotated[str, Field(description=\"The resolved destination project.\")]\n+    source: Annotated[SourceName, Field(description=\"The resolved configured source.\")]\n+    task: Annotated[str, Field(description=\"The qualified task identity.\")]\n+    url: Annotated[str, Field(description=\"The canonical tracker issue URL.\")]"},{"sha":"7181c972455c13cb652db4bf06e07019be64e3d1","filename":"sdks/python/src/onetaskgraph_sdk/_generated/human_task_projection.py","status":"added","additions":95,"deletions":0,"changes":95,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fhuman_task_projection.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fhuman_task_projection.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fhuman_task_projection.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,95 @@\n+# ruff: noqa: E501  # Generated descriptions preserve the schema's text.\n+# generated by datamodel-codegen:\n+#   schema root: HumanTaskProjection\n+\n+from __future__ import annotations\n+\n+from enum import StrEnum\n+from typing import Annotated, Literal\n+\n+from pydantic import BaseModel, ConfigDict, Field, RootModel\n+\n+\n+class Priority(StrEnum):\n+    PriorityNone = \"none\"\n+    PriorityUrgent = \"urgent\"\n+    PriorityHigh = \"high\"\n+    PriorityMedium = \"medium\"\n+    PriorityLow = \"low\"\n+\n+\n+class ProjectionOwner(BaseModel):\n+    model_config = ConfigDict(\n+        extra=\"forbid\",\n+    )\n+    plan: Annotated[str | None, Field(description=\"The owning plan, when applicable.\")]\n+    run: Annotated[str | None, Field(description=\"The owning run, when applicable.\")]\n+    session: Annotated[str, Field(description=\"The owning session.\")]\n+\n+\n+class ProjectionState(StrEnum):\n+    ProjectionStateOpen = \"open\"\n+    ProjectionStateCompleted = \"completed\"\n+    ProjectionStateDismissed = \"dismissed\"\n+\n+\n+class ProjectionVersion(RootModel[Literal[1]]):\n+    root: Literal[1]\n+\n+\n+class Repository(RootModel[str]):\n+    root: Annotated[\n+        str,\n+        Field(\n+            description=\"A repository identified by its normalized origin, without a URL scheme or `.git` suffix.\"\n+        ),\n+    ]\n+\n+\n+class SourceName(RootModel[str]):\n+    root: Annotated[\n+        str,\n+        Field(\n+            description=\"The name a configuration document gives one configured source.\",\n+            pattern=\"^[a-z0-9][a-z0-9-]*$\",\n+        ),\n+    ]\n+\n+\n+class HumanTaskProjection(BaseModel):\n+    model_config = ConfigDict(\n+        extra=\"forbid\",\n+    )\n+    body: Annotated[str, Field(description=\"The visible task content.\")]\n+    item_id: Annotated[\n+        str,\n+        Field(description=\"The external idempotency identity, stable across producer retries.\"),\n+    ]\n+    owner: Annotated[ProjectionOwner, Field(description=\"The producer that owns the intent.\")]\n+    priority: Annotated[\n+        Priority,\n+        Field(description=\"Its priority, using the existing plugin API serialization.\"),\n+    ]\n+    project: Annotated[\n+        str | None,\n+        Field(\n+            description=\"The plan's resolved destination project, or null for a configured human project.\"\n+        ),\n+    ]\n+    reason: Annotated[\n+        str | None,\n+        Field(description=\"An optional dismissal reason. Omission and null both preserve absence.\"),\n+    ] = None\n+    repositories: Annotated[\n+        list[Repository],\n+        Field(description=\"Normalized repository origins whose work this item concerns.\"),\n+    ]\n+    schema_version: Annotated[\n+        ProjectionVersion, Field(description=\"The wire contract version, always 1.\")\n+    ]\n+    source: Annotated[\n+        SourceName,\n+        Field(description=\"The configured source through which placement is resolved.\"),\n+    ]\n+    state: Annotated[ProjectionState, Field(description=\"The desired lifecycle.\")]\n+    title: Annotated[str, Field(description=\"The visible task title.\")]"},{"sha":"f4d47733ecad92af2900127dfc80395caad1a2ab","filename":"sdks/python/src/onetaskgraph_sdk/_generated/models.py","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fmodels.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fmodels.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Fsrc%2Fonetaskgraph_sdk%2F_generated%2Fmodels.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -22,6 +22,8 @@\n     from .failure_document import FailureDocument as FailureDocument\n     from .fields_report import FieldsReport as FieldsReport\n     from .global_id import GlobalId as GlobalId\n+    from .human_task_projected import HumanTaskProjected as HumanTaskProjected\n+    from .human_task_projection import HumanTaskProjection as HumanTaskProjection\n     from .issues_completed import IssuesCompleted as IssuesCompleted\n     from .item_type import ItemType as ItemType\n     from .linear_config import LinearConfig as LinearConfig\n@@ -100,6 +102,8 @@\n     \"FailureDocument\",\n     \"FieldsReport\",\n     \"GlobalId\",\n+    \"HumanTaskProjected\",\n+    \"HumanTaskProjection\",\n     \"IssuesCompleted\",\n     \"ItemType\",\n     \"LinearConfig\",\n@@ -170,6 +174,8 @@\n     \"FailureDocument\": (\"failure_document\", \"FailureDocument\"),\n     \"FieldsReport\": (\"fields_report\", \"FieldsReport\"),\n     \"GlobalId\": (\"global_id\", \"GlobalId\"),\n+    \"HumanTaskProjected\": (\"human_task_projected\", \"HumanTaskProjected\"),\n+    \"HumanTaskProjection\": (\"human_task_projection\", \"HumanTaskProjection\"),\n     \"IssuesCompleted\": (\"issues_completed\", \"IssuesCompleted\"),\n     \"ItemType\": (\"item_type\", \"ItemType\"),\n     \"LinearConfig\": (\"linear_config\", \"LinearConfig\"),"},{"sha":"10c1237c74473a3001412284c70ac873dbfb4c8c","filename":"sdks/python/tests/test_artifact.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Ftests%2Ftest_artifact.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Ftests%2Ftest_artifact.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Ftests%2Ftest_artifact.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -271,7 +271,7 @@ def test_the_generated_package_is_built_from_the_schema_bundle_this_sdk_expects(\n     # read from the raw document and the roots from the validated one.\n     bundle = generate.validate_schema_bundle(emitted_bundle)\n \n-    assert emitted_bundle[\"version\"] == 49\n+    assert emitted_bundle[\"version\"] == 50\n     assert \"LocateReport\" in bundle[\"roots\"]\n     assert \"reachable\" in emitted_bundle[\"roots\"][\"SourceRoute\"][\"required\"]\n     assert \"task locate\" in emitted_bundle[\"commands\"]"},{"sha":"96b80066bc8d0db8689d558cc49880404a2f12f4","filename":"sdks/python/tests/test_client.py","status":"modified","additions":212,"deletions":0,"changes":212,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Ftests%2Ftest_client.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Ftests%2Ftest_client.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Ftests%2Ftest_client.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -10,8 +10,10 @@\n import threading\n import tomllib\n from collections.abc import Coroutine, Mapping\n+from dataclasses import asdict, dataclass\n from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n from pathlib import Path\n+from typing import Literal, NewType\n \n import pytest\n from pydantic import ValidationError\n@@ -21,6 +23,7 @@\n     Delivered,\n     FieldsReport,\n     GlobalId,\n+    HumanTaskProjection,\n     IssuesCompleted,\n     MetadataSet,\n     OnetaskgraphError,\n@@ -319,6 +322,215 @@ def log_message(self, format: str, *args: object) -> None:\n         thread.join()\n \n \n+LinearProjectId = NewType(\"LinearProjectId\", str)\n+\"\"\"A Linear project's id, as ``issueCreate`` names the project an issue is filed in.\"\"\"\n+\n+LinearStateId = NewType(\"LinearStateId\", str)\n+\"\"\"A Linear workflow state's id.\"\"\"\n+\n+LinearStateType = Literal[\"unstarted\", \"completed\", \"canceled\"]\n+\"\"\"The workflow-state categories the loopback team holds.\"\"\"\n+\n+\n+@dataclass(frozen=True)\n+class GraphqlRequest:\n+    \"\"\"One GraphQL request a loopback tracker received: its document and its variables.\"\"\"\n+\n+    query: str\n+    variables: dict[str, object]\n+\n+    @classmethod\n+    def parse(cls, raw: bytes) -> GraphqlRequest:\n+        \"\"\"Decode a request body, refusing one that names no document.\"\"\"\n+        decoded = json.loads(raw)\n+        if not isinstance(decoded, dict) or not isinstance(decoded.get(\"query\"), str):\n+            raise ValueError(\"a GraphQL request names its query\")\n+        variables = decoded.get(\"variables\") or {}\n+        if not isinstance(variables, dict):\n+            raise ValueError(\"a GraphQL request's variables are an object\")\n+        return cls(query=decoded[\"query\"], variables=variables)\n+\n+\n+@dataclass(frozen=True)\n+class LinearIssueInput:\n+    \"\"\"The ``issueCreate`` input a projection sends: what the loopback stores.\"\"\"\n+\n+    title: str\n+    description: str\n+    priority: int\n+    project_id: LinearProjectId\n+\n+    @classmethod\n+    def of(cls, request: GraphqlRequest) -> LinearIssueInput:\n+        \"\"\"Read the input of an ``issueCreate`` request, refusing one missing a member.\"\"\"\n+        stored = request.variables.get(\"input\")\n+        if not isinstance(stored, dict):\n+            raise ValueError(\"issueCreate names its input\")\n+        return cls(\n+            title=str(stored[\"title\"]),\n+            description=str(stored[\"description\"]),\n+            priority=int(stored[\"priority\"]),\n+            project_id=LinearProjectId(str(stored[\"projectId\"])),\n+        )\n+\n+    def answered(self) -> dict[str, object]:\n+        \"\"\"The issue Linear answers ``issueCreate`` with, stored as given.\"\"\"\n+        return {\n+            \"id\": \"ISSUE-1\",\n+            \"identifier\": \"FIX-1\",\n+            \"title\": self.title,\n+            \"description\": self.description,\n+            \"url\": \"https://linear.app/fixture/issue/FIX-1\",\n+            \"createdAt\": None,\n+            \"updatedAt\": \"2026-09-01T00:00:00Z\",\n+            \"archivedAt\": None,\n+            \"state\": {\"name\": \"Todo\", \"type\": \"unstarted\"},\n+            \"priority\": self.priority,\n+            \"labels\": {\"nodes\": []},\n+            \"project\": {\"id\": self.project_id},\n+        }\n+\n+\n+@dataclass(frozen=True)\n+class LinearState:\n+    \"\"\"One workflow state of the loopback team.\"\"\"\n+\n+    id: LinearStateId\n+    name: str\n+    type: LinearStateType\n+\n+\n+LINEAR_STATES = (\n+    LinearState(LinearStateId(\"STATE-todo\"), \"Todo\", \"unstarted\"),\n+    LinearState(LinearStateId(\"STATE-done\"), \"Done\", \"completed\"),\n+    LinearState(LinearStateId(\"STATE-canceled\"), \"Canceled\", \"canceled\"),\n+)\n+\n+\n+def linear_projection_handler(received: list[GraphqlRequest]) -> type[BaseHTTPRequestHandler]:\n+    \"\"\"Build a loopback Linear answering the two documents a cold projection sends.\n+\n+    Those are the team's resolution and ``issueCreate``, answered with the issue it stored.\n+    \"\"\"\n+\n+    class LinearHandler(BaseHTTPRequestHandler):\n+        def do_POST(self) -> None:  # noqa: N802  # stdlib handler API names the method.\n+            length = int(self.headers[\"content-length\"])\n+            request = GraphqlRequest.parse(self.rfile.read(length))\n+            received.append(request)\n+            data: dict[str, object]\n+            match request.query:\n+                case query if \"teams(\" in query:\n+                    states = [asdict(state) for state in LINEAR_STATES]\n+                    data = {\n+                        \"organization\": {\"id\": \"ORG-1\"},\n+                        \"teams\": {\n+                            \"nodes\": [\n+                                {\n+                                    \"id\": \"TEAM-1\",\n+                                    \"states\": {\n+                                        \"nodes\": states,\n+                                        \"pageInfo\": {\"hasNextPage\": False},\n+                                    },\n+                                }\n+                            ]\n+                        },\n+                        \"projectStatuses\": {\"nodes\": [], \"pageInfo\": {\"hasNextPage\": False}},\n+                    }\n+                case query if \"issueCreate(\" in query:\n+                    data = {\n+                        \"issueCreate\": {\n+                            \"success\": True,\n+                            \"issue\": LinearIssueInput.of(request).answered(),\n+                        }\n+                    }\n+                case _:\n+                    self.send_response(400)\n+                    self.end_headers()\n+                    return\n+            body = json.dumps({\"data\": data}).encode()\n+            self.send_response(200)\n+            self.send_header(\"content-type\", \"application/json\")\n+            self.send_header(\"content-length\", str(len(body)))\n+            self.end_headers()\n+            self.wfile.write(body)\n+\n+        def log_message(self, format: str, *args: object) -> None:\n+            return\n+\n+    return LinearHandler\n+\n+\n+def test_a_human_task_is_projected_through_the_real_binary_into_a_loopback_linear(\n+    binary: Path, tmp_path: Path\n+) -> None:\n+    \"\"\"Project one human task and decode the binding the binary answers with.\"\"\"\n+    received: list[GraphqlRequest] = []\n+    server = ThreadingHTTPServer((\"127.0.0.1\", 0), linear_projection_handler(received))\n+    thread = threading.Thread(target=server.serve_forever)\n+    thread.start()\n+    try:\n+        config = {\n+            \"sources\": {\n+                \"org\": {\n+                    \"plugin\": \"linear\",\n+                    \"config\": {\n+                        \"endpoint\": f\"http://127.0.0.1:{server.server_port}/graphql\",\n+                        \"team\": \"FIX\",\n+                        \"status_mapping\": {\"todo\": \"Todo\", \"done\": \"Done\", \"cancelled\": \"Canceled\"},\n+                    },\n+                    \"cache\": {\"dir\": str(tmp_path / \"cache\")},\n+                    \"task_projection\": {\n+                        \"host\": \"sdk-host\",\n+                        \"directory\": str(tmp_path / \"intents\"),\n+                        \"project\": \"P-1\",\n+                    },\n+                }\n+            }\n+        }\n+        (tmp_path / \"onetaskgraph.yaml\").write_text(json.dumps(config), encoding=\"utf-8\")\n+        request = HumanTaskProjection.model_validate(\n+            {\n+                \"schema_version\": 1,\n+                \"item_id\": \"sdk-item\",\n+                \"owner\": {\"session\": \"session-1\", \"run\": None, \"plan\": None},\n+                \"title\": \"Decide on the release\",\n+                \"body\": \"Choose a date.\",\n+                \"priority\": \"high\",\n+                \"repositories\": [],\n+                \"project\": None,\n+                \"source\": \"org\",\n+                \"state\": \"open\",\n+                \"reason\": None,\n+            }\n+        )\n+        (tmp_path / \"request.json\").write_text(request.model_dump_json(), encoding=\"utf-8\")\n+        client = Client(\n+            binary,\n+            cwd=tmp_path,\n+            environment={\n+                **os.environ,\n+                \"LINEAR_API_KEY\": \"fixture-key\",\n+                \"ONETASKGRAPH_HOST\": \"sdk-host\",\n+            },\n+        )\n+        projected = run(client.task_project_human(str(tmp_path / \"request.json\")))\n+        assert projected.source.root == \"org\"\n+        assert projected.task == \"org:ISSUE-1\"\n+        assert projected.url == \"https://linear.app/fixture/issue/FIX-1\"\n+        assert projected.project == \"P-1\"\n+        creates = [call for call in received if \"issueCreate(\" in call.query]\n+        assert len(creates) == 1\n+        # Bound: the same request again is the same answer, and the tracker is asked nothing.\n+        before = len(received)\n+        assert run(client.task_project_human(str(tmp_path / \"request.json\"))) == projected\n+        assert len(received) == before\n+    finally:\n+        server.shutdown()\n+        server.server_close()\n+        thread.join()\n+\n+\n def landed(outcome: CopyOutcome) -> str:\n     \"\"\"The id a copy wrote to, absent only for a dry run that would have created one.\"\"\"\n     reported = outcome.root"},{"sha":"4f6f0d206106220384622ac0b028ed43bdf9cc53","filename":"sdks/python/tests/test_measure_import.py","status":"modified","additions":6,"deletions":1,"changes":7,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Ftests%2Ftest_measure_import.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Ftests%2Ftest_measure_import.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Ftests%2Ftest_measure_import.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -65,7 +65,12 @@ def test_the_figure_and_every_share_reach_the_file_onebudgetspec_names(tmp_path:\n         \"load average\",\n     ):\n         assert share in detail, f\"the detail does not name {share!r}: {detail}\"\n-    assert f\"import, validate and exit median {reported['value']:.3f} s\" in detail\n+    quoted = re.search(r\"import, validate and exit median (\\d+\\.\\d{3}) s\", detail)\n+    assert quoted, f\"the detail does not quote the figure's median: {detail}\"\n+    # The detail rounds the median to three places and the value to four, so formatting the\n+    # value again rounds twice: a median of 0.10851 is quoted 0.109 and reported 0.1085, which\n+    # reformats as 0.108. The two agree to within the detail's own half a thousandth.\n+    assert abs(float(quoted.group(1)) - reported[\"value\"]) <= 0.0005 + 1e-9, detail\n     # What onebudgetspec records is what a person running the script reads.\n     assert ran.stderr.strip() == detail\n "},{"sha":"e65de5a21be2ea2e2a1ebbdb4750aeb0fe0ce240","filename":"sdks/python/tests/test_typed_surface.py","status":"modified","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Ftests%2Ftest_typed_surface.py","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Fpython%2Ftests%2Ftest_typed_surface.py","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Fpython%2Ftests%2Ftest_typed_surface.py?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -41,6 +41,8 @@\n     FailureDocument,\n     FieldsReport,\n     GlobalId,\n+    HumanTaskProjected,\n+    HumanTaskProjection,\n     IssuesCompleted,\n     ItemType,\n     LinearConfig,\n@@ -146,6 +148,12 @@\n from onetaskgraph_sdk._generated.models import (\n     GlobalId as ModelsGlobalId,\n )\n+from onetaskgraph_sdk._generated.models import (\n+    HumanTaskProjected as ModelsHumanTaskProjected,\n+)\n+from onetaskgraph_sdk._generated.models import (\n+    HumanTaskProjection as ModelsHumanTaskProjection,\n+)\n from onetaskgraph_sdk._generated.models import (\n     IssuesCompleted as ModelsIssuesCompleted,\n )\n@@ -341,6 +349,8 @@ def test_this_file_imports_every_name_the_module_exports(module: object) -> None\n     \"FailureDocument\": FailureDocument,\n     \"FieldsReport\": FieldsReport,\n     \"GlobalId\": GlobalId,\n+    \"HumanTaskProjected\": HumanTaskProjected,\n+    \"HumanTaskProjection\": HumanTaskProjection,\n     \"IssuesCompleted\": IssuesCompleted,\n     \"ItemType\": ItemType,\n     \"LinearConfig\": LinearConfig,\n@@ -413,6 +423,8 @@ def test_this_file_imports_every_name_the_module_exports(module: object) -> None\n     \"FailureDocument\": ModelsFailureDocument,\n     \"FieldsReport\": ModelsFieldsReport,\n     \"GlobalId\": ModelsGlobalId,\n+    \"HumanTaskProjected\": ModelsHumanTaskProjected,\n+    \"HumanTaskProjection\": ModelsHumanTaskProjection,\n     \"IssuesCompleted\": ModelsIssuesCompleted,\n     \"ItemType\": ModelsItemType,\n     \"LinearConfig\": ModelsLinearConfig,\n@@ -551,6 +563,8 @@ def test_client_methods_answer_with_the_types_they_declare(binary: Path, tmp_pat\n     \"FailureDocument\": FailureDocument,\n     \"FieldsReport\": FieldsReport,\n     \"GlobalId\": GlobalId,\n+    \"HumanTaskProjected\": HumanTaskProjected,\n+    \"HumanTaskProjection\": HumanTaskProjection,\n     \"IssuesCompleted\": IssuesCompleted,\n     \"LinearConfig\": LinearConfig,\n     \"LocateReport\": LocateReport,\n@@ -614,6 +628,8 @@ def test_client_methods_answer_with_the_types_they_declare(binary: Path, tmp_pat\n     \"FailureDocument\": ModelsFailureDocument,\n     \"FieldsReport\": ModelsFieldsReport,\n     \"GlobalId\": ModelsGlobalId,\n+    \"HumanTaskProjected\": ModelsHumanTaskProjected,\n+    \"HumanTaskProjection\": ModelsHumanTaskProjection,\n     \"IssuesCompleted\": ModelsIssuesCompleted,\n     \"LinearConfig\": ModelsLinearConfig,\n     \"LocateReport\": ModelsLocateReport,"},{"sha":"6700c64046e6706e7ca7ecbb88619662b4d9ad7f","filename":"sdks/typescript/package.json","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fpackage.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fpackage.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Ftypescript%2Fpackage.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n {\n   \"name\": \"@onetaskgraph/sdk\",\n   \"//\": \"llmlint: ignore-file[projects_stay_in_one_js_workspace] This package IS the JS workspace's one member; what the rule reads as a second is the optionalDependency below, which is the published launcher an end user installs beside the SDK and resolves from the registry at their own install. `workspace:*` names nothing there, and npm/cli is not a workspace member for the reason its own manifest records. scripts/set-version.sh writes this number and `--check` refuses any other, under distribution-check. JSON has no comment to scope this to the one line.\",\n-  \"version\": \"0.12.12\",\n+  \"version\": \"0.12.13\",\n   \"description\": \"The TypeScript SDK for onetaskgraph, generated from the binary's own JSON Schema bundle.\",\n   \"license\": \"MIT\",\n   \"type\": \"module\",\n@@ -28,7 +28,7 @@\n     \"generate:check\": \"bun scripts/generate.ts --check\"\n   },\n   \"optionalDependencies\": {\n-    \"@onetaskgraph/cli\": \"0.12.12\"\n+    \"@onetaskgraph/cli\": \"0.12.13\"\n   },\n   \"devDependencies\": {\n     \"ajv\": \"8.17.1\","},{"sha":"c3269fbdd6b757a1f5bea6baa3f9509113850408","filename":"sdks/typescript/src/client.ts","status":"modified","additions":14,"deletions":1,"changes":15,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Fclient.ts","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Fclient.ts","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Ftypescript%2Fsrc%2Fclient.ts?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -14,6 +14,7 @@ import type {\n   EffectiveConfig,\n   FailureDocument,\n   FieldsReport,\n+  HumanTaskProjected,\n   IssuesCompleted,\n   LocateReport,\n   MetadataSet,\n@@ -297,6 +298,8 @@ export const commandResponseRoots: Readonly<Record<string, keyof typeof runtimeS\n   \"task render\": \"Regenerated\",\n   \"task answers\": \"TemplateAnswers\",\n   \"task assets\": \"TaskAssetNames\",\n+  // One human task projected idempotently: its task, canonical URL, project and source.\n+  \"task project-human\": \"HumanTaskProjected\",\n   \"document create\": \"DocumentDetail\",\n   \"document render\": \"Regenerated\",\n   \"document answers\": \"TemplateAnswers\",\n@@ -320,7 +323,8 @@ export const commandAlternateRoots: Readonly<\n // several nor keeps anything in step, so exit 4 is not a code it can produce and not one this\n // client accepts from it. A `metadata set` is the same: one write to one source, and metadata is\n // not status, so it keeps no delivered task in step — and so are `priority set` and `content\n-// set`, for the same reason. `sources fields` sets up one board and answers for it whole, or\n+// set`, for the same reason. `task project-human` writes one item to one source and keeps\n+// nothing in step. `sources fields` sets up one board and answers for it whole, or\n // fails, and `sources route` reads configuration alone. `project graph` prints a graph or\n // nothing, and a graph lacking a private source it could not ask names it in `unanswered` and\n // exits 0, so it never exits 4. `task assets` reads one task from one source and\n@@ -343,6 +347,7 @@ const partialResponseCommands = new Set(\n       !command.endsWith(\" render\") &&\n       !command.endsWith(\" answers\") &&\n       command !== \"task assets\" &&\n+      command !== \"task project-human\" &&\n       command !== \"project create\" &&\n       command !== \"document create\",\n   ),\n@@ -1416,6 +1421,14 @@ export class OnetaskgraphClient {\n   taskAssets(id: string, outputDir: string): Promise<TaskAssetNames> {\n     return this.run(\"task assets\", [id, \"--output-dir\", outputDir]);\n   }\n+  // Project one human task from the `HumanTaskProjection` request at `input`, a file path or\n+  // `-` for standard input: created once by its `item_id`, and settled once at a terminal state.\n+  taskProjectHuman(input: string): Promise<HumanTaskProjected> {\n+    return this.run(\"task project-human\", [\n+      \"--input\",\n+      stringOption(\"taskProjectHuman\", \"input\", input),\n+    ]);\n+  }\n   // Create — or, with `id` naming one the source holds, replace — a project, its description\n   // rendered from a template or given as it is; it answers as `projectShow` does.\n   async projectCreate("},{"sha":"203cdf30cb39112d59d7c1eaafd706a0f5912c67","filename":"sdks/typescript/src/generated/commands.ts","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Fgenerated%2Fcommands.ts","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Fgenerated%2Fcommands.ts","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Ftypescript%2Fsrc%2Fgenerated%2Fcommands.ts?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -28,6 +28,7 @@ export const binaryCommands = [\n   \"task render\",\n   \"task answers\",\n   \"task assets\",\n+  \"task project-human\",\n   \"project list\",\n   \"project show\",\n   \"project deps\","},{"sha":"88f9c65a5df39de7d932aaf986b2a3d072f94db2","filename":"sdks/typescript/src/generated/models.ts","status":"modified","additions":98,"deletions":1,"changes":99,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Fgenerated%2Fmodels.ts","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Fgenerated%2Fmodels.ts","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Ftypescript%2Fsrc%2Fgenerated%2Fmodels.ts?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,6 +1,6 @@\n /* Generated by scripts/generate.ts. Do not edit. */\n // Literal version keeps generated consumers pinned to this exact contract.\n-export const SCHEMA_BUNDLE_VERSION = 49 as const;\n+export const SCHEMA_BUNDLE_VERSION = 50 as const;\n export namespace GeneratedAsset {\n /**\n  * One asset a record holds, as a read reports it.\n@@ -4199,6 +4199,103 @@ repositories?: Repository[]\n \n }\n export type HeldTask = GeneratedHeldTask.HeldTask;\n+export namespace GeneratedHumanTaskProjected {\n+/**\n+ * A durable projection's bound tracker identity, suitable for a directly clickable card.\n+ */\n+export interface HumanTaskProjected {\n+/**\n+ * The resolved destination project.\n+ */\n+project: string\n+/**\n+ * The resolved configured source.\n+ */\n+source: string\n+/**\n+ * The qualified task identity.\n+ */\n+task: string\n+/**\n+ * The canonical tracker issue URL.\n+ */\n+url: string\n+}\n+\n+}\n+export type HumanTaskProjected = GeneratedHumanTaskProjected.HumanTaskProjected;\n+export namespace GeneratedHumanTaskProjection {\n+/**\n+ * A repository identified by its normalized origin, without a URL scheme or `.git` suffix.\n+ */\n+export type Repository = string\n+\n+/**\n+ * Version 1 of the general human task projection request.\n+ */\n+export interface HumanTaskProjection {\n+/**\n+ * The visible task content.\n+ */\n+body: string\n+/**\n+ * The external idempotency identity, stable across producer retries.\n+ */\n+item_id: string\n+owner: ProjectionOwner\n+/**\n+ * Its priority, using the existing plugin API serialization.\n+ */\n+priority: (\"none\" | \"urgent\" | \"high\" | \"medium\" | \"low\")\n+/**\n+ * The plan's resolved destination project, or null for a configured human project.\n+ */\n+project: (string | null)\n+/**\n+ * An optional dismissal reason. Omission and null both preserve absence.\n+ */\n+reason?: (string | null)\n+/**\n+ * Normalized repository origins whose work this item concerns.\n+ */\n+repositories: Repository[]\n+/**\n+ * The wire contract version, always 1.\n+ */\n+schema_version: 1\n+/**\n+ * The configured source through which placement is resolved.\n+ */\n+source: string\n+/**\n+ * The desired lifecycle.\n+ */\n+state: (\"open\" | \"completed\" | \"dismissed\")\n+/**\n+ * The visible task title.\n+ */\n+title: string\n+}\n+/**\n+ * The producer that owns the intent.\n+ */\n+export interface ProjectionOwner {\n+/**\n+ * The owning plan, when applicable.\n+ */\n+plan: (string | null)\n+/**\n+ * The owning run, when applicable.\n+ */\n+run: (string | null)\n+/**\n+ * The owning session.\n+ */\n+session: string\n+}\n+\n+}\n+export type HumanTaskProjection = GeneratedHumanTaskProjection.HumanTaskProjection;\n export namespace GeneratedIssueCompleted {\n /**\n  * What keeping one delivered task in step with one deliverer came to."},{"sha":"ebd3c602583d2dd7c9fdde954660e7d0792f2c85","filename":"sdks/typescript/src/generated/schemas.ts","status":"modified","additions":208,"deletions":0,"changes":208,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Fgenerated%2Fschemas.ts","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Fgenerated%2Fschemas.ts","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Ftypescript%2Fsrc%2Fgenerated%2Fschemas.ts?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -6846,6 +6846,214 @@ export const runtimeSchemas = {\n     \"title\": \"HeldTask\",\n     \"type\": \"object\"\n   },\n+  \"HumanTaskProjected\": {\n+    \"$defs\": {\n+      \"SourceName\": {\n+        \"description\": \"The name a configuration document gives one configured source.\",\n+        \"pattern\": \"^[a-z0-9][a-z0-9-]*$\",\n+        \"type\": \"string\"\n+      }\n+    },\n+    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+    \"additionalProperties\": false,\n+    \"description\": \"A durable projection's bound tracker identity, suitable for a directly clickable card.\",\n+    \"properties\": {\n+      \"project\": {\n+        \"description\": \"The resolved destination project.\",\n+        \"type\": \"string\"\n+      },\n+      \"source\": {\n+        \"$ref\": \"#/$defs/SourceName\",\n+        \"description\": \"The resolved configured source.\"\n+      },\n+      \"task\": {\n+        \"description\": \"The qualified task identity.\",\n+        \"type\": \"string\"\n+      },\n+      \"url\": {\n+        \"description\": \"The canonical tracker issue URL.\",\n+        \"type\": \"string\"\n+      }\n+    },\n+    \"required\": [\n+      \"task\",\n+      \"url\",\n+      \"project\",\n+      \"source\"\n+    ],\n+    \"title\": \"HumanTaskProjected\",\n+    \"type\": \"object\"\n+  },\n+  \"HumanTaskProjection\": {\n+    \"$defs\": {\n+      \"Priority\": {\n+        \"description\": \"How much a task matters, in the one vocabulary every source is normalised into.\\n\\nFive values, most pressing first after [`None`](Self::None): Linear's own priority has\\nexactly these, and a source whose backend has none of its own maps its representation\\nonto them. `none` is a value rather than an absent field, because \\\"no priority is set\\\" is\\nsomething a person sets — writing `none` clears a priority — and a reader tells it apart\\nfrom nothing by the value alone.\",\n+        \"oneOf\": [\n+          {\n+            \"const\": \"none\",\n+            \"description\": \"No priority is set.\",\n+            \"type\": \"string\"\n+          },\n+          {\n+            \"const\": \"urgent\",\n+            \"description\": \"Drop everything for it.\",\n+            \"type\": \"string\"\n+          },\n+          {\n+            \"const\": \"high\",\n+            \"description\": \"Next, before the rest.\",\n+            \"type\": \"string\"\n+          },\n+          {\n+            \"const\": \"medium\",\n+            \"description\": \"In its turn.\",\n+            \"type\": \"string\"\n+          },\n+          {\n+            \"const\": \"low\",\n+            \"description\": \"When there is nothing more pressing.\",\n+            \"type\": \"string\"\n+          }\n+        ]\n+      },\n+      \"ProjectionOwner\": {\n+        \"additionalProperties\": false,\n+        \"description\": \"The producer that owns the intent; nullable run and plan are explicit on the wire.\",\n+        \"properties\": {\n+          \"plan\": {\n+            \"description\": \"The owning plan, when applicable.\",\n+            \"type\": [\n+              \"string\",\n+              \"null\"\n+            ]\n+          },\n+          \"run\": {\n+            \"description\": \"The owning run, when applicable.\",\n+            \"type\": [\n+              \"string\",\n+              \"null\"\n+            ]\n+          },\n+          \"session\": {\n+            \"description\": \"The owning session.\",\n+            \"type\": \"string\"\n+          }\n+        },\n+        \"required\": [\n+          \"session\",\n+          \"run\",\n+          \"plan\"\n+        ],\n+        \"type\": \"object\"\n+      },\n+      \"ProjectionState\": {\n+        \"description\": \"The requested tracker lifecycle. Questions have no representation here.\",\n+        \"oneOf\": [\n+          {\n+            \"const\": \"open\",\n+            \"description\": \"The operator has work to do.\",\n+            \"type\": \"string\"\n+          },\n+          {\n+            \"const\": \"completed\",\n+            \"description\": \"The operator completed the work.\",\n+            \"type\": \"string\"\n+          },\n+          {\n+            \"const\": \"dismissed\",\n+            \"description\": \"The operator dismissed the work, optionally recording a reason.\",\n+            \"type\": \"string\"\n+          }\n+        ]\n+      },\n+      \"ProjectionVersion\": {\n+        \"const\": 1,\n+        \"type\": \"integer\"\n+      },\n+      \"Repository\": {\n+        \"description\": \"A repository identified by its normalized origin, without a URL scheme or `.git` suffix.\",\n+        \"type\": \"string\"\n+      },\n+      \"SourceName\": {\n+        \"description\": \"The name a configuration document gives one configured source.\",\n+        \"pattern\": \"^[a-z0-9][a-z0-9-]*$\",\n+        \"type\": \"string\"\n+      }\n+    },\n+    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n+    \"additionalProperties\": false,\n+    \"description\": \"Version 1 of the general human task projection request.\",\n+    \"properties\": {\n+      \"body\": {\n+        \"description\": \"The visible task content.\",\n+        \"type\": \"string\"\n+      },\n+      \"item_id\": {\n+        \"description\": \"The external idempotency identity, stable across producer retries.\",\n+        \"type\": \"string\"\n+      },\n+      \"owner\": {\n+        \"$ref\": \"#/$defs/ProjectionOwner\",\n+        \"description\": \"The producer that owns the intent.\"\n+      },\n+      \"priority\": {\n+        \"$ref\": \"#/$defs/Priority\",\n+        \"description\": \"Its priority, using the existing plugin API serialization.\"\n+      },\n+      \"project\": {\n+        \"description\": \"The plan's resolved destination project, or null for a configured human project.\",\n+        \"type\": [\n+          \"string\",\n+          \"null\"\n+        ]\n+      },\n+      \"reason\": {\n+        \"default\": null,\n+        \"description\": \"An optional dismissal reason. Omission and null both preserve absence.\",\n+        \"type\": [\n+          \"string\",\n+          \"null\"\n+        ]\n+      },\n+      \"repositories\": {\n+        \"description\": \"Normalized repository origins whose work this item concerns.\",\n+        \"items\": {\n+          \"$ref\": \"#/$defs/Repository\"\n+        },\n+        \"type\": \"array\"\n+      },\n+      \"schema_version\": {\n+        \"$ref\": \"#/$defs/ProjectionVersion\",\n+        \"description\": \"The wire contract version, always 1.\"\n+      },\n+      \"source\": {\n+        \"$ref\": \"#/$defs/SourceName\",\n+        \"description\": \"The configured source through which placement is resolved.\"\n+      },\n+      \"state\": {\n+        \"$ref\": \"#/$defs/ProjectionState\",\n+        \"description\": \"The desired lifecycle.\"\n+      },\n+      \"title\": {\n+        \"description\": \"The visible task title.\",\n+        \"type\": \"string\"\n+      }\n+    },\n+    \"required\": [\n+      \"schema_version\",\n+      \"item_id\",\n+      \"owner\",\n+      \"title\",\n+      \"body\",\n+      \"priority\",\n+      \"repositories\",\n+      \"project\",\n+      \"source\",\n+      \"state\"\n+    ],\n+    \"title\": \"HumanTaskProjection\",\n+    \"type\": \"object\"\n+  },\n   \"IssueCompleted\": {\n     \"$defs\": {\n       \"CompleteAction\": {"},{"sha":"ad3f43e13fb0705c7d523c3a9537bd3699c49f47","filename":"sdks/typescript/src/index.ts","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Findex.ts","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Fsrc%2Findex.ts","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Ftypescript%2Fsrc%2Findex.ts?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -7,6 +7,6 @@\n  */\n \n /** The version this package publishes. `package.json` must agree; see the tests. */\n-export const VERSION = \"0.12.12\";\n+export const VERSION = \"0.12.13\";\n export * from \"./client.ts\";\n export type * from \"./generated/models.ts\";"},{"sha":"ea82e9b0f531f0f37ec2f9bef3efc717f75c1538","filename":"sdks/typescript/tests/client.test.ts","status":"modified","additions":189,"deletions":0,"changes":189,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Ftests%2Fclient.test.ts","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/sdks%2Ftypescript%2Ftests%2Fclient.test.ts","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/sdks%2Ftypescript%2Ftests%2Fclient.test.ts?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1217,6 +1217,195 @@ test(\"a reconcile and a completion drive the real binary over a source whose sta\n   }\n });\n \n+// A loopback Linear answering the two documents a cold projection sends: the team's resolution\n+// and `issueCreate`, answered with the issue it stored. Every request is recorded.\n+function linearProjectionDouble(received: { query: string }[]) {\n+  return Bun.serve({\n+    port: 0,\n+    hostname: \"127.0.0.1\",\n+    async fetch(request) {\n+      const parsed: unknown = await request.json();\n+      if (\n+        typeof parsed !== \"object\" ||\n+        parsed === null ||\n+        !(\"query\" in parsed) ||\n+        typeof parsed.query !== \"string\"\n+      ) {\n+        return new Response(\"a GraphQL request names its query\", { status: 400 });\n+      }\n+      const variables = \"variables\" in parsed ? parsed.variables : undefined;\n+      const input =\n+        typeof variables === \"object\" &&\n+        variables !== null &&\n+        \"input\" in variables &&\n+        typeof variables.input === \"object\" &&\n+        variables.input !== null\n+          ? Object.fromEntries(Object.entries(variables.input))\n+          : undefined;\n+      const body = { query: parsed.query };\n+      received.push(body);\n+      if (body.query.includes(\"teams(\")) {\n+        return Response.json({\n+          data: {\n+            organization: { id: \"ORG-1\" },\n+            teams: {\n+              nodes: [\n+                {\n+                  id: \"TEAM-1\",\n+                  states: {\n+                    nodes: [\n+                      { id: \"STATE-todo\", name: \"Todo\", type: \"unstarted\" },\n+                      { id: \"STATE-done\", name: \"Done\", type: \"completed\" },\n+                      { id: \"STATE-canceled\", name: \"Canceled\", type: \"canceled\" },\n+                    ],\n+                    pageInfo: { hasNextPage: false },\n+                  },\n+                },\n+              ],\n+            },\n+            projectStatuses: { nodes: [], pageInfo: { hasNextPage: false } },\n+          },\n+        });\n+      }\n+      if (body.query.includes(\"issueCreate(\")) {\n+        if (input === undefined) {\n+          return new Response(\"issueCreate names its input\", { status: 400 });\n+        }\n+        const stored = input;\n+        return Response.json({\n+          data: {\n+            issueCreate: {\n+              success: true,\n+              issue: {\n+                id: \"ISSUE-1\",\n+                identifier: \"FIX-1\",\n+                title: stored.title,\n+                description: stored.description,\n+                url: \"https://linear.app/fixture/issue/FIX-1\",\n+                createdAt: null,\n+                updatedAt: \"2026-09-01T00:00:00Z\",\n+                archivedAt: null,\n+                state: { name: \"Todo\", type: \"unstarted\" },\n+                priority: stored.priority,\n+                labels: { nodes: [] },\n+                project: { id: stored.projectId },\n+              },\n+            },\n+          },\n+        });\n+      }\n+      return new Response(\"unexpected document\", { status: 400 });\n+    },\n+  });\n+}\n+\n+test(\"a human task is projected through the real binary into a loopback Linear\", async () => {\n+  const root = mkdtempSync(resolve(tmpdir(), \"onetaskgraph-sdk-projection-\"));\n+  const received: { query: string }[] = [];\n+  const server = linearProjectionDouble(received);\n+  try {\n+    writeFileSync(\n+      resolve(root, \"onetaskgraph.yaml\"),\n+      JSON.stringify({\n+        sources: {\n+          org: {\n+            plugin: \"linear\",\n+            config: {\n+              endpoint: `http://127.0.0.1:${server.port}/graphql`,\n+              team: \"FIX\",\n+              status_mapping: { todo: \"Todo\", done: \"Done\", cancelled: \"Canceled\" },\n+            },\n+            cache: { dir: resolve(root, \"cache\") },\n+            task_projection: {\n+              host: \"sdk-host\",\n+              directory: resolve(root, \"intents\"),\n+              project: \"P-1\",\n+            },\n+          },\n+        },\n+      }),\n+    );\n+    const input = resolve(root, \"request.json\");\n+    writeFileSync(\n+      input,\n+      JSON.stringify({\n+        schema_version: 1,\n+        item_id: \"sdk-item\",\n+        owner: { session: \"session-1\", run: null, plan: null },\n+        title: \"Decide on the release\",\n+        body: \"Choose a date.\",\n+        priority: \"high\",\n+        repositories: [],\n+        project: null,\n+        source: \"org\",\n+        state: \"open\",\n+        reason: null,\n+      }),\n+    );\n+    const client = new OnetaskgraphClient({\n+      binaryPath: binary,\n+      cwd: root,\n+      env: { LINEAR_API_KEY: \"fixture-key\", ONETASKGRAPH_HOST: \"sdk-host\" },\n+    });\n+    const projected = await client.taskProjectHuman(input);\n+    expect(projected).toEqual({\n+      task: \"org:ISSUE-1\",\n+      url: \"https://linear.app/fixture/issue/FIX-1\",\n+      project: \"P-1\",\n+      source: \"org\",\n+    });\n+    expect(received.filter((call) => call.query.includes(\"issueCreate(\")).length).toBe(1);\n+    // Bound: the same request again is the same answer, and the tracker is asked nothing.\n+    const before = received.length;\n+    expect(await client.taskProjectHuman(input)).toEqual(projected);\n+    expect(received.length).toBe(before);\n+  } finally {\n+    server.stop(true);\n+    rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+test(\"a human task projection's request reaches the real binary, which refuses what it cannot project\", async () => {\n+  const root = deliveringFolder();\n+  try {\n+    const client = new OnetaskgraphClient({\n+      binaryPath: binary,\n+      cwd: root,\n+      env: { ONETASKGRAPH_HOST: \"sdk-host\" },\n+    });\n+    const request = {\n+      schema_version: 1,\n+      item_id: \"item-1\",\n+      owner: { session: \"session-1\", run: null, plan: null },\n+      title: \"Decide on the release\",\n+      body: \"Choose a date.\",\n+      priority: \"high\",\n+      repositories: [],\n+      project: null,\n+      source: \"work\",\n+      state: \"open\",\n+      reason: null,\n+    };\n+    const valid = resolve(root, \"request.json\");\n+    writeFileSync(valid, JSON.stringify(request));\n+    // The binary read the request whole and refused this host, which no source's\n+    // task_projection names, before starting any source.\n+    const unconfigured = client.taskProjectHuman(valid);\n+    await expect(unconfigured).rejects.toBeInstanceOf(OnetaskgraphExecutionError);\n+    await expect(unconfigured).rejects.toThrow(\n+      'host \"sdk-host\" is not the host any source\\'s task_projection names',\n+    );\n+    const question = resolve(root, \"question.json\");\n+    writeFileSync(question, JSON.stringify({ ...request, state: \"question\" }));\n+    const malformed = client.taskProjectHuman(question);\n+    await expect(malformed).rejects.toBeInstanceOf(OnetaskgraphExecutionError);\n+    await expect(malformed).rejects.toThrow(\"is not a v1 HumanTaskProjection request\");\n+    expect(() => client.taskProjectHuman(JSON.parse(\"7\"))).toThrow(\"taskProjectHuman\");\n+  } finally {\n+    rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n function priorityFolder(): string {\n   const priorityRoot = mkdtempSync(resolve(tmpdir(), \"onetaskgraph-sdk-priority-\"));\n   mkdirSync(resolve(priorityRoot, \"work/tasks\"), { recursive: true });"},{"sha":"63f59e2a8d532ba472b3e1abeee9b70083bd35dd","filename":"uv.lock","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/uv.lock","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/uv.lock","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/uv.lock?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -504,12 +504,12 @@ wheels = [\n \n [[package]]\n name = \"onetaskgraph-cli\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n source = { editable = \".\" }\n \n [[package]]\n name = \"onetaskgraph-sdk\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n source = { editable = \"sdks/python\" }\n dependencies = [\n     { name = \"onetaskgraph-cli\" },"}]}