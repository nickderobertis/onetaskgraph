thub.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e01115356673d76d2bfc65159d742c1186a85d4f","url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/e01115356673d76d2bfc65159d742c1186a85d4f","html_url":"https://github.com/nickderobertis/onetaskgraph/commit/e01115356673d76d2bfc65159d742c1186a85d4f"}]},"status":"ahead","ahead_by":4,"behind_by":0,"total_commits":4,"commits":[{"sha":"f01c39962783f51a32ef75e9f33d53c5c71c664a","node_id":"C_kwDOUBBgxtoAKGYwMWMzOTk2Mjc4M2Y1MWEzMmVmNzVlOWYzM2Q1M2M1YzcxYzY2NGE","commit":{"author":{"name":"Nick DeRobertis","email":"whoopnip@gmail.com","date":"2026-10-30T00:10:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-30T00:10:04Z"},"message":"feat: project human tasks through existing tracker routing (#3824)\n\n## What\n\nAdds `onetaskgraph task project-human --input FILE --json` and typed\nPython/TypeScript SDK support to create, retry, complete or dismiss\nhuman tasks in GitHub and Linear. Durable claims preserve ticket\nidentity across retries and return canonical issue URLs; dismissal\nreasons remain optional.\n\nPurpose-scoped routing uses existing projects, keeps private and\nmixed-repository work out of public destinations, and preserves legacy\nrouting. Adds recovery, privacy and approval lifecycle journeys, plus\nsaved-telemetry budgets for projection and complete approval costs.\n\n## Why\n\nA single visible queue lets the operator focus on the most urgent human\nwork while unrelated development continues during a decision.\n\n## Additional info\n\nProjection destinations require an authoritative host and an absolute\nintent directory; planless tasks also need a configured project.\nAmbiguous creates refuse for reconciliation instead of risking duplicate\ntickets, and conflicting terminal states refuse. GitHub placement\ncontext persists across processes and is reused only after validating\nits setup token. Terminal body changes use the current tracker body. See\n[the projection contract and configuration](docs/task-projection.md).\n\nThe registered limits are 7.3 modeled GraphQL points per task lifecycle\nand 13 per complete approval, including review task creation and\nresolution. Reporters read saved journey telemetry, with each measured\ncreate and terminal projection running in its own cold CLI process;\nthese are loopback cost budgets, not live quota observations.\n\n---------\n\nCo-authored-by: Nick DeRobertis <19440155+nickderobertis@users.noreply.github.com>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"6aa95b88ed6a769257f7b36e9b4c142ac3ca1cc9","url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/trees/6aa95b88ed6a769257f7b36e9b4c142ac3ca1cc9"},"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/commits/f01c39962783f51a32ef75e9f33d53c5c71c664a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq4+BcCRC1aQ7uu5UhlAAAoUsQAD/6VFxBIX5iC+xKVr6nSmQA\nTb7HUKw/bclzIpqui6zOJgzxnuv4LapSQBjTNdtsWSIgundFk3FNUIbEiyeQdy7f\nINXZTDnFCdTKQHSgJLpIHfooGHJv8YsEa+K6CvjdPzksxeaIVGcGYAO/yeWcrqHP\nZaHoJq9l+8jvg2CZPnfSyzVPstb9TiBbgBPXdgvTqv/GlwKJZtJeKTns9WZRfSzC\nZde1xEUKkt79y9hIwnYUmmUsy1J8ZNCweXyFkSXWto62TwXq27rZNYMizq1pUuGz\n/pJZW5kvThVxnB0fppJtTH4rIwKsiY75l3tBp95EktgtKhaZXfsWNrRIZ3Fbjw06\nrkNvcRcoNBvS6q+vlL+LZoTTooCYirOmsqkKjio/yJe6VTh6Gfv+9dxN0IIj0/D9\nNEDxY6qI8gzMnY2dGHO82IWp47pw4zZanZiAYcaODc5eZrTNXjcpVXpjq29VHspr\nPE3/dYpW2iCZl6XQGnXGQ2LjtPHR4cuHvArJNhQj+T3hi3X9hRQuMxt0//O5HfD8\nL880OjZSHp531DvnboWxBa8PTy1QCSxCh/wTydBnOBW7Rwzq1EoP9xR3mhKU+b9D\n5S2j3T3KuYTNrCWgUvMFO2bFCZu7lizUozX2Oa4/7JjN48J/3JgWJ4CNWPUWW7mx\nV+9A8GE/nbyOLPQZHFAL\n=YQkX\n-----END PGP SIGNATURE-----\n","payload":"tree 6aa95b88ed6a769257f7b36e9b4c142ac3ca1cc9\nparent 46ad0c49cb3243f950beb7459776b2a9d5603d53\nauthor Nick DeRobertis <whoopnip@gmail.com> 1793319004 -0600\ncommitter GitHub <noreply@github.com> 1793319004 -0600\n\nfeat: project human tasks through existing tracker routing (#3824)\n\n## What\n\nAdds `onetaskgraph task project-human --input FILE --json` and typed\nPython/TypeScript SDK support to create, retry, complete or dismiss\nhuman tasks in GitHub and Linear. Durable claims preserve ticket\nidentity across retries and return canonical issue URLs; dismissal\nreasons remain optional.\n\nPurpose-scoped routing uses existing projects, keeps private and\nmixed-repository work out of public destinations, and preserves legacy\nrouting. Adds recovery, privacy and approval lifecycle journeys, plus\nsaved-telemetry budgets for projection and complete approval costs.\n\n## Why\n\nA single visible queue lets the operator focus on the most urgent human\nwork while unrelated development continues during a decision.\n\n## Additional info\n\nProjection destinations require an authoritative host and an absolute\nintent directory; planless tasks also need a configured project.\nAmbiguous creates refuse for reconciliation instead of risking duplicate\ntickets, and conflicting terminal states refuse. GitHub placement\ncontext persists across processes and is reused only after validating\nits setup token. Terminal body changes use the current tracker body. See\n[the projection contract and configuration](docs/task-projection.md).\n\nThe registered limits are 7.3 modeled GraphQL points per task lifecycle\nand 13 per complete approval, including review task creation and\nresolution. Reporters read saved journey telemetry, with each measured\ncreate and terminal projection running in its own cold CLI process;\nthese are loopback cost budgets, not live quota observations.\n\n---------\n\nCo-authored-by: Nick DeRobertis <19440155+nickderobertis@users.noreply.github.com>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","verified_at":"2026-10-30T00:10:04Z"}},"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/f01c39962783f51a32ef75e9f33d53c5c71c664a","html_url":"https://github.com/nickderobertis/onetaskgraph/commit/f01c39962783f51a32ef75e9f33d53c5c71c664a","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/f01c39962783f51a32ef75e9f33d53c5c71c664a/comments","author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"46ad0c49cb3243f950beb7459776b2a9d5603d53","url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/46ad0c49cb3243f950beb7459776b2a9d5603d53","html_url":"https://github.com/nickderobertis/onetaskgraph/commit/46ad0c49cb3243f950beb7459776b2a9d5603d53"}]},{"sha":"3791687d504b5eb4866349d8cf7382e68fa8ede8","node_id":"C_kwDOUBBgxtoAKDM3OTE2ODdkNTA0YjVlYjQ4NjYzNDlkOGNmNzM4MmU2OGZhOGVkZTg","commit":{"author":{"name":"Nick DeRobertis","email":"whoopnip@gmail.com","date":"2026-10-30T03:39:25Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-30T03:39:25Z"},"message":"test(linear): bound live document creation with reusable fixtures and daily creation coverage (#3821)\n\n## What\n\nBoth Linear live lanes reuse four owned document slots in ordinary CI\nwhile retaining update, read, filtering, metadata/Markdown and\nasset-recopy coverage. Fresh creation and deletion coverage runs daily,\nwith transport-journal budgets of zero document creations per warm\nordinary pass and four per daily pass.\n\n## Why\n\nPrevent Linear’s retained-trash quota from blocking unrelated changes or\nforcing replacement of the nominated test team, while preserving\nmeaningful real-service coverage and deterministic protection against\nincreasing daily document creation.\n\n## Additional info\n\nOrdinary CI initializes only missing standing slots before running reuse\nassertions. Those creations are journalled separately as a cold rebuild,\noutside both pass totals. Manual dispatch remains available for\ninitialization and recovery. Ambiguous ownership, unverifiable team\nmembership and uncertain create acknowledgements fail closed. Standing\nCI documents and their parent projects survive cleanup and the janitor.\n\nOrdinary, initialization and daily CI writers share a concurrency group\nwith `cancel-in-progress: false` and `queue: max`; machine-local Session\nexclusivity remains. Local runs explicitly opt in with\n`ONETASKGRAPH_LINEAR_DOCUMENT_MODE=initialize`, exercise reuse\nassertions and retire their separately stamped set, including after\nfailed initialization. Default local ordinary runs refuse an absent or\nincomplete set before writing.\n\nThe approved trade-off moves fresh creation and deletion assertions to\ndaily coverage. See the [assertion\ninventory](docs/linear-document-assertion-inventory.md) and [lifecycle\nand privacy guidance](docs/linear-live-cleanup.md). Deleting documents\ndoes not restore quota. Budget reporting reads both lanes’ recorded HTTP\njournals without rerunning scenarios, counts subsequently deleted\ncreations, reports cold rebuilds and failed-pass residue separately, and\nrejects missing or incomplete telemetry. Replay fixtures use synthetic\ncontent rather than captured workspace listings or private bodies.\n\nLabelled live task writes retry the specific `cannot resolve label …:\nfound 0 matches` refusal within a bound, preserving that refusal if\nvisibility never settles. Offline HTTP journeys cover delayed\nvisibility, exhaustion and preservation of active labels through\nstanding-set preparation, residue clearing and a second queued pass.\nThis supports label-filter lag as an explanation but does not establish\nthe cause of the earlier live failure.\n\nThe asset journey addresses the stale-read failure seen in [the required\nUbuntu\ncheck](https://github.com/nickderobertis/onetaskgraph/actions/runs/40972765063/job/123793400052):\neach invocation supplies distinct source content and waits boundedly for\nthat content after copying. An HTTP replay reproduces a destination read\nholding the previous pass’s content after reset, preventing an incorrect\nunchanged-copy result from leaving the reset marker in place. No\nsuccessful credentialed Linear rerun is claimed.\n\nThe offline asset replay now reuses HTTP connections at both ends,\naddressing loopback connection pressure implicated in [the required\nWindows check’s request-send\nfailure](https://github.com/nickderobertis/onetaskgraph/actions/runs/40982402040/job/123825424738).\nThe credentialed live observer is unchanged; a successful Windows rerun\nis not claimed.\n\nAn incidental Python SDK test fix addresses double rounding in the\nimport-measurement assertion that failed [the earlier required Ubuntu\ncheck](https://github.com/nickderobertis/onetaskgraph/actions/runs/40950313486/job/123716544115).\nIt compares the quoted three-decimal median with the reported\nfour-decimal value using the rounding tolerance; the measurement script\nand the rest of the SDK are unchanged.\n\n---------\n\nCo-authored-by: Nick DeRobertis <19440155+nickderobertis@users.noreply.github.com>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"0eaa478f21875aa90464ab53119def45e6d7e218","url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/trees/0eaa478f21875aa90464ab53119def45e6d7e218"},"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/commits/3791687d504b5eb4866349d8cf7382e68fa8ede8","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq5BFtCRC1aQ7uu5UhlAAAqfUQAJGWBgFtgw1ny64bzYFTPE5k\n66rDZaKBKokrSreCKo6IJ+uetHtDwYj6ozJFWnWoLW3zXrVxZOZQg5Vs3McAVV46\nU9t01aTnAKwZRqTS3pxIrtDFc6PZ8ZyxpTeGBF0CBBCA16w9b1kncsrUYjYzozJ3\nAbQg3zG+H/KYOS6le4a1jkWdRbMEekCwwlDLAB9Q4kZuQ0I2OvGtt8S5SKLP4eQk\nApf/HVA/phG6na7yw6xw5fAkyEVLMpfSb1o4KKV8mDVPmYPsLshbtxmf/sCRcibz\nvXOgvSGXOR/Z7EElPRCs0J5nfcR9HbV+1dnayflwspBK0vjGvddV6Ywsj5vz1vMq\nv4n4jUOZUIr+5ztaEhrnUf+nOdXsEDhjjYu9MO8859VkVk8YhrKIXgpD8ysta50T\nzjesBW+38jFqlLhFoFXKyCFMkURENCLnidGWQqw0m5bb1TC0Gsp4u6VEJFCK6Rn1\nhh5cDr3r6PF6Qu916bVR4iLtqnAFXDADuj61Fy7D4vN3Im+G7gz++/ZjE0vce1SR\nICT1/qypDaeTnabaTw58JkUeZY/M5U309dz0f3/8KKQD9UHAx9Roxgf9k81vkpfK\n6GEqmI7t2AshddQ9lR/BQcA5TaiF+SQGWdKSbNqFqXU6HWv6AT9nPuu6sKK4xwH0\nNXuHrOz3vP6V5e6jT1eO\n=1bXw\n-----END PGP SIGNATURE-----\n","payload":"tree 0eaa478f21875aa90464ab53119def45e6d7e218\nparent f01c39962783f51a32ef75e9f33d53c5c71c664a\nauthor Nick DeRobertis <whoopnip@gmail.com> 1793331565 -0600\ncommitter GitHub <noreply@github.com> 1793331565 -0600\n\ntest(linear): bound live document creation with reusable fixtures and daily creation coverage (#3821)\n\n## What\n\nBoth Linear live lanes reuse four owned document slots in ordinary CI\nwhile retaining update, read, filtering, metadata/Markdown and\nasset-recopy coverage. Fresh creation and deletion coverage runs daily,\nwith transport-journal budgets of zero document creations per warm\nordinary pass and four per daily pass.\n\n## Why\n\nPrevent Linear’s retained-trash quota from blocking unrelated changes or\nforcing replacement of the nominated test team, while preserving\nmeaningful real-service coverage and deterministic protection against\nincreasing daily document creation.\n\n## Additional info\n\nOrdinary CI initializes only missing standing slots before running reuse\nassertions. Those creations are journalled separately as a cold rebuild,\noutside both pass totals. Manual dispatch remains available for\ninitialization and recovery. Ambiguous ownership, unverifiable team\nmembership and uncertain create acknowledgements fail closed. Standing\nCI documents and their parent projects survive cleanup and the janitor.\n\nOrdinary, initialization and daily CI writers share a concurrency group\nwith `cancel-in-progress: false` and `queue: max`; machine-local Session\nexclusivity remains. Local runs explicitly opt in with\n`ONETASKGRAPH_LINEAR_DOCUMENT_MODE=initialize`, exercise reuse\nassertions and retire their separately stamped set, including after\nfailed initialization. Default local ordinary runs refuse an absent or\nincomplete set before writing.\n\nThe approved trade-off moves fresh creation and deletion assertions to\ndaily coverage. See the [assertion\ninventory](docs/linear-document-assertion-inventory.md) and [lifecycle\nand privacy guidance](docs/linear-live-cleanup.md). Deleting documents\ndoes not restore quota. Budget reporting reads both lanes’ recorded HTTP\njournals without rerunning scenarios, counts subsequently deleted\ncreations, reports cold rebuilds and failed-pass residue separately, and\nrejects missing or incomplete telemetry. Replay fixtures use synthetic\ncontent rather than captured workspace listings or private bodies.\n\nLabelled live task writes retry the specific `cannot resolve label …:\nfound 0 matches` refusal within a bound, preserving that refusal if\nvisibility never settles. Offline HTTP journeys cover delayed\nvisibility, exhaustion and preservation of active labels through\nstanding-set preparation, residue clearing and a second queued pass.\nThis supports label-filter lag as an explanation but does not establish\nthe cause of the earlier live failure.\n\nThe asset journey addresses the stale-read failure seen in [the required\nUbuntu\ncheck](https://github.com/nickderobertis/onetaskgraph/actions/runs/40972765063/job/123793400052):\neach invocation supplies distinct source content and waits boundedly for\nthat content after copying. An HTTP replay reproduces a destination read\nholding the previous pass’s content after reset, preventing an incorrect\nunchanged-copy result from leaving the reset marker in place. No\nsuccessful credentialed Linear rerun is claimed.\n\nThe offline asset replay now reuses HTTP connections at both ends,\naddressing loopback connection pressure implicated in [the required\nWindows check’s request-send\nfailure](https://github.com/nickderobertis/onetaskgraph/actions/runs/40982402040/job/123825424738).\nThe credentialed live observer is unchanged; a successful Windows rerun\nis not claimed.\n\nAn incidental Python SDK test fix addresses double rounding in the\nimport-measurement assertion that failed [the earlier required Ubuntu\ncheck](https://github.com/nickderobertis/onetaskgraph/actions/runs/40950313486/job/123716544115).\nIt compares the quoted three-decimal median with the reported\nfour-decimal value using the rounding tolerance; the measurement script\nand the rest of the SDK are unchanged.\n\n---------\n\nCo-authored-by: Nick DeRobertis <19440155+nickderobertis@users.noreply.github.com>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","verified_at":"2026-10-30T03:39:25Z"}},"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/3791687d504b5eb4866349d8cf7382e68fa8ede8","html_url":"https://github.com/nickderobertis/onetaskgraph/commit/3791687d504b5eb4866349d8cf7382e68fa8ede8","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/3791687d504b5eb4866349d8cf7382e68fa8ede8/comments","author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f01c39962783f51a32ef75e9f33d53c5c71c664a","url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/f01c39962783f51a32ef75e9f33d53c5c71c664a","html_url":"https://github.com/nickderobertis/onetaskgraph/commit/f01c39962783f51a32ef75e9f33d53c5c71c664a"}]},{"sha":"e2d3bf08e0ced82120f38a708dc2b7a92d26ce7f","node_id":"C_kwDOUBBgxtoAKGUyZDNiZjA4ZTBjZWQ4MjEyMGYzOGE3MDhkYzJiN2E5MmQyNmNlN2Y","commit":{"author":{"name":"Nick DeRobertis","email":"whoopnip@gmail.com","date":"2026-10-30T05:47:45Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-30T05:47:45Z"},"message":"ci: warm the pull-request Rust cache on every push to main (#3825)\n\n## What\n\nWarm the shared Linux and Windows Rust caches on pushes to main for\n#3642’s pull-request test jobs, without running tests. Guard cache-key,\ntoolchain and build-input parity, check Linux dependency reuse, and make\nthe warmer’s test harness compatible with native Windows executables.\n\n## Why\n\nThe owner needs real warm-cache pull-request timings to decide the CI\nbudget. Landing the warmer separately makes those measurements possible\nbefore the rest of the CI speed-up lands.\n\n## Additional info\n\nThe consumer jobs are captured from\n[#3642](https://github.com/nickderobertis/onetaskgraph/pull/3642) at\n`ef1322ea6c3a` until they land in `ci.yml`; the parity check rejects\nduplicate definitions, so the corresponding fixtures must be removed\nwhen the jobs land. Existing CI jobs and budget files are unchanged.\nmacOS warming remains with #3642.\n\n---------\n\nCo-authored-by: Nick DeRobertis <19440155+nickderobertis@users.noreply.github.com>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"fd8dc23703a6dde117b2223a0f5495ba17db562a","url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/trees/fd8dc23703a6dde117b2223a0f5495ba17db562a"},"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/commits/e2d3bf08e0ced82120f38a708dc2b7a92d26ce7f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq5C+CCRC1aQ7uu5UhlAAAsFoQAKhbL+dJSyOYwteCVDyOb3nQ\nxjP6t2bfv9FuRwA38T0Juf7sGSJc7KLbLn1vmse4oGObzRBOgbrFZzvyqN6zUwFC\n0ovl3rQCiXn7uTuxp61W5eeNhjcoLB+1flcHBXAuMSn6rdi3nW4m3623SrqhYwpi\nPp0kQddkBEL3n39h5/57Hjcragw/3SYPdghN5oUypD4tCUBHy6EkpoMafrw19Rr5\no9Yhd2LUQrO1HY8Oi/+7vKDZYPJTnd+kJyHAT4yLWSbzBNNYtvSLWPIMnP1PNhhD\n6z5oRvUjbgDgbVgLlTjlA2T2e+7a9p+Xm/IO9Hq/YVgm3XB1lZTvCmt29iYXbGV7\noq6wlD8uGhc/AHbugtw6TT5OkH7sYWljRXIUjTWX/D4gsVvqlTSrnj28UcWgLokC\nZk5SBcMBPbUU6ziAPSIZTXHi8CkjXiwJMH1/8tZYgUVp1iU124QyLulBJGZuwboa\nR8uRQON2V6JKR30St1vPWQ+KTod1H4NPrlSqII48VENoV5jBK787zRK2OmqjRPbi\nyfuPx/yR/zWroWLFRH/fg/aNtH5+U8Jh0TkaggxjtEzpGjcoPpOvlHyORqmTvtCD\nTxHWOhcwmB+F8XCePfXG3nTjDjpGgZpZW1U/8u8lLTSXVtdbFqTH/5WbTQ7xaNvU\nNBie6YoVIZirXi7E5k6q\n=zRYs\n-----END PGP SIGNATURE-----\n","payload":"tree fd8dc23703a6dde117b2223a0f5495ba17db562a\nparent 3791687d504b5eb4866349d8cf7382e68fa8ede8\nauthor Nick DeRobertis <whoopnip@gmail.com> 1793339265 -0600\ncommitter GitHub <noreply@github.com> 1793339265 -0600\n\nci: warm the pull-request Rust cache on every push to main (#3825)\n\n## What\n\nWarm the shared Linux and Windows Rust caches on pushes to main for\n#3642’s pull-request test jobs, without running tests. Guard cache-key,\ntoolchain and build-input parity, check Linux dependency reuse, and make\nthe warmer’s test harness compatible with native Windows executables.\n\n## Why\n\nThe owner needs real warm-cache pull-request timings to decide the CI\nbudget. Landing the warmer separately makes those measurements possible\nbefore the rest of the CI speed-up lands.\n\n## Additional info\n\nThe consumer jobs are captured from\n[#3642](https://github.com/nickderobertis/onetaskgraph/pull/3642) at\n`ef1322ea6c3a` until they land in `ci.yml`; the parity check rejects\nduplicate definitions, so the corresponding fixtures must be removed\nwhen the jobs land. Existing CI jobs and budget files are unchanged.\nmacOS warming remains with #3642.\n\n---------\n\nCo-authored-by: Nick DeRobertis <19440155+nickderobertis@users.noreply.github.com>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","verified_at":"2026-10-30T05:47:46Z"}},"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/e2d3bf08e0ced82120f38a708dc2b7a92d26ce7f","html_url":"https://github.com/nickderobertis/onetaskgraph/commit/e2d3bf08e0ced82120f38a708dc2b7a92d26ce7f","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/e2d3bf08e0ced82120f38a708dc2b7a92d26ce7f/comments","author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3791687d504b5eb4866349d8cf7382e68fa8ede8","url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/3791687d504b5eb4866349d8cf7382e68fa8ede8","html_url":"https://github.com/nickderobertis/onetaskgraph/commit/3791687d504b5eb4866349d8cf7382e68fa8ede8"}]},{"sha":"3b6b228f168ab17c94613a831e1eec96a225d949","node_id":"C_kwDOUBBgxtoAKDNiNmIyMjhmMTY4YWIxN2M5NDYxM2E4MzFlMWVlYzk2YTIyNWQ5NDk","commit":{"author":{"name":"Nick DeRobertis","email":"whoopnip@gmail.com","date":"2026-10-30T08:28:10Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-30T08:28:10Z"},"message":"chore: release v0.12.13 (#3826)\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.12.12 -> 0.12.13\n* `onetaskgraph-github-projects`: 0.12.12 -> 0.12.13\n* `onetaskgraph-linear`: 0.12.12 -> 0.12.13\n* `onetaskgraph-core`: 0.12.12 -> 0.12.13\n* `onetaskgraph`: 0.12.12 -> 0.12.13\n\n<detai