kgraph/git/trees/f85e26bba5012ffd209b3b5dd9b1907a7123ad7d"},"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/commits/3b6b228f168ab17c94613a831e1eec96a225d949","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq5FUaCRC1aQ7uu5UhlAAAOwwQAG2wLXZodS2/+fWZhLy4wX6O\nMAl8ZgaEjslI7e5UJ2A5hJD9S4K77qAooD53yqoGutuKJTPH6/K/Uvx24Rd35o9T\n0OkqHsIqIkcTnl2jsBJGqy65UGk2EatpYdZ+HRzlho6o4WRWPOJLvYdUoVsDNdNf\nUFamqIjs5tc/CePqb9WhlEZ+pclQHyO94dZ3xB0+g1n6vnVgCrhNdKx4I1+PlWYa\nFzAoERtzYpRKhPw5wqj21psgRxdny7UqWlmI8YBkZoojtGC9dR31E4t+LhOlQInL\nhoXJR3uTvjEEN3qtqUpRr5VptHEPrDNc8pCNV2O4ngvPwYRXbbp2E8kCK98dpyt3\nhIrFbZe4mvOobSZrbvH3+POY3hW81ugi1K2kqk0eJbF/IAUbvbckHv8LqZtrgfNn\n/78GV/n0Oqr/nfWPvzoumw/7cQffv+WS0vF4q7mSCFtUxGBsGp2uS/ZL8c4ExeVA\nooz+r2vkh3gcRrp8YMsh4MYxTcZsiS1+g/s4LxJSJeliPDujW9o5azFr12eCFEF9\n876O154f4B+YIfQGNI7Ll5J4u0dBaX2xROb9HlWKYELU/lSJB8HQWNvO8unKEfee\nZyqr717NM6Ax7NkSdC6qTNI9X7LnIbwuz4MZ7Rb1GuymtYEpUWJ1HqyfGP8YQc2N\ncDBif5S/g1GzmPILPWKa\n=lbMN\n-----END PGP SIGNATURE-----\n","payload":"tree f85e26bba5012ffd209b3b5dd9b1907a7123ad7d\nparent e2d3bf08e0ced82120f38a708dc2b7a92d26ce7f\nauthor Nick DeRobertis <whoopnip@gmail.com> 1793348890 -0600\ncommitter GitHub <noreply@github.com> 1793348890 +0000\n\nchore: release v0.12.13 (#3826)\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.12.12 -> 0.12.13\n* `onetaskgraph-github-projects`: 0.12.12 -> 0.12.13\n* `onetaskgraph-linear`: 0.12.12 -> 0.12.13\n* `onetaskgraph-core`: 0.12.12 -> 0.12.13\n* `onetaskgraph`: 0.12.12 -> 0.12.13\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n##\n[0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.12.12...onetaskgraph-plugin-api-v0.12.13)\n- 2026-10-30\n\n### Added\n\n- project human tasks through existing tracker routing\n([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n</blockquote>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n##\n[0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.12.12...onetaskgraph-github-projects-v0.12.13)\n- 2026-10-30\n\n### Added\n\n- project human tasks through existing tracker routing\n([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n</blockquote>\n\n## `onetaskgraph-linear`\n\n<blockquote>\n\n##\n[0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-linear-v0.12.12...onetaskgraph-linear-v0.12.13)\n- 2026-10-30\n\n### Added\n\n- project human tasks through existing tracker routing\n([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n##\n[0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.12.12...onetaskgraph-core-v0.12.13)\n- 2026-10-30\n\n### Added\n\n- project human tasks through existing tracker routing\n([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n</blockquote>\n\n## `onetaskgraph`\n\n<blockquote>\n\n##\n[0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/v0.12.12...v0.12.13)\n- 2026-10-30\n\n### Added\n\n- project human tasks through existing tracker routing\n([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with\n[release-plz](https://github.com/release-plz/release-plz/).","verified_at":"2026-10-30T08:28:11Z"}},"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/3b6b228f168ab17c94613a831e1eec96a225d949","html_url":"https://github.com/nickderobertis/onetaskgraph/commit/3b6b228f168ab17c94613a831e1eec96a225d949","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/3b6b228f168ab17c94613a831e1eec96a225d949/comments","author":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e2d3bf08e0ced82120f38a708dc2b7a92d26ce7f","url":"https://api.github.com/repos/nickderobertis/onetaskgraph/commits/e2d3bf08e0ced82120f38a708dc2b7a92d26ce7f","html_url":"https://github.com/nickderobertis/onetaskgraph/commit/e2d3bf08e0ced82120f38a708dc2b7a92d26ce7f"}]}],"files":[{"sha":"98a987d5e0239e1a653e7cb794a6c58f4cd78479","filename":".github/linear-documents-policy/policy.test.mjs","status":"added","additions":100,"deletions":0,"changes":100,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Flinear-documents-policy%2Fpolicy.test.mjs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Flinear-documents-policy%2Fpolicy.test.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Flinear-documents-policy%2Fpolicy.test.mjs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,100 @@\n+import assert from \"node:assert/strict\";\n+import { execFileSync } from \"node:child_process\";\n+import { fileURLToPath } from \"node:url\";\n+import { createRequire } from \"node:module\";\n+import { dirname, resolve } from \"node:path\";\n+import { test } from \"node:test\";\n+import { read, workflows } from \"../workflow-graph.mjs\";\n+\n+// The service owns the queue. Reconcile its actual declarations instead of simulating\n+// a second scheduler whose behavior could disagree with Actions.\n+test(\"ordinary, daily and explicit initialization retain three pending CI writers\", () => {\n+  const definitions = workflows();\n+  const ci = definitions[\"ci.yml\"];\n+  const creation = definitions[\"linear-documents.yml\"];\n+  assert.equal(ci.concurrency, undefined, \"outer cancellation must not cancel pending checks\");\n+  const ordinary = ci.jobs.check.concurrency;\n+  assert.match(ordinary.group, /'linear-live-documents'/);\n+  const daily = creation.jobs.documents.concurrency;\n+  assert.equal(daily.group, \"linear-live-documents\");\n+  // Three simultaneous pending writers must all reach the service's 100-waiter queue;\n+  // the default single pending setting would silently replace two required checks.\n+  for (const declaration of [ordinary, daily, daily]) {\n+    assert.equal(declaration[\"cancel-in-progress\"], false);\n+    assert.equal(declaration.queue, \"max\");\n+  }\n+});\n+\n+test(\"only the daily schedule creates fresh documents and manual dispatch initializes\", () => {\n+  const definitions = workflows();\n+  const workflow = definitions[\"linear-documents.yml\"];\n+  assert.deepEqual(Object.keys(workflow.on), [\"schedule\", \"workflow_dispatch\"]);\n+  assert.deepEqual(workflow.on.schedule, [{ cron: \"43 6 * * *\" }]);\n+  assert.equal(workflow.on.workflow_dispatch, null);\n+  const job = workflow.jobs.documents;\n+  assert.equal(\n+    job.env.ONETASKGRAPH_LINEAR_DOCUMENT_MODE,\n+    \"$\" + \"{{ github.event_name == 'schedule' && 'fresh' || 'initialize' }}\",\n+  );\n+  assert.equal(job.env.ONETASKGRAPH_LIVE_REQUIRED, \"1\");\n+  assert.equal(job.env.LINEAR_WRITE_TEAM, \"$\" + \"{{ vars.LINEAR_WRITE_TEAM }}\");\n+  const commands = job.steps.filter((step) => step.run).map((step) => step.run);\n+  assert.deepEqual(commands, [\"just linear-document-creation\"]);\n+  assert.ok(job.steps.some((step) => step.uses === \"extractions/setup-just@v4\"));\n+  assert.ok(\n+    job.steps.some(\n+      (step) =>\n+        step.uses === \"oven-sh/setup-bun@v2\" && step.with[\"bun-version-file\"] === \"package.json\",\n+    ),\n+  );\n+  assert.match(\n+    read(\"justfile\"),\n+    /linear-document-creation:\\n {4}@\\{\\{nx\\}\\} run-many -t live-documents --projects onetaskgraph-linear,onetaskgraph-linear-e2e --parallel=1/,\n+  );\n+  const commandsByLane = {\n+    \"onetaskgraph-linear\":\n+      \"cargo test --locked -p onetaskgraph-linear --test live -- real_linear_applies_every_declared_capability_and_leaves_no_residue --exact --nocapture\",\n+    \"onetaskgraph-linear-e2e\":\n+      \"cargo test --locked -p onetaskgraph-linear-e2e --test e2e -- linear_assets::live_disposable_issue_and_document_assets_copy_and_recopy --exact --nocapture\",\n+  };\n+  for (const [lane, command] of Object.entries(commandsByLane)) {\n+    const project = JSON.parse(read(`crates/${lane}/project.json`));\n+    const target = project.targets[\"live-documents\"];\n+    assert.equal(target.options.command, command);\n+    assert.equal(target.cache, false);\n+    assert.equal(target.parallelism, false);\n+    assert.ok(!project.targets.check.dependsOn.includes(\"live-documents\"));\n+    if (lane.endsWith(\"-e2e\")) assert.deepEqual(target.dependsOn, [\"onetaskgraph:build\"]);\n+  }\n+  for (const step of definitions[\"ci.yml\"].jobs.check.steps.filter(\n+    (step) => step.env?.LINEAR_API_KEY,\n+  )) {\n+    assert.equal(step.env.ONETASKGRAPH_LINEAR_DOCUMENT_MODE, \"ordinary\");\n+    assert.match(step.run, /^just (check|gate)-generated$/);\n+  }\n+});\n+\n+test(\"surface edits select document policy without publication journeys\", () => {\n+  const require = createRequire(import.meta.url);\n+  const manifest = require.resolve(\"nx/package.json\");\n+  const nx = resolve(dirname(manifest), require(\"nx/package.json\").bin.nx);\n+  const cwd = fileURLToPath(new URL(\"../../\", import.meta.url));\n+  for (const file of [\n+    \"justfile\",\n+    \"crates/onetaskgraph-linear/project.json\",\n+    \"crates/onetaskgraph-linear-e2e/project.json\",\n+  ]) {\n+    const projects = JSON.parse(\n+      execFileSync(\n+        process.execPath,\n+        [nx, \"show\", \"projects\", \"--affected\", \"--files\", file, \"--json\"],\n+        { cwd, encoding: \"utf8\" },\n+      ),\n+    );\n+    assert.ok(projects.includes(\"linear-documents-policy\"), `${file} must select its policy`);\n+    assert.ok(\n+      !projects.includes(\"github-workflows\"),\n+      `${file} must not select publication journeys`,\n+    );\n+  }\n+});"},{"sha":"73259ca9e06eecc1ab831d00a9340770c63dcc38","filename":".github/linear-documents-policy/project.json","status":"added","additions":69,"deletions":0,"changes":69,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Flinear-documents-policy%2Fproject.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Flinear-documents-policy%2Fproject.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Flinear-documents-policy%2Fproject.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,69 @@\n+{\n+  \"$schema\": \"../../node_modules/nx/schemas/project-schema.json\",\n+  \"name\": \"linear-documents-policy\",\n+  \"projectType\": \"library\",\n+  \"tags\": [\"lang:javascript\", \"layer:workspace\"],\n+  \"namedInputs\": {\n+    \"default\": [\n+      \"{projectRoot}/**/*\",\n+      \"{workspaceRoot}/justfile\",\n+      \"{workspaceRoot}/crates/onetaskgraph-linear/project.json\",\n+      \"{workspaceRoot}/crates/onetaskgraph-linear-e2e/project.json\",\n+      \"{workspaceRoot}/.github/workflows/*.yml\",\n+      \"{workspaceRoot}/.github/workflows/*.yaml\",\n+      \"{workspaceRoot}/.github/workflow-graph.mjs\",\n+      \"{workspaceRoot}/.github/actions-expressions.mjs\",\n+      \"{workspaceRoot}/.github/telemetry.ts\",\n+      \"{workspaceRoot}/.github/package.json\",\n+      \"{workspaceRoot}/.github/bun.lock\",\n+      \"{workspaceRoot}/.github/tsconfig.json\"\n+    ]\n+  },\n+  \"targets\": {\n+    \"bootstrap\": {\n+      \"executor\": \"nx:noop\",\n+      \"dependsOn\": [\"github-workflows:bootstrap\"]\n+    },\n+    \"check\": {\n+      \"executor\": \"nx:noop\",\n+      \"dependsOn\": [\"format-check\", \"lint\", \"typecheck\", \"test\", \"coverage\"]\n+    },\n+    \"format\": {\n+      \"executor\": \"nx:run-commands\",\n+      \"options\": {\n+        \"command\": \"bun run biome format --write .github/linear-documents-policy\"\n+      },\n+      \"cache\": false\n+    },\n+    \"format-check\": {\n+      \"executor\": \"nx:run-commands\",\n+      \"options\": {\n+        \"command\": \"bun run biome format .github/linear-documents-policy\"\n+      }\n+    },\n+    \"lint\": {\n+      \"executor\": \"nx:run-commands\",\n+      \"options\": {\n+        \"command\": \"bun run biome lint --error-on-warnings .github/linear-documents-policy\"\n+      }\n+    },\n+    \"typecheck\": {\n+      \"executor\": \"nx:run-commands\",\n+      \"options\": {\n+        \"command\": \"bun run tsc -p .github/tsconfig.json\"\n+      }\n+    },\n+    \"test\": {\n+      \"executor\": \"nx:run-commands\",\n+      \"dependsOn\": [\"bootstrap\"],\n+      \"options\": {\n+        \"command\": \"node --test .github/linear-documents-policy/policy.test.mjs\"\n+      },\n+      \"cache\": false\n+    },\n+    \"coverage\": {\n+      \"executor\": \"nx:noop\",\n+      \"//\": \"Private declarative workflow policy is verified by executable assertions and real Nx selection; it adds no separate runtime coverage metric.\"\n+    }\n+  }\n+}"},{"sha":"4479e7cb5414cfe0b49116698f0949bf6dce6c5a","filename":".github/project.json","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Fproject.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Fproject.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Fproject.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -8,6 +8,7 @@\n       \"{projectRoot}/**/*\",\n       \"!{projectRoot}/node_modules/**/*\",\n       \"!{projectRoot}/.telemetry/**/*\",\n+      \"!{projectRoot}/linear-documents-policy/**/*\",\n       \"{workspaceRoot}/release-targets.toml\",\n       \"{workspaceRoot}/config/github-interfaces.toml\",\n       \"{workspaceRoot}/screencomp.toml\",\n@@ -92,5 +93,5 @@\n       \"//\": \"Declared empty to preserve the repository standard target inventory, as scripts:coverage does; this private workflow tooling has executable subprocess and graph contracts but no separate coverage metric or new product coverage threshold.\"\n     }\n   },\n-  \"//\": \"llmlint: ignore-file[projects_stay_in_one_js_workspace,external_service_suite_stays_out_of_the_affected_tier] The task requires this private workflow-tooling project and lockfile to stay isolated from public SDK dependency resolution; its bootstrap installs only YAML, Actions expressions and budget reporting in .github. Its default input names the release plumbing the CD journeys under tests/ drive \\u2014 scripts/release_cd.py and every script and manifest a CD job runs (the justfile is not one: its release recipes only name that script, and its other recipes would select these journeys for nothing) \\u2014 so a change to how a release is produced selects them, while a change to a crate does not. The CD journeys' crate publication reads index.crates.io and static.crates.io without a credential \\u2014 the public reads every cargo build in the affected tier already makes for its dependencies \\u2014 through the double's index proxy and cargo's own verification build; they write only to loopback doubles, and dropping cargo's verification build to avoid them would stop proving each crate builds with its siblings resolved from a registry. JSON has no comment to scope this to the test target.\"\n+  \"//\": \"llmlint: ignore-file[projects_stay_in_one_js_workspace,external_service_suite_stays_out_of_the_affected_tier] The task requires this private workflow-tooling project and lockfile to stay isolated from public SDK dependency resolution; its bootstrap installs only YAML, Actions expressions and budget reporting in .github. Its default input names the release plumbing the CD journeys under tests/ drive. The justfile and Linear project manifests belong to the separate inexpensive document-policy project, so edits to those surfaces do not select the publication journeys. The CD journeys' crate publication reads index.crates.io and static.crates.io without a credential \\u2014 the public reads every cargo build in the affected tier already makes for its dependencies \\u2014 through the double's index proxy and cargo's own verification build; they write only to loopback doubles, and dropping cargo's verification build to avoid them would stop proving each crate builds with its siblings resolved from a registry. JSON has no comment to scope this to the test target.\"\n }"},{"sha":"d24244771cb167bda9feffdd9bf633b25425c29e","filename":".github/rust-cache-key.mjs","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Frust-cache-key.mjs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Frust-cache-key.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Frust-cache-key.mjs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,4 @@\n+// The env-var name prefixes the pinned Swatinem/rust-cache hashes into its key besides the\n+// toolchain and the manifests. rust-cache.test.mjs reconciles this list with that action's\n+// own source on every run, so it cannot drift from what the action really keys on.\n+export const HASHED_ENV_PREFIXES = [\"CARGO\", \"CC\", \"CFLAGS\", \"CXX\", \"CMAKE\", \"RUST\"];"},{"sha":"8f632457ddbb5d7be6ad8f48d47aae8503d300ea","filename":".github/tests/fixtures/ci-speedup-test-jobs.yml","status":"added","additions":63,"deletions":0,"changes":63,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Ftests%2Ffixtures%2Fci-speedup-test-jobs.yml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Ftests%2Ffixtures%2Fci-speedup-test-jobs.yml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Ftests%2Ffixtures%2Fci-speedup-test-jobs.yml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,63 @@\n+# llmlint: ignore-file[contracts_have_one_source_or_a_drift_gate] The authoritative jobs are on #3642's unmerged branch, which no gate here can read; the manager ruled this verbatim snapshot until they land. .github/tests/rust-cache-warm.test.mjs compares each warmer leg with this file only while ci.yml lacks its job, and fails when a job is in both, so the change that adds them to ci.yml must delete this file.\n+# The Rust-cache-relevant half of the two pull-request test jobs .github/workflows/rust-cache-warm.yml\n+# warms, copied verbatim from #3642 (branch nick/3632/onetaskgraph-ci-speedup) at\n+# ef1322ea6c3abf9baafe0d780825cdaab9f4746b: each job's runner and job-level env, its\n+# floating-compiler removal, its setup-rust-toolchain step, its tool install and the step that\n+# runs its build (that step's own env, credentials and nominations, left out: rust-cache keys\n+# nothing on it). `phases` is that job's arm of scripts/ci-job.sh at the same commit.\n+jobs:\n+  test-linux:\n+    runs-on: ubuntu-latest\n+    env:\n+      ONETASKGRAPH_SDK_WITHOUT_CLI: \"1\"\n+      UV_NO_SYNC: \"1\"\n+    steps:\n+      - name: Exclude the unused floating compiler from the build cache\n+        if: steps.release.outputs.tests == 'run'\n+        shell: bash\n+        run: rustup toolchain uninstall stable\n+      - uses: actions-rust-lang/setup-rust-toolchain@v1\n+        if: steps.release.outputs.tests == 'run'\n+        with:\n+          cache-shared-key: test-linux\n+      - uses: taiki-e/install-action@v2\n+        if: steps.release.outputs.tests == 'run'\n+        with:\n+          tool: cargo-llvm-cov,cargo-nextest,cargo-machete,cargo-deny,cargo-binstall\n+      - name: Test the affected projects\n+        if: steps.release.outputs.tests == 'run'\n+        run: just ci-test-linux\n+    phases: |-\n+      1 affected test tag:test-in-coverage:*,onetaskgraph-linear,onetaskgraph-linear-e2e\n+      1 affected test *,!onetaskgraph-linear,!onetaskgraph-linear-e2e\n+      1 affected test-uncovered,coverage tag:layer:sdk\n+      1 affected coverage *,!tag:layer:sdk\n+      1 run scripts:distribution-check -\n+      1 run scripts:distribution-test -\n+      2 affected budgets - --excludeTaskDependencies,--skipNxCache\n+  test-windows:\n+    runs-on: windows-latest\n+    env:\n+      ONETASKGRAPH_SDK_WITHOUT_CLI: \"1\"\n+      UV_NO_SYNC: \"1\"\n+      NX_PLUGIN_NO_TIMEOUTS: \"true\"\n+    steps:\n+      - name: Exclude the unused floating compiler from the build cache\n+        if: steps.release.outputs.tests == 'run'\n+        shell: bash\n+        run: rustup toolchain uninstall stable\n+      - uses: actions-rust-lang/setup-rust-toolchain@v1\n+        if: steps.release.outputs.tests == 'run'\n+        with:\n+          cache-shared-key: test-windows\n+      - uses: taiki-e/install-action@v2\n+        if: steps.release.outputs.tests == 'run'\n+        with:\n+          tool: cargo-llvm-cov,cargo-nextest,cargo-machete,cargo-deny,cargo-binstall\n+      - name: Test the affected projects\n+        if: steps.release.outputs.tests == 'run'\n+        run: just ci-test-windows\n+    phases: |-\n+      1 affected test,budgets - --parallel=4\n+      1 run scripts:distribution-check -\n+      1 run scripts:distribution-test -"},{"sha":"0451a7cdd45f42c8bd688a9a0d2859451ba3f92c","filename":".github/tests/rust-cache-warm.test.mjs","status":"added","additions":361,"deletions":0,"changes":361,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Ftests%2Frust-cache-warm.test.mjs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Ftests%2Frust-cache-warm.test.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Ftests%2Frust-cache-warm.test.mjs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,361 @@\n+import assert from \"node:assert/strict\";\n+import { existsSync } from \"node:fs\";\n+import { test } from \"node:test\";\n+import { parse } from \"yaml\";\n+import { HASHED_ENV_PREFIXES } from \"../rust-cache-key.mjs\";\n+import { read, root } from \"../workflow-graph.mjs\";\n+\n+// Each leg of rust-cache-warm.yml must save exactly the cache its pull-request job restores:\n+// the same shared key, the same toolchain and rust-cache inputs on the same runner, and the\n+// same build — or the save is a cache nobody reads and every pull request builds cold.\n+// A real save and restore needs GitHub's cache service, so the key is proven in two halves\n+// that need none: this parity of every input rust-cache keys on, beside rust-cache.test.mjs\n+// running the real action's key computation, and scripts/check-warm-rust-cache-reuse.sh,\n+// which builds the job's units over what the warmer built and fails on any recompiled.\n+\n+const FIXTURE = \".github/tests/fixtures/ci-speedup-test-jobs.yml\";\n+const SETUP = \"actions-rust-lang/setup-rust-toolchain@\";\n+const UNINSTALL = \"rustup toolchain uninstall stable\";\n+const WARM = /^bash scripts\\/warm-rust-cache\\.sh(?: (--instrumented))?$/;\n+\n+const isMapping = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\n+\n+// Holds a parsed workflow to the shape the helpers below read, naming the file and where it\n+// breaks rather than surfacing later as a TypeError.\n+function shaped(file, document) {\n+  const refuse = (where, what) => {\n+    throw Error(`${file}: ${where} is not ${what}`);\n+  };\n+  if (!isMapping(document)) refuse(\"the document\", \"a mapping\");\n+  if (document.env !== undefined && !isMapping(document.env)) refuse(\"env\", \"a mapping\");\n+  if (!isMapping(document.jobs)) refuse(\"jobs\", \"a mapping\");\n+  for (const [id, job] of Object.entries(document.jobs)) {\n+    if (!isMapping(job)) refuse(`jobs.${id}`, \"a mapping\");\n+    if (job.env !== undefined && !isMapping(job.env)) refuse(`jobs.${id}.env`, \"a mapping\");\n+    const include = job.strategy?.matrix?.include;\n+    if (include !== undefined && !(Array.isArray(include) && include.every(isMapping)))\n+      refuse(`jobs.${id}.strategy.matrix.include`, \"a list of mappings\");\n+    if (job.phases !== undefined && typeof job.phases !== \"string\")\n+      refuse(`jobs.${id}.phases`, \"a string\");\n+    if (job.steps === undefined) continue;\n+    if (!Array.isArray(job.steps)) refuse(`jobs.${id}.steps`, \"a list\");\n+    job.steps.forEach((step, index) => {\n+      const where = `jobs.${id}.steps[${index}]`;\n+      if (!isMapping(step)) refuse(where, \"a mapping\");\n+      if (step.with !== undefined && !isMapping(step.with)) refuse(`${where}.with`, \"a mapping\");\n+      for (const field of [\"uses\", \"run\"])\n+        if (step[field] !== undefined && typeof step[field] !== \"string\")\n+          refuse(`${where}.${field}`, \"a string\");\n+    });\n+  }\n+  return document;\n+}\n+\n+function sources() {\n+  const ciJob = new URL(\"scripts/ci-job.sh\", root);\n+  const load = (file) => shaped(file, parse(read(file)));\n+  return {\n+    warmer: load(\".github/workflows/rust-cache-warm.yml\"),\n+    ci: load(\".github/workflows/ci.yml\"),\n+    fixture: existsSync(new URL(FIXTURE, root)) ? load(FIXTURE) : { jobs: {} },\n+    ciJob: existsSync(ciJob) ? read(\"scripts/ci-job.sh\") : undefined,\n+  };\n+}\n+\n+function resolve(value, matrix) {\n+  if (typeof value === \"string\")\n+    return value.replace(/\\$\\{\\{\\s*matrix\\.([A-Za-z0-9_-]+)\\s*\\}\\}/g, (_, name) => {\n+      if (!Object.hasOwn(matrix, name))\n+        throw Error(`rust-cache-warm.yml names matrix.${name}, which its leg does not define`);\n+      return String(matrix[name]);\n+    });\n+  if (Array.isArray(value)) return value.map((entry) => resolve(entry, matrix));\n+  if (value && typeof value === \"object\")\n+    return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, resolve(v, matrix)]));\n+  return value;\n+}\n+\n+function legs(warmer) {\n+  const found = [];\n+  for (const [id, job] of Object.entries(warmer.jobs ?? {})) {\n+    if (!job.steps?.some((step) => step.uses?.startsWith(SETUP))) continue;\n+    const combinations = job.strategy?.matrix?.include ?? [{}];\n+    for (const matrix of combinations) {\n+      const resolved = resolve(job, matrix);\n+      const setup = resolved.steps.find((step) => step.uses?.startsWith(SETUP));\n+      found.push({ id, job: resolved, key: setup.with?.[\"cache-shared-key\"] });\n+    }\n+  }\n+  return found;\n+}\n+\n+function hashedEnv(...levels) {\n+  const merged = Object.assign({}, ...levels.map((env) => env ?? {}));\n+  return Object.fromEntries(\n+    Object.entries(merged)\n+      .filter(([name]) => HASHED_ENV_PREFIXES.some((prefix) => name.startsWith(prefix)))\n+      .sort(([a], [b]) => a.localeCompare(b)),\n+  );\n+}\n+\n+function toolchain(job) {\n+  const steps = job.steps ?? [];\n+  const index = steps.findIndex((step) => step.uses?.startsWith(SETUP));\n+  if (index < 0) return undefined;\n+  const { \"cache-shared-key\": _key, \"cache-save-if\": _save, ...inputs } = steps[index].with ?? {};\n+  return {\n+    uses: steps[index].uses,\n+    inputs,\n+    key: steps[index].with?.[\"cache-shared-key\"],\n+    hasKeyInput: steps[index].with?.[\"cache-key\"] !== undefined,\n+    uninstalled: steps[index - 1]?.run === UNINSTALL,\n+  };\n+}\n+\n+function installs(job) {\n+  return (job.steps ?? [])\n+    .filter((step) => step.uses?.startsWith(\"taiki-e/install-action@\"))\n+    .flatMap((step) => String(step.with?.tool ?? \"\").split(\",\"))\n+    .map((tool) => tool.trim())\n+    .filter(Boolean);\n+}\n+\n+// The phases a pull-request job runs: its arm of scripts/ci-job.sh once that exists, else the\n+// fixture's copy of it.\n+function phases(id, fixtureJob, ciJob) {\n+  if (ciJob !== undefined) {\n+    const arm = ciJob.match(new RegExp(`\\\\n  ${id}\\\\)\\\\n[\\\\s\\\\S]*?phases=\"([\\\\s\\\\S]*?)\"\\\\n`));\n+    if (arm) return arm[1];\n+  }\n+  return fixtureJob?.phases;\n+}\n+\n+function targets(text) {\n+  return text\n+    .split(\"\\n\")\n+    .map((line) => line.trim().split(/\\s+/))\n+    .filter((fields) => fields.length >= 3)\n+    .flatMap(([, kind, list]) =>\n+      kind === \"run\" ? [list.split(\":\")[1]] : list.split(\",\").map((t) => t.trim()),\n+    );\n+}\n+\n+function problems({ warmer, ci, fixture, ciJob }) {\n+  const found = [];\n+  const all = legs(warmer);\n+  if (!all.length) found.push(\"rust-cache-warm.yml has no leg running setup-rust-toolchain\");\n+  for (const id of Object.keys(fixture.jobs ?? {}))\n+    if (ci.jobs?.[id])\n+      found.push(`${id} is in ci.yml and in ${FIXTURE}; delete the fixture now ci.yml has the job`);\n+  for (const leg of all) {\n+    const name = `${leg.id} (${leg.job[\"runs-on\"]})`;\n+    if (!leg.key) {\n+      found.push(`${name} saves under no cache-shared-key`);\n+      continue;\n+    }\n+    const pr = ci.jobs?.[leg.key] ?? fixture.jobs?.[leg.key];\n+    if (!pr) {\n+      found.push(`${name} saves key ${leg.key}, which no job in ci.yml or ${FIXTURE} restores`);\n+      continue;\n+    }\n+    const mine = toolchain(leg.job);\n+    const theirs = toolchain(pr);\n+    if (!theirs) {\n+      found.push(`${leg.key} runs no setup-rust-toolchain step, so restores no Rust cache`);\n+      continue;\n+    }\n+    // rust-cache names a cache by its shared key, else by the job id.\n+    const restored = theirs.key ?? (theirs.hasKeyInput ? undefined : leg.key);\n+    if (restored !== leg.key)\n+      found.push(`${name} saves key ${leg.key}, but ${leg.key} restores ${restored}`);\n+    if (leg.job[\"runs-on\"] !== pr[\"runs-on\"])\n+      found.push(`${name} runs on ${leg.job[\"runs-on\"]}, ${leg.key} on ${pr[\"runs-on\"]}`);\n+    if (mine.uses !== theirs.uses)\n+      found.push(`${name} sets up the toolchain with ${mine.uses}, ${leg.key} with ${theirs.uses}`);\n+    try {\n+      assert.deepEqual(mine.inputs, theirs.inputs);\n+    } catch {\n+      found.push(\n+        `${name} gives setup-rust-toolchain ${JSON.stringify(mine.inputs)}, ${leg.key} ${JSON.stringify(theirs.inputs)}`,\n+      );\n+    }\n+    if (!mine.uninstalled || !theirs.uninstalled)\n+      found.push(`${name} and ${leg.key} must both remove floating stable before the cache step`);\n+    try {\n+      assert.deepEqual(hashedEnv(warmer.env, leg.job.env), hashedEnv(ci.env, pr.env));\n+    } catch {\n+      found.push(`${name} and ${leg.key} differ in an env var rust-cache hashes into the key`);\n+    }\n+    const builds = (leg.job.steps ?? [])\n+      .map((step) => step.run?.trim().match(WARM))\n+      .filter(Boolean);\n+    if (builds.length !== 1) {\n+      found.push(`${name} must run scripts/warm-rust-cache.sh exactly once`);\n+      continue;\n+    }\n+    const instrumented = builds[0][1] === \"--instrumented\";\n+    const prPhases = phases(leg.key, fixture.jobs?.[leg.key], ciJob);\n+    if (prPhases === undefined) {\n+      found.push(`${leg.key}'s phases are in neither scripts/ci-job.sh nor ${FIXTURE}`);\n+      continue;\n+    }\n+    const run = targets(prPhases);\n+    if (instrumented !== run.includes(\"coverage\"))\n+      found.push(\n+        `${name} builds ${instrumented ? \"instrumented\" : \"uninstrumented\"}, but ${leg.key} ${run.includes(\"coverage\") ? \"runs\" : \"does not run\"} coverage`,\n+      );\n+    if (!run.includes(\"distribution-test\"))\n+      found.push(`${name} builds the distribution journey's release, which ${leg.key} never runs`);\n+    if (instrumented)\n+      for (const tool of [\"cargo-llvm-cov\", \"cargo-nextest\"])\n+        if (!installs(leg.job).includes(tool) || !installs(pr).includes(tool))\n+          found.push(`${name} and ${leg.key} must both install ${tool} to build instrumented`);\n+  }\n+  return found;\n+}\n+\n+test(\"every warmer leg saves what its pull-request job restores\", () => {\n+  const all = sources();\n+  assert.deepEqual(problems(all), []);\n+  assert.deepEqual(\n+    legs(all.warmer).map((leg) => `${leg.key}:${leg.job[\"runs-on\"]}`),\n+    [\"test-linux:ubuntu-latest\", \"test-windows:windows-latest\"],\n+  );\n+  // A push to main schedules no Mac job: the macOS cache is warmed by its own pull requests.\n+  for (const [id, job] of Object.entries(all.warmer.jobs))\n+    for (const matrix of job.strategy?.matrix?.include ?? [{}])\n+      assert.doesNotMatch(String(resolve(job[\"runs-on\"], matrix)), /mac/i, id);\n+});\n+\n+test(\"a leg differing from its job in key, toolchain or build is refused\", () => {\n+  const original = sources();\n+  const mutate = (edit) => {\n+    const changed = structuredClone(original);\n+    edit(changed);\n+    return problems(changed);\n+  };\n+  const warm = (all) => all.warmer.jobs.warm;\n+  const leg = (all, id) => warm(all).strategy.matrix.include.find((entry) => entry.job === id);\n+  const linux = (all) => leg(all, \"test-linux\");\n+  const job = (all, id) => all.ci.jobs[id] ?? all.fixture.jobs[id];\n+  const setup = (steps) => steps.find((step) => step.uses?.startsWith(SETUP));\n+  const cases = {\n+    \"another key\": [\n+      /saves key test-linux-other, which no job/,\n+      (all) => {\n+        linux(all).job = \"test-linux-other\";\n+      },\n+    ],\n+    \"the pull-request job's key\": [\n+      /saves key test-windows, but test-windows restores windows/,\n+      (all) => {\n+        setup(job(all, \"test-windows\").steps).with[\"cache-shared-key\"] = \"windows\";\n+      },\n+    ],\n+    \"another toolchain\": [\n+      /warm \\(ubuntu-latest\\) gives setup-rust-toolchain/,\n+      (all) => {\n+        setup(warm(all).steps).with.toolchain = \"nightly\";\n+      },\n+    ],\n+    \"another cache input\": [\n+      /warm \\(windows-latest\\) gives setup-rust-toolchain/,\n+      (all) => {\n+        setup(job(all, \"test-windows\").steps).with[\"cache-workspaces\"] = \"crates\";\n+      },\n+    ],\n+    \"another runner\": [\n+      /runs on ubuntu-24\\.04-arm, test-linux on ubuntu-latest/,\n+      (all) => {\n+        linux(all).os = \"ubuntu-24.04-arm\";\n+      },\n+    ],\n+    \"a hashed env var\": [\n+      /differ in an env var rust-cache hashes/,\n+      (all) => {\n+        warm(all).env = { RUSTFLAGS: \"-C debug-assertions\" };\n+      },\n+    ],\n+    \"floating stable kept\": [\n+      /must both remove floating stable/,\n+      (all) => {\n+        const steps = warm(all).steps;\n+        steps.splice(\n+          steps.findIndex((step) => step.run === UNINSTALL),\n+          1,\n+        );\n+      },\n+    ],\n+    \"uninstrumented on Linux\": [\n+      /builds uninstrumented, but test-linux runs coverage/,\n+      (all) => {\n+        linux(all).build = \"\";\n+      },\n+    ],\n+    \"instrumented on Windows\": [\n+      /builds instrumented, but test-windows does not run coverage/,\n+      (all) => {\n+        leg(all, \"test-windows\").build = \"--instrumented\";\n+      },\n+    ],\n+    \"the job no longer runs coverage\": [\n+      /builds instrumented, but test-linux does not run coverage/,\n+      (all) => {\n+        all.ciJob = undefined;\n+        all.fixture.jobs[\"test-linux\"].phases =\n+          \"1 affected test -\\n1 run scripts:distribution-test -\";\n+      },\n+    ],\n+    \"no build\": [\n+      /must run scripts\\/warm-rust-cache\\.sh exactly once/,\n+      (all) => {\n+        const steps = warm(all).steps;\n+        steps.splice(\n+          steps.findIndex((step) => step.run?.startsWith(\"bash scripts/warm-rust-cache.sh\")),\n+          1,\n+        );\n+      },\n+    ],\n+    \"the job in both files\": [\n+      /test-windows is in ci\\.yml and in/,\n+      (all) => {\n+        all.ci.jobs[\"test-windows\"] = structuredClone(all.fixture.jobs[\"test-windows\"]);\n+      },\n+    ],\n+    \"the job in neither file\": [\n+      /saves key test-windows, which no job/,\n+      (all) => {\n+        delete all.fixture.jobs[\"test-windows\"];\n+        delete all.ci.jobs[\"test-windows\"];\n+      },\n+    ],\n+  };\n+  assert.throws(\n+    () => mutate((all) => delete linux(all).build),\n+    /names matrix\\.build, which its leg does not define/,\n+  );\n+  for (const [name, [expected, edit]] of Object.entries(cases)) {\n+    const found = mutate(edit);\n+    assert.ok(\n+      found.some((problem) => expected.test(problem)),\n+      `${name} must be refused with ${expected}: ${JSON.stringify(found)}`,\n+    );\n+  }\n+});\n+\n+test(\"a workflow not shaped as one is refused naming where\", () => {\n+  assert.throws(() => shaped(\"w.yml\", null), /w\\.yml: the document is not a mapping/);\n+  assert.throws(() => shaped(\"w.yml\", { jobs: [] }), /w\\.yml: jobs is not a mapping/);\n+  assert.throws(\n+    () => shaped(\"w.yml\", { jobs: { warm: { steps: {} } } }),\n+    /w\\.yml: jobs\\.warm\\.steps is not a list/,\n+  );\n+  assert.throws(\n+    () => shaped(\"w.yml\", { jobs: { warm: { steps: [{ run: 1 }] } } }),\n+    /w\\.yml: jobs\\.warm\\.steps\\[0\\]\\.run is not a string/,\n+  );\n+  assert.throws(\n+    () => shaped(\"w.yml\", { jobs: { warm: { strategy: { matrix: { include: \"x\" } } } } }),\n+    /w\\.yml: jobs\\.warm\\.strategy\\.matrix\\.include is not a list of mappings/,\n+  );\n+});"},{"sha":"8fe193a9aee73e4089fca9b2cda0de2dc1576190","filename":".github/tests/rust-cache.test.mjs","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Ftests%2Frust-cache.test.mjs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Ftests%2Frust-cache.test.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Ftests%2Frust-cache.test.mjs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -14,6 +14,7 @@ import { tmpdir } from \"node:os\";\n import { dirname, join } from \"node:path\";\n import { promisify } from \"node:util\";\n import { parse } from \"yaml\";\n+import { HASHED_ENV_PREFIXES } from \"../rust-cache-key.mjs\";\n import { read } from \"../workflow-graph.mjs\";\n import { test } from \"node:test\";\n import { workflows } from \"../workflow-graph.mjs\";\n@@ -161,6 +162,12 @@ test(\"the real cache action ignores floating stable but tracks the pin and lockf\n     ]);\n     command(\"git\", [\"-C\", action, \"checkout\", \"-q\", \"FETCH_HEAD\"]);\n     const manifest = actionManifest(readFileSync(join(action, \"action.yml\"), \"utf8\"));\n+    // The env-var prefixes rust-cache-warm.test.mjs compares a warmer leg and its job on.\n+    const prefixes = readFileSync(join(action, \"src/config.ts\"), \"utf8\").match(\n+      /const envPrefixes = \\[([^\\]]*)\\];/,\n+    );\n+    assert.ok(prefixes, \"rust-cache must declare its env-var prefixes in src/config.ts\");\n+    assert.deepEqual(JSON.parse(`[${prefixes[1]}]`), HASHED_ENV_PREFIXES);\n     assert.equal(manifest.runs.using, \"node24\");\n     assert.equal(typeof manifest.runs.main, \"string\");\n     assert.match(manifest.runs.main, /^dist\\/(?:[A-Za-z0-9_-]+\\/)*[A-Za-z0-9_-]+\\.js$/);"},{"sha":"4a32a879852a55ce98f1c6b029eb2cb5f7262ee4","filename":".github/workflows/ci.yml","status":"modified","additions":9,"deletions":4,"changes":13,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Fworkflows%2Fci.yml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Fworkflows%2Fci.yml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Fworkflows%2Fci.yml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -27,10 +27,6 @@ on:\n         type: boolean\n         default: false\n \n-concurrency:\n-  group: ${{ github.workflow }}-${{ github.ref }}\n-  cancel-in-progress: true\n-\n # Least privilege: the token is read-only by default and widened per job only where a job\n # genuinely needs more.\n permissions:\n@@ -89,6 +85,13 @@ jobs:\n   # matrix; affected selection is what keeps that affordable.\n   check:\n     name: check (${{ matrix.os }})\n+    # The live journeys remain inside the affected gate. Serialize only this job,\n+    # and retain every waiting check rather than replacing a pending writer.\n+    # llmlint: ignore[external_service_suite_stays_out_of_the_affected_tier] This block moves no suite into the gate: the live journeys were already ordinary affected tests, run only when their own plugin changed, which AGENTS.md records as reversing the separate live tier. It only serializes the one credentialed leg so two writers cannot interleave updates to the standing Linear set.\n+    concurrency:\n+      group: ${{ matrix.os == 'ubuntu-latest' && 'linear-live-documents' || format('check-{0}-{1}', matrix.os, github.run_id) }}\n+      cancel-in-progress: false\n+      queue: max\n     needs: [macos-lanes]\n     if: ${{ !cancelled() && github.event_name != 'workflow_dispatch' }}\n     runs-on: ${{ matrix.os }}\n@@ -184,6 +187,7 @@ jobs:\n           GITHUB_LIVE_SESSION_ID: ${{ github.run_id }}-${{ github.run_attempt }}\n           GITHUB_LIVE_SESSION_DIR: ${{ github.workspace }}/target/debug/telemetry/github-live-session/${{ github.run_id }}-${{ github.run_attempt }}\n           GITHUB_LIVE_SOURCE_REVISION: ${{ github.sha }}\n+          ONETASKGRAPH_LINEAR_DOCUMENT_MODE: ordinary\n           LINEAR_API_KEY: ${{ secrets.LINEAR_API_KEY }}\n           # Nominations, not secrets: each lane writes only where it is pointed and refuses\n           # to pick a target itself, because \"whichever project was updated most recently\"\n@@ -231,6 +235,7 @@ jobs:\n           GITHUB_LIVE_SESSION_ID: ${{ github.run_id }}-${{ github.run_attempt }}\n           GITHUB_LIVE_SESSION_DIR: ${{ github.workspace }}/target/debug/telemetry/github-live-session/${{ github.run_id }}-${{ github.run_attempt }}\n           GITHUB_LIVE_SOURCE_REVISION: ${{ github.sha }}\n+          ONETASKGRAPH_LINEAR_DOCUMENT_MODE: ordinary\n           LINEAR_API_KEY: ${{ secrets.LINEAR_API_KEY }}\n           # llmlint: ignore[contracts_have_one_source_or_a_drift_gate] As on that step: the lane's own refusal is the drift gate, because ONETASKGRAPH_LIVE_REQUIRED is 1 here too, so a name spelled differently on either side fails this run naming the variable rather than skipping green.\n           GH_PROJECTS_OWNER: nickderobertis"},{"sha":"27f83e8a83fc84ee7d59b6e192ae75bf311e237e","filename":".github/workflows/linear-documents.yml","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Fworkflows%2Flinear-documents.yml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Fworkflows%2Flinear-documents.yml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Fworkflows%2Flinear-documents.yml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,32 @@\n+# Fresh creation coverage is daily; change-triggered affected checks reuse standing slots.\n+name: Linear document creation\n+\n+on:\n+  schedule:\n+    - cron: \"43 6 * * *\"\n+  workflow_dispatch:\n+\n+permissions:\n+  contents: read\n+\n+jobs:\n+  documents:\n+    runs-on: ubuntu-latest\n+    concurrency:\n+      group: linear-live-documents\n+      cancel-in-progress: false\n+      queue: max\n+    env:\n+      LINEAR_API_KEY: ${{ secrets.LINEAR_API_KEY }}\n+      LINEAR_WRITE_TEAM: ${{ vars.LINEAR_WRITE_TEAM }}\n+      ONETASKGRAPH_LIVE_REQUIRED: \"1\"\n+      ONETASKGRAPH_LINEAR_DOCUMENT_MODE: ${{ github.event_name == 'schedule' && 'fresh' || 'initialize' }}\n+    steps:\n+      - uses: actions/checkout@v7\n+      - uses: actions-rust-lang/setup-rust-toolchain@v1\n+      - uses: extractions/setup-just@v4\n+      - uses: oven-sh/setup-bun@v2\n+        with:\n+          bun-version-file: package.json\n+      - name: Prove document creation or initialize missing slots\n+        run: just linear-document-creation"},{"sha":"095c988b7719f54451b00f92250e1e4da3c3a276","filename":".github/workflows/rust-cache-warm.yml","status":"added","additions":69,"deletions":0,"changes":69,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Fworkflows%2Frust-cache-warm.yml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/.github%2Fworkflows%2Frust-cache-warm.yml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Fworkflows%2Frust-cache-warm.yml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,69 @@\n+# Build, testing nothing, what test-linux and test-windows build, and save it under the key each\n+# restores; AGENTS.md says why main must. No macOS leg: a push to main schedules no Mac job.\n+# .github/tests/rust-cache-warm.test.mjs holds each leg to its job's key and build inputs.\n+\n+name: rust cache warm\n+\n+on:\n+  push:\n+    branches: [main]\n+\n+concurrency:\n+  group: ${{ github.workflow }}-${{ github.ref }}\n+  cancel-in-progress: false\n+\n+permissions:\n+  contents: read\n+\n+jobs:\n+  warm:\n+    name: warm (${{ matrix.os }})\n+    strategy:\n+      fail-fast: false\n+      matrix:\n+        include:\n+          - os: ubuntu-latest\n+            job: test-linux\n+            build: --instrumented\n+          - os: windows-latest\n+            job: test-windows\n+            build: \"\"\n+    runs-on: ${{ matrix.os }}\n+    timeout-minutes: 60\n+    steps:\n+      - uses: actions/checkout@v7\n+        with:\n+          persist-credentials: false\n+      # Defender scanning each file the build writes slows it; the cache key reads none of this.\n+      - name: Keep Defender's real-time scan off the build\n+        if: runner.os == 'Windows'\n+        shell: pwsh\n+        run: |\n+          Add-MpPreference -ExclusionPath $env:GITHUB_WORKSPACE, \"$env:USERPROFILE\\.cargo\", \"$env:USERPROFILE\\.rustup\", \"$env:LOCALAPPDATA\\uv\", $env:RUNNER_TEMP, $env:TEMP\n+      # The distribution journey's release build runs maturin through uv.\n+      - uses: astral-sh/setup-uv@v7\n+      # The key the pull-request job restores; rust-cache adds the OS, the toolchain and every\n+      # Cargo manifest and lockfile to it.\n+      # rust-cache hashes every installed compiler; exclude the unused floating one.\n+      - name: Exclude the unused floating compiler from the build cache\n+        shell: bash\n+        run: rustup toolchain uninstall stable\n+      - uses: actions-rust-lang/setup-rust-toolchain@v1\n+        with:\n+          cache-shared-key: ${{ matrix.job }}\n+      - uses: taiki-e/install-action@v2\n+        if: matrix.build == '--instrumented'\n+        with:\n+          tool: cargo-llvm-cov,cargo-nextest\n+      - name: Build what ${{ matrix.job }} builds\n+        shell: bash\n+        run: bash scripts/warm-rust-cache.sh ${{ matrix.build }}\n+      # test-linux's own builds over what was just built, which must recompile no dependency:\n+      # a push to main fails the moment the cache it saves is not one a pull request reuses.\n+      - uses: extractions/setup-just@v4\n+        if: matrix.job == 'test-linux'\n+      - name: Check what test-linux builds reuses this build\n+        if: matrix.job == 'test-linux'\n+        shell: bash\n+        run: just warm-cache-reuse-check-warmed\n+"},{"sha":"01d9c62a8bebb9b9558bb7d1361988a8672436d2","filename":"AGENTS.md","status":"modified","additions":36,"deletions":2,"changes":38,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/AGENTS.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/AGENTS.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/AGENTS.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -164,7 +164,7 @@ Nothing of a user's work is stored, cached, indexed or mirrored outside the plug\n owns it. The engine compensates transiently and writes nothing down. Extend these three\n mechanisms rather than rediscovering the rule; each says how it fails, not how it works.\n \n-**One named exception: the local cache of a remote source, and only where a configuration\n+**Named exception: the local cache of a remote source, and only where a configuration\n turns it on.** `sources.<name>.cache.enabled` (off unless set) keeps a GitHub board's or a\n Linear source's tasks, projects, documents and verified image bytes under `${XDG_CACHE_HOME:-$HOME/.cache}/onetaskgraph/<digest>` or\n `cache.dir`, keyed on the change token alone and served only at the version a caller pinned\n@@ -176,6 +176,19 @@ anywhere, and `no_persistence.rs` still proves it; with it set, the GitHub Proje\n `with_caching_on_the_cache_directory_is_the_only_place_a_file_changes` proves only the cache\n directory changes.\n \n+**Named exception: producer-owned projection write authority.**\n+`task_projection::IntentStore` keeps the producer's recovery state in the directory its\n+caller explicitly selects; [the journal](crates/onetaskgraph-core/src/task_projection/intent.rs)\n+defines its contents. Supply the existing cache's source identity digest, not a second\n+identity scheme. This journal authorizes a write; it never answers a work query and holds\n+no task title or body. OS locks serialize local owners, a create claim must be committed\n+before a create is sent, and a failed commit requires reopening the claim. A pending create is\n+bound only by one verified origin match; zero, multiple or unindexed matches refuse,\n+never authorize another create. Never use stored work content as current terminal-write\n+authority. The placement a projection keeps between processes — ids under a plugin-owned\n+setup-context token, never work content — sits beside `designator.json` in the source's cache\n+directory on the same terms. See [the projection intent API](docs/task-projection.md).\n+\n **A destination write is not a cache, and the difference is stated rather than assumed.**\n A destination write is at the user's explicit request, names its destination, goes through\n that source's own write interface into that source's own store, and is never read back to\n@@ -425,7 +438,11 @@ The suite is the only QA loop; realism and completeness are rules, not preferenc\n   and the default branch runs `just gate`, which is `deny` plus that same `check`.\n   CI derives its base explicitly from the merge base or `github.event.before`, because\n   an implicit base can select the wrong changes. Pushes run no repository checks;\n-  contributors can run `NX_BASE=<ref> just check` or `just gate` manually.\n+  contributors can run `NX_BASE=<ref> just check` or `just gate` manually. A push to main\n+  does build, testing nothing, the Rust cache `test-linux` and `test-windows` restore\n+  (`.github/workflows/rust-cache-warm.yml`): a pull request restores only a cache saved on\n+  its own ref or on main, so nothing else could give a new one a warm build. It has no macOS\n+  leg, so a push to main still schedules no Mac job.\n   `scripts/check-live-lane-selection.sh`, a command in `scripts:test`, holds all of that:\n   it puts the five diffs to the real decision over real git states, drives the real recipes\n   for both CI paths, puts three diffs to real Nx, and ENUMERATES the paths from\n@@ -1288,6 +1305,23 @@ them do; this is the inventory of what is owed, not a status board.\n     one view each; and every visibility refusal still firing, writing nothing, with placement\n     unchanged on a board not declared private and for a repository that reads private.\n \n+123. `task project-human` creates one ticket per `item_id` on a GitHub board and in a Linear\n+     plan project, answers its canonical issue URL, answers a bound retry sending nothing,\n+     settles a terminal state once — completed, dismissed without and with a reason — and\n+     refuses a conflicting one, another host, a changed payload and every malformed or question\n+     request, writing nothing.\n+124. Killed after the tracker applied a chosen write, a projection recovers a lost create answer\n+     by its one verified origin match and a lost terminal answer by one read, and refuses a\n+     pending create with no, an unverifiable or two matches without creating again;\n+     simultaneous managers share one ticket.\n+125. Human-task routes send public work to the public board, private and mixed work only to the\n+     private one and an organization's to its Linear plan project, refuse private work with no\n+     private route and a project of another source, and are never taken without their purpose.\n+126. A later cold process takes the kept placement behind its setup-context token and reads it\n+     afresh once an option changes; a person's body edit survives every terminal projection;\n+     and an approval creates and resolves its review task through `task project-human`, a stale\n+     version refusing the approval and leaving the review open.\n+\n ## The public boundary\n \n Classification, a source's declared `visibility`, classification routes and `write_policy`"},{"sha":"57c764af096ad40521c625d800b4a76aa1dbcf04","filename":"Cargo.lock","status":"modified","additions":18,"deletions":16,"changes":34,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/Cargo.lock","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/Cargo.lock","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/Cargo.lock?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1223,7 +1223,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"chrono\",\n  \"clap\",\n@@ -1240,7 +1240,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-core\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1262,11 +1262,12 @@ dependencies = [\n  \"tempfile\",\n  \"thiserror 2.0.20\",\n  \"tokio\",\n+ \"url\",\n ]\n \n [[package]]\n name = \"onetaskgraph-e2e\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"assert_cmd\",\n  \"async-trait\",\n@@ -1286,7 +1287,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-e2e-support\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"assert_cmd\",\n  \"chrono\",\n@@ -1302,7 +1303,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-github-live\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"onetaskgraph-live\",\n  \"serde\",\n@@ -1313,7 +1314,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-github-projects\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1333,7 +1334,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-github-projects-e2e\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"chrono\",\n  \"libc\",\n@@ -1355,7 +1356,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-in-memory\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1369,7 +1370,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-linear\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1386,8 +1387,9 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-linear-e2e\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n+ \"graphql-parser\",\n  \"onebudgetspec-core\",\n  \"onetaskgraph-core\",\n  \"onetaskgraph-e2e-support\",\n@@ -1404,11 +1406,11 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-live\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n \n [[package]]\n name = \"onetaskgraph-live-janitor\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"graphql-parser\",\n  \"onebudgetspec-core\",\n@@ -1426,7 +1428,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-local-md\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1445,7 +1447,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-plugin-api\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"async-trait\",\n  \"base64\",\n@@ -1462,7 +1464,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-status-options\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"onetaskgraph-github-projects\",\n  \"onetaskgraph-plugin-api\",\n@@ -1473,7 +1475,7 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-status-options-e2e\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n dependencies = [\n  \"onetaskgraph-e2e-support\",\n  \"serde_json\","},{"sha":"028943043a06aac46311f017f73d8a82cf227105","filename":"Cargo.toml","status":"modified","additions":9,"deletions":8,"changes":17,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/Cargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/Cargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/Cargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -3,7 +3,7 @@ resolver = \"3\"\n members = [\"crates/*\"]\n \n [workspace.package]\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n edition = \"2024\"\n rust-version = \"1.97\"\n license = \"MIT\"\n@@ -17,13 +17,13 @@ authors = [\"Nick DeRobertis\"]\n # another's newer patch and compile nothing. release-plz rewrites these in step, keeping the\n # `=`; scripts/set-version.sh --check refuses one without it, and the release job refuses to\n # publish a crate whose siblings resolve elsewhere (scripts/crate-sibling-resolution.sh).\n-onetaskgraph-plugin-api = { path = \"crates/onetaskgraph-plugin-api\", version = \"=0.12.12\" }\n-onetaskgraph-core = { path = \"crates/onetaskgraph-core\", version = \"=0.12.12\" }\n-onetaskgraph-in-memory = { path = \"crates/onetaskgraph-in-memory\", version = \"=0.12.12\" }\n-onetaskgraph-local-md = { path = \"crates/onetaskgraph-local-md\", version = \"=0.12.12\" }\n-onetaskgraph-linear = { path = \"crates/onetaskgraph-linear\", version = \"=0.12.12\" }\n-onetaskgraph-github-projects = { path = \"crates/onetaskgraph-github-projects\", version = \"=0.12.12\" }\n-onetaskgraph-status-options = { path = \"crates/onetaskgraph-status-options\", version = \"=0.12.12\" }\n+onetaskgraph-plugin-api = { path = \"crates/onetaskgraph-plugin-api\", version = \"=0.12.13\" }\n+onetaskgraph-core = { path = \"crates/onetaskgraph-core\", version = \"=0.12.13\" }\n+onetaskgraph-in-memory = { path = \"crates/onetaskgraph-in-memory\", version = \"=0.12.13\" }\n+onetaskgraph-local-md = { path = \"crates/onetaskgraph-local-md\", version = \"=0.12.13\" }\n+onetaskgraph-linear = { path = \"crates/onetaskgraph-linear\", version = \"=0.12.13\" }\n+onetaskgraph-github-projects = { path = \"crates/onetaskgraph-github-projects\", version = \"=0.12.13\" }\n+onetaskgraph-status-options = { path = \"crates/onetaskgraph-status-options\", version = \"=0.12.13\" }\n # The workspace's own test-support crate: the gate every live session opens. Path-only\n # and unpublished on purpose — cargo strips a path-only dev-dependency when it packages\n # the crates that name it, so nothing a consumer installs can reach it.\n@@ -36,6 +36,7 @@ onetaskgraph-github-live = { path = \"crates/onetaskgraph-github-live\" }\n # `onetaskgraph-live` is: only the test-only e2e members name it.\n onetaskgraph-e2e-support = { path = \"crates/onetaskgraph-e2e-support\" }\n \n+url = \"2.5.8\"\n async-trait = \"0.1.92\"\n # An asset's bytes over the stdio plugin protocol. Already in this lockfile through reqwest, so\n # naming it adds no crate to the closure."},{"sha":"efb48480fc792eee6585ce191c9c22f5cb66ebda","filename":"bun.lock","status":"modified","additions":19,"deletions":2,"changes":21,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/bun.lock","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/bun.lock","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/bun.lock?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -7,20 +7,21 @@\n       \"devDependencies\": {\n         \"@biomejs/biome\": \"2.5.10\",\n         \"@onebudgetspec/cli\": \"0.1.5\",\n+        \"@onebudgetspec/sdk\": \"0.1.3\",\n         \"@types/bun\": \"1.3.14\",\n         \"nx\": \"23.1.1\",\n         \"typescript\": \"5.9.3\",\n       },\n     },\n     \"sdks/typescript\": {\n       \"name\": \"@onetaskgraph/sdk\",\n-      \"version\": \"0.12.12\",\n+      \"version\": \"0.12.13\",\n       \"devDependencies\": {\n         \"ajv\": \"8.17.1\",\n         \"json-schema-to-typescript\": \"15.0.4\",\n       },\n       \"optionalDependencies\": {\n-        \"@onetaskgraph/cli\": \"0.12.12\",\n+        \"@onetaskgraph/cli\": \"0.12.13\",\n       },\n     },\n   },\n@@ -91,6 +92,8 @@\n \n     \"@onebudgetspec/cli-win32-x64\": [\"@onebudgetspec/cli-win32-x64@0.1.5\", \"\", { \"os\": \"win32\", \"cpu\": \"x64\" }, \"sha512-7JqBsIu/UYxJJrrXBAF8zrxLq3uG+oFtQEkm6cjbTsRGYpJzgFj5KntJvpNWTnUysgGYix8H4VZJYRRrUnPD2A==\"],\n \n+    \"@onebudgetspec/sdk\": [\"@onebudgetspec/sdk@0.1.3\", \"\", { \"optionalDependencies\": { \"@onebudgetspec/cli\": \"0.1.3\" } }, \"sha512-A3tAXHcmPqtkutMVEo9y3Z1GpKiPW2ns1fBF+EuASfh8LmASVXkDVMx0XrV+dS7WUitZR4vhhjszDS1nAeTACg==\"],\n+\n     \"@onetaskgraph/sdk\": [\"@onetaskgraph/sdk@workspace:sdks/typescript\"],\n \n     \"@tybys/wasm-util\": [\"@tybys/wasm-util@0.9.0\", \"\", { \"dependencies\": { \"tslib\": \"^2.4.0\" } }, \"sha512-6+7nlbMVX/PVDCwaIQ8nTOPveOcFLSt8GcXdx8hD0bt39uWxYT88uXzqTd4fTvqta7oeUJqudepapKNt2DYJFw==\"],\n@@ -366,5 +369,19 @@\n     \"yargs\": [\"yargs@17.7.2\", \"\", { \"dependencies\": { \"cliui\": \"^8.0.1\", \"escalade\": \"^3.1.1\", \"get-caller-file\": \"^2.0.5\", \"require-directory\": \"^2.1.1\", \"string-width\": \"^4.2.3\", \"y18n\": \"^5.0.5\", \"yargs-parser\": \"^21.1.1\" } }, \"sha512-7dSzzRQ++CKnNI/krKnYRV7JKKPUXMEh61soaHKg9mrWEhzFWhFnxPxGl+69cD1Ou63C13NUPCnmIcrvqCuM6w==\"],\n \n     \"yargs-parser\": [\"yargs-parser@21.1.1\", \"\", {}, \"sha512-tVpsJW7DdjecAiFpbIB1e3qxIQsE6NoPc5/eTdrbbIC4h0LVsWhnoa3g+m2HclBIujHzsxZ4VJVA+GUuc2/LBw==\"],\n+\n+    \"@onebudgetspec/sdk/@onebudgetspec/cli\": [\"@onebudgetspec/cli@0.1.3\", \"\", { \"optionalDependencies\": { \"@onebudgetspec/cli-darwin-arm64\": \"0.1.3\", \"@onebudgetspec/cli-darwin-x64\": \"0.1.3\", \"@onebudgetspec/cli-linux-arm64\": \"0.1.3\", \"@onebudgetspec/cli-linux-x64\": \"0.1.3\", \"@onebudgetspec/cli-win32-arm64\": \"0.1.3\", \"@onebudgetspec/cli-win32-x64\": \"0.1.3\" }, \"bin\": { \"onebudgetspec\": \"bin/onebudgetspec.js\" } }, \"sha512-iamgIA8Rlm9tdpJcSuem45lMMKDsp6u/bsGKT3PPGCrM/YS4eF5EujFWVJkt8aq/CZxrSxe4iL5WoI/Sm/WAwA==\"],\n+\n+    \"@onebudgetspec/sdk/@onebudgetspec/cli/@onebudgetspec/cli-darwin-arm64\": [\"@onebudgetspec/cli-darwin-arm64@0.1.3\", \"\", { \"os\": \"darwin\", \"cpu\": \"arm64\" }, \"sha512-/oChqGOmYfDVep6uKJMEQaNhASe8195msrpPv10+/54phujMeCcQcen3J4x7GMNdV7e0XN1XE7IS4dNQ9mzaeA==\"],\n+\n+    \"@onebudgetspec/sdk/@onebudgetspec/cli/@onebudgetspec/cli-darwin-x64\": [\"@onebudgetspec/cli-darwin-x64@0.1.3\", \"\", { \"os\": \"darwin\", \"cpu\": \"x64\" }, \"sha512-aTRi9xGaTcZ1Akbp7/mk7USj3rSJt8vCTPv5QDHI7Oo5EgfwVMGuP6kP9cDQKou9XEUDfl3Np5sKyD6d0UQGjQ==\"],\n+\n+    \"@onebudgetspec/sdk/@onebudgetspec/cli/@onebudgetspec/cli-linux-arm64\": [\"@onebudgetspec/cli-linux-arm64@0.1.3\", \"\", { \"os\": \"linux\", \"cpu\": \"arm64\" }, \"sha512-4VZAlqAt8qo3XeyxCeOMMfKDAoYGQbVzQMJ2kEl4F2gQXjmOIb2M4T4lRPz+D9GsQk4RYA8atz54EU9EVu3ALg==\"],\n+\n+    \"@onebudgetspec/sdk/@onebudgetspec/cli/@onebudgetspec/cli-linux-x64\": [\"@onebudgetspec/cli-linux-x64@0.1.3\", \"\", { \"os\": \"linux\", \"cpu\": \"x64\" }, \"sha512-M1tZ6cfXQpedCLHR4qD7dxyrLKA1rkdJJPWuAlFpfBR8MVqCW/VFpM1HcUNVToVcBiBAdouv64J1mDgYClwvFg==\"],\n+\n+    \"@onebudgetspec/sdk/@onebudgetspec/cli/@onebudgetspec/cli-win32-arm64\": [\"@onebudgetspec/cli-win32-arm64@0.1.3\", \"\", { \"os\": \"win32\", \"cpu\": \"arm64\" }, \"sha512-waRrYrt9Memj2LMTRQqLAecxh+5Qy4GAJEfjIBfeaey3cVuOghPYxcNQoTpfklLKK/NA1j+bbuqhBDX19aN7tA==\"],\n+\n+    \"@onebudgetspec/sdk/@onebudgetspec/cli/@onebudgetspec/cli-win32-x64\": [\"@onebudgetspec/cli-win32-x64@0.1.3\", \"\", { \"os\": \"win32\", \"cpu\": \"x64\" }, \"sha512-eOW/fz30SZqJfR0281VD5o832ijdjKzDeTxjAIQmfXHJnJPTBarfYBQr/7U/Z8AR+q6PyDmNnJ9ckuIGnIBU/w==\"],\n   }\n }"},{"sha":"0de9c2fa1f8a1e28018801b38959b285733ed367","filename":"crates/onetaskgraph-core/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2FCHANGELOG.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2FCHANGELOG.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.12.12...onetaskgraph-core-v0.12.13) - 2026-10-30\n+\n+### Added\n+\n+- project human tasks through existing tracker routing ([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n+\n ## [0.12.11](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.12.10...onetaskgraph-core-v0.12.11) - 2026-10-29\n \n ### Fixed"},{"sha":"f3b65663408b8ef2d5292ad392cd453eddf98bd7","filename":"crates/onetaskgraph-core/Cargo.toml","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n [package]\n name = \"onetaskgraph-core\"\n description = \"The onetaskgraph engine: the plugin registry, global-id qualification, and the plan every response carries.\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n edition.workspace = true\n rust-version.workspace = true\n license.workspace = true\n@@ -21,6 +21,7 @@ linear = [\"dep:onetaskgraph-linear\"]\n # The engine may depend on every plugin; no plugin may depend back. Registering a new\n # plugin here is what lets a configuration name it.\n [dependencies]\n+url.workspace = true\n # The trait a subprocess-hosted source implements is async, so the engine needs the same\n # attribute macro a plugin does. It brings no runtime with it: this crate is still written\n # against `std::future` alone and runs on whatever runtime its caller starts."},{"sha":"5d16e13bbf28acf96dec0784af35e90f3c22a5a2","filename":"crates/onetaskgraph-core/src/cache/mod.rs","status":"modified","additions":11,"deletions":4,"changes":15,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fcache%2Fmod.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fcache%2Fmod.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fcache%2Fmod.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -82,15 +82,23 @@ pub fn location(config: &SourceConfig, home: Option<&Path>) -> Option<CacheLocat\n     if !config.cache().enabled {\n         return None;\n     }\n-    let identity = config.plugin().plugin().remote_identity(config.config())?;\n-    let remote = digest(&format!(\"{}\\n{identity}\", config.plugin().as_str()));\n+    let remote = remote_digest(config)?;\n     let dir = match &config.cache().dir {\n         Some(dir) => dir.clone(),\n         None => home?.join(\"onetaskgraph\").join(&remote),\n     };\n     Some(CacheLocation { dir, remote })\n }\n \n+/// The digest naming the remote `config` reads — the one its cache directory is named for, its\n+/// designator is held to and a projection keys its intents by — or `None` for a source with no\n+/// remote. The one spelling of that identity.\n+#[must_use]\n+pub(crate) fn remote_digest(config: &SourceConfig) -> Option<String> {\n+    let identity = config.plugin().plugin().remote_identity(config.config())?;\n+    Some(digest(&format!(\"{}\\n{identity}\", config.plugin().as_str())))\n+}\n+\n /// Where the source `config` keeps the designator its backend answered, whether or not its\n /// cache is on: the path of `designator.json` in the directory the cache lives in — `cache.dir`,\n /// or the directory named for the remote under `home` — and the digest of that remote, which a\n@@ -103,8 +111,7 @@ pub(crate) fn designator_location(\n     config: &SourceConfig,\n     home: Option<&Path>,\n ) -> Option<(PathBuf, String)> {\n-    let identity = config.plugin().plugin().remote_identity(config.config())?;\n-    let remote = digest(&format!(\"{}\\n{identity}\", config.plugin().as_str()));\n+    let remote = remote_digest(config)?;\n     let dir = match &config.cache().dir {\n         Some(dir) => dir.clone(),\n         None => home?.join(\"onetaskgraph\").join(&remote),"},{"sha":"1d2890a9598774bde6fb9fc313fff42ab0d0963d","filename":"crates/onetaskgraph-core/src/cache/source.rs","status":"modified","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fcache%2Fsource.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fcache%2Fsource.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fcache%2Fsource.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -978,6 +978,22 @@ impl TaskSource for CachedSource {\n         self.inner.prime_write(id, context, board)\n     }\n \n+    fn placement_context(&self) -> Option<Value> {\n+        self.inner.placement_context()\n+    }\n+\n+    fn prime_placement(&self, context: &Value) -> bool {\n+        self.inner.prime_placement(context)\n+    }\n+\n+    fn written_context(&self, id: &NativeId) -> Option<Value> {\n+        self.inner.written_context(id)\n+    }\n+\n+    fn prime_written(&self, id: &NativeId, context: &Value, task: &Task) -> bool {\n+        self.inner.prime_written(id, context, task)\n+    }\n+\n     fn unprime(&self, id: &NativeId) {\n         self.inner.unprime(id);\n     }"},{"sha":"d5a4d95709c6faeadbb5b27cdd7de249180589c4","filename":"crates/onetaskgraph-core/src/config/environment_layer.rs","status":"modified","additions":7,"deletions":1,"changes":8,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fconfig%2Fenvironment_layer.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fconfig%2Fenvironment_layer.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fconfig%2Fenvironment_layer.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -23,7 +23,13 @@ pub const ENVIRONMENT_PREFIX: &str = \"ONETASKGRAPH_\";\n /// it drives in `ONETASKGRAPH_BIN` and passes its environment on to that binary, where it\n /// would decode to a setting called `bin` and refuse every command. It says which binary\n /// to run — settled before this binary starts — so no command's answer depends on it.\n-const RESERVED: &[&str] = &[SECRETS_FILE_VARIABLE, BIN_VARIABLE];\n+///\n+/// [`HOST_VARIABLE`] names the host this process runs on, which a source's\n+/// `task_projection` is compared with; it is a fact about the machine rather than a setting.\n+const RESERVED: &[&str] = &[SECRETS_FILE_VARIABLE, BIN_VARIABLE, HOST_VARIABLE];\n+\n+/// The variable naming the host this process runs on, which is not a setting.\n+pub const HOST_VARIABLE: &str = \"ONETASKGRAPH_HOST\";\n \n /// The variable a caller names this binary's own path in, which is not a setting.\n const BIN_VARIABLE: &str = \"ONETASKGRAPH_BIN\";"},{"sha":"e173873f66890c7ada95daeb7678003a26dbf32a","filename":"crates/onetaskgraph-core/src/config/mod.rs","status":"modified","additions":64,"deletions":2,"changes":66,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fconfig%2Fmod.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fconfig%2Fmod.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fconfig%2Fmod.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -43,12 +43,12 @@ pub use discovery::{\n     read_optional, readable_documents, secrets_path, user_document_path,\n };\n pub use effective::EffectiveConfig;\n-pub use environment_layer::{ENVIRONMENT_PREFIX, variable_for};\n+pub use environment_layer::{ENVIRONMENT_PREFIX, HOST_VARIABLE, variable_for};\n pub use error::ConfigError;\n pub use layer::{Layer, Merged, Origin, Setting, SettingPath, merge, unflatten, value_from_text};\n pub(crate) use relative::rebased;\n pub use relative::resolve_document_relative_paths;\n-pub use routes::{Placement, RepositoryPattern, Route, Routes, SourceRoute};\n+pub use routes::{Placement, RepositoryPattern, Route, RoutePurpose, Routes, SourceRoute};\n \n /// The variable that moves the credentials file somewhere else.\n pub const SECRETS_FILE_VARIABLE: &str = \"ONETASKGRAPH_SECRETS_FILE\";\n@@ -84,9 +84,17 @@ pub struct SourceConfig {\n     visibility: SourceVisibility,\n     cache: SourceCacheConfig,\n     public_alias: Option<onetaskgraph_plugin_api::Designator>,\n+    task_projection: Option<TaskProjectionConfig>,\n }\n \n impl SourceConfig {\n+    /// Where, and on which host's authority, human task projections into this source keep\n+    /// their durable intents — `None` for a source that receives none.\n+    #[must_use]\n+    pub fn task_projection(&self) -> Option<&TaskProjectionConfig> {\n+        self.task_projection.as_ref()\n+    }\n+\n     /// The designator `public_alias` declares, `alias/<public_alias>`, for a source whose\n     /// backend has no opaque identifier of its own: every host's configuration of the same\n     /// tracker declares the same alias, so an opaque edge written under one host's name for\n@@ -179,6 +187,28 @@ struct SourceShape {\n     /// repeats the value.\n     #[serde(default)]\n     public_alias: Option<Value>,\n+    #[serde(default)]\n+    task_projection: Option<TaskProjectionConfig>,\n+}\n+\n+/// A source's `task_projection`: the host-local authority over human task projections\n+/// written into it (see `docs/task-projection.md`).\n+///\n+/// One host is authoritative for a source's projections, and its intents live in one absolute\n+/// directory there; a process on another host is refused rather than arbitrating. `project` is\n+/// the existing project a session's or host's item lands under when its request names no plan\n+/// project.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]\n+#[serde(deny_unknown_fields)]\n+pub struct TaskProjectionConfig {\n+    /// The authoritative host, compared with `ONETASKGRAPH_HOST` or the machine's hostname.\n+    pub host: crate::task_projection::HostIdentity,\n+    /// The absolute directory holding the durable intents.\n+    #[schemars(with = \"String\")]\n+    pub directory: AbsoluteDirectory,\n+    /// The existing project of this source a planless item is filed under.\n+    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n+    pub project: Option<crate::task_projection::ProjectionProjectId>,\n }\n \n /// The designator a source's `public_alias` declares, refused when it is not a string matching\n@@ -228,6 +258,37 @@ pub struct SourceCacheConfig {\n     pub dir: Option<std::path::PathBuf>,\n }\n \n+/// An absolute directory, refused at load when a configuration gives a relative one.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(try_from = \"std::path::PathBuf\", into = \"std::path::PathBuf\")]\n+pub struct AbsoluteDirectory(std::path::PathBuf);\n+\n+impl AbsoluteDirectory {\n+    /// The directory.\n+    #[must_use]\n+    pub fn as_path(&self) -> &Path {\n+        &self.0\n+    }\n+}\n+\n+impl TryFrom<std::path::PathBuf> for AbsoluteDirectory {\n+    type Error = String;\n+\n+    fn try_from(path: std::path::PathBuf) -> Result<Self, Self::Error> {\n+        if path.is_absolute() {\n+            Ok(Self(path))\n+        } else {\n+            Err(format!(\"{} is not an absolute directory\", path.display()))\n+        }\n+    }\n+}\n+\n+impl From<AbsoluteDirectory> for std::path::PathBuf {\n+    fn from(directory: AbsoluteDirectory) -> Self {\n+        directory.0\n+    }\n+}\n+\n /// Who a configuration declares can read one source: `visibility` beside `plugin` and\n /// `config` in its entry.\n ///\n@@ -469,6 +530,7 @@ impl Config {\n                     visibility: source.visibility,\n                     cache: source.cache,\n                     public_alias,\n+                    task_projection: source.task_projection,\n                 },\n             );\n         }"},{"sha":"239593c314eb0faf5081ec8f44d44157370eecb5","filename":"crates/onetaskgraph-core/src/config/routes.rs","status":"modified","additions":105,"deletions":14,"changes":119,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fconfig%2Froutes.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fconfig%2Froutes.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fconfig%2Froutes.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -86,10 +86,56 @@ impl RepositoryPattern {\n /// One entry of a source's `routes`.\n #[derive(Debug, Clone, PartialEq, Eq)]\n pub struct Route {\n+    purpose: Option<RoutePurpose>,\n     matcher: Matcher,\n     to: SourceName,\n }\n \n+/// An operation's routing identity. Producers name their own purpose; legacy writers\n+/// leave it absent. A purpose is a nonempty lowercase identifier separated by hyphens.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]\n+#[serde(try_from = \"String\", into = \"String\")]\n+pub struct RoutePurpose(String);\n+\n+impl RoutePurpose {\n+    /// Validate a producer's routing identity.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses empty identifiers and segments containing anything but lowercase ASCII letters.\n+    pub fn new(value: impl Into<String>) -> Result<Self, String> {\n+        let value = value.into();\n+        if value\n+            .split('-')\n+            .all(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_lowercase()))\n+        {\n+            Ok(Self(value))\n+        } else {\n+            Err(\"a route purpose is lowercase words separated by hyphens\".to_owned())\n+        }\n+    }\n+\n+    /// The producer's identifier as written.\n+    #[must_use]\n+    pub fn as_str(&self) -> &str {\n+        &self.0\n+    }\n+}\n+\n+impl TryFrom<String> for RoutePurpose {\n+    type Error = String;\n+\n+    fn try_from(value: String) -> Result<Self, Self::Error> {\n+        Self::new(value)\n+    }\n+}\n+\n+impl From<RoutePurpose> for String {\n+    fn from(value: RoutePurpose) -> Self {\n+        value.0\n+    }\n+}\n+\n /// What one entry matches on: its repositories, its classification, or both together, so\n /// an entry naming neither cannot be held.\n #[derive(Debug, Clone, PartialEq, Eq)]\n@@ -104,6 +150,12 @@ enum Matcher {\n }\n \n impl Route {\n+    /// The operation this entry serves, or the legacy unscoped operation.\n+    #[must_use]\n+    pub fn purpose(&self) -> Option<&RoutePurpose> {\n+        self.purpose.as_ref()\n+    }\n+\n     /// The patterns, in the order written — empty for a classification entry.\n     #[must_use]\n     pub fn repositories(&self) -> &[RepositoryPattern] {\n@@ -221,6 +273,20 @@ impl Routes {\n         source: &SourceName,\n         classification: Classification,\n         repositories: &[Repository],\n+    ) -> Placement {\n+        self.place_for(source, classification, repositories, None)\n+    }\n+\n+    /// Place an item using only entries of the requested purpose. Visibility restrictions\n+    /// and matcher precedence are identical to legacy routing; a scoped entry never\n+    /// changes an unrelated writer's destination.\n+    #[must_use]\n+    pub fn place_for(\n+        &self,\n+        source: &SourceName,\n+        classification: Classification,\n+        repositories: &[Repository],\n+        purpose: Option<&RoutePurpose>,\n     ) -> Placement {\n         let entries: Vec<(usize, &Route)> = self\n             .0\n@@ -230,9 +296,10 @@ impl Routes {\n                     .iter()\n                     .enumerate()\n                     .filter(|(_, route)| {\n-                        classification.is_public()\n-                            || self.is_private(&route.to)\n-                            || self.2.contains(&route.to)\n+                        route.purpose.as_ref() == purpose\n+                            && (classification.is_public()\n+                                || self.is_private(&route.to)\n+                                || self.2.contains(&route.to))\n                     })\n                     .collect()\n             })\n@@ -290,24 +357,31 @@ impl Routes {\n         self\n     }\n \n-    /// Whether `source` declares any route.\n+    /// Whether `source` declares any legacy, unscoped route.\n     #[must_use]\n     pub fn routes(&self, source: &SourceName) -> bool {\n-        self.0.get(source).is_some_and(|routes| !routes.is_empty())\n+        self.of(source).iter().any(|route| route.purpose.is_none())\n     }\n \n-    /// Whether any source declares any route.\n+    /// Whether any source declares a legacy, unscoped route.\n     #[must_use]\n     pub fn any(&self) -> bool {\n-        self.0.values().any(|routes| !routes.is_empty())\n+        self.0\n+            .values()\n+            .flatten()\n+            .any(|route| route.purpose.is_none())\n     }\n \n     /// Every source an item written to `source` could land in: the source itself first,\n     /// then each distinct route target in the order its entries are written.\n     #[must_use]\n     pub fn reachable(&self, source: &SourceName) -> Vec<SourceName> {\n         let mut reachable = vec![source.clone()];\n-        for route in self.0.get(source).into_iter().flatten() {\n+        for route in self\n+            .of(source)\n+            .iter()\n+            .filter(|route| route.purpose.is_none())\n+        {\n             if !reachable.contains(&route.to) {\n                 reachable.push(route.to.clone());\n             }\n@@ -337,6 +411,7 @@ impl Routes {\n             for (index, (patterns, to)) in entries.into_iter().enumerate() {\n                 let key = entry_key(&source, index);\n                 parsed.push(Route {\n+                    purpose: None,\n                     matcher: Matcher::Repositories(patterns_of(&key, patterns)?),\n                     to,\n                 });\n@@ -366,6 +441,7 @@ impl Routes {\n         let mut classified: Vec<Route> = entries\n             .into_iter()\n             .map(|(classification, to)| Route {\n+                purpose: None,\n                 matcher: Matcher::Classification(classification),\n                 to,\n             })\n@@ -398,6 +474,7 @@ impl Routes {\n         for (index, (classification, patterns, to)) in entries.into_iter().enumerate() {\n             let key = entry_key(&source, index);\n             combined.push(Route {\n+                purpose: None,\n                 matcher: Matcher::Combined(classification, patterns_of(&key, patterns)?),\n                 to,\n             });\n@@ -488,18 +565,29 @@ fn parse_entry(key: &str, entry: &Value) -> Result<Route, ConfigError> {\n              `{classification: private, to: <source>}` or both matchers together.\",\n         ));\n     };\n-    if let Some(unknown) = fields\n-        .keys()\n-        .find(|field| ![\"repositories\", \"classification\", \"to\"].contains(&field.as_str()))\n-    {\n+    if let Some(unknown) = fields.keys().find(|field| {\n+        ![\"repositories\", \"classification\", \"to\", \"purpose\"].contains(&field.as_str())\n+    }) {\n         return Err(ConfigError::setting(\n             format!(\"{key}.{unknown}\"),\n             \"unknown field; a route holds `to` and `repositories`, `classification` or both, \\\n-             and nothing else\",\n+             with optional `purpose: human-task`\",\n             \"remove it.\",\n         ));\n     }\n     let to = destination_of(key, fields)?;\n+    let purpose = fields\n+        .get(\"purpose\")\n+        .map(|value| {\n+            serde_json::from_value::<RoutePurpose>(value.clone()).map_err(|error| {\n+                ConfigError::setting(\n+                    format!(\"{key}.purpose\"),\n+                    error.to_string(),\n+                    \"write `human-task` or omit purpose for legacy routing.\",\n+                )\n+            })\n+        })\n+        .transpose()?;\n     let classification = fields\n         .get(\"classification\")\n         .map(|classification| {\n@@ -517,6 +605,7 @@ fn parse_entry(key: &str, entry: &Value) -> Result<Route, ConfigError> {\n         .transpose()?;\n     if let (Some(classification), false) = (classification, fields.contains_key(\"repositories\")) {\n         return Ok(Route {\n+            purpose,\n             matcher: Matcher::Classification(classification),\n             to,\n         });\n@@ -552,6 +641,7 @@ fn parse_entry(key: &str, entry: &Value) -> Result<Route, ConfigError> {\n     };\n     let patterns = patterns_of(key, patterns)?;\n     Ok(Route {\n+        purpose,\n         matcher: match classification {\n             Some(classification) => Matcher::Combined(classification, patterns),\n             None => Matcher::Repositories(patterns),\n@@ -649,7 +739,7 @@ pub(super) fn check(routes: &Routes, configured: &[SourceName]) -> Result<(), Co\n                     \"name another source, or remove the entry.\",\n                 ));\n             }\n-            if routes.routes(&route.to) {\n+            if !routes.of(&route.to).is_empty() {\n                 return Err(ConfigError::setting(\n                     key,\n                     format!(\n@@ -742,6 +832,7 @@ mod tests {\n     #[test]\n     fn an_entry_matches_only_when_every_repository_does() {\n         let route = Route {\n+            purpose: None,\n             matcher: Matcher::Repositories(vec![\n                 RepositoryPattern::new(\"github.com/example-org/*\").unwrap(),\n             ]),"},{"sha":"a54fe5ec2ec444246f3551bf4560a18578d3e2a9","filename":"crates/onetaskgraph-core/src/engine/held_off.rs","status":"modified","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Fheld_off.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Fheld_off.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Fheld_off.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -182,6 +182,22 @@ impl TaskSource for HeldOff {\n         self.inner.prime_write(id, context, board)\n     }\n \n+    fn placement_context(&self) -> Option<Value> {\n+        self.inner.placement_context()\n+    }\n+\n+    fn prime_placement(&self, context: &Value) -> bool {\n+        self.inner.prime_placement(context)\n+    }\n+\n+    fn written_context(&self, id: &NativeId) -> Option<Value> {\n+        self.inner.written_context(id)\n+    }\n+\n+    fn prime_written(&self, id: &NativeId, context: &Value, task: &Task) -> bool {\n+        self.inner.prime_written(id, context, task)\n+    }\n+\n     fn unprime(&self, id: &NativeId) {\n         self.inner.unprime(id)\n     }"},{"sha":"96bd802de1a38b1b3ad188cd7f8e91de6b2a87b5","filename":"crates/onetaskgraph-core/src/engine/mod.rs","status":"modified","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Fmod.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Fmod.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Fmod.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -32,6 +32,7 @@ mod join;\n mod local;\n mod metadata;\n mod narrow;\n+mod projection;\n mod rendered;\n mod resume;\n mod stored;\n@@ -884,6 +885,21 @@ pub enum EngineError {\n         asset: String,\n     },\n \n+    /// A human task projection its durable intent, its routing or its tracker evidence does not\n+    /// authorize — nothing further was sent for it.\n+    #[error(\n+        \"human task projection {item_id:?} was refused: {message}\\n\\\n+         next: {next}\"\n+    )]\n+    ProjectionRefused {\n+        /// The request's external idempotency identity.\n+        item_id: String,\n+        /// Why it was refused.\n+        message: String,\n+        /// What resolves it.\n+        next: String,\n+    },\n+\n     /// `task create` or `document create` named a source whose plugin has no write side.\n     #[error(\n         \"source {name} cannot create a {record}: its plugin is {kind}, which has no write side\\n\\\n@@ -1671,6 +1687,8 @@ pub struct Engine {\n     copy_expect: std::sync::Mutex<Option<String>>,\n     /// Which tracker each source reads, as its configuration declares and its plugin answers.\n     designators: designators::Designators,\n+    /// Each source's human task projection authority, as its configuration declares it.\n+    projections: BTreeMap<SourceName, Result<crate::task_projection::ProjectionSource, String>>,\n }\n \n /// One operation's hold on every source's visibility reads, released when dropped — on every\n@@ -1752,6 +1770,7 @@ impl Engine {\n         ));\n         engine.caches = caches;\n         engine.designators = designators::Designators::configured(config);\n+        engine.projections = crate::task_projection::configured(config);\n         engine\n     }\n \n@@ -1789,6 +1808,7 @@ impl Engine {\n             caches: BTreeMap::new(),\n             copy_expect: std::sync::Mutex::new(None),\n             designators: designators::Designators::default(),\n+            projections: BTreeMap::new(),\n         }\n     }\n "},{"sha":"51723f46d5a5f424836b0154fe6f76e66c990381","filename":"crates/onetaskgraph-core/src/engine/projection.rs","status":"added","additions":492,"deletions":0,"changes":492,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Fprojection.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Fprojection.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Fprojection.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,492 @@\n+//! The engine's half of a human task projection: routing, screening and the tracker writes,\n+//! each held to the producer's durable intent (`crate::task_projection`).\n+//!\n+//! The intent is the authority, not this file: a create is sent only once the intent says one\n+//! may be, a pending create is bound only by one verified origin match, and a terminal write\n+//! is committed before it is sent. What this file owns is everything the existing write path\n+//! already decides — where an item routes, whether it may be written there, and what the\n+//! source is asked — with the reads a projection does not need left out: no whole-project\n+//! classification, no read back of what was written, and no read of a task this producer\n+//! wrote before when the ids it kept say where it is.\n+\n+use std::collections::BTreeMap;\n+\n+use onetaskgraph_plugin_api::{\n+    Classification, ItemWrite, MetadataKey, MetadataRecord, NativeId, PageRequest, Status,\n+    StatusCategory, Task, TaskQuery, TaskUpdate, WriteTarget,\n+};\n+use serde_json::Value;\n+\n+use super::boundary::{Exposure, Outbound};\n+use super::delivery::source_failed;\n+use super::{Engine, EngineError, ResolvedSource};\n+use crate::GlobalId;\n+use crate::task_projection::{\n+    HumanTaskProjected, HumanTaskProjection, IntentPhase, IntentStore, PlacementCache,\n+    ProjectedTaskId, ProjectionClaim, ProjectionError, ProjectionPlacement, ProjectionProjectId,\n+    ProjectionState, TrackerUrl, route_purpose,\n+};\n+\n+/// The metadata keys a projected task carries, read back by recovery.\n+const ITEM_ID_KEY: &str = \"human.item_id\";\n+const OWNER_KEY: &str = \"human.owner\";\n+const DIGEST_KEY: &str = \"human.payload_digest\";\n+const HOST_KEY: &str = \"human.host\";\n+/// A dismissal's reason, recorded only when the request gives one.\n+const REASON_KEY: &str = \"human.reason\";\n+\n+/// The most origin matches one recovery reads; a page holding more is ambiguous.\n+const RECOVERY_PAGE: u32 = 10;\n+\n+impl Engine {\n+    /// Project one human task: create it once, bind its canonical identity durably, and settle\n+    /// it at the terminal state the request names — or answer the binding already held.\n+    ///\n+    /// `current_host` is the host this process runs on; only the host a destination's\n+    /// `task_projection` names may project into it.\n+    ///\n+    /// # Errors\n+    ///\n+    /// [`EngineError::ProjectionRefused`] for a request its routing, its durable intent or the\n+    /// tracker's evidence does not authorize — a private item with no private route, a project\n+    /// of another source, another host, a changed payload, a conflicting terminal state, and a\n+    /// pending create with no single verified match — and the source's own refusal of a write.\n+    pub async fn project_human(\n+        &self,\n+        request: &HumanTaskProjection,\n+        current_host: &str,\n+    ) -> Result<HumanTaskProjected, EngineError> {\n+        let refused = |message: String, next: &str| EngineError::ProjectionRefused {\n+            item_id: request.item_id.to_string(),\n+            message,\n+            next: next.to_owned(),\n+        };\n+        self.built(&request.source)?;\n+        if request.reason.is_some() && request.state != ProjectionState::Dismissed {\n+            return Err(refused(\n+                \"a reason is recorded only for a dismissal\".to_owned(),\n+                \"send the reason with state dismissed, or send it as null.\",\n+            ));\n+        }\n+        // Who may read it is its repositories' answer while the boundary is active; it is\n+        // routed by that and by its repositories through the human-task entries alone.\n+        let classification = self\n+            .classify(Classification::Public, &request.repositories)\n+            .await;\n+        let destination = self\n+            .routes\n+            .place_for(\n+                &request.source,\n+                classification,\n+                &request.repositories,\n+                Some(&route_purpose()),\n+            )\n+            .destination;\n+        let item = format!(\"human task {:?}\", request.item_id.as_str());\n+        // A private item with no private route stays where it was sent, and is refused there:\n+        // nothing is ever written publicly in its place.\n+        self.refuse_private_landing(&destination, &item, classification)?;\n+        let settings = match self.projections.get(&destination) {\n+            Some(Ok(settings)) => settings,\n+            Some(Err(why)) => return Err(refused(why.clone(), \"project into a tracker source.\")),\n+            None => {\n+                return Err(refused(\n+                    format!(\"source {destination} declares no task_projection\"),\n+                    &format!(\n+                        \"declare sources.{destination}.task_projection with its host and \\\n+                         intent directory.\"\n+                    ),\n+                ));\n+            }\n+        };\n+        let project = match &request.project {\n+            Some(project) => match project.as_str().split_once(':') {\n+                Some((source, native)) if source == destination.as_str() => {\n+                    ProjectionProjectId::new(native)\n+                        .map_err(|why| refused(why, \"name a project.\"))?\n+                }\n+                Some((source, _)) => {\n+                    return Err(refused(\n+                        format!(\n+                            \"project {project} is in source {source}, but this item routes to \\\n+                             {destination}\"\n+                        ),\n+                        \"name the plan's project resolved in the source the item routes to; \\\n+                         nothing was written anywhere else.\",\n+                    ));\n+                }\n+                None => project.clone(),\n+            },\n+            None => settings.project.clone().ok_or_else(|| {\n+                refused(\n+                    format!(\n+                        \"the request names no project and source {destination} configures none\"\n+                    ),\n+                    &format!(\"set sources.{destination}.task_projection.project.\"),\n+                )\n+            })?,\n+        };\n+        let source = self.creatable(&destination, MetadataRecord::Task)?;\n+        let store = IntentStore::new(\n+            settings.directory.clone(),\n+            settings.host.as_str().to_owned(),\n+            current_host.to_owned(),\n+        )\n+        .map_err(|error| projection_refused(request, &error))?;\n+        let placement = ProjectionPlacement {\n+            identity: settings.identity.clone(),\n+            source: destination.clone(),\n+            project: project.clone(),\n+            classification,\n+        };\n+        let native_project = project.native_id();\n+        // Held to the destination's declaration and — while the boundary is active and the\n+        // destination is not declared private — to the caller's check, before the intent can\n+        // authorize anything.\n+        let task = projected_task(request, &project, classification, None);\n+        self.admit(\n+            source,\n+            &Outbound {\n+                item: item.clone(),\n+                classification,\n+                target: WriteTarget::New {\n+                    repositories: &request.repositories,\n+                    project: Some(&native_project),\n+                },\n+                exposure: &Exposure::of_task(&task),\n+            },\n+        )\n+        .await?;\n+        let mut claim = store\n+            .claim(request, &placement)\n+            .map_err(|error| projection_refused(request, &error))?;\n+        let task = projected_task(request, &project, classification, Some(&claim));\n+        match claim.phase() {\n+            IntentPhase::Bound => {}\n+            IntentPhase::Creating => {\n+                let matches = self.origin_matches(source, claim.origin()).await?;\n+                claim\n+                    .reconcile(request, &matches)\n+                    .map_err(|error| projection_refused(request, &error))?;\n+                // The match this process just read is what a later terminal write takes instead\n+                // of reading it again, exactly as a create's own answer is.\n+                if let Some(binding) = claim.binding().cloned() {\n+                    let written = source\n+                        .source()\n+                        .written_context(&binding.task().global_id().native);\n+                    claim\n+                        .bind_written(binding, written)\n+                        .map_err(|error| projection_refused(request, &error))?;\n+                }\n+            }\n+            IntentPhase::Ready | IntentPhase::Uncertain => {\n+                self.create_projection(source, &mut claim, request, &task)\n+                    .await?;\n+            }\n+        }\n+        if request.state != ProjectionState::Open {\n+            self.settle_projection(source, &item, &mut claim, request, &task)\n+                .await?;\n+        }\n+        claim\n+            .binding()\n+            .cloned()\n+            .ok_or_else(|| refused(\"no binding was committed\".to_owned(), \"project it again.\"))\n+    }\n+\n+    /// Send the one create the intent authorizes, and bind what it returned.\n+    async fn create_projection(\n+        &self,\n+        source: &ResolvedSource,\n+        claim: &mut ProjectionClaim,\n+        request: &HumanTaskProjection,\n+        task: &Task,\n+    ) -> Result<(), EngineError> {\n+        let kept = self\n+            .projections\n+            .get(&claim.placement().source)\n+            .and_then(|settings| settings.as_ref().ok())\n+            .and_then(|settings| settings.placement.clone());\n+        if let Some(context) = kept\n+            .as_ref()\n+            .map(PlacementCache::read)\n+            .transpose()\n+            .map_err(|error| projection_refused(request, &error))?\n+            .flatten()\n+        {\n+            source.source().prime_placement(&context);\n+        }\n+        claim\n+            .begin_create()\n+            .map_err(|error| projection_refused(request, &error))?;\n+        let write = ItemWrite {\n+            target: None,\n+            item: task.clone(),\n+            depends_on: Vec::new(),\n+        };\n+        let id = match source.source().write_task(&write).await {\n+            Ok(id) => id,\n+            Err(error) => {\n+                // What it held may be what the tracker refused; the next create reads afresh.\n+                if let Some(kept) = &kept {\n+                    let _ = kept.forget();\n+                }\n+                return Err(source_failed(source, error));\n+            }\n+        };\n+        if let (Some(kept), Some(context)) = (&kept, source.source().placement_context()) {\n+            let _ = kept.keep(&context);\n+        }\n+        let written = source.source().written_context(&id);\n+        let url = match source\n+            .source()\n+            .written_location(MetadataRecord::Task, &id)\n+            .and_then(|location| match location {\n+                onetaskgraph_plugin_api::Location::Url(url) => Some(url),\n+                onetaskgraph_plugin_api::Location::Path(_) => None,\n+            }) {\n+            Some(url) => url,\n+            None => {\n+                // The create's answer named no address, so the tracker is asked: what this process\n+                // remembers of its own write knows no more than that answer did.\n+                source\n+                    .source()\n+                    .end_command()\n+                    .await\n+                    .map_err(|error| source_failed(source, error))?;\n+                source\n+                    .source()\n+                    .get_task(&id)\n+                    .await\n+                    .map_err(|error| source_failed(source, error))?\n+                    .and_then(|task| task.url)\n+                    .unwrap_or_default()\n+            }\n+        };\n+        let placement = claim.placement().clone();\n+        let binding = HumanTaskProjected::new(\n+            ProjectedTaskId::try_from(GlobalId::new(placement.source.clone(), id.clone()))\n+                .map_err(|why| refused_by(request, why, \"inspect the tracker.\"))?,\n+            TrackerUrl::new(url).map_err(|why| {\n+                refused_by(\n+                    request,\n+                    format!(\n+                        \"the tracker answered the create of {id} without a canonical URL: {why}\"\n+                    ),\n+                    \"inspect the tracker; the created task is reconciled by its origin.\",\n+                )\n+            })?,\n+            placement.project,\n+        );\n+        claim\n+            .bind_written(binding, written)\n+            .map_err(|error| projection_refused(request, &error))\n+    }\n+\n+    /// Every task of `source` carrying `origin`, read once and held to the origin exactly.\n+    async fn origin_matches(\n+        &self,\n+        source: &ResolvedSource,\n+        origin: &str,\n+    ) -> Result<Vec<Task>, EngineError> {\n+        let page = source\n+            .source()\n+            .query_tasks(\n+                &TaskQuery {\n+                    origin: Some(origin.to_owned()),\n+                    ..TaskQuery::default()\n+                },\n+                &PageRequest {\n+                    cursor: None,\n+                    limit: RECOVERY_PAGE,\n+                },\n+            )\n+            .await\n+            .map_err(|error| source_failed(source, error))?;\n+        let mut matches: Vec<Task> = page\n+            .items\n+            .into_iter()\n+            .filter(|task| {\n+                task.metadata\n+                    .get(GlobalId::ORIGIN_KEY)\n+                    .and_then(Value::as_str)\n+                    == Some(origin)\n+            })\n+            .collect();\n+        // A page with more behind it is not a whole answer, so it cannot be one match.\n+        if page.next.is_some() && matches.len() == 1 {\n+            matches.push(matches[0].clone());\n+        }\n+        Ok(matches)\n+    }\n+\n+    /// Write the terminal state the request names, once, after committing it.\n+    async fn settle_projection(\n+        &self,\n+        source: &ResolvedSource,\n+        item: &str,\n+        claim: &mut ProjectionClaim,\n+        request: &HumanTaskProjection,\n+        task: &Task,\n+    ) -> Result<(), EngineError> {\n+        let resumed = claim.terminal_committed();\n+        claim\n+            .begin_terminal(request.state, request.reason.clone())\n+            .map_err(|error| projection_refused(request, &error))?;\n+        if claim.terminal_acknowledged() {\n+            return Ok(());\n+        }\n+        let binding = claim\n+            .binding()\n+            .cloned()\n+            .ok_or_else(|| refused_by(request, \"no task is bound\".to_owned(), \"project it.\"))?;\n+        let id = binding.task().global_id().native;\n+        let update = terminal_update(request);\n+        self.admit_update(source, item, &id, &update).await?;\n+        // A terminal write whose answer was lost may have landed whole, in part or not at all:\n+        // the update then reads the task as it stands and writes only what still differs.\n+        if !resumed && let Some(context) = claim.written_context() {\n+            // The terminal state is the issue's own — its status and its closure — so the ids this\n+            // producer kept are all the write needs. A reason is recorded against the body as it\n+            // stands now, which the source reads before composing it — never against a copy of the\n+            // body this producer wrote.\n+            let mut held = task.clone();\n+            held.id.clone_from(&id);\n+            source.source().prime_written(&id, context, &held);\n+        }\n+        source\n+            .source()\n+            .update_task(&id, &update)\n+            .await\n+            .map_err(|error| source_failed(source, error))?\n+            .ok_or_else(|| {\n+                refused_by(\n+                    request,\n+                    format!(\"bound task {} is no longer in the tracker\", binding.task()),\n+                    \"inspect the tracker and reconcile the projection by hand.\",\n+                )\n+            })?;\n+        claim\n+            .acknowledge_terminal()\n+            .map_err(|error| projection_refused(request, &error))\n+    }\n+\n+    /// Hold a terminal update of a task already written to the destination's declaration and\n+    /// the caller's check, as every other narrow write is held.\n+    async fn admit_update(\n+        &self,\n+        source: &ResolvedSource,\n+        item: &str,\n+        id: &NativeId,\n+        update: &TaskUpdate,\n+    ) -> Result<(), EngineError> {\n+        let exposure = Exposure::of_update(update);\n+        self.preflight(\n+            source,\n+            &Outbound {\n+                item: item.to_owned(),\n+                classification: Classification::Public,\n+                target: WriteTarget::Existing(id),\n+                exposure: &exposure,\n+            },\n+        )\n+        .await\n+    }\n+}\n+\n+/// The task a projection creates: open, with its identity, owner and origin in its metadata\n+/// so a recovery can verify it from the tracker alone.\n+fn projected_task(\n+    request: &HumanTaskProjection,\n+    project: &ProjectionProjectId,\n+    classification: Classification,\n+    claim: Option<&ProjectionClaim>,\n+) -> Task {\n+    let mut metadata = BTreeMap::new();\n+    metadata.insert(\n+        ITEM_ID_KEY.to_owned(),\n+        Value::from(request.item_id.as_str()),\n+    );\n+    metadata.insert(\n+        OWNER_KEY.to_owned(),\n+        serde_json::to_value(&request.owner).unwrap_or(Value::Null),\n+    );\n+    if let Some(claim) = claim {\n+        metadata.insert(GlobalId::ORIGIN_KEY.to_owned(), Value::from(claim.origin()));\n+        metadata.insert(DIGEST_KEY.to_owned(), Value::from(claim.payload_digest()));\n+        metadata.insert(HOST_KEY.to_owned(), Value::from(claim.host()));\n+    }\n+    Task {\n+        version: None,\n+        id: NativeId::from(\"human-task\"),\n+        key: None,\n+        title: request.title.as_str().to_owned(),\n+        content: Some(request.body.clone()),\n+        status: Status {\n+            category: StatusCategory::Todo,\n+            name: \"todo\".to_owned(),\n+        },\n+        priority: request.priority,\n+        labels: Vec::new(),\n+        project: Some(project.native_id()),\n+        url: None,\n+        location: None,\n+        created_at: None,\n+        updated_at: None,\n+        metadata,\n+        repositories: request.repositories.clone(),\n+        delivers: Vec::new(),\n+        delivered_by: Vec::new(),\n+        classification,\n+    }\n+}\n+\n+/// The category a terminal state lands in.\n+fn terminal_category(state: ProjectionState) -> StatusCategory {\n+    match state {\n+        ProjectionState::Completed => StatusCategory::Done,\n+        ProjectionState::Dismissed | ProjectionState::Open => StatusCategory::Cancelled,\n+    }\n+}\n+\n+/// The one update a terminal projection writes: its status — which closes the issue as its\n+/// category says — and, only when the request gave one, its reason. An absent reason stays\n+/// absent.\n+fn terminal_update(request: &HumanTaskProjection) -> TaskUpdate {\n+    let category = terminal_category(request.state);\n+    let mut metadata_set = BTreeMap::new();\n+    if let Some(reason) = &request.reason {\n+        metadata_set.insert(\n+            MetadataKey::new(REASON_KEY.to_owned()).expect(\"a literal human key\"),\n+            Value::from(reason.as_str()),\n+        );\n+    }\n+    TaskUpdate {\n+        status: Some(Status {\n+            category,\n+            name: serde_json::to_value(category)\n+                .ok()\n+                .and_then(|word| word.as_str().map(str::to_owned))\n+                .unwrap_or_default(),\n+        }),\n+        metadata_set,\n+        ..TaskUpdate::default()\n+    }\n+}\n+\n+fn projection_refused(request: &HumanTaskProjection, error: &ProjectionError) -> EngineError {\n+    refused_by(\n+        request,\n+        error.to_string(),\n+        \"inspect the tracker for the item's origin and reconcile its intent; no second create \\\n+         was sent.\",\n+    )\n+}\n+\n+fn refused_by(request: &HumanTaskProjection, message: String, next: &str) -> EngineError {\n+    EngineError::ProjectionRefused {\n+        item_id: request.item_id.to_string(),\n+        message,\n+        next: next.to_owned(),\n+    }\n+}"},{"sha":"8f5833e07442e88cf7b4419760dfb46c9cc924ed","filename":"crates/onetaskgraph-core/src/engine/rendered.rs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Frendered.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Frendered.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fengine%2Frendered.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1654,7 +1654,7 @@ impl Engine {\n     }\n \n     /// The built source called `name`, when it can be written through.\n-    fn creatable(\n+    pub(super) fn creatable(\n         &self,\n         name: &SourceName,\n         record: MetadataRecord,"},{"sha":"c2d2256e4409096935d233b775c802699962fc9e","filename":"crates/onetaskgraph-core/src/failure.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Ffailure.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Ffailure.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Ffailure.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -286,6 +286,7 @@ fn cause(error: &EngineError) -> (String, Option<SourceName>, Option<&SourceErro\n         EngineError::UnrecordedMember { .. } => (\"unrecorded-member\".to_owned(), None, None),\n         EngineError::Misrouted { .. } => (\"misrouted\".to_owned(), None, None),\n         EngineError::SplitPrivateHome { .. } => (\"split-private-home\".to_owned(), None, None),\n+        EngineError::ProjectionRefused { .. } => (\"projection-refused\".to_owned(), None, None),\n         EngineError::NotPrivateDestination { destination, .. } => (\n             \"not-private-destination\".to_owned(),\n             configured(destination),"},{"sha":"6644e965ed9ab50b6f5835abc8266ba060027a00","filename":"crates/onetaskgraph-core/src/lib.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Flib.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Flib.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Flib.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -42,6 +42,7 @@ mod resolve;\n mod schema;\n mod secrets;\n pub mod subprocess;\n+pub mod task_projection;\n // llmlint: ignore[code_lands_in_the_domain_that_owns_it] The task that introduced templates fixes their API at this crate's root; the head of `template/mod.rs` states why.\n pub mod template;\n pub mod version;"},{"sha":"a30e0557ea7f3d52f7aa4f9e9563fdadee26a1c6","filename":"crates/onetaskgraph-core/src/schema.rs","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fschema.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Fschema.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Fschema.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -54,14 +54,16 @@ use crate::{\n /// that it moves whenever [`schema_bundle`] below emits a different document. The golden\n /// that holds it to that is `PUBLISHED_BUNDLES` in `tests/engine.rs`, which records every\n /// root's schema by digest from this version on.\n-pub const SCHEMA_BUNDLE_VERSION: u32 = 49;\n+pub const SCHEMA_BUNDLE_VERSION: u32 = 50;\n \n /// Every contract root, keyed by name, plus each registered plugin's config schema.\n #[must_use]\n pub fn schema_bundle() -> Value {\n     let mut roots: BTreeMap<&'static str, Schema> = BTreeMap::new();\n \n     roots.insert(\"Task\", schema_for!(Task));\n+    // llmlint: ignore[code_lands_in_the_domain_that_owns_it] The repository deliberately centralizes every schema root beside its append-only version golden. This single line registers the projection domain's own list; its declarations and schema derivation remain in that domain.\n+    roots.extend(crate::task_projection::schemas());\n     roots.insert(\"Project\", schema_for!(Project));\n     roots.insert(\"Document\", schema_for!(Document));\n     // A root of its own although both `Task` and `Project` reach it inside their own"},{"sha":"de0efa24794d3d9d6f033d58e34d587d87180561","filename":"crates/onetaskgraph-core/src/task_projection/identity.rs","status":"added","additions":246,"deletions":0,"changes":246,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Ftask_projection%2Fidentity.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Ftask_projection%2Fidentity.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Ftask_projection%2Fidentity.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,246 @@\n+//! Validated producer identities serialize as the fixed v1 string fields.\n+\n+// llmlint: ignore-file[code_lands_in_the_domain_that_owns_it] The repository keeps core domains as submodules of the core crate and its one Nx project, including config, cache and template. These projection-owned identities follow that same boundary; they are not shared routing vocabulary or a second producer contract.\n+\n+use schemars::{JsonSchema, Schema, SchemaGenerator};\n+use serde::{Deserialize, Serialize};\n+\n+macro_rules! identity {\n+    ($name:ident, $description:literal, $validate:ident) => {\n+        #[doc = $description]\n+        #[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n+        #[serde(try_from = \"String\", into = \"String\")]\n+        pub struct $name(String);\n+\n+        impl $name {\n+            /// Validate an identity without changing its wire spelling.\n+            ///\n+            /// # Errors\n+            ///\n+            /// Refuses an identity that does not meet this type's invariants.\n+            pub fn new(value: impl Into<String>) -> Result<Self, String> {\n+                let value = value.into();\n+                $validate(&value)?;\n+                Ok(Self(value))\n+            }\n+\n+            /// The validated wire spelling.\n+            #[must_use]\n+            pub fn as_str(&self) -> &str {\n+                &self.0\n+            }\n+        }\n+\n+        impl TryFrom<String> for $name {\n+            type Error = String;\n+\n+            fn try_from(value: String) -> Result<Self, Self::Error> {\n+                Self::new(value)\n+            }\n+        }\n+\n+        impl From<$name> for String {\n+            fn from(value: $name) -> Self {\n+                value.0\n+            }\n+        }\n+\n+        impl std::fmt::Display for $name {\n+            fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+                formatter.write_str(self.as_str())\n+            }\n+        }\n+\n+        // The published v1 schema spells these identities as strings. Validation belongs\n+        // at deserialization without changing that frozen consumer schema.\n+        impl JsonSchema for $name {\n+            fn inline_schema() -> bool {\n+                true\n+            }\n+\n+            fn schema_name() -> std::borrow::Cow<'static, str> {\n+                String::schema_name()\n+            }\n+\n+            fn json_schema(generator: &mut SchemaGenerator) -> Schema {\n+                String::json_schema(generator)\n+            }\n+        }\n+    };\n+}\n+\n+identity!(\n+    ExternalItemId,\n+    \"A producer's stable external idempotency identity.\",\n+    nonempty\n+);\n+identity!(\n+    SessionId,\n+    \"The identity of the producer session that owns an intent.\",\n+    nonempty\n+);\n+identity!(\n+    RunId,\n+    \"The identity of the producer run, when one owns the item.\",\n+    nonempty\n+);\n+identity!(\n+    PlanId,\n+    \"The identity of the producer plan, when one owns the item.\",\n+    nonempty\n+);\n+identity!(\n+    ProjectionProjectId,\n+    \"A resolved tracker project identity.\",\n+    nonempty\n+);\n+identity!(\n+    ProjectedTaskId,\n+    \"A validated source-qualified tracker task identity.\",\n+    qualified_task\n+);\n+identity!(\n+    TrackerUrl,\n+    \"An absolute HTTPS tracker URL suitable for a clickable card.\",\n+    tracker_url\n+);\n+\n+identity!(\n+    SourceIdentityDigest,\n+    \"The cache's lowercase SHA-256 source identity digest.\",\n+    source_digest\n+);\n+\n+identity!(\n+    HostIdentity,\n+    \"A validated local projection authority host identity.\",\n+    host_identity\n+);\n+identity!(\n+    PayloadDigest,\n+    \"The immutable projection payload and placement digest.\",\n+    source_digest\n+);\n+identity!(\n+    ProjectionOrigin,\n+    \"A stable human task origin naming its host and claim key.\",\n+    projection_origin\n+);\n+\n+fn host_identity(value: &str) -> Result<(), String> {\n+    if !value.is_empty()\n+        && value\n+            .bytes()\n+            .all(|byte| byte.is_ascii_alphanumeric() || b\"._-\".contains(&byte))\n+    {\n+        Ok(())\n+    } else {\n+        Err(\"a host identity uses ASCII letters, digits, dots, underscores and hyphens\".to_owned())\n+    }\n+}\n+\n+fn projection_origin(value: &str) -> Result<(), String> {\n+    let mut parts = value.split(':');\n+    if parts.next() != Some(\"human-task\") {\n+        return Err(\"a projection origin starts with human-task\".to_owned());\n+    }\n+    host_identity(\n+        parts\n+            .next()\n+            .ok_or(\"an origin requires its authoritative host\")?,\n+    )?;\n+    source_digest(parts.next().ok_or(\"an origin requires its claim digest\")?)?;\n+    if parts.next().is_some() {\n+        return Err(\"an origin has exactly a purpose, host and claim digest\".to_owned());\n+    }\n+    Ok(())\n+}\n+\n+fn source_digest(value: &str) -> Result<(), String> {\n+    if value.len() == 64\n+        && value\n+            .bytes()\n+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))\n+    {\n+        Ok(())\n+    } else {\n+        Err(\"a source identity must be a lowercase SHA-256 digest\".to_owned())\n+    }\n+}\n+\n+identity!(\n+    ProjectionTitle,\n+    \"A nonblank task title, preserved in its supplied wire spelling.\",\n+    nonblank_title\n+);\n+\n+fn nonblank_title(value: &str) -> Result<(), String> {\n+    if value.trim().is_empty() {\n+        Err(\"a projected task title must be nonempty\".to_owned())\n+    } else {\n+        Ok(())\n+    }\n+}\n+\n+fn nonempty(value: &str) -> Result<(), String> {\n+    if value.is_empty() || value.trim() != value || value.chars().any(char::is_control) {\n+        Err(\n+            \"an identity must be nonempty with no surrounding whitespace or control characters\"\n+                .to_owned(),\n+        )\n+    } else {\n+        Ok(())\n+    }\n+}\n+\n+fn qualified_task(value: &str) -> Result<(), String> {\n+    nonempty(value)?;\n+    value\n+        .parse::<crate::GlobalId>()\n+        .map(|_| ())\n+        .map_err(|error| error.to_string())\n+}\n+\n+fn tracker_url(value: &str) -> Result<(), String> {\n+    if value\n+        .chars()\n+        .any(|character| character.is_whitespace() || character.is_control())\n+    {\n+        return Err(\"a tracker URL cannot contain whitespace\".to_owned());\n+    }\n+    let parsed = url::Url::parse(value).map_err(|error| error.to_string())?;\n+    if parsed.scheme() != \"https\"\n+        || !parsed.has_host()\n+        || !parsed.username().is_empty()\n+        || parsed.password().is_some()\n+    {\n+        return Err(\"a tracker URL must be absolute HTTPS without embedded credentials\".to_owned());\n+    }\n+    Ok(())\n+}\n+\n+impl ProjectedTaskId {\n+    /// The engine's validated qualified identity.\n+    #[must_use]\n+    pub fn global_id(&self) -> crate::GlobalId {\n+        self.as_str()\n+            .parse()\n+            .expect(\"the constructor validated the qualified identity\")\n+    }\n+}\n+\n+impl TryFrom<crate::GlobalId> for ProjectedTaskId {\n+    type Error = String;\n+\n+    fn try_from(value: crate::GlobalId) -> Result<Self, Self::Error> {\n+        Self::new(value.to_string())\n+    }\n+}\n+\n+impl ProjectionProjectId {\n+    /// The existing plugin API's native project identity.\n+    #[must_use]\n+    pub fn native_id(&self) -> onetaskgraph_plugin_api::NativeId {\n+        onetaskgraph_plugin_api::NativeId(self.as_str().to_owned())\n+    }\n+}"},{"sha":"3c5e076b156a5c29cf03bcf1d6bc175838d4751d","filename":"crates/onetaskgraph-core/src/task_projection/intent.rs","status":"added","additions":789,"deletions":0,"changes":789,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Ftask_projection%2Fintent.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Ftask_projection%2Fintent.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Ftask_projection%2Fintent.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,789 @@\n+//! The producer's durable create intent and binding. No tracker client lives here.\n+// llmlint: ignore-file[code_lands_in_the_domain_that_owns_it] Config, cache and template establish this repository's core-domain convention: a submodule of onetaskgraph-core, not an Nx project for each concern. This producer-owned journal belongs to the task-projection submodule under that same convention, alongside its sole public wire declaration.\n+\n+use std::fs::{self, File, OpenOptions};\n+use std::io::Write as _;\n+use std::path::{Path, PathBuf};\n+\n+use onetaskgraph_plugin_api::{Classification, SourceName, Task};\n+use serde::{Deserialize, Serialize};\n+use sha2::{Digest as _, Sha256};\n+\n+use super::identity::{HostIdentity, PayloadDigest, ProjectionOrigin};\n+use super::{\n+    ExternalItemId, HumanTaskProjected, HumanTaskProjection, ProjectedTaskId, ProjectionProjectId,\n+    ProjectionState, SourceIdentityDigest, TrackerUrl,\n+};\n+use crate::GlobalId;\n+\n+/// A failure to establish a safe durable projection.\n+#[derive(Debug, thiserror::Error)]\n+pub enum ProjectionError {\n+    /// The intent or tracker evidence does not authorize this operation.\n+    #[error(\"human task projection refused: {0}\")]\n+    Refused(String),\n+    /// The durable store could not be read or committed.\n+    #[error(\"human task projection durable store: {0}\")]\n+    Io(#[from] std::io::Error),\n+    /// A journal or request could not be serialized.\n+    #[error(\"human task projection journal: {0}\")]\n+    Json(#[from] serde_json::Error),\n+}\n+\n+/// Placement validated through the engine before the create intent is committed.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+pub struct ProjectionPlacement {\n+    /// The same source identity digest used by the remote source's local cache.\n+    pub identity: SourceIdentityDigest,\n+    /// The resolved configured source.\n+    pub source: SourceName,\n+    /// The existing resolved member project.\n+    pub project: ProjectionProjectId,\n+    /// The privacy classification the write was admitted under.\n+    pub classification: Classification,\n+}\n+\n+/// The phase that determines whether sending a create is still permitted.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum IntentPhase {\n+    /// No create has been authorized for transmission.\n+    Ready,\n+    /// A create may have reached the tracker; only positive reconciliation can bind it.\n+    Creating,\n+    /// A canonical tracker identity has been committed.\n+    Bound,\n+    /// A failed durable commit requires reopening the claim before any tracker write.\n+    Uncertain,\n+}\n+\n+/// A terminal projection's outcome: only a dismissal carries a reason, and an absent one stays\n+/// absent.\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+enum Outcome {\n+    Completed,\n+    Dismissed(Option<String>),\n+}\n+\n+impl Outcome {\n+    /// The outcome `state` and `reason` name, refused for an open state and for a reason beside\n+    /// a completion.\n+    fn of(state: ProjectionState, reason: Option<String>) -> Result<Self, ProjectionError> {\n+        match (state, reason) {\n+            (ProjectionState::Completed, None) => Ok(Self::Completed),\n+            (ProjectionState::Completed, Some(_)) => {\n+                Err(refused(\"a reason is recorded only for a dismissal\"))\n+            }\n+            (ProjectionState::Dismissed, reason) => Ok(Self::Dismissed(reason)),\n+            (ProjectionState::Open, _) => Err(refused(\"an open state is not a terminal intent\")),\n+        }\n+    }\n+}\n+\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(from = \"bool\", into = \"bool\")]\n+enum Acknowledgment {\n+    Pending,\n+    Acknowledged,\n+}\n+\n+impl From<bool> for Acknowledgment {\n+    fn from(acknowledged: bool) -> Self {\n+        if acknowledged {\n+            Self::Acknowledged\n+        } else {\n+            Self::Pending\n+        }\n+    }\n+}\n+\n+impl From<Acknowledgment> for bool {\n+    fn from(acknowledgment: Acknowledgment) -> Self {\n+        acknowledgment == Acknowledgment::Acknowledged\n+    }\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(try_from = \"StoredTerminal\", into = \"StoredTerminal\")]\n+struct Terminal {\n+    outcome: Outcome,\n+    acknowledged: Acknowledgment,\n+}\n+\n+/// A terminal intent as the journal spells it.\n+#[derive(Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+struct StoredTerminal {\n+    state: ProjectionState,\n+    reason: Option<String>,\n+    acknowledged: Acknowledgment,\n+}\n+\n+impl TryFrom<StoredTerminal> for Terminal {\n+    type Error = String;\n+\n+    fn try_from(stored: StoredTerminal) -> Result<Self, Self::Error> {\n+        Ok(Self {\n+            outcome: Outcome::of(stored.state, stored.reason).map_err(|error| error.to_string())?,\n+            acknowledged: stored.acknowledged,\n+        })\n+    }\n+}\n+\n+impl From<Terminal> for StoredTerminal {\n+    fn from(terminal: Terminal) -> Self {\n+        let (state, reason) = match terminal.outcome {\n+            Outcome::Completed => (ProjectionState::Completed, None),\n+            Outcome::Dismissed(reason) => (ProjectionState::Dismissed, reason),\n+        };\n+        Self {\n+            state,\n+            reason,\n+            acknowledged: terminal.acknowledged,\n+        }\n+    }\n+}\n+\n+#[derive(Debug, Serialize, Deserialize)]\n+#[serde(tag = \"kind\", rename_all = \"kebab-case\", deny_unknown_fields)]\n+enum Phase {\n+    #[serde(skip)]\n+    Uncertain {},\n+    Ready {},\n+    Creating {},\n+    Bound {\n+        binding: HumanTaskProjected,\n+        terminal: Option<Terminal>,\n+        /// The ids — never the title or the content — the source gave for the task it wrote,\n+        /// which a later terminal write takes instead of reading the task again.\n+        #[serde(default, skip_serializing_if = \"Option::is_none\")]\n+        written: Option<serde_json::Value>,\n+    },\n+}\n+\n+#[derive(Debug, Clone, Copy, Serialize, Deserialize)]\n+#[serde(try_from = \"u32\", into = \"u32\")]\n+struct JournalVersion;\n+\n+impl TryFrom<u32> for JournalVersion {\n+    type Error = String;\n+\n+    fn try_from(version: u32) -> Result<Self, Self::Error> {\n+        if version == 1 {\n+            Ok(Self)\n+        } else {\n+            Err(format!(\"unsupported projection journal version {version}\"))\n+        }\n+    }\n+}\n+\n+impl From<JournalVersion> for u32 {\n+    fn from(_: JournalVersion) -> Self {\n+        1\n+    }\n+}\n+\n+#[derive(Debug, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+struct Journal {\n+    schema_version: JournalVersion,\n+    item_id: ExternalItemId,\n+    host: HostIdentity,\n+    origin: ProjectionOrigin,\n+    payload_digest: PayloadDigest,\n+    placement: ProjectionPlacement,\n+    phase: Phase,\n+}\n+\n+/// A source's kept placement: the immutable knowledge of where it creates — field and\n+/// repository ids under the plugin's setup-context token — in the store's per-host local cache\n+/// for that source, keyed by its source identity as the cache's own directory is.\n+///\n+/// It holds no item's title, content or membership and authorizes nothing: the plugin takes it\n+/// only while its token, computed from a read the create makes anyway, still holds.\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct PlacementCache {\n+    path: PathBuf,\n+}\n+\n+impl PlacementCache {\n+    /// The kept placement at `path`, the source's cache directory's `placement.json`.\n+    #[must_use]\n+    pub fn at(path: PathBuf) -> Self {\n+        Self { path }\n+    }\n+\n+    /// What was kept, when anything readable was: a context that is not JSON reads as none.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses a cache that cannot be read.\n+    pub fn read(&self) -> Result<Option<serde_json::Value>, ProjectionError> {\n+        match fs::read(&self.path) {\n+            Ok(bytes) => Ok(serde_json::from_slice(&bytes).ok()),\n+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),\n+            Err(error) => Err(error.into()),\n+        }\n+    }\n+\n+    /// Keep `context` in place of what was kept, atomically.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses a cache that cannot be written.\n+    pub fn keep(&self, context: &serde_json::Value) -> Result<(), ProjectionError> {\n+        let directory = self\n+            .path\n+            .parent()\n+            .ok_or_else(|| refused(\"a kept placement needs a directory\"))?;\n+        create_directories(directory)?;\n+        let name = self\n+            .path\n+            .file_name()\n+            .and_then(|name| name.to_str())\n+            .unwrap_or(\"placement.json\");\n+        let temporary = directory.join(format!(\"{name}.{}.pending\", std::process::id()));\n+        let mut file = private_options()\n+            .create(true)\n+            .truncate(true)\n+            .write(true)\n+            .open(&temporary)?;\n+        file.write_all(&serde_json::to_vec(context)?)?;\n+        file.sync_all()?;\n+        fs::rename(temporary, &self.path)?;\n+        sync_directory(directory)?;\n+        Ok(())\n+    }\n+\n+    /// Forget what was kept, so the next create reads its placement afresh.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses a cache that cannot be written.\n+    pub fn forget(&self) -> Result<(), ProjectionError> {\n+        match fs::remove_file(&self.path) {\n+            Ok(()) => Ok(()),\n+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),\n+            Err(error) => Err(error.into()),\n+        }\n+    }\n+}\n+\n+/// The local authoritative intent store, shared by processes on one host.\n+///\n+/// The caller obtains its host and directory from host-local configuration. This store\n+/// never arbitrates across hosts; an explicit authority mismatch refuses before a new\n+/// intent can be written.\n+#[derive(Debug)]\n+pub struct IntentStore {\n+    directory: PathBuf,\n+    host: HostIdentity,\n+    current_host: HostIdentity,\n+}\n+\n+impl IntentStore {\n+    /// Select the authoritative host and its durable directory.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses an invalid host identity or a relative intent directory.\n+    pub fn new(\n+        directory: PathBuf,\n+        host: String,\n+        current_host: String,\n+    ) -> Result<Self, ProjectionError> {\n+        if !directory.is_absolute() {\n+            return Err(refused(\n+                \"task_projection requires an absolute intent directory\",\n+            ));\n+        }\n+        Ok(Self {\n+            directory,\n+            host: HostIdentity::new(host).map_err(refused)?,\n+            current_host: HostIdentity::new(current_host).map_err(refused)?,\n+        })\n+    }\n+\n+    /// Lock one source identity and external item id, then commit or load its intent.\n+    ///\n+    /// The lock remains held until the returned claim is dropped. A crash releases the\n+    /// operating system lock but cannot erase a committed Creating phase.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses a foreign host, malformed journal, changed payload/placement, or a terminal\n+    /// projection that conflicts with an earlier terminal intent.\n+    pub fn claim(\n+        &self,\n+        request: &HumanTaskProjection,\n+        placement: &ProjectionPlacement,\n+    ) -> Result<ProjectionClaim, ProjectionError> {\n+        if self.current_host != self.host {\n+            return Err(refused(format!(\n+                \"current host {:?} is not authoritative host {:?}; inspect sources.{}.task_projection\",\n+                self.current_host.as_str(),\n+                self.host.as_str(),\n+                placement.source\n+            )));\n+        }\n+        let payload_digest = payload_digest(request, placement)?;\n+        let key = digest(&serde_json::to_vec(&(\n+            &placement.identity,\n+            &request.item_id,\n+        ))?);\n+        let origin =\n+            ProjectionOrigin::new(format!(\"human-task:{}:{key}\", self.host)).map_err(refused)?;\n+        let directory = self.directory.join(placement.identity.as_str());\n+        create_directories(&directory)?;\n+        let lock = private_options()\n+            .create(true)\n+            .truncate(false)\n+            .read(true)\n+            .write(true)\n+            .open(directory.join(format!(\"{key}.lock\")))?;\n+        lock.lock()?;\n+        let path = directory.join(format!(\"{key}.json\"));\n+        let existing = match fs::read(&path) {\n+            Ok(bytes) => Some(serde_json::from_slice::<Journal>(&bytes)?),\n+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,\n+            Err(error) => return Err(error.into()),\n+        };\n+        let journal = match existing {\n+            Some(journal) => {\n+                if journal.item_id != request.item_id\n+                    || journal.host != self.host\n+                    || journal.payload_digest != payload_digest\n+                    || journal.placement != *placement\n+                    || journal.origin != origin\n+                {\n+                    return Err(refused(\n+                        \"persisted intent differs in owner, payload, route or privacy; reconcile it before projecting again\",\n+                    ));\n+                }\n+                if let Phase::Bound {\n+                    binding, terminal, ..\n+                } = &journal.phase\n+                {\n+                    if !binding_valid(binding, placement) {\n+                        return Err(refused(\n+                            \"invalid persisted tracker binding; reconcile the durable store\",\n+                        ));\n+                    }\n+                    if let Some(terminal) = terminal\n+                        && Outcome::of(request.state, request.reason.clone())\n+                            .ok()\n+                            .as_ref()\n+                            != Some(&terminal.outcome)\n+                    {\n+                        return Err(refused(\n+                            \"conflicting terminal projection; the prior terminal intent is immutable\",\n+                        ));\n+                    }\n+                }\n+                journal\n+            }\n+            None => Journal {\n+                schema_version: JournalVersion,\n+                item_id: request.item_id.clone(),\n+                host: self.host.clone(),\n+                origin,\n+                payload_digest,\n+                placement: placement.clone(),\n+                phase: Phase::Ready {},\n+            },\n+        };\n+        let mut claim = ProjectionClaim {\n+            path,\n+            journal,\n+            _lock: lock,\n+        };\n+        claim.persist()?;\n+        Ok(claim)\n+    }\n+}\n+\n+/// A locked producer intent. Methods commit transitions before handing authority back.\n+#[derive(Debug)]\n+pub struct ProjectionClaim {\n+    path: PathBuf,\n+    journal: Journal,\n+    _lock: File,\n+}\n+\n+impl ProjectionClaim {\n+    /// Whether a create has never been sent, needs reconciliation, or is already bound.\n+    #[must_use]\n+    pub fn phase(&self) -> IntentPhase {\n+        match self.journal.phase {\n+            Phase::Uncertain {} => IntentPhase::Uncertain,\n+            Phase::Ready {} => IntentPhase::Ready,\n+            Phase::Creating {} => IntentPhase::Creating,\n+            Phase::Bound { .. } => IntentPhase::Bound,\n+        }\n+    }\n+\n+    /// The resolved immutable placement this claim is bound to.\n+    #[must_use]\n+    pub fn placement(&self) -> &ProjectionPlacement {\n+        &self.journal.placement\n+    }\n+\n+    /// The stable external idempotency identity.\n+    #[must_use]\n+    pub fn item_id(&self) -> &str {\n+        self.journal.item_id.as_str()\n+    }\n+\n+    /// The stable origin included in the initial issue body.\n+    #[must_use]\n+    pub fn origin(&self) -> &str {\n+        self.journal.origin.as_str()\n+    }\n+\n+    /// The immutable payload and placement digest used to verify recovery candidates.\n+    #[must_use]\n+    pub fn payload_digest(&self) -> &str {\n+        self.journal.payload_digest.as_str()\n+    }\n+\n+    /// The authoritative host recorded in the initial issue metadata and binding.\n+    #[must_use]\n+    pub fn host(&self) -> &str {\n+        self.journal.host.as_str()\n+    }\n+\n+    /// The canonical identity previously committed, if any.\n+    #[must_use]\n+    pub fn binding(&self) -> Option<&HumanTaskProjected> {\n+        match &self.journal.phase {\n+            Phase::Bound { binding, .. } => Some(binding),\n+            Phase::Uncertain {} | Phase::Ready {} | Phase::Creating {} => None,\n+        }\n+    }\n+\n+    /// The ids the source gave for the task it wrote, when the binding kept any.\n+    #[must_use]\n+    pub fn written_context(&self) -> Option<&serde_json::Value> {\n+        match &self.journal.phase {\n+            Phase::Bound { written, .. } => written.as_ref(),\n+            Phase::Uncertain {} | Phase::Ready {} | Phase::Creating {} => None,\n+        }\n+    }\n+\n+    /// Whether a terminal intent was committed — acknowledged or not.\n+    #[must_use]\n+    pub fn terminal_committed(&self) -> bool {\n+        matches!(\n+            &self.journal.phase,\n+            Phase::Bound {\n+                terminal: Some(_),\n+                ..\n+            }\n+        )\n+    }\n+\n+    /// Durably bind a returned identity with the ids the source gave for what it wrote.\n+    ///\n+    /// # Errors\n+    ///\n+    /// As [`bind`](Self::bind).\n+    pub fn bind_written(\n+        &mut self,\n+        binding: HumanTaskProjected,\n+        written: Option<serde_json::Value>,\n+    ) -> Result<(), ProjectionError> {\n+        self.bind(binding)?;\n+        if let Phase::Bound {\n+            written: held @ None,\n+            terminal: None,\n+            ..\n+        } = &mut self.journal.phase\n+            && written.is_some()\n+        {\n+            *held = written;\n+            return self.persist();\n+        }\n+        Ok(())\n+    }\n+\n+    /// Persist that a create may reach the tracker before the caller sends it.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses a second create, including one after a lost response.\n+    pub fn begin_create(&mut self) -> Result<(), ProjectionError> {\n+        if !matches!(self.journal.phase, Phase::Ready {}) {\n+            return Err(refused(\n+                \"a create may already exist; reconcile by persisted origin instead of creating again\",\n+            ));\n+        }\n+        self.journal.phase = Phase::Creating {};\n+        self.persist()\n+    }\n+\n+    /// Durably bind a returned canonical tracker identity before acknowledging it.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses a different binding or a response incompatible with resolved placement.\n+    pub fn bind(&mut self, binding: HumanTaskProjected) -> Result<(), ProjectionError> {\n+        if !binding_valid(&binding, &self.journal.placement) {\n+            return Err(refused(\n+                \"tracker binding disagrees with the committed source/project\",\n+            ));\n+        }\n+        match &self.journal.phase {\n+            Phase::Bound { binding: held, .. } => {\n+                return if held == &binding {\n+                    Ok(())\n+                } else {\n+                    Err(refused(\"a different ticket is already bound\"))\n+                };\n+            }\n+            Phase::Uncertain {} => {\n+                return Err(refused(\n+                    \"a durable commit failed; drop and reopen this claim\",\n+                ));\n+            }\n+            Phase::Ready {} => return Err(refused(\"a create was not durably claimed\")),\n+            Phase::Creating {} => {}\n+        }\n+        self.journal.phase = Phase::Bound {\n+            binding,\n+            terminal: None,\n+            written: None,\n+        };\n+        self.persist()\n+    }\n+\n+    /// Bind exactly one tracker-origin match after verifying immutable identity and fields.\n+    ///\n+    /// The caller supplies the complete origin query from the existing source interface.\n+    /// An empty, multiple, unindexed or unverifiable answer never authorizes a second create.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses anything other than one verified indexed task with its canonical URL.\n+    pub fn reconcile(\n+        &mut self,\n+        request: &HumanTaskProjection,\n+        matches: &[Task],\n+    ) -> Result<(), ProjectionError> {\n+        if !matches!(self.journal.phase, Phase::Creating {}) || matches.len() != 1 {\n+            return Err(refused(\n+                \"pending create has zero or multiple origin matches; inspect the tracker and reconcile; no second create was sent\",\n+            ));\n+        }\n+        let placement = &self.journal.placement;\n+        if payload_digest(request, placement)? != self.journal.payload_digest {\n+            return Err(refused(\n+                \"recovery request differs from the committed payload\",\n+            ));\n+        }\n+        let task = &matches[0];\n+        let metadata_matches = [\n+            (\"human.item_id\", self.item_id()),\n+            (GlobalId::ORIGIN_KEY, self.origin()),\n+            (\"human.payload_digest\", self.payload_digest()),\n+            (\"human.host\", self.host()),\n+        ]\n+        .iter()\n+        .all(|(key, expected)| {\n+            task.metadata.get(*key).and_then(serde_json::Value::as_str) == Some(*expected)\n+        });\n+        if !metadata_matches\n+            || task.project.as_ref().map(|id| id.as_str()) != Some(placement.project.as_str())\n+            || task.classification != placement.classification\n+            || task.title != request.title.as_str()\n+            || task.content.as_deref().unwrap_or_default() != request.body\n+            || task.priority != request.priority\n+            || repository_set(&task.repositories) != repository_set(&request.repositories)\n+            || task.metadata.get(\"human.owner\") != Some(&serde_json::to_value(&request.owner)?)\n+        {\n+            return Err(refused(\n+                \"origin match is unindexed or differs in item_id, host, route, privacy or payload; inspect and reconcile; no second create was sent\",\n+            ));\n+        }\n+        self.bind(HumanTaskProjected {\n+            task: ProjectedTaskId::try_from(GlobalId::new(\n+                placement.source.clone(),\n+                task.id.clone(),\n+            ))\n+            .map_err(refused)?,\n+            url: TrackerUrl::new(\n+                task.url\n+                    .clone()\n+                    .ok_or_else(|| refused(\"origin match has no canonical issue URL\"))?,\n+            )\n+            .map_err(refused)?,\n+            project: placement.project.clone(),\n+            source: placement.source.clone(),\n+        })\n+    }\n+\n+    /// Commit a terminal intent before writing it, preserving an absent dismissal reason.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses an open state, unbound task or conflicting terminal intent.\n+    pub fn begin_terminal(\n+        &mut self,\n+        state: ProjectionState,\n+        reason: Option<String>,\n+    ) -> Result<(), ProjectionError> {\n+        let outcome = Outcome::of(state, reason)?;\n+        let Phase::Bound { terminal, .. } = &mut self.journal.phase else {\n+            return Err(refused(\n+                \"terminal projection requires an already bound task\",\n+            ));\n+        };\n+        if let Some(terminal) = terminal {\n+            return if terminal.outcome == outcome {\n+                Ok(())\n+            } else {\n+                Err(refused(\"conflicting terminal projection\"))\n+            };\n+        }\n+        *terminal = Some(Terminal {\n+            outcome,\n+            acknowledged: Acknowledgment::Pending,\n+        });\n+        self.persist()\n+    }\n+\n+    /// Whether the terminal write was durably acknowledged.\n+    #[must_use]\n+    pub fn terminal_acknowledged(&self) -> bool {\n+        matches!(\n+            &self.journal.phase,\n+            Phase::Bound {\n+                terminal: Some(Terminal {\n+                    acknowledged: Acknowledgment::Acknowledged,\n+                    ..\n+                }),\n+                ..\n+            }\n+        )\n+    }\n+\n+    /// Acknowledge the terminal write after the tracker confirms it.\n+    ///\n+    /// # Errors\n+    ///\n+    /// Refuses a claim without a terminal intent.\n+    pub fn acknowledge_terminal(&mut self) -> Result<(), ProjectionError> {\n+        let Phase::Bound {\n+            terminal: Some(terminal),\n+            ..\n+        } = &mut self.journal.phase\n+        else {\n+            return Err(refused(\"there is no terminal intent to acknowledge\"));\n+        };\n+        terminal.acknowledged = Acknowledgment::Acknowledged;\n+        self.persist()\n+    }\n+\n+    fn persist(&mut self) -> Result<(), ProjectionError> {\n+        let result = self.persist_to_disk();\n+        if result.is_err() {\n+            self.journal.phase = Phase::Uncertain {};\n+        }\n+        result\n+    }\n+\n+    fn persist_to_disk(&self) -> Result<(), ProjectionError> {\n+        let bytes = serde_json::to_vec(&self.journal)?;\n+        let temporary = self.path.with_extension(\"pending\");\n+        let mut file = private_options()\n+            .create(true)\n+            .truncate(true)\n+            .write(true)\n+            .open(&temporary)?;\n+        file.write_all(&bytes)?;\n+        file.sync_all()?;\n+        fs::rename(temporary, &self.path)?;\n+        sync_directory(self.path.parent().expect(\"a journal has a directory\"))?;\n+        Ok(())\n+    }\n+}\n+\n+fn payload_digest(\n+    request: &HumanTaskProjection,\n+    placement: &ProjectionPlacement,\n+) -> Result<PayloadDigest, ProjectionError> {\n+    let mut payload = serde_json::to_value(request)?;\n+    let fields = payload.as_object_mut().expect(\"a request is a mapping\");\n+    fields.remove(\"state\");\n+    fields.remove(\"reason\");\n+    PayloadDigest::new(digest(&serde_json::to_vec(&(payload, placement))?)).map_err(refused)\n+}\n+\n+fn sync_directory(path: &Path) -> std::io::Result<()> {\n+    #[cfg(unix)]\n+    File::open(path)?.sync_all()?;\n+    #[cfg(not(unix))]\n+    let _ = path;\n+    Ok(())\n+}\n+\n+fn digest(bytes: &[u8]) -> String {\n+    format!(\"{:x}\", Sha256::digest(bytes))\n+}\n+\n+fn refused(message: impl Into<String>) -> ProjectionError {\n+    ProjectionError::Refused(message.into())\n+}\n+\n+fn private_options() -> OpenOptions {\n+    #[cfg(unix)]\n+    {\n+        use std::os::unix::fs::OpenOptionsExt as _;\n+        let mut options = OpenOptions::new();\n+        options.mode(0o600);\n+        options\n+    }\n+    #[cfg(not(unix))]\n+    OpenOptions::new()\n+}\n+\n+fn create_directories(path: &Path) -> std::io::Result<()> {\n+    if path.is_dir() {\n+        return Ok(());\n+    }\n+    if let Some(parent) = path.parent() {\n+        create_directories(parent)?;\n+    }\n+    #[cfg(unix)]\n+    let builder = {\n+        use std::os::unix::fs::DirBuilderExt as _;\n+        let mut builder = fs::DirBuilder::new();\n+        builder.mode(0o700);\n+        builder\n+    };\n+    #[cfg(not(unix))]\n+    let builder = fs::DirBuilder::new();\n+    match builder.create(path) {\n+        Ok(()) => {}\n+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists && path.is_dir() => {}\n+        Err(error) => return Err(error),\n+    }\n+    if let Some(parent) = path.parent() {\n+        sync_directory(parent)?;\n+    }\n+    Ok(())\n+}\n+\n+fn binding_valid(binding: &HumanTaskProjected, placement: &ProjectionPlacement) -> bool {\n+    binding.task.global_id().source == placement.source\n+        && binding.source == placement.source\n+        && binding.project == placement.project\n+}\n+\n+fn repository_set(\n+    repositories: &[onetaskgraph_plugin_api::Repository],\n+) -> std::collections::BTreeSet<&str> {\n+    repositories\n+        .iter()\n+        .map(|repository| repository.as_str())\n+        .collect()\n+}"},{"sha":"99388eea332e2b3dbbbabf5429553b6e2bd8584d","filename":"crates/onetaskgraph-core/src/task_projection/mod.rs","status":"added","additions":283,"deletions":0,"changes":283,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Ftask_projection%2Fmod.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Fsrc%2Ftask_projection%2Fmod.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Fsrc%2Ftask_projection%2Fmod.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,283 @@\n+//! Producer-owned human task projection: the public wire declaration lives here.\n+//!\n+//! Requests identify an action item rather than a question. The same declaration is used\n+//! by the CLI and exported schemas so consumers need not maintain a parallel contract.\n+\n+// llmlint: ignore-file[code_lands_in_the_domain_that_owns_it] Core domains here are crate submodules: config, cache, template and engine each live within onetaskgraph-core's single Nx project. Task projection follows that convention, owning its declaration and producer intent here while sharing the existing engine write machinery. A separate project for this one domain would impose a boundary the existing core domains do not have.\n+mod identity;\n+mod intent;\n+\n+pub use identity::{\n+    ExternalItemId, HostIdentity, PlanId, ProjectedTaskId, ProjectionProjectId, ProjectionTitle,\n+    RunId, SessionId, SourceIdentityDigest, TrackerUrl,\n+};\n+\n+pub use intent::{\n+    IntentPhase, IntentStore, PlacementCache, ProjectionClaim, ProjectionError, ProjectionPlacement,\n+};\n+\n+use onetaskgraph_plugin_api::{Priority, Repository, SourceName};\n+use schemars::{JsonSchema, Schema, SchemaGenerator};\n+use serde::{Deserialize, Deserializer, Serialize, Serializer};\n+\n+/// The sole supported projection request version.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n+pub struct ProjectionVersion;\n+\n+impl Serialize for ProjectionVersion {\n+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {\n+        serializer.serialize_u32(1)\n+    }\n+}\n+\n+impl<'de> Deserialize<'de> for ProjectionVersion {\n+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {\n+        match u32::deserialize(deserializer)? {\n+            1 => Ok(Self),\n+            other => Err(serde::de::Error::custom(format!(\n+                \"unsupported task projection schema_version {other}; expected 1\"\n+            ))),\n+        }\n+    }\n+}\n+\n+impl JsonSchema for ProjectionVersion {\n+    fn schema_name() -> std::borrow::Cow<'static, str> {\n+        \"ProjectionVersion\".into()\n+    }\n+\n+    fn json_schema(_generator: &mut SchemaGenerator) -> Schema {\n+        serde_json::json!({\"type\": \"integer\", \"const\": 1})\n+            .try_into()\n+            .expect(\"a literal schema\")\n+    }\n+}\n+\n+/// The producer that owns the intent; nullable run and plan are explicit on the wire.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]\n+#[serde(deny_unknown_fields)]\n+pub struct ProjectionOwner {\n+    /// The owning session.\n+    pub session: SessionId,\n+    /// The owning run, when applicable.\n+    #[serde(deserialize_with = \"nullable\")]\n+    #[schemars(required, schema_with = \"nullable_string_schema\")]\n+    pub run: Option<RunId>,\n+    /// The owning plan, when applicable.\n+    #[serde(deserialize_with = \"nullable\")]\n+    #[schemars(required, schema_with = \"nullable_string_schema\")]\n+    pub plan: Option<PlanId>,\n+}\n+\n+/// The requested tracker lifecycle. Questions have no representation here.\n+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]\n+#[serde(rename_all = \"kebab-case\")]\n+pub enum ProjectionState {\n+    /// The operator has work to do.\n+    Open,\n+    /// The operator completed the work.\n+    Completed,\n+    /// The operator dismissed the work, optionally recording a reason.\n+    Dismissed,\n+}\n+\n+/// Version 1 of the general human task projection request.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]\n+#[serde(deny_unknown_fields)]\n+pub struct HumanTaskProjection {\n+    /// The wire contract version, always 1.\n+    pub schema_version: ProjectionVersion,\n+    /// The external idempotency identity, stable across producer retries.\n+    pub item_id: ExternalItemId,\n+    /// The producer that owns the intent.\n+    pub owner: ProjectionOwner,\n+    /// The visible task title.\n+    pub title: ProjectionTitle,\n+    /// The visible task content.\n+    pub body: String,\n+    /// Its priority, using the existing plugin API serialization.\n+    pub priority: Priority,\n+    /// Normalized repository origins whose work this item concerns.\n+    pub repositories: Vec<Repository>,\n+    /// The plan's resolved destination project, or null for a configured human project.\n+    #[serde(deserialize_with = \"nullable\")]\n+    #[schemars(required, schema_with = \"nullable_string_schema\")]\n+    pub project: Option<ProjectionProjectId>,\n+    /// The configured source through which placement is resolved.\n+    pub source: SourceName,\n+    /// The desired lifecycle.\n+    pub state: ProjectionState,\n+    /// An optional dismissal reason. Omission and null both preserve absence.\n+    // llmlint: ignore[invalid_states_unrepresentable] The v1 wire declares `state` and `reason` as independent fields, and the exported schema both SDKs generate from is frozen; `Engine::project_human` refuses a reason beside any state but `dismissed` before anything is written, and a journey proves it.\n+    #[serde(default)]\n+    pub reason: Option<String>,\n+}\n+\n+/// A durable projection's bound tracker identity, suitable for a directly clickable card.\n+#[derive(Debug, Clone, PartialEq, Eq, Serialize, JsonSchema)]\n+#[serde(deny_unknown_fields)]\n+pub struct HumanTaskProjected {\n+    /// The qualified task identity.\n+    task: ProjectedTaskId,\n+    /// The canonical tracker issue URL.\n+    url: TrackerUrl,\n+    /// The resolved destination project.\n+    project: ProjectionProjectId,\n+    /// The resolved configured source.\n+    source: SourceName,\n+}\n+\n+impl HumanTaskProjected {\n+    /// Bind a canonical issue URL and existing project to a qualified task identity.\n+    #[must_use]\n+    pub fn new(task: ProjectedTaskId, url: TrackerUrl, project: ProjectionProjectId) -> Self {\n+        let source = task.global_id().source;\n+        Self {\n+            task,\n+            url,\n+            project,\n+            source,\n+        }\n+    }\n+\n+    /// The qualified task identity.\n+    #[must_use]\n+    pub fn task(&self) -> &ProjectedTaskId {\n+        &self.task\n+    }\n+\n+    /// The canonical URL used directly by a tracker card.\n+    #[must_use]\n+    pub fn url(&self) -> &TrackerUrl {\n+        &self.url\n+    }\n+\n+    /// The resolved existing project.\n+    #[must_use]\n+    pub fn project(&self) -> &ProjectionProjectId {\n+        &self.project\n+    }\n+\n+    /// The source derived from the qualified task identity.\n+    #[must_use]\n+    pub fn source(&self) -> &SourceName {\n+        &self.source\n+    }\n+}\n+\n+impl<'de> Deserialize<'de> for HumanTaskProjected {\n+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {\n+        let mut fields = serde_json::Map::<String, serde_json::Value>::deserialize(deserializer)?;\n+        fn take<T: serde::de::DeserializeOwned>(\n+            fields: &mut serde_json::Map<String, serde_json::Value>,\n+            name: &str,\n+        ) -> Result<T, String> {\n+            serde_json::from_value(\n+                fields\n+                    .remove(name)\n+                    .ok_or_else(|| format!(\"missing field {name}\"))?,\n+            )\n+            .map_err(|error| format!(\"{name}: {error}\"))\n+        }\n+        let task: ProjectedTaskId = take(&mut fields, \"task\").map_err(serde::de::Error::custom)?;\n+        let url = take(&mut fields, \"url\").map_err(serde::de::Error::custom)?;\n+        let project = take(&mut fields, \"project\").map_err(serde::de::Error::custom)?;\n+        let source: SourceName = take(&mut fields, \"source\").map_err(serde::de::Error::custom)?;\n+        if !fields.is_empty() {\n+            return Err(serde::de::Error::custom(\"unknown projection binding field\"));\n+        }\n+        let bound = Self::new(task, url, project);\n+        if bound.source != source {\n+            return Err(serde::de::Error::custom(\n+                \"binding source disagrees with qualified task\",\n+            ));\n+        }\n+        Ok(bound)\n+    }\n+}\n+\n+/// Require a nullable key to be present, distinguishing it from an optional reason.\n+fn nullable<'de, D: Deserializer<'de>, T: Deserialize<'de>>(\n+    deserializer: D,\n+) -> Result<Option<T>, D::Error> {\n+    Option::<T>::deserialize(deserializer)\n+}\n+\n+/// One source's projection authority, as its `task_projection` configures it.\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct ProjectionSource {\n+    /// The digest naming the source's remote, shared with its local cache.\n+    pub identity: SourceIdentityDigest,\n+    /// The authoritative host.\n+    pub host: HostIdentity,\n+    /// The absolute directory holding its intents.\n+    pub directory: std::path::PathBuf,\n+    /// The project a planless item is filed under.\n+    pub project: Option<ProjectionProjectId>,\n+    /// Where its kept placement lives — beside the source's local cache — or `None` when this\n+    /// host names no cache home, so every create reads its placement.\n+    pub placement: Option<PlacementCache>,\n+}\n+\n+/// Every configured source's projection authority, or why it cannot hold one.\n+pub(crate) fn configured(\n+    config: &crate::config::Config,\n+) -> std::collections::BTreeMap<SourceName, Result<ProjectionSource, String>> {\n+    config\n+        .sources()\n+        .iter()\n+        .filter_map(|(name, source)| {\n+            let declared = source.task_projection()?;\n+            let home = config\n+                .cache_home()\n+                .map(std::path::Path::to_path_buf)\n+                .or_else(crate::cache::process_home);\n+            let resolved = (|| {\n+                let identity = crate::cache::remote_digest(source).ok_or_else(|| {\n+                    format!(\n+                        \"source {name} names no remote tracker, so its projections have no \\\n+                         stable identity\"\n+                    )\n+                })?;\n+                Ok(ProjectionSource {\n+                    identity: SourceIdentityDigest::new(identity)?,\n+                    host: declared.host.clone(),\n+                    directory: declared.directory.as_path().to_path_buf(),\n+                    project: declared.project.clone(),\n+                    placement: crate::cache::designator_location(source, home.as_deref()).map(\n+                        |(designator, _)| {\n+                            PlacementCache::at(designator.with_file_name(\"placement.json\"))\n+                        },\n+                    ),\n+                })\n+            })();\n+            Some((name.clone(), resolved))\n+        })\n+        .collect()\n+}\n+\n+/// The purpose selected by human task projection writers on existing route declarations.\n+#[must_use]\n+pub fn route_purpose() -> crate::config::RoutePurpose {\n+    crate::config::RoutePurpose::new(\"human-task\").expect(\"a literal routing identity\")\n+}\n+\n+fn nullable_string_schema(_generator: &mut SchemaGenerator) -> Schema {\n+    serde_json::json!({\"type\": [\"string\", \"null\"]})\n+        .try_into()\n+        .expect(\"a literal nullable string schema\")\n+}\n+\n+/// The schema bundle registers this domain once; new roots stay beside their declaration.\n+pub(crate) fn schemas() -> [(&'static str, Schema); 2] {\n+    [\n+        (\n+            \"HumanTaskProjection\",\n+            schemars::schema_for!(HumanTaskProjection),\n+        ),\n+        (\n+            \"HumanTaskProjected\",\n+            schemars::schema_for!(HumanTaskProjected),\n+        ),\n+    ]\n+}"},{"sha":"f4ff54e63de9e631f14b54e5e648d92573d3fc77","filename":"crates/onetaskgraph-core/tests/engine.rs","status":"modified","additions":151,"deletions":0,"changes":151,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Ftests%2Fengine.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Ftests%2Fengine.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Ftests%2Fengine.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -3890,6 +3890,13 @@ const PUBLISHED_BUNDLES: &[(u32, Published)] = &[\n             beside: &FORTY_NINTH_BUNDLE_BESIDE,\n         },\n     ),\n+    (\n+        50,\n+        Published::Whole {\n+            roots: &FIFTIETH_BUNDLE_SHAPE,\n+            beside: &FORTY_NINTH_BUNDLE_BESIDE,\n+        },\n+    ),\n ];\n \n /// What version 35 publishes beside the engine's roots.\n@@ -5449,3 +5456,147 @@ fn a_failure_document_names_what_failed_where_and_takes_a_wrapped_failures_class\n     assert_eq!(decided.message(), \"not qualified\");\n     assert_eq!(document(decided)[\"failure\"][\"kind\"], \"invalid-id\");\n }\n+\n+/// The complete root snapshot: a version describes all domains together, so additions\n+/// cannot hide an unrelated root's drift.\n+// llmlint: ignore-block[code_lands_in_the_domain_that_owns_it] Repository policy requires one append-only golden for the one schema-bundle version. This snapshot records every root emitted by schema_bundle, including the projection domain's own derived schemas; moving its rows into producer tables would stop this snapshot from independently detecting cross-domain drift. The existing bundle test compares the complete names and digests against the real exporter.\n+const FIFTIETH_BUNDLE_SHAPE: [(&str, u64); 136] = [\n+    (\"Asset\", 0x3861b2a394973652),\n+    (\"AssetContentType\", 0x045a0ea0dface7ec),\n+    (\"AssetName\", 0x0f5aa03142270839),\n+    (\"AssetPayload\", 0xe85850d677490e97),\n+    (\"AssetUpload\", 0xf417fb0dc8a3a044),\n+    (\"AssetUploads\", 0xc07fc8afac6acde5),\n+    (\"AssetWrite\", 0x425ab5b21768c337),\n+    (\"AssetsWritten\", 0x5a394f7414967354),\n+    (\"CacheCleared\", 0x07f2024428115e02),\n+    (\"CacheUse\", 0x99e677fe6a710743),\n+    (\"Capabilities\", 0x0307809d59773695),\n+    (\"Classification\", 0xbac1e9e5c34a4675),\n+    (\"ClosedAs\", 0x61fad6b731146cda),\n+    (\"Comment\", 0xf4d10955d5040047),\n+    (\"CommentList\", 0x19a453e829b59921),\n+    (\"CommentWritten\", 0x7b7fd4a7d857882c),\n+    (\"CompleteAction\", 0x5e0bba6a83c81f31),\n+    (\"Completion\", 0x5853ab75d4e5e2e3),\n+    (\"ContradictedItem\", 0x554446204e302ef5),\n+    (\"CopyAction\", 0x30ee0fa5cbe3f661),\n+    (\"CopyLink\", 0x58389f81345b5907),\n+    (\"CopyOutcome\", 0x5398367f4d3b4e2b),\n+    (\"CopyReport\", 0x8afb6d574bd4723a),\n+    (\"CopyVia\", 0xbbb3114f110ab62e),\n+    (\"CredentialLayer\", 0x54cdffe467a3b7f1),\n+    (\"DeletedComment\", 0xc5a47d04782a4f76),\n+    (\"Delivered\", 0xd27ae244686ce058),\n+    (\"DeliveryOutcome\", 0xdffbe7762b598b85),\n+    (\"DependencyEdge\", 0x34a23777c098079c),\n+    (\"DependencyEndpoint\", 0x7792d822063ecb64),\n+    (\"DependencyKind\", 0x62a3106e8479701a),\n+    (\"Direction\", 0x497cbce272a8a5bb),\n+    (\"Document\", 0xaf87c446d7ea9402),\n+    (\"DocumentDetail\", 0xf8192dc562775fdf),\n+    (\"DocumentQuery\", 0xab8ca467012e1a12),\n+    (\"EffectiveConfig\", 0x09720f8fb6300662),\n+    (\"ExpectedWrite\", 0x4bb6619afc95b3f3),\n+    (\"Failure\", 0x19dbdae11bff9082),\n+    (\"FailureClass\", 0x7fcbfc34989aa444),\n+    (\"FailureDocument\", 0x2faf98bea73155b2),\n+    (\"GlobalId\", 0xe692661021d9c53e),\n+    (\"Health\", 0x4a65ae032f76c6ca),\n+    (\"HeldTask\", 0x72aa6c278ce2989a),\n+    (\"HumanTaskProjected\", 0xc9ae27f7485ba275),\n+    (\"HumanTaskProjection\", 0xf2d5ebdb0ce970ac),\n+    (\"IssueCompleted\", 0xcda0626796abdead),\n+    (\"IssueHolding\", 0x1fa0063f0f16797b),\n+    (\"IssueRef\", 0x4811b4d45dc1b892),\n+    (\"IssuesCompleted\", 0x9ab31da0d5f7e5fd),\n+    (\"ItemKind\", 0x75db1aa08ed04b2f),\n+    (\"ItemType\", 0x417523fd8e62d46a),\n+    (\"Label\", 0x07555503d77a90c7),\n+    (\"LinearConfig\", 0x10a5b658053e0912),\n+    (\"LocateReport\", 0x8af64af6dd02ab00),\n+    (\"Location\", 0x0690620b049c989a),\n+    (\"MetadataSet\", 0x4c828982de7fcea8),\n+    (\"NativeId\", 0x0150d4025c258cb8),\n+    (\"NewComment\", 0xda981b6b61244e61),\n+    (\"Origin\", 0x653235a0d0c3576e),\n+    (\"OutputFormat\", 0xa8a85cfd04d98684),\n+    (\"PageOfComment\", 0x1766e3e0b0cfe101),\n+    (\"PageOfDependencyEdge\", 0xf3083fc9dc91beb9),\n+    (\"PageOfDocument\", 0xdacc2efd767af6c4),\n+    (\"PageOfLabel\", 0xd6110ddeeaaa78e8),\n+    (\"PageOfProject\", 0x405e690d92a767b5),\n+    (\"PageOfTask\", 0x999e022251984937),\n+    (\"PageRequest\", 0x6c7be3975028b78c),\n+    (\"PageToken\", 0xc685683af2c78c39),\n+    (\"Placement\", 0xe5c1c0857f3cbaeb),\n+    (\"Predicate\", 0x716a40e358d48364),\n+    (\"Priority\", 0xef323286b7a05b23),\n+    (\"Project\", 0x532ad3dad5ab19cb),\n+    (\"ProjectGraph\", 0x5231b0aef0f2349d),\n+    (\"ProjectQuery\", 0x65c1348867b92915),\n+    (\"ProjectStatusSet\", 0x0fc20a92f42562fe),\n+    (\"PublicProjections\", 0xeff35b0daff22815),\n+    (\"PublicWriteInput\", 0x372b3adc968f9443),\n+    (\"QualifiedDocument\", 0x345fa41c95c3aeaa),\n+    (\"QualifiedEdge\", 0xe24f9b34b618df17),\n+    (\"QualifiedEndpoint\", 0x7bc0f5163c4c8594),\n+    (\"QualifiedLabel\", 0x7ac91fcfd8f41e30),\n+    (\"QualifiedProject\", 0x2f9906d61e3e071d),\n+    (\"QualifiedTask\", 0xf6e4a99c8c375fd5),\n+    (\"QueryPlan\", 0x55bbbcd70ea539e5),\n+    (\"QueryResponseOfQualifiedDocument\", 0xc34d66ec76b42960),\n+    (\"QueryResponseOfQualifiedEdge\", 0xd47c74c326794d58),\n+    (\"QueryResponseOfQualifiedLabel\", 0x28eecbe61d4a7ffc),\n+    (\"QueryResponseOfQualifiedProject\", 0x5e960ee81e2e9cb3),\n+    (\"QueryResponseOfQualifiedTask\", 0xf0a04aa1edb48505),\n+    (\"QueryResponseOfSearchHit\", 0xa9f72507502b6a47),\n+    (\"ReconcileOutcome\", 0x0c916b694a28be32),\n+    (\"Regenerated\", 0x115dedc2c67a50c0),\n+    (\"RenderedTemplate\", 0x08d378ba8134d8d5),\n+    (\"Repository\", 0x98147ade92ced0f0),\n+    (\"RepositoryVisibility\", 0x97913706150bdd17),\n+    (\"ResolvedCredential\", 0x14a23b081a4e8d10),\n+    (\"SearchHit\", 0x813451b94db1b728),\n+    (\"SearchKind\", 0xc4d2cd105ad4b849),\n+    (\"SecretsReport\", 0x245d50b08721b73d),\n+    (\"Setting\", 0xf593f9ae902cba68),\n+    (\"SourceCacheConfig\", 0x5e2d1e6e457f8ba7),\n+    (\"SourceError\", 0x33872c91770f86da),\n+    (\"SourceFailure\", 0xb30fd488e61b4def),\n+    (\"SourceListing\", 0x84cc563bc6183560),\n+    (\"SourceListings\", 0x365df5b4c9e0f6f1),\n+    (\"SourceName\", 0x369c7453415b4c0d),\n+    (\"SourcePlan\", 0xd27635c28c7b6f79),\n+    (\"SourceRoute\", 0x2d0c02eb1c380ea4),\n+    (\"SourceVisibility\", 0xf5faf7a9eeb49c00),\n+    (\"Status\", 0x9aeea7ad21e23334),\n+    (\"StatusCategory\", 0xeb567f8510446170),\n+    (\"StatusContradiction\", 0x14c41ce1745a8da1),\n+    (\"StatusMapping\", 0x8254754ba020e7f3),\n+    (\"StatusReconciled\", 0xc7ebba9481c79438),\n+    (\"StatusesReconciled\", 0x70c7a2c5693acf6d),\n+    (\"Task\", 0x4552c888ea064e07),\n+    (\"TaskAssetNames\", 0xc964f4e9ef203e23),\n+    (\"TaskContentSet\", 0x3dfc9353ef15910a),\n+    (\"TaskDetail\", 0xf6f914f9b1bb1304),\n+    (\"TaskDetails\", 0x9551707a78661091),\n+    (\"TaskPrioritySet\", 0x3e1a79344c7f54d6),\n+    (\"TaskQuery\", 0x0efc24a7b89f2422),\n+    (\"TaskRef\", 0xad8ce2508e0797c7),\n+    (\"TaskStatusSet\", 0x93f775d84ce36557),\n+    (\"TaskUpdate\", 0xbcdc79352391db9f),\n+    (\"TaskUpdateOutcome\", 0x1e18f414f9207b19),\n+    (\"TaskUpdated\", 0x51db348dfcbdc7d4),\n+    (\"TemplateAnswers\", 0xbeb56ff5ed8f5ebc),\n+    (\"TemplateProvenance\", 0x297651a29bb44a49),\n+    (\"TemplateVariable\", 0x482dac5032a65dec),\n+    (\"TemplateVariables\", 0x25e538f450bbf057),\n+    (\"TextFields\", 0x7240bd05f9beff93),\n+    (\"UpdatedField\", 0xd9491e609db7475c),\n+    (\"VariableType\", 0x4310e29eba96791c),\n+    (\"WritePolicyConfig\", 0x99a987f6423fdb8a),\n+    (\"WriteVerdict\", 0xfe9f3b7541b8efb0),\n+];\n+\n+// llmlint: ignore-end[code_lands_in_the_domain_that_owns_it]"},{"sha":"f11c3fcf8dc134f8ca69bc114e938a5ca6ca85be","filename":"crates/onetaskgraph-core/tests/human_routes.rs","status":"added","additions":223,"deletions":0,"changes":223,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Ftests%2Fhuman_routes.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Ftests%2Fhuman_routes.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Ftests%2Fhuman_routes.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,223 @@\n+//! Human task destinations use the existing validated route declaration.\n+use onetaskgraph_core::Config;\n+use onetaskgraph_core::config::RoutePurpose;\n+use onetaskgraph_plugin_api::{Classification, Repository, SourceName};\n+use serde_json::{Value, json};\n+\n+fn configured(purpose: Value) -> Value {\n+    json!({\"sources\": {\n+        \"plans\": {\"plugin\": \"in-memory\", \"routes\": [\n+            {\"classification\": \"public\", \"purpose\": purpose, \"to\": \"human-public\"},\n+            {\"classification\": \"private\", \"purpose\": \"human-task\", \"to\": \"human-private\"},\n+            {\"classification\": \"public\", \"to\": \"legacy\"}\n+        ]},\n+        \"human-public\": {\"plugin\": \"in-memory\"},\n+        \"human-private\": {\"plugin\": \"in-memory\", \"visibility\": \"private\"},\n+        \"legacy\": {\"plugin\": \"in-memory\"}\n+    }})\n+}\n+\n+#[test]\n+fn human_routes_preserve_legacy_placement_and_private_safety() {\n+    let config = Config::from_document(configured(json!(\"human-task\"))).expect(\"valid routes\");\n+    let routes = config.routes();\n+    let plans = SourceName::new(\"plans\".to_owned()).expect(\"source\");\n+    let repositories =\n+        [Repository::try_from(\"github.com/operator/work\".to_owned()).expect(\"origin\")];\n+    assert_eq!(\n+        routes.place(&plans, &repositories).destination.as_str(),\n+        \"legacy\"\n+    );\n+    for (classification, destination) in [\n+        (Classification::Public, \"human-public\"),\n+        (Classification::Private, \"human-private\"),\n+    ] {\n+        let placed = routes.place_for(\n+            &plans,\n+            classification,\n+            &repositories,\n+            Some(&RoutePurpose::new(\"human-task\").expect(\"purpose\")),\n+        );\n+        assert_eq!(placed.destination.as_str(), destination);\n+        assert_eq!(\n+            routes.of(&plans)[placed.route.expect(\"matched\") as usize].purpose(),\n+            Some(&RoutePurpose::new(\"human-task\").expect(\"purpose\"))\n+        );\n+    }\n+\n+    let mut missing = configured(json!(\"human-task\"));\n+    missing[\"sources\"][\"plans\"][\"routes\"]\n+        .as_array_mut()\n+        .expect(\"routes\")\n+        .remove(1);\n+    let missing = Config::from_document(missing).expect(\"missing private route loads\");\n+    let placed = missing.routes().place_for(\n+        &plans,\n+        Classification::Private,\n+        &repositories,\n+        Some(&RoutePurpose::new(\"human-task\").expect(\"purpose\")),\n+    );\n+    assert_eq!(\n+        placed.destination, plans,\n+        \"private items never fall back publicly\"\n+    );\n+    assert_eq!(placed.route, None);\n+}\n+\n+#[test]\n+fn malformed_or_unsafe_human_routes_refuse_at_configuration_boundary() {\n+    for purpose in [\n+        json!(\"\"),\n+        json!(\"-task\"),\n+        json!(\"task-\"),\n+        json!(\"task--work\"),\n+        json!(\"Human Task\"),\n+        json!(1),\n+        Value::Null,\n+    ] {\n+        let refusal = Config::from_document(configured(purpose)).expect_err(\"invalid purpose\");\n+        assert!(\n+            refusal\n+                .to_string()\n+                .contains(\"sources.plans.routes.0.purpose\"),\n+            \"{refusal}\"\n+        );\n+    }\n+    let mut unsafe_route = configured(json!(\"human-task\"));\n+    unsafe_route[\"sources\"][\"plans\"][\"routes\"][1][\"to\"] = json!(\"human-public\");\n+    let refusal = Config::from_document(unsafe_route).expect_err(\"private route to public\");\n+    assert!(\n+        refusal.to_string().contains(\"not declared private\"),\n+        \"{refusal}\"\n+    );\n+}\n+\n+#[test]\n+fn scoped_repository_routes_keep_precedence_order_and_visibility_filtering() {\n+    let config = Config::from_document(json!({\"sources\": {\n+        \"plans\": {\"plugin\": \"in-memory\", \"routes\": [\n+            {\"repositories\": [\"github.com/operator/*\"], \"purpose\": \"human-task\", \"to\": \"public\"},\n+            {\"classification\": \"public\", \"purpose\": \"human-task\", \"to\": \"classified\"},\n+            {\"repositories\": [\"github.com/operator/*\"], \"classification\": \"public\",\n+             \"purpose\": \"human-task\", \"to\": \"combined\"},\n+            {\"repositories\": [\"github.com/operator/*\"], \"classification\": \"public\",\n+             \"purpose\": \"human-task\", \"to\": \"second\"},\n+            {\"repositories\": [\"github.com/operator/*\"], \"purpose\": \"human-task\", \"to\": \"vault\"}\n+        ]},\n+        \"public\": {\"plugin\": \"in-memory\"},\n+        \"classified\": {\"plugin\": \"in-memory\"},\n+        \"combined\": {\"plugin\": \"in-memory\"},\n+        \"second\": {\"plugin\": \"in-memory\"},\n+        \"vault\": {\"plugin\": \"in-memory\", \"visibility\": \"private\"}\n+    }}))\n+    .expect(\"all matcher kinds\");\n+    let plans = SourceName::new(\"plans\".to_owned()).expect(\"source\");\n+    let repositories =\n+        [Repository::try_from(\"github.com/operator/work\".to_owned()).expect(\"origin\")];\n+    let routes = config.routes();\n+    let place = |classification, repositories: &[Repository]| {\n+        routes.place_for(\n+            &plans,\n+            classification,\n+            repositories,\n+            Some(&RoutePurpose::new(\"human-task\").expect(\"purpose\")),\n+        )\n+    };\n+    assert_eq!(\n+        place(Classification::Public, &repositories)\n+            .destination\n+            .as_str(),\n+        \"combined\",\n+        \"combined outranks classification and repository; first combined wins\"\n+    );\n+    assert_eq!(\n+        place(Classification::Public, &[]).destination.as_str(),\n+        \"classified\",\n+        \"repository matchers require repositories\"\n+    );\n+    assert_eq!(\n+        place(Classification::Private, &repositories)\n+            .destination\n+            .as_str(),\n+        \"vault\",\n+        \"matching public repository route is skipped before precedence\"\n+    );\n+    for index in [0, 2] {\n+        assert_eq!(\n+            routes.of(&plans)[index].purpose(),\n+            Some(&RoutePurpose::new(\"human-task\").expect(\"purpose\"))\n+        );\n+    }\n+    assert_eq!(\n+        routes.place(&plans, &repositories).destination,\n+        plans,\n+        \"scoped repository and combined entries never affect legacy callers\"\n+    );\n+}\n+\n+#[test]\n+fn distinct_producer_purposes_cannot_select_each_others_routes() {\n+    let mut document = configured(json!(\"human-task\"));\n+    document[\"sources\"][\"plans\"][\"routes\"]\n+        .as_array_mut()\n+        .expect(\"routes\")\n+        .insert(\n+            0,\n+            json!({\"classification\": \"public\", \"purpose\": \"review\", \"to\": \"human-private\"}),\n+        );\n+    let routes = Config::from_document(document)\n+        .expect(\"two purposes\")\n+        .routes();\n+    let plans = SourceName::new(\"plans\".to_owned()).expect(\"source\");\n+    for (purpose, destination) in [(\"review\", \"human-private\"), (\"human-task\", \"human-public\")] {\n+        assert_eq!(\n+            routes\n+                .place_for(\n+                    &plans,\n+                    Classification::Public,\n+                    &[],\n+                    Some(&RoutePurpose::new(purpose).expect(\"purpose\"))\n+                )\n+                .destination\n+                .as_str(),\n+            destination\n+        );\n+    }\n+}\n+\n+#[test]\n+fn scoped_routes_never_expand_legacy_write_preflights() {\n+    let mut document = configured(json!(\"human-task\"));\n+    let plans = SourceName::new(\"plans\".to_owned()).expect(\"source\");\n+    let config = Config::from_document(document.clone()).expect(\"routes\");\n+    let routes = config.routes();\n+    assert_eq!(\n+        routes\n+            .reachable(&plans)\n+            .iter()\n+            .map(SourceName::as_str)\n+            .collect::<Vec<_>>(),\n+        [\"plans\", \"legacy\"],\n+        \"legacy preflight must not contact scoped destinations\"\n+    );\n+    document[\"sources\"][\"plans\"][\"routes\"]\n+        .as_array_mut()\n+        .expect(\"routes\")\n+        .pop();\n+    let scoped_only = Config::from_document(document)\n+        .expect(\"only scoped routes\")\n+        .routes();\n+    assert!(!scoped_only.routes(&plans));\n+    assert!(!scoped_only.any());\n+    assert_eq!(scoped_only.reachable(&plans), vec![plans]);\n+}\n+\n+#[test]\n+fn scoped_entries_still_cannot_create_route_chains() {\n+    let mut document = configured(json!(\"human-task\"));\n+    document[\"sources\"][\"human-public\"][\"routes\"] = json!([\n+        {\"classification\":\"public\",\"purpose\":\"review\",\"to\":\"legacy\"}\n+    ]);\n+    let error = Config::from_document(document).expect_err(\"a scoped target still routes\");\n+    assert!(error.to_string().contains(\"routes of its own\"), \"{error}\");\n+}"},{"sha":"8c0caecf9d63eb54d2cc47c6f89b6631fcfc7009","filename":"crates/onetaskgraph-core/tests/projection_intent.rs","status":"added","additions":802,"deletions":0,"changes":802,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Ftests%2Fprojection_intent.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Ftests%2Fprojection_intent.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Ftests%2Fprojection_intent.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,802 @@\n+//! Producer intents use the real filesystem and OS locks; tracker evidence is passed at\n+//! the public journal boundary, never through a substitute engine.\n+use std::process::Command;\n+\n+use onetaskgraph_core::task_projection::{\n+    HumanTaskProjected, HumanTaskProjection, IntentPhase, IntentStore, ProjectionPlacement,\n+    ProjectionState,\n+};\n+use onetaskgraph_plugin_api::{Classification, SourceName, Task};\n+use serde_json::json;\n+use tempfile::TempDir;\n+\n+fn request() -> HumanTaskProjection {\n+    serde_json::from_value(json!({\n+        \"schema_version\":1,\"item_id\":\"host/session/item\",\n+        \"owner\":{\"session\":\"session\",\"run\":null,\"plan\":null},\n+        \"title\":\"Review release\",\"body\":\"Decide whether to release.\",\"priority\":\"high\",\n+        \"repositories\":[\"github.com/operator/product\"],\"project\":\"P-1\",\"source\":\"plans\",\n+        \"state\":\"open\",\"reason\":null\n+    }))\n+    .expect(\"v1\")\n+}\n+\n+fn placement() -> ProjectionPlacement {\n+    ProjectionPlacement {\n+        identity: onetaskgraph_core::task_projection::SourceIdentityDigest::new(\"a\".repeat(64))\n+            .expect(\"source digest\"),\n+        source: SourceName::new(\"human\".to_owned()).expect(\"source\"),\n+        project: onetaskgraph_core::task_projection::ProjectionProjectId::new(\"P-1\")\n+            .expect(\"project\"),\n+        classification: Classification::Public,\n+    }\n+}\n+\n+fn store(root: &std::path::Path) -> IntentStore {\n+    IntentStore::new(root.to_path_buf(), \"host\".to_owned(), \"host\".to_owned()).expect(\"store\")\n+}\n+\n+fn binding() -> HumanTaskProjected {\n+    serde_json::from_value(json!({\n+        \"task\":\"human:ISSUE-1\",\"url\":\"https://github.com/operator/product/issues/1\",\n+        \"project\":\"P-1\",\"source\":\"human\"\n+    }))\n+    .expect(\"binding\")\n+}\n+\n+#[test]\n+fn intent_process() {\n+    let Some(root) = std::env::var_os(\"OTG_INTENT_CHILD_ROOT\") else {\n+        return;\n+    };\n+    let store = store(std::path::Path::new(&root));\n+    let mut claim = store.claim(&request(), &placement()).expect(\"claim\");\n+    match std::env::var(\"OTG_INTENT_CHILD_MODE\")\n+        .expect(\"mode\")\n+        .as_str()\n+    {\n+        \"crash-before-create\" => std::process::exit(71),\n+        \"crash-after-create-claim\" => {\n+            claim.begin_create().expect(\"durable creating\");\n+            std::process::exit(72);\n+        }\n+        \"crash-after-bind\" => {\n+            claim.begin_create().expect(\"durable creating\");\n+            claim.bind(binding()).expect(\"durable binding\");\n+            std::process::exit(73);\n+        }\n+        \"contender\" => match claim.begin_create() {\n+            Ok(()) => std::process::exit(74),\n+            Err(_) => std::process::exit(75),\n+        },\n+        _ => panic!(\"unknown child mode\"),\n+    }\n+}\n+\n+fn child(root: &std::path::Path, mode: &str) -> std::process::Child {\n+    Command::new(std::env::current_exe().expect(\"test executable\"))\n+        .args([\"--exact\", \"intent_process\", \"--nocapture\"])\n+        .env(\"OTG_INTENT_CHILD_ROOT\", root)\n+        .env(\"OTG_INTENT_CHILD_MODE\", mode)\n+        .stdout(std::process::Stdio::null())\n+        .spawn()\n+        .expect(\"child\")\n+}\n+\n+#[test]\n+fn process_crashes_preserve_create_authority_and_binding() {\n+    for (mode, exit, expected) in [\n+        (\"crash-before-create\", 71, IntentPhase::Ready),\n+        (\"crash-after-create-claim\", 72, IntentPhase::Creating),\n+        (\"crash-after-bind\", 73, IntentPhase::Bound),\n+    ] {\n+        let root = TempDir::new().expect(\"root\");\n+        assert_eq!(\n+            child(root.path(), mode).wait().expect(\"child exit\").code(),\n+            Some(exit)\n+        );\n+        let mut claim = store(root.path())\n+            .claim(&request(), &placement())\n+            .expect(\"fresh process view\");\n+        assert_eq!(claim.phase(), expected);\n+        if expected == IntentPhase::Ready {\n+            claim\n+                .begin_create()\n+                .expect(\"no create could have been sent\");\n+        } else {\n+            assert!(\n+                claim.begin_create().is_err(),\n+                \"a retry never authorizes another create\"\n+            );\n+        }\n+        if expected == IntentPhase::Bound {\n+            assert_eq!(claim.binding(), Some(&binding()));\n+        }\n+    }\n+}\n+\n+#[test]\n+fn simultaneous_local_owners_serialize_before_authorizing_create() {\n+    let root = TempDir::new().expect(\"root\");\n+    let mut first = child(root.path(), \"contender\");\n+    let mut second = child(root.path(), \"contender\");\n+    let mut exits = [\n+        first.wait().expect(\"first\").code().expect(\"code\"),\n+        second.wait().expect(\"second\").code().expect(\"code\"),\n+    ];\n+    exits.sort_unstable();\n+    assert_eq!(\n+        exits,\n+        [74, 75],\n+        \"only one process receives create authority\"\n+    );\n+}\n+\n+#[test]\n+fn terminal_intent_is_immutable_and_absent_reason_stays_absent() {\n+    for reason in [None, Some(\"Superseded\".to_owned())] {\n+        let root = TempDir::new().expect(\"root\");\n+        let mut request = request();\n+        let store = store(root.path());\n+        let mut claim = store.claim(&request, &placement()).expect(\"claim\");\n+        claim.begin_create().expect(\"create\");\n+        claim.bind(binding()).expect(\"bind\");\n+        claim\n+            .begin_terminal(ProjectionState::Dismissed, reason.clone())\n+            .expect(\"terminal\");\n+        assert!(!claim.terminal_acknowledged());\n+        drop(claim);\n+        request.state = ProjectionState::Dismissed;\n+        request.reason = reason;\n+        let mut claim = store\n+            .claim(&request, &placement())\n+            .expect(\"resume terminal\");\n+        claim.acknowledge_terminal().expect(\"acknowledge\");\n+        drop(claim);\n+        let claim = store.claim(&request, &placement()).expect(\"no-op\");\n+        assert!(claim.terminal_acknowledged());\n+        assert_eq!(claim.binding(), Some(&binding()));\n+        drop(claim);\n+        request.state = ProjectionState::Completed;\n+        assert!(\n+            store.claim(&request, &placement()).is_err(),\n+            \"conflicting terminal refuses\"\n+        );\n+    }\n+}\n+\n+#[test]\n+fn changed_payload_route_privacy_and_foreign_host_refuse() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    drop(\n+        store\n+            .claim(&request(), &placement())\n+            .expect(\"initial intent\"),\n+    );\n+    let mut changed = request();\n+    changed.body = \"Changed content\".to_owned();\n+    assert!(store.claim(&changed, &placement()).is_err());\n+    let mut changed_route = placement();\n+    changed_route.project =\n+        onetaskgraph_core::task_projection::ProjectionProjectId::new(\"P-2\").expect(\"project\");\n+    assert!(store.claim(&request(), &changed_route).is_err());\n+    let mut changed_privacy = placement();\n+    changed_privacy.classification = Classification::Private;\n+    assert!(store.claim(&request(), &changed_privacy).is_err());\n+    let foreign_root = root.path().join(\"foreign\");\n+    let foreign = IntentStore::new(foreign_root.clone(), \"host\".to_owned(), \"other\".to_owned())\n+        .expect(\"explicit authority\");\n+    let error = foreign\n+        .claim(&request(), &placement())\n+        .expect_err(\"foreign host\")\n+        .to_string();\n+    assert!(error.contains(\"host\") && error.contains(\"other\") && error.contains(\"task_projection\"));\n+    assert!(!foreign_root.exists(), \"authority refusal writes nothing\");\n+}\n+\n+fn candidate(claim: &onetaskgraph_core::task_projection::ProjectionClaim) -> Task {\n+    serde_json::from_value(json!({\n+        \"id\":\"ISSUE-1\",\"title\":\"Review release\",\"content\":\"Decide whether to release.\",\n+        \"priority\":\"high\",\"repositories\":[\"github.com/operator/product\"],\n+        \"status\":{\"category\":\"todo\",\"name\":\"Todo\"},\n+        \"labels\":[],\"project\":\"P-1\",\"url\":\"https://github.com/operator/product/issues/1\",\n+        \"metadata\":{\n+            \"human.item_id\":claim.item_id(),\n+            \"human.owner\":request().owner,\n+            \"human.host\":claim.host(),\n+            \"human.payload_digest\":claim.payload_digest(),\n+            onetaskgraph_core::GlobalId::ORIGIN_KEY:claim.origin()\n+        }\n+    }))\n+    .expect(\"tracker evidence\")\n+}\n+\n+#[test]\n+fn only_one_verified_indexed_origin_match_can_bind_a_pending_create() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut claim = store.claim(&request(), &placement()).expect(\"claim\");\n+    claim.begin_create().expect(\"create may have happened\");\n+    let task = candidate(&claim);\n+    assert!(claim.reconcile(&request(), &[]).is_err());\n+    assert!(\n+        claim\n+            .reconcile(&request(), &[task.clone(), task.clone()])\n+            .is_err()\n+    );\n+    for key in [\n+        \"human.item_id\",\n+        \"human.payload_digest\",\n+        \"human.host\",\n+        \"onetaskgraph.origin\",\n+    ] {\n+        let mut changed = task.clone();\n+        changed.metadata.insert(key.to_owned(), json!(\"different\"));\n+        assert!(claim.reconcile(&request(), &[changed]).is_err(), \"{key}\");\n+    }\n+    let mut unindexed = task.clone();\n+    unindexed.project = None;\n+    assert!(claim.reconcile(&request(), &[unindexed]).is_err());\n+    assert_eq!(claim.phase(), IntentPhase::Creating);\n+    claim\n+        .reconcile(&request(), &[task])\n+        .expect(\"one verified positive match\");\n+    assert_eq!(claim.binding(), Some(&binding()));\n+    assert!(claim.begin_create().is_err());\n+}\n+\n+#[test]\n+fn untrusted_placement_cannot_escape_the_intent_directory() {\n+    let root = TempDir::new().expect(\"root\");\n+    for invalid in [\"../escape\".to_owned(), \"A\".repeat(64), \"g\".repeat(64)] {\n+        let mut changed = serde_json::to_value(placement()).expect(\"placement\");\n+        changed[\"identity\"] = json!(invalid);\n+        assert!(serde_json::from_value::<ProjectionPlacement>(changed).is_err());\n+    }\n+    assert_eq!(\n+        std::fs::read_dir(root.path()).expect(\"directory\").count(),\n+        0\n+    );\n+}\n+\n+#[test]\n+fn invalid_tracker_responses_never_become_durable_card_bindings() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut claim = store.claim(&request(), &placement()).expect(\"claim\");\n+    assert!(\n+        claim.bind(binding()).is_err(),\n+        \"create authority must be committed first\"\n+    );\n+    claim.begin_create().expect(\"begin create\");\n+    for (field, value) in [\n+        (\"task\", \"other:ISSUE-1\"),\n+        (\"task\", \"not-qualified\"),\n+        (\"source\", \"other\"),\n+        (\"project\", \"P-2\"),\n+        (\"url\", \"javascript:alert(1)\"),\n+        (\"url\", \"https://example.com/ bad\"),\n+    ] {\n+        let mut invalid = serde_json::to_value(binding()).expect(\"binding\");\n+        invalid[field] = json!(value);\n+        if let Ok(invalid) = serde_json::from_value(invalid) {\n+            assert!(claim.bind(invalid).is_err());\n+        }\n+    }\n+    claim.bind(binding()).expect(\"canonical response\");\n+    claim.bind(binding()).expect(\"identical binding is a no-op\");\n+    let held = binding();\n+    let different = HumanTaskProjected::new(\n+        onetaskgraph_core::task_projection::ProjectedTaskId::new(\"human:ISSUE-2\").expect(\"task id\"),\n+        held.url().clone(),\n+        held.project().clone(),\n+    );\n+    assert!(claim.bind(different).is_err(), \"a claim cannot be rebound\");\n+}\n+\n+#[test]\n+fn invalid_authority_and_blank_titles_refuse_before_persistence() {\n+    let root = TempDir::new().expect(\"root\");\n+    for (host, current) in [\n+        (\"\", \"host\"),\n+        (\"bad:host\", \"host\"),\n+        (\"host\", \"\"),\n+        (\"host\", \"bad host\"),\n+    ] {\n+        assert!(\n+            IntentStore::new(\n+                root.path().to_path_buf(),\n+                host.to_owned(),\n+                current.to_owned()\n+            )\n+            .is_err()\n+        );\n+    }\n+    assert!(IntentStore::new(\"relative\".into(), \"host\".to_owned(), \"host\".to_owned()).is_err());\n+    let mut blank = serde_json::to_value(request()).expect(\"request\");\n+    blank[\"title\"] = json!(\"  \");\n+    assert!(serde_json::from_value::<HumanTaskProjection>(blank).is_err());\n+    assert_eq!(\n+        std::fs::read_dir(root.path()).expect(\"directory\").count(),\n+        0\n+    );\n+}\n+\n+fn journal_path(root: &std::path::Path) -> std::path::PathBuf {\n+    std::fs::read_dir(root.join(\"a\".repeat(64)))\n+        .expect(\"source directory\")\n+        .map(|entry| entry.expect(\"entry\").path())\n+        .find(|path| {\n+            path.extension()\n+                .is_some_and(|extension| extension == \"json\")\n+        })\n+        .expect(\"committed journal\")\n+}\n+\n+#[test]\n+fn corrupted_persisted_evidence_never_authorizes_a_create_or_noop() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut claim = store.claim(&request(), &placement()).expect(\"claim\");\n+    claim.begin_create().expect(\"create\");\n+    claim.bind(binding()).expect(\"binding\");\n+    drop(claim);\n+    let path = journal_path(root.path());\n+    let original = std::fs::read(&path).expect(\"journal\");\n+    let document: serde_json::Value = serde_json::from_slice(&original).expect(\"journal JSON\");\n+    for (pointer, value) in [\n+        (\"/schema_version\", json!(2)),\n+        (\n+            \"/origin\",\n+            json!(format!(\"wrong-purpose:host:{}\", \"a\".repeat(64))),\n+        ),\n+        (\"/origin\", json!(\"human-task\")),\n+        (\"/origin\", json!(\"human-task:host\")),\n+        (\n+            \"/origin\",\n+            json!(format!(\"human-task:bad host:{}\", \"a\".repeat(64))),\n+        ),\n+        (\n+            \"/origin\",\n+            json!(format!(\"human-task:host:{}:extra\", \"a\".repeat(64))),\n+        ),\n+        (\"/payload_digest\", json!(\"G\".repeat(64))),\n+        (\"/item_id\", json!(\"different-item\")),\n+        (\"/host\", json!(\"different-host\")),\n+        (\n+            \"/origin\",\n+            json!(format!(\"human-task:host:{}\", \"b\".repeat(64))),\n+        ),\n+        (\"/payload_digest\", json!(\"b\".repeat(64))),\n+        (\"/phase/binding/task\", json!(\"unqualified\")),\n+        (\"/phase/binding/project\", json!(\"P-2\")),\n+        (\n+            \"/phase/binding\",\n+            json!({\n+                \"task\":\"other:ISSUE-1\",\"source\":\"other\",\"project\":\"P-1\",\n+                \"url\":\"https://github.com/operator/product/issues/1\"\n+            }),\n+        ),\n+        (\"/phase/binding/source\", json!(\"different\")),\n+        (\"/phase/binding/url\", json!(\"javascript:alert(1)\")),\n+        (\"/phase\", json!({\"kind\":\"bound\"})),\n+        (\"/phase\", json!({\"kind\":\"ready\",\"binding\":binding()})),\n+        (\n+            \"/phase/terminal\",\n+            json!({\"state\":\"open\",\"reason\":null,\"acknowledged\":true}),\n+        ),\n+    ] {\n+        let mut changed = document.clone();\n+        if pointer == \"/phase/terminal\" {\n+            changed[\"phase\"][\"terminal\"] = value;\n+        } else {\n+            *changed.pointer_mut(pointer).expect(\"existing field\") = value;\n+        }\n+        std::fs::write(&path, serde_json::to_vec(&changed).expect(\"JSON\"))\n+            .expect(\"fault injection\");\n+        assert!(store.claim(&request(), &placement()).is_err(), \"{pointer}\");\n+    }\n+    std::fs::write(&path, b\"{malformed\").expect(\"malformed journal\");\n+    assert!(store.claim(&request(), &placement()).is_err());\n+    std::fs::write(&path, original).expect(\"restore journal\");\n+    let claim = store\n+        .claim(&request(), &placement())\n+        .expect(\"restored binding\");\n+    assert_eq!(claim.binding(), Some(&binding()));\n+}\n+\n+#[test]\n+fn failed_phase_commit_returns_no_create_authority_and_retries_safely() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut claim = store\n+        .claim(&request(), &placement())\n+        .expect(\"initial intent\");\n+    let obstruction = journal_path(root.path()).with_extension(\"pending\");\n+    std::fs::create_dir(&obstruction).expect(\"obstruct atomic write\");\n+    assert!(\n+        claim.begin_create().is_err(),\n+        \"failed persistence returns no authority to send create\"\n+    );\n+    drop(claim);\n+    std::fs::remove_dir(obstruction).expect(\"remove obstruction\");\n+    let mut retry = store\n+        .claim(&request(), &placement())\n+        .expect(\"retry committed intent\");\n+    retry\n+        .begin_create()\n+        .expect(\"no earlier create could have been authorized\");\n+    drop(retry);\n+    let mut fresh = store.claim(&request(), &placement()).expect(\"fresh view\");\n+    assert!(\n+        fresh.begin_create().is_err(),\n+        \"successful phase commit cannot authorize twice\"\n+    );\n+}\n+\n+#[test]\n+fn terminal_transitions_require_a_bound_task_and_preserve_completion() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut request = request();\n+    let mut claim = store.claim(&request, &placement()).expect(\"claim\");\n+    assert!(claim.acknowledge_terminal().is_err());\n+    assert!(\n+        claim\n+            .begin_terminal(ProjectionState::Completed, None)\n+            .is_err()\n+    );\n+    claim.begin_create().expect(\"create\");\n+    claim.bind(binding()).expect(\"bind\");\n+    assert!(claim.acknowledge_terminal().is_err());\n+    assert!(claim.begin_terminal(ProjectionState::Open, None).is_err());\n+    claim\n+        .begin_terminal(ProjectionState::Completed, None)\n+        .expect(\"completion\");\n+    claim\n+        .begin_terminal(ProjectionState::Completed, None)\n+        .expect(\"same terminal is a no-op\");\n+    assert!(\n+        claim\n+            .begin_terminal(ProjectionState::Dismissed, None)\n+            .is_err()\n+    );\n+    assert!(\n+        claim\n+            .begin_terminal(ProjectionState::Completed, Some(\"changed\".to_owned()))\n+            .is_err()\n+    );\n+    claim\n+        .acknowledge_terminal()\n+        .expect(\"acknowledge completion\");\n+    drop(claim);\n+    request.state = ProjectionState::Completed;\n+    let resumed = store\n+        .claim(&request, &placement())\n+        .expect(\"cold completion retry\");\n+    assert!(resumed.terminal_acknowledged());\n+}\n+\n+#[test]\n+fn reconciliation_refuses_unverifiable_ticket_fields_and_wrong_phases() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut claim = store.claim(&request(), &placement()).expect(\"claim\");\n+    let task = candidate(&claim);\n+    assert!(\n+        claim\n+            .reconcile(&request(), std::slice::from_ref(&task))\n+            .is_err(),\n+        \"no create sent yet\"\n+    );\n+    claim.begin_create().expect(\"create may have happened\");\n+    for (field, value) in [\n+        (\"classification\", json!(\"private\")),\n+        (\"url\", serde_json::Value::Null),\n+        (\"url\", json!(\"javascript:alert(1)\")),\n+        (\"id\", json!(\"\")),\n+        (\"priority\", json!(\"none\")),\n+        (\"title\", json!(\"Different\")),\n+        (\"content\", json!(\"Different\")),\n+        (\"repositories\", json!([])),\n+    ] {\n+        let mut invalid = serde_json::to_value(&task).expect(\"task\");\n+        invalid[field] = value;\n+        assert!(\n+            claim\n+                .reconcile(\n+                    &request(),\n+                    &[serde_json::from_value(invalid).expect(\"tracker answer\")]\n+                )\n+                .is_err(),\n+            \"{field}\"\n+        );\n+    }\n+    for owner in [\n+        None,\n+        Some(json!({\"session\":\"other\",\"run\":null,\"plan\":null})),\n+    ] {\n+        let mut changed = task.clone();\n+        match owner {\n+            Some(owner) => {\n+                changed.metadata.insert(\"human.owner\".to_owned(), owner);\n+            }\n+            None => {\n+                changed.metadata.remove(\"human.owner\");\n+            }\n+        }\n+        assert!(claim.reconcile(&request(), &[changed]).is_err());\n+    }\n+    let mut changed_request = request();\n+    changed_request.title =\n+        onetaskgraph_core::task_projection::ProjectionTitle::new(\"Changed intent\").expect(\"title\");\n+    assert!(\n+        claim\n+            .reconcile(&changed_request, std::slice::from_ref(&task))\n+            .is_err()\n+    );\n+    claim\n+        .reconcile(&request(), std::slice::from_ref(&task))\n+        .expect(\"one verified answer\");\n+    assert!(\n+        claim.reconcile(&request(), &[task]).is_err(),\n+        \"already bound\"\n+    );\n+}\n+\n+#[test]\n+fn failed_binding_commit_cannot_acknowledge_or_skip_a_later_commit() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut claim = store.claim(&request(), &placement()).expect(\"claim\");\n+    claim.begin_create().expect(\"create\");\n+    let obstruction = journal_path(root.path()).with_extension(\"pending\");\n+    std::fs::create_dir(&obstruction).expect(\"obstruct binding commit\");\n+    assert!(claim.bind(binding()).is_err());\n+    assert_eq!(claim.phase(), IntentPhase::Uncertain);\n+    assert_eq!(\n+        claim.binding(),\n+        None,\n+        \"an uncommitted binding cannot be acknowledged\"\n+    );\n+    assert!(\n+        claim.bind(binding()).is_err(),\n+        \"same live claim must reopen after failed commit\"\n+    );\n+    std::fs::remove_dir(obstruction).expect(\"remove obstruction\");\n+    drop(claim);\n+    let mut reopened = store\n+        .claim(&request(), &placement())\n+        .expect(\"reopen pending create\");\n+    assert_eq!(reopened.binding(), None);\n+    assert!(\n+        reopened.begin_create().is_err(),\n+        \"a lost binding never authorizes another create\"\n+    );\n+    reopened.bind(binding()).expect(\"commit original binding\");\n+    assert_eq!(reopened.binding(), Some(&binding()));\n+}\n+\n+#[test]\n+fn failed_terminal_intent_commit_requires_reopening_before_tracker_authority() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut claim = store.claim(&request(), &placement()).expect(\"claim\");\n+    claim.begin_create().expect(\"create\");\n+    claim.bind(binding()).expect(\"bind\");\n+    let obstruction = journal_path(root.path()).with_extension(\"pending\");\n+    std::fs::create_dir(&obstruction).expect(\"obstruct terminal commit\");\n+    assert!(\n+        claim\n+            .begin_terminal(ProjectionState::Completed, None)\n+            .is_err()\n+    );\n+    assert!(\n+        claim\n+            .begin_terminal(ProjectionState::Completed, None)\n+            .is_err()\n+    );\n+    assert!(!claim.terminal_acknowledged());\n+    std::fs::remove_dir(obstruction).expect(\"remove obstruction\");\n+    drop(claim);\n+    let mut reopened = store\n+        .claim(&request(), &placement())\n+        .expect(\"reopen binding\");\n+    reopened\n+        .begin_terminal(ProjectionState::Completed, None)\n+        .expect(\"commit terminal intent\");\n+}\n+\n+#[test]\n+fn failed_acknowledgment_never_reports_a_durable_terminal_noop() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut request = request();\n+    let mut claim = store.claim(&request, &placement()).expect(\"claim\");\n+    claim.begin_create().expect(\"create\");\n+    claim.bind(binding()).expect(\"bind\");\n+    claim\n+        .begin_terminal(ProjectionState::Completed, None)\n+        .expect(\"terminal intent\");\n+    let obstruction = journal_path(root.path()).with_extension(\"pending\");\n+    std::fs::create_dir(&obstruction).expect(\"obstruct acknowledgment\");\n+    assert!(claim.acknowledge_terminal().is_err());\n+    assert!(!claim.terminal_acknowledged());\n+    assert!(claim.acknowledge_terminal().is_err());\n+    std::fs::remove_dir(obstruction).expect(\"remove obstruction\");\n+    drop(claim);\n+    request.state = ProjectionState::Completed;\n+    let mut reopened = store\n+        .claim(&request, &placement())\n+        .expect(\"reopen terminal intent\");\n+    assert!(\n+        !reopened.terminal_acknowledged(),\n+        \"failed acknowledgment did not commit\"\n+    );\n+    reopened\n+        .acknowledge_terminal()\n+        .expect(\"durable acknowledgment\");\n+    assert!(reopened.terminal_acknowledged());\n+}\n+\n+#[cfg(unix)]\n+#[test]\n+fn new_intent_directories_and_all_write_artifacts_are_private() {\n+    use std::os::unix::fs::PermissionsExt as _;\n+    let root = TempDir::new().expect(\"root\");\n+    let directory = root.path().join(\"private-store\");\n+    let store = store(&directory);\n+    let mut claim = store.claim(&request(), &placement()).expect(\"claim\");\n+    let source = directory.join(\"a\".repeat(64));\n+    for path in [&directory, &source] {\n+        assert_eq!(\n+            std::fs::metadata(path)\n+                .expect(\"directory\")\n+                .permissions()\n+                .mode()\n+                & 0o077,\n+            0\n+        );\n+    }\n+    for entry in std::fs::read_dir(&source).expect(\"source\") {\n+        assert_eq!(\n+            entry\n+                .expect(\"entry\")\n+                .metadata()\n+                .expect(\"file\")\n+                .permissions()\n+                .mode()\n+                & 0o077,\n+            0\n+        );\n+    }\n+    let path = journal_path(&directory);\n+    std::fs::remove_file(&path).expect(\"obstruct rename target\");\n+    std::fs::create_dir(&path).expect(\"directory refuses file rename\");\n+    assert!(claim.begin_create().is_err());\n+    let pending = path.with_extension(\"pending\");\n+    assert!(\n+        pending.is_file(),\n+        \"failed rename leaves the private staged file\"\n+    );\n+    assert_eq!(\n+        std::fs::metadata(pending)\n+            .expect(\"pending file\")\n+            .permissions()\n+            .mode()\n+            & 0o077,\n+        0\n+    );\n+}\n+\n+#[cfg(unix)]\n+#[test]\n+fn post_rename_sync_failure_reopens_as_a_possibly_committed_create() {\n+    use std::os::unix::fs::{MetadataExt as _, PermissionsExt as _};\n+    let root = TempDir::new().expect(\"root\");\n+    if std::fs::metadata(root.path()).expect(\"root\").uid() == 0 {\n+        // A superuser bypasses the directory-read denial used to induce this fault.\n+        eprintln!(\"directory-sync denial probe requires an ordinary Unix user\");\n+        return;\n+    }\n+    let store = store(root.path());\n+    let mut claim = store.claim(&request(), &placement()).expect(\"claim\");\n+    let directory = root.path().join(\"a\".repeat(64));\n+    // Write and traverse remain permitted: creating the staged file and renaming it\n+    // succeed, while opening the directory for the final fsync is refused.\n+    std::fs::set_permissions(&directory, std::fs::Permissions::from_mode(0o300))\n+        .expect(\"deny directory reads\");\n+    let outcome = claim.begin_create();\n+    std::fs::set_permissions(&directory, std::fs::Permissions::from_mode(0o700))\n+        .expect(\"restore directory reads\");\n+    assert!(outcome.is_err());\n+    assert_eq!(claim.phase(), IntentPhase::Uncertain);\n+    assert!(claim.begin_create().is_err());\n+    drop(claim);\n+    let mut reopened = store\n+        .claim(&request(), &placement())\n+        .expect(\"reopen installed journal\");\n+    assert_eq!(\n+        reopened.phase(),\n+        IntentPhase::Creating,\n+        \"rename installed the transition before sync failed\"\n+    );\n+    assert!(\n+        reopened.begin_create().is_err(),\n+        \"uncertain commit never authorizes a second create\"\n+    );\n+}\n+\n+#[test]\n+fn claim_establishment_filesystem_failures_recover_without_extra_create_authority() {\n+    let root = TempDir::new().expect(\"root\");\n+    let blocked_root = root.path().join(\"blocked\");\n+    std::fs::write(&blocked_root, b\"not a directory\").expect(\"directory obstruction\");\n+    let blocked_store = store(&blocked_root);\n+    assert!(blocked_store.claim(&request(), &placement()).is_err());\n+    std::fs::remove_file(blocked_root).expect(\"remove directory obstruction\");\n+    let mut recovered = blocked_store\n+        .claim(&request(), &placement())\n+        .expect(\"recovered store\");\n+    recovered\n+        .begin_create()\n+        .expect(\"first create authority after failed establishment\");\n+    drop(recovered);\n+\n+    for fault in [\"lock\", \"read\", \"initial-commit\"] {\n+        let directory = root.path().join(fault);\n+        let store = store(&directory);\n+        drop(\n+            store\n+                .claim(&request(), &placement())\n+                .expect(\"establish a ready intent\"),\n+        );\n+        let journal = journal_path(&directory);\n+        let saved = std::fs::read(&journal).expect(\"original journal\");\n+        let obstruction = match fault {\n+            \"lock\" => journal.with_extension(\"lock\"),\n+            \"read\" => journal.clone(),\n+            _ => journal.with_extension(\"pending\"),\n+        };\n+        if obstruction.exists() {\n+            std::fs::remove_file(&obstruction).expect(\"remove fault target\");\n+        }\n+        std::fs::create_dir(&obstruction).expect(\"obstruct establishment\");\n+        assert!(store.claim(&request(), &placement()).is_err(), \"{fault}\");\n+        std::fs::remove_dir(&obstruction).expect(\"remove obstruction\");\n+        if fault == \"read\" {\n+            std::fs::write(&journal, saved).expect(\"restore original journal\");\n+        }\n+        let mut claim = store\n+            .claim(&request(), &placement())\n+            .expect(\"recover establishment\");\n+        claim.begin_create().expect(\"first create authorization\");\n+        drop(claim);\n+        let mut fresh = store.claim(&request(), &placement()).expect(\"fresh view\");\n+        assert!(\n+            fresh.begin_create().is_err(),\n+            \"{fault}: no second authorization\"\n+        );\n+    }\n+}\n+\n+#[test]\n+fn recovery_accepts_tracker_repository_ordering_and_deduplication() {\n+    let root = TempDir::new().expect(\"root\");\n+    let store = store(root.path());\n+    let mut request = request();\n+    let first = request.repositories[0].clone();\n+    let second =\n+        onetaskgraph_plugin_api::Repository::try_from(\"github.com/operator/other\".to_owned())\n+            .expect(\"origin\");\n+    request.repositories = vec![first.clone(), second.clone(), first.clone()];\n+    let mut claim = store.claim(&request, &placement()).expect(\"claim\");\n+    claim.begin_create().expect(\"create\");\n+    let mut task = candidate(&claim);\n+    task.repositories = vec![second, first];\n+    claim\n+        .reconcile(&request, &[task])\n+        .expect(\"same repository set\");\n+    assert_eq!(claim.binding(), Some(&binding()));\n+}"},{"sha":"87f3d700fbf0bc1fc9dbf859215297f18ed25f48","filename":"crates/onetaskgraph-core/tests/task_projection.rs","status":"added","additions":221,"deletions":0,"changes":221,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Ftests%2Ftask_projection.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-core%2Ftests%2Ftask_projection.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-core%2Ftests%2Ftask_projection.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,221 @@\n+//! The projection domain is the one wire contract used by callers and schema consumers.\n+use onetaskgraph_core::task_projection::{HumanTaskProjected, HumanTaskProjection};\n+use serde_json::{Value, json};\n+\n+fn request() -> Value {\n+    json!({\n+        \"schema_version\": 1,\n+        \"item_id\": \"host/session/item\",\n+        \"owner\": {\"session\": \"session\", \"run\": null, \"plan\": null},\n+        \"title\": \"Review release\",\n+        \"body\": \"Decide whether to release.\",\n+        \"priority\": \"high\",\n+        \"repositories\": [\"github.com/operator/product\"],\n+        \"project\": null,\n+        \"source\": \"plans\",\n+        \"state\": \"open\",\n+        \"reason\": null\n+    })\n+}\n+\n+#[test]\n+fn projection_request_round_trips_existing_priority_and_nullable_reason() {\n+    let value = request();\n+    let parsed: HumanTaskProjection = serde_json::from_value(value.clone()).expect(\"v1\");\n+    assert_eq!(serde_json::to_value(parsed).expect(\"serialize\"), value);\n+    for reason in [None, Some(Value::Null), Some(json!(\"Not needed\"))] {\n+        let mut value = request();\n+        value[\"state\"] = json!(\"dismissed\");\n+        match reason {\n+            Some(reason) => value[\"reason\"] = reason,\n+            None => {\n+                value.as_object_mut().expect(\"mapping\").remove(\"reason\");\n+            }\n+        }\n+        let parsed: HumanTaskProjection = serde_json::from_value(value.clone()).expect(\"dismissal\");\n+        assert_eq!(parsed.reason.as_deref(), value[\"reason\"].as_str());\n+    }\n+}\n+\n+#[test]\n+fn projection_refuses_questions_unknown_fields_wrong_versions_and_malformed_origins() {\n+    for (key, invalid) in [\n+        (\"schema_version\", json!(2)),\n+        (\"schema_version\", json!(\"1\")),\n+        (\"state\", json!(\"question\")),\n+        (\"priority\", json!(\"critical\")),\n+        (\n+            \"repositories\",\n+            json!([\"https://github.com/operator/product.git\"]),\n+        ),\n+        (\"question\", json!(\"Proceed?\")),\n+        (\"item_id\", json!(12)),\n+    ] {\n+        let mut value = request();\n+        value[key] = invalid;\n+        assert!(\n+            serde_json::from_value::<HumanTaskProjection>(value).is_err(),\n+            \"{key}\"\n+        );\n+    }\n+    for key in [\"schema_version\", \"item_id\", \"owner\", \"project\", \"state\"] {\n+        let mut value = request();\n+        value.as_object_mut().expect(\"mapping\").remove(key);\n+        assert!(\n+            serde_json::from_value::<HumanTaskProjection>(value).is_err(),\n+            \"{key}\"\n+        );\n+    }\n+    for key in [\"run\", \"plan\"] {\n+        let mut value = request();\n+        value[\"owner\"]\n+            .as_object_mut()\n+            .expect(\"owner mapping\")\n+            .remove(key);\n+        assert!(\n+            serde_json::from_value::<HumanTaskProjection>(value).is_err(),\n+            \"{key}\"\n+        );\n+    }\n+    let mut value = request();\n+    value[\"owner\"][\"question\"] = json!(\"Proceed?\");\n+    assert!(serde_json::from_value::<HumanTaskProjection>(value).is_err());\n+}\n+\n+#[test]\n+fn projection_response_has_only_the_declared_card_binding() {\n+    let value = json!({\"task\":\"human:ISSUE-1\",\"url\":\"https://github.com/operator/product/issues/1\",\n+        \"project\":\"P-1\",\"source\":\"human\"});\n+    let parsed: HumanTaskProjected = serde_json::from_value(value.clone()).expect(\"binding\");\n+    assert_eq!(serde_json::to_value(parsed).expect(\"serialize\"), value);\n+    let mut invalid = value;\n+    invalid[\"question\"] = json!(\"Proceed?\");\n+    assert!(serde_json::from_value::<HumanTaskProjected>(invalid).is_err());\n+}\n+\n+#[test]\n+fn exported_projection_schemas_come_from_the_domain_declaration() {\n+    let bundle = onetaskgraph_core::schema_bundle();\n+    for (name, derived) in [\n+        (\n+            \"HumanTaskProjection\",\n+            schemars::schema_for!(HumanTaskProjection),\n+        ),\n+        (\n+            \"HumanTaskProjected\",\n+            schemars::schema_for!(HumanTaskProjected),\n+        ),\n+    ] {\n+        assert_eq!(\n+            bundle[\"roots\"][name],\n+            serde_json::to_value(derived).expect(\"schema\")\n+        );\n+    }\n+    let schema = &bundle[\"roots\"][\"HumanTaskProjection\"];\n+    let validator = jsonschema::validator_for(schema).expect(\"valid request schema\");\n+    assert!(validator.is_valid(&request()));\n+    let mut question = request();\n+    question[\"state\"] = json!(\"question\");\n+    assert!(!validator.is_valid(&question));\n+    let mut version = request();\n+    version[\"schema_version\"] = json!(2);\n+    assert!(!validator.is_valid(&version));\n+    let mut absent_reason = request();\n+    absent_reason\n+        .as_object_mut()\n+        .expect(\"mapping\")\n+        .remove(\"reason\");\n+    assert!(validator.is_valid(&absent_reason));\n+}\n+\n+#[test]\n+fn projection_identities_validate_without_changing_the_published_wire_schema() {\n+    for field in [\"item_id\", \"project\"] {\n+        let mut value = request();\n+        value[field] = json!(\"\");\n+        assert!(\n+            serde_json::from_value::<HumanTaskProjection>(value).is_err(),\n+            \"{field}\"\n+        );\n+    }\n+    for field in [\"session\", \"run\", \"plan\"] {\n+        let mut value = request();\n+        value[\"owner\"][field] = json!(\"\");\n+        assert!(\n+            serde_json::from_value::<HumanTaskProjection>(value).is_err(),\n+            \"{field}\"\n+        );\n+    }\n+    for (field, invalid) in [\n+        (\"task\", \"not-qualified\"),\n+        (\"project\", \"\"),\n+        (\"url\", \"javascript:alert(1)\"),\n+        (\"url\", \"https://\"),\n+        (\"url\", \"https://user:secret@example.com/issue/1\"),\n+    ] {\n+        let mut value = json!({\"task\":\"human:ISSUE-1\",\"project\":\"P-1\",\"source\":\"human\",\n+            \"url\":\"https://github.com/operator/product/issues/1\"});\n+        value[field] = json!(invalid);\n+        assert!(\n+            serde_json::from_value::<HumanTaskProjected>(value).is_err(),\n+            \"{field}\"\n+        );\n+    }\n+    let task =\n+        onetaskgraph_core::task_projection::ProjectedTaskId::new(\"human:ISSUE-1\").expect(\"task\");\n+    assert_eq!(task.global_id().to_string(), \"human:ISSUE-1\");\n+    let project =\n+        onetaskgraph_core::task_projection::ProjectionProjectId::new(\"P-1\").expect(\"project\");\n+    assert_eq!(project.native_id().as_str(), \"P-1\");\n+    let empty_native = onetaskgraph_core::GlobalId::new(\n+        onetaskgraph_plugin_api::SourceName::new(\"human\".to_owned()).expect(\"source\"),\n+        onetaskgraph_plugin_api::NativeId(String::new()),\n+    );\n+    assert!(onetaskgraph_core::task_projection::ProjectedTaskId::try_from(empty_native).is_err());\n+}\n+\n+#[test]\n+fn projection_identities_refuse_whitespace_and_control_characters() {\n+    for invalid in [\" item\", \"item \", \"item\\nline\", \"item\\u{0}\"] {\n+        let mut value = request();\n+        value[\"item_id\"] = json!(invalid);\n+        assert!(\n+            serde_json::from_value::<HumanTaskProjection>(value).is_err(),\n+            \"{invalid:?}\"\n+        );\n+    }\n+}\n+\n+#[test]\n+fn response_source_is_derived_and_deserialization_refuses_contradictions() {\n+    let value = json!({\"task\":\"human:ISSUE-1\",\"project\":\"P-1\",\"source\":\"human\",\n+        \"url\":\"https://github.com/operator/product/issues/1\"});\n+    let binding: HumanTaskProjected = serde_json::from_value(value.clone()).expect(\"binding\");\n+    assert_eq!(binding.source().as_str(), \"human\");\n+    assert_eq!(binding.task().global_id().source, *binding.source());\n+    let mut contradiction = value.clone();\n+    contradiction[\"source\"] = json!(\"other\");\n+    assert!(serde_json::from_value::<HumanTaskProjected>(contradiction).is_err());\n+    for field in [\"task\", \"project\", \"source\", \"url\"] {\n+        let mut missing = value.clone();\n+        missing.as_object_mut().expect(\"mapping\").remove(field);\n+        assert!(\n+            serde_json::from_value::<HumanTaskProjected>(missing).is_err(),\n+            \"{field}\"\n+        );\n+    }\n+}\n+\n+#[test]\n+fn tracker_urls_never_retain_control_characters_stripped_by_url_parsing() {\n+    for url in [\n+        \"\\0https://github.com/operator/product/issues/1\",\n+        \"https://github.com/operator/product/issues/1\\0\",\n+    ] {\n+        let value = json!({\"task\":\"human:ISSUE-1\",\"project\":\"P-1\",\"source\":\"human\",\"url\":url});\n+        assert!(\n+            serde_json::from_value::<HumanTaskProjected>(value).is_err(),\n+            \"{url:?}\"\n+        );\n+    }\n+}"},{"sha":"23048ec60e146516b77ff3bd0ce516a50cbf316d","filename":"crates/onetaskgraph-e2e-support/src/fixtures.rs","status":"modified","additions":56,"deletions":2,"changes":58,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-e2e-support%2Fsrc%2Ffixtures.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-e2e-support%2Fsrc%2Ffixtures.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-e2e-support%2Fsrc%2Ffixtures.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1116,6 +1116,12 @@ struct BoardPlacement {\n /// The board this fixture keeps, and everything a request may change on it.\n // llmlint: ignore[code_lands_in_the_domain_that_owns_it] The shared e2e harness is where the agreed e2e layout puts every loopback server, so no suite copies one: the journey-matrix table in this file builds each of its rows through both hosted plugins' loopbacks, and the engine's own suite drives both, so neither can live in one plugin's suite. Editing it re-selects every suite, as editing any shared harness does.\n struct GitHubBoard {\n+    canonical_issue_urls: bool,\n+    /// Whether `createIssue` answers without the issue's URL, so a writer learns it only by\n+    /// reading the issue.\n+    created_url_omitted: bool,\n+    /// Whether every issue's URL is answered over plain HTTP, which is no canonical card link.\n+    insecure_issue_urls: bool,\n     items: Vec<Value>,\n     /// Every comment on every issue this board holds, oldest first.\n     ///\n@@ -1751,6 +1757,32 @@ impl GitHubBoardFields {\n         board.find(&json!(id))[\"parent\"] = parent.map_or(Value::Null, |parent| json!(parent));\n     }\n \n+    /// Put `items` on this board beside what it holds, each in this board's own item shape — an\n+    /// issue a person made by hand, say, duplicating another.\n+    // llmlint: ignore[code_lands_in_the_domain_that_owns_it] A control of the loopback board's private items, which its request loop answers from: only this handle can add one, beside `use_canonical_issue_urls`.\n+    pub fn add_items(&self, items: Vec<Value>) {\n+        self.board.lock().unwrap().items.extend(items);\n+    }\n+\n+    /// Answer every issue's URL as GitHub's canonical `https://github.com/<repo>/issues/<n>`,\n+    /// for journeys whose card links to it; other journeys keep their placeholder addresses.\n+    // llmlint: ignore[code_lands_in_the_domain_that_owns_it] A control of the loopback board's own answer for every issue's URL, which its request loop composes from its private state: only this handle can switch it, beside `use_repository`.\n+    pub fn use_canonical_issue_urls(&self) {\n+        self.board.lock().unwrap().canonical_issue_urls = true;\n+    }\n+\n+    /// Answer `createIssue` without the issue's URL, so a writer has to read the issue for it.\n+    // llmlint: ignore[code_lands_in_the_domain_that_owns_it] A control of the loopback board's own answer to `createIssue`, composed by its request loop from its private state: only this handle can switch it, beside `use_canonical_issue_urls`.\n+    pub fn omit_created_issue_urls(&self) {\n+        self.board.lock().unwrap().created_url_omitted = true;\n+    }\n+\n+    /// Answer every issue's URL over plain HTTP, which no card may link to as canonical.\n+    // llmlint: ignore[code_lands_in_the_domain_that_owns_it] A control of the loopback board's own answer for every issue's URL, which its request loop composes from its private state: only this handle can switch it, beside `use_canonical_issue_urls`.\n+    pub fn serve_insecure_issue_urls(&self) {\n+        self.board.lock().unwrap().insecure_issue_urls = true;\n+    }\n+\n     /// Move the issue `id` to the repository `repository`, as a person transferring it on\n     /// GitHub would — the issue keeps its node id and its board item, and the one thing this\n     /// board says moved is its `repository`.\n@@ -2692,6 +2724,20 @@ fn board_client(endpoint: &str) -> Arc<Mutex<loopback::Upstream>> {\n }\n \n impl GitHubBoard {\n+    fn issue_url(&self, id: &str, repository: &str) -> String {\n+        if self.insecure_issue_urls {\n+            return format!(\"http://example.invalid/{id}\");\n+        }\n+        if self.canonical_issue_urls {\n+            format!(\n+                \"https://github.com/{repository}/issues/{}\",\n+                github_number(id)\n+            )\n+        } else {\n+            format!(\"https://example.invalid/{id}\")\n+        }\n+    }\n+\n     fn options(&self) -> Value {\n         Value::Array(self.status_options.clone())\n     }\n@@ -3017,7 +3063,7 @@ impl GitHubBoard {\n         }\n         json!({\"__typename\":\"Issue\",\"id\":item[\"id\"],\"title\":item[\"title\"],\"body\":item[\"body\"],\n                \"number\":github_number(item[\"id\"].as_str().unwrap()),\n-               \"url\":format!(\"https://example.invalid/{}\", item[\"id\"].as_str().unwrap()),\n+               \"url\":self.issue_url(item[\"id\"].as_str().unwrap(), item[\"repo\"].as_str().unwrap()),\n                \"createdAt\":item[\"createdAt\"],\"updatedAt\":item[\"updatedAt\"],\n                \"commentCount\":{\"totalCount\":self.comment_count(&item[\"id\"])},\n                \"relationshipEvents\":{\"totalCount\":self.timeline_count(item)},\n@@ -3603,6 +3649,9 @@ fn github_projects_board_at(\n         }\n     }\n     let board = Arc::new(Mutex::new(GitHubBoard {\n+        canonical_issue_urls: false,\n+        created_url_omitted: false,\n+        insecure_issue_urls: false,\n         items,\n         comments: Vec::new(),\n         comment_ticks: 0,\n@@ -4979,8 +5028,13 @@ fn github_answer(board: &Arc<Mutex<GitHubBoard>>, query: &str, variables: &Value\n         // GitHub answers the creating mutation with the issue's own web address and its\n         // number, which is the only place a run learns where an item it just created is,\n         // and what that item's short handle is, before this board's read catches up.\n+        let url = if board.created_url_omitted {\n+            Value::Null\n+        } else {\n+            json!(board.issue_url(&id, &board.repository))\n+        };\n         return json!({\"createIssue\":{\"issue\":{\"id\":id,\"number\":github_number(&id),\n-            \"url\":format!(\"https://example.invalid/{id}\")}}});\n+            \"url\":url}}});\n     }\n     if query.contains(\"addProjectV2ItemById(input:$input)\") {\n         assert_eq!(input[\"projectId\"], \"PVT-board\");"},{"sha":"572c8972e10e4ec1e04f473a2c7762898edbb832","filename":"crates/onetaskgraph-e2e/tests/e2e/human_routes.rs","status":"added","additions":122,"deletions":0,"changes":122,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-e2e%2Ftests%2Fe2e%2Fhuman_routes.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-e2e%2Ftests%2Fe2e%2Fhuman_routes.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-e2e%2Ftests%2Fe2e%2Fhuman_routes.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,122 @@\n+//! A human task routed across plugins by its source's `purpose: human-task` routes: an\n+//! organization's work sent from a GitHub board to that organization's Linear workspace, into\n+//! the plan's existing project there, and nothing of it written to the board.\n+\n+use serde_json::{Value, json};\n+\n+use crate::common::{Sandbox, stderr, stdout};\n+use crate::fixtures::{\n+    document, github_projects_with_items, linear_default_mapping, linear_workspace,\n+};\n+\n+const HOST: &str = \"routing-host\";\n+\n+#[test]\n+fn an_organizations_human_task_routes_from_a_board_to_its_plan_project_in_linear() {\n+    let sandbox = Sandbox::new();\n+    let (mut board_config, board) = github_projects_with_items(\n+        &sandbox,\n+        vec![\n+            json!({\"item\":\"ITEM-PROJECT-1\",\"id\":\"PROJECT-1\",\"type\":\"Issue\",\"title\":\"Human tasks\",\n+            \"body\":\"Waiting on a person.\\n\\n<!-- onetaskgraph.metadata\\n{\\\"onetaskgraph.item_kind\\\":\\\"project\\\"}\\n-->\",\n+            \"state\":\"OPEN\",\"reason\":null,\"parent\":null,\"repo\":\"nickderobertis/onetaskgraph\",\n+            \"status\":\"Todo\",\"origin\":\"\",\"labels\":[]}),\n+        ],\n+    );\n+    board_config[\"priority_mapping\"] = json!({});\n+    let mut data = crate::fixtures::dataset();\n+    data[\"task_dependencies\"] = json!([]);\n+    let (mut linear_config, workspace) = linear_workspace(&sandbox, data);\n+    linear_config[\"status_mapping\"] = linear_default_mapping();\n+    let intents = sandbox.subdirectory(\"intents\");\n+    let projection =\n+        |project: &str| json!({\"host\": HOST, \"directory\": intents, \"project\": project});\n+    let configure = |route: Value| {\n+        sandbox.project_document(&document(&json!({\n+            \"human\": {\"plugin\": \"github-projects\", \"config\": board_config, \"routes\": [route],\n+                      \"cache\": {\"dir\": sandbox.subdirectory(\"cache-human\")},\n+                      \"task_projection\": projection(\"PROJECT-1\")},\n+            \"org\": {\"plugin\": \"linear\", \"config\": linear_config,\n+                    \"cache\": {\"dir\": sandbox.subdirectory(\"cache-org\")},\n+                    \"task_projection\": projection(\"P-1\")}\n+        })));\n+    };\n+    configure(\n+        json!({\"repositories\": [\"github.com/orgco/*\"], \"purpose\": \"human-task\",\n+                     \"to\": \"org\"}),\n+    );\n+    let request = json!({\"schema_version\": 1, \"item_id\": \"org-review\",\n+        \"owner\": {\"session\": \"session-1\", \"run\": null, \"plan\": \"plan-1\"},\n+        \"title\": \"Approve the organization's release\", \"body\": \"Sign off on the release.\",\n+        \"priority\": \"high\", \"repositories\": [\"github.com/orgco/service\"],\n+        \"project\": \"org:P-1\", \"source\": \"human\", \"state\": \"open\", \"reason\": null});\n+    let path = sandbox.project().join(\"request.json\");\n+    std::fs::write(&path, request.to_string()).unwrap();\n+    let board_before = board.served().len();\n+    let output = sandbox\n+        .command()\n+        .args([\"task\", \"project-human\", \"--input\"])\n+        .arg(&path)\n+        .arg(\"--json\")\n+        .env(\"ONETASKGRAPH_HOST\", HOST)\n+        .env(\"GITHUB_PROJECTS_FIXTURE_TOKEN\", \"test-token\")\n+        .output()\n+        .unwrap();\n+    assert_eq!(output.status.code(), Some(0), \"{}\", stderr(&output));\n+    let answer: Value = serde_json::from_str(&stdout(&output)).unwrap();\n+    assert_eq!(answer[\"source\"], \"org\");\n+    assert_eq!(answer[\"project\"], \"P-1\");\n+    assert!(\n+        answer[\"url\"]\n+            .as_str()\n+            .unwrap()\n+            .starts_with(\"https://linear.app/\"),\n+        \"{answer}\"\n+    );\n+    assert!(\n+        workspace\n+            .served()\n+            .iter()\n+            .any(|(query, _)| query.contains(\"issueCreate\")),\n+        \"created in Linear\"\n+    );\n+    assert_eq!(\n+        board.served().len(),\n+        board_before,\n+        \"the board was sent nothing\"\n+    );\n+\n+    // Without the purpose the same entry is a legacy route the human task does not take: it\n+    // stays with the board it was sent to, which files a sub-issue only in a repository of its\n+    // project issue's owner and so refuses it — and Linear is sent no create.\n+    configure(json!({\"repositories\": [\"github.com/orgco/*\"], \"to\": \"org\"}));\n+    let mut stays = request;\n+    stays[\"item_id\"] = json!(\"org-review-unscoped\");\n+    stays[\"project\"] = Value::Null;\n+    std::fs::write(&path, stays.to_string()).unwrap();\n+    let creates = |workspace: &crate::fixtures::LinearWorkspace| {\n+        workspace\n+            .served()\n+            .iter()\n+            .filter(|(query, _)| query.contains(\"issueCreate\"))\n+            .count()\n+    };\n+    let linear_creates = creates(&workspace);\n+    let output = sandbox\n+        .command()\n+        .args([\"task\", \"project-human\", \"--input\"])\n+        .arg(&path)\n+        .arg(\"--json\")\n+        .env(\"ONETASKGRAPH_HOST\", HOST)\n+        .env(\"GITHUB_PROJECTS_FIXTURE_TOKEN\", \"test-token\")\n+        .output()\n+        .unwrap();\n+    assert_ne!(output.status.code(), Some(0), \"{}\", stdout(&output));\n+    let failure: Value = serde_json::from_str(&stdout(&output)).unwrap();\n+    assert_eq!(failure[\"failure\"][\"source\"], \"human\", \"{failure}\");\n+    assert_eq!(\n+        creates(&workspace),\n+        linear_creates,\n+        \"Linear was sent no create\"\n+    );\n+}"},{"sha":"c3644a2c03fde3a2d8ba8c2aa63e14baf947eeac","filename":"crates/onetaskgraph-e2e/tests/e2e/main.rs","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-e2e%2Ftests%2Fe2e%2Fmain.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-e2e%2Ftests%2Fe2e%2Fmain.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-e2e%2Ftests%2Fe2e%2Fmain.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -112,6 +112,8 @@ mod failures;\n // edge, which AGENTS.md forbids depending on the engine at any depth; what the GitHub Projects\n // plugin owes it is proven behind that plugin's own edge, in its e2e suite.\n mod graph;\n+// llmlint: ignore[expensive_tests_stay_behind_their_own_edge] Not expensive, and there is no narrower edge for it: it drives the binary against a loopback board and Linear workspace with no credential and no network in about a second. Routing a human task across two plugins is the engine's and the configuration's, so it cannot sit behind one plugin crate's edge, which AGENTS.md forbids depending on the engine at any depth.\n+mod human_routes;\n mod journeys;\n // `task locate` against the copy after it: placement, counterpart and refusals.\n // llmlint: ignore[expensive_tests_stay_behind_their_own_edge] No credential and no network: the journeys drive the binary against folders of Markdown, the loopback board and a counting Linear stand-in, with the released onevcs boundary commands behind a recorder, in seconds. What they prove — that locate places and looks up through the copy's own path — is the engine's, so no plugin crate's edge is narrower, and AGENTS.md forbids any plugin crate to depend on the engine."},{"sha":"cda0f34b68320291006d3354786b5521d56cbc83","filename":"crates/onetaskgraph-e2e/tests/e2e/surface.rs","status":"modified","additions":5,"deletions":1,"changes":6,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-e2e%2Ftests%2Fe2e%2Fsurface.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-e2e%2Ftests%2Fe2e%2Fsurface.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-e2e%2Ftests%2Fe2e%2Fsurface.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -42,6 +42,7 @@ const SURFACE: &[(&[&str], &[&str])] = &[\n     (&[\"help\", \"cache\", \"clear\"], &[\"[SOURCE]\", \"--json\"]),\n     (&[\"help\", \"task\", \"show\"], &[\"--pin\", \"--no-comments\"]),\n     (&[\"help\", \"task\", \"show-many\"], &[\"--pin\", \"--no-comments\"]),\n+    (&[\"help\", \"task\", \"project-human\"], &[\"--input\"]),\n     (&[\"help\", \"task\", \"comment\", \"list\"], &[\"--pin\"]),\n     (&[\"help\", \"task\", \"deps\"], &[\"--pin\", \"--direction\"]),\n     (&[\"help\", \"project\", \"deps\"], &[\"--pin\", \"--direction\"]),\n@@ -301,7 +302,9 @@ fn schema_emits_a_bundle_covering_every_contract_root_and_plugin_config() {\n     let bundle: serde_json::Value =\n         serde_json::from_slice(&output.stdout).expect(\"schema output is valid JSON\");\n \n-    assert_eq!(bundle[\"version\"], 49);\n+    assert_eq!(bundle[\"version\"], 50);\n+    assert!(bundle[\"roots\"][\"HumanTaskProjection\"].is_object());\n+    assert!(bundle[\"roots\"][\"HumanTaskProjected\"].is_object());\n     assert!(bundle[\"roots\"][\"LocateReport\"].is_object());\n     assert_eq!(\n         bundle[\"roots\"][\"SourceRoute\"][\"properties\"][\"reachable\"][\"type\"], \"array\",\n@@ -431,6 +434,7 @@ fn schema_emits_a_bundle_covering_every_contract_root_and_plugin_config() {\n             \"task render\",\n             \"task answers\",\n             \"task assets\",\n+            \"task project-human\",\n             \"project list\",\n             \"project show\",\n             \"project deps\","},{"sha":"0ab16ed90500b8a93064bc792efc8bd023948fbd","filename":"crates/onetaskgraph-github-projects-e2e/budgets.yaml","status":"modified","additions":17,"deletions":4,"changes":21,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Fbudgets.yaml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Fbudgets.yaml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Fbudgets.yaml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -202,14 +202,27 @@ budgets:\n     threshold: 40\n   - id: github-approval-calls-points\n     description: >-\n-      An inner measure of the shared board token that no check may spend: the GitHub GraphQL points the four store calls approving a plan's design document on a 2,000-item loopback board spend, priced with the plugin's own point-cost table, the larger of the sequence with no write policy and the sequence screened through the released onevcs boundary commands. It protects every manager's share of that token from what an approval spends.\n+      Modelled GitHub GraphQL points of one complete plan design approval, its review task's creation and resolution included, on a 2,000-item board, screened or not. It protects every manager's share of the board token.\n     labels: [github]\n     measure: reported\n-    # llmlint: ignore[budget_commands_measure_directly] This command reports the telemetry the `approval` journey measured in the crate's test run, refusing any other recording; onebudgetspec judges the figure.\n-    command: [\"cargo\", \"test\", \"--quiet\", \"-p\", \"onetaskgraph-github-projects-e2e\", \"--all-features\", \"--locked\", \"--test\", \"e2e\", \"--\", \"budget_runner::report_approval_calls\", \"--exact\", \"--nocapture\"]\n+    # llmlint: ignore[budget_commands_measure_directly] This task fixes the `node crates/onetaskgraph-github-projects-e2e/human-items/approval-report.mjs` surface, spelled from this file's directory, which onebudgetspec runs every command in: it reads only the telemetry the `approval` journey saved in the crate's test run, refuses any other recording, and reports one figure through the onebudgetspec SDK, which alone judges it.\n+    command: [\"node\", \"human-items/approval-report.mjs\"]\n     unit: points\n     direction: max\n-    threshold: 5\n+    threshold: 13\n+    timeout_seconds: 30\n+  # llmlint: ignore[budgets_track_product_owner_outcomes] Manager-approved for this design: the per-item budget covers every human task lifecycle on its own, independently of the complete approval flow (`github-approval-calls-points`) that also includes one, because the 100-item, 10-manager workload is what spends the shared token and an approval total cannot show one item's lifecycle regressing.\n+  - id: human-task-projection-points\n+    description: >-\n+      Modelled GitHub GraphQL points per human task projected through its whole lifecycle by simultaneous managers onto a shared screened board. It protects every manager's share of the board token.\n+    labels: [github]\n+    measure: reported\n+    # llmlint: ignore[budget_commands_measure_directly] This task fixes the `node crates/onetaskgraph-github-projects-e2e/human-items/report.mjs` surface, spelled from this file's directory, which onebudgetspec runs every command in: it reads only the telemetry `tests/e2e/human_cost.rs` saved in the crate's test run, refuses any other recording, and reports one figure through the onebudgetspec SDK, which alone judges it.\n+    command: [\"node\", \"human-items/report.mjs\"]\n+    unit: points\n+    direction: max\n+    threshold: 7.3\n+    timeout_seconds: 30\n   # llmlint: ignore[budgets_track_product_owner_outcomes] The user ruled that every store operation the engine uses carries its own per-backend request bound, paired with the engine's backend-agnostic store-operation budgets (its hold loop with the dependency reads, each dispatch with the status writes); a session or hourly total cannot show one operation's requests regressing, which is what this bound is for.\n   - id: github-requests-per-dependency-read\n     description: >-"},{"sha":"35bbeffe9eb21c9f62a62d98148d6eb28ee1bffd","filename":"crates/onetaskgraph-github-projects-e2e/human-items/approval-report.mjs","status":"added","additions":61,"deletions":0,"changes":61,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Fhuman-items%2Fapproval-report.mjs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Fhuman-items%2Fapproval-report.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Fhuman-items%2Fapproval-report.mjs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,61 @@\n+// `github-approval-calls-points`: the modelled GraphQL points of one complete design approval\n+// `tests/e2e/approval.rs` recorded in the crate's test run — its review task created through\n+// `task project-human`, the four existing store calls, and the review resolved — the larger of\n+// the unscreened and the screened sequence, handed to onebudgetspec with each call and the split\n+// between existing calls and the review's projection as its detail. Reads saved telemetry only.\n+import { report } from \"@onebudgetspec/sdk\";\n+import { recorded, run, sum } from \"./telemetry.mjs\";\n+\n+const BUDGET = \"github-approval-calls-points\";\n+const WORKLOAD = \"plan approval store calls\";\n+const CALLS = [\n+  \"task project-human (review open)\",\n+  \"project show\",\n+  \"task list --project\",\n+  \"document list --project\",\n+  \"document metadata set --expect\",\n+  \"task project-human (review completed)\",\n+];\n+\n+// One mode's figures, refused unless its calls are the approval's, in order, each counting its\n+// requests and points, adding up.\n+function mode(telemetry, name) {\n+  const spent = telemetry[name];\n+  if (!spent || !Array.isArray(spent.calls)) throw Error(`the recording has no ${name} sequence`);\n+  if (JSON.stringify(spent.calls.map((call) => call.call)) !== JSON.stringify(CALLS))\n+    throw Error(`the ${name} sequence does not name the approval's calls in order`);\n+  sum(spent.calls, \"requests\");\n+  const projection = spent.calls.filter((call) => call.call.startsWith(\"task project-human\"));\n+  if (\n+    sum(spent.calls, \"points\") !== spent.points ||\n+    sum(projection, \"points\") !== spent.projection ||\n+    spent.existing + spent.projection !== spent.points\n+  )\n+    throw Error(`the ${name} sequence's points do not add up`);\n+  return spent;\n+}\n+\n+const reported = run(BUDGET, () => {\n+  const telemetry = recorded(BUDGET, WORKLOAD);\n+  if (telemetry.board !== 2000 || telemetry.tasks !== 8 || telemetry.documents !== 1)\n+    throw Error(\"the recording is not of a plan of 8 tasks and 1 document on a 2000-item board\");\n+  const unscreened = mode(telemetry, \"unscreened\");\n+  const screened = mode(telemetry, \"screened\");\n+  const value = Math.max(unscreened.points, screened.points);\n+  if (value !== telemetry.value) throw Error(\"the recording's figure is not its larger sequence\");\n+  const split = ({ points, existing, projection, calls }) => ({\n+    points,\n+    existing,\n+    projection,\n+    calls,\n+  });\n+  return {\n+    value,\n+    detail: JSON.stringify({\n+      unit: \"primary modelled GraphQL points\",\n+      unscreened: split(unscreened),\n+      screened: split(screened),\n+    }),\n+  };\n+});\n+if (reported) report(reported.value, reported.detail);"},{"sha":"6ca41fa92d349fec16d55bebfb18921686a7c39a","filename":"crates/onetaskgraph-github-projects-e2e/human-items/report.mjs","status":"added","additions":51,"deletions":0,"changes":51,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Fhuman-items%2Freport.mjs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Fhuman-items%2Freport.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Fhuman-items%2Freport.mjs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,51 @@\n+// `human-task-projection-points`: the modelled GraphQL points per item of the projection\n+// lifecycle `tests/e2e/human_cost.rs` recorded in the crate's test run, handed to onebudgetspec\n+// with each operation's and phase's requests, points, aliased mutation fields and secondary\n+// points as its detail. Reads saved telemetry only; re-runs nothing.\n+import { report } from \"@onebudgetspec/sdk\";\n+import { recorded, run, sum } from \"./telemetry.mjs\";\n+\n+const BUDGET = \"human-task-projection-points\";\n+const WORKLOAD = \"human task projection lifecycle\";\n+const COUNTS = [\"requests\", \"points\", \"mutation_fields\", \"secondary_points\"];\n+\n+const reported = run(BUDGET, () => {\n+  const telemetry = recorded(BUDGET, WORKLOAD);\n+  const { tasks, managers, board_items, screened, totals, phases, operations } = telemetry;\n+  if (tasks !== 100 || managers !== 10 || board_items !== 2000 || screened !== true)\n+    throw Error(\"the recording is not of 100 tasks from 10 managers on a screened 2000-item board\");\n+  for (const field of COUNTS) {\n+    if (sum(phases, field) !== totals[field] || sum(operations, field) !== totals[field])\n+      throw Error(`the recording's ${field} do not add up to its total`);\n+  }\n+  for (const phase of [\"create\", \"terminal\", \"create_recovery\", \"cold_terminal_retry\"]) {\n+    if (!phases.some((row) => row.phase === phase && row.requests > 0))\n+      throw Error(`the recording has no ${phase} phase`);\n+  }\n+  const { terminals, recoveries } = telemetry;\n+  if (\n+    terminals?.completed !== 34 ||\n+    terminals?.dismissed_without_reason !== 33 ||\n+    terminals?.dismissed_with_reason !== 33 ||\n+    recoveries?.create !== 10 ||\n+    recoveries?.cold_terminal !== 10 ||\n+    recoveries?.warm_noop !== 10\n+  )\n+    throw Error(\"the recording is not of the registered terminals and recoveries\");\n+  return {\n+    value: totals.points / tasks,\n+    detail: JSON.stringify({\n+      unit: \"primary modelled GraphQL points per item\",\n+      tasks,\n+      managers,\n+      board_items,\n+      terminals: telemetry.terminals,\n+      recoveries: telemetry.recoveries,\n+      secondary_model: telemetry.secondary_model,\n+      totals,\n+      phases,\n+      operations,\n+    }),\n+  };\n+});\n+if (reported) report(reported.value, reported.detail);"},{"sha":"69d7e23ea0407ac26d880750d43ef47a98db891c","filename":"crates/onetaskgraph-github-projects-e2e/human-items/telemetry.mjs","status":"added","additions":53,"deletions":0,"changes":53,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Fhuman-items%2Ftelemetry.mjs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Fhuman-items%2Ftelemetry.mjs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Fhuman-items%2Ftelemetry.mjs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,53 @@\n+// The saved telemetry the crate's own `test` target recorded, as both human-items reporters read\n+// it: nothing here measures, and nothing here judges a figure — onebudgetspec does.\n+import { readFileSync } from \"node:fs\";\n+import { dirname, join } from \"node:path\";\n+import { fileURLToPath } from \"node:url\";\n+\n+const root = join(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\", \"..\");\n+\n+// Where `onetaskgraph-github-projects-e2e:test` writes its telemetry — the directory its\n+// `outputs` declare — or wherever GITHUB_ASSET_TELEMETRY_DIR moved it, as the journeys honour.\n+export function telemetryDirectory() {\n+  return (\n+    process.env.GITHUB_ASSET_TELEMETRY_DIR ??\n+    join(root, \"target\", \"debug\", \"telemetry\", \"onetaskgraph-github-projects-e2e\")\n+  );\n+}\n+\n+// The recording of `budget`, refused unless it is that budget's, of `workload`.\n+export function recorded(budget, workload) {\n+  const path = join(telemetryDirectory(), `${budget}.json`);\n+  let telemetry;\n+  try {\n+    telemetry = JSON.parse(readFileSync(path, \"utf8\"));\n+  } catch (error) {\n+    throw Error(`no telemetry at ${path}: ${error.message}`);\n+  }\n+  if (telemetry.budget !== budget || telemetry.workload !== workload)\n+    throw Error(`${path} is not the ${workload} recording of ${budget}`);\n+  return telemetry;\n+}\n+\n+// The sum of `field` over `rows`, each a non-negative integer.\n+export function sum(rows, field) {\n+  return rows.reduce((total, row) => {\n+    if (!Number.isInteger(row[field]) || row[field] < 0)\n+      throw Error(`a row's ${field} is not a count: ${JSON.stringify(row)}`);\n+    return total + row[field];\n+  }, 0);\n+}\n+\n+export function run(budget, reporter) {\n+  try {\n+    const { value, detail } = reporter();\n+    console.log(JSON.stringify({ budget, value }));\n+    return { value, detail };\n+  } catch (error) {\n+    console.error(\n+      `${budget}: ${error.message}; next: run onetaskgraph-github-projects-e2e:test, then the reporter again`,\n+    );\n+    process.exitCode = 1;\n+    return null;\n+  }\n+}"},{"sha":"3e5ae91d67c1afafe9824228f8e698be1a208a97","filename":"crates/onetaskgraph-github-projects-e2e/tests/e2e/approval.rs","status":"modified","additions":231,"deletions":42,"changes":273,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fapproval.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fapproval.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fapproval.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,18 +1,20 @@\n //! What approving a plan on a board costs: the store calls an approval makes, each through the\n-//! real binary against the loopback board of `plan_copy` holding 2,000 other items — `project\n-//! show`, `task list --project`, `document list --project`, then `document metadata set\n-//! --expect` carrying the version that listing reported for the design document. The listing\n-//! carries the document whole, exactly as `document show` would answer it, so approval reads it\n-//! once.\n+//! real binary against the loopback board of `plan_copy` holding 2,000 other items — the review\n+//! task `task project-human` creates under the plan's project, `project show`, `task list\n+//! --project`, `document list --project`, then `document metadata set --expect` carrying the\n+//! version that listing reported for the design document, and last the review task resolved\n+//! through `task project-human`. The listing carries the document whole, exactly as `document\n+//! show` would answer it, so approval reads it once.\n //!\n //! Each call's requests are priced by the plugin's own point-cost table, the one\n //! `tests/point_cost.rs` pins and the credentialed lane reconciles against GitHub, and what the\n-//! sequence spent is recorded as the `github-approval-calls-points` budget's telemetry, which\n-//! `budget_runner::report_approval_calls` hands to onebudgetspec. Nothing here holds the total\n-//! to a bound: that is the budget's. What is held here is what each call sends, that the\n-//! records come back whole and in order, that the binary waits for nothing on the way, and that\n-//! a write expecting a version the board has moved past — whoever moved it, and whether or not\n-//! anything here saw it — writes nothing.\n+//! sequence spent — split into the existing calls and the review's projection — is recorded as\n+//! the `github-approval-calls-points` budget's telemetry, which `human-items/approval-report.mjs`\n+//! hands to onebudgetspec. Nothing here holds the total to a bound: that is the budget's. What\n+//! is held here is what each call sends, that the records come back whole and in order, that the\n+//! existing calls wait for nothing on the way, that the review task is created once and resolved\n+//! once, and that a write expecting a version the board has moved past — whoever moved it, and\n+//! whether or not anything here saw it — writes nothing and leaves the review open.\n \n use super::asset_board::{Call, Kind};\n use super::plan_copy::{Plan, SMALL, TASKS, counterparts, never_walks, operation, success};\n@@ -26,14 +28,26 @@ pub(super) const BUDGET: &str = \"github-approval-calls-points\";\n /// Named in the recording, so the runner refuses telemetry another journey wrote.\n pub(super) const WORKLOAD: &str = \"plan approval store calls\";\n \n-/// The calls an approval makes, in the order it makes them, by what each is.\n-pub(super) const CALLS: [&str; 4] = [\n+/// The calls an approval makes, in the order it makes them, by what each is: the review task's\n+/// creation, the four existing store calls, and the review task's resolution.\n+pub(super) const CALLS: [&str; 6] = [\n+    REVIEW_OPEN,\n     \"project show\",\n     \"task list --project\",\n     \"document list --project\",\n     \"document metadata set --expect\",\n+    REVIEW_RESOLVED,\n ];\n \n+/// The review task's creation through `task project-human`.\n+const REVIEW_OPEN: &str = \"task project-human (review open)\";\n+\n+/// The review task's resolution through `task project-human`.\n+const REVIEW_RESOLVED: &str = \"task project-human (review completed)\";\n+\n+/// The host every approval's configuration names as authoritative over its projections.\n+const HOST: &str = \"approval-host\";\n+\n const KEY: &str = \"plan.approval\";\n \n /// The read that holds a guarded write to the version: the document, with its project and the\n@@ -100,11 +114,76 @@ fn shown_version(plan: &Plan, id: &str) -> String {\n     version_of(&success(&plan.run(&[\"document\", \"show\", id, \"--json\"])))\n }\n \n+/// Give the board source the projection authority a review task is written under: this host,\n+/// an intent directory in the plan's sandbox, and the plan's project.\n+fn authorize_reviews(plan: &Plan, project: &str) {\n+    let path = plan.sandbox.project().join(\"onetaskgraph.yaml\");\n+    let mut configured: Value =\n+        serde_json::from_str(&std::fs::read_to_string(&path).unwrap()).unwrap();\n+    configured[\"sources\"][\"board\"][\"task_projection\"] = json!({\"host\": HOST,\n+        \"directory\": plan.sandbox.subdirectory(\"intents\"), \"project\": project});\n+    // Where the kept placement lives: the board's cache directory, inside this sandbox, whether\n+    // or not the cache itself is on.\n+    if configured[\"sources\"][\"board\"][\"cache\"][\"dir\"].is_null() {\n+        configured[\"sources\"][\"board\"][\"cache\"][\"dir\"] =\n+            json!(plan.sandbox.subdirectory(\"board-cache\"));\n+    }\n+    plan.sandbox.project_document(&configured.to_string());\n+}\n+\n+/// The review task of the plan whose project is `project`, at `state`.\n+fn review(plan: &Plan, project: &str, state: &str) -> Value {\n+    let repository = plan\n+        .github\n+        .repository_of(project)\n+        .expect(\"the plan's project issue\");\n+    let request = json!({\"schema_version\": 1, \"item_id\": format!(\"review-{project}\"),\n+        \"owner\": {\"session\": \"manager-session\", \"run\": \"run-1\", \"plan\": \"plan-1\"},\n+        \"title\": \"Review the plan's design\", \"body\": \"Approve the design or say what changes.\",\n+        \"priority\": \"high\", \"repositories\": [format!(\"github.com/{repository}\")],\n+        \"project\": format!(\"board:{project}\"), \"source\": \"board\", \"state\": state,\n+        \"reason\": null});\n+    let path = plan.sandbox.project().join(format!(\"review-{state}.json\"));\n+    std::fs::write(&path, request.to_string()).unwrap();\n+    json!(path)\n+}\n+\n+/// Project the review task at `state`, with what the board answered.\n+fn project_review(plan: &Plan, project: &str, state: &str, what: &'static str) -> Step {\n+    let path = review(plan, project, state);\n+    let screened = plan.boundary_calls().len();\n+    let (output, calls) = plan.measured_with(\n+        &[\n+            \"task\",\n+            \"project-human\",\n+            \"--input\",\n+            path.as_str().unwrap(),\n+            \"--json\",\n+        ],\n+        &[(\"ONETASKGRAPH_HOST\", HOST)],\n+    );\n+    Step {\n+        what,\n+        report: success(&output),\n+        calls,\n+        screening: plan.boundary_calls()[screened..].to_vec(),\n+    }\n+}\n+\n fn approve(plan: &Plan, project: &str, document: &str) -> Vec<Step> {\n+    authorize_reviews(plan, project);\n+    let mut steps = vec![project_review(plan, project, \"open\", REVIEW_OPEN)];\n+    steps.extend(approve_existing(plan, project, document));\n+    steps.push(project_review(plan, project, \"completed\", REVIEW_RESOLVED));\n+    steps\n+}\n+\n+/// The four existing store calls of an approval, as they were before a review task joined them.\n+fn approve_existing(plan: &Plan, project: &str, document: &str) -> Vec<Step> {\n     let project = format!(\"board:{project}\");\n     let document = format!(\"board:{document}\");\n     let mut steps = Vec::new();\n-    for what in &CALLS[..3] {\n+    for what in &CALLS[1..4] {\n         let verb = match *what {\n             \"project show\" => vec![\"project\", \"show\", &project, \"--json\"],\n             \"task list --project\" => vec![\"task\", \"list\"],\n@@ -137,7 +216,7 @@ fn approve(plan: &Plan, project: &str, document: &str) -> Vec<Step> {\n         \"--json\",\n     ]);\n     steps.push(Step {\n-        what: CALLS[3],\n+        what: CALLS[4],\n         report,\n         calls,\n         screening: plan.boundary_calls()[screened..].to_vec(),\n@@ -204,38 +283,61 @@ fn breakdown(steps: &[Step]) -> Vec<Value> {\n         .collect()\n }\n \n+/// What `steps` spent, in points: all of them, the existing calls', and the review's.\n+fn spent(steps: &[Step]) -> Value {\n+    spent_of(breakdown(steps))\n+}\n+\n+/// What one sequence's `calls` — each `{call, requests, points, ...}` — spent, in points: all\n+/// of them, the existing calls', and the review's.\n+pub(super) fn spent_of(calls: Vec<Value>) -> Value {\n+    let total = |keep: &dyn Fn(&str) -> bool| -> u64 {\n+        calls\n+            .iter()\n+            .filter(|call| keep(call[\"call\"].as_str().unwrap()))\n+            .map(|call| call[\"points\"].as_u64().unwrap())\n+            .sum()\n+    };\n+    let review = |call: &str| call == REVIEW_OPEN || call == REVIEW_RESOLVED;\n+    json!({\"points\": total(&|_| true), \"existing\": total(&|call| !review(call)),\n+           \"projection\": total(&review), \"calls\": calls})\n+}\n+\n /// Record what the sequence spent as the budget's telemetry: the larger of the run with no\n-/// write policy and the run with write screening on, each call's requests and points beside\n-/// it, and both runs in the detail.\n+/// write policy and the run with write screening on, each split into the existing store calls\n+/// and the review task's projection, with both runs' calls in the detail.\n fn record(unscreened: &[Step], screened: &[Step]) {\n-    let total =\n-        |steps: &[Step]| -> u64 { steps.iter().flat_map(|step| &step.calls).map(points).sum() };\n-    let larger = if total(screened) > total(unscreened) {\n-        screened\n-    } else {\n-        unscreened\n-    };\n     let directory = super::budget_runner::directory();\n     std::fs::create_dir_all(&directory).unwrap();\n     std::fs::write(\n         onetaskgraph_e2e_support::telemetry::file_in(&directory, BUDGET),\n-        serde_json::to_vec(&json!({\"budget\": BUDGET, \"value\": total(larger),\n-            \"detail\": json!({\"unscreened\": {\"points\": total(unscreened), \"calls\": breakdown(unscreened)},\n-                             \"screened\": {\"points\": total(screened), \"calls\": breakdown(screened)}})\n-                .to_string(),\n-            \"workload\": WORKLOAD, \"board\": SMALL, \"tasks\": TASKS, \"documents\": 1,\n-            \"calls\": breakdown(larger)}))\n-        .unwrap(),\n+        serde_json::to_vec_pretty(&recording(spent(unscreened), spent(screened))).unwrap(),\n     )\n     .unwrap();\n }\n \n+/// The budget's telemetry over the two sequences' figures, the larger as its value.\n+pub(super) fn recording(unscreened: Value, screened: Value) -> Value {\n+    let larger = unscreened[\"points\"]\n+        .as_u64()\n+        .max(screened[\"points\"].as_u64());\n+    json!({\"budget\": BUDGET, \"value\": larger,\n+        \"workload\": WORKLOAD, \"board\": SMALL, \"tasks\": TASKS, \"documents\": 1,\n+        \"call_order\": CALLS, \"unscreened\": unscreened, \"screened\": screened})\n+}\n+\n #[test]\n fn approving_a_plan_lists_each_kind_in_one_point_and_writes_its_approval_behind_one_read() {\n     let (plan, project, document) = copied(false);\n+    authorize_reviews(&plan, &project);\n+    let opened = project_review(&plan, &project, \"open\", REVIEW_OPEN);\n     let waits_before = plan.clock.slept().len();\n-    let steps = approve(&plan, &project, &document);\n+    let existing = approve_existing(&plan, &project, &document);\n     let waits: Vec<_> = plan.clock.slept()[waits_before..].to_vec();\n+    let resolved = project_review(&plan, &project, \"completed\", REVIEW_RESOLVED);\n+    let mut steps = vec![opened];\n+    steps.extend(existing);\n+    steps.push(resolved);\n     // Every wait the binary schedules — pacing, a secondary limit, a backoff — is recorded on the\n     // clock with its cause, and the board answers nothing to a binary not attached to it, so a\n     // count of none is a record of none rather than an absence of one.\n@@ -251,10 +353,11 @@ fn approving_a_plan_lists_each_kind_in_one_point_and_writes_its_approval_behind_\n     }\n     let step = |what: &str| steps.iter().find(|step| step.what == what).unwrap();\n \n-    // Each listing is one request, priced at one point, carrying the project's whole page.\n+    // Each listing is one request, priced at one point, carrying the project's whole page — the\n+    // plan's tasks and the review task filed under the same project.\n     // llmlint: ignore-block[tests_hold_no_nonfunctional_thresholds] The node's acceptance criteria require this journey to show each listing is one request priced at one point by the plugin's own table: the point is the functional outcome of MEMBER_PAGE_SIZE, which `tests/point_cost.rs` pins, rather than a budget figure. The sequence's total is recorded below for onebudgetspec, which alone judges it against `github-approval-calls-points`.\n     for (what, records) in [\n-        (\"task list --project\", TASKS),\n+        (\"task list --project\", TASKS + 1),\n         (\"document list --project\", 1),\n     ] {\n         let listing = step(what);\n@@ -272,17 +375,21 @@ fn approving_a_plan_lists_each_kind_in_one_point_and_writes_its_approval_behind_\n     }\n     // llmlint: ignore-end[tests_hold_no_nonfunctional_thresholds]\n \n-    // The tasks come back in the order they were filed under the project, each with what a read\n-    // of it by its own id reports.\n+    // The tasks come back in the order they were filed under the project, the review task last,\n+    // each with what a read of it by its own id reports.\n     let listed = rows(&step(\"task list --project\").report);\n     let titles: Vec<String> = listed.iter().map(|(_, title)| title.clone()).collect();\n-    let filed: Vec<String> = (1..=TASKS)\n+    let mut filed: Vec<String> = (1..=TASKS)\n         .map(|n| format!(\"Step {n} of the plan\"))\n         .collect();\n+    filed.push(\"Review the plan's design\".to_owned());\n     assert_eq!(titles, filed);\n+    // The review task is resolved since it was listed, so the plan's own tasks are compared.\n     for row in step(\"task list --project\").report[\"items\"]\n         .as_array()\n         .unwrap()\n+        .iter()\n+        .filter(|row| row[\"item\"][\"metadata\"].get(\"human.item_id\").is_none())\n     {\n         let id = format!(\"board:{}\", row[\"item\"][\"id\"].as_str().unwrap());\n         let shown = success(&plan.run(&[\"task\", \"show\", &id, \"--no-comments\", \"--json\"]));\n@@ -316,7 +423,7 @@ fn approving_a_plan_lists_each_kind_in_one_point_and_writes_its_approval_behind_\n     // write, and its one check passed before that write.\n     let (screened_plan, screened_project, screened_document) = copied_screened();\n     let screened = approve(&screened_plan, &screened_project, &screened_document);\n-    let write = &screened[3];\n+    let write = &screened[4];\n     assert_eq!(\n         sent(&write.calls),\n         GUARDED_WRITE,\n@@ -335,17 +442,99 @@ fn approving_a_plan_lists_each_kind_in_one_point_and_writes_its_approval_behind_\n         .find(|call| call.creating)\n         .expect(\"the write\");\n     assert!(checks[0].finished < updated.wall, \"checked before it wrote\");\n-    for step in &screened[..3] {\n+    for step in &screened[1..4] {\n         assert!(step.screening.is_empty(), \"{} screened nothing\", step.what);\n     }\n+    // The review task's own writes are screened like every other public write.\n+    for step in [&screened[0], &screened[5]] {\n+        assert!(\n+            step.screening\n+                .iter()\n+                .any(|call| call.command == BoundaryCommand::Check),\n+            \"{} was screened\",\n+            step.what\n+        );\n+    }\n     assert_eq!(\n         slot(&screened_plan, &screened_document)[KEY],\n         json!(\"approved\")\n     );\n \n+    // The review task was created once, under the plan's project, before the approval, and\n+    // resolved once after it — on the board both times, as one issue.\n+    for (plan, project, steps) in [\n+        (&plan, &project, &steps),\n+        (&screened_plan, &screened_project, &screened),\n+    ] {\n+        let opened = &steps[0].report;\n+        let resolved = &steps[5].report;\n+        assert_eq!(opened, resolved);\n+        assert_eq!(opened[\"project\"], json!(project));\n+        assert_eq!(opened[\"source\"], \"board\");\n+        let review = opened[\"task\"]\n+            .as_str()\n+            .unwrap()\n+            .strip_prefix(\"board:\")\n+            .unwrap();\n+        assert_eq!(\n+            plan.github.state(review),\n+            (\"CLOSED\".to_owned(), Some(\"COMPLETED\".to_owned()))\n+        );\n+        assert_eq!(plan.github.status(review).as_deref(), Some(\"Done\"));\n+        assert_eq!(\n+            plan.github\n+                .issues()\n+                .iter()\n+                .find(|issue| issue[\"id\"] == json!(review))\n+                .unwrap()[\"parent\"],\n+            json!(project)\n+        );\n+    }\n+\n     record(&steps, &screened);\n }\n \n+#[test]\n+fn a_stale_version_refuses_the_approval_and_leaves_its_review_task_open() {\n+    let (plan, project, document) = copied(false);\n+    authorize_reviews(&plan, &project);\n+    let opened = project_review(&plan, &project, \"open\", REVIEW_OPEN).report;\n+    let review = opened[\"task\"]\n+        .as_str()\n+        .unwrap()\n+        .strip_prefix(\"board:\")\n+        .unwrap()\n+        .to_owned();\n+    let id = format!(\"board:{document}\");\n+    let stale = shown_version(&plan, &id);\n+    plan.github\n+        .edit_body(&document, \"Edited on the board after the version was read.\");\n+    let (refused, calls) = set_expecting(&plan, &id, KEY, &stale);\n+    assert_ne!(refused.status.code(), Some(0), \"{}\", stdout(&refused));\n+    assert_eq!(sent(&calls), [GUARDED_READ], \"nothing was written\");\n+    let failure: Value = serde_json::from_str(&stdout(&refused)).expect(\"a failure document\");\n+    assert_eq!(failure[\"failure\"][\"kind\"], \"version-moved\", \"{failure}\");\n+    assert!(\n+        !plan.github.body(&document).as_str().unwrap().contains(KEY),\n+        \"the refused approval wrote nothing\"\n+    );\n+    // The refused approval resolved nothing: the review task is open on the board.\n+    assert_eq!(plan.github.state(&review).0, \"OPEN\");\n+    assert_eq!(plan.github.status(&review).as_deref(), Some(\"Todo\"));\n+\n+    // With the version the board holds now, the approval lands and the review is resolved.\n+    let current = shown_version(&plan, &id);\n+    let (landed, _) = set_expecting(&plan, &id, KEY, &current);\n+    assert_eq!(landed.status.code(), Some(0), \"{}\", stderr(&landed));\n+    assert_eq!(slot(&plan, &document)[KEY], json!(true));\n+    let resolved = project_review(&plan, &project, \"completed\", REVIEW_RESOLVED).report;\n+    assert_eq!(resolved, opened);\n+    assert_eq!(\n+        plan.github.state(&review),\n+        (\"CLOSED\".to_owned(), Some(\"COMPLETED\".to_owned()))\n+    );\n+}\n+\n #[test]\n fn a_document_write_expecting_a_version_the_board_has_moved_past_unseen_is_refused() {\n     for cache in [false, true] {\n@@ -494,20 +683,20 @@ fn a_screened_approval_reclassifies_a_project_a_person_changed_since_and_refuses\n     let first = approve(&plan, &project, &document);\n     assert_eq!(slot(&plan, &document)[KEY], json!(\"approved\"));\n     assert!(\n-        first[3]\n+        first[4]\n             .screening\n             .iter()\n             .all(|call| call.command != BoundaryCommand::Inspect\n                 || call.input[\"repository\"] != \"github.com/synthco/secret-gadgets\"),\n         \"{:?}\",\n-        first[3].screening\n+        first[4].screening\n     );\n     plan.screening\n         .as_mut()\n         .expect(\"a screened plan\")\n         .0\n         .private(\"synthco\", \"secret-gadgets\");\n-    let members = rows(&first[1].report);\n+    let members = rows(&first[2].report);\n     let moved = members[2].0.clone();\n     let body = plan.github.body(&moved);\n     let (content, held) = body"},{"sha":"5f90b928f3fa95a663ad7489594495321e932dbf","filename":"crates/onetaskgraph-github-projects-e2e/tests/e2e/asset_board.rs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fasset_board.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fasset_board.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fasset_board.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -133,7 +133,7 @@ impl Kind {\n /// mutation — read by brace depth, so a nested selection is never counted, and leaving out each\n /// field an `@include(if:$name)` whose variable is false, or a `@skip(if:$name)` whose variable\n /// is true, keeps from being sent.\n-fn top_level_fields(document: &str, variables: &Value) -> usize {\n+pub(super) fn top_level_fields(document: &str, variables: &Value) -> usize {\n     let sent = |name: &str| variables.get(name).and_then(Value::as_bool);\n     let mut excluded = 0;\n     for (directive, keeps) in [(\"@include(if:$\", true), (\"@skip(if:$\", false)] {"},{"sha":"2897068853c0aec0d7f3b356636941aba127604e","filename":"crates/onetaskgraph-github-projects-e2e/tests/e2e/budget_runner.rs","status":"modified","additions":0,"deletions":179,"changes":179,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fbudget_runner.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fbudget_runner.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fbudget_runner.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -171,18 +171,6 @@ fn report_metadata_fields() {\n     let (value, detail) = metadata_field_share(&budget).unwrap_or_else(|error| refuse(&error));\n     hand_over(value, &detail);\n }\n-// llmlint: ignore-block[budget_commands_measure_directly] This entry reports the telemetry the `approval` journey measured in the crate's test run, refusing any other recording; onebudgetspec judges the figure.\n-#[test]\n-fn report_approval_calls() {\n-    let Some(budget) = selected() else {\n-        return;\n-    };\n-    let (value, detail) =\n-        approval_calls_of(&recorded(&budget).unwrap_or_else(|error| refuse(&error)))\n-            .unwrap_or_else(|error| refuse(&error));\n-    hand_over(value, &detail);\n-}\n-// llmlint: ignore-end[budget_commands_measure_directly]\n // llmlint: ignore-block[budget_commands_measure_directly] Every budget of this crate selects its own report-only entry here, the harness-runner convention it landed with (report_visibility_reads, report_metadata_fields), and the task registering the plan-copy budgets names this one entry for all seven of them. It reads only the telemetry `plan_copy.rs` recorded during the crate's ordinary test run, refuses a recording of another plan, board size or scenario, and hands the figure to onebudgetspec, which alone judges it.\n #[test]\n fn report_plan_copy() {\n@@ -397,173 +385,6 @@ fn the_plan_copy_report_hands_over_the_recorded_figure_and_refuses_another_workl\n     }\n }\n \n-/// What `approval.rs` recorded, refused unless it is that journey's recording of the approval\n-/// sequence on a board of 2,000 items over a plan of eight tasks and one document, with each\n-/// call of the sequence in its breakdown and their points adding up to the figure.\n-fn approval_calls_of(value: &Value) -> Result<(f64, String), String> {\n-    use super::approval::{CALLS, WORKLOAD};\n-    if value[\"workload\"].as_str() != Some(WORKLOAD) {\n-        return Err(\"the recording is not of the approval sequence\".into());\n-    }\n-    if value[\"board\"].as_u64() != Some(super::plan_copy::SMALL as u64)\n-        || value[\"tasks\"].as_u64() != Some(super::plan_copy::TASKS as u64)\n-        || value[\"documents\"].as_u64() != Some(1)\n-    {\n-        return Err(\n-            \"the recording is not of a project of 8 tasks and 1 document on a board of 2000 items\"\n-                .into(),\n-        );\n-    }\n-    let figure = value[\"value\"]\n-        .as_u64()\n-        .ok_or(\"missing whole-number figure\")?;\n-    let calls = value[\"calls\"].as_array().ok_or(\"missing call breakdown\")?;\n-    if calls.len() != CALLS.len() {\n-        return Err(\"the breakdown does not name the approval's calls in order\".into());\n-    }\n-    let mut points = 0;\n-    for (call, named) in calls.iter().zip(CALLS) {\n-        if call[\"call\"].as_str() != Some(named) {\n-            return Err(\"the breakdown does not name the approval's calls in order\".into());\n-        }\n-        let (Some(_), Some(spent)) = (call[\"requests\"].as_u64(), call[\"points\"].as_u64()) else {\n-            return Err(\"a call of the breakdown has no whole requests and points\".into());\n-        };\n-        points = u64::checked_add(points, spent).ok_or(\"the breakdown's points overflow\")?;\n-    }\n-    if points != figure {\n-        return Err(\"the breakdown does not add up to the figure\".into());\n-    }\n-    let detail = value[\"detail\"].as_str().ok_or(\"missing detail\")?.to_owned();\n-    let figure = u32::try_from(figure).map_err(|_| \"figure out of range\")?;\n-    Ok((f64::from(figure), detail))\n-}\n-\n-#[test]\n-fn the_approval_report_entry_hands_over_only_a_recording_of_the_approval() {\n-    use onetaskgraph_e2e_support::common::Sandbox;\n-    use serde_json::json;\n-    let sandbox = Sandbox::new();\n-    let directory = sandbox.subdirectory(\"approval\");\n-    std::fs::create_dir_all(&directory).unwrap();\n-    let budget = super::approval::BUDGET;\n-    let run = |recorded: &Value| {\n-        let path = onetaskgraph_e2e_support::telemetry::file_in(&directory, budget);\n-        std::fs::write(&path, recorded.to_string()).unwrap();\n-        let result = directory.join(\"result.json\");\n-        let _ = std::fs::remove_file(&result);\n-        let output = std::process::Command::new(std::env::current_exe().unwrap())\n-            .args([\n-                \"budget_runner::report_approval_calls\",\n-                \"--exact\",\n-                \"--nocapture\",\n-            ])\n-            .env(\"GITHUB_ASSET_TELEMETRY_DIR\", &directory)\n-            .env(\"ONEBUDGETSPEC_BUDGET_ID\", budget)\n-            .env(\"ONEBUDGETSPEC_RESULT\", &result)\n-            .output()\n-            .unwrap();\n-        (output, std::fs::read_to_string(&result).ok())\n-    };\n-    let calls: Vec<Value> = super::approval::CALLS\n-        .iter()\n-        .map(|call| json!({\"call\": call, \"requests\": 1, \"points\": 1}))\n-        .collect();\n-    let valid = json!({\"budget\": budget, \"value\": calls.len(), \"detail\": \"recorded\",\n-        \"workload\": super::approval::WORKLOAD, \"board\": super::plan_copy::SMALL,\n-        \"tasks\": super::plan_copy::TASKS, \"documents\": 1, \"calls\": calls});\n-    let (output, written) = run(&valid);\n-    assert!(\n-        output.status.success(),\n-        \"{}\",\n-        String::from_utf8_lossy(&output.stderr)\n-    );\n-    let written: Value = serde_json::from_str(&written.expect(\"a figure\")).unwrap();\n-    assert_eq!(\n-        written[\"value\"].as_f64(),\n-        Some(super::approval::CALLS.len() as f64),\n-        \"{written}\"\n-    );\n-\n-    let mut other = valid.clone();\n-    other[\"workload\"] = json!(\"a plan copy\");\n-    let (output, written) = run(&other);\n-    assert!(!output.status.success(), \"accepted another workload\");\n-    assert!(\n-        String::from_utf8_lossy(&output.stderr).contains(\"not of the approval sequence\"),\n-        \"{}\",\n-        String::from_utf8_lossy(&output.stderr)\n-    );\n-    assert_eq!(written, None, \"reported a figure over another workload\");\n-}\n-\n-#[test]\n-fn the_approval_report_hands_over_the_recorded_figure_and_refuses_another_workload() {\n-    use serde_json::json;\n-    let calls: Vec<Value> = super::approval::CALLS\n-        .iter()\n-        .map(|call| {\n-            // The guarded write is a read and the write, each a point.\n-            let spent = if call.starts_with(\"document metadata set\") {\n-                2\n-            } else {\n-                1\n-            };\n-            json!({\"call\": call, \"requests\": spent, \"points\": spent})\n-        })\n-        .collect();\n-    let valid = json!({\"budget\": super::approval::BUDGET, \"value\": 5, \"detail\": \"recorded\",\n-        \"workload\": super::approval::WORKLOAD, \"board\": super::plan_copy::SMALL,\n-        \"tasks\": super::plan_copy::TASKS, \"documents\": 1, \"calls\": calls});\n-    assert_eq!(approval_calls_of(&valid), Ok((5.0, \"recorded\".to_owned())));\n-    let with = |pointer: &str, replaced: Value| {\n-        let mut changed = valid.clone();\n-        *changed.pointer_mut(pointer).unwrap() = replaced;\n-        changed\n-    };\n-    for (recorded, refusal) in [\n-        (\n-            with(\"/workload\", json!(\"a plan copy\")),\n-            \"not of the approval sequence\",\n-        ),\n-        (\n-            with(\"/board\", json!(super::plan_copy::LARGE)),\n-            \"board of 2000 items\",\n-        ),\n-        (with(\"/tasks\", json!(9)), \"8 tasks and 1 document\"),\n-        (\n-            with(\"/calls/1/call\", json!(\"project list\")),\n-            \"calls in order\",\n-        ),\n-        (with(\"/calls/1/call\", json!(null)), \"calls in order\"),\n-        (\n-            {\n-                let mut longer = valid.clone();\n-                longer[\"calls\"]\n-                    .as_array_mut()\n-                    .unwrap()\n-                    .push(json!({\"requests\": 1, \"points\": 0}));\n-                longer\n-            },\n-            \"calls in order\",\n-        ),\n-        (\n-            with(\"/calls/2/requests\", json!(-1)),\n-            \"no whole requests and points\",\n-        ),\n-        (\n-            with(\"/calls/3/points\", json!(null)),\n-            \"no whole requests and points\",\n-        ),\n-        (with(\"/value\", json!(4)), \"does not add up\"),\n-        (with(\"/value\", json!(5.5)), \"whole-number figure\"),\n-        (with(\"/detail\", json!(null)), \"missing detail\"),\n-    ] {\n-        let refused = approval_calls_of(&recorded).expect_err(refusal);\n-        assert!(refused.contains(refusal), \"{refused}\");\n-    }\n-}\n-\n /// The workload `metadata_fields.rs` records: one follow-up copied once and re-copied twice\n /// unchanged, with a projected host and without one.\n pub(super) const METADATA_FIELD_WORKLOAD: &str = \"metadata-field-follow-up\";"},{"sha":"0f67f871335d4a97938f08849ccae6b525ac5d8e","filename":"crates/onetaskgraph-github-projects-e2e/tests/e2e/human_cost.rs","status":"added","additions":334,"deletions":0,"changes":334,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_cost.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_cost.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_cost.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,334 @@\n+//! What projecting human tasks costs a shared board: 100 items projected through the binary by\n+//! 10 simultaneous managers onto one screened loopback board of 2,000 items, each resolved once —\n+//! 34 completed, 33 dismissed with no reason and 33 with one — with ten creates whose answer is\n+//! lost and recovered, ten terminal writes whose answer is lost and retried cold, and ten warm\n+//! retries after them.\n+//!\n+//! Every request is priced by the plugin's own point-cost table; every aliased mutation field is\n+//! counted beside it and charged five secondary points, a read one. The recording is the\n+//! `human-task-projection-points` budget's telemetry, which `human-items/report.mjs` hands to\n+//! onebudgetspec. What is held here is what the tickets are, never what they cost.\n+\n+use std::path::PathBuf;\n+use std::process::{Command, Output, Stdio};\n+use std::sync::{Arc, Mutex};\n+\n+use onetaskgraph_e2e_support::common::{Sandbox, stderr, stdout};\n+use onetaskgraph_e2e_support::fixtures::{GitHubBoardFields, document};\n+use onetaskgraph_e2e_support::onevcs::{BoundaryRecord, OnevcsHome};\n+use onetaskgraph_github_projects::worst_case_point_cost;\n+use serde_json::{Value, json};\n+\n+use super::human_items::{HOST, PROJECT, PUBLIC_REPOSITORY, board, native, slot};\n+\n+pub(super) const BUDGET: &str = \"human-task-projection-points\";\n+\n+/// Named in the recording, so the reporter refuses telemetry another journey wrote.\n+pub(super) const WORKLOAD: &str = \"human task projection lifecycle\";\n+\n+const TASKS: usize = 100;\n+const MANAGERS: usize = 10;\n+const BOARD_ITEMS: usize = 2_000;\n+\n+/// The secondary points a mutation's every aliased field is charged, as the plugin's pacing\n+/// model charges it; a read is charged one.\n+const SECONDARY_PER_FIELD: u64 = 5;\n+\n+/// One host: the screened board every manager projects onto, and the intents they share.\n+struct Host {\n+    sandbox: Sandbox,\n+    board: GitHubBoardFields,\n+    home: OnevcsHome,\n+    _record: BoundaryRecord,\n+}\n+\n+impl Host {\n+    fn new() -> Self {\n+        let sandbox = Sandbox::new();\n+        let items = (0..BOARD_ITEMS - 1)\n+            .map(super::plan_copy::background)\n+            .collect();\n+        let board = board(&sandbox, items);\n+        let (owner, name) = PUBLIC_REPOSITORY.split_once('/').unwrap();\n+        let mut home = OnevcsHome::new(&sandbox);\n+        home.public(owner, name);\n+        let record = home.recorded(&sandbox);\n+        let intents: PathBuf = sandbox.subdirectory(\"intents\");\n+        let sources = json!({\"human\": {\n+            \"plugin\": \"github-projects\", \"config\": board.config, \"visibility\": \"public\",\n+            \"cache\": {\"dir\": sandbox.subdirectory(\"cache-human\")},\n+            \"task_projection\": {\"host\": HOST, \"directory\": intents, \"project\": PROJECT}}});\n+        let mut configured: Value = serde_json::from_str(&document(&sources)).unwrap();\n+        configured[\"write_policy\"] = record.write_policy().clone();\n+        sandbox.project_document(&configured.to_string());\n+        Self {\n+            sandbox,\n+            board: board.fields,\n+            home,\n+            _record: record,\n+        }\n+    }\n+\n+    /// The binary projecting `request` with `token` as its board credential.\n+    fn command(&self, request: &Value, token: &str) -> Command {\n+        let path = self.sandbox.project().join(format!(\n+            \"request-{}-{}.json\",\n+            request[\"item_id\"].as_str().unwrap(),\n+            request[\"state\"].as_str().unwrap()\n+        ));\n+        std::fs::write(&path, request.to_string()).unwrap();\n+        let mut command = self.sandbox.subprocess(onetaskgraph_e2e_support::binary());\n+        command\n+            .args([\"task\", \"project-human\", \"--input\"])\n+            .arg(&path)\n+            .arg(\"--json\")\n+            .env(\"ONETASKGRAPH_HOST\", HOST)\n+            .env(\"ONEVCS_HOME\", self.home.path())\n+            .env(\"GITHUB_PROJECTS_FIXTURE_TOKEN\", token);\n+        command\n+    }\n+\n+    fn project(&self, request: &Value, token: &str) -> Value {\n+        let output: Output = self.command(request, token).output().unwrap();\n+        assert_eq!(\n+            output.status.code(),\n+            Some(0),\n+            \"{}\\n{}\",\n+            stdout(&output),\n+            stderr(&output)\n+        );\n+        serde_json::from_str(&stdout(&output)).unwrap()\n+    }\n+\n+    /// Project `request`, the binary killed once the board applied the first request carrying\n+    /// `operation` — its answer never reaching it.\n+    fn crashed(&self, request: &Value, token: &str, operation: &'static str) {\n+        let mut command = self.command(request, token);\n+        command.stdout(Stdio::null()).stderr(Stdio::null());\n+        let child = Arc::new(Mutex::new(command.spawn().unwrap()));\n+        let killed = Arc::clone(&child);\n+        self.board.after_request(\n+            move |query: &str, _: &Value| query.contains(operation),\n+            0,\n+            move |_| {\n+                let _ = killed.lock().unwrap().kill();\n+            },\n+        );\n+        let status = loop {\n+            if let Some(status) = child.lock().unwrap().try_wait().unwrap() {\n+                break status;\n+            }\n+            std::thread::sleep(std::time::Duration::from_millis(5));\n+        };\n+        assert!(!status.success(), \"the binary finished before {operation}\");\n+    }\n+\n+    /// What `token` has been sent from request `from` on, as one phase's priced row.\n+    fn row(&self, token: &str, from: usize, phase: &str) -> Value {\n+        let requests = self.board.served_to(token)[from..].to_vec();\n+        let priced: Vec<Value> = requests\n+            .iter()\n+            .map(|(query, variables)| {\n+                let mutation = query.trim_start().starts_with(\"mutation\");\n+                let fields = if mutation {\n+                    super::asset_board::top_level_fields(query, variables) as u64\n+                } else {\n+                    0\n+                };\n+                json!({\"operation\": super::plan_copy::operation_name(query),\n+                       \"points\": worst_case_point_cost(query).expect(\"a priced document\"),\n+                       \"mutation_fields\": fields,\n+                       \"secondary_points\": if mutation { SECONDARY_PER_FIELD * fields } else { 1 }})\n+            })\n+            .collect();\n+        json!({\"phase\": phase, \"requests\": priced.len(), \"priced\": priced})\n+    }\n+\n+    fn sent(&self, token: &str) -> usize {\n+        self.board.served_to(token).len()\n+    }\n+}\n+\n+/// Item `n`'s open request, owned by its manager's session.\n+fn open(n: usize) -> Value {\n+    json!({\"schema_version\": 1, \"item_id\": format!(\"human-item-{n}\"),\n+        \"owner\": {\"session\": format!(\"manager-{}\", n / 10), \"run\": null, \"plan\": null},\n+        \"title\": format!(\"Review synthetic decision {n}\"),\n+        \"body\": \"Choose the next public example.\", \"priority\": \"high\",\n+        \"repositories\": [format!(\"github.com/{PUBLIC_REPOSITORY}\")],\n+        \"project\": null, \"source\": \"human\", \"state\": \"open\", \"reason\": null})\n+}\n+\n+/// Item `n`'s terminal request: completed for every third, dismissed otherwise — with a reason\n+/// for every third of those.\n+fn terminal(n: usize) -> Value {\n+    let mut request = open(n);\n+    match n % 3 {\n+        0 => request[\"state\"] = json!(\"completed\"),\n+        1 => request[\"state\"] = json!(\"dismissed\"),\n+        _ => {\n+            request[\"state\"] = json!(\"dismissed\");\n+            request[\"reason\"] = json!(\"Superseded by another example.\");\n+        }\n+    }\n+    request\n+}\n+\n+/// Item `n`'s one ticket, held to what its terminal request says.\n+fn settled(board: &GitHubBoardFields, n: usize, answer: &Value) {\n+    let id = native(answer);\n+    let needle = format!(\"\\\"human.item_id\\\":\\\"human-item-{n}\\\"\");\n+    let tickets = board\n+        .issues()\n+        .into_iter()\n+        .filter(|issue| {\n+            issue[\"body\"]\n+                .as_str()\n+                .is_some_and(|body| body.contains(&needle))\n+        })\n+        .count();\n+    assert_eq!(tickets, 1, \"item {n} has one ticket\");\n+    let reason = if n.is_multiple_of(3) {\n+        \"COMPLETED\"\n+    } else {\n+        \"NOT_PLANNED\"\n+    };\n+    assert_eq!(\n+        board.state(&id),\n+        (\"CLOSED\".to_owned(), Some(reason.to_owned())),\n+        \"item {n}\"\n+    );\n+    let held = slot(board, &id);\n+    assert_eq!(\n+        held.get(\"human.reason\").and_then(Value::as_str),\n+        (n % 3 == 2).then_some(\"Superseded by another example.\"),\n+        \"item {n}\"\n+    );\n+    assert!(\n+        answer[\"url\"]\n+            .as_str()\n+            .unwrap()\n+            .starts_with(&format!(\"https://github.com/{PUBLIC_REPOSITORY}/issues/\")),\n+        \"{answer}\"\n+    );\n+}\n+\n+/// Every priced request of `rows`, summed by operation and in total.\n+fn summed(rows: &[Value], key: &str) -> Vec<Value> {\n+    let mut by: std::collections::BTreeMap<String, [u64; 4]> = std::collections::BTreeMap::new();\n+    for row in rows {\n+        if key == \"phase\" {\n+            by.entry(row[\"phase\"].as_str().unwrap().to_owned())\n+                .or_default();\n+        }\n+        for request in row[\"priced\"].as_array().unwrap() {\n+            let name = if key == \"operation\" {\n+                request[\"operation\"].as_str().unwrap().to_owned()\n+            } else {\n+                row[\"phase\"].as_str().unwrap().to_owned()\n+            };\n+            let entry = by.entry(name).or_default();\n+            entry[0] += 1;\n+            entry[1] += request[\"points\"].as_u64().unwrap();\n+            entry[2] += request[\"mutation_fields\"].as_u64().unwrap();\n+            entry[3] += request[\"secondary_points\"].as_u64().unwrap();\n+        }\n+    }\n+    by.into_iter()\n+        .map(|(name, [requests, points, fields, secondary])| {\n+            json!({key: name, \"requests\": requests, \"points\": points,\n+                   \"mutation_fields\": fields, \"secondary_points\": secondary})\n+        })\n+        .collect()\n+}\n+\n+#[test]\n+fn a_hundred_tasks_from_ten_managers_are_projected_recovered_and_resolved_once_each() {\n+    let host = Host::new();\n+    // Nine of each manager's ten items, every manager at once.\n+    let rows: Vec<Value> = std::thread::scope(|scope| {\n+        let handles: Vec<_> = (0..MANAGERS)\n+            .map(|manager| {\n+                let host = &host;\n+                scope.spawn(move || {\n+                    let token = format!(\"test-token-projection-{manager}\");\n+                    let mut rows = Vec::new();\n+                    for offset in 1..10 {\n+                        let n = manager * 10 + offset;\n+                        let from = host.sent(&token);\n+                        let created = host.project(&open(n), &token);\n+                        rows.push(host.row(&token, from, \"create\"));\n+                        let from = host.sent(&token);\n+                        let resolved = host.project(&terminal(n), &token);\n+                        rows.push(host.row(&token, from, \"terminal\"));\n+                        assert_eq!(resolved, created, \"item {n}\");\n+                        settled(&host.board, n, &resolved);\n+                    }\n+                    rows\n+                })\n+            })\n+            .collect();\n+        handles\n+            .into_iter()\n+            .flat_map(|handle| handle.join().unwrap())\n+            .collect()\n+    });\n+    let mut rows = rows;\n+    // Each manager's first item, one manager after another so each crash lands where it is\n+    // meant to: its create's answer lost and recovered, its terminal's lost and retried cold,\n+    // and a warm retry after.\n+    for manager in 0..MANAGERS {\n+        let n = manager * 10;\n+        let token = format!(\"test-token-projection-{manager}\");\n+        let from = host.sent(&token);\n+        host.crashed(&open(n), &token, \"addSubIssue\");\n+        rows.push(host.row(&token, from, \"create\"));\n+        let from = host.sent(&token);\n+        let recovered = host.project(&open(n), &token);\n+        rows.push(host.row(&token, from, \"create_recovery\"));\n+        let from = host.sent(&token);\n+        host.crashed(&terminal(n), &token, \"updateIssue(input\");\n+        rows.push(host.row(&token, from, \"terminal\"));\n+        let from = host.sent(&token);\n+        let retried = host.project(&terminal(n), &token);\n+        rows.push(host.row(&token, from, \"cold_terminal_retry\"));\n+        let from = host.sent(&token);\n+        let warm = host.project(&terminal(n), &token);\n+        rows.push(host.row(&token, from, \"warm_noop\"));\n+        assert_eq!(retried, recovered, \"item {n}\");\n+        assert_eq!(warm, recovered, \"item {n}\");\n+        settled(&host.board, n, &warm);\n+    }\n+\n+    let directory = super::budget_runner::directory();\n+    std::fs::create_dir_all(&directory).unwrap();\n+    std::fs::write(\n+        onetaskgraph_e2e_support::telemetry::file_in(&directory, BUDGET),\n+        serde_json::to_vec_pretty(&recording(&rows)).unwrap(),\n+    )\n+    .unwrap();\n+}\n+\n+/// The budget's telemetry over `rows`, each one phase's priced requests: what the reporter\n+/// reads, summed by phase and by operation.\n+pub(super) fn recording(rows: &[Value]) -> Value {\n+    let phases = summed(rows, \"phase\");\n+    let operations = summed(rows, \"operation\");\n+    let total = |field: &str| -> u64 {\n+        phases\n+            .iter()\n+            .map(|phase| phase[field].as_u64().unwrap())\n+            .sum()\n+    };\n+    let totals = json!({\"requests\": total(\"requests\"), \"points\": total(\"points\"),\n+        \"mutation_fields\": total(\"mutation_fields\"),\n+        \"secondary_points\": total(\"secondary_points\")});\n+    json!({\n+        \"budget\": BUDGET, \"workload\": WORKLOAD, \"tasks\": TASKS, \"managers\": MANAGERS,\n+        \"board_items\": BOARD_ITEMS, \"screened\": true,\n+        \"terminals\": {\"completed\": 34, \"dismissed_without_reason\": 33,\n+                      \"dismissed_with_reason\": 33},\n+        \"recoveries\": {\"create\": MANAGERS, \"cold_terminal\": MANAGERS, \"warm_noop\": MANAGERS},\n+        \"secondary_model\": {\"per_mutation_field\": SECONDARY_PER_FIELD, \"per_read\": 1},\n+        \"totals\": totals, \"phases\": phases, \"operations\": operations})\n+}"},{"sha":"4dfd5ee7e6a5222a7ea1cb16c706d9ee2d35cbff","filename":"crates/onetaskgraph-github-projects-e2e/tests/e2e/human_items.rs","status":"added","additions":1329,"deletions":0,"changes":1329,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_items.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_items.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_items.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,1329 @@\n+//! Human task projection through the binary: `task project-human --input FILE --json` against\n+//! loopback GitHub boards — the lifecycle of one item, its retries, its crashes, its routing and\n+//! its refusals, each observed as the tickets the boards hold and the requests they answered.\n+\n+use std::path::PathBuf;\n+\n+use onetaskgraph_e2e_support::common::{Sandbox, stderr, stdout};\n+use onetaskgraph_e2e_support::fixtures::{GitHubBoardFields, document, github_projects_with_items};\n+use onetaskgraph_github_projects::graphql;\n+use serde_json::{Value, json};\n+\n+/// The host every journey's configuration names as the authority over its projections.\n+pub(super) const HOST: &str = \"projection-host\";\n+\n+/// The repository the boards create their issues in.\n+pub(super) const PUBLIC_REPOSITORY: &str = \"synthco/public-widgets\";\n+\n+/// The project issue every planless item is filed under.\n+pub(super) const PROJECT: &str = \"PROJECT-1\";\n+\n+/// The project issue a board holds for planless human tasks.\n+pub(super) fn project_item(id: &str, repository: &str) -> Value {\n+    json!({\"item\":format!(\"ITEM-{id}\"),\"id\":id,\"type\":\"Issue\",\"title\":\"Human tasks\",\n+        \"body\":\"Work waiting on a person.\\n\\n<!-- onetaskgraph.metadata\\n{\\\"onetaskgraph.item_kind\\\":\\\"project\\\"}\\n-->\",\n+        \"state\":\"OPEN\",\"reason\":null,\"parent\":null,\"repo\":repository,\"status\":\"Todo\",\n+        \"origin\":\"\",\"labels\":[]})\n+}\n+\n+/// One loopback board configured as a source, with the request that reaches it.\n+pub(super) struct Board {\n+    pub fields: GitHubBoardFields,\n+    pub config: Value,\n+}\n+\n+/// A board holding `items` beside the human-task project, creating its issues in\n+/// [`PUBLIC_REPOSITORY`] and answering canonical issue URLs.\n+pub(super) fn board(sandbox: &Sandbox, mut items: Vec<Value>) -> Board {\n+    items.push(project_item(PROJECT, PUBLIC_REPOSITORY));\n+    let (mut config, fields) = github_projects_with_items(sandbox, items);\n+    config[\"repository\"] = json!(PUBLIC_REPOSITORY);\n+    config[\"priority_mapping\"] = json!({\"urgent\": \"Urgent\"});\n+    fields.use_repository(PUBLIC_REPOSITORY);\n+    fields.use_canonical_issue_urls();\n+    fields.file_new_items_without_status(true);\n+    Board { fields, config }\n+}\n+\n+/// A store holding one public board, `human`, whose projections this host is authoritative\n+/// over.\n+pub(super) struct Store {\n+    pub sandbox: Sandbox,\n+    pub board: Board,\n+    pub intents: PathBuf,\n+}\n+\n+impl Store {\n+    pub fn new(items: Vec<Value>) -> Self {\n+        let sandbox = Sandbox::new();\n+        let board = board(&sandbox, items);\n+        let intents = sandbox.subdirectory(\"intents\");\n+        let store = Self {\n+            sandbox,\n+            board,\n+            intents,\n+        };\n+        store.configure(json!({}));\n+        store\n+    }\n+\n+    /// Write the configuration, `extra` sources beside `human`.\n+    pub fn configure(&self, extra: Value) {\n+        let mut sources = json!({\"human\": {\n+            \"plugin\": \"github-projects\",\n+            \"config\": self.board.config,\n+            \"cache\": {\"dir\": self.sandbox.subdirectory(\"cache-human\")},\n+            \"task_projection\": {\"host\": HOST, \"directory\": self.intents, \"project\": PROJECT}\n+        }});\n+        for (name, source) in extra.as_object().unwrap() {\n+            sources[name] = source.clone();\n+        }\n+        self.sandbox.project_document(&document(&sources));\n+    }\n+\n+    /// Write `request` to a file and project it from this host.\n+    pub fn project(&self, request: &Value) -> std::process::Output {\n+        self.project_from(request, HOST)\n+    }\n+\n+    /// Write `request` to a file and project it from the host `host`.\n+    pub fn project_from(&self, request: &Value, host: &str) -> std::process::Output {\n+        let path = self.sandbox.project().join(format!(\n+            \"request-{}.json\",\n+            std::time::SystemTime::now()\n+                .duration_since(std::time::UNIX_EPOCH)\n+                .unwrap()\n+                .as_nanos()\n+        ));\n+        std::fs::write(&path, request.to_string()).unwrap();\n+        self.sandbox\n+            .command()\n+            .args([\"task\", \"project-human\", \"--input\"])\n+            .arg(&path)\n+            .arg(\"--json\")\n+            .env(\"ONETASKGRAPH_HOST\", host)\n+            .output()\n+            .unwrap()\n+    }\n+\n+    /// The requests the board has answered so far.\n+    pub fn requests(&self) -> usize {\n+        self.board.fields.served().len()\n+    }\n+\n+    /// The operations the board answered from request `from` on.\n+    pub fn operations_since(&self, from: usize) -> Vec<&'static str> {\n+        self.board.fields.served()[from..]\n+            .iter()\n+            .map(|(query, _)| super::plan_copy::operation_name(query))\n+            .collect()\n+    }\n+\n+    /// Every issue on the board whose body carries `item_id` as its human item.\n+    pub fn tickets(&self, item_id: &str) -> Vec<String> {\n+        let needle = format!(\"\\\"human.item_id\\\":\\\"{item_id}\\\"\");\n+        self.board\n+            .fields\n+            .issues()\n+            .into_iter()\n+            .filter(|issue| {\n+                issue[\"body\"]\n+                    .as_str()\n+                    .is_some_and(|body| body.contains(&needle))\n+            })\n+            .map(|issue| issue[\"id\"].as_str().unwrap().to_owned())\n+            .collect()\n+    }\n+}\n+\n+/// A v1 request for `item_id`, open, with `repositories`.\n+pub(super) fn request(item_id: &str, repositories: &[&str]) -> Value {\n+    json!({\"schema_version\": 1, \"item_id\": item_id,\n+        \"owner\": {\"session\": \"session-1\", \"run\": null, \"plan\": null},\n+        \"title\": format!(\"Decide on {item_id}\"), \"body\": \"Choose the next public example.\",\n+        \"priority\": \"high\",\n+        \"repositories\": repositories.iter().map(|r| format!(\"github.com/{r}\")).collect::<Vec<_>>(),\n+        \"project\": null, \"source\": \"human\", \"state\": \"open\", \"reason\": null})\n+}\n+\n+/// The answer a successful projection printed.\n+pub(super) fn projected(output: &std::process::Output) -> Value {\n+    assert_eq!(\n+        output.status.code(),\n+        Some(0),\n+        \"stdout: {}\\nstderr: {}\",\n+        stdout(output),\n+        stderr(output)\n+    );\n+    serde_json::from_str(&stdout(output)).expect(\"a HumanTaskProjected document\")\n+}\n+\n+/// The native id of the answer's task.\n+pub(super) fn native(answer: &Value) -> String {\n+    answer[\"task\"]\n+        .as_str()\n+        .unwrap()\n+        .split_once(':')\n+        .unwrap()\n+        .1\n+        .to_owned()\n+}\n+\n+/// The metadata slot of one issue's body.\n+pub(super) fn slot(fields: &GitHubBoardFields, id: &str) -> Value {\n+    let body = fields.body(id);\n+    let body = body.as_str().expect(\"the board holds the issue\");\n+    let (_, inner) = body\n+        .split_once(\"<!-- onetaskgraph.metadata\")\n+        .expect(\"the body carries its metadata slot\");\n+    let (inner, _) = inner.split_once(\"-->\").expect(\"the slot is closed\");\n+    serde_json::from_str(inner.trim()).expect(\"the slot is JSON\")\n+}\n+\n+#[test]\n+fn an_item_is_created_once_bound_and_settled_once_and_a_conflicting_terminal_is_refused() {\n+    let store = Store::new(Vec::new());\n+    let open = request(\"item-1\", &[PUBLIC_REPOSITORY]);\n+\n+    let before = store.requests();\n+    let answer = projected(&store.project(&open));\n+    let created = native(&answer);\n+    assert_eq!(\n+        answer.as_object().unwrap().keys().collect::<Vec<_>>(),\n+        [\"project\", \"source\", \"task\", \"url\"]\n+    );\n+    assert_eq!(answer[\"source\"], \"human\");\n+    assert_eq!(answer[\"project\"], PROJECT);\n+    assert_eq!(\n+        answer[\"url\"],\n+        format!(\n+            \"https://github.com/{PUBLIC_REPOSITORY}/issues/{}\",\n+            onetaskgraph_e2e_support::fixtures::github_number(&created)\n+        )\n+    );\n+    assert_eq!(store.tickets(\"item-1\"), std::slice::from_ref(&created));\n+    let held = slot(&store.board.fields, &created);\n+    assert_eq!(held[\"human.item_id\"], \"item-1\");\n+    assert!(\n+        held.get(\"human.state\").is_none(),\n+        \"the state is the issue's own: {held}\"\n+    );\n+    assert!(\n+        held[\"onetaskgraph.origin\"]\n+            .as_str()\n+            .unwrap()\n+            .starts_with(&format!(\"human-task:{HOST}:\"))\n+    );\n+    assert_eq!(\n+        store.board.fields.priority(&created).as_deref(),\n+        Some(\"High\")\n+    );\n+    assert_eq!(store.board.fields.status(&created).as_deref(), Some(\"Todo\"));\n+    let created_with = store.operations_since(before);\n+    assert!(\n+        !created_with\n+            .iter()\n+            .any(|operation| operation.contains(\"comment\")),\n+        \"{created_with:?}\"\n+    );\n+\n+    // A retry of a bound item answers the same ticket and asks the board nothing.\n+    let before = store.requests();\n+    assert_eq!(projected(&store.project(&open)), answer);\n+    assert_eq!(store.requests(), before, \"a bound retry sent requests\");\n+\n+    // Dismissed with no reason: closed as not planned, the reason left absent.\n+    let mut dismissed = open.clone();\n+    dismissed[\"state\"] = json!(\"dismissed\");\n+    let before = store.requests();\n+    assert_eq!(projected(&store.project(&dismissed)), answer);\n+    let settled_with = store.operations_since(before);\n+    assert_eq!(\n+        store.board.fields.state(&created),\n+        (\"CLOSED\".to_owned(), Some(\"NOT_PLANNED\".to_owned()))\n+    );\n+    let held = slot(&store.board.fields, &created);\n+    assert!(held.get(\"human.reason\").is_none(), \"{held}\");\n+    assert_eq!(\n+        store.board.fields.status(&created).as_deref(),\n+        Some(\"Cancelled\")\n+    );\n+    assert!(\n+        !settled_with\n+            .iter()\n+            .any(|operation| operation.starts_with(\"reading\")),\n+        \"a terminal write after the create read the issue again: {settled_with:?}\"\n+    );\n+\n+    // The same terminal again is a no-op; a different one is refused, writing nothing.\n+    let before = store.requests();\n+    assert_eq!(projected(&store.project(&dismissed)), answer);\n+    assert_eq!(store.requests(), before);\n+    let mut completed = open.clone();\n+    completed[\"state\"] = json!(\"completed\");\n+    let refused = store.project(&completed);\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"conflicting terminal\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    let failure: Value = serde_json::from_str(&stdout(&refused)).unwrap();\n+    assert_eq!(failure[\"failure\"][\"kind\"], \"projection-refused\");\n+    assert_eq!(store.requests(), before);\n+    let mut reopened = open.clone();\n+    reopened[\"state\"] = json!(\"open\");\n+    assert_ne!(store.project(&reopened).status.code(), Some(0));\n+    assert_eq!(store.board.fields.state(&created).0, \"CLOSED\");\n+    assert_eq!(store.tickets(\"item-1\"), [created]);\n+}\n+\n+impl Store {\n+    /// Write `request` where the binary reads it.\n+    fn request_file(&self, request: &Value) -> PathBuf {\n+        let path = self.sandbox.project().join(format!(\n+            \"request-{}.json\",\n+            std::time::SystemTime::now()\n+                .duration_since(std::time::UNIX_EPOCH)\n+                .unwrap()\n+                .as_nanos()\n+        ));\n+        std::fs::write(&path, request.to_string()).unwrap();\n+        path\n+    }\n+\n+    /// Project `request` and kill the binary as soon as the board has applied the first\n+    /// request `matches` holds of — before its answer reaches the binary: a crash at that\n+    /// point of the sequence.\n+    pub fn project_killed(\n+        &self,\n+        request: &Value,\n+        matches: impl Fn(&str, &Value) -> bool + Send + 'static,\n+    ) {\n+        let path = self.request_file(request);\n+        let mut command = self.sandbox.subprocess(onetaskgraph_e2e_support::binary());\n+        command\n+            .args([\"task\", \"project-human\", \"--input\"])\n+            .arg(&path)\n+            .arg(\"--json\")\n+            .env(\"ONETASKGRAPH_HOST\", HOST)\n+            .stdout(std::process::Stdio::null())\n+            .stderr(std::process::Stdio::null());\n+        let child = std::sync::Arc::new(std::sync::Mutex::new(command.spawn().unwrap()));\n+        let killed = std::sync::Arc::clone(&child);\n+        self.board.fields.after_request(matches, 0, move |_| {\n+            let _ = killed.lock().unwrap().kill();\n+        });\n+        let status = loop {\n+            if let Some(status) = child.lock().unwrap().try_wait().unwrap() {\n+                break status;\n+            }\n+            std::thread::sleep(std::time::Duration::from_millis(5));\n+        };\n+        assert!(\n+            !status.success(),\n+            \"the binary finished before the crash point\"\n+        );\n+    }\n+}\n+\n+/// A request matching a document carrying `operation`.\n+fn carrying(operation: &'static str) -> impl Fn(&str, &Value) -> bool + Send + 'static {\n+    move |query: &str, _: &Value| query.contains(operation)\n+}\n+\n+/// The operation names of the requests the board answered from `from` on.\n+fn creates_since(store: &Store, from: usize) -> usize {\n+    store\n+        .operations_since(from)\n+        .iter()\n+        .filter(|operation| **operation == \"creating an issue\")\n+        .count()\n+}\n+\n+#[test]\n+fn a_dismissal_keeps_its_reason_and_a_lost_terminal_answer_is_retried_without_writing_again() {\n+    let store = Store::new(Vec::new());\n+    let open = request(\"item-reason\", &[PUBLIC_REPOSITORY]);\n+    let created = native(&projected(&store.project(&open)));\n+    let mut dismissed = open.clone();\n+    dismissed[\"state\"] = json!(\"dismissed\");\n+    dismissed[\"reason\"] = json!(\"Superseded by another example.\");\n+    // The close lands and its answer never reaches the binary.\n+    store.project_killed(&dismissed, carrying(\"updateIssue(input\"));\n+    assert_eq!(store.board.fields.state(&created).0, \"CLOSED\");\n+\n+    // A fresh process reads the issue once, finds the terminal state there, and writes nothing.\n+    let before = store.requests();\n+    let answer = projected(&store.project(&dismissed));\n+    assert_eq!(native(&answer), created);\n+    assert_eq!(store.operations_since(before), [\"reading one issue\"]);\n+    let held = slot(&store.board.fields, &created);\n+    assert_eq!(held[\"human.reason\"], \"Superseded by another example.\");\n+    assert_eq!(\n+        store.board.fields.state(&created),\n+        (\"CLOSED\".to_owned(), Some(\"NOT_PLANNED\".to_owned()))\n+    );\n+    // Acknowledged now, so the next retry asks the board nothing.\n+    let before = store.requests();\n+    projected(&store.project(&dismissed));\n+    assert_eq!(store.requests(), before);\n+\n+    // An omitted reason is the same request as a null one.\n+    let other = request(\"item-omitted\", &[PUBLIC_REPOSITORY]);\n+    let mut omitted = other.clone();\n+    omitted.as_object_mut().unwrap().remove(\"reason\");\n+    omitted[\"state\"] = json!(\"completed\");\n+    let completed = native(&projected(&store.project(&omitted)));\n+    let held = slot(&store.board.fields, &completed);\n+    assert!(held.get(\"human.reason\").is_none(), \"{held}\");\n+    assert_eq!(\n+        store.board.fields.status(&completed).as_deref(),\n+        Some(\"Done\")\n+    );\n+    assert_eq!(\n+        store.board.fields.state(&completed),\n+        (\"CLOSED\".to_owned(), Some(\"COMPLETED\".to_owned()))\n+    );\n+    let mut nulled = other;\n+    nulled[\"state\"] = json!(\"completed\");\n+    let before = store.requests();\n+    assert_eq!(native(&projected(&store.project(&nulled))), completed);\n+    assert_eq!(store.requests(), before);\n+}\n+\n+#[test]\n+fn a_create_whose_answer_was_lost_is_bound_by_its_one_verified_origin_match() {\n+    let store = Store::new(Vec::new());\n+    let open = request(\"item-lost\", &[PUBLIC_REPOSITORY]);\n+    // Filed under its project — the last write of the create — and the answer lost.\n+    store.project_killed(&open, carrying(\"addSubIssue\"));\n+    let tickets = store.tickets(\"item-lost\");\n+    assert_eq!(tickets.len(), 1);\n+\n+    let before = store.requests();\n+    let answer = projected(&store.project(&open));\n+    assert_eq!(native(&answer), tickets[0]);\n+    assert_eq!(\n+        answer[\"url\"],\n+        format!(\n+            \"https://github.com/{PUBLIC_REPOSITORY}/issues/{}\",\n+            onetaskgraph_e2e_support::fixtures::github_number(&tickets[0])\n+        )\n+    );\n+    assert_eq!(creates_since(&store, before), 0);\n+    assert_eq!(\n+        store.operations_since(before),\n+        [super::plan_copy::operation_name(graphql::ORIGIN_LOOKUP)],\n+        \"recovery is one origin read\"\n+    );\n+    // Bound: the same answer again costs nothing, and resolving it writes the one ticket.\n+    let before = store.requests();\n+    assert_eq!(projected(&store.project(&open)), answer);\n+    assert_eq!(store.requests(), before);\n+    let mut completed = open;\n+    completed[\"state\"] = json!(\"completed\");\n+    assert_eq!(projected(&store.project(&completed)), answer);\n+    assert_eq!(store.board.fields.state(&tickets[0]).0, \"CLOSED\");\n+    assert_eq!(store.tickets(\"item-lost\"), tickets);\n+}\n+\n+#[test]\n+fn a_pending_create_with_no_verifiable_match_is_refused_and_never_sent_again() {\n+    // Crashed before the create reached the board: nothing carries the origin.\n+    let store = Store::new(Vec::new());\n+    let open = request(\"item-unsent\", &[PUBLIC_REPOSITORY]);\n+    store.project_killed(&open, move |query: &str, _: &Value| {\n+        query == graphql::CREATION_CONTEXT\n+    });\n+    assert!(store.tickets(\"item-unsent\").is_empty());\n+    let before = store.requests();\n+    let refused = store.project(&open);\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"no second create was sent\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(creates_since(&store, before), 0);\n+    assert!(store.tickets(\"item-unsent\").is_empty());\n+\n+    // Created, and crashed before it was filed under its project: the one issue carrying the\n+    // origin cannot be verified, so it is refused rather than bound or created again.\n+    let open = request(\"item-unfiled\", &[PUBLIC_REPOSITORY]);\n+    store.project_killed(&open, carrying(\"createIssue(input\"));\n+    assert_eq!(store.tickets(\"item-unfiled\").len(), 1);\n+    let before = store.requests();\n+    let refused = store.project(&open);\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"reconcile\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(creates_since(&store, before), 0);\n+    assert_eq!(store.tickets(\"item-unfiled\").len(), 1);\n+}\n+\n+#[test]\n+fn two_issues_carrying_one_pending_origin_are_refused_without_a_third() {\n+    let store = Store::new(Vec::new());\n+    let open = request(\"item-twice\", &[PUBLIC_REPOSITORY]);\n+    store.project_killed(&open, carrying(\"addSubIssue\"));\n+    let first = store.tickets(\"item-twice\");\n+    assert_eq!(first.len(), 1);\n+    // A person duplicates the issue, body, origin and all.\n+    let mut twin = store\n+        .board\n+        .fields\n+        .issues()\n+        .into_iter()\n+        .find(|issue| issue[\"id\"] == json!(first[0]))\n+        .unwrap();\n+    twin[\"id\"] = json!(\"TWIN-1\");\n+    twin[\"item\"] = json!(\"ITEM-TWIN-1\");\n+    store.board.fields.add_items(vec![twin]);\n+    let before = store.requests();\n+    let refused = store.project(&open);\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"zero or multiple origin matches\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(creates_since(&store, before), 0);\n+    assert_eq!(store.tickets(\"item-twice\").len(), 2);\n+}\n+\n+#[test]\n+fn simultaneous_managers_projecting_one_item_share_one_ticket() {\n+    let store = Store::new(Vec::new());\n+    let open = request(\"item-shared\", &[PUBLIC_REPOSITORY]);\n+    let answers: Vec<Value> = std::thread::scope(|scope| {\n+        let handles: Vec<_> = (0..6)\n+            .map(|_| scope.spawn(|| projected(&store.project(&open))))\n+            .collect();\n+        handles\n+            .into_iter()\n+            .map(|handle| handle.join().unwrap())\n+            .collect()\n+    });\n+    assert!(\n+        answers.iter().all(|answer| *answer == answers[0]),\n+        \"{answers:?}\"\n+    );\n+    assert_eq!(store.tickets(\"item-shared\"), [native(&answers[0])]);\n+}\n+\n+#[test]\n+fn another_host_a_changed_payload_and_a_malformed_request_are_refused_writing_nothing() {\n+    let store = Store::new(Vec::new());\n+    let open = request(\"item-guarded\", &[PUBLIC_REPOSITORY]);\n+\n+    let before = store.requests();\n+    let refused = store.project_from(&open, \"another-host\");\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"another-host\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(store.requests(), before);\n+    assert!(store.tickets(\"item-guarded\").is_empty());\n+\n+    let created = native(&projected(&store.project(&open)));\n+    let mut changed = open.clone();\n+    changed[\"title\"] = json!(\"A different decision\");\n+    let before = store.requests();\n+    let refused = store.project(&changed);\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"differs in owner, payload, route or privacy\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(store.requests(), before);\n+    assert_eq!(store.tickets(\"item-guarded\"), [created]);\n+\n+    let mut malformed = Vec::new();\n+    for field in [\n+        \"item_id\", \"owner\", \"title\", \"priority\", \"source\", \"state\", \"project\",\n+    ] {\n+        let mut missing = open.clone();\n+        missing.as_object_mut().unwrap().remove(field);\n+        malformed.push((format!(\"without {field}\"), missing));\n+    }\n+    for (what, field, value) in [\n+        (\"a question\", \"state\", json!(\"question\")),\n+        (\"another version\", \"schema_version\", json!(2)),\n+        (\"an unknown priority\", \"priority\", json!(\"critical\")),\n+        (\"a blank title\", \"title\", json!(\"  \")),\n+        (\"a repository list of numbers\", \"repositories\", json!([1])),\n+        (\"an unqualified owner\", \"owner\", json!({\"session\": \"s\"})),\n+    ] {\n+        let mut wrong = open.clone();\n+        wrong[field] = value;\n+        malformed.push((what.to_owned(), wrong));\n+    }\n+    for extra in [\"question\", \"kind\", \"classification\"] {\n+        let mut wrong = open.clone();\n+        wrong[extra] = json!(\"question\");\n+        malformed.push((format!(\"with {extra}\"), wrong));\n+    }\n+    for (what, request) in malformed {\n+        let refused = store.project(&request);\n+        assert_ne!(refused.status.code(), Some(0), \"{what} was accepted\");\n+        let failure: Value = serde_json::from_str(&stdout(&refused)).unwrap();\n+        assert_eq!(\n+            failure[\"failure\"][\"kind\"], \"projection-input\",\n+            \"{what}: {failure}\"\n+        );\n+    }\n+    assert_eq!(store.requests(), before);\n+}\n+\n+#[test]\n+fn an_edit_a_person_makes_before_the_terminal_projection_survives_it() {\n+    let store = Store::new(Vec::new());\n+    for (item, reason) in [\n+        (\"item-edited\", None),\n+        (\"item-edited-reason\", Some(\"Superseded by another example.\")),\n+    ] {\n+        let open = request(item, &[PUBLIC_REPOSITORY]);\n+        let created = native(&projected(&store.project(&open)));\n+        let body = store.board.fields.body(&created);\n+        let (_, slotted) = body\n+            .as_str()\n+            .unwrap()\n+            .split_once(\"<!-- onetaskgraph.metadata\")\n+            .unwrap();\n+        let edited = format!(\n+            \"A person rewrote this between the create and the decision.\\n\\n<!-- onetaskgraph.metadata{slotted}\"\n+        );\n+        store.board.fields.edit_body(&created, &edited);\n+\n+        let mut dismissed = open;\n+        dismissed[\"state\"] = json!(\"dismissed\");\n+        dismissed[\"reason\"] = json!(reason);\n+        let before = store.requests();\n+        projected(&store.project(&dismissed));\n+        let body = store.board.fields.body(&created);\n+        let body = body.as_str().unwrap();\n+        assert!(\n+            body.starts_with(\"A person rewrote this between the create and the decision.\"),\n+            \"{item}: {body}\"\n+        );\n+        assert_eq!(\n+            store.board.fields.state(&created),\n+            (\"CLOSED\".to_owned(), Some(\"NOT_PLANNED\".to_owned()))\n+        );\n+        match reason {\n+            // Nothing of the body is written: the state is the issue's own.\n+            None => {\n+                assert_eq!(body, edited, \"{item}\");\n+                assert!(\n+                    !store\n+                        .operations_since(before)\n+                        .iter()\n+                        .any(|operation| operation.starts_with(\"reading\")),\n+                    \"{item}\"\n+                );\n+            }\n+            // The reason is written against the body as it reads now: the `Status` write answers\n+            // with the issue whole, and the body is composed against that answer — still two\n+            // requests, neither of them a read of its own.\n+            Some(reason) => {\n+                assert_eq!(slot(&store.board.fields, &created)[\"human.reason\"], reason);\n+                assert_eq!(\n+                    store.operations_since(before),\n+                    [\n+                        super::plan_copy::operation_name(graphql::UPDATE_FIELD_WHOLE),\n+                        \"updating an issue\"\n+                    ],\n+                    \"{item}\"\n+                );\n+            }\n+        }\n+    }\n+}\n+\n+#[test]\n+fn a_later_cold_process_takes_the_kept_placement_and_a_changed_option_is_read_afresh() {\n+    let store = Store::new(Vec::new());\n+    let setup = super::plan_copy::operation_name(graphql::CREATION_CONTEXT);\n+    let created_with = |item: &str| {\n+        let before = store.requests();\n+        let answer = projected(&store.project(&request(item, &[PUBLIC_REPOSITORY])));\n+        assert_eq!(\n+            store.board.fields.status(&native(&answer)).as_deref(),\n+            Some(\"Todo\"),\n+            \"{item}\"\n+        );\n+        store.operations_since(before)\n+    };\n+    assert!(created_with(\"item-first\").contains(&setup));\n+    // Kept in the source's own cache directory, beside nothing of anybody's work: ids under a\n+    // token, no title and no body.\n+    let kept = std::fs::read_to_string(store.sandbox.project().join(\"cache-human/placement.json\"))\n+        .expect(\"the placement is kept in the source's cache directory\");\n+    assert!(kept.contains(\"\\\"token\\\"\"), \"{kept}\");\n+    assert!(\n+        !kept.contains(\"item-first\") && !kept.contains(\"Choose the next\"),\n+        \"{kept}\"\n+    );\n+    // The binding keeps the written issue's ids and nothing of its work or its state.\n+    let journals: Vec<String> = std::fs::read_dir(&store.intents)\n+        .unwrap()\n+        .flat_map(|identity| std::fs::read_dir(identity.unwrap().path()).unwrap())\n+        .map(|entry| entry.unwrap().path())\n+        .filter(|path| {\n+            path.extension()\n+                .is_some_and(|extension| extension == \"json\")\n+        })\n+        .map(|path| std::fs::read_to_string(path).unwrap())\n+        .collect();\n+    let journal: Value = serde_json::from_str(\n+        journals\n+            .iter()\n+            .find(|text| text.contains(\"\\\"item-first\\\"\"))\n+            .unwrap(),\n+    )\n+    .unwrap();\n+    let written = journal[\"phase\"][\"written\"].to_string();\n+    let kept_ids = journal[\"phase\"][\"written\"].as_object().unwrap();\n+    for id in [\"issue\", \"item\", \"board\"] {\n+        assert!(kept_ids[id].is_string(), \"{written}\");\n+    }\n+    for work in [\"Decide on item-first\", \"Choose the next\", \"human.\"] {\n+        assert!(!written.contains(work), \"{work} in {written}\");\n+    }\n+    for state in [\n+        \"title\", \"body\", \"slot\", \"status\", \"option\", \"closed\", \"reason\",\n+    ] {\n+        assert!(!kept_ids.contains_key(state), \"{state} in {written}\");\n+    }\n+    // A second process reads the project issue it is filed under, as every create does, finds\n+    // the kept placement's token unchanged there, and reads no board fields or repository.\n+    let second = created_with(\"item-second\");\n+    assert!(!second.contains(&setup), \"{second:?}\");\n+    assert_eq!(second.first().copied(), Some(\"reading one issue\"));\n+\n+    // An option given a new id moves the token: the next process reads its context afresh,\n+    // writes the option's new id, and keeps that context for the one after it.\n+    store.board.fields.remint_status_option(\"Todo\");\n+    assert!(created_with(\"item-third\").contains(&setup));\n+    assert!(!created_with(\"item-fourth\").contains(&setup));\n+}\n+\n+#[test]\n+fn a_request_on_standard_input_is_projected_and_a_half_landed_terminal_is_finished() {\n+    use std::io::Write as _;\n+    let store = Store::new(Vec::new());\n+    let open = request(\"item-stdin\", &[PUBLIC_REPOSITORY]);\n+    let mut child = store\n+        .sandbox\n+        .subprocess(onetaskgraph_e2e_support::binary())\n+        .args([\"task\", \"project-human\", \"--input\", \"-\", \"--json\"])\n+        .env(\"ONETASKGRAPH_HOST\", HOST)\n+        .stdin(std::process::Stdio::piped())\n+        .stdout(std::process::Stdio::piped())\n+        .stderr(std::process::Stdio::piped())\n+        .spawn()\n+        .unwrap();\n+    child\n+        .stdin\n+        .take()\n+        .unwrap()\n+        .write_all(open.to_string().as_bytes())\n+        .unwrap();\n+    let created = native(&projected(&child.wait_with_output().unwrap()));\n+    assert_eq!(store.tickets(\"item-stdin\"), std::slice::from_ref(&created));\n+\n+    // A reason is recorded only for a dismissal.\n+    let mut completed = open.clone();\n+    completed[\"state\"] = json!(\"completed\");\n+    completed[\"reason\"] = json!(\"Done early.\");\n+    let before = store.requests();\n+    assert_ne!(store.project(&completed).status.code(), Some(0));\n+    assert_eq!(store.requests(), before);\n+\n+    // The card moves and the close is refused: the retry reads the issue and sends only the\n+    // close the tracker does not hold yet.\n+    completed[\"reason\"] = Value::Null;\n+    store.board.fields.refuse_once(\"updateIssue(input\");\n+    assert_ne!(store.project(&completed).status.code(), Some(0));\n+    assert_eq!(store.board.fields.state(&created).0, \"OPEN\");\n+    let before = store.requests();\n+    projected(&store.project(&completed));\n+    assert_eq!(\n+        store.operations_since(before),\n+        [\"reading one issue\", \"updating an issue\"]\n+    );\n+    assert_eq!(\n+        store.board.fields.state(&created),\n+        (\"CLOSED\".to_owned(), Some(\"COMPLETED\".to_owned()))\n+    );\n+    assert_eq!(store.board.fields.status(&created).as_deref(), Some(\"Done\"));\n+}\n+\n+#[test]\n+fn kept_contexts_that_cannot_be_read_are_declined_and_read_afresh() {\n+    let store = Store::new(Vec::new());\n+    let setup = super::plan_copy::operation_name(graphql::CREATION_CONTEXT);\n+    projected(&store.project(&request(\"item-kept\", &[PUBLIC_REPOSITORY])));\n+\n+    // A kept placement that is not one — an empty repository id — is declined: the next create\n+    // reads its context and keeps a sound one.\n+    let kept = store.sandbox.project().join(\"cache-human/placement.json\");\n+    let mut placement: Value =\n+        serde_json::from_str(&std::fs::read_to_string(&kept).unwrap()).unwrap();\n+    placement[\"repository_id\"] = json!(\"\");\n+    std::fs::write(&kept, placement.to_string()).unwrap();\n+    let before = store.requests();\n+    let open = request(\"item-after-corruption\", &[PUBLIC_REPOSITORY]);\n+    let created = native(&projected(&store.project(&open)));\n+    assert!(store.operations_since(before).contains(&setup));\n+\n+    // A written context naming another board is declined: the terminal write reads the issue\n+    // first, then settles it.\n+    let journal = std::fs::read_dir(&store.intents)\n+        .unwrap()\n+        .flat_map(|identity| std::fs::read_dir(identity.unwrap().path()).unwrap())\n+        .map(|entry| entry.unwrap().path())\n+        .find(|path| {\n+            path.extension()\n+                .is_some_and(|extension| extension == \"json\")\n+                && std::fs::read_to_string(path)\n+                    .unwrap()\n+                    .contains(\"\\\"item-after-corruption\\\"\")\n+        })\n+        .expect(\"the item's journal\");\n+    let mut held: Value =\n+        serde_json::from_str(&std::fs::read_to_string(&journal).unwrap()).unwrap();\n+    held[\"phase\"][\"written\"][\"number\"] = json!(999);\n+    std::fs::write(&journal, held.to_string()).unwrap();\n+    let mut completed = open;\n+    completed[\"state\"] = json!(\"completed\");\n+    let before = store.requests();\n+    projected(&store.project(&completed));\n+    assert_eq!(\n+        store.operations_since(before).first().copied(),\n+        Some(\"reading one issue\")\n+    );\n+    assert_eq!(\n+        store.board.fields.state(&created),\n+        (\"CLOSED\".to_owned(), Some(\"COMPLETED\".to_owned()))\n+    );\n+}\n+\n+#[test]\n+fn a_create_answered_without_its_url_reads_it_and_one_with_no_canonical_url_is_refused() {\n+    // The create's answer names no URL: the issue is read once for it, and the card's URL is\n+    // still the issue's canonical address.\n+    let store = Store::new(Vec::new());\n+    store.board.fields.omit_created_issue_urls();\n+    let before = store.requests();\n+    let answer = projected(&store.project(&request(\"item-unaddressed\", &[PUBLIC_REPOSITORY])));\n+    let created = native(&answer);\n+    assert_eq!(\n+        answer[\"url\"],\n+        format!(\n+            \"https://github.com/{PUBLIC_REPOSITORY}/issues/{}\",\n+            onetaskgraph_e2e_support::fixtures::github_number(&created)\n+        )\n+    );\n+    assert_eq!(\n+        store.operations_since(before).last().copied(),\n+        Some(\"reading one issue\"),\n+        \"the URL was read after the create\"\n+    );\n+\n+    // No address the tracker gives is canonical HTTPS: the projection is refused rather than\n+    // answered with a link a card cannot use, and a retry sends no second create.\n+    let store = Store::new(Vec::new());\n+    store.board.fields.serve_insecure_issue_urls();\n+    let open = request(\"item-insecure\", &[PUBLIC_REPOSITORY]);\n+    let refused = store.project(&open);\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"canonical\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(store.tickets(\"item-insecure\").len(), 1);\n+    let before = store.requests();\n+    let retried = store.project(&open);\n+    assert_ne!(retried.status.code(), Some(0));\n+    assert_eq!(creates_since(&store, before), 0, \"no second create\");\n+    assert_eq!(store.tickets(\"item-insecure\").len(), 1);\n+}\n+\n+/// The fixture board's credential, as a plugin built outside the binary is handed it.\n+struct FixtureToken;\n+\n+impl onetaskgraph_plugin_api::SecretResolver for FixtureToken {\n+    fn get(&self, _: &str) -> Option<secrecy::SecretString> {\n+        Some(\"test-token\".to_owned().into())\n+    }\n+}\n+\n+#[test]\n+fn a_primed_update_changing_the_body_without_moving_an_option_reads_the_body_first() {\n+    use onetaskgraph_plugin_api::{ItemWrite, MetadataKey, SourceName, SourcePlugin as _, Task};\n+    // One process writes the issue and keeps its ids; a person then edits the issue; a later\n+    // process primes those ids and sends an update that changes the body's metadata and no\n+    // status. Nothing moves an option, so the body is read before it is composed.\n+    let store = Store::new(Vec::new());\n+    let name = SourceName::new(\"human\").unwrap();\n+    let runtime = tokio::runtime::Runtime::new().unwrap();\n+    let task: Task = serde_json::from_value(json!({\n+        \"id\": \"item-primed\", \"title\": \"Decide on item-primed\",\n+        \"content\": \"Choose the next public example.\", \"status\": {\"category\": \"todo\", \"name\": \"Todo\"},\n+        \"priority\": \"high\", \"labels\": [], \"project\": PROJECT, \"url\": null,\n+        \"created_at\": null, \"updated_at\": null, \"metadata\": {\"human.item_id\": \"item-primed\"},\n+        \"repositories\": [format!(\"github.com/{PUBLIC_REPOSITORY}\")]}))\n+    .unwrap();\n+    let writer = onetaskgraph_github_projects::Plugin\n+        .build(&name, &store.board.config, &FixtureToken)\n+        .unwrap();\n+    let id = runtime\n+        .block_on(writer.write_task(&ItemWrite {\n+            target: None,\n+            item: task.clone(),\n+            depends_on: Vec::new(),\n+        }))\n+        .unwrap();\n+    let kept = writer\n+        .written_context(&id)\n+        .expect(\"ids of the issue written\");\n+    let body = store.board.fields.body(&id.0);\n+    let (_, slotted) = body\n+        .as_str()\n+        .unwrap()\n+        .split_once(\"<!-- onetaskgraph.metadata\")\n+        .unwrap();\n+    store.board.fields.edit_body(\n+        &id.0,\n+        &format!(\"A person rewrote this.\\n\\n<!-- onetaskgraph.metadata{slotted}\"),\n+    );\n+\n+    let later = onetaskgraph_github_projects::Plugin\n+        .build(&name, &store.board.config, &FixtureToken)\n+        .unwrap();\n+    let mut primed = task;\n+    primed.id = id.clone();\n+    assert!(later.prime_written(&id, &kept, &primed));\n+    let before = store.requests();\n+    let mut update = onetaskgraph_plugin_api::TaskUpdate::default();\n+    update.metadata_set.insert(\n+        MetadataKey::new(\"human.reason\".to_owned()).unwrap(),\n+        json!(\"Superseded.\"),\n+    );\n+    runtime\n+        .block_on(later.update_task(&id, &update))\n+        .unwrap()\n+        .expect(\"the issue is held\");\n+    assert_eq!(\n+        store.operations_since(before),\n+        [\"reading one issue\", \"updating an issue\"]\n+    );\n+    let body = store.board.fields.body(&id.0);\n+    assert!(\n+        body.as_str().unwrap().starts_with(\"A person rewrote this.\"),\n+        \"{body}\"\n+    );\n+    assert_eq!(\n+        slot(&store.board.fields, &id.0)[\"human.reason\"],\n+        \"Superseded.\"\n+    );\n+    assert_eq!(\n+        slot(&store.board.fields, &id.0)[\"human.item_id\"],\n+        \"item-primed\"\n+    );\n+}\n+\n+#[test]\n+fn without_a_named_host_the_machines_own_name_is_the_authority_and_text_names_the_card() {\n+    // The host the `hostname` command names is the one a configuration declares.\n+    let output = std::process::Command::new(\"hostname\").output().unwrap();\n+    let machine = String::from_utf8(output.stdout).unwrap().trim().to_owned();\n+    let store = Store::new(Vec::new());\n+    let configured = std::fs::read_to_string(store.sandbox.project().join(\"onetaskgraph.yaml\"))\n+        .unwrap()\n+        .replace(HOST, &machine);\n+    store.sandbox.project_document(&configured);\n+    let path = store.request_file(&request(\"item-machine\", &[PUBLIC_REPOSITORY]));\n+    let answered = store\n+        .sandbox\n+        .command()\n+        .args([\"task\", \"project-human\", \"--input\"])\n+        .arg(&path)\n+        .output()\n+        .unwrap();\n+    assert_eq!(answered.status.code(), Some(0), \"{}\", stderr(&answered));\n+    // Without --json, one line: the task and the URL a card links to.\n+    let created = store.tickets(\"item-machine\");\n+    assert_eq!(created.len(), 1);\n+    assert_eq!(\n+        stdout(&answered).trim(),\n+        format!(\n+            \"human:{} https://github.com/{PUBLIC_REPOSITORY}/issues/{}\",\n+            created[0],\n+            onetaskgraph_e2e_support::fixtures::github_number(&created[0])\n+        )\n+    );\n+\n+    // Named otherwise, the host is another one, and is refused.\n+    let refused = store\n+        .sandbox\n+        .command()\n+        .args([\"task\", \"project-human\", \"--input\"])\n+        .arg(&path)\n+        .env(\"ONETASKGRAPH_HOST\", \"not-this-machine\")\n+        .output()\n+        .unwrap();\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"not-this-machine\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+}\n+\n+#[test]\n+fn a_primed_record_stays_unread_through_a_bodiless_update_and_a_failed_read() {\n+    use onetaskgraph_plugin_api::{\n+        ItemWrite, MetadataKey, SourceName, SourcePlugin as _, Status, StatusCategory, Task,\n+        TaskUpdate,\n+    };\n+    let store = Store::new(Vec::new());\n+    let name = SourceName::new(\"human\").unwrap();\n+    let runtime = tokio::runtime::Runtime::new().unwrap();\n+    let task: Task = serde_json::from_value(json!({\n+        \"id\": \"item-sequence\", \"title\": \"Decide on item-sequence\",\n+        \"content\": \"Choose the next public example.\", \"status\": {\"category\": \"todo\", \"name\": \"Todo\"},\n+        \"priority\": \"high\", \"labels\": [], \"project\": PROJECT, \"url\": null,\n+        \"created_at\": null, \"updated_at\": null, \"metadata\": {\"human.item_id\": \"item-sequence\"},\n+        \"repositories\": [format!(\"github.com/{PUBLIC_REPOSITORY}\")]}))\n+    .unwrap();\n+    let writer = onetaskgraph_github_projects::Plugin\n+        .build(&name, &store.board.config, &FixtureToken)\n+        .unwrap();\n+    let id = runtime\n+        .block_on(writer.write_task(&ItemWrite {\n+            target: None,\n+            item: task.clone(),\n+            depends_on: Vec::new(),\n+        }))\n+        .unwrap();\n+    let kept = writer.written_context(&id).unwrap();\n+    let body = store.board.fields.body(&id.0);\n+    let (_, slotted) = body\n+        .as_str()\n+        .unwrap()\n+        .split_once(\"<!-- onetaskgraph.metadata\")\n+        .unwrap();\n+    let edited = format!(\"A person rewrote this.\\n\\n<!-- onetaskgraph.metadata{slotted}\");\n+    store.board.fields.edit_body(&id.0, &edited);\n+\n+    let later = onetaskgraph_github_projects::Plugin\n+        .build(&name, &store.board.config, &FixtureToken)\n+        .unwrap();\n+    let mut primed = task;\n+    primed.id = id.clone();\n+    assert!(later.prime_written(&id, &kept, &primed));\n+    // A status update writes no body, and leaves the body as the person left it.\n+    let closing = TaskUpdate {\n+        status: Some(Status {\n+            category: StatusCategory::Cancelled,\n+            name: \"cancelled\".to_owned(),\n+        }),\n+        ..TaskUpdate::default()\n+    };\n+    runtime\n+        .block_on(later.update_task(&id, &closing))\n+        .unwrap()\n+        .unwrap();\n+    assert_eq!(store.board.fields.body(&id.0), json!(edited));\n+\n+    // The next update changes the body: its read of the issue is refused, so it writes nothing;\n+    // retried, the same update reads the body first and keeps the person's edit.\n+    let mut reason = TaskUpdate::default();\n+    reason.metadata_set.insert(\n+        MetadataKey::new(\"human.reason\".to_owned()).unwrap(),\n+        json!(\"Superseded.\"),\n+    );\n+    let reads = |from: usize| {\n+        store\n+            .operations_since(from)\n+            .iter()\n+            .filter(|operation| operation.starts_with(\"reading\"))\n+            .count()\n+    };\n+    let before = store.requests();\n+    store.board.fields.refuse_once(\"query($id:ID!\");\n+    assert!(runtime.block_on(later.update_task(&id, &reason)).is_err());\n+    assert_eq!(store.board.fields.body(&id.0), json!(edited));\n+    runtime\n+        .block_on(later.update_task(&id, &reason))\n+        .unwrap()\n+        .unwrap();\n+    assert!(reads(before) >= 1, \"{:?}\", store.operations_since(before));\n+    let body = store.board.fields.body(&id.0);\n+    assert!(\n+        body.as_str().unwrap().starts_with(\"A person rewrote this.\"),\n+        \"{body}\"\n+    );\n+    assert_eq!(\n+        slot(&store.board.fields, &id.0)[\"human.reason\"],\n+        \"Superseded.\"\n+    );\n+}\n+\n+#[test]\n+fn a_status_write_answered_without_the_body_is_refused_and_the_retry_writes_the_reason() {\n+    let store = Store::new(Vec::new());\n+    let open = request(\"item-bodiless\", &[PUBLIC_REPOSITORY]);\n+    let created = native(&projected(&store.project(&open)));\n+    let body = store.board.fields.body(&created);\n+    let mut dismissed = open;\n+    dismissed[\"state\"] = json!(\"dismissed\");\n+    dismissed[\"reason\"] = json!(\"Superseded by another example.\");\n+    // The `Status` write that should answer with the body answers without it: no body is\n+    // composed from anything else, and nothing of the body is written.\n+    store.board.fields.omit_from_writes(&[\"body\"]);\n+    let refused = store.project(&dismissed);\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"no issue body\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(store.board.fields.body(&created), body);\n+    // Answered whole again, the retry reads the issue and records the reason against it.\n+    store.board.fields.omit_from_writes(&[]);\n+    projected(&store.project(&dismissed));\n+    assert_eq!(\n+        slot(&store.board.fields, &created)[\"human.reason\"],\n+        \"Superseded by another example.\"\n+    );\n+    assert_eq!(\n+        store.board.fields.state(&created),\n+        (\"CLOSED\".to_owned(), Some(\"NOT_PLANNED\".to_owned()))\n+    );\n+}\n+\n+#[test]\n+fn a_relative_intent_directory_is_refused_when_the_configuration_is_read() {\n+    let store = Store::new(Vec::new());\n+    let configured = std::fs::read_to_string(store.sandbox.project().join(\"onetaskgraph.yaml\"))\n+        .unwrap()\n+        .replace(\n+            &serde_json::to_string(&store.intents).unwrap(),\n+            \"\\\"relative/intents\\\"\",\n+        );\n+    assert!(configured.contains(\"relative/intents\"), \"{configured}\");\n+    store.sandbox.project_document(&configured);\n+    let refused = store.project(&request(\"item-relative\", &[PUBLIC_REPOSITORY]));\n+    assert_ne!(refused.status.code(), Some(0));\n+    let failure: Value = serde_json::from_str(&stdout(&refused)).unwrap();\n+    assert_eq!(failure[\"failure\"][\"kind\"], \"config-setting\", \"{failure}\");\n+    assert!(\n+        stderr(&refused).contains(\"task_projection.directory\")\n+            && stderr(&refused).contains(\"not an absolute directory\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(store.requests(), 0, \"nothing was sent\");\n+}\n+\n+#[test]\n+fn a_projection_with_no_project_a_source_with_no_remote_and_a_deleted_ticket_are_refused() {\n+    let store = Store::new(Vec::new());\n+    let folder = store.sandbox.subdirectory(\"notes\");\n+    // A destination configuring no project takes no planless item.\n+    store.sandbox.project_document(&document(&json!({\"human\": {\n+        \"plugin\": \"github-projects\", \"config\": store.board.config,\n+        \"cache\": {\"dir\": store.sandbox.subdirectory(\"cache-human\")},\n+        \"task_projection\": {\"host\": HOST, \"directory\": store.intents}}})));\n+    let refused = store.project(&request(\"item-unfiled\", &[PUBLIC_REPOSITORY]));\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"configures none\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(store.requests(), 0);\n+\n+    // A source with no remote tracker has no stable identity to key its intents by.\n+    store.configure(\n+        json!({\"notes\": {\"plugin\": \"local-md\", \"config\": {\"root\": folder},\n+        \"task_projection\": {\"host\": HOST, \"directory\": store.intents, \"project\": \"P-1\"}}}),\n+    );\n+    let mut local = request(\"item-local\", &[]);\n+    local[\"source\"] = json!(\"notes\");\n+    let refused = store.project(&local);\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"names no remote tracker\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+\n+    // A bound ticket deleted on the tracker is never replaced: the terminal projection is\n+    // refused, and no second create is sent.\n+    let open = request(\"item-deleted\", &[PUBLIC_REPOSITORY]);\n+    let created = native(&projected(&store.project(&open)));\n+    store.board.fields.delete_issue(&created);\n+    // GitHub answers a write naming the deleted issue's board item as a node that no longer\n+    // resolves.\n+    store\n+        .board\n+        .fields\n+        .refuse_as_stale_once(\"updateProjectV2ItemFieldValue\");\n+    let mut completed = open;\n+    completed[\"state\"] = json!(\"completed\");\n+    let before = store.requests();\n+    let refused = store.project(&completed);\n+    assert_ne!(refused.status.code(), Some(0), \"{}\", stdout(&refused));\n+    assert_eq!(creates_since(&store, before), 0, \"no replacement create\");\n+    assert!(store.tickets(\"item-deleted\").is_empty());\n+    assert!(\n+        stderr(&refused).contains(\"Could not resolve\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    // Retried, the terminal intent reads the ticket, finds none, and refuses — still creating\n+    // nothing in its place.\n+    let before = store.requests();\n+    let refused = store.project(&completed);\n+    assert_ne!(refused.status.code(), Some(0), \"{}\", stdout(&refused));\n+    assert!(\n+        stderr(&refused).contains(\"no longer in the tracker\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(creates_since(&store, before), 0, \"no replacement create\");\n+    assert!(store.tickets(\"item-deleted\").is_empty());\n+}\n+\n+#[test]\n+fn with_the_cache_on_kept_contexts_cross_processes_through_the_cached_source() {\n+    let store = Store::new(Vec::new());\n+    let cache = store.sandbox.subdirectory(\"cache-human\");\n+    store.sandbox.project_document(&document(&json!({\"human\": {\n+        \"plugin\": \"github-projects\", \"config\": store.board.config,\n+        \"cache\": {\"enabled\": true, \"dir\": cache},\n+        \"task_projection\": {\"host\": HOST, \"directory\": store.intents, \"project\": PROJECT}}})));\n+    let setup = super::plan_copy::operation_name(graphql::CREATION_CONTEXT);\n+    projected(&store.project(&request(\"item-cached-first\", &[PUBLIC_REPOSITORY])));\n+    // A later process, its source behind the store's cache, takes the kept placement…\n+    let open = request(\"item-cached\", &[PUBLIC_REPOSITORY]);\n+    let before = store.requests();\n+    let created = native(&projected(&store.project(&open)));\n+    assert!(!store.operations_since(before).contains(&setup));\n+    // …and a later one still settles the ticket by the ids it kept, reading nothing first.\n+    let mut completed = open;\n+    completed[\"state\"] = json!(\"completed\");\n+    let before = store.requests();\n+    projected(&store.project(&completed));\n+    assert!(\n+        !store\n+            .operations_since(before)\n+            .iter()\n+            .any(|operation| operation.starts_with(\"reading\")),\n+        \"{:?}\",\n+        store.operations_since(before)\n+    );\n+    assert_eq!(\n+        store.board.fields.state(&created),\n+        (\"CLOSED\".to_owned(), Some(\"COMPLETED\".to_owned()))\n+    );\n+}\n+\n+#[test]\n+fn an_unreadable_request_and_an_unknown_host_are_refused_before_any_source() {\n+    let store = Store::new(Vec::new());\n+    let failure = |output: &std::process::Output| -> Value {\n+        assert_ne!(output.status.code(), Some(0));\n+        serde_json::from_str(&stdout(output)).unwrap()\n+    };\n+\n+    // A request file that is not there.\n+    let missing = store\n+        .sandbox\n+        .command()\n+        .args([\n+            \"task\",\n+            \"project-human\",\n+            \"--input\",\n+            \"no-such-request.json\",\n+            \"--json\",\n+        ])\n+        .env(\"ONETASKGRAPH_HOST\", HOST)\n+        .output()\n+        .unwrap();\n+    assert_eq!(failure(&missing)[\"failure\"][\"kind\"], \"projection-input\");\n+    assert!(\n+        stderr(&missing).contains(\"no-such-request.json\"),\n+        \"{}\",\n+        stderr(&missing)\n+    );\n+\n+    // Standard input that cannot be read: a directory in its place.\n+    #[cfg(unix)]\n+    {\n+        let unreadable = store\n+            .sandbox\n+            .subprocess(onetaskgraph_e2e_support::binary())\n+            .args([\"task\", \"project-human\", \"--input\", \"-\", \"--json\"])\n+            .env(\"ONETASKGRAPH_HOST\", HOST)\n+            .stdin(std::fs::File::open(store.sandbox.project()).unwrap())\n+            .output()\n+            .unwrap();\n+        assert_eq!(failure(&unreadable)[\"failure\"][\"kind\"], \"projection-input\");\n+        assert!(\n+            stderr(&unreadable).contains(\"standard input\"),\n+            \"{}\",\n+            stderr(&unreadable)\n+        );\n+    }\n+\n+    // A host no source's task_projection names, refused from the configuration alone.\n+    let path = store.request_file(&request(\"item-unknown-host\", &[PUBLIC_REPOSITORY]));\n+    let unknown = store\n+        .sandbox\n+        .command()\n+        .args([\"task\", \"project-human\", \"--input\"])\n+        .arg(&path)\n+        .arg(\"--json\")\n+        .env(\"ONETASKGRAPH_HOST\", \"no-source-names-this-host\")\n+        .output()\n+        .unwrap();\n+    assert_eq!(failure(&unknown)[\"failure\"][\"kind\"], \"projection-host\");\n+    assert!(\n+        stderr(&unknown).contains(\"no-source-names-this-host\"),\n+        \"{}\",\n+        stderr(&unknown)\n+    );\n+\n+    // No host named, and — where the platform finds none without a PATH — no `hostname`\n+    // command to ask; either way no source names the host this process ends up with.\n+    let path = store.request_file(&request(\"item-hostless\", &[PUBLIC_REPOSITORY]));\n+    let hostless = store\n+        .sandbox\n+        .command()\n+        .args([\"task\", \"project-human\", \"--input\"])\n+        .arg(&path)\n+        .arg(\"--json\")\n+        .env(\"PATH\", store.sandbox.subdirectory(\"empty-path\"))\n+        .output()\n+        .unwrap();\n+    assert_eq!(failure(&hostless)[\"failure\"][\"kind\"], \"projection-host\");\n+    assert!(\n+        stderr(&hostless).contains(\"ONETASKGRAPH_HOST\"),\n+        \"{}\",\n+        stderr(&hostless)\n+    );\n+    assert_eq!(store.requests(), 0, \"nothing was sent\");\n+}"},{"sha":"6b3da9ab0cb2be1af9c4e2705908546519a1b85d","filename":"crates/onetaskgraph-github-projects-e2e/tests/e2e/human_reporters.rs","status":"added","additions":142,"deletions":0,"changes":142,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_reporters.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_reporters.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_reporters.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,142 @@\n+//! The two human-items reporters, driven as onebudgetspec drives them — `node` in this crate's\n+//! directory, `ONEBUDGETSPEC_RESULT` naming where the figure goes — over recordings built by the\n+//! very functions the journeys record with. So a reporter handing over the wrong figure, taking\n+//! a recording it should refuse, or drifting from what the journeys write fails here.\n+\n+use std::path::Path;\n+\n+use onetaskgraph_e2e_support::common::Sandbox;\n+use serde_json::{Value, json};\n+\n+/// Run `script` over `recording`, saved as `budget`'s telemetry: its exit, and the result file.\n+fn report(script: &str, budget: &str, recording: &Value) -> (bool, Option<Value>) {\n+    let sandbox = Sandbox::new();\n+    let directory = sandbox.subdirectory(\"telemetry\");\n+    std::fs::write(\n+        onetaskgraph_e2e_support::telemetry::file_in(&directory, budget),\n+        recording.to_string(),\n+    )\n+    .unwrap();\n+    let result = sandbox.project().join(\"result.json\");\n+    let output = std::process::Command::new(\"node\")\n+        .arg(Path::new(\"human-items\").join(script))\n+        .current_dir(env!(\"CARGO_MANIFEST_DIR\"))\n+        .env(\"GITHUB_ASSET_TELEMETRY_DIR\", &directory)\n+        .env(\"ONEBUDGETSPEC_RESULT\", &result)\n+        .output()\n+        .expect(\"node runs the reporter\");\n+    let written = std::fs::read_to_string(&result)\n+        .ok()\n+        .map(|text| serde_json::from_str(&text).unwrap());\n+    (output.status.success(), written)\n+}\n+\n+/// One phase's row of `requests` reads, priced a point each.\n+fn row(phase: &str, requests: usize) -> Value {\n+    let priced: Vec<Value> = (0..requests)\n+        .map(|_| {\n+            json!({\"operation\": \"reading one issue\", \"points\": 1, \"mutation_fields\": 0,\n+                   \"secondary_points\": 1})\n+        })\n+        .collect();\n+    json!({\"phase\": phase, \"requests\": requests, \"priced\": priced})\n+}\n+\n+#[test]\n+fn the_projection_reporter_hands_over_points_per_item_and_refuses_an_incomplete_recording() {\n+    let budget = super::human_cost::BUDGET;\n+    let rows = vec![\n+        row(\"create\", 510),\n+        row(\"terminal\", 200),\n+        row(\"create_recovery\", 10),\n+        row(\"cold_terminal_retry\", 10),\n+        row(\"warm_noop\", 0),\n+    ];\n+    let recorded = super::human_cost::recording(&rows);\n+    let (succeeded, written) = report(\"report.mjs\", budget, &recorded);\n+    assert!(succeeded);\n+    let written = written.expect(\"a figure\");\n+    assert_eq!(written[\"value\"], json!(7.3));\n+    let detail: Value = serde_json::from_str(written[\"detail\"].as_str().unwrap()).unwrap();\n+    assert_eq!(detail[\"totals\"][\"points\"], 730);\n+    assert_eq!(detail[\"phases\"].as_array().unwrap().len(), 5);\n+\n+    let with = |pointer: &str, replaced: Value| {\n+        let mut changed = recorded.clone();\n+        *changed.pointer_mut(pointer).unwrap() = replaced;\n+        changed\n+    };\n+    for refused in [\n+        with(\"/workload\", json!(\"another workload\")),\n+        with(\"/tasks\", json!(99)),\n+        with(\"/terminals/completed\", json!(33)),\n+        with(\"/recoveries/create\", json!(0)),\n+        with(\"/totals/points\", json!(700)),\n+        super::human_cost::recording(&rows[..3]),\n+    ] {\n+        assert_eq!(\n+            report(\"report.mjs\", budget, &refused),\n+            (false, None),\n+            \"{refused}\"\n+        );\n+    }\n+}\n+\n+#[test]\n+fn the_approval_reporter_hands_over_the_larger_sequence_of_the_journeys_calls() {\n+    let budget = super::approval::BUDGET;\n+    let calls = |extra: u64| -> Vec<Value> {\n+        super::approval::CALLS\n+            .iter()\n+            .map(|call| {\n+                let points = if call.starts_with(\"task project-human\") {\n+                    4\n+                } else {\n+                    1\n+                } + extra;\n+                json!({\"call\": call, \"requests\": points, \"points\": points})\n+            })\n+            .collect()\n+    };\n+    let recorded = super::approval::recording(\n+        super::approval::spent_of(calls(0)),\n+        super::approval::spent_of(calls(1)),\n+    );\n+    let (succeeded, written) = report(\"approval-report.mjs\", budget, &recorded);\n+    assert!(succeeded);\n+    let written = written.expect(\"a figure\");\n+    assert_eq!(\n+        written[\"value\"],\n+        json!(18),\n+        \"the screened sequence is the larger\"\n+    );\n+    let detail: Value = serde_json::from_str(written[\"detail\"].as_str().unwrap()).unwrap();\n+    assert_eq!(detail[\"unscreened\"][\"existing\"], 4);\n+    assert_eq!(detail[\"unscreened\"][\"projection\"], 8);\n+\n+    let mut reordered = calls(0);\n+    reordered.swap(1, 2);\n+    let mut unpriced = recorded.clone();\n+    unpriced[\"screened\"][\"projection\"] = json!(0);\n+    let mut uncounted = recorded.clone();\n+    uncounted[\"unscreened\"][\"calls\"][2][\"requests\"] = json!(-1);\n+    for refused in [\n+        super::approval::recording(\n+            super::approval::spent_of(reordered),\n+            recorded[\"screened\"].clone(),\n+        ),\n+        unpriced,\n+        uncounted,\n+        {\n+            let mut other = recorded.clone();\n+            other[\"workload\"] = json!(\"a plan copy\");\n+            other\n+        },\n+    ] {\n+        assert_eq!(\n+            report(\"approval-report.mjs\", budget, &refused),\n+            (false, None),\n+            \"{refused}\"\n+        );\n+    }\n+}"},{"sha":"47afba07bf735623c9121b102f9c35c05069d2c8","filename":"crates/onetaskgraph-github-projects-e2e/tests/e2e/human_routing.rs","status":"added","additions":309,"deletions":0,"changes":309,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_routing.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_routing.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fhuman_routing.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,309 @@\n+//! Where a human task projection lands: the `purpose: human-task` routes of the source a request\n+//! names, under the store's public boundary screened by the released onevcs commands — public\n+//! work to the public board, private and mixed work to the private one, and a private item with\n+//! nowhere private to go refused rather than written publicly.\n+\n+use std::path::PathBuf;\n+\n+use onetaskgraph_e2e_support::common::{Sandbox, stderr, stdout};\n+use onetaskgraph_e2e_support::fixtures::{GitHubBoardFields, document, github_projects_with_items};\n+use onetaskgraph_e2e_support::onevcs::{BoundaryCommand, BoundaryRecord, OnevcsHome};\n+use serde_json::{Value, json};\n+\n+use super::human_items::{HOST, PROJECT, PUBLIC_REPOSITORY, native, project_item, projected};\n+\n+/// The private repository private work names, and the private board creates its issues in.\n+const PRIVATE_REPOSITORY: &str = \"synthco/private-widgets\";\n+\n+/// The project the private board files planless items under.\n+const PRIVATE_PROJECT: &str = \"PROJECT-9\";\n+\n+/// A plan's project the public board already holds.\n+const PLAN_PROJECT: &str = \"PROJECT-7\";\n+\n+/// A private title, the term no public request may carry.\n+const PRIVATE_TITLE: &str = \"Rotate the private-widgets signing key\";\n+\n+/// A store of two loopback boards — `human-public` and `human-private` — whose writes are screened\n+/// by the released onevcs boundary commands against a home registering the public and the\n+/// private repository.\n+struct Routed {\n+    sandbox: Sandbox,\n+    public: GitHubBoardFields,\n+    private: GitHubBoardFields,\n+    home: OnevcsHome,\n+    record: BoundaryRecord,\n+    intents: PathBuf,\n+    public_config: Value,\n+    private_config: Value,\n+}\n+\n+impl Routed {\n+    fn new() -> Self {\n+        let sandbox = Sandbox::new();\n+        let (mut public_config, public) = github_projects_with_items(\n+            &sandbox,\n+            vec![\n+                project_item(PROJECT, PUBLIC_REPOSITORY),\n+                project_item(PLAN_PROJECT, PUBLIC_REPOSITORY),\n+            ],\n+        );\n+        public_config[\"repository\"] = json!(PUBLIC_REPOSITORY);\n+        public.use_repository(PUBLIC_REPOSITORY);\n+        public.use_canonical_issue_urls();\n+        public.file_new_items_without_status(true);\n+        let (mut private_config, private) = github_projects_with_items(\n+            &sandbox,\n+            vec![project_item(PRIVATE_PROJECT, PRIVATE_REPOSITORY)],\n+        );\n+        private_config[\"repository\"] = json!(PRIVATE_REPOSITORY);\n+        private.use_repository(PRIVATE_REPOSITORY);\n+        private.use_canonical_issue_urls();\n+        private.file_new_items_without_status(true);\n+        let (owner, name) = PUBLIC_REPOSITORY.split_once('/').unwrap();\n+        let mut home = OnevcsHome::new(&sandbox);\n+        home.public(owner, name);\n+        let (owner, name) = PRIVATE_REPOSITORY.split_once('/').unwrap();\n+        home.private(owner, name);\n+        let record = home.recorded(&sandbox);\n+        let intents = sandbox.subdirectory(\"intents\");\n+        let routed = Self {\n+            sandbox,\n+            public,\n+            private,\n+            home,\n+            record,\n+            intents,\n+            public_config,\n+            private_config,\n+        };\n+        routed.configure(true);\n+        routed\n+    }\n+\n+    /// Write the configuration, with the public source's private human-task route when\n+    /// `private_route` is — and, either way, a legacy route with no purpose sending the public\n+    /// repository's work to the private board, which a human task never takes.\n+    fn configure(&self, private_route: bool) {\n+        let mut routes = vec![\n+            json!({\"repositories\": [format!(\"github.com/{PUBLIC_REPOSITORY}\")],\n+                                     \"to\": \"human-private\"}),\n+        ];\n+        if private_route {\n+            routes.push(json!({\"classification\": \"private\", \"purpose\": \"human-task\",\n+                               \"to\": \"human-private\"}));\n+        }\n+        let projection =\n+            |project: &str| json!({\"host\": HOST, \"directory\": self.intents, \"project\": project});\n+        let sources = json!({\n+            \"human-public\": {\"plugin\": \"github-projects\", \"config\": self.public_config,\n+                             \"visibility\": \"public\", \"routes\": routes,\n+                             \"cache\": {\"dir\": self.sandbox.subdirectory(\"cache-public\")},\n+                             \"task_projection\": projection(PROJECT)},\n+            \"human-private\": {\"plugin\": \"github-projects\", \"config\": self.private_config,\n+                              \"visibility\": \"private\",\n+                              \"cache\": {\"dir\": self.sandbox.subdirectory(\"cache-private\")},\n+                              \"task_projection\": projection(PRIVATE_PROJECT)}\n+        });\n+        let mut configured: Value = serde_json::from_str(&document(&sources)).unwrap();\n+        configured[\"write_policy\"] = self.record.write_policy().clone();\n+        self.sandbox.project_document(&configured.to_string());\n+    }\n+\n+    /// Project `request` through the binary.\n+    fn project(&self, request: &Value) -> std::process::Output {\n+        let path = self.sandbox.project().join(format!(\n+            \"request-{}.json\",\n+            request[\"item_id\"].as_str().unwrap()\n+        ));\n+        std::fs::write(&path, request.to_string()).unwrap();\n+        self.sandbox\n+            .command()\n+            .args([\"task\", \"project-human\", \"--input\"])\n+            .arg(&path)\n+            .arg(\"--json\")\n+            .env(\"ONETASKGRAPH_HOST\", HOST)\n+            .env(\"ONEVCS_HOME\", self.home.path())\n+            .output()\n+            .unwrap()\n+    }\n+\n+    /// Every document `board` has been sent, joined with its variables, as one text.\n+    fn sent_to(board: &GitHubBoardFields) -> String {\n+        board\n+            .served()\n+            .iter()\n+            .map(|(query, variables)| format!(\"{query}\\n{variables}\"))\n+            .collect::<Vec<_>>()\n+            .join(\"\\n\")\n+    }\n+}\n+\n+/// A request from `human-public` for `item_id` naming `repositories`, titled `title`.\n+fn routed(item_id: &str, title: &str, repositories: &[&str]) -> Value {\n+    json!({\"schema_version\": 1, \"item_id\": item_id,\n+        \"owner\": {\"session\": \"session-1\", \"run\": \"run-1\", \"plan\": null},\n+        \"title\": title, \"body\": \"Decide before the release.\", \"priority\": \"urgent\",\n+        \"repositories\": repositories.iter().map(|r| format!(\"github.com/{r}\")).collect::<Vec<_>>(),\n+        \"project\": null, \"source\": \"human-public\", \"state\": \"open\", \"reason\": null})\n+}\n+\n+#[test]\n+fn public_work_lands_on_the_public_board_and_private_or_mixed_work_only_on_the_private_one() {\n+    let store = Routed::new();\n+\n+    let screened = store.record.calls().len();\n+    let public = projected(&store.project(&routed(\n+        \"public-item\",\n+        \"Choose the next public example\",\n+        &[PUBLIC_REPOSITORY],\n+    )));\n+    assert_eq!(public[\"source\"], \"human-public\");\n+    assert_eq!(public[\"project\"], PROJECT);\n+    assert!(\n+        public[\"url\"]\n+            .as_str()\n+            .unwrap()\n+            .starts_with(&format!(\"https://github.com/{PUBLIC_REPOSITORY}/issues/\")),\n+        \"{public}\"\n+    );\n+    assert_eq!(\n+        store.public.priority(&native(&public)).as_deref(),\n+        Some(\"Urgent\")\n+    );\n+    assert!(\n+        store.record.calls()[screened..]\n+            .iter()\n+            .any(|call| call.command == BoundaryCommand::Check),\n+        \"the public write was screened\"\n+    );\n+\n+    let public_before = store.public.served().len();\n+    for (item, repositories) in [\n+        (\"private-item\", vec![PRIVATE_REPOSITORY]),\n+        (\"mixed-item\", vec![PUBLIC_REPOSITORY, PRIVATE_REPOSITORY]),\n+    ] {\n+        let answer = projected(&store.project(&routed(item, PRIVATE_TITLE, &repositories)));\n+        assert_eq!(answer[\"source\"], \"human-private\", \"{item}\");\n+        assert_eq!(answer[\"project\"], PRIVATE_PROJECT, \"{item}\");\n+        let id = native(&answer);\n+        assert!(\n+            store.private.body(&id).as_str().is_some(),\n+            \"{item} is on the private board\"\n+        );\n+        assert_eq!(\n+            store.private.repository_of(&id).as_deref(),\n+            Some(PRIVATE_REPOSITORY)\n+        );\n+    }\n+    assert_eq!(\n+        store.public.served().len(),\n+        public_before,\n+        \"private and mixed work sent the public board nothing\"\n+    );\n+    assert!(!Routed::sent_to(&store.public).contains(PRIVATE_TITLE));\n+}\n+\n+#[test]\n+fn private_work_with_no_private_route_is_refused_and_nothing_reaches_either_board() {\n+    let store = Routed::new();\n+    store.configure(false);\n+    for (item, repositories) in [\n+        (\"private-unrouted\", vec![PRIVATE_REPOSITORY]),\n+        (\n+            \"mixed-unrouted\",\n+            vec![PUBLIC_REPOSITORY, PRIVATE_REPOSITORY],\n+        ),\n+    ] {\n+        let refused = store.project(&routed(item, PRIVATE_TITLE, &repositories));\n+        assert_ne!(refused.status.code(), Some(0), \"{item}\");\n+        let failure: Value = serde_json::from_str(&stdout(&refused)).unwrap();\n+        assert_eq!(\n+            failure[\"failure\"][\"kind\"], \"not-private-destination\",\n+            \"{item}\"\n+        );\n+        assert!(\n+            stderr(&refused).contains(\"human-public\"),\n+            \"{}\",\n+            stderr(&refused)\n+        );\n+    }\n+    assert!(store.public.served().is_empty());\n+    assert!(store.private.served().is_empty());\n+}\n+\n+#[test]\n+fn a_project_of_another_source_is_refused_and_a_plan_project_is_used_as_given() {\n+    let store = Routed::new();\n+    let mut elsewhere = routed(\n+        \"misplaced-item\",\n+        \"Choose the next public example\",\n+        &[PUBLIC_REPOSITORY],\n+    );\n+    elsewhere[\"project\"] = json!(format!(\"human-private:{PRIVATE_PROJECT}\"));\n+    let refused = store.project(&elsewhere);\n+    assert_ne!(refused.status.code(), Some(0));\n+    assert!(\n+        stderr(&refused).contains(\"routes to human-public\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert!(store.public.served().is_empty());\n+    assert!(store.private.served().is_empty());\n+\n+    let mut planned = routed(\n+        \"planned-item\",\n+        \"Review the plan's next step\",\n+        &[PUBLIC_REPOSITORY],\n+    );\n+    planned[\"owner\"][\"plan\"] = json!(\"plan-7\");\n+    planned[\"project\"] = json!(format!(\"human-public:{PLAN_PROJECT}\"));\n+    let answer = projected(&store.project(&planned));\n+    assert_eq!(answer[\"project\"], PLAN_PROJECT);\n+    let id = native(&answer);\n+    let issue = store\n+        .public\n+        .issues()\n+        .into_iter()\n+        .find(|issue| issue[\"id\"] == json!(id))\n+        .unwrap();\n+    assert_eq!(\n+        issue[\"parent\"], PLAN_PROJECT,\n+        \"filed under the plan's project\"\n+    );\n+}\n+\n+#[test]\n+fn a_legacy_route_still_routes_other_writers_and_never_a_human_task() {\n+    let store = Routed::new();\n+    let routed_legacy = store\n+        .sandbox\n+        .command()\n+        .args([\"sources\", \"route\", \"human-public\", \"--repository\"])\n+        .arg(format!(\"github.com/{PUBLIC_REPOSITORY}\"))\n+        .arg(\"--json\")\n+        .output()\n+        .unwrap();\n+    assert_eq!(\n+        routed_legacy.status.code(),\n+        Some(0),\n+        \"{}\",\n+        stderr(&routed_legacy)\n+    );\n+    let answer: Value = serde_json::from_str(&stdout(&routed_legacy)).unwrap();\n+    assert_eq!(answer[\"destination\"], \"human-private\", \"{answer}\");\n+    assert_eq!(\n+        answer[\"reachable\"],\n+        json!([\"human-public\", \"human-private\"])\n+    );\n+\n+    // The same repository's human task takes no entry without its purpose: public, it stays on\n+    // the public board it was sent to.\n+    let answer = projected(&store.project(&routed(\n+        \"legacy-item\",\n+        \"Choose the next public example\",\n+        &[PUBLIC_REPOSITORY],\n+    )));\n+    assert_eq!(answer[\"source\"], \"human-public\");\n+    assert!(store.private.served().is_empty());\n+}"},{"sha":"1056b6d0d8ae5e72b5c0a8e8fa505029cefcda2d","filename":"crates/onetaskgraph-github-projects-e2e/tests/e2e/main.rs","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fmain.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fmain.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fmain.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -27,6 +27,11 @@ mod copy_unsettled;\n mod fields;\n mod github_status_by_kind;\n mod graph;\n+// llmlint: ignore[expensive_tests_stay_behind_their_own_edge] The human-task-projection-points workload must run in this crate's `test` target, whose saved telemetry its reporter reads and whose `budgets` target judges it, as every budget of this crate does (`plan_copy`, `store_cost`); it is about six seconds of loopback-only work, and its default inputs are the crate's own, shared by every journey here.\n+mod human_cost;\n+mod human_items;\n+mod human_reporters;\n+mod human_routing;\n mod locate;\n mod member_copy;\n mod metadata_fields;"},{"sha":"f1a4be940823e9a53f9c6597e83c935701d3bc65","filename":"crates/onetaskgraph-github-projects-e2e/tests/e2e/plan_copy.rs","status":"modified","additions":16,"deletions":1,"changes":17,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fplan_copy.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fplan_copy.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects-e2e%2Ftests%2Fe2e%2Fplan_copy.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -583,6 +583,11 @@ impl Plan {\n \n     /// One command through the binary, attached to the clock.\n     pub fn run(&self, arguments: &[&str]) -> Output {\n+        self.run_with(arguments, &[])\n+    }\n+\n+    /// [`Self::run`], with `environment` set beside what every command of this plan is given.\n+    pub fn run_with(&self, arguments: &[&str], environment: &[(&str, &str)]) -> Output {\n         let mut command = match self.main_thread_stack {\n             #[cfg(unix)]\n             Some(kib) => {\n@@ -600,6 +605,7 @@ impl Plan {\n         }\n         command\n             .args(arguments)\n+            .envs(environment.iter().copied())\n             .envs(self.clock.client_env(self.client))\n             .stdout(Stdio::piped())\n             .stderr(Stdio::piped());\n@@ -2175,9 +2181,18 @@ impl Plan {\n \n     /// [`Self::measured`], for a command that may fail: what it exited with and printed.\n     pub(super) fn measured_output(&self, arguments: &[&str]) -> (Output, Vec<Call>) {\n+        self.measured_with(arguments, &[])\n+    }\n+\n+    /// [`Self::measured_output`], with `environment` set beside what every command is given.\n+    pub(super) fn measured_with(\n+        &self,\n+        arguments: &[&str],\n+        environment: &[(&str, &str)],\n+    ) -> (Output, Vec<Call>) {\n         let before = self.board.calls().len();\n         let lease = self.clock.lease(self.client);\n-        let output = self.run(arguments);\n+        let output = self.run_with(arguments, environment);\n         lease.wait_for_detach();\n         drop(lease);\n         (output, self.own_calls(before))"},{"sha":"0a0d6f9deda10f450d39c9becbb263284c6532c6","filename":"crates/onetaskgraph-github-projects/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects%2FCHANGELOG.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects%2FCHANGELOG.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.12.12...onetaskgraph-github-projects-v0.12.13) - 2026-10-30\n+\n+### Added\n+\n+- project human tasks through existing tracker routing ([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n+\n ## [0.12.11](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.12.10...onetaskgraph-github-projects-v0.12.11) - 2026-10-29\n \n ### Fixed"},{"sha":"03d912357ba695a9abfd351869afa83db9ba3c81","filename":"crates/onetaskgraph-github-projects/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n [package]\n name = \"onetaskgraph-github-projects\"\n description = \"A onetaskgraph source over GitHub Projects.\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n edition.workspace = true\n rust-version.workspace = true\n license.workspace = true"},{"sha":"d860e6c9d540c23d76d96ff8494caa008f28ad48","filename":"crates/onetaskgraph-github-projects/src/lib.rs","status":"modified","additions":102,"deletions":13,"changes":115,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects%2Fsrc%2Flib.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects%2Fsrc%2Flib.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects%2Fsrc%2Flib.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -654,6 +654,7 @@ pub mod change_token;\n mod expected;\n pub use expected::{CONTEXT_VERSION, WHOLE_MEMBERS, context_shapes};\n mod pacing;\n+mod projection;\n mod visibility;\n \n use accounting::Accounting;\n@@ -3689,7 +3690,8 @@ impl StatusTarget {\n /// [`GitHubProjectsConfig::repository`]. [`GitHubProjectsSource::creation_target`] makes\n /// that choice and says what it refuses before `createIssue`.\n // llmlint: ignore-end[comments_earn_their_place, contracts_have_one_source_or_a_drift_gate]\n-#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]\n+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n+#[serde(try_from = \"String\", into = \"String\")]\n struct RepositoryTarget {\n     owner: String, // llmlint: ignore[invalid_states_unrepresentable] Private, constructed only after `owner/name` validation in `new`.\n     name: String, // llmlint: ignore[invalid_states_unrepresentable] Private, constructed only after `owner/name` validation in `new`.\n@@ -3746,6 +3748,22 @@ impl RepositoryTarget {\n     }\n }\n \n+/// Read back from a kept context as the `owner/name` it was written as, refused unless\n+/// [`RepositoryTarget::parse`] takes it.\n+impl TryFrom<String> for RepositoryTarget {\n+    type Error = String;\n+\n+    fn try_from(slug: String) -> Result<Self, Self::Error> {\n+        Self::parse(&slug).map_err(|error| error.to_string())\n+    }\n+}\n+\n+impl From<RepositoryTarget> for String {\n+    fn from(target: RepositoryTarget) -> Self {\n+        target.slug()\n+    }\n+}\n+\n /// A source which reads GitHub afresh for every operation.\n pub struct GitHubProjectsSource {\n     /// This source's configured name, used both to tell a far end naming this source\n@@ -3943,6 +3961,24 @@ pub struct GitHubProjectsSource {\n     /// What [`expected`] holds for a write the store's cache expects: the journal while one is\n     /// open, the issues primed from the cache, and the comments known on each.\n     expected: expected::Held,\n+    /// What [`projection`] holds for a producer's projection: a kept placement awaiting its\n+    /// setup-context token, and where the last create was placed.\n+    projection: projection::Held,\n+}\n+\n+/// The board item a single field update's answer names, refused unless it is `item_id`.\n+fn field_update_item<'a>(data: &'a Value, item_id: &str) -> Result<&'a Value, SourceError> {\n+    let returned = data\n+        .pointer(\"/updateProjectV2ItemFieldValue/projectV2Item\")\n+        .ok_or_else(|| SourceError::Malformed {\n+            message: \"GitHub field update returned no project item\".into(),\n+        })?;\n+    if required_str(returned, \"id\")? != item_id {\n+        return Err(SourceError::Malformed {\n+            message: \"GitHub field update returned the wrong project item\".into(),\n+        });\n+    }\n+    Ok(returned)\n }\n \n /// GitHub's closed single-select color vocabulary.\n@@ -5070,6 +5106,7 @@ impl GitHubProjectsSource {\n             repository_cache: Mutex::new(BTreeMap::new()),\n             ledger,\n             expected: expected::Held::default(),\n+            projection: projection::Held::default(),\n         })\n     }\n \n@@ -6309,6 +6346,11 @@ impl GitHubProjectsSource {\n         if fields_known || self.repository_cache()?.contains_key(repository) {\n             return Ok(());\n         }\n+        // A placement an earlier process kept is taken only while the project issue this create\n+        // has just read shows its setup-context token unchanged; see `projection`.\n+        if self.placed_by_kept(repository, incoming.parent) {\n+            return Ok(());\n+        }\n         let data = self\n             .graphql(\n                 graphql::CREATION_CONTEXT,\n@@ -8450,6 +8492,48 @@ impl GitHubProjectsSource {\n             None => None,\n         };\n \n+        // A record primed from what a producer wrote holds no body anybody read, so an update\n+        // changing the body reads it first: by the `Status` write's own answer when the update\n+        // moves the option — the mutation answering with the issue whole — and otherwise by\n+        // reading the issue. The body is then composed against what GitHub holds now.\n+        let mut option_selected = false;\n+        // The mark stays until a read lands, so an update that writes no body, or one whose\n+        // read fails, leaves the next update of it to read the body too.\n+        if (update.content.is_some()\n+            || !update.metadata_set.is_empty()\n+            || !update.metadata_remove.is_empty()\n+            || update.delivers.is_some()\n+            || edges.is_some())\n+            && self.is_unread(id)\n+        {\n+            let live = match status_move.as_ref().filter(|moving| moving.moves.option()) {\n+                Some(moving) => {\n+                    option_selected = true;\n+                    Some(\n+                        self.select_reading_body(\n+                            moving.board.as_str(),\n+                            &item.item_id,\n+                            &moving.field,\n+                            &moving.option,\n+                        )\n+                        .await?,\n+                    )\n+                }\n+                None => {\n+                    self.forget(id)?;\n+                    let Some(read) = self.item_by_id(id).await? else {\n+                        return Ok(None);\n+                    };\n+                    read.raw_body\n+                }\n+            };\n+            let (visible, read_slot) = metadata_body(live.clone())?;\n+            self.mark_read(id);\n+            item.raw_body = live;\n+            item.body = visible;\n+            item.slot = read_slot;\n+        }\n+\n         let mut slot = item.slot.clone();\n         for (key, value) in &update.metadata_set {\n             slot.insert(key.as_str().to_owned(), value.clone());\n@@ -8515,7 +8599,10 @@ impl GitHubProjectsSource {\n         // closes, as a whole write does — then the `blockedBy` difference, then the body.\n         let mut board_writes: Vec<(&BoardId, (String, Value))> = Vec::new();\n         let mut clears: Vec<(&BoardId, &str)> = Vec::new();\n-        if let Some(moving) = status_move.as_ref().filter(|moving| moving.moves.option()) {\n+        if let Some(moving) = status_move\n+            .as_ref()\n+            .filter(|moving| moving.moves.option() && !option_selected)\n+        {\n             board_writes.push((\n                 &moving.board,\n                 (\n@@ -8690,17 +8777,7 @@ impl GitHubProjectsSource {\n                 },\"readPriority\":false,\"priorityName\":PRIORITY_FIELD}),\n             )\n             .await?;\n-        let returned = data\n-            .pointer(\"/updateProjectV2ItemFieldValue/projectV2Item\")\n-            .ok_or_else(|| SourceError::Malformed {\n-                message: \"GitHub field update returned no project item\".into(),\n-            })?;\n-        if required_str(returned, \"id\")? != item_id {\n-            return Err(SourceError::Malformed {\n-                message: \"GitHub field update returned the wrong project item\".into(),\n-            });\n-        }\n-        Ok(())\n+        field_update_item(&data, item_id).map(|_| ())\n     }\n \n     /// GitHub accepts one value per field mutation; aliases combine those mutations in\n@@ -13195,6 +13272,18 @@ impl TaskSource for GitHubProjectsSource {\n     fn unprime(&self, id: &NativeId) {\n         self.unprime_held(id);\n     }\n+    fn placement_context(&self) -> Option<Value> {\n+        self.placement_held()\n+    }\n+    fn prime_placement(&self, context: &Value) -> bool {\n+        self.prime_placement_held(context)\n+    }\n+    fn written_context(&self, id: &NativeId) -> Option<Value> {\n+        self.written_held(id)\n+    }\n+    fn prime_written(&self, id: &NativeId, context: &Value, task: &Task) -> bool {\n+        self.prime_written_held(id, context, task)\n+    }\n     fn begin_journal(&self) {\n         self.expected.begin();\n     }"},{"sha":"c9c6389baf92d877cb83b07e6781722484b06680","filename":"crates/onetaskgraph-github-projects/src/projection.rs","status":"added","additions":482,"deletions":0,"changes":482,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects%2Fsrc%2Fprojection.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-github-projects%2Fsrc%2Fprojection.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-github-projects%2Fsrc%2Fprojection.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,482 @@\n+//! What a producer's projection carries from one process to the next on this board: the\n+//! placement a create reads, held behind a setup-context token, and the ids of an item this\n+//! process wrote — never its title or its content. `docs/task-projection.md` states the\n+//! contract; here, the token is computed from the project-issue read every create already\n+//! makes, which carries the board's whole field list, so taking a kept placement adds no\n+//! request.\n+\n+use std::sync::{Mutex, MutexGuard};\n+\n+use onetaskgraph_plugin_api::{\n+    Classification, NativeId, Repository, Status, StatusCategory, Task, asset_sha256,\n+};\n+use serde::{Deserialize, Serialize};\n+use serde_json::{Value, json};\n+\n+use super::{\n+    BoardFields, BoardKind, ContentKind, GitHubProjectsSource, HeldPriority, ItemKind,\n+    RepositoryTarget, Resolved, compose_body,\n+};\n+\n+/// The version of both contexts, so one an earlier or later build wrote is declined rather\n+/// than misread.\n+const PROJECTION_CONTEXT_VERSION: u64 = 2;\n+\n+/// [`PROJECTION_CONTEXT_VERSION`], the one version a context may carry: any other refuses to\n+/// deserialize, so a context of another build is never taken.\n+#[derive(Clone, Copy, Serialize, Deserialize)]\n+#[serde(try_from = \"u64\", into = \"u64\")]\n+struct ContextVersion;\n+\n+impl TryFrom<u64> for ContextVersion {\n+    type Error = String;\n+\n+    fn try_from(version: u64) -> Result<Self, Self::Error> {\n+        if version == PROJECTION_CONTEXT_VERSION {\n+            Ok(Self)\n+        } else {\n+            Err(format!(\n+                \"projection context version {version} is another build's\"\n+            ))\n+        }\n+    }\n+}\n+\n+impl From<ContextVersion> for u64 {\n+    fn from(_: ContextVersion) -> Self {\n+        PROJECTION_CONTEXT_VERSION\n+    }\n+}\n+\n+/// A non-empty GitHub node id, as a kept context names one.\n+#[derive(Clone, Serialize, Deserialize)]\n+#[serde(try_from = \"String\", into = \"String\")]\n+struct NodeId(String);\n+\n+impl TryFrom<String> for NodeId {\n+    type Error = String;\n+\n+    fn try_from(id: String) -> Result<Self, Self::Error> {\n+        if id.is_empty() || id.chars().any(char::is_whitespace) {\n+            Err(\"a node id is non-empty and holds no whitespace\".to_owned())\n+        } else {\n+            Ok(Self(id))\n+        }\n+    }\n+}\n+\n+impl From<NodeId> for String {\n+    fn from(id: NodeId) -> Self {\n+        id.0\n+    }\n+}\n+\n+/// An issue's address as GitHub answered it: an absolute HTTP or HTTPS URL naming a host.\n+#[derive(Clone, Serialize, Deserialize)]\n+#[serde(try_from = \"String\", into = \"String\")]\n+struct IssueUrl(String);\n+\n+impl TryFrom<String> for IssueUrl {\n+    type Error = String;\n+\n+    fn try_from(url: String) -> Result<Self, Self::Error> {\n+        let parsed = reqwest::Url::parse(&url).map_err(|error| error.to_string())?;\n+        if matches!(parsed.scheme(), \"http\" | \"https\") && parsed.has_host() {\n+            Ok(Self(url))\n+        } else {\n+            Err(format!(\"{url} is no issue address\"))\n+        }\n+    }\n+}\n+\n+impl From<IssueUrl> for String {\n+    fn from(url: IssueUrl) -> Self {\n+        url.0\n+    }\n+}\n+\n+/// A setup-context token: the lowercase SHA-256 [`setup_token`] spells.\n+#[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]\n+#[serde(try_from = \"String\", into = \"String\")]\n+struct SetupToken(String);\n+\n+impl TryFrom<String> for SetupToken {\n+    type Error = String;\n+\n+    fn try_from(token: String) -> Result<Self, Self::Error> {\n+        if token.len() == 64\n+            && token\n+                .bytes()\n+                .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))\n+        {\n+            Ok(Self(token))\n+        } else {\n+            Err(\"a setup-context token is a lowercase SHA-256\".to_owned())\n+        }\n+    }\n+}\n+\n+impl From<SetupToken> for String {\n+    fn from(token: SetupToken) -> Self {\n+        token.0\n+    }\n+}\n+\n+/// The placement a create in this board reads before it writes, and the token it holds under.\n+#[derive(Clone, Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+struct Placement {\n+    version: ContextVersion,\n+    /// The setup-context token the placement was kept under.\n+    token: SetupToken,\n+    /// The repository the issue is created in.\n+    repository: RepositoryTarget,\n+    /// That repository's node id.\n+    repository_id: NodeId,\n+}\n+\n+/// The ids of one task issue this source wrote, and the board — its owner and number — it was\n+/// written on: everything a later write needs to address it, and nothing of its work or of its\n+/// state. Its title, body, metadata, status, option and closure are not representable here, so\n+/// a later update sends every part of itself rather than skipping one on a kept record's word.\n+#[derive(Serialize, Deserialize)]\n+#[serde(deny_unknown_fields)]\n+struct WrittenIds {\n+    version: ContextVersion,\n+    owner: String,\n+    number: u32,\n+    /// The issue's node id.\n+    issue: NodeId,\n+    /// Its board item's node id.\n+    item: NodeId,\n+    /// The board's node id.\n+    board: NodeId,\n+    /// The issue's own number in its repository.\n+    issue_number: Option<u64>,\n+    url: Option<IssueUrl>,\n+    /// The repository the issue lives in.\n+    own_repository: Option<Repository>,\n+    /// The project issue it is filed under.\n+    parent: Option<NativeId>,\n+    repositories: Vec<Repository>,\n+    classification: Classification,\n+    /// The definitions of the board's fields — ids and options, which the setup-context token\n+    /// guards for a create — that its writes select by id.\n+    board_fields: FieldDefinitions,\n+}\n+\n+/// A board's field definitions as a read of its `fields` gives them: a `nodes` list whose every\n+/// field names its id and name, and whose every option, where it has options, does too.\n+#[derive(Clone, Serialize, Deserialize)]\n+#[serde(try_from = \"Value\", into = \"Value\")]\n+struct FieldDefinitions(Value);\n+\n+impl TryFrom<Value> for FieldDefinitions {\n+    type Error = String;\n+\n+    fn try_from(definitions: Value) -> Result<Self, Self::Error> {\n+        let named = |value: &Value| {\n+            [\"id\", \"name\"].iter().all(|key| {\n+                value\n+                    .get(key)\n+                    .and_then(Value::as_str)\n+                    .is_some_and(|text| !text.is_empty())\n+            })\n+        };\n+        let nodes = definitions\n+            .get(\"nodes\")\n+            .and_then(Value::as_array)\n+            .ok_or(\"field definitions hold a `nodes` list\")?;\n+        for field in nodes {\n+            let options_named = match field.get(\"options\") {\n+                None => true,\n+                Some(options) => options\n+                    .as_array()\n+                    .is_some_and(|options| options.iter().all(named)),\n+            };\n+            if !named(field) || !options_named {\n+                return Err(format!(\"a field definition names no id and name: {field}\"));\n+            }\n+        }\n+        Ok(Self(definitions))\n+    }\n+}\n+\n+impl From<FieldDefinitions> for Value {\n+    fn from(definitions: FieldDefinitions) -> Self {\n+        definitions.0\n+    }\n+}\n+\n+impl WrittenIds {\n+    /// The record a write of the issue takes: these ids, `task`'s title, content and priority as\n+    /// the caller states them, and no state — every status, option and closure unknown.\n+    fn resolved(self, task: &Task) -> Option<Resolved> {\n+        let raw_body =\n+            compose_body(task.content.as_deref(), &std::collections::BTreeMap::new()).ok()?;\n+        let fields = self\n+            .board_fields\n+            .0\n+            .get(\"nodes\")\n+            .and_then(Value::as_array)\n+            .cloned()?;\n+        Some(Resolved {\n+            item_id: self.item.into(),\n+            id: NativeId(self.issue.into()),\n+            content_kind: ContentKind::Issue,\n+            kind: BoardKind::Work(ItemKind::Task),\n+            title: task.title.clone(),\n+            body: task.content.clone(),\n+            raw_body,\n+            status: Status {\n+                category: StatusCategory::Unknown,\n+                name: String::new(),\n+            },\n+            option: None,\n+            priority: HeldPriority::Read(task.priority),\n+            closed: false,\n+            reason: None,\n+            delivers: Vec::new(),\n+            delivered_by: Vec::new(),\n+            labels: Vec::new(),\n+            parent: self.parent,\n+            origin: None,\n+            projected: std::collections::BTreeMap::new(),\n+            number: self.issue_number,\n+            url: self.url.map(String::from),\n+            created_at: None,\n+            updated_at: None,\n+            item_updated_at: None,\n+            comment_count: None,\n+            relationship_events: None,\n+            served_at: None,\n+            facets: None,\n+            own_repository: self.own_repository,\n+            repositories: self.repositories,\n+            classification: self.classification,\n+            slot: std::collections::BTreeMap::new(),\n+            board_id: Some(self.board.into()),\n+            fields,\n+            board_fields: Some(self.board_fields.into()),\n+            blocked_by: None,\n+        })\n+    }\n+}\n+\n+/// What this source holds for projections, for the length of one process.\n+#[derive(Default)]\n+pub(super) struct Held {\n+    /// A placement an earlier process kept, not yet held to this process's token.\n+    kept: Mutex<Option<Placement>>,\n+    /// The repository and project issue the last create of this process was placed by.\n+    placed: Mutex<Option<(RepositoryTarget, Option<NativeId>)>>,\n+    /// Issues primed from a producer's written context whose body nothing in this process has\n+    /// read: an update changing one reads the body first.\n+    unread: Mutex<std::collections::BTreeSet<NativeId>>,\n+}\n+\n+/// A lock an earlier panic poisoned is read as it stands: what these hold is an optimisation,\n+/// and a create that cannot use it reads instead.\n+fn held<T>(lock: &Mutex<T>) -> MutexGuard<'_, T> {\n+    lock.lock()\n+        .unwrap_or_else(std::sync::PoisonError::into_inner)\n+}\n+\n+/// The setup-context token of `board`'s fields, for an issue created in `repository` under\n+/// `parent` by a source `private` or not: the digest of each field's id, name, kind and options,\n+/// in id order, beside the rest.\n+fn setup_token(\n+    board: &BoardFields,\n+    repository: &RepositoryTarget,\n+    parent: Option<&NativeId>,\n+    private: bool,\n+) -> Option<SetupToken> {\n+    let mut fields: Vec<Value> = board\n+        .fields\n+        .get(\"nodes\")?\n+        .as_array()?\n+        .iter()\n+        .map(|field| {\n+            let options = field\n+                .get(\"options\")\n+                .and_then(Value::as_array)\n+                .map(|options| {\n+                    options\n+                        .iter()\n+                        .map(|option| json!([option.get(\"id\"), option.get(\"name\")]))\n+                        .collect::<Vec<_>>()\n+                });\n+            json!({\"id\": field.get(\"id\"), \"name\": field.get(\"name\"),\n+                   \"kind\": field.get(\"__typename\"), \"type\": field.get(\"dataType\"),\n+                   \"options\": options})\n+        })\n+        .collect();\n+    fields.sort_by_key(|field| field[\"id\"].to_string());\n+    let parts = json!({\"version\": PROJECTION_CONTEXT_VERSION, \"board\": board.id.as_str(),\n+        \"fields\": fields, \"repository\": repository.slug(), \"parent\": parent.map(|id| &id.0),\n+        \"private\": private});\n+    SetupToken::try_from(asset_sha256(parts.to_string().as_bytes())).ok()\n+}\n+\n+impl GitHubProjectsSource {\n+    /// The placement this process's last create read, under the token it holds now.\n+    pub(super) fn placement_held(&self) -> Option<Value> {\n+        let (repository, parent) = held(&self.projection.placed).clone()?;\n+        let fields = self.fields_cache().ok()?.clone()?;\n+        let repository_id = self.repository_cache().ok()?.get(&repository)?.clone();\n+        let token = setup_token(\n+            &fields,\n+            &repository,\n+            parent.as_ref(),\n+            self.is_declared_private(),\n+        )?;\n+        serde_json::to_value(Placement {\n+            version: ContextVersion,\n+            token,\n+            repository: repository.clone(),\n+            repository_id: NodeId::try_from(repository_id).ok()?,\n+        })\n+        .ok()\n+    }\n+\n+    /// Hold a placement an earlier process kept, to be taken only once this process's own read\n+    /// of the project issue shows its token unchanged.\n+    pub(super) fn prime_placement_held(&self, context: &Value) -> bool {\n+        let Ok(placement) = serde_json::from_value::<Placement>(context.clone()) else {\n+            return false;\n+        };\n+        *held(&self.projection.kept) = Some(placement);\n+        true\n+    }\n+\n+    /// Record where a create is placed, and take the kept placement when the project issue this\n+    /// create already read shows its token unchanged — answering whether it did, so the create\n+    /// reads its context only when it did not.\n+    pub(super) fn placed_by_kept(\n+        &self,\n+        repository: &RepositoryTarget,\n+        parent: Option<&NativeId>,\n+    ) -> bool {\n+        *held(&self.projection.placed) = Some((repository.clone(), parent.cloned()));\n+        let Some(kept) = held(&self.projection.kept).clone() else {\n+            return false;\n+        };\n+        let Some(board) = parent.and_then(|parent| {\n+            self.resolved_cache()\n+                .ok()?\n+                .get(parent)\n+                .and_then(Resolved::carried_board)\n+        }) else {\n+            return false;\n+        };\n+        let current = setup_token(&board, repository, parent, self.is_declared_private());\n+        if kept.repository != *repository || current.as_ref() != Some(&kept.token) {\n+            return false;\n+        }\n+        let (Ok(mut fields), Ok(mut repositories)) = (self.fields_cache(), self.repository_cache())\n+        else {\n+            return false;\n+        };\n+        *fields = Some(board);\n+        repositories.insert(repository.clone(), kept.repository_id.into());\n+        true\n+    }\n+\n+    /// The ids of issue `id`, which this process wrote, and of the board it sits on.\n+    pub(super) fn written_held(&self, id: &NativeId) -> Option<Value> {\n+        let item = self.resolved_cache().ok()?.get(id).cloned()?;\n+        if item.kind != BoardKind::Work(ItemKind::Task) || item.content_kind != ContentKind::Issue {\n+            return None;\n+        }\n+        serde_json::to_value(WrittenIds {\n+            version: ContextVersion,\n+            owner: self.owner.clone(),\n+            number: self.project_number,\n+            issue: NodeId::try_from(item.id.0).ok()?,\n+            item: NodeId::try_from(item.item_id).ok()?,\n+            board: NodeId::try_from(item.board_id?).ok()?,\n+            issue_number: item.number,\n+            url: item.url.map(IssueUrl::try_from).transpose().ok()?,\n+            own_repository: item.own_repository,\n+            parent: item.parent,\n+            repositories: item.repositories,\n+            classification: item.classification,\n+            // The board's whole field list when the read carried it, else the definitions of the\n+            // fields the item holds values of — which a read of it by origin carries, and which\n+            // name every field its later writes select.\n+            board_fields: FieldDefinitions::try_from(item.board_fields.unwrap_or_else(\n+                || json!({\"nodes\": item.fields, \"pageInfo\": {\"hasNextPage\": false}}),\n+            ))\n+            .ok()?,\n+        })\n+        .ok()\n+    }\n+\n+    /// Take `context` with `task`'s title and content as the record of issue `id`.\n+    ///\n+    /// What it holds of the body is the caller's word, not a read, so it is marked unread: an\n+    /// update that changes the body reads the body first (`targeted_update`), and one that does\n+    /// not sends no body at all.\n+    pub(super) fn prime_written_held(&self, id: &NativeId, context: &Value, task: &Task) -> bool {\n+        let Ok(written) = serde_json::from_value::<WrittenIds>(context.clone()) else {\n+            return false;\n+        };\n+        // Only a task issue of this board, addressed by its id, directs a write.\n+        if written.owner != self.owner\n+            || written.number != self.project_number\n+            || written.issue.0 != id.0\n+            || task.id != *id\n+        {\n+            return false;\n+        }\n+        let Some(item) = written.resolved(task) else {\n+            return false;\n+        };\n+        let Ok(mut cache) = self.resolved_cache() else {\n+            return false;\n+        };\n+        cache.insert(id.clone(), item);\n+        held(&self.projection.unread).insert(id.clone());\n+        true\n+    }\n+\n+    /// Whether issue `id`'s record was primed from a written context and its body not read\n+    /// since.\n+    pub(super) fn is_unread(&self, id: &NativeId) -> bool {\n+        held(&self.projection.unread).contains(id)\n+    }\n+\n+    /// Record that issue `id`'s body has now been read.\n+    pub(super) fn mark_read(&self, id: &NativeId) {\n+        held(&self.projection.unread).remove(id);\n+    }\n+\n+    /// Select `option` in the board field `field` of the item `item` by the mutation that answers\n+    /// with the issue whole, and answer with the issue's body as GitHub holds it now: a write of\n+    /// the body composed against that answer is composed against the body as it stands.\n+    pub(super) async fn select_reading_body(\n+        &self,\n+        board: &str,\n+        item: &str,\n+        field: &str,\n+        option: &str,\n+    ) -> Result<String, onetaskgraph_plugin_api::SourceError> {\n+        let data = self\n+            .graphql_sent(\n+                super::graphql::UPDATE_FIELD_WHOLE,\n+                super::expected::whole_variables(json!({\"input\":{\n+                    \"projectId\":board,\"itemId\":item,\"fieldId\":field,\n+                    \"value\":{\"singleSelectOptionId\":option}\n+                },\"readPriority\":false,\"priorityName\":super::PRIORITY_FIELD})),\n+            )\n+            .await?;\n+        let returned = super::field_update_item(&data, item)?;\n+        Ok(returned\n+            .pointer(\"/content/body\")\n+            .and_then(Value::as_str)\n+            .ok_or_else(|| onetaskgraph_plugin_api::SourceError::Malformed {\n+                message: \"GitHub field update returned no issue body\".into(),\n+            })?\n+            .to_owned())\n+    }\n+}"},{"sha":"628109f91806896c4a091dcc0388e9b8ecfa6926","filename":"crates/onetaskgraph-in-memory/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-in-memory%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-in-memory%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-in-memory%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n [package]\n name = \"onetaskgraph-in-memory\"\n description = \"A complete onetaskgraph source held entirely in memory, configured with the work it serves and the capabilities it declares.\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n edition.workspace = true\n rust-version.workspace = true\n license.workspace = true"},{"sha":"4b6fa93222c7a3f8b37edc932a801083640f87a8","filename":"crates/onetaskgraph-linear-e2e/Cargo.toml","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear-e2e%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -15,6 +15,8 @@ authors.workspace = true\n \n # Every dependency is a dev-dependency: the package has no library or binary of its own.\n [dev-dependencies]\n+# Validate the actual document replay replies with the shared pinned-schema guard.\n+graphql-parser.workspace = true\n # The warm budget measurements drive the engine the binary links, as a long-lived caller holds\n # one source instance across writes.\n onetaskgraph-core = { workspace = true, features = [\"linear\"] }"},{"sha":"aaa8f920947561f549656d5735a6f04f7f75b1af","filename":"crates/onetaskgraph-linear-e2e/budgets.yaml","status":"modified","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Fbudgets.yaml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Fbudgets.yaml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear-e2e%2Fbudgets.yaml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -197,3 +197,25 @@ budgets:\n     unit: requests\n     direction: max\n     threshold: 20\n+  - id: linear-live-documents-created-per-ordinary-pass\n+    description: >-\n+      Successful documentCreate operations recorded by both live lanes during one ordinary\n+      CI pass protect Linear's retained-trash capacity. Deleted documents still count;\n+      initialization and failed-pass residue are reported separately as diagnostic detail.\n+    labels: [linear]\n+    measure: reported\n+    command: [\"cargo\", \"test\", \"--quiet\", \"-p\", \"onetaskgraph-linear-e2e\", \"--all-features\", \"--locked\", \"--test\", \"e2e\", \"--\", \"budget_runner::report\", \"--exact\", \"--nocapture\"]\n+    unit: documents/pass\n+    direction: max\n+    threshold: 0\n+  - id: linear-live-documents-created-per-daily-pass\n+    description: >-\n+      Successful documentCreate operations recorded by both live lanes during one daily\n+      CI pass protect Linear's retained-trash capacity. Deleted documents still count;\n+      initialization and failed-pass residue are reported separately as diagnostic detail.\n+    labels: [linear]\n+    measure: reported\n+    command: [\"cargo\", \"test\", \"--quiet\", \"-p\", \"onetaskgraph-linear-e2e\", \"--all-features\", \"--locked\", \"--test\", \"e2e\", \"--\", \"budget_runner::report\", \"--exact\", \"--nocapture\"]\n+    unit: documents/pass\n+    direction: max\n+    threshold: 4"},{"sha":"e650396ac19c449b5117385dc08055e6b1ee43d3","filename":"crates/onetaskgraph-linear-e2e/project.json","status":"modified","additions":17,"deletions":4,"changes":21,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Fproject.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Fproject.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear-e2e%2Fproject.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -63,6 +63,8 @@\n       \"inputs\": [\n         \"default\",\n         \"^default\",\n+        { \"env\": \"ONETASKGRAPH_LINEAR_DOCUMENT_MODE\" },\n+        { \"env\": \"GITHUB_ACTIONS\" },\n         { \"env\": \"LINEAR_API_KEY\" },\n         { \"env\": \"LINEAR_WRITE_TEAM\" },\n         { \"env\": \"ONETASKGRAPH_LIVE_REQUIRED\" }\n@@ -71,17 +73,28 @@\n     },\n     \"budgets\": {\n       \"executor\": \"nx:run-commands\",\n-      \"dependsOn\": [\"test\"],\n+      \"//\": \"llmlint: ignore[external_service_suite_stays_out_of_the_affected_tier,expensive_tests_stay_behind_their_own_edge] Both lane tests produce the HTTP journals this report consumes, including when only the consumer changes; both are required prerequisites within the Linear budget edge. On its own line, this directive covers exactly the dependsOn line below it, the one biome lets it share no line with.\",\n+      \"dependsOn\": [\"test\", \"onetaskgraph-linear:test\"],\n       \"options\": {\n         \"command\": \"bun run onebudgetspec check crates/onetaskgraph-linear-e2e/budgets.yaml\"\n       },\n       \"cache\": true,\n       \"inputs\": [\n         \"default\",\n         \"^default\",\n-        { \"dependentTasksOutputFiles\": \"**/telemetry/onetaskgraph-linear-e2e/*.json\" }\n-      ],\n-      \"//\": \"Judges the figures `test` recorded and runs no journey again. Cached: they are requests a deterministic loopback workspace served, in an environment with nothing of the host's, so the key is this project's files (budgets.yaml among them), the measured code (the binary, the engine and the harness in `default`, the Linear plugin and the contract through `^default`), the recorded telemetry, and the onebudgetspec pins in bun.lock and Cargo.lock (sharedGlobals).\"\n+        { \"dependentTasksOutputFiles\": \"**/telemetry/onetaskgraph-linear-e2e/*.json\" },\n+        { \"dependentTasksOutputFiles\": \"**/telemetry/onetaskgraph-linear/*.json\" }\n+      ]\n+    },\n+    \"live-documents\": {\n+      \"executor\": \"nx:run-commands\",\n+      \"cache\": false,\n+      \"parallelism\": false,\n+      \"options\": {\n+        \"command\": \"cargo test --locked -p onetaskgraph-linear-e2e --test e2e -- linear_assets::live_disposable_issue_and_document_assets_copy_and_recopy --exact --nocapture\"\n+      },\n+      \"//\": \"Explicit daily creation and initialization only: this target is outside the affected check fan-out and must reach the service on every invocation.\",\n+      \"dependsOn\": [\"onetaskgraph:build\"]\n     },\n     \"coverage\": {\n       \"executor\": \"nx:run-commands\","},{"sha":"2ec52136c0547786a8f03932545230232188f6b0","filename":"crates/onetaskgraph-linear-e2e/tests/e2e/budget_runner.rs","status":"modified","additions":151,"deletions":0,"changes":151,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Fbudget_runner.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Fbudget_runner.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Fbudget_runner.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -17,6 +17,8 @@ use serde_json::{Value, json};\n use crate::common::Sandbox;\n use crate::telemetry;\n \n+use crate::linear_assets::document_lifecycle::journal as transport_journal;\n+\n #[test]\n fn report() {\n     let budget = match std::env::var(\"ONEBUDGETSPEC_BUDGET_ID\") {\n@@ -559,3 +561,152 @@ fn each_absolute_linear_budget_is_reported_as_the_recorded_hour_holds_it_and_ref\n         }\n     }\n }\n+\n+#[test]\n+fn document_reports_require_complete_transport_journals_from_both_lanes() {\n+    let sandbox = Sandbox::new();\n+    let assets = sandbox.subdirectory(\"assets\");\n+    let plugin = sandbox.subdirectory(\"plugin\");\n+    let result = sandbox.subdirectory(\"result\").join(\"report.json\");\n+    let budget = \"linear-live-documents-created-per-daily-pass\";\n+    let run = |id: &str| {\n+        run_report(&assets, |command| {\n+            command\n+                .env(\"LINEAR_PLUGIN_TELEMETRY_DIR\", &plugin)\n+                .env(\"ONEBUDGETSPEC_BUDGET_ID\", id)\n+                .env(\"ONEBUDGETSPEC_RESULT\", &result);\n+        })\n+    };\n+    for (lane, directory) in [(\"plugin\", &plugin), (\"assets\", &assets)] {\n+        for mode in [\"ordinary\", \"fresh\", \"initialize\", \"failure\"] {\n+            let failed = run(budget);\n+            assert!(\n+                !failed.status.success(),\n+                \"missing {lane}/{mode} was accepted\"\n+            );\n+            assert!(!result.exists(), \"missing journals emitted a report\");\n+            let journal = transport_journal::Journal::new(lane, mode)\n+                .durable(directory.to_path_buf())\n+                .expect(\"durable transport journal\");\n+            journal.begin(mode);\n+            // The ordinary pass's one create is a cold rebuild of a missing standing slot,\n+            // which is filed under that journey and must stay out of the ordinary total.\n+            if mode != \"ordinary\" {\n+                journal.journey(\"probe\");\n+            }\n+            // Exercise the same acknowledgement recorder and serializer the HTTP replay\n+            // uses, rather than a separately maintained consumer-shaped record.\n+            journal.observe(\n+                &json!({\"query\":\"mutation { documentCreate(input: {}) { success } }\"}),\n+                &json!({\"data\":{\"documentCreate\":{\"success\":true}}}),\n+            );\n+            assert_eq!(journal.count(), 1);\n+            let interrupted = run(budget);\n+            assert!(\n+                !interrupted.status.success(),\n+                \"unfinished durable {lane}/{mode} was accepted\"\n+            );\n+            assert!(!result.exists(), \"unfinished journal emitted a report\");\n+            journal.finish_in(directory).expect(\"writable journal\");\n+            let path = directory.join(format!(\"linear-live-documents-{mode}.json\"));\n+            let mut recorded: Value =\n+                serde_json::from_slice(&std::fs::read(&path).expect(\"journal\")).expect(\"JSON\");\n+            recorded[\"residue\"] = json!(1);\n+            std::fs::write(path, recorded.to_string()).expect(\"writable diagnostic\");\n+        }\n+    }\n+    let success = run(budget);\n+    assert!(\n+        success.status.success(),\n+        \"{}\",\n+        String::from_utf8_lossy(&success.stderr)\n+    );\n+    let report: Value =\n+        serde_json::from_slice(&std::fs::read(&result).expect(\"report\")).expect(\"JSON\");\n+    assert_eq!(report[\"value\"], 2.0, \"{report:#}\");\n+    let detail = report[\"detail\"].as_str().expect(\"per-lane detail\");\n+    for lane in [\"plugin\", \"assets\"] {\n+        for mode in [\"ordinary\", \"fresh\", \"initialize\", \"failure\"] {\n+            assert!(detail.contains(&format!(\"{lane}/{mode}:\")), \"{detail}\");\n+        }\n+    }\n+    assert!(\n+        detail.contains(\"plugin/failure residue: 1 documents\"),\n+        \"{detail}\"\n+    );\n+    for lane in [\"plugin\", \"assets\"] {\n+        assert!(\n+            detail.contains(&format!(\n+                \"{lane}/ordinary cold rebuild: 1 documents, outside the pass total\"\n+            )),\n+            \"{detail}\"\n+        );\n+    }\n+    let ordinary = run(\"linear-live-documents-created-per-ordinary-pass\");\n+    assert!(\n+        ordinary.status.success(),\n+        \"{}\",\n+        String::from_utf8_lossy(&ordinary.stderr)\n+    );\n+    let report: Value =\n+        serde_json::from_slice(&std::fs::read(&result).expect(\"ordinary report\")).expect(\"JSON\");\n+    assert_eq!(\n+        report[\"value\"], 0.0,\n+        \"a cold rebuild is never counted in the ordinary pass: {report:#}\"\n+    );\n+    std::fs::remove_file(&result).expect(\"remove previous report\");\n+    let path = plugin.join(\"linear-live-documents-fresh.json\");\n+    std::fs::write(&path, \"not JSON\").expect(\"writable\");\n+    let malformed = run(budget);\n+    assert!(!malformed.status.success());\n+    assert!(String::from_utf8_lossy(&malformed.stderr).contains(\"invalid plugin/fresh journal\"));\n+    assert!(!result.exists(), \"malformed journal emitted a report\");\n+    for invalid in [\n+        json!({\"schema_version\":2,\"lane\":\"plugin\",\"mode\":\"fresh\",\"completed\":true,\"operations\":[]}),\n+        json!({\"schema_version\":1,\"lane\":\"assets\",\"mode\":\"fresh\",\"completed\":true,\"operations\":[]}),\n+        json!({\"schema_version\":1,\"lane\":\"plugin\",\"mode\":\"ordinary\",\"completed\":true,\"operations\":[]}),\n+        json!({\"schema_version\":1,\"lane\":\"plugin\",\"mode\":\"fresh\",\"completed\":true,\"operations\":[{\"operation\":\"documentCreate\",\"success\":true}]}),\n+        json!({\"schema_version\":1,\"lane\":\"plugin\",\"mode\":\"fresh\",\"completed\":true,\"operations\":[{\"journey\":\"\",\"operation\":\"documentCreate\",\"success\":true}]}),\n+        json!({\"schema_version\":1,\"lane\":\"plugin\",\"mode\":\"fresh\",\"completed\":true,\"operations\":[{\"journey\":\"probe\",\"operation\":\"documentUpdate\",\"success\":true}]}),\n+        json!({\"schema_version\":1,\"lane\":\"plugin\",\"mode\":\"fresh\",\"completed\":true,\"operations\":[],\"residue\":\"private body\"}),\n+        json!({\"schema_version\":1,\"lane\":\"plugin\",\"mode\":\"fresh\",\"completed\":false,\"operations\":[]}),\n+        json!({\"schema_version\":1,\"lane\":\"plugin\",\"mode\":\"fresh\",\"completed\":true}),\n+        json!({\"schema_version\":1,\"lane\":\"plugin\",\"mode\":\"fresh\",\"completed\":true,\"operations\":[{\"journey\":\"probe\",\"operation\":\"documentCreate\",\"success\":false}]}),\n+    ] {\n+        std::fs::write(&path, invalid.to_string()).expect(\"writable\");\n+        let refused = run(budget);\n+        assert!(\n+            !refused.status.success(),\n+            \"invalid journal was accepted: {invalid}\"\n+        );\n+        assert!(!result.exists(), \"invalid journal emitted a report\");\n+    }\n+}\n+\n+#[test]\n+fn durable_transport_journal_counts_aliased_and_spaced_creates_before_completion() {\n+    let sandbox = Sandbox::new();\n+    let directory = sandbox.subdirectory(\"durable-journal\");\n+    let journal = transport_journal::Journal::new(\"assets\", \"fresh\")\n+        .durable(directory.clone())\n+        .unwrap();\n+    journal.journey(\"transport-acknowledgements\");\n+    journal.observe(&json!({\"query\":\"mutation { first: documentCreate (input:{title:\\\"one\\\"}) {success} second: documentCreate(input:{title:\\\"two\\\"}) {success} }\"}),&json!({\"data\":{\"first\":{\"success\":true,\"document\":null},\"second\":{\"success\":true}}}));\n+    journal.observe(\n+        &json!({\"query\":\"mutation { documentCreate (input:{title:\\\"refused\\\"}) {success} }\"}),\n+        &json!({\"data\":{\"documentCreate\":{\"success\":false}}}),\n+    );\n+    assert_eq!(\n+        journal.count(),\n+        2,\n+        \"each actual successful operation counts, even without a returned id\"\n+    );\n+    let path = directory.join(\"linear-live-documents-fresh.json\");\n+    let incomplete: Value = serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();\n+    assert_eq!(incomplete[\"completed\"], false);\n+    assert_eq!(incomplete[\"operations\"].as_array().unwrap().len(), 2);\n+    journal.finish_in(&directory).unwrap();\n+    let complete: Value = serde_json::from_slice(&std::fs::read(path).unwrap()).unwrap();\n+    assert_eq!(complete[\"completed\"], true);\n+    assert_eq!(complete[\"operations\"], incomplete[\"operations\"]);\n+}"},{"sha":"9e935bf0acb24cd39c5d1c73b1890704aa80a4b7","filename":"crates/onetaskgraph-linear-e2e/tests/e2e/human_items.rs","status":"added","additions":292,"deletions":0,"changes":292,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Fhuman_items.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Fhuman_items.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Fhuman_items.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,292 @@\n+//! Human task projection into Linear through the binary: `task project-human --input FILE\n+//! --json` against the loopback Linear workspace — an organization's item kept in its plan's\n+//! existing project, its canonical issue URL answered, dismissed with and without a reason, a\n+//! lost create answer bound to its one verified origin match, and a person's edit surviving the\n+//! terminal projection.\n+\n+use std::path::PathBuf;\n+use std::process::{Output, Stdio};\n+use std::sync::{Arc, Mutex};\n+\n+use serde_json::{Value, json};\n+\n+use crate::common::{Sandbox, stderr, stdout};\n+use crate::fixtures::{LinearWorkspace, document, linear_workspace};\n+use crate::linear::{eng_mapping, held, issue, linear};\n+\n+const HOST: &str = \"linear-projection-host\";\n+\n+/// The plan's existing project the organization's items land in.\n+const PLAN_PROJECT: &str = \"P-1\";\n+\n+struct Store {\n+    sandbox: Sandbox,\n+    workspace: LinearWorkspace,\n+}\n+\n+impl Store {\n+    fn new() -> Self {\n+        let sandbox = Sandbox::new();\n+        let (config, workspace) = linear_workspace(\n+            &sandbox,\n+            held(\n+                vec![issue(\"I-1\", \"Todo\", json!({\"project\": PLAN_PROJECT}))],\n+                vec![\n+                    json!({\"id\": PLAN_PROJECT, \"title\": \"The organization's plan\",\n+                    \"content\": \"The plan.\", \"labels\": [],\n+                    \"status\": {\"category\": \"in-progress\", \"name\": \"Doing\"}}),\n+                ],\n+                vec![],\n+            ),\n+        );\n+        let intents: PathBuf = sandbox.subdirectory(\"intents\");\n+        let mut org = linear(&config, json!({\"status_mapping\": eng_mapping()}));\n+        org[\"task_projection\"] = json!({\"host\": HOST, \"directory\": intents});\n+        org[\"cache\"] = json!({\"dir\": sandbox.subdirectory(\"cache-org\")});\n+        sandbox.project_document(&document(&json!({\"org\": org})));\n+        Self { sandbox, workspace }\n+    }\n+\n+    fn file(&self, request: &Value) -> PathBuf {\n+        let path = self.sandbox.project().join(format!(\n+            \"request-{}-{}.json\",\n+            request[\"item_id\"].as_str().unwrap(),\n+            request[\"state\"].as_str().unwrap()\n+        ));\n+        std::fs::write(&path, request.to_string()).unwrap();\n+        path\n+    }\n+\n+    fn project(&self, request: &Value) -> Output {\n+        self.sandbox\n+            .command()\n+            .args([\"task\", \"project-human\", \"--input\"])\n+            .arg(self.file(request))\n+            .arg(\"--json\")\n+            .env(\"ONETASKGRAPH_HOST\", HOST)\n+            .output()\n+            .unwrap()\n+    }\n+\n+    /// Project `request`, the binary killed once the workspace applied the first request\n+    /// `matches` holds of, its answer never reaching it.\n+    fn crashed(&self, request: &Value, operation: &'static str) {\n+        let mut command = self.sandbox.subprocess(onetaskgraph_e2e_support::binary());\n+        command\n+            .args([\"task\", \"project-human\", \"--input\"])\n+            .arg(self.file(request))\n+            .arg(\"--json\")\n+            .env(\"ONETASKGRAPH_HOST\", HOST)\n+            .stdout(Stdio::null())\n+            .stderr(Stdio::null());\n+        let child = Arc::new(Mutex::new(command.spawn().unwrap()));\n+        let killed = Arc::clone(&child);\n+        self.workspace.after_request(\n+            move |query: &str, _: &Value| query.contains(operation),\n+            0,\n+            move |_| {\n+                let _ = killed.lock().unwrap().kill();\n+            },\n+        );\n+        let status = loop {\n+            if let Some(status) = child.lock().unwrap().try_wait().unwrap() {\n+                break status;\n+            }\n+            std::thread::sleep(std::time::Duration::from_millis(5));\n+        };\n+        assert!(!status.success(), \"the binary finished before {operation}\");\n+    }\n+\n+    /// One task as `task show --json` reads it back.\n+    fn shown(&self, id: &str) -> Value {\n+        let output = self\n+            .sandbox\n+            .command()\n+            .args([\"--json\", \"task\", \"show\", id])\n+            .output()\n+            .unwrap();\n+        assert_eq!(output.status.code(), Some(0), \"{}\", stderr(&output));\n+        serde_json::from_str::<Value>(&stdout(&output)).unwrap()[\"items\"][0][\"item\"].clone()\n+    }\n+\n+    /// Every issue the workspace holds whose metadata names `item_id` as its human item.\n+    fn tickets(&self, item_id: &str) -> usize {\n+        let output = self\n+            .sandbox\n+            .command()\n+            .args([\"--json\", \"task\", \"list\", \"--source\", \"org\", \"--metadata\"])\n+            .arg(format!(\"human.item_id={item_id}\"))\n+            .output()\n+            .unwrap();\n+        assert_eq!(output.status.code(), Some(0), \"{}\", stderr(&output));\n+        serde_json::from_str::<Value>(&stdout(&output)).unwrap()[\"items\"]\n+            .as_array()\n+            .unwrap()\n+            .len()\n+    }\n+\n+    fn creates_since(&self, from: usize) -> usize {\n+        self.workspace.served()[from..]\n+            .iter()\n+            .filter(|(query, _)| query.contains(\"issueCreate\"))\n+            .count()\n+    }\n+}\n+\n+/// An organization's open item for its plan's project.\n+fn request(item_id: &str) -> Value {\n+    json!({\"schema_version\": 1, \"item_id\": item_id,\n+        \"owner\": {\"session\": \"session-1\", \"run\": \"run-1\", \"plan\": \"plan-1\"},\n+        \"title\": format!(\"Decide on {item_id}\"), \"body\": \"Choose the release date.\",\n+        \"priority\": \"urgent\", \"repositories\": [\"github.com/orgco/service\"],\n+        \"project\": format!(\"org:{PLAN_PROJECT}\"), \"source\": \"org\", \"state\": \"open\",\n+        \"reason\": null})\n+}\n+\n+fn projected(output: &Output) -> Value {\n+    assert_eq!(\n+        output.status.code(),\n+        Some(0),\n+        \"{}\\n{}\",\n+        stdout(output),\n+        stderr(output)\n+    );\n+    serde_json::from_str(&stdout(output)).unwrap()\n+}\n+\n+#[test]\n+fn an_organization_item_lands_in_its_plans_project_and_is_dismissed_with_and_without_a_reason() {\n+    let store = Store::new();\n+    for (item, reason) in [\n+        (\"org-plain\", None),\n+        (\"org-reasoned\", Some(\"The customer withdrew the request.\")),\n+    ] {\n+        let open = request(item);\n+        let answer = projected(&store.project(&open));\n+        assert_eq!(answer[\"source\"], \"org\");\n+        assert_eq!(answer[\"project\"], PLAN_PROJECT);\n+        let url = answer[\"url\"].as_str().unwrap();\n+        assert!(\n+            url.starts_with(\"https://linear.app/\") && url.contains(\"/issue/\"),\n+            \"{answer}\"\n+        );\n+        let task = answer[\"task\"].as_str().unwrap();\n+        let shown = store.shown(task);\n+        assert_eq!(shown[\"project\"], PLAN_PROJECT, \"kept in the plan's project\");\n+        assert_eq!(shown[\"priority\"], \"urgent\");\n+        assert_eq!(shown[\"url\"], url, \"the card's URL is the issue's own\");\n+        assert_eq!(shown[\"metadata\"][\"human.item_id\"], item);\n+\n+        // A retry of the bound item is the same answer and sends nothing.\n+        let before = store.workspace.served().len();\n+        assert_eq!(projected(&store.project(&open)), answer);\n+        assert_eq!(store.workspace.served().len(), before);\n+\n+        let mut dismissed = open.clone();\n+        dismissed[\"state\"] = json!(\"dismissed\");\n+        dismissed[\"reason\"] = json!(reason);\n+        assert_eq!(projected(&store.project(&dismissed)), answer);\n+        let shown = store.shown(task);\n+        assert_eq!(shown[\"status\"][\"category\"], \"cancelled\");\n+        assert_eq!(\n+            shown[\"metadata\"]\n+                .get(\"human.reason\")\n+                .and_then(Value::as_str),\n+            reason,\n+            \"{item}\"\n+        );\n+        // A different terminal state is refused, writing nothing.\n+        let mut completed = open;\n+        completed[\"state\"] = json!(\"completed\");\n+        let before = store.workspace.served().len();\n+        let refused = store.project(&completed);\n+        assert_ne!(refused.status.code(), Some(0));\n+        assert!(\n+            stderr(&refused).contains(\"conflicting terminal\"),\n+            \"{}\",\n+            stderr(&refused)\n+        );\n+        assert_eq!(store.workspace.served().len(), before);\n+        assert_eq!(store.tickets(item), 1);\n+    }\n+}\n+\n+#[test]\n+fn a_lost_create_answer_is_bound_to_its_one_verified_origin_match_in_linear() {\n+    let store = Store::new();\n+    let open = request(\"org-lost\");\n+    store.crashed(&open, \"issueCreate\");\n+    assert_eq!(store.tickets(\"org-lost\"), 1);\n+    let before = store.workspace.served().len();\n+    let answer = projected(&store.project(&open));\n+    assert_eq!(store.creates_since(before), 0, \"no second create\");\n+    assert_eq!(store.tickets(\"org-lost\"), 1);\n+    assert_eq!(answer[\"project\"], PLAN_PROJECT);\n+    let mut completed = open;\n+    completed[\"state\"] = json!(\"completed\");\n+    assert_eq!(projected(&store.project(&completed)), answer);\n+    assert_eq!(\n+        store.shown(answer[\"task\"].as_str().unwrap())[\"status\"][\"category\"],\n+        \"done\"\n+    );\n+}\n+\n+#[test]\n+fn an_edit_a_person_makes_in_linear_survives_the_terminal_projection() {\n+    let store = Store::new();\n+    let open = request(\"org-edited\");\n+    let answer = projected(&store.project(&open));\n+    let task = answer[\"task\"].as_str().unwrap();\n+    let native = task.split_once(':').unwrap().1;\n+    store\n+        .workspace\n+        .edit_description(native, \"A person rewrote this in Linear.\");\n+    let mut dismissed = open;\n+    dismissed[\"state\"] = json!(\"dismissed\");\n+    dismissed[\"reason\"] = json!(\"No longer needed.\");\n+    projected(&store.project(&dismissed));\n+    let shown = store.shown(task);\n+    assert_eq!(\n+        shown[\"content\"], \"A person rewrote this in Linear.\",\n+        \"{shown}\"\n+    );\n+    assert_eq!(shown[\"metadata\"][\"human.reason\"], \"No longer needed.\");\n+}\n+\n+#[test]\n+fn one_origin_match_with_another_page_behind_it_is_refused_rather_than_bound() {\n+    let store = Store::new();\n+    let open = request(\"org-paged\");\n+    store.crashed(&open, \"issueCreate\");\n+    assert_eq!(store.tickets(\"org-paged\"), 1);\n+    // The origin lookup answers its one match and says another page follows: that page is no\n+    // whole answer, so the match is not bound and no second create is sent.\n+    store.workspace.bend_answers(\n+        |query: &str, variables: &Value| {\n+            query.contains(\"issues(\")\n+                && variables\n+                    .pointer(\"/filter/and/1/description/contains\")\n+                    .and_then(Value::as_str)\n+                    .is_some_and(|phrase| phrase.contains(\"human-task:\"))\n+        },\n+        1,\n+        |_, data: &mut Value| {\n+            data[\"issues\"][\"pageInfo\"] = json!({\"hasNextPage\": true, \"endCursor\": \"more\"});\n+        },\n+    );\n+    let before = store.workspace.served().len();\n+    let refused = store.project(&open);\n+    assert_ne!(refused.status.code(), Some(0), \"{}\", stdout(&refused));\n+    assert!(\n+        stderr(&refused).contains(\"zero or multiple origin matches\"),\n+        \"{}\",\n+        stderr(&refused)\n+    );\n+    assert_eq!(store.creates_since(before), 0, \"no second create\");\n+    assert_eq!(store.tickets(\"org-paged\"), 1);\n+\n+    // Answered whole, the same match binds.\n+    let answer = projected(&store.project(&open));\n+    assert_eq!(answer[\"project\"], PLAN_PROJECT);\n+    assert_eq!(store.tickets(\"org-paged\"), 1);\n+}"},{"sha":"78dc5ebbbbcfcded4a170591eb184cbf6ea9b018","filename":"crates/onetaskgraph-linear-e2e/tests/e2e/linear_assets.rs","status":"modified","additions":1299,"deletions":115,"changes":1414,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Flinear_assets.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Flinear_assets.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Flinear_assets.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -7,6 +7,7 @@ use std::path::Path;\n use std::sync::{Arc, Mutex};\n use std::time::Duration;\n \n+use onetaskgraph_e2e_support::loopback::{self, After};\n use onetaskgraph_e2e_support::{clock::SimulatedClock, images};\n use onetaskgraph_plugin_api::asset_sha256;\n use serde_json::{Value, json};\n@@ -18,6 +19,12 @@ const REQUEST_WINDOW: Duration = Duration::from_secs(3_600);\n // llmlint: ignore-end[contracts_have_one_source_or_a_drift_gate]\n \n use crate::fixtures::{LinearMarkdown, LinearWorkspace, document, linear_workspace};\n+#[path = \"../../../onetaskgraph-linear/tests/document_lifecycle/mod.rs\"]\n+pub(crate) mod document_lifecycle;\n+#[path = \"../../../onetaskgraph-linear/tests/document_lifecycle/replay_schema.rs\"]\n+mod document_replay_schema;\n+use document_lifecycle::Mode;\n+use onetaskgraph_linear::live_artifact::{Scope, Slot};\n \n #[derive(Default)]\n struct Upload {\n@@ -30,6 +37,13 @@ struct Upload {\n #[derive(Default)]\n struct State {\n     uploads: BTreeMap<usize, Upload>,\n+    document_journal: Option<document_lifecycle::journal::Journal>,\n+    refused_document_deletes: std::collections::BTreeSet<String>,\n+    document_delete_attempts: Vec<String>,\n+    ignore_asset_reset: bool,\n+    /// A document id, the content a lagging replica still holds for it, and how many more\n+    /// `document(id:)` reads that replica answers.\n+    stale_document: Option<(String, String, usize)>,\n     requests: usize,\n     tokens: f64,\n     last_refill: Duration,\n@@ -75,13 +89,27 @@ impl Workspace {\n         let serving = state.clone();\n         let timing = clock.clone();\n         let address = endpoint.clone();\n-        std::thread::spawn(move || {\n-            for stream in listener.incoming().flatten() {\n-                let state = serving.clone();\n-                let clock = timing.clone();\n-                let backend = backend.clone();\n-                let address = address.clone();\n-                std::thread::spawn(move || serve(stream, &backend, &address, &state, &clock));\n+        // Each connection the binary keeps alive is answered on a thread of its own, forwarding\n+        // over one kept connection of its own to the backend, so no request costs a connection\n+        // at either end — a connection per request is what AGENTS.md says exhausts the Windows\n+        // runner's loopback ports under the rest of this suite.\n+        let upstream_address = backend.parse().unwrap();\n+        loopback::serve_each(listener, move || {\n+            let state = serving.clone();\n+            let clock = timing.clone();\n+            let backend = backend.clone();\n+            let address = address.clone();\n+            let mut upstream = loopback::Upstream::new(upstream_address);\n+            move |request: &loopback::Request, stream: &mut TcpStream| {\n+                serve(\n+                    request,\n+                    stream,\n+                    &mut upstream,\n+                    &backend,\n+                    &address,\n+                    &state,\n+                    &clock,\n+                )\n             }\n         });\n         config[\"endpoint\"] = json!(format!(\"{endpoint}/0/graphql\"));\n@@ -142,6 +170,10 @@ fn answer(stream: &mut TcpStream, status: u16, body: &[u8]) {\n }\n \n fn answer_hinted(stream: &mut TcpStream, status: u16, body: &[u8], hint: Option<&str>) {\n+    respond(stream, status, body, hint, \"close\");\n+}\n+\n+fn respond(stream: &mut TcpStream, status: u16, body: &[u8], hint: Option<&str>, connection: &str) {\n     let now = std::time::SystemTime::now()\n         .duration_since(std::time::UNIX_EPOCH)\n         .unwrap()\n@@ -165,21 +197,48 @@ fn answer_hinted(stream: &mut TcpStream, status: u16, body: &[u8], hint: Option<\n     };\n     write!(\n         stream,\n-        \"HTTP/1.1 {status} Fixture\\r\\nContent-Length: {}\\r\\n{headers}Connection: close\\r\\n\\r\\n\",\n+        \"HTTP/1.1 {status} Fixture\\r\\nContent-Length: {}\\r\\n{headers}Connection: {connection}\\r\\n\\r\\n\",\n         body.len()\n     )\n     .unwrap();\n     stream.write_all(body).unwrap();\n }\n \n+/// [`answer`] on a connection the client keeps alive, which therefore stays open.\n+fn reply(stream: &mut TcpStream, status: u16, body: &[u8]) {\n+    reply_hinted(stream, status, body, Some(\"normal\"));\n+}\n+\n+/// [`answer_hinted`] on a connection the client keeps alive.\n+fn reply_hinted(stream: &mut TcpStream, status: u16, body: &[u8], hint: Option<&str>) {\n+    respond(stream, status, body, hint, \"keep-alive\");\n+}\n+\n+fn complete_replay_document(row: &mut Value) {\n+    if !row.is_object() {\n+        return;\n+    }\n+    let recorded: Value = serde_json::from_str(include_str!(\n+        \"../../../onetaskgraph-linear/tests/fixtures/documents.json\"\n+    ))\n+    .unwrap();\n+    for field in [\"createdAt\", \"updatedAt\"] {\n+        if row[field].is_null() {\n+            row[field] = recorded[\"data\"][\"documents\"][\"nodes\"][0][field].clone();\n+        }\n+    }\n+}\n+\n fn serve(\n-    mut stream: TcpStream,\n+    request: &loopback::Request,\n+    stream: &mut TcpStream,\n+    upstream: &mut loopback::Upstream,\n     backend: &str,\n     address: &str,\n     state: &Mutex<State>,\n     clock: &SimulatedClock,\n-) {\n-    let bytes = read_request(&mut stream);\n+) -> After {\n+    let bytes = request.bytes();\n     let split = bytes\n         .windows(4)\n         .position(|window| window == b\"\\r\\n\\r\\n\")\n@@ -284,15 +343,15 @@ fn serve(\n                 | (Some(\"redirect-read\"), \"verifying read\")\n         ) {\n             stream.write_all(b\"HTTP/1.1 302 Found\\r\\nLocation: https://example.invalid/credential-target\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\").unwrap();\n-            return;\n+            return After::Close;\n         }\n         if matches!(\n             (fault, stage),\n             (Some(\"disconnect-mutation\"), \"mutation\")\n                 | (Some(\"disconnect-PUT\"), \"PUT\")\n                 | (Some(\"disconnect-read\"), \"verifying read\")\n         ) {\n-            return;\n+            return After::Close;\n         }\n         if stage == \"mutation\" {\n             let bad = match fault {\n@@ -307,8 +366,8 @@ fn serve(\n                 _ => None,\n             };\n             if let Some(body) = bad {\n-                answer(&mut stream, 200, body.as_bytes());\n-                return;\n+                reply(stream, 200, body.as_bytes());\n+                return After::KeepOpen;\n             }\n         }\n     }\n@@ -329,8 +388,8 @@ fn serve(\n         } else {\n             body.to_string()\n         };\n-        answer_hinted(\n-            &mut stream,\n+        reply_hinted(\n+            stream,\n             if stage == \"mutation\" && status == 429 && fault != Some(\"mutation-http429\") {\n                 400\n             } else {\n@@ -339,17 +398,125 @@ fn serve(\n             body.as_bytes(),\n             hint,\n         );\n-        return;\n+        return After::KeepOpen;\n     }\n     if !asset_request {\n-        let mut upstream = TcpStream::connect(backend).unwrap();\n-        let original = String::from_utf8_lossy(&bytes[..split]).replacen(path, \"/graphql\", 1);\n-        upstream.write_all(original.as_bytes()).unwrap();\n-        upstream.write_all(&bytes[split..]).unwrap();\n-        let mut response = Vec::new();\n-        upstream.read_to_end(&mut response).unwrap();\n-        stream.write_all(&response).unwrap();\n-        return;\n+        use onetaskgraph_linear::graphql;\n+        let mut forwarded = gql.clone();\n+        let query = gql[\"query\"].as_str().unwrap();\n+        // Linear refuses a document over its complexity cap with HTTP 400 before reading a\n+        // row, so this stand-in does too for the lane's own standing-set listings, the documents\n+        // that model is reconciled for. It does not score the binary's documents: Linear prices\n+        // `issues` by the rows it returns (it accepts that listing at 250, `MAX_PAGE_SIZE`),\n+        // which the structural model over-prices — `ISSUES_CACHED` at 100 rows scores 16355 —\n+        // and those are priced by `cache_budget::price` from Linear's own scores instead.\n+        if [document_lifecycle::DOCUMENTS, document_lifecycle::PROJECTS].contains(&query)\n+            && let Some(refused) =\n+                document_replay_schema::complexity::refusal(query, &gql[\"variables\"])\n+        {\n+            reply(\n+                stream,\n+                400,\n+                json!({\"errors\":[{\"message\":refused}]})\n+                    .to_string()\n+                    .as_bytes(),\n+            );\n+            return After::KeepOpen;\n+        }\n+        if query.contains(\"documentUpdate(\")\n+            && gql[\"variables\"][\"input\"][\"content\"]\n+                .as_str()\n+                .is_some_and(|content| content.starts_with(\"Reset for invocation \"))\n+            && state.lock().unwrap().ignore_asset_reset\n+        {\n+            reply(\n+                stream,\n+                200,\n+                json!({\"data\":{\"documentUpdate\":{\"success\":true}}})\n+                    .to_string()\n+                    .as_bytes(),\n+            );\n+            return After::KeepOpen;\n+        }\n+        if query.contains(\"documentDelete(\") {\n+            let id = gql[\"variables\"][\"id\"].as_str().unwrap();\n+            let refused = {\n+                let mut state = state.lock().unwrap();\n+                state.document_delete_attempts.push(id.to_owned());\n+                state.refused_document_deletes.contains(id)\n+            };\n+            if refused {\n+                reply(\n+                    stream,\n+                    200,\n+                    json!({\"data\":{\"documentDelete\":{\"success\":false}}})\n+                        .to_string()\n+                        .as_bytes(),\n+                );\n+                return After::KeepOpen;\n+            }\n+        }\n+        let discovery = query.contains(\"documents(\") && query.contains(\"team{key}\");\n+        if discovery {\n+            forwarded[\"query\"] = json!(graphql::DOCUMENTS);\n+            forwarded[\"variables\"][\"first\"] = json!(100);\n+        } else if query.contains(\"documentCreate(\") {\n+            forwarded[\"query\"] = json!(graphql::DOCUMENT_CREATE);\n+        } else if query.contains(\"documentUpdate(\") {\n+            forwarded[\"query\"] = json!(graphql::DOCUMENT_UPDATE);\n+        } else if query.contains(\"documentDelete(\") {\n+            forwarded[\"query\"] = json!(graphql::DOCUMENT_DELETE);\n+        }\n+        let body = forwarded.to_string();\n+        let response = upstream.forward(format!(\"POST /graphql HTTP/1.1\\r\\nHost: {backend}\\r\\nAuthorization: fixture-key\\r\\nContent-Type: application/json\\r\\nContent-Length: {}\\r\\n\\r\\n{body}\",body.len()).as_bytes());\n+        let split = response.windows(4).position(|b| b == b\"\\r\\n\\r\\n\").unwrap() + 4;\n+        let mut response: Value = serde_json::from_slice(&response[split..]).unwrap();\n+        if discovery\n+            && let Some(nodes) = response\n+                .pointer_mut(\"/data/documents/nodes\")\n+                .and_then(Value::as_array_mut)\n+        {\n+            for node in nodes {\n+                node[\"team\"] = json!({\"key\":\"ENG\"});\n+                if node[\"project\"].is_object() {\n+                    node[\"project\"][\"teams\"] =\n+                        json!({\"nodes\":[{\"key\":\"ENG\"}],\"pageInfo\":{\"hasNextPage\":false}});\n+                }\n+            }\n+        }\n+        if let Some(row) = response.pointer_mut(\"/data/document\")\n+            && let Some((id, content, reads)) = &mut state.lock().unwrap().stale_document\n+            && row[\"id\"].as_str() == Some(id.as_str())\n+            && *reads > 0\n+        {\n+            *reads -= 1;\n+            row[\"content\"] = json!(content);\n+        }\n+        if let Some(journal) = &state.lock().unwrap().document_journal {\n+            // Record acknowledgement before validating its shape, including uncertain IDs.\n+            journal.observe(&gql, &response);\n+            for pointer in [\n+                \"/data/document\",\n+                \"/data/documentCreate/document\",\n+                \"/data/documentUpdate/document\",\n+            ] {\n+                if let Some(row) = response.pointer_mut(pointer) {\n+                    complete_replay_document(row);\n+                }\n+            }\n+            if let Some(nodes) = response\n+                .pointer_mut(\"/data/documents/nodes\")\n+                .and_then(Value::as_array_mut)\n+            {\n+                for row in nodes {\n+                    complete_replay_document(row);\n+                }\n+            }\n+            document_replay_schema::validate(query, &response)\n+                .expect(\"recorded Linear response shape\");\n+        }\n+        reply(stream, 200, response.to_string().as_bytes());\n+        return After::KeepOpen;\n     }\n     let response = {\n         let mut state = state.lock().unwrap();\n@@ -387,6 +554,13 @@ fn serve(\n         }\n     };\n     let mut response = response;\n+    if state.lock().unwrap().document_journal.is_some() && stage == \"mutation\" {\n+        document_replay_schema::validate(\n+            gql[\"query\"].as_str().unwrap(),\n+            &serde_json::from_slice(&response).unwrap(),\n+        )\n+        .expect(\"recorded fileUpload response shape\");\n+    }\n     if stage == \"mutation\" {\n         let mut body: Value = serde_json::from_slice(&response).unwrap();\n         let file = &mut body[\"data\"][\"fileUpload\"][\"uploadFile\"];\n@@ -415,7 +589,8 @@ fn serve(\n         }\n         response = body.to_string().into_bytes();\n     }\n-    answer(&mut stream, 200, &response);\n+    reply(stream, 200, &response);\n+    After::KeepOpen\n }\n \n pub(crate) struct Journey {\n@@ -986,7 +1161,11 @@ struct LiveUploads {\n \n /// A forwarding observer changes only the signed PUT URL, keeping Linear's asset URL intact, so\n /// the journey's own authenticated GET of each asset reaches Linear directly.\n-fn live_observer(key: String) -> (String, Arc<Mutex<LiveUploads>>) {\n+fn live_observer(\n+    key: String,\n+    journal: document_lifecycle::journal::Journal,\n+    upstream: String,\n+) -> (String, Arc<Mutex<LiveUploads>>) {\n     let listener = TcpListener::bind(\"127.0.0.1:0\").unwrap();\n     let endpoint = format!(\"http://{}\", listener.local_addr().unwrap());\n     let state = Arc::new(Mutex::new(LiveUploads::default()));\n@@ -1045,14 +1224,15 @@ fn live_observer(key: String) -> (String, Arc<Mutex<LiveUploads>>) {\n                 let response = runtime\n                     .block_on(\n                         client\n-                            .post(\"https://api.linear.app/graphql\")\n+                            .post(&upstream)\n                             .header(\"Authorization\", &key)\n                             .json(&request)\n                             .send(),\n                     )\n                     .unwrap();\n                 let status = response.status().as_u16();\n                 let mut body: Value = runtime.block_on(response.json()).unwrap();\n+                journal.observe(&request, &body);\n                 let mut state = recording.lock().unwrap();\n                 if request[\"query\"].as_str().unwrap().contains(\"fileUpload(\") {\n                     let id = state.signed.len();\n@@ -1085,6 +1265,226 @@ fn live_observer(key: String) -> (String, Arc<Mutex<LiveUploads>>) {\n     (format!(\"{endpoint}/graphql\"), state)\n }\n \n+/// The line [`asset_origins`] ends each origin's content with, naming the invocation that made it.\n+const INVOCATION_LINE: &str = \"Invocation \";\n+\n+/// Reads after a copy that may still answer the destination as it stood before, and their spacing.\n+const SHOW_READS: u32 = 21;\n+\n+/// Each origin of one invocation, its content ending in an [`INVOCATION_LINE`] no other\n+/// invocation shares.\n+///\n+/// The standing asset slot keeps one title across runs, and the images are seeded from the title,\n+/// so without that line every ordinary pass would copy byte-for-byte what the previous one wrote.\n+/// Linear answers a single read from a replica that can still hold that previous content after\n+/// the reset is confirmed, and a copy reading it finds nothing to change and writes nothing —\n+/// which is how one ordinary pass showed the reset marker with no `onetaskgraph.assets`.\n+fn asset_origins(\n+    journey: &Journey,\n+    title: impl Fn(&str) -> String,\n+) -> Vec<(&'static str, String, String)> {\n+    static INVOCATIONS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);\n+    let invocation = format!(\n+        \"{}-{}-{}\",\n+        std::process::id(),\n+        std::time::SystemTime::now()\n+            .duration_since(std::time::UNIX_EPOCH)\n+            .unwrap()\n+            .as_nanos(),\n+        INVOCATIONS.fetch_add(1, std::sync::atomic::Ordering::Relaxed)\n+    );\n+    let mut origins = Vec::new();\n+    for kind in [\"task\", \"document\"] {\n+        let title = title(kind);\n+        let (id, _) = journey.create_named(kind, 2, &title, false);\n+        let output = journey\n+            .sandbox\n+            .command()\n+            .args([\"--json\", kind, \"show\", &id])\n+            .output()\n+            .unwrap();\n+        let shown: Value = serde_json::from_str(&stdout(&output)).unwrap();\n+        let path = shown[\"items\"][0][\"item\"][\"location\"][\"path\"]\n+            .as_str()\n+            .unwrap();\n+        let text = std::fs::read_to_string(path).unwrap();\n+        let mut text: String = text\n+            .lines()\n+            .filter(|line| !line.starts_with(\"project:\"))\n+            .map(|line| format!(\"{line}\\n\"))\n+            .collect();\n+        text.push_str(&format!(\"\\n{INVOCATION_LINE}{invocation}\\n\"));\n+        std::fs::write(path, text).unwrap();\n+        origins.push((kind, id, title));\n+    }\n+    origins\n+}\n+\n+fn cleanup_asset_items(\n+    runtime: &tokio::runtime::Runtime,\n+    endpoint: &str,\n+    key: &str,\n+    items: &[(&str, String)],\n+) -> bool {\n+    items\n+        .iter()\n+        .map(|(kind, id)| {\n+            let (query, root) = if *kind == \"issue\" {\n+                (onetaskgraph_linear::graphql::ISSUE_DELETE, \"issueDelete\")\n+            } else {\n+                (\n+                    onetaskgraph_linear::graphql::DOCUMENT_DELETE,\n+                    \"documentDelete\",\n+                )\n+            };\n+            // Attempt every removal even when another failed, preserving the observer journal.\n+            runtime\n+                .block_on(document_lifecycle::send(\n+                    endpoint,\n+                    key,\n+                    query,\n+                    json!({\"id\":id}),\n+                ))\n+                .is_ok_and(|response| response[root][\"success\"] == true)\n+        })\n+        .fold(true, |all, removed| all & removed)\n+}\n+\n+fn retire_asset_invocation(\n+    runtime: &tokio::runtime::Runtime,\n+    endpoint: &str,\n+    key: &str,\n+    created: &[(&str, String)],\n+    standing: &document_lifecycle::Standing,\n+    scope: Scope<'_>,\n+) -> bool {\n+    let mut items = created.to_vec();\n+    if !scope.is_ci() {\n+        items.extend(standing.ids.values().cloned().map(|id| (\"document\", id)));\n+    }\n+    cleanup_asset_items(runtime, endpoint, key, &items)\n+}\n+\n+fn reset_asset_slot(\n+    runtime: &tokio::runtime::Runtime,\n+    endpoint: &str,\n+    key: &str,\n+    standing: &document_lifecycle::Standing,\n+    stamp: &str,\n+    reads: u32,\n+) {\n+    if let Some(id) = standing.ids.get(\"assets\") {\n+        let marker = format!(\"Reset for invocation {stamp}\");\n+        let response=runtime.block_on(document_lifecycle::send(endpoint,key,\n+            \"mutation($id:String!,$input:DocumentUpdateInput!){documentUpdate(id:$id,input:$input){success}}\",\n+            json!({\"id\":id,\"input\":{\"content\":marker}}))).unwrap();\n+        assert_eq!(\n+            response[\"documentUpdate\"][\"success\"], true,\n+            \"Linear must acknowledge the run-specific reset\"\n+        );\n+        for attempt in 0..reads {\n+            let held = runtime\n+                .block_on(document_lifecycle::send(\n+                    endpoint,\n+                    key,\n+                    onetaskgraph_linear::graphql::DOCUMENT,\n+                    json!({\"id\":id}),\n+                ))\n+                .unwrap();\n+            if held[\"document\"][\"content\"].as_str() == Some(marker.as_str()) {\n+                return;\n+            }\n+            if attempt + 1 < reads {\n+                std::thread::sleep(Duration::from_secs(1));\n+            }\n+        }\n+        panic!(\"Linear did not retain the run-specific asset reset before copying\");\n+    }\n+}\n+\n+/// The live and replay lanes share the exact copy/read/unchanged-recopy assertions.\n+fn drive_asset_copy_recopy(\n+    journey: &Journey,\n+    origins: &[(&str, String, String)],\n+    mode: Mode,\n+    asset_read: impl Fn(&str, &str),\n+    upload_count: impl Fn() -> usize,\n+) {\n+    for (kind, id, title) in origins {\n+        let kind = *kind;\n+        let run = || {\n+            let mut command = journey.sandbox.command();\n+            command.args([\"--json\", kind, \"copy\", id.as_str(), \"--to\", \"dest\"]);\n+            if kind == \"document\" && mode != Mode::Fresh {\n+                command.args([\"--match-by\", \"title\"]);\n+            }\n+            command.output().unwrap()\n+        };\n+        let show = |id: &str| {\n+            let output = journey\n+                .sandbox\n+                .command()\n+                .args([\"--json\", kind, \"show\", id])\n+                .output()\n+                .unwrap();\n+            assert!(output.status.success(), \"{}\", stderr(&output));\n+            serde_json::from_str::<Value>(&stdout(&output)).unwrap()\n+        };\n+        let origin = show(id);\n+        let invocation = origin[\"items\"][0][\"item\"][\"content\"]\n+            .as_str()\n+            .unwrap()\n+            .lines()\n+            .find(|line| line.starts_with(INVOCATION_LINE))\n+            .expect(\"every origin names its invocation\")\n+            .to_owned();\n+        let output = run();\n+        assert!(output.status.success(), \"{}\", stderr(&output));\n+        let report: Value = serde_json::from_str(&stdout(&output)).unwrap();\n+        let dest = report[\"items\"][0][\"destination\"].as_str().unwrap();\n+        // A single Linear read can still answer from before the copy; read until it reaches it.\n+        let mut shown = show(dest);\n+        for _ in 1..SHOW_READS {\n+            if shown[\"items\"][0][\"item\"][\"content\"]\n+                .as_str()\n+                .is_some_and(|content| content.contains(&invocation))\n+            {\n+                break;\n+            }\n+            std::thread::sleep(Duration::from_secs(1));\n+            shown = show(dest);\n+        }\n+        let item = &shown[\"items\"][0][\"item\"];\n+        assert!(\n+            item[\"content\"]\n+                .as_str()\n+                .is_some_and(|content| content.contains(&invocation)),\n+            \"{kind} copy {} never reached {dest} after {SHOW_READS} reads: {}\",\n+            report[\"items\"][0][\"action\"],\n+            item[\"content\"]\n+        );\n+        assert_eq!(\n+            item[\"title\"],\n+            title.as_str(),\n+            \"the destination retains its recoverable ownership title\"\n+        );\n+        let content = item[\"content\"].as_str().unwrap();\n+        assert!(!content.contains(\"](./\"));\n+        let uploads = item[\"metadata\"][\"onetaskgraph.assets\"].as_object().unwrap();\n+        assert_eq!(uploads.len(), 2);\n+        for (name, upload) in uploads {\n+            let url = upload[\"url\"].as_str().unwrap();\n+            assert!(content.contains(url));\n+            asset_read(name, url);\n+        }\n+        let before = upload_count();\n+        let output = run();\n+        assert!(output.status.success(), \"{}\", stderr(&output));\n+        let after = upload_count();\n+        assert_eq!(after, before, \"unchanged copy sends no fileUpload\");\n+    }\n+}\n+\n #[test]\n fn live_disposable_issue_and_document_assets_copy_and_recopy() {\n     use onetaskgraph_live::{Credential, Exclusivity, Session, missing, required};\n@@ -1141,42 +1541,184 @@ fn live_disposable_issue_and_document_assets_copy_and_recopy() {\n         .as_str()\n         .unwrap()\n         .to_owned();\n+    let mode = Mode::read().unwrap();\n+    let ci = std::env::var(\"GITHUB_ACTIONS\").as_deref() == Ok(\"true\");\n+    let owner_stamp = onetaskgraph_live::artifact::Stamp::new(\n+        onetaskgraph_live::artifact::Run::current(),\n+        onetaskgraph_live::artifact::now_micros(),\n+    )\n+    .to_string();\n+    let team_key = team.to_ascii_uppercase();\n+    let scope = if ci {\n+        Scope::ci(&team_key).unwrap()\n+    } else {\n+        Scope::local(&team_key, &owner_stamp).unwrap()\n+    };\n+    let team_id = response[\"data\"][\"teams\"][\"nodes\"][0][\"id\"]\n+        .as_str()\n+        .unwrap();\n+    let effective_mode = mode;\n+    if !ci && mode == Mode::Initialize {\n+        eprintln!(\n+            \"non-CI creation pass: initialize the invocation-owned asset destination, exercise reuse assertions, and retire it\"\n+        );\n+    }\n+    let journal = document_lifecycle::journal::Journal::new(\"assets\", effective_mode.name())\n+        .durable(\n+            std::env::current_exe()\n+                .unwrap()\n+                .parent()\n+                .unwrap()\n+                .parent()\n+                .unwrap()\n+                .join(\"telemetry/onetaskgraph-linear-e2e/live\")\n+                .join(&owner_stamp),\n+        )\n+        .unwrap();\n+    let lifecycle_endpoint = document_lifecycle::observer::start(\n+        \"https://api.linear.app/graphql\",\n+        &key,\n+        journal.clone(),\n+    );\n+    let created = document_lifecycle::Created::default();\n+    guard_asset_invocation(\n+        &runtime,\n+        &lifecycle_endpoint,\n+        &key,\n+        &team_key,\n+        team_id,\n+        scope,\n+        effective_mode,\n+        &journal,\n+        &created,\n+        |standing| {\n+            if ci && mode == Mode::Initialize {\n+                journal.finish().unwrap();\n+                return;\n+            }\n+            drive_live_assets(\n+                &runtime,\n+                &client,\n+                &key,\n+                &team,\n+                &state_name,\n+                standing,\n+                scope,\n+                mode,\n+                &owner_stamp,\n+                &journal,\n+                &lifecycle_endpoint,\n+                &created,\n+            );\n+        },\n+    );\n+}\n+\n+/// Prepares the lane's standing slot and runs `drive` over it, so that from the first\n+/// create on nothing this invocation owns outlives a panic: one partway through preparing,\n+/// or anywhere in `drive` before its own cleanup ran, retires every slot `created` records\n+/// before the panic leaves the lane. A CI set is standing and is never retired here.\n+#[allow(\n+    clippy::too_many_arguments,\n+    reason = \"prepare_owned's lane identities plus the journal and drive; the offline journey passes each one separately to drive this guard as the live lane does\"\n+)]\n+fn guard_asset_invocation(\n+    runtime: &tokio::runtime::Runtime,\n+    lifecycle_endpoint: &str,\n+    key: &str,\n+    team_key: &str,\n+    team_id: &str,\n+    scope: Scope<'_>,\n+    mode: Mode,\n+    journal: &document_lifecycle::journal::Journal,\n+    created: &document_lifecycle::Created,\n+    drive: impl FnOnce(&document_lifecycle::Standing),\n+) {\n+    let guarded = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n+        let standing = runtime\n+            .block_on(document_lifecycle::prepare_owned(\n+                lifecycle_endpoint,\n+                key,\n+                team_key,\n+                team_id,\n+                scope,\n+                mode,\n+                &[Slot::Assets],\n+                created,\n+            ))\n+            .unwrap_or_else(|error| panic!(\"{error}\"));\n+        // Whatever preparation created was the standing set's cold rebuild; from here on a\n+        // create is this journey's own.\n+        journal.journey(\"live_disposable_issue_and_document_assets_copy_and_recopy\");\n+        drive(&standing);\n+    }));\n+    if let Err(panic) = guarded {\n+        if let Err(error) = runtime.block_on(document_lifecycle::retire(\n+            lifecycle_endpoint,\n+            key,\n+            scope,\n+            created,\n+        )) {\n+            eprintln!(\"{error}\");\n+        }\n+        let _ = journal.finish();\n+        std::panic::resume_unwind(panic);\n+    }\n+}\n+\n+/// Everything the live asset lane does once its standing slot is prepared, ending with the\n+/// invocation cleanup; a panic here unwinds to the caller's guard over `created`.\n+#[allow(\n+    clippy::too_many_arguments,\n+    reason = \"the live lane's locals this body used before it moved under the guard, passed unchanged\"\n+)]\n+fn drive_live_assets(\n+    runtime: &tokio::runtime::Runtime,\n+    client: &reqwest::Client,\n+    key: &str,\n+    team: &str,\n+    state_name: &str,\n+    standing: &document_lifecycle::Standing,\n+    scope: Scope<'_>,\n+    mode: Mode,\n+    owner_stamp: &str,\n+    journal: &document_lifecycle::journal::Journal,\n+    lifecycle_endpoint: &str,\n+    created: &document_lifecycle::Created,\n+) {\n+    let key = key.to_owned();\n+    reset_asset_slot(\n+        runtime,\n+        \"https://api.linear.app/graphql\",\n+        &key,\n+        standing,\n+        owner_stamp,\n+        21,\n+    );\n     let journey = Journey::new();\n     let stamp = std::time::SystemTime::now()\n         .duration_since(std::time::UNIX_EPOCH)\n         .unwrap()\n         .as_micros();\n-    let mut origins = Vec::new();\n-    for kind in [\"task\", \"document\"] {\n-        let title = format!(\n-            \"{}{}\",\n-            onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX,\n-            onetaskgraph_live::artifact::Stamp::new(\n-                onetaskgraph_live::artifact::Run::current(),\n-                stamp as u64\n+    let origins = asset_origins(&journey, |kind| {\n+        if kind == \"document\" && mode != Mode::Fresh {\n+            standing.titles[\"assets\"].clone()\n+        } else {\n+            format!(\n+                \"{}{}\",\n+                onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX,\n+                onetaskgraph_live::artifact::Stamp::new(\n+                    onetaskgraph_live::artifact::Run::current(),\n+                    stamp as u64\n+                )\n             )\n-        );\n-        let (id, _) = journey.create_named(kind, 2, &title, false);\n-        let output = journey\n-            .sandbox\n-            .command()\n-            .args([\"--json\", kind, \"show\", &id])\n-            .output()\n-            .unwrap();\n-        let shown: Value = serde_json::from_str(&stdout(&output)).unwrap();\n-        let path = shown[\"items\"][0][\"item\"][\"location\"][\"path\"]\n-            .as_str()\n-            .unwrap();\n-        let text = std::fs::read_to_string(path).unwrap();\n-        let text: String = text\n-            .lines()\n-            .filter(|line| !line.starts_with(\"project:\"))\n-            .map(|line| format!(\"{line}\\n\"))\n-            .collect();\n-        std::fs::write(path, text).unwrap();\n-        origins.push((kind, id, title));\n-    }\n-    let (endpoint, observed) = live_observer(key.clone());\n+        }\n+    });\n+    let (endpoint, observed) = live_observer(\n+        key.clone(),\n+        journal.clone(),\n+        \"https://api.linear.app/graphql\".into(),\n+    );\n     journey\n         .sandbox\n         .secrets_file(&format!(\"LINEAR_API_KEY={key}\\n\"));\n@@ -1188,39 +1730,11 @@ fn live_disposable_issue_and_document_assets_copy_and_recopy() {\n     // reads the observer's item journal, never the failed journey state; mutex guards are\n     // dropped before assertions, and the runtime/client are only reused for fresh deletes.\n     let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n-        for (kind, id, title) in origins {\n-            let run = || {\n-                journey\n-                    .sandbox\n-                    .command()\n-                    .args([\"--json\", kind, \"copy\", &id, \"--to\", \"dest\"])\n-                    .output()\n-                    .unwrap()\n-            };\n-            let output = run();\n-            assert!(output.status.success(), \"{}\", stderr(&output));\n-            let report: Value = serde_json::from_str(&stdout(&output)).unwrap();\n-            let dest = report[\"items\"][0][\"destination\"].as_str().unwrap();\n-            let output = journey\n-                .sandbox\n-                .command()\n-                .args([\"--json\", kind, \"show\", dest])\n-                .output()\n-                .unwrap();\n-            assert!(output.status.success(), \"{}\", stderr(&output));\n-            let shown: Value = serde_json::from_str(&stdout(&output)).unwrap();\n-            let item = &shown[\"items\"][0][\"item\"];\n-            assert_eq!(\n-                item[\"title\"], title,\n-                \"the destination retains its recoverable ownership title\"\n-            );\n-            let content = item[\"content\"].as_str().unwrap();\n-            assert!(!content.contains(\"](./\"));\n-            let uploads = item[\"metadata\"][\"onetaskgraph.assets\"].as_object().unwrap();\n-            assert_eq!(uploads.len(), 2);\n-            for (name, upload) in uploads {\n-                let url = upload[\"url\"].as_str().unwrap();\n-                assert!(content.contains(url));\n+        drive_asset_copy_recopy(\n+            &journey,\n+            &origins,\n+            mode,\n+            |name, url| {\n                 let parsed = reqwest::Url::parse(url).unwrap();\n                 assert_eq!(parsed.scheme(), \"https\");\n                 assert_eq!(parsed.host_str(), Some(\"uploads.linear.app\"));\n@@ -1238,34 +1752,20 @@ fn live_disposable_issue_and_document_assets_copy_and_recopy() {\n                     response.status()\n                 );\n                 assert!(response.status().is_success());\n-            }\n-            let before = observed.lock().unwrap().signed.len();\n-            let output = run();\n-            assert!(output.status.success(), \"{}\", stderr(&output));\n-            let after = observed.lock().unwrap().signed.len();\n-            assert_eq!(after, before, \"unchanged copy sends no fileUpload\");\n-        }\n+            },\n+            || observed.lock().unwrap().signed.len(),\n+        );\n     }));\n     for observation in &observed.lock().unwrap().observations {\n         eprintln!(\"{observation}\");\n     }\n     let items = observed.lock().unwrap().items.clone();\n-    let mut cleanup_failed = false;\n-    for (kind, id) in items {\n-        let mutation = if kind == \"issue\" {\n-            \"issueDelete\"\n-        } else {\n-            \"documentDelete\"\n-        };\n-        let response: Value = runtime.block_on(async {\n-            client.post(\"https://api.linear.app/graphql\").header(\"Authorization\", &key)\n-                .json(&json!({\"query\":format!(\"mutation($id:String!){{{mutation}(id:$id){{success}}}}\"),\"variables\":{\"id\":id}}))\n-                .send().await.unwrap().json().await.unwrap()\n-        });\n-        let removed = response[\"data\"][mutation][\"success\"] == true;\n-        eprintln!(\"live disposable {kind} {id}: removed={removed}, response={response}\");\n-        cleanup_failed |= !removed;\n-    }\n+    let cleanup_failed =\n+        !retire_asset_invocation(runtime, lifecycle_endpoint, &key, &items, standing, scope);\n+    // That cleanup attempted every slot `created` recorded, so the caller's guard must not\n+    // send their deletes a second time.\n+    created.forget();\n+    journal.finish().unwrap();\n     assert!(!cleanup_failed, \"live disposable cleanup failed\");\n     if let Err(panic) = result {\n         std::panic::resume_unwind(panic);\n@@ -2060,3 +2560,687 @@ fn an_asset_carrying_rendering_records_what_linear_stores_and_an_unstable_backen\n             .rewrite_markdown_on_write(LinearMarkdown::Measured);\n     }\n }\n+\n+#[test]\n+fn document_modes_replay_the_live_binary_asset_entry_over_http() {\n+    use document_lifecycle::journal::Journal;\n+    let journey = Journey::with_clients(0);\n+    let runtime = tokio::runtime::Runtime::new().unwrap();\n+    let endpoint = format!(\"{}/0/graphql\", journey.workspace.endpoint);\n+    let journal = Journal::new(\"assets\", \"initialize\");\n+    journey.workspace.state.lock().unwrap().document_journal = Some(journal.clone());\n+    let scope = Scope::ci(\"ENG\").unwrap();\n+    let slots = &[Slot::Assets];\n+    // A default non-CI invocation refuses before any create and names the explicit mode,\n+    // which initializes its own set, finds it again on recovery and retires it.\n+    let local = Scope::local(\"ENG\", \"123-456-500\").unwrap();\n+    let absent = runtime.block_on(document_lifecycle::prepare(\n+        &endpoint,\n+        \"fixture-key\",\n+        \"ENG\",\n+        \"team\",\n+        local,\n+        Mode::Ordinary,\n+        slots,\n+    ));\n+    assert!(absent.err().unwrap().contains(\"initialize\"));\n+    assert_eq!(journal.count(), 0, \"ordinary absence refuses before create\");\n+    let created = document_lifecycle::Created::default();\n+    let standing = runtime\n+        .block_on(document_lifecycle::prepare_owned(\n+            &endpoint,\n+            \"fixture-key\",\n+            \"ENG\",\n+            \"team\",\n+            local,\n+            Mode::Initialize,\n+            slots,\n+            &created,\n+        ))\n+        .unwrap();\n+    assert_eq!(\n+        journal.count(),\n+        1,\n+        \"one asset slot initialized at the HTTP boundary\"\n+    );\n+    let again = runtime\n+        .block_on(document_lifecycle::prepare(\n+            &endpoint,\n+            \"fixture-key\",\n+            \"ENG\",\n+            \"team\",\n+            local,\n+            Mode::Initialize,\n+            slots,\n+        ))\n+        .unwrap();\n+    assert_eq!(standing.ids, again.ids);\n+    assert_eq!(\n+        journal.count(),\n+        1,\n+        \"recovery discovers the exact initialized slot\"\n+    );\n+    assert_eq!(\n+        runtime\n+            .block_on(document_lifecycle::retire(\n+                &endpoint,\n+                \"fixture-key\",\n+                local,\n+                &created\n+            ))\n+            .unwrap(),\n+        1\n+    );\n+    journal.finish().unwrap();\n+    // The CI set is absent: the first ordinary pass rebuilds its one slot through the lane's\n+    // own guard, files it as a cold rebuild, and runs every reuse assertion over it; the warm\n+    // pass after it creates nothing. Then the daily fresh pass.\n+    for (mode, label, warm) in [\n+        (Mode::Ordinary, \"ordinary\", false),\n+        (Mode::Ordinary, \"ordinary\", true),\n+        (Mode::Fresh, \"fresh\", true),\n+    ] {\n+        if !(mode == Mode::Ordinary && warm) {\n+            journal.begin(label);\n+        }\n+        let before = journal.count();\n+        let rebuilt_before = journal.count_in(document_lifecycle::journal::COLD_REBUILD);\n+        let run = match (mode, warm) {\n+            (Mode::Fresh, _) => 2000,\n+            (_, false) => 1000,\n+            (_, true) => 1001,\n+        };\n+        let mut fresh_title = None;\n+        guard_asset_invocation(\n+            &runtime,\n+            &endpoint,\n+            \"fixture-key\",\n+            \"ENG\",\n+            \"team\",\n+            scope,\n+            mode,\n+            &journal,\n+            &document_lifecycle::Created::default(),\n+            |standing| {\n+                reset_asset_slot(&runtime, &endpoint, \"fixture-key\", standing, label, 21);\n+                let origins = asset_origins(&journey, |kind| {\n+                    if kind == \"document\" && mode == Mode::Ordinary {\n+                        standing.titles[\"assets\"].clone()\n+                    } else {\n+                        format!(\n+                            \"{}123-456-{run}\",\n+                            onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX,\n+                        )\n+                    }\n+                });\n+                drive_asset_copy_recopy(\n+                    &journey,\n+                    &origins,\n+                    mode,\n+                    |name, url| {\n+                        let response = runtime\n+                            .block_on(\n+                                reqwest::Client::new()\n+                                    .get(url)\n+                                    .header(\"Authorization\", \"fixture-key\")\n+                                    .send(),\n+                            )\n+                            .unwrap();\n+                        assert!(response.status().is_success());\n+                        let bytes = runtime.block_on(response.bytes()).unwrap();\n+                        let state = journey.workspace.state.lock().unwrap();\n+                        let upload = state\n+                            .uploads\n+                            .values()\n+                            .find(|u| u.name == name && u.bytes == bytes.as_ref())\n+                            .expect(\"authenticated image read is byte-identical to the upload\");\n+                        assert_eq!(upload.bytes.len(), upload.size);\n+                        assert_eq!(asset_sha256(&upload.bytes), asset_sha256(&bytes));\n+                    },\n+                    || journey.workspace.counts().0,\n+                );\n+                fresh_title = origins\n+                    .iter()\n+                    .find(|(kind, _, _)| *kind == \"document\")\n+                    .map(|origin| origin.2.clone());\n+            },\n+        );\n+        let rebuilt = journal.count_in(document_lifecycle::journal::COLD_REBUILD) - rebuilt_before;\n+        assert_eq!(\n+            rebuilt,\n+            usize::from(!warm),\n+            \"{label}: only the cold ordinary pass rebuilds the missing standing slot\"\n+        );\n+        assert_eq!(\n+            journal.count() - before - rebuilt,\n+            usize::from(mode == Mode::Fresh),\n+            \"{label}: the shared entry path creates the fresh destination once\"\n+        );\n+        // Removal does not erase a creation from its transport journal.\n+        if mode == Mode::Fresh {\n+            let title = fresh_title.unwrap();\n+            let id = journey.workspace.held.document_titled(&title).unwrap();\n+            assert!(cleanup_asset_items(\n+                &runtime,\n+                &endpoint,\n+                \"fixture-key\",\n+                &[(\"document\", id)]\n+            ));\n+            assert!(journey.workspace.held.document_titled(&title).is_none());\n+            assert_eq!(journal.count(), 1);\n+        }\n+        journal.finish().unwrap();\n+    }\n+    journal.begin(\"failure\");\n+    journal.journey(\"failed_asset_copy_cleanup\");\n+    let title = format!(\n+        \"{}123-456-3000\",\n+        onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX\n+    );\n+    let origins = asset_origins(&journey, |kind| format!(\"{title}-{kind}\"));\n+    let failure = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n+        drive_asset_copy_recopy(\n+            &journey,\n+            &origins,\n+            Mode::Fresh,\n+            |_, _| panic!(\"injected assertion failure after creation\"),\n+            || journey.workspace.counts().0,\n+        )\n+    }));\n+    assert!(failure.is_err());\n+    // The first origin is an issue; exercise the document failure path separately.\n+    let document = origins\n+        .iter()\n+        .find(|(kind, _, _)| *kind == \"document\")\n+        .unwrap()\n+        .clone();\n+    let failure = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n+        drive_asset_copy_recopy(\n+            &journey,\n+            std::slice::from_ref(&document),\n+            Mode::Fresh,\n+            |_, _| panic!(\"injected document assertion failure\"),\n+            || journey.workspace.counts().0,\n+        )\n+    }));\n+    assert!(failure.is_err());\n+    let id = journey.workspace.held.document_titled(&document.2).unwrap();\n+    assert_eq!(\n+        journal.count(),\n+        1,\n+        \"failed-run creations remain in the journal\"\n+    );\n+    assert!(cleanup_asset_items(\n+        &runtime,\n+        &endpoint,\n+        \"fixture-key\",\n+        &[(\"document\", id)]\n+    ));\n+    assert!(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(&document.2)\n+            .is_none()\n+    );\n+    assert_eq!(journal.count(), 1);\n+    journal.residue(usize::from(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(&document.2)\n+            .is_some(),\n+    ));\n+    journal.finish().unwrap();\n+}\n+\n+#[test]\n+fn asset_invocation_cleanup_retires_local_slots_and_continues_after_a_refused_delete() {\n+    let journey = Journey::with_clients(0);\n+    let runtime = tokio::runtime::Runtime::new().unwrap();\n+    let endpoint = format!(\"{}/0/graphql\", journey.workspace.endpoint);\n+    let ci_scope = Scope::ci(\"ENG\").unwrap();\n+    let local_scope = Scope::local(\"ENG\", \"1-2-3\").unwrap();\n+    let prepare = |scope| {\n+        runtime\n+            .block_on(document_lifecycle::prepare(\n+                &endpoint,\n+                \"fixture-key\",\n+                \"ENG\",\n+                \"team\",\n+                scope,\n+                Mode::Initialize,\n+                &[Slot::Assets],\n+            ))\n+            .unwrap()\n+    };\n+    let ci = prepare(ci_scope);\n+    let local = prepare(local_scope);\n+    let create = |title: &str| {\n+        runtime.block_on(document_lifecycle::send(&endpoint,\"fixture-key\",onetaskgraph_linear::graphql::DOCUMENT_CREATE,json!({\"input\":{\"title\":title,\"content\":\"synthetic disposable cleanup probe\",\"teamId\":\"team\"}}))).unwrap()[\"documentCreate\"][\"document\"][\"id\"].as_str().unwrap().to_owned()\n+    };\n+    let first_title = format!(\"{}1-2-4\", onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX);\n+    let second_title = format!(\"{}1-2-5\", onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX);\n+    let first = create(&first_title);\n+    let second = create(&second_title);\n+    let unrelated = create(\"Unrelated synthetic document\");\n+    journey\n+        .workspace\n+        .state\n+        .lock()\n+        .unwrap()\n+        .refused_document_deletes\n+        .insert(first.clone());\n+    let created = vec![(\"document\", first.clone()), (\"document\", second.clone())];\n+    assert!(\n+        !retire_asset_invocation(\n+            &runtime,\n+            &endpoint,\n+            \"fixture-key\",\n+            &created,\n+            &local,\n+            local_scope\n+        ),\n+        \"a refused removal reports failure\"\n+    );\n+    let attempted = journey\n+        .workspace\n+        .state\n+        .lock()\n+        .unwrap()\n+        .document_delete_attempts\n+        .clone();\n+    for id in [&first, &second, &local.ids[\"assets\"]] {\n+        assert!(\n+            attempted.contains(id),\n+            \"cleanup attempted every invocation-owned item\"\n+        );\n+    }\n+    assert!(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(&first_title)\n+            .is_some()\n+    );\n+    assert!(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(&second_title)\n+            .is_none()\n+    );\n+    assert!(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(&local.titles[\"assets\"])\n+            .is_none(),\n+        \"local retained destination retires within invocation cleanup\"\n+    );\n+    assert_eq!(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(\"Unrelated synthetic document\"),\n+        Some(unrelated)\n+    );\n+    assert!(retire_asset_invocation(\n+        &runtime,\n+        &endpoint,\n+        \"fixture-key\",\n+        &[],\n+        &ci,\n+        ci_scope\n+    ));\n+    assert_eq!(\n+        journey.workspace.held.document_titled(&ci.titles[\"assets\"]),\n+        Some(ci.ids[\"assets\"].clone()),\n+        \"CI standing slot survives the same cleanup entry\"\n+    );\n+    journey\n+        .workspace\n+        .state\n+        .lock()\n+        .unwrap()\n+        .refused_document_deletes\n+        .clear();\n+    assert!(\n+        cleanup_asset_items(&runtime, &endpoint, \"fixture-key\", &[(\"document\", first)]),\n+        \"retry retires only the refused invocation item\"\n+    );\n+    assert!(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(&first_title)\n+            .is_none()\n+    );\n+    let local = prepare(local_scope);\n+    assert!(retire_asset_invocation(\n+        &runtime,\n+        &endpoint,\n+        \"fixture-key\",\n+        &[],\n+        &local,\n+        local_scope\n+    ));\n+    assert!(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(&local.titles[\"assets\"])\n+            .is_none(),\n+        \"successful normal local cleanup also retires its set\"\n+    );\n+}\n+\n+/// A panic straight after the asset lane's one local slot create, and one later in the\n+/// drive before its own cleanup, each retire the invocation's slot before the panic leaves\n+/// the lane: one documentCreate and one documentDelete of that document at the transport,\n+/// the create still counted, and the standing CI slot and an unrelated document kept.\n+#[test]\n+fn a_panic_after_the_local_asset_slot_create_retires_it_before_the_lane_fails() {\n+    let journey = Journey::with_clients(0);\n+    let runtime = tokio::runtime::Runtime::new().unwrap();\n+    let endpoint = format!(\"{}/0/graphql\", journey.workspace.endpoint);\n+    let journal = document_lifecycle::journal::Journal::new(\"assets\", \"initialize\");\n+    journey.workspace.state.lock().unwrap().document_journal = Some(journal.clone());\n+    let ci = runtime\n+        .block_on(document_lifecycle::prepare(\n+            &endpoint,\n+            \"fixture-key\",\n+            \"ENG\",\n+            \"team\",\n+            Scope::ci(\"ENG\").unwrap(),\n+            Mode::Initialize,\n+            &[Slot::Assets],\n+        ))\n+        .unwrap();\n+    let unrelated = runtime.block_on(document_lifecycle::send(&endpoint,\"fixture-key\",onetaskgraph_linear::graphql::DOCUMENT_CREATE,json!({\"input\":{\"title\":\"Unrelated synthetic document\",\"content\":\"synthetic\",\"teamId\":\"team\"}}))).unwrap()[\"documentCreate\"][\"document\"][\"id\"].as_str().unwrap().to_owned();\n+    for (stamp, created, drive_panics) in [\n+        (\n+            \"1-2-3\",\n+            document_lifecycle::Created::panicking_after(1),\n+            false,\n+        ),\n+        (\"1-2-4\", document_lifecycle::Created::default(), true),\n+    ] {\n+        let scope = Scope::local(\"ENG\", stamp).unwrap();\n+        let title =\n+            onetaskgraph_linear::live_artifact::retained_title(scope, Slot::Assets).unwrap();\n+        let creates = journal.count();\n+        let deletes = journey\n+            .workspace\n+            .state\n+            .lock()\n+            .unwrap()\n+            .document_delete_attempts\n+            .len();\n+        let failed = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n+            guard_asset_invocation(\n+                &runtime,\n+                &endpoint,\n+                \"fixture-key\",\n+                \"ENG\",\n+                \"team\",\n+                scope,\n+                Mode::Initialize,\n+                &journal,\n+                &created,\n+                |standing| {\n+                    assert!(standing.ids.contains_key(\"assets\"));\n+                    assert!(!drive_panics, \"injected failure in the drive\");\n+                },\n+            )\n+        }));\n+        assert!(failed.is_err(), \"{stamp}: the lane still fails\");\n+        assert_eq!(\n+            journal.count() - creates,\n+            1,\n+            \"{stamp}: the create stays counted\"\n+        );\n+        let attempted = journey\n+            .workspace\n+            .state\n+            .lock()\n+            .unwrap()\n+            .document_delete_attempts[deletes..]\n+            .to_vec();\n+        assert_eq!(\n+            attempted.len(),\n+            1,\n+            \"{stamp}: exactly the created slot is retired\"\n+        );\n+        assert!(\n+            journey.workspace.held.document_titled(&title).is_none(),\n+            \"{stamp}: nothing of the invocation's set survives\"\n+        );\n+        assert_eq!(created.len(), 0);\n+    }\n+    assert_eq!(\n+        journey.workspace.held.document_titled(&ci.titles[\"assets\"]),\n+        Some(ci.ids[\"assets\"].clone()),\n+        \"the standing CI slot survives\"\n+    );\n+    assert_eq!(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(\"Unrelated synthetic document\"),\n+        Some(unrelated)\n+    );\n+}\n+\n+#[test]\n+fn asset_reset_must_store_its_current_marker_before_copying_and_recovers() {\n+    let journey = Journey::with_clients(0);\n+    let runtime = tokio::runtime::Runtime::new().unwrap();\n+    let endpoint = format!(\"{}/0/graphql\", journey.workspace.endpoint);\n+    let journal = document_lifecycle::journal::Journal::new(\"assets\", \"initialize\");\n+    journey.workspace.state.lock().unwrap().document_journal = Some(journal.clone());\n+    let standing = runtime\n+        .block_on(document_lifecycle::prepare(\n+            &endpoint,\n+            \"fixture-key\",\n+            \"ENG\",\n+            \"team\",\n+            Scope::ci(\"ENG\").unwrap(),\n+            Mode::Initialize,\n+            &[Slot::Assets],\n+        ))\n+        .unwrap();\n+    journal.begin(\"ordinary\");\n+    journey.workspace.state.lock().unwrap().ignore_asset_reset = true;\n+    let refused = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n+        reset_asset_slot(\n+            &runtime,\n+            &endpoint,\n+            \"fixture-key\",\n+            &standing,\n+            \"current-run\",\n+            1,\n+        )\n+    }));\n+    assert!(\n+        refused.is_err(),\n+        \"an acknowledged reset that stores nothing must refuse\"\n+    );\n+    assert_eq!(\n+        journal.count(),\n+        0,\n+        \"failed reset never bootstraps a replacement\"\n+    );\n+    journey.workspace.state.lock().unwrap().ignore_asset_reset = false;\n+    reset_asset_slot(\n+        &runtime,\n+        &endpoint,\n+        \"fixture-key\",\n+        &standing,\n+        \"recovered-run\",\n+        21,\n+    );\n+    assert_eq!(\n+        journey\n+            .workspace\n+            .held\n+            .long_form(\"documents\", &standing.ids[\"assets\"])\n+            .as_deref(),\n+        Some(\"Reset for invocation recovered-run\")\n+    );\n+    assert_eq!(journal.count(), 0);\n+}\n+\n+/// Two ordinary passes over one standing slot, the second with Linear's single read of the slot\n+/// answering, once, from a replica still holding what the first pass wrote — after the reset\n+/// was read back. The previous pass's content is what this pass would write were the content not\n+/// run-specific, so the copy would find nothing to change and leave the reset marker in place,\n+/// which is the `onetaskgraph.assets` read one live ordinary pass panicked on.\n+#[test]\n+fn an_ordinary_asset_pass_writes_over_a_replica_still_holding_the_previous_pass() {\n+    let journey = Journey::with_clients(0);\n+    let runtime = tokio::runtime::Runtime::new().unwrap();\n+    let endpoint = format!(\"{}/0/graphql\", journey.workspace.endpoint);\n+    let journal = document_lifecycle::journal::Journal::new(\"assets\", \"initialize\");\n+    journey.workspace.state.lock().unwrap().document_journal = Some(journal.clone());\n+    let standing = runtime\n+        .block_on(document_lifecycle::prepare(\n+            &endpoint,\n+            \"fixture-key\",\n+            \"ENG\",\n+            \"team\",\n+            Scope::ci(\"ENG\").unwrap(),\n+            Mode::Initialize,\n+            &[Slot::Assets],\n+        ))\n+        .unwrap();\n+    let slot = standing.ids[\"assets\"].clone();\n+    let read = |_: &str, url: &str| {\n+        let response = runtime\n+            .block_on(\n+                reqwest::Client::new()\n+                    .get(url)\n+                    .header(\"Authorization\", \"fixture-key\")\n+                    .send(),\n+            )\n+            .unwrap();\n+        assert!(response.status().is_success());\n+    };\n+    for pass in [\"previous-pass\", \"lagging-pass\"] {\n+        let previous = journey.workspace.held.long_form(\"documents\", &slot);\n+        reset_asset_slot(&runtime, &endpoint, \"fixture-key\", &standing, pass, 21);\n+        if pass == \"lagging-pass\" {\n+            let previous = previous.unwrap();\n+            assert!(previous.contains(\"onetaskgraph.assets\"), \"{previous}\");\n+            // Armed once the reset has been read back, as the live pass saw it.\n+            journey.workspace.state.lock().unwrap().stale_document =\n+                Some((slot.clone(), previous, 1));\n+        }\n+        let origins = asset_origins(&journey, |kind| {\n+            if kind == \"document\" {\n+                standing.titles[\"assets\"].clone()\n+            } else {\n+                format!(\n+                    \"{}123-456-{pass}\",\n+                    onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX\n+                )\n+            }\n+        });\n+        let document = origins\n+            .iter()\n+            .find(|(kind, _, _)| *kind == \"document\")\n+            .unwrap()\n+            .clone();\n+        assert_eq!(\n+            document.1, \"notes:onetaskgraph-live-cleanup-retained-v1-ci-eng-assets\",\n+            \"{pass}: the origin has the id every live pass's origin has\"\n+        );\n+        drive_asset_copy_recopy(\n+            &journey,\n+            std::slice::from_ref(&document),\n+            Mode::Ordinary,\n+            read,\n+            || journey.workspace.counts().0,\n+        );\n+        // Each live pass copies from a sandbox of its own, so its origin has the same id as the\n+        // previous pass's; retiring this one's file lets the next pass's origin take that id too.\n+        let output = journey\n+            .sandbox\n+            .command()\n+            .args([\"--json\", \"document\", \"show\", &document.1])\n+            .output()\n+            .unwrap();\n+        let shown: Value = serde_json::from_str(&stdout(&output)).unwrap();\n+        std::fs::remove_file(\n+            shown[\"items\"][0][\"item\"][\"location\"][\"path\"]\n+                .as_str()\n+                .unwrap(),\n+        )\n+        .unwrap();\n+    }\n+    assert_eq!(\n+        journey\n+            .workspace\n+            .state\n+            .lock()\n+            .unwrap()\n+            .stale_document\n+            .as_ref()\n+            .map(|held| held.2),\n+        Some(0),\n+        \"the lagging replica answered the copy's read\"\n+    );\n+    assert_eq!(journal.count(), 1, \"the passes reuse the one slot\");\n+}\n+\n+#[test]\n+fn live_asset_forwarding_transport_counts_created_then_deleted_documents() {\n+    let journey = Journey::with_clients(0);\n+    let runtime = tokio::runtime::Runtime::new().unwrap();\n+    let upstream = format!(\"{}/0/graphql\", journey.workspace.endpoint);\n+    // The synthetic upstream checks the wire shape independently of the real observer.\n+    journey.workspace.state.lock().unwrap().document_journal =\n+        Some(document_lifecycle::journal::Journal::new(\"assets\", \"fresh\"));\n+    let journal = document_lifecycle::journal::Journal::new(\"assets\", \"fresh\");\n+    journal.journey(\"live-asset-forwarding-transport\");\n+    let (endpoint, observed) = live_observer(\"fixture-key\".into(), journal.clone(), upstream);\n+    let created=runtime.block_on(document_lifecycle::send(&endpoint,\"fixture-key\",onetaskgraph_linear::graphql::DOCUMENT_CREATE,json!({\"input\":{\"title\":\"Synthetic forwarded document\",\"content\":\"Synthetic body\",\"teamId\":\"team\"}}))).unwrap();\n+    let id = created[\"documentCreate\"][\"document\"][\"id\"]\n+        .as_str()\n+        .unwrap();\n+    assert_eq!(\n+        journal.count(),\n+        1,\n+        \"the live forwarding path observes the actual create acknowledgement\"\n+    );\n+    assert_eq!(\n+        observed.lock().unwrap().items,\n+        vec![(\"document\", id.to_owned())]\n+    );\n+    assert!(cleanup_asset_items(\n+        &runtime,\n+        &endpoint,\n+        \"fixture-key\",\n+        &[(\"document\", id.to_owned())]\n+    ));\n+    assert!(\n+        journey\n+            .workspace\n+            .held\n+            .document_titled(\"Synthetic forwarded document\")\n+            .is_none()\n+    );\n+    assert_eq!(\n+        journal.count(),\n+        1,\n+        \"deletion never erases a forwarded create\"\n+    );\n+    let directory = journey.sandbox.subdirectory(\"forwarded-journal\");\n+    journal.finish_in(&directory).unwrap();\n+    let recorded: Value = serde_json::from_slice(\n+        &std::fs::read(directory.join(\"linear-live-documents-fresh.json\")).unwrap(),\n+    )\n+    .unwrap();\n+    assert_eq!(recorded[\"operations\"].as_array().unwrap().len(), 1);\n+    assert_eq!(recorded[\"completed\"], true);\n+}"},{"sha":"bb0f8579612ce547f92af46d9c2cd9be156c421a","filename":"crates/onetaskgraph-linear-e2e/tests/e2e/main.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Fmain.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Fmain.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Fmain.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -20,6 +20,7 @@ mod cache_documents;\n mod cache_parts;\n mod copy_skip;\n mod health;\n+mod human_items;\n mod linear;\n mod linear_assets;\n mod linear_boundary;"},{"sha":"38378c32840554aef6988d0c11f57bd72666b2cd","filename":"crates/onetaskgraph-linear-e2e/tests/e2e/telemetry.rs","status":"modified","additions":91,"deletions":0,"changes":91,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Ftelemetry.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Ftelemetry.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear-e2e%2Ftests%2Fe2e%2Ftelemetry.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,5 +1,7 @@\n //! Where the Linear request budgets' telemetry lives: one JSON file per budget,\n //! `{\"value\": <requests>, \"detail\": \"<how they were counted>\"}`, named after the budget's id.\n+//! Document creation budgets instead aggregate the two lanes' versioned transport journals;\n+//! they require completed recordings of ordinary, fresh, initialization and failure journeys.\n //!\n //! The `measure_*` journeys write it with [`record`] while the `e2e` target runs, and\n //! `budget_runner::report` reads it back with [`recorded`] for `onebudgetspec check`. The\n@@ -10,6 +12,7 @@\n //! recorded. [`DIRECTORY`] names another, so a test can drive the runner over telemetry of its\n //! own without touching what the journeys recorded.\n \n+use crate::linear_assets::document_lifecycle::journal::COLD_REBUILD;\n use serde_json::{Value, json};\n use std::path::{Path, PathBuf};\n \n@@ -84,6 +87,13 @@ pub fn recorded(budget: &str) -> Result<(f64, Option<String>), String> {\n             onebudgetspec_core::model::ID_PATTERN\n         ));\n     }\n+    if matches!(\n+        budget,\n+        \"linear-live-documents-created-per-ordinary-pass\"\n+            | \"linear-live-documents-created-per-daily-pass\"\n+    ) {\n+        return live_documents_recorded(budget);\n+    }\n     let path = file_in(&directory(), budget);\n     let text = std::fs::read_to_string(&path).map_err(|error| {\n         format!(\n@@ -240,3 +250,84 @@ pub fn recorded(budget: &str) -> Result<(f64, Option<String>), String> {\n     };\n     Ok((value, detail))\n }\n+\n+/// Read both transport journals, without executing either producer. Every mode must have\n+/// finished recording: a missing failed-pass journal is not evidence that it created nothing.\n+fn live_documents_recorded(budget: &str) -> Result<(f64, Option<String>), String> {\n+    let selected = if budget.ends_with(\"ordinary-pass\") {\n+        \"ordinary\"\n+    } else {\n+        \"fresh\"\n+    };\n+    let assets = directory();\n+    let plugin = std::env::var_os(\"LINEAR_PLUGIN_TELEMETRY_DIR\")\n+        .map(PathBuf::from)\n+        .unwrap_or_else(|| assets.with_file_name(\"onetaskgraph-linear\"));\n+    let mut total = 0_u64;\n+    let mut details = Vec::new();\n+    for (lane, directory) in [(\"plugin\", plugin), (\"assets\", assets)] {\n+        for mode in [\"ordinary\", \"fresh\", \"initialize\", \"failure\"] {\n+            let path = directory.join(format!(\"linear-live-documents-{mode}.json\"));\n+            let text = std::fs::read_to_string(&path).map_err(|error| {\n+                format!(\n+                    \"{budget}: missing {lane}/{mode} journal at {}: {error}\",\n+                    path.display()\n+                )\n+            })?;\n+            let journal: Value = serde_json::from_str(&text)\n+                .map_err(|error| format!(\"{budget}: invalid {lane}/{mode} journal: {error}\"))?;\n+            if journal[\"schema_version\"] != 1\n+                || journal[\"lane\"] != lane\n+                || journal[\"mode\"] != mode\n+                || journal[\"completed\"] != true\n+            {\n+                return Err(format!(\n+                    \"{budget}: incomplete or mismatched {lane}/{mode} journal\"\n+                ));\n+            }\n+            let operations = journal[\"operations\"]\n+                .as_array()\n+                .ok_or_else(|| format!(\"{budget}: {lane}/{mode} journal has no operations\"))?;\n+            let mut journeys = std::collections::BTreeMap::<&str, u64>::new();\n+            let mut rebuilt = 0_u64;\n+            for operation in operations {\n+                let journey = operation[\"journey\"]\n+                    .as_str()\n+                    .filter(|name| !name.is_empty())\n+                    .ok_or_else(|| format!(\"{budget}: {lane}/{mode} operation has no journey\"))?;\n+                if operation[\"operation\"] != \"documentCreate\" || operation[\"success\"] != true {\n+                    return Err(format!(\n+                        \"{budget}: {lane}/{mode} journal contains an unacknowledged create\"\n+                    ));\n+                }\n+                if journey == COLD_REBUILD {\n+                    rebuilt += 1;\n+                } else {\n+                    *journeys.entry(journey).or_default() += 1;\n+                }\n+            }\n+            let count =\n+                u64::try_from(operations.len()).map_err(|error| error.to_string())? - rebuilt;\n+            if mode == selected {\n+                total = total.checked_add(count).ok_or(\"document count overflow\")?;\n+            }\n+            details.push(format!(\n+                \"{lane}/{mode}: {count} successful documentCreate operations ({journeys:?})\"\n+            ));\n+            // A standing slot the pass had to create is a cold rebuild: reported, never\n+            // counted in the pass and never read as zero-cost reuse.\n+            if rebuilt > 0 {\n+                details.push(format!(\n+                    \"{lane}/{mode} cold rebuild: {rebuilt} documents, outside the pass total\"\n+                ));\n+            }\n+            if let Some(residue) = journal.get(\"residue\") {\n+                let residue = residue.as_u64().ok_or_else(|| {\n+                    format!(\"{budget}: {lane}/{mode} residue is not a document count\")\n+                })?;\n+                details.push(format!(\"{lane}/{mode} residue: {residue} documents\"));\n+            }\n+        }\n+    }\n+    Ok((total as f64, Some(details.join(\"; \"))))\n+}"},{"sha":"80728ad0314673486e74d6e7c4cbcafa9ca08c5a","filename":"crates/onetaskgraph-linear/CHANGELOG.md","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2FCHANGELOG.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2FCHANGELOG.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2FCHANGELOG.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.12.13](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-linear-v0.12.12...onetaskgraph-linear-v0.12.13) - 2026-10-30\n+\n+### Added\n+\n+- project human tasks through existing tracker routing ([#3824](https://github.com/nickderobertis/onetaskgraph/pull/3824))\n+\n ## [0.12.10](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-linear-v0.12.9...onetaskgraph-linear-v0.12.10) - 2026-10-29\n \n ### Fixed"},{"sha":"0f108a4b67d072cc529fd010202fccca1334b5bb","filename":"crates/onetaskgraph-linear/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2FCargo.toml","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2FCargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2FCargo.toml?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -1,7 +1,7 @@\n [package]\n name = \"onetaskgraph-linear\"\n description = \"A onetaskgraph source over the Linear API.\"\n-version = \"0.12.12\"\n+version = \"0.12.13\"\n edition.workspace = true\n rust-version.workspace = true\n license.workspace = true"},{"sha":"80d1fabdd4d8b01506042b08d97081d6a954e5bc","filename":"crates/onetaskgraph-linear/project.json","status":"modified","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Fproject.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Fproject.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Fproject.json?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -53,10 +53,13 @@\n         \"parallel\": false\n       },\n       \"parallelism\": false,\n+      \"outputs\": [\"{workspaceRoot}/target/debug/telemetry/onetaskgraph-linear\"],\n       \"//\": \"The live journey is one of the tests the first command runs; the second drives it through skipped, declined and expected-but-absent without a credential. Serial: it re-runs the binary the first builds. `parallelism: false` runs this target alone: onetaskgraph-linear-e2e's asset journey takes the same one-at-a-time Linear seat, and with both selected in one `just check` the second to start was declined, failing the required check; scripts/check-live-seat-serialised.sh proves against real Nx that no two seat-holding targets overlap. The env inputs are the cache key's, because this target's result is not a function of the files \\u2014 a replay of an uncredentialed run would otherwise stand in for a credentialed one and the live tests would not run while the target reported green. `coverage` takes none of them: scripts/rust-coverage.sh clears the credentials first, which is what keeps one run to one live session.\",\n       \"inputs\": [\n         \"default\",\n         \"^default\",\n+        { \"env\": \"ONETASKGRAPH_LINEAR_DOCUMENT_MODE\" },\n+        { \"env\": \"GITHUB_ACTIONS\" },\n         \"{workspaceRoot}/scripts/check-live-decline.sh\",\n         {\n           \"env\": \"LINEAR_API_KEY\"\n@@ -69,6 +72,15 @@\n         }\n       ]\n     },\n+    \"live-documents\": {\n+      \"executor\": \"nx:run-commands\",\n+      \"cache\": false,\n+      \"parallelism\": false,\n+      \"options\": {\n+        \"command\": \"cargo test --locked -p onetaskgraph-linear --test live -- real_linear_applies_every_declared_capability_and_leaves_no_residue --exact --nocapture\"\n+      },\n+      \"//\": \"Explicit daily creation and initialization only: this target is outside the affected check fan-out and must reach the service on every invocation.\"\n+    },\n     \"coverage\": {\n       \"executor\": \"nx:run-commands\",\n       \"dependsOn\": [\"workspace:coverage-clear\"],"},{"sha":"82850d987f29f41ba24f0928c9b65bf53fc9aadf","filename":"crates/onetaskgraph-linear/src/lib.rs","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Fsrc%2Flib.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Fsrc%2Flib.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Fsrc%2Flib.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -510,6 +510,9 @@ pub mod change_token;\n /// Ownership prefix for Linear live-test artifacts and scheduled orphan recovery.\n pub const LIVE_ARTIFACT_TITLE_PREFIX: &str = \"onetaskgraph live cleanup \";\n \n+/// Exact ownership grammar shared by live lanes and their cleanup.\n+pub mod live_artifact;\n+\n mod origins;\n \n /// The plugin kind a `linear` source's `plugin:` field names."},{"sha":"7abdc89d752d6a2d90c4997772c023f2a4541657","filename":"crates/onetaskgraph-linear/src/live_artifact.rs","status":"added","additions":136,"deletions":0,"changes":136,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Fsrc%2Flive_artifact.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Fsrc%2Flive_artifact.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Fsrc%2Flive_artifact.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,136 @@\n+//! Retained live-test identities. Recognition establishes ownership syntax only; callers\n+//! must independently verify the nominated team before mutating a discovered item.\n+use crate::LIVE_ARTIFACT_TITLE_PREFIX;\n+\n+/// Four document slots and the project that holds filed documents.\n+#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n+pub enum Slot {\n+    /// Project-filed document probe.\n+    Filed,\n+    /// Team-owned document without a project.\n+    Loose,\n+    /// Metadata and follow-up update probe.\n+    FollowUp,\n+    /// Binary copy and recopy destination.\n+    Assets,\n+    /// Retained project, separate from the four document slots.\n+    Parent,\n+}\n+impl Slot {\n+    fn name(self) -> &'static str {\n+        match self {\n+            Self::Filed => \"filed\",\n+            Self::Loose => \"loose\",\n+            Self::FollowUp => \"follow-up\",\n+            Self::Assets => \"assets\",\n+            Self::Parent => \"parent\",\n+        }\n+    }\n+    fn read(value: &str) -> Option<Self> {\n+        match value {\n+            \"filed\" => Some(Self::Filed),\n+            \"loose\" => Some(Self::Loose),\n+            \"follow-up\" => Some(Self::FollowUp),\n+            \"assets\" => Some(Self::Assets),\n+            \"parent\" => Some(Self::Parent),\n+            _ => None,\n+        }\n+    }\n+}\n+\n+/// CI identities are stable; local identities belong to one registered invocation.\n+#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n+pub struct Scope<'a> {\n+    team: &'a str,\n+    stamp: Option<&'a str>,\n+}\n+impl<'a> Scope<'a> {\n+    /// Validate the canonical team key of the standing CI set.\n+    pub fn ci(team: &'a str) -> Result<Self, String> {\n+        if !team_valid(team) {\n+            return Err(\"invalid retained Linear team identity\".into());\n+        }\n+        Ok(Self { team, stamp: None })\n+    }\n+\n+    /// Validate the team key and a canonical, positively vouched local ownership stamp.\n+    pub fn local(team: &'a str, stamp: &'a str) -> Result<Self, String> {\n+        let scope = Self::ci(team)?;\n+        if !stamp_valid(stamp) {\n+            return Err(\"invalid retained Linear local ownership stamp\".into());\n+        }\n+        Ok(Self {\n+            stamp: Some(stamp),\n+            ..scope\n+        })\n+    }\n+\n+    /// The validated canonical nominated team key.\n+    #[must_use]\n+    pub fn team(self) -> &'a str {\n+        self.team\n+    }\n+\n+    /// The validated invocation stamp, absent for the standing CI set.\n+    #[must_use]\n+    pub fn local_stamp(self) -> Option<&'a str> {\n+        self.stamp\n+    }\n+\n+    /// Whether this is the standing CI set.\n+    #[must_use]\n+    pub fn is_ci(self) -> bool {\n+        self.stamp.is_none()\n+    }\n+}\n+\n+/// Exact recognized identity; this alone does not verify remote team membership.\n+#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n+pub struct Retained<'a> {\n+    /// Who owns this standing set.\n+    pub scope: Scope<'a>,\n+    /// Which probe or parent this object represents.\n+    pub slot: Slot,\n+}\n+\n+fn team_valid(team: &str) -> bool {\n+    !team.is_empty()\n+        && team\n+            .bytes()\n+            .all(|c| c.is_ascii_uppercase() || c.is_ascii_digit() || c == b'_' || c == b'-')\n+}\n+fn stamp_valid(stamp: &str) -> bool {\n+    let parts: Vec<_> = stamp.split('-').collect();\n+    parts.len() == 3\n+        && parts.iter().all(|part| {\n+            !part.starts_with('0')\n+                && part.bytes().all(|c| c.is_ascii_digit())\n+                && part.parse::<u64>().is_ok_and(|value| value > 0)\n+        })\n+        && parts[..2].iter().all(|part| part.parse::<u32>().is_ok())\n+}\n+\n+/// Format an identity whose team and stamp were validated at scope construction.\n+pub fn retained_title(scope: Scope<'_>, slot: Slot) -> Result<String, String> {\n+    let suffix = match scope.local_stamp() {\n+        None => format!(\"ci {} {}\", scope.team(), slot.name()),\n+        Some(stamp) => format!(\"local {} {} {stamp}\", scope.team(), slot.name()),\n+    };\n+    Ok(format!(\"{LIVE_ARTIFACT_TITLE_PREFIX}retained-v1 {suffix}\"))\n+}\n+\n+/// Recognize only exact identities. Unknown versions, extra tokens and malformed markers\n+/// confer no authority, including authority to clean up an item.\n+#[must_use]\n+pub fn classify_retained(title: &str) -> Option<Retained<'_>> {\n+    let suffix = title\n+        .strip_prefix(LIVE_ARTIFACT_TITLE_PREFIX)?\n+        .strip_prefix(\"retained-v1 \")?;\n+    let parts: Vec<_> = suffix.split(' ').collect();\n+    let (scope, slot) = match parts.as_slice() {\n+        [\"ci\", team, slot] => (Scope::ci(team).ok()?, Slot::read(slot)?),\n+        [\"local\", team, slot, stamp] => (Scope::local(team, stamp).ok()?, Slot::read(slot)?),\n+        _ => return None,\n+    };\n+    Some(Retained { scope, slot })\n+}"},{"sha":"270afb2754418a9af2be98d13c272cd7f10b09f9","filename":"crates/onetaskgraph-linear/tests/cleanup/mod.rs","status":"modified","additions":20,"deletions":1,"changes":21,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fcleanup%2Fmod.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fcleanup%2Fmod.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fcleanup%2Fmod.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -234,13 +234,32 @@ async fn find_artifacts(\n         found.extend(\n             listed\n                 .into_iter()\n-                .filter(|(_, name)| matches(residue.prefix, name))\n+                .filter(|(_, name)| cleanup_matches(residue.prefix, name, matches))\n                 .map(|(id, name)| (residue, id, name)),\n         );\n     }\n     Ok(found)\n }\n \n+/// Retained CI objects are never run residue. Local sets use the same positive\n+/// registration evidence as disposable artifacts, after extracting their exact stamp.\n+fn cleanup_matches(prefix: &str, name: &str, matches: &dyn Fn(&str, &str) -> bool) -> bool {\n+    use onetaskgraph_linear::live_artifact::classify_retained;\n+    if let Some(retained) = classify_retained(name) {\n+        return retained\n+            .scope\n+            .local_stamp()\n+            .is_some_and(|stamp| matches(prefix, &format!(\"{prefix}{stamp}\")));\n+    }\n+    if name\n+        .strip_prefix(ARTIFACT_PREFIX)\n+        .is_some_and(|suffix| suffix.starts_with(\"retained-\"))\n+    {\n+        return false;\n+    }\n+    matches(prefix, name)\n+}\n+\n /// Deletes every issue, project, document and label whose name `matches`.\n ///\n /// Called twice, over two different `matches`: once after the journey over this run's own"},{"sha":"f0d6e8e847412fe70efa88d850ff95424fb4a5a4","filename":"crates/onetaskgraph-linear/tests/document_lifecycle/complexity.rs","status":"added","additions":150,"deletions":0,"changes":150,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fcomplexity.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fcomplexity.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fcomplexity.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,150 @@\n+//! Linear's complexity score of a query document, which it refuses over [`CAP`] with HTTP 400\n+//! before reading a row and which no schema shows, so a replay must refuse it too.\n+//!\n+//! The model is the one `onetaskgraph_linear::graphql::RESOLUTION` documents — a property 0.1,\n+//! an object 1, a connection's children times its `first` (or `last`, else 50) — and Linear's\n+//! own scores run [`LINEAR_ABOVE_MODEL`] above it, which the first test reconciles.\n+use graphql_parser::query as q;\n+use serde_json::Value;\n+\n+// llmlint: ignore-block[contracts_have_one_source_or_a_drift_gate] Linear scores a document only at its own runtime and publishes no scoring artifact or versioned rule to generate from; the model, the cap and the offset are reconciled below against the two scores Linear itself reported (recorded in `onetaskgraph_linear`'s `MAX_PAGE_SIZE` and `graphql::RESOLUTION` documentation), and re-taking them needs the credential the live lane holds, which is the upstream gate: it sends these discovery documents to real Linear.\n+/// Linear's per-document complexity cap.\n+pub const CAP: f64 = 10_000.0;\n+\n+/// How far Linear's reported score ran above [`score`] on both documents it has scored here.\n+pub const LINEAR_ABOVE_MODEL: f64 = 225.0;\n+\n+/// What Linear's model scores `query` at under `variables`, or why it cannot be scored.\n+pub fn score(query: &str, variables: &Value) -> Result<f64, String> {\n+    let document = q::parse_query::<String>(query).map_err(|e| e.to_string())?;\n+    let mut total = 0.0;\n+    for definition in &document.definitions {\n+        let q::Definition::Operation(operation) = definition else {\n+            return Err(\"complexity is scored without fragments\".into());\n+        };\n+        let selection = match operation {\n+            q::OperationDefinition::Query(v) => &v.selection_set,\n+            q::OperationDefinition::Mutation(v) => &v.selection_set,\n+            q::OperationDefinition::SelectionSet(v) => v,\n+            q::OperationDefinition::Subscription(v) => &v.selection_set,\n+        };\n+        total += selected(selection, variables)?;\n+    }\n+    Ok(total)\n+}\n+\n+/// The refusal Linear answers a document over [`CAP`] with, or `None` when it is under it.\n+pub fn refusal(query: &str, variables: &Value) -> Option<String> {\n+    match score(query, variables) {\n+        Ok(points) if points + LINEAR_ABOVE_MODEL <= CAP => None,\n+        Ok(points) => Some(format!(\n+            \"The query is too complex. (scored {:.1} against {CAP})\",\n+            points + LINEAR_ABOVE_MODEL\n+        )),\n+        Err(error) => Some(format!(\"complexity could not be scored: {error}\")),\n+    }\n+}\n+\n+fn selected(selection: &q::SelectionSet<'_, String>, variables: &Value) -> Result<f64, String> {\n+    let mut total = 0.0;\n+    for item in &selection.items {\n+        let q::Selection::Field(field) = item else {\n+            return Err(\"complexity is scored without fragments\".into());\n+        };\n+        total += if field.selection_set.items.is_empty() {\n+            0.1\n+        } else if let Some(rows) = page(field, variables)? {\n+            rows * selected(&field.selection_set, variables)?\n+        } else {\n+            1.0 + selected(&field.selection_set, variables)?\n+        };\n+    }\n+    Ok(total)\n+}\n+\n+/// The rows a connection field asks for, or `None` when the field is a plain object.\n+fn page(field: &q::Field<'_, String>, variables: &Value) -> Result<Option<f64>, String> {\n+    let named = field\n+        .arguments\n+        .iter()\n+        .find(|(name, _)| name == \"first\" || name == \"last\");\n+    if let Some((name, value)) = named {\n+        let given = match value {\n+            q::Value::Int(rows) => Some(json_rows(rows.as_i64())),\n+            // A variable left unset, or set null, is Linear's default page.\n+            q::Value::Variable(variable) => match variables.get(variable) {\n+                None | Some(Value::Null) => None,\n+                Some(rows) => Some(json_rows(rows.as_i64())),\n+            },\n+            _ => Some(None),\n+        };\n+        return match given {\n+            None => Ok(Some(50.0)),\n+            Some(Some(rows)) => Ok(Some(rows)),\n+            Some(None) => Err(format!(\n+                \"{}({name}) is not a non-negative integer\",\n+                field.name\n+            )),\n+        };\n+    }\n+    let connection = field.selection_set.items.iter().any(|item| {\n+        matches!(item, q::Selection::Field(child) if child.name == \"nodes\" || child.name == \"edges\")\n+    });\n+    Ok(connection.then_some(50.0))\n+}\n+\n+fn json_rows(rows: Option<i64>) -> Option<f64> {\n+    rows.filter(|rows| *rows >= 0).map(|rows| rows as f64)\n+}\n+// llmlint: ignore-end[contracts_have_one_source_or_a_drift_gate]\n+\n+#[test]\n+fn the_model_reconciles_with_the_scores_linear_reported() {\n+    use onetaskgraph_linear::graphql;\n+    let key = serde_json::json!({\"key\":\"T\"});\n+    // `RESOLUTION`'s documentation prices it 1827.2, plus 1.1 for `organization{id}`.\n+    let resolution = score(graphql::RESOLUTION, &key).unwrap();\n+    assert!((resolution - 1828.3).abs() < 0.01, \"{resolution}\");\n+    // Linear scored `RESOLUTION` 30905 and refused it while it had `teams` at its default page\n+    // and no `organization{id}`, and `PROJECTS` at `first: 250` 17475.\n+    let refused = graphql::RESOLUTION\n+        .replace(\"teams(first:2,\", \"teams(\")\n+        .replace(\" organization{id}\", \"\");\n+    let projects = score(graphql::PROJECTS, &serde_json::json!({\"first\":250})).unwrap();\n+    for (points, reported) in [\n+        (score(&refused, &key).unwrap(), 30905.0),\n+        (projects, 17475.0),\n+    ] {\n+        assert!(\n+            (points + LINEAR_ABOVE_MODEL - reported).abs() < 0.01,\n+            \"{points}\"\n+        );\n+    }\n+    assert!(refusal(&refused, &key).is_some());\n+}\n+\n+#[test]\n+fn a_nested_hundred_row_page_inside_a_hundred_row_page_is_refused() {\n+    let nested = \"query($after:String){documents(first:100,after:$after){nodes{id project{teams(first:100){nodes{key} pageInfo{hasNextPage}}}} pageInfo{hasNextPage endCursor}}}\";\n+    let refused = refusal(nested, &serde_json::json!({\"after\":null})).unwrap();\n+    assert!(refused.contains(\"too complex\"), \"{refused}\");\n+    let bounded = nested.replace(\"teams(first:100)\", \"teams(first:2)\");\n+    assert_eq!(refusal(&bounded, &serde_json::json!({\"after\":null})), None);\n+}\n+\n+#[test]\n+fn a_page_size_that_is_not_a_non_negative_integer_is_refused() {\n+    let query = \"query($first:Int){teams(first:$first){nodes{id}}}\";\n+    for bad in [\n+        serde_json::json!({\"first\":\"100\"}),\n+        serde_json::json!({\"first\":-1}),\n+        serde_json::json!({\"first\":true}),\n+    ] {\n+        assert!(score(query, &bad).is_err(), \"{bad}\");\n+    }\n+    assert_eq!(\n+        score(query, &serde_json::json!({})).unwrap(),\n+        score(query, &serde_json::json!({\"first\":50})).unwrap()\n+    );\n+    assert!(score(\"query{teams(first:-1){nodes{id}}}\", &Value::Null).is_err());\n+}"},{"sha":"56bd32c4b63372e9f7263c5ec5a358d62696c06b","filename":"crates/onetaskgraph-linear/tests/document_lifecycle/journal.rs","status":"added","additions":137,"deletions":0,"changes":137,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fjournal.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fjournal.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fjournal.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,137 @@\n+//! Transport-only creation accounting, shared by both live entry paths.\n+use serde_json::{Value, json};\n+use std::sync::{Arc, Mutex};\n+/// The journey every create made while a lane prepares its standing set is filed under:\n+/// in an ordinary journal it is a cold rebuild, reported beside that pass and never in it.\n+pub const COLD_REBUILD: &str = \"cold-rebuild\";\n+#[derive(Clone)]\n+pub struct Journal {\n+    lane: &'static str,\n+    directory: Option<std::path::PathBuf>,\n+    residue: Arc<Mutex<Option<usize>>>,\n+    mode: Arc<Mutex<&'static str>>,\n+    operations: Arc<Mutex<Vec<Value>>>,\n+    journey: Arc<Mutex<&'static str>>,\n+}\n+impl Journal {\n+    pub fn new(lane: &'static str, mode: &'static str) -> Self {\n+        Self {\n+            lane,\n+            directory: None,\n+            residue: Arc::default(),\n+            mode: Arc::new(Mutex::new(mode)),\n+            operations: Arc::default(),\n+            journey: Arc::new(Mutex::new(COLD_REBUILD)),\n+        }\n+    }\n+    pub fn durable(mut self, directory: std::path::PathBuf) -> Result<Self, String> {\n+        self.directory = Some(directory);\n+        self.write_in(self.directory.as_ref().unwrap(), false)?;\n+        Ok(self)\n+    }\n+    pub fn observe(&self, request: &Value, response: &Value) {\n+        use graphql_parser::query::{Definition, OperationDefinition, Selection, parse_query};\n+        let Some(query) = request[\"query\"].as_str() else {\n+            return;\n+        };\n+        let Ok(query) = parse_query::<String>(query) else {\n+            return;\n+        };\n+        let mut created = 0;\n+        for definition in &query.definitions {\n+            let Definition::Operation(OperationDefinition::Mutation(mutation)) = definition else {\n+                continue;\n+            };\n+            for selection in &mutation.selection_set.items {\n+                let Selection::Field(field) = selection else {\n+                    continue;\n+                };\n+                let response_key = field.alias.as_ref().unwrap_or(&field.name);\n+                if field.name == \"documentCreate\"\n+                    && response[\"data\"][response_key][\"success\"] == true\n+                {\n+                    created += 1;\n+                }\n+            }\n+        }\n+        if created == 0 {\n+            return;\n+        }\n+        {\n+            let mut operations = self.operations.lock().unwrap();\n+            for _ in 0..created {\n+                operations.push(json!({\"journey\":*self.journey.lock().unwrap(),\"operation\":\"documentCreate\",\"success\":true}));\n+            }\n+        }\n+        if let Some(directory) = &self.directory {\n+            self.write_in(directory, false)\n+                .expect(\"persist successful create before proceeding\");\n+        }\n+    }\n+    pub fn residue(&self, documents: usize) {\n+        *self.residue.lock().unwrap() = Some(documents);\n+    }\n+    pub fn journey(&self, journey: &'static str) {\n+        *self.journey.lock().unwrap() = journey;\n+    }\n+    pub fn begin(&self, mode: &'static str) {\n+        *self.mode.lock().unwrap() = mode;\n+        self.operations.lock().unwrap().clear();\n+        *self.journey.lock().unwrap() = COLD_REBUILD;\n+        *self.residue.lock().unwrap() = None;\n+    }\n+    pub fn count(&self) -> usize {\n+        self.operations.lock().unwrap().len()\n+    }\n+    /// The successful creates filed under one journey.\n+    pub fn count_in(&self, journey: &str) -> usize {\n+        self.operations\n+            .lock()\n+            .unwrap()\n+            .iter()\n+            .filter(|operation| operation[\"journey\"] == journey)\n+            .count()\n+    }\n+    pub fn finish(&self) -> Result<(), String> {\n+        if let Some(directory) = &self.directory {\n+            return self.finish_in(directory);\n+        }\n+\n+        let variable = if self.lane == \"plugin\" {\n+            \"LINEAR_PLUGIN_TELEMETRY_DIR\"\n+        } else {\n+            \"LINEAR_BUDGET_TELEMETRY_DIR\"\n+        };\n+        let directory = std::env::var_os(variable)\n+            .map(std::path::PathBuf::from)\n+            .unwrap_or_else(|| {\n+                let exe = std::env::current_exe().expect(\"test executable\");\n+                exe.parent()\n+                    .expect(\"deps\")\n+                    .parent()\n+                    .expect(\"profile\")\n+                    .join(\"telemetry\")\n+                    .join(if self.lane == \"plugin\" {\n+                        \"onetaskgraph-linear\"\n+                    } else {\n+                        \"onetaskgraph-linear-e2e\"\n+                    })\n+            });\n+        self.finish_in(&directory)\n+    }\n+    pub fn finish_in(&self, directory: &std::path::Path) -> Result<(), String> {\n+        self.write_in(directory, true)\n+    }\n+    fn write_in(&self, directory: &std::path::Path, completed: bool) -> Result<(), String> {\n+        std::fs::create_dir_all(directory).map_err(|e| e.to_string())?;\n+        let mode = *self.mode.lock().unwrap();\n+        let path = directory.join(format!(\"linear-live-documents-{mode}.json\"));\n+        let pending = path.with_extension(\"pending\");\n+        let mut body = json!({\"schema_version\":1,\"lane\":self.lane,\"mode\":mode,\"completed\":completed,\"operations\":*self.operations.lock().unwrap()});\n+        if let Some(residue) = *self.residue.lock().unwrap() {\n+            body[\"residue\"] = json!(residue);\n+        }\n+        std::fs::write(&pending, body.to_string()).map_err(|e| e.to_string())?;\n+        std::fs::rename(pending, path).map_err(|e| e.to_string())\n+    }\n+}"},{"sha":"61254b988d96e32cbe32529a673ff1a892789c40","filename":"crates/onetaskgraph-linear/tests/document_lifecycle/mod.rs","status":"added","additions":496,"deletions":0,"changes":496,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fmod.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fmod.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fmod.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,496 @@\n+//! Shared infrastructure for the two real Linear document lanes.\n+pub mod journal;\n+pub mod observer;\n+use onetaskgraph_linear::live_artifact::{Scope, Slot, classify_retained, retained_title};\n+use serde_json::{Value, json};\n+use std::collections::BTreeMap;\n+use std::sync::{Arc, Mutex};\n+\n+pub const MODE_VARIABLE: &str = \"ONETASKGRAPH_LINEAR_DOCUMENT_MODE\";\n+#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n+pub enum Mode {\n+    Ordinary,\n+    Fresh,\n+    Initialize,\n+}\n+impl Mode {\n+    pub fn name(self) -> &'static str {\n+        match self {\n+            Self::Ordinary => \"ordinary\",\n+            Self::Fresh => \"fresh\",\n+            Self::Initialize => \"initialize\",\n+        }\n+    }\n+\n+    pub fn read() -> Result<Self, String> {\n+        match std::env::var(MODE_VARIABLE).as_deref() {\n+            Err(std::env::VarError::NotPresent) | Ok(\"ordinary\") => Ok(Self::Ordinary),\n+            Ok(\"fresh\") => Ok(Self::Fresh),\n+            Ok(\"initialize\") => Ok(Self::Initialize),\n+            _ => Err(format!(\n+                \"{MODE_VARIABLE} must be ordinary, fresh or initialize\"\n+            )),\n+        }\n+    }\n+}\n+\n+pub struct Standing {\n+    pub titles: BTreeMap<&'static str, String>,\n+    pub ids: BTreeMap<&'static str, String>,\n+    pub parent: Option<String>,\n+}\n+pub fn slot_key(slot: Slot) -> &'static str {\n+    match slot {\n+        Slot::Filed => \"filed\",\n+        Slot::Loose => \"loose\",\n+        Slot::FollowUp => \"follow-up\",\n+        Slot::Assets => \"assets\",\n+        Slot::Parent => \"parent\",\n+    }\n+}\n+\n+pub async fn send(\n+    endpoint: &str,\n+    key: &str,\n+    query: &str,\n+    variables: Value,\n+) -> Result<Value, String> {\n+    let body: Value = reqwest::Client::new()\n+        .post(endpoint)\n+        .header(\"Authorization\", key)\n+        .json(&json!({\"query\":query,\"variables\":variables}))\n+        .send()\n+        .await\n+        .map_err(|e| {\n+            format!(\"Linear lifecycle request failed; discover ownership before retry: {e}\")\n+        })?\n+        .error_for_status()\n+        .map_err(|e| e.to_string())?\n+        .json()\n+        .await\n+        .map_err(|e| e.to_string())?;\n+    if body\n+        .get(\"errors\")\n+        .is_some_and(|e| !e.as_array().is_some_and(Vec::is_empty))\n+    {\n+        return Err(\"Linear rejected lifecycle request; discover ownership before retry\".into());\n+    }\n+    body.get(\"data\")\n+        .cloned()\n+        .ok_or(\"Linear lifecycle response omitted data\".into())\n+}\n+// `teams(first:2)`: a full nested page puts these 100-row listings over Linear's complexity\n+// cap (`complexity.rs`), and two still lets `in_team` see a second team and fail closed.\n+pub(crate) const DOCUMENTS: &str = \"query($after:String,$filter:DocumentFilter!){documents(first:100,after:$after,filter:$filter){nodes{id title team{key} project{teams(first:2){nodes{key} pageInfo{hasNextPage}}}} pageInfo{hasNextPage endCursor}}}\";\n+pub(crate) const PROJECTS: &str = \"query($after:String,$filter:ProjectFilter!){projects(first:100,after:$after,filter:$filter){nodes{id name teams(first:2){nodes{key} pageInfo{hasNextPage}}} pageInfo{hasNextPage endCursor}}}\";\n+fn in_team(node: &Value, team: &str, project: bool) -> bool {\n+    if !project {\n+        match node.get(\"team\") {\n+            Some(Value::Null) => {}\n+            Some(Value::Object(direct)) => {\n+                return direct\n+                    .get(\"key\")\n+                    .and_then(Value::as_str)\n+                    .is_some_and(|key| key.eq_ignore_ascii_case(team));\n+            }\n+            _ => return false,\n+        }\n+    }\n+    let teams = if project {\n+        node.get(\"teams\")\n+    } else {\n+        node.pointer(\"/project/teams\")\n+    };\n+    teams.is_some_and(|teams| {\n+        teams.pointer(\"/pageInfo/hasNextPage\") == Some(&json!(false))\n+            && teams[\"nodes\"].as_array().is_some_and(|nodes| {\n+                !nodes.is_empty()\n+                    && nodes.iter().all(|n| {\n+                        n[\"key\"]\n+                            .as_str()\n+                            .is_some_and(|key| key.eq_ignore_ascii_case(team))\n+                    })\n+            })\n+    })\n+}\n+async fn discover(\n+    endpoint: &str,\n+    key: &str,\n+    title: &str,\n+    team: &str,\n+    project: bool,\n+) -> Result<Option<String>, String> {\n+    let root = if project { \"projects\" } else { \"documents\" };\n+    let name = if project { \"name\" } else { \"title\" };\n+    let query = if project { PROJECTS } else { DOCUMENTS };\n+    let mut after = Value::Null;\n+    let mut found = Vec::new();\n+    for _ in 0..50 {\n+        let filter = json!({name:{\"containsIgnoreCase\":format!(\"{}retained\",onetaskgraph_linear::LIVE_ARTIFACT_TITLE_PREFIX)}});\n+        let data = send(endpoint, key, query, json!({\"after\":after,\"filter\":filter})).await?;\n+        let page = &data[root];\n+        for node in page[\"nodes\"]\n+            .as_array()\n+            .ok_or(\"standing discovery omitted nodes\")?\n+        {\n+            let actual_title = node[name]\n+                .as_str()\n+                .ok_or(\"standing discovery omitted title\")?;\n+            let actual = classify_retained(actual_title)\n+                .ok_or(\"unknown standing ownership; discovery required before initialization\")?;\n+            let expected = classify_retained(title).ok_or(\"invalid requested standing identity\")?;\n+            if actual.scope != expected.scope {\n+                continue;\n+            }\n+            if !in_team(node, team, project) {\n+                return Err(\"standing ownership or nominated-team membership cannot be verified; no update sent\".into());\n+            }\n+            if actual.slot != expected.slot {\n+                continue;\n+            }\n+            found.push(\n+                node[\"id\"]\n+                    .as_str()\n+                    .filter(|s| !s.is_empty())\n+                    .ok_or(\"standing discovery omitted id\")?\n+                    .to_owned(),\n+            );\n+        }\n+        match page\n+            .pointer(\"/pageInfo/hasNextPage\")\n+            .and_then(Value::as_bool)\n+        {\n+            Some(false) => {\n+                return match found.len() {\n+                    0 => Ok(None),\n+                    1 => Ok(found.pop()),\n+                    _ => Err(\"duplicate standing ownership; no update sent\".into()),\n+                };\n+            }\n+            Some(true) => {\n+                let next = page\n+                    .pointer(\"/pageInfo/endCursor\")\n+                    .and_then(Value::as_str)\n+                    .ok_or(\"standing discovery omitted cursor\")?;\n+                if after.as_str() == Some(next) {\n+                    return Err(\"standing discovery cursor did not advance\".into());\n+                }\n+                after = json!(next);\n+            }\n+            None => return Err(\"standing discovery omitted pagination\".into()),\n+        }\n+    }\n+    Err(\"standing discovery did not terminate\".into())\n+}\n+/// Every slot this invocation created, recorded the moment Linear acknowledged its id.\n+///\n+/// A local set is the invocation's own, so a failure or panic anywhere after its first\n+/// create — partway through initialization included — has to retire exactly these ids\n+/// rather than leave them for the orphan sweep. [`retire`] drains it, so a second call\n+/// after the ordinary cleanup has run deletes nothing twice.\n+#[derive(Clone, Default)]\n+pub struct Created {\n+    ids: Arc<Mutex<Vec<(Slot, String)>>>,\n+    panic_after: Option<usize>,\n+}\n+impl Created {\n+    /// Fault injection for the offline journeys: panic straight after the `n`th create\n+    /// is recorded, which is the earliest point a lane can have stranded a slot.\n+    pub fn panicking_after(n: usize) -> Self {\n+        Self {\n+            panic_after: Some(n),\n+            ..Self::default()\n+        }\n+    }\n+    fn record(&self, slot: Slot, id: &str) {\n+        let count = {\n+            let mut ids = self.ids.lock().unwrap();\n+            ids.push((slot, id.to_owned()));\n+            ids.len()\n+        };\n+        if self.panic_after == Some(count) {\n+            panic!(\"injected failure after standing create {count}\");\n+        }\n+    }\n+    /// Drops the record once another cleanup has attempted every recorded slot itself.\n+    #[allow(\n+        dead_code,\n+        reason = \"this module is compiled into both lanes' test binaries, and only the asset lane's own cleanup retires slots by its standing record\"\n+    )]\n+    pub fn forget(&self) {\n+        self.ids.lock().unwrap().clear();\n+    }\n+    pub fn len(&self) -> usize {\n+        self.ids.lock().unwrap().len()\n+    }\n+}\n+\n+/// Deletes, newest first, every slot `created` holds — documents before the parent project\n+/// they are filed under — when the set is invocation-owned. A CI set is standing and is\n+/// never retired here. Returns how many were deleted; every refusal is named.\n+pub async fn retire(\n+    endpoint: &str,\n+    key: &str,\n+    scope: Scope<'_>,\n+    created: &Created,\n+) -> Result<usize, String> {\n+    if scope.is_ci() {\n+        return Ok(0);\n+    }\n+    let held = std::mem::take(&mut *created.ids.lock().unwrap());\n+    let mut refused = Vec::new();\n+    let mut retired = 0;\n+    for (slot, id) in held.into_iter().rev() {\n+        let (query, root) = if slot == Slot::Parent {\n+            (\n+                onetaskgraph_linear::graphql::PROJECT_DELETE,\n+                \"projectDelete\",\n+            )\n+        } else {\n+            (\n+                onetaskgraph_linear::graphql::DOCUMENT_DELETE,\n+                \"documentDelete\",\n+            )\n+        };\n+        match send(endpoint, key, query, json!({\"id\":id})).await {\n+            Ok(data) if data[root][\"success\"] == true => retired += 1,\n+            Ok(_) => refused.push(format!(\n+                \"Linear did not confirm retiring {} slot {id}\",\n+                slot_key(slot)\n+            )),\n+            Err(error) => refused.push(format!(\"{} slot {id}: {error}\", slot_key(slot))),\n+        }\n+    }\n+    if refused.is_empty() {\n+        Ok(retired)\n+    } else {\n+        Err(format!(\n+            \"invocation-owned standing slots were not all retired: {}\",\n+            refused.join(\"; \")\n+        ))\n+    }\n+}\n+\n+/// Polls `future`, turning a panic inside it into `Err` so the caller can clean up first.\n+pub async fn unwinding<F: std::future::Future>(future: F) -> std::thread::Result<F::Output> {\n+    let mut future = std::pin::pin!(future);\n+    std::future::poll_fn(|cx| {\n+        match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| future.as_mut().poll(cx))) {\n+            Ok(std::task::Poll::Pending) => std::task::Poll::Pending,\n+            Ok(std::task::Poll::Ready(output)) => std::task::Poll::Ready(Ok(output)),\n+            Err(panic) => std::task::Poll::Ready(Err(panic)),\n+        }\n+    })\n+    .await\n+}\n+\n+/// [`prepare`] for a live lane: a failure or panic after any slot create retires every slot\n+/// this invocation created before it is reported, so nothing it owns outlives the process.\n+#[allow(\n+    clippy::too_many_arguments,\n+    reason = \"prepare's seven lane identities plus the tracker its caller must hold for cleanup; a struct would only restate them\"\n+)]\n+pub async fn prepare_owned(\n+    endpoint: &str,\n+    key: &str,\n+    team: &str,\n+    team_id: &str,\n+    scope: Scope<'_>,\n+    mode: Mode,\n+    slots: &[Slot],\n+    created: &Created,\n+) -> Result<Standing, String> {\n+    let outcome = unwinding(prepare_tracked(\n+        endpoint, key, team, team_id, scope, mode, slots, created,\n+    ))\n+    .await;\n+    if !matches!(outcome, Ok(Ok(_))) {\n+        discover_stranded(endpoint, key, team, scope, slots, created).await;\n+    }\n+    match outcome {\n+        Ok(Ok(standing)) => Ok(standing),\n+        Ok(Err(error)) => Err(match retire(endpoint, key, scope, created).await {\n+            Ok(_) => error,\n+            Err(retired) => format!(\"{error}; additionally, {retired}\"),\n+        }),\n+        Err(panic) => {\n+            if let Err(retired) = retire(endpoint, key, scope, created).await {\n+                eprintln!(\"{retired}\");\n+            }\n+            std::panic::resume_unwind(panic)\n+        }\n+    }\n+}\n+\n+/// A local create whose acknowledgement named no id may still have stored the slot, so a\n+/// failed initialization finds each slot it did not record by its exact identity — the\n+/// discovery recovery requires — and records it for [`retire`]. A CI set is left as it is.\n+async fn discover_stranded(\n+    endpoint: &str,\n+    key: &str,\n+    team: &str,\n+    scope: Scope<'_>,\n+    slots: &[Slot],\n+    created: &Created,\n+) {\n+    if scope.is_ci() {\n+        return;\n+    }\n+    let mut wanted = slots.to_vec();\n+    if slots.contains(&Slot::Filed) {\n+        wanted.insert(0, Slot::Parent);\n+    }\n+    for slot in wanted {\n+        if created\n+            .ids\n+            .lock()\n+            .unwrap()\n+            .iter()\n+            .any(|(held, _)| *held == slot)\n+        {\n+            continue;\n+        }\n+        let Ok(title) = retained_title(scope, slot) else {\n+            continue;\n+        };\n+        match discover(endpoint, key, &title, team, slot == Slot::Parent).await {\n+            Ok(Some(id)) => {\n+                // The parent goes last in `retire`, which deletes newest first.\n+                let mut ids = created.ids.lock().unwrap();\n+                if slot == Slot::Parent {\n+                    ids.insert(0, (slot, id));\n+                } else {\n+                    ids.push((slot, id));\n+                }\n+            }\n+            Ok(None) => {}\n+            Err(error) => eprintln!(\n+                \"{} slot could not be discovered for retirement: {error}\",\n+                slot_key(slot)\n+            ),\n+        }\n+    }\n+}\n+/// Ordinary non-CI discovery is read-only; initialization, and an ordinary CI pass as a\n+/// cold rebuild, fill only the missing identities.\n+pub async fn prepare(\n+    endpoint: &str,\n+    key: &str,\n+    team: &str,\n+    team_id: &str,\n+    scope: Scope<'_>,\n+    mode: Mode,\n+    slots: &[Slot],\n+) -> Result<Standing, String> {\n+    prepare_tracked(\n+        endpoint,\n+        key,\n+        team,\n+        team_id,\n+        scope,\n+        mode,\n+        slots,\n+        &Created::default(),\n+    )\n+    .await\n+}\n+\n+#[allow(\n+    clippy::too_many_arguments,\n+    reason = \"the same lane identities as prepare_owned, which forwards each one unchanged\"\n+)]\n+async fn prepare_tracked(\n+    endpoint: &str,\n+    key: &str,\n+    team: &str,\n+    team_id: &str,\n+    scope: Scope<'_>,\n+    mode: Mode,\n+    slots: &[Slot],\n+    created: &Created,\n+) -> Result<Standing, String> {\n+    let nominated = scope.team();\n+    if !nominated.eq_ignore_ascii_case(team)\n+        || team_id.trim().is_empty()\n+        || team_id.chars().any(char::is_control)\n+    {\n+        return Err(\"standing scope and nominated team disagree or team id is unverifiable\".into());\n+    }\n+    let mut standing = Standing {\n+        titles: BTreeMap::new(),\n+        ids: BTreeMap::new(),\n+        parent: None,\n+    };\n+    if mode == Mode::Fresh {\n+        return Ok(standing);\n+    }\n+    let mut wanted = slots.to_vec();\n+    if slots.contains(&Slot::Filed) {\n+        wanted.insert(0, Slot::Parent);\n+    }\n+    // Discover the entire lane before sending even an initialization mutation.\n+    for slot in &wanted {\n+        let title = retained_title(scope, *slot)?;\n+        if let Some(id) = discover(endpoint, key, &title, team, *slot == Slot::Parent).await? {\n+            standing.ids.insert(slot_key(*slot), id);\n+        }\n+        standing.titles.insert(slot_key(*slot), title);\n+    }\n+    // An ordinary CI pass rebuilds a missing standing slot itself, under the shared CI\n+    // concurrency group, and its journal files that create as a cold rebuild outside the\n+    // ordinary total. A non-CI set is the invocation's own and is created only on request.\n+    if mode == Mode::Ordinary\n+        && !scope.is_ci()\n+        && wanted\n+            .iter()\n+            .any(|s| !standing.ids.contains_key(slot_key(*s)))\n+    {\n+        return Err(format!(\n+            \"invocation-owned Linear document set absent or incomplete; non-CI ordinary reuse would create documents; run {MODE_VARIABLE}=initialize for an explicit creation pass; no documentCreate sent\"\n+        ));\n+    }\n+    for slot in wanted {\n+        let name = slot_key(slot);\n+        if standing.ids.contains_key(name) {\n+            continue;\n+        }\n+        let title = &standing.titles[name];\n+        let (query, input, root, field) = if slot == Slot::Parent {\n+            (\n+                \"mutation($input:ProjectCreateInput!){projectCreate(input:$input){success project{id}}}\",\n+                json!({\"name\":title,\"teamIds\":[team_id]}),\n+                \"projectCreate\",\n+                \"project\",\n+            )\n+        } else {\n+            let mut input =\n+                json!({\"title\":title,\"content\":\"Explicit standing-set initialization.\"});\n+            if slot == Slot::Filed {\n+                input[\"projectId\"] = json!(standing.ids[\"parent\"]);\n+            } else {\n+                input[\"teamId\"] = json!(team_id);\n+            }\n+            (\n+                \"mutation($input:DocumentCreateInput!){documentCreate(input:$input){success document{id}}}\",\n+                input,\n+                \"documentCreate\",\n+                \"document\",\n+            )\n+        };\n+        let data = send(endpoint, key, query, json!({\"input\":input}))\n+            .await\n+            .map_err(|error| {\n+                format!(\n+                    \"uncertain standing create; discover exact identity before recovery: {error}\"\n+                )\n+            })?;\n+        if data[root][\"success\"] != true {\n+            return Err(\"uncertain standing create; discover exact identity before recovery; no automatic retry\".into());\n+        }\n+        let id=data[root][field][\"id\"].as_str().filter(|s| !s.is_empty()).ok_or(\"uncertain standing create acknowledgement; discover exact identity before recovery; no automatic retry\")?;\n+        standing.ids.insert(name, id.to_owned());\n+        created.record(slot, id);\n+    }\n+    standing.parent = standing.ids.get(\"parent\").cloned();\n+    Ok(standing)\n+}"},{"sha":"be87679d04f4c7fe27ab0312cd9e95cfd9d8e78d","filename":"crates/onetaskgraph-linear/tests/document_lifecycle/observer.rs","status":"added","additions":68,"deletions":0,"changes":68,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fobserver.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fobserver.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Fobserver.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,68 @@\n+//! A transport observer forwards requests unchanged and records only successful creates.\n+use super::journal::Journal;\n+use serde_json::Value;\n+use std::{\n+    io::{Read, Write},\n+    net::TcpListener,\n+};\n+\n+pub fn start(upstream: &str, key: &str, journal: Journal) -> String {\n+    let listener = TcpListener::bind(\"127.0.0.1:0\").expect(\"loopback observer\");\n+    let endpoint = format!(\"http://{}/graphql\", listener.local_addr().unwrap());\n+    let upstream = upstream.to_owned();\n+    let key = key.to_owned();\n+    std::thread::spawn(move || {\n+        let runtime = tokio::runtime::Runtime::new().unwrap();\n+        let client = reqwest::Client::new();\n+        'connections: for mut stream in listener.incoming().flatten() {\n+            let mut bytes = Vec::new();\n+            let mut buf = [0; 8192];\n+            let request: Value = loop {\n+                let n = match stream.read(&mut buf) {\n+                    Ok(0) | Err(_) => continue 'connections,\n+                    Ok(n) => n,\n+                };\n+                bytes.extend_from_slice(&buf[..n]);\n+                assert!(bytes.len() < 2_000_000, \"bounded live request\");\n+                if let Some(split) = bytes.windows(4).position(|b| b == b\"\\r\\n\\r\\n\") {\n+                    let head = String::from_utf8_lossy(&bytes[..split]).to_ascii_lowercase();\n+                    let size: usize = head\n+                        .lines()\n+                        .find_map(|l| l.strip_prefix(\"content-length: \"))\n+                        .unwrap()\n+                        .parse()\n+                        .unwrap();\n+                    if bytes.len() >= split + 4 + size {\n+                        break serde_json::from_slice(&bytes[split + 4..split + 4 + size]).unwrap();\n+                    }\n+                }\n+            };\n+            let response = runtime.block_on(\n+                client\n+                    .post(&upstream)\n+                    .header(\"Authorization\", &key)\n+                    .json(&request)\n+                    .send(),\n+            );\n+            match response {\n+                Ok(response) => {\n+                    let status = response.status().as_u16();\n+                    let body = runtime.block_on(response.bytes()).unwrap();\n+                    if let Ok(value) = serde_json::from_slice(&body) {\n+                        journal.observe(&request, &value);\n+                    }\n+                    let _ = write!(\n+                        stream,\n+                        \"HTTP/1.1 {status} Observed\\r\\nContent-Type: application/json\\r\\nContent-Length: {}\\r\\nConnection: close\\r\\n\\r\\n\",\n+                        body.len()\n+                    );\n+                    let _ = stream.write_all(&body);\n+                }\n+                Err(_) => {\n+                    let _ = stream.write_all(b\"HTTP/1.1 502 Upstream unavailable\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\");\n+                }\n+            }\n+        }\n+    });\n+    endpoint\n+}"},{"sha":"1dc099fe9e07f4958453191d6669dcb5f4f224a3","filename":"crates/onetaskgraph-linear/tests/document_lifecycle/replay.rs","status":"added","additions":443,"deletions":0,"changes":443,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Freplay.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Freplay.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Freplay.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,443 @@\n+//! Synthetic HTTP replay of the recorded Linear wire shapes, never a source double.\n+use super::document_lifecycle::journal::Journal;\n+#[path = \"replay_schema.rs\"]\n+mod schema;\n+use serde_json::{Value, json};\n+use std::{\n+    collections::BTreeMap,\n+    io::{Read, Write},\n+    net::{TcpListener, TcpStream},\n+    sync::{\n+        Arc, Mutex,\n+        atomic::{AtomicBool, Ordering},\n+    },\n+};\n+#[derive(Default)]\n+pub struct State {\n+    pub documents: BTreeMap<String, Value>,\n+    pub projects: BTreeMap<String, Value>,\n+    pub issues: BTreeMap<String, Value>,\n+    /// Labels by name: their id, and how many lookups of that name answer no match before\n+    /// the label filter holds it — Linear's read-after-write lag; `u32::MAX` never holds it.\n+    pub labels: BTreeMap<String, (String, u32)>,\n+    /// How many times each label name has been looked up.\n+    pub label_lookups: BTreeMap<String, u32>,\n+    pub requests: Vec<Value>,\n+    pub uncertain: bool,\n+    pub pause_next_create: bool,\n+    pub wrong_team: bool,\n+    pub direct_team_override: Option<Value>,\n+    pub omit_direct_team: bool,\n+    pub unverifiable_team: bool,\n+    pub corrupt_document_create_ack: bool,\n+    pub freeze_document_run_metadata: bool,\n+    pub ambiguous: bool,\n+    /// Discovery-only page size and deliberate pagination fault, applied over stored rows.\n+    pub discovery_pagination: Option<&'static str>,\n+    pub schema_errors: Vec<String>,\n+    serial: usize,\n+    rewrites: BTreeMap<String, String>,\n+}\n+pub struct Replay {\n+    pub endpoint: String,\n+    pub state: Arc<Mutex<State>>,\n+    pub journal: Journal,\n+    pub paused: Arc<AtomicBool>,\n+    pub release: Arc<AtomicBool>,\n+}\n+fn page(nodes: Vec<Value>) -> Value {\n+    json!({\"nodes\":nodes,\"pageInfo\":{\"hasNextPage\":false,\"hasPreviousPage\":false,\"endCursor\":null,\"startCursor\":null}})\n+}\n+fn matches(row: &Value, filter: &Value) -> bool {\n+    let Some(filter) = filter.as_object() else {\n+        return true;\n+    };\n+    filter.iter().all(|(field, cmp)| {\n+        if field == \"and\" {\n+            return cmp.as_array().unwrap().iter().all(|f| matches(row, f));\n+        }\n+        if field == \"or\" {\n+            return cmp.as_array().unwrap().iter().any(|f| matches(row, f));\n+        }\n+        if field == \"team\" {\n+            return true;\n+        }\n+        if field == \"comments\" {\n+            return row[\"comments\"].as_array().is_some_and(|comments| {\n+                comments\n+                    .iter()\n+                    .any(|comment| matches(comment, &cmp[\"some\"]))\n+            });\n+        }\n+        let value = &row[field];\n+        if let Some(cmp) = cmp.as_object() {\n+            cmp.iter().all(|(op, wanted)| match op.as_str() {\n+                \"eq\" => value == wanted,\n+                \"neq\" => value != wanted,\n+                \"eqIgnoreCase\" => value\n+                    .as_str()\n+                    .zip(wanted.as_str())\n+                    .is_some_and(|(a, b)| a.eq_ignore_ascii_case(b)),\n+                \"contains\" => value\n+                    .as_str()\n+                    .zip(wanted.as_str())\n+                    .is_some_and(|(a, b)| a.contains(b)),\n+                \"containsIgnoreCase\" => value\n+                    .as_str()\n+                    .zip(wanted.as_str())\n+                    .is_some_and(|(a, b)| a.to_lowercase().contains(&b.to_lowercase())),\n+                \"startsWith\" => value\n+                    .as_str()\n+                    .zip(wanted.as_str())\n+                    .is_some_and(|(a, b)| a.starts_with(b)),\n+                \"in\" => wanted.as_array().is_some_and(|v| v.contains(value)),\n+                \"null\" => value.is_null() == wanted.as_bool().unwrap_or(false),\n+                \"some\" => value\n+                    .get(\"nodes\")\n+                    .and_then(Value::as_array)\n+                    .is_some_and(|nodes| nodes.iter().any(|n| matches(n, wanted))),\n+                \"gte\" => value\n+                    .as_str()\n+                    .zip(wanted.as_str())\n+                    .is_some_and(|(a, b)| a >= b),\n+                _ => matches(value, &json!({op:wanted})),\n+            })\n+        } else {\n+            true\n+        }\n+    })\n+}\n+impl Replay {\n+    pub fn start(journal: Journal, rewrites: BTreeMap<String, String>) -> Self {\n+        let listener = TcpListener::bind(\"127.0.0.1:0\").unwrap();\n+        let upstream = format!(\"http://{}/graphql\", listener.local_addr().unwrap());\n+        let state = Arc::new(Mutex::new(State {\n+            rewrites,\n+            ..State::default()\n+        }));\n+        let paused = Arc::new(AtomicBool::new(false));\n+        let release = Arc::new(AtomicBool::new(false));\n+        let serving_paused = paused.clone();\n+        let serving_release = release.clone();\n+        let serving = state.clone();\n+        std::thread::spawn(move || {\n+            for mut stream in listener.incoming().flatten() {\n+                let request = read(&mut stream);\n+                let mut state = serving.lock().unwrap();\n+                // Linear scores a document before it reads a row and refuses one over its\n+                // cap with HTTP 400, so this replay does too, rather than answering it.\n+                // A request with no query string fails to parse and is refused the same way.\n+                if let Some(refused) = schema::complexity::refusal(\n+                    request[\"query\"].as_str().unwrap_or_default(),\n+                    &request[\"variables\"],\n+                ) {\n+                    state.schema_errors.push(refused.clone());\n+                    state.requests.push(request);\n+                    drop(state);\n+                    let body = json!({\"errors\":[{\"message\":refused}]}).to_string();\n+                    let _ = write!(\n+                        stream,\n+                        \"HTTP/1.1 400 Bad Request\\r\\nContent-Type: application/json\\r\\nContent-Length: {}\\r\\nConnection: close\\r\\n\\r\\n{body}\",\n+                        body.len()\n+                    );\n+                    continue;\n+                }\n+                let mut body = respond(&mut state, &request);\n+                if body.get(\"errors\").is_none()\n+                    && body\n+                        .pointer(\"/data/documentCreate/document\")\n+                        .is_none_or(|v| !v.is_null())\n+                    && let Err(error) = schema::validate(request[\"query\"].as_str().unwrap(), &body)\n+                {\n+                    state.schema_errors.push(error.clone());\n+                    body = json!({\"errors\":[{\"message\":error}]});\n+                }\n+                // Negative wire journeys corrupt an otherwise schema-validated response.\n+                // Missing pagination must reach discovery's guard, rather than becoming a\n+                // schema validator error returned by the fixture server itself.\n+                if state.discovery_pagination == Some(\"missing-pagination\")\n+                    && request[\"query\"].as_str().unwrap().contains(\"documents(\")\n+                    && let Some(connection) = body\n+                        .pointer_mut(\"/data/documents\")\n+                        .and_then(Value::as_object_mut)\n+                {\n+                    connection.remove(\"pageInfo\");\n+                }\n+                if request[\"query\"].as_str().unwrap().contains(\"documents(\")\n+                    && let Some(nodes) = body\n+                        .pointer_mut(\"/data/documents/nodes\")\n+                        .and_then(Value::as_array_mut)\n+                {\n+                    for node in nodes {\n+                        if state.omit_direct_team {\n+                            node.as_object_mut().unwrap().remove(\"team\");\n+                        } else if let Some(direct) = &state.direct_team_override {\n+                            node[\"team\"] = direct.clone();\n+                        }\n+                    }\n+                }\n+                let pause = state.pause_next_create\n+                    && request[\"query\"]\n+                        .as_str()\n+                        .unwrap()\n+                        .contains(\"documentCreate(\");\n+                if pause {\n+                    state.pause_next_create = false;\n+                }\n+                state.requests.push(request);\n+                drop(state);\n+                if pause {\n+                    serving_paused.store(true, Ordering::Release);\n+                    while !serving_release.load(Ordering::Acquire) {\n+                        std::thread::sleep(std::time::Duration::from_millis(5));\n+                    }\n+                }\n+                let body = body.to_string();\n+                let _ = write!(\n+                    stream,\n+                    \"HTTP/1.1 200 OK\\r\\nContent-Type: application/json\\r\\nContent-Length: {}\\r\\nConnection: close\\r\\n\\r\\n{body}\",\n+                    body.len()\n+                );\n+            }\n+        });\n+        let endpoint =\n+            super::document_lifecycle::observer::start(&upstream, \"synthetic\", journal.clone());\n+        Self {\n+            endpoint,\n+            state,\n+            journal,\n+            paused,\n+            release,\n+        }\n+    }\n+}\n+fn read(stream: &mut TcpStream) -> Value {\n+    let mut bytes = Vec::new();\n+    let mut buf = [0; 8192];\n+    loop {\n+        let n = stream.read(&mut buf).unwrap();\n+        assert!(n > 0);\n+        bytes.extend_from_slice(&buf[..n]);\n+        assert!(bytes.len() < 2_000_000);\n+        if let Some(p) = bytes.windows(4).position(|b| b == b\"\\r\\n\\r\\n\") {\n+            let head = String::from_utf8_lossy(&bytes[..p]).to_lowercase();\n+            let len: usize = head\n+                .lines()\n+                .find_map(|l| l.strip_prefix(\"content-length: \"))\n+                .unwrap()\n+                .parse()\n+                .unwrap();\n+            if bytes.len() >= p + 4 + len {\n+                return serde_json::from_slice(&bytes[p + 4..p + 4 + len]).unwrap();\n+            }\n+        }\n+    }\n+}\n+fn respond(state: &mut State, request: &Value) -> Value {\n+    let q = request[\"query\"].as_str().unwrap();\n+    let v = &request[\"variables\"];\n+    graphql_parser::parse_query::<String>(q).expect(\"replay requests are GraphQL documents\");\n+    let teams = json!({\"nodes\":[{\"id\":\"team\",\"key\":\"ENG\",\"states\":{\"nodes\":[{\"id\":\"open\",\"name\":\"Todo\",\"type\":\"unstarted\",\"position\":0},{\"id\":\"done\",\"name\":\"Done\",\"type\":\"completed\",\"position\":1}],\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":null}}}]});\n+    if q.contains(\"issueLabels(\") {\n+        let name = v[\"name\"].as_str().unwrap().to_lowercase();\n+        let lookups = state.label_lookups.entry(name.clone()).or_default();\n+        *lookups += 1;\n+        let seen = *lookups;\n+        let nodes = state\n+            .labels\n+            .iter()\n+            .filter(|(held, (_, lag))| held.to_lowercase() == name && seen > *lag)\n+            .map(|(_, (id, _))| json!({\"id\":id}))\n+            .collect();\n+        return json!({\"data\":{\"issueLabels\":page(nodes)}});\n+    }\n+    if q.contains(\"teams(\") && !q.contains(\"projects(\") && !q.contains(\"documents(\") {\n+        return json!({\"data\":{\"organization\":{\"id\":\"synthetic-organization\"},\"teams\":teams,\"projectStatuses\":{\"nodes\":[{\"id\":\"status\",\"name\":\"Planned\",\"type\":\"planned\",\"position\":0}],\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":null}}}});\n+    }\n+    for (root, field) in [\n+        (\"documentCreate\", \"document\"),\n+        (\"documentUpdate\", \"document\"),\n+        (\"projectCreate\", \"project\"),\n+        (\"issueCreate\", \"issue\"),\n+        (\"issueUpdate\", \"issue\"),\n+    ] {\n+        if q.contains(&format!(\"{root}(\")) {\n+            let create = root.ends_with(\"Create\");\n+            let id = if create {\n+                state.serial += 1;\n+                format!(\"{field}-{}\", state.serial)\n+            } else {\n+                v[\"id\"].as_str().unwrap().to_owned()\n+            };\n+            let table = match field {\n+                \"document\" => &mut state.documents,\n+                \"project\" => &mut state.projects,\n+                _ => &mut state.issues,\n+            };\n+            let template: Value = serde_json::from_str(if field == \"document\" {\n+                include_str!(\"../fixtures/documents.json\")\n+            } else if field == \"project\" {\n+                include_str!(\"../fixtures/projects.json\")\n+            } else {\n+                include_str!(\"../fixtures/issues.json\")\n+            })\n+            .unwrap();\n+            let mut row = table.get(&id).cloned().unwrap_or_else(|| {\n+                if field == \"document\" {\n+                    template[\"data\"][\"documents\"][\"nodes\"][0].clone()\n+                } else if field == \"project\" {\n+                    template[\"data\"][\"projects\"][\"nodes\"][0].clone()\n+                } else {\n+                    template[\"data\"][\"issues\"][\"nodes\"][0].clone()\n+                }\n+            });\n+            row[\"id\"] = json!(id);\n+            row[\"archivedAt\"] = Value::Null;\n+            row[\"url\"] = json!(format!(\"https://linear.app/test/{field}/{id}\"));\n+            row[\"team\"] = json!({\"key\":\"ENG\"});\n+            row[\"teams\"] = json!({\"nodes\":[{\"key\":\"ENG\"}],\"pageInfo\":{\"hasNextPage\":false}});\n+            if create {\n+                row[\"project\"] = Value::Null;\n+                row[\"labels\"] = page(vec![]);\n+                row[\"relations\"] = page(vec![]);\n+                row[\"comments\"] = json!([]);\n+            }\n+            for (key, value) in v[\"input\"].as_object().unwrap() {\n+                match key.as_str() {\n+                    \"teamId\" | \"teamIds\" => {}\n+                    \"projectId\" => {\n+                        row[\"project\"] = if value.is_null() {\n+                            Value::Null\n+                        } else {\n+                            json!({\"id\":value,\"teams\":{\"nodes\":[{\"key\":\"ENG\"}],\"pageInfo\":{\"hasNextPage\":false}}})\n+                        }\n+                    }\n+                    \"stateId\" => row[\"state\"] = json!({\"name\":\"Todo\",\"type\":\"unstarted\"}),\n+                    \"content\" | \"description\" => {\n+                        if root == \"documentUpdate\"\n+                            && state.freeze_document_run_metadata\n+                            && value\n+                                .as_str()\n+                                .is_some_and(|body| body.contains(\"caller.run\"))\n+                        {\n+                            continue;\n+                        }\n+                        row[key] = value\n+                            .as_str()\n+                            .and_then(|s| state.rewrites.get(s))\n+                            .map(|s| json!(s))\n+                            .unwrap_or_else(|| value.clone())\n+                    }\n+                    _ => row[key] = value.clone(),\n+                }\n+            }\n+            table.insert(id, row.clone());\n+            if root == \"documentCreate\" && state.uncertain {\n+                state.uncertain = false;\n+                return json!({\"data\":{root:{\"success\":true,\"document\":null}}});\n+            }\n+            if root == \"documentCreate\" && state.corrupt_document_create_ack {\n+                row[\"content\"] =\n+                    json!(\"Synthetic changed body in a successful create acknowledgement.\");\n+            }\n+            return json!({\"data\":{root:{\"success\":true,field:row}}});\n+        }\n+    }\n+    for (root, table) in [\n+        (\"documentDelete\", &mut state.documents),\n+        (\"projectDelete\", &mut state.projects),\n+        (\"issueDelete\", &mut state.issues),\n+    ] {\n+        if q.contains(&format!(\"{root}(\")) {\n+            table.remove(v[\"id\"].as_str().unwrap());\n+            return json!({\"data\":{root:{\"success\":true}}});\n+        }\n+    }\n+    if q.contains(\"commentCreate(\") {\n+        let id = v[\"input\"][\"issueId\"].as_str().unwrap();\n+        let mut comment: Value =\n+            serde_json::from_str(include_str!(\"../fixtures/comments.json\")).unwrap();\n+        comment = comment[\"data\"][\"issue\"][\"comments\"][\"nodes\"][0].clone();\n+        comment[\"body\"] = v[\"input\"][\"body\"].clone();\n+        comment[\"createdAt\"] = json!(chrono::Utc::now().to_rfc3339());\n+        comment[\"updatedAt\"] = comment[\"createdAt\"].clone();\n+        state.issues.get_mut(id).unwrap()[\"comments\"]\n+            .as_array_mut()\n+            .unwrap()\n+            .push(comment.clone());\n+        return json!({\"data\":{\"commentCreate\":{\"success\":true,\"comment\":comment}}});\n+    }\n+    for (root, table) in [\n+        (\"document\", &state.documents),\n+        (\"project\", &state.projects),\n+        (\"issue\", &state.issues),\n+    ] {\n+        if q.contains(&format!(\"{root}(\")) {\n+            let row = table\n+                .get(v[\"id\"].as_str().unwrap())\n+                .cloned()\n+                .unwrap_or(Value::Null);\n+            return json!({\"data\":{root:row}});\n+        }\n+    }\n+    for (root, table) in [\n+        (\"documents\", &state.documents),\n+        (\"projects\", &state.projects),\n+        (\"issues\", &state.issues),\n+    ] {\n+        if q.contains(&format!(\"{root}(\")) {\n+            let mut nodes: Vec<_> = table\n+                .values()\n+                .filter(|row| matches(row, &v[\"filter\"]))\n+                .cloned()\n+                .collect();\n+            if state.wrong_team {\n+                for row in &mut nodes {\n+                    row[\"team\"] = json!({\"key\":\"OTHER\"});\n+                    row[\"teams\"] = json!({\"nodes\":[],\"pageInfo\":{\"hasNextPage\":true}});\n+                }\n+            }\n+            if state.unverifiable_team {\n+                for row in &mut nodes {\n+                    row[\"team\"] = Value::Null;\n+                    row[\"project\"] = json!({\"teams\":{\"nodes\":[],\"pageInfo\":{\"hasNextPage\":true}}});\n+                    row[\"teams\"] = json!({\"nodes\":[],\"pageInfo\":{\"hasNextPage\":true}});\n+                }\n+            }\n+            if state.ambiguous\n+                && let Some(first) = nodes.first().cloned()\n+            {\n+                nodes.push(first);\n+            }\n+            let connection = if root == \"documents\" {\n+                if let Some(mode) = state.discovery_pagination {\n+                    let index = v[\"after\"]\n+                        .as_str()\n+                        .map(|cursor| cursor.parse::<usize>().expect(\"synthetic cursor\"))\n+                        .unwrap_or(0);\n+                    let next = index + 1;\n+                    let more = mode == \"exhausted\" || next < nodes.len();\n+                    let rows = nodes.into_iter().skip(index).take(1).collect();\n+                    let mut connection = page(rows);\n+                    connection[\"pageInfo\"][\"hasNextPage\"] = json!(more);\n+                    connection[\"pageInfo\"][\"endCursor\"] = if mode == \"missing-cursor\" {\n+                        Value::Null\n+                    } else if mode == \"repeated-cursor\" {\n+                        json!(\"1\")\n+                    } else if more {\n+                        json!(next.to_string())\n+                    } else {\n+                        Value::Null\n+                    };\n+                    connection\n+                } else {\n+                    page(nodes)\n+                }\n+            } else {\n+                page(nodes)\n+            };\n+            return json!({\"data\":{root:connection}});\n+        }\n+    }\n+    panic!(\"unhandled synthetic replay query: {q}\")\n+}"},{"sha":"c97fb5dfc148f141393edcc0834859fb15b9b50d","filename":"crates/onetaskgraph-linear/tests/document_lifecycle/replay_schema.rs","status":"added","additions":213,"deletions":0,"changes":213,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Freplay_schema.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Freplay_schema.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Fdocument_lifecycle%2Freplay_schema.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -0,0 +1,213 @@\n+//! Every selected response field is checked against the pinned Linear schema. Synthetic\n+//! values replace fixture bodies, never their selected wire types.\n+use graphql_parser::{query as q, schema as s};\n+use serde_json::Value;\n+use std::{collections::BTreeMap, sync::LazyLock};\n+#[path = \"complexity.rs\"]\n+pub mod complexity;\n+static SCHEMA: LazyLock<s::Document<'static, String>> =\n+    LazyLock::new(|| s::parse_schema(include_str!(\"../fixtures/schema.graphql\")).unwrap());\n+\n+pub fn validate(query: &str, body: &Value) -> Result<(), String> {\n+    let objects: BTreeMap<_, _> = SCHEMA\n+        .definitions\n+        .iter()\n+        .filter_map(|d| match d {\n+            s::Definition::TypeDefinition(s::TypeDefinition::Object(o)) => {\n+                Some((o.name.as_str(), o))\n+            }\n+            _ => None,\n+        })\n+        .collect();\n+    let query = q::parse_query::<String>(query).map_err(|e| e.to_string())?;\n+    for definition in &query.definitions {\n+        let q::Definition::Operation(operation) = definition else {\n+            return Err(\"replay has no fragments\".into());\n+        };\n+        let (root, selection) = match operation {\n+            q::OperationDefinition::Query(v) => (\"Query\", &v.selection_set),\n+            q::OperationDefinition::Mutation(v) => (\"Mutation\", &v.selection_set),\n+            q::OperationDefinition::SelectionSet(v) => (\"Query\", v),\n+            _ => return Err(\"replay has no subscriptions\".into()),\n+        };\n+        selected(&objects, root, selection, &body[\"data\"])?;\n+    }\n+    Ok(())\n+}\n+fn selected(\n+    objects: &BTreeMap<&str, &s::ObjectType<'_, String>>,\n+    name: &str,\n+    selection: &q::SelectionSet<'_, String>,\n+    value: &Value,\n+) -> Result<(), String> {\n+    // A deleted document is returned null by the recorded service behavior even though\n+    // introspection declares Query.document non-null; live absence assertions require it.\n+    if value.is_null() {\n+        return Ok(());\n+    }\n+    let object = objects\n+        .get(name)\n+        .ok_or_else(|| format!(\"schema lacks {name}\"))?;\n+    for field in &selection.items {\n+        let q::Selection::Field(field) = field else {\n+            return Err(\"replay has no fragments\".into());\n+        };\n+        let definition = object\n+            .fields\n+            .iter()\n+            .find(|f| f.name == field.name)\n+            .ok_or_else(|| format!(\"schema lacks {name}.{}\", field.name))?;\n+        for (argument, _) in &field.arguments {\n+            if !definition.arguments.iter().any(|a| a.name == *argument) {\n+                return Err(format!(\"schema lacks {name}.{}({argument})\", field.name));\n+            }\n+        }\n+        let key = field.alias.as_ref().unwrap_or(&field.name);\n+        let value = value\n+            .get(key)\n+            .ok_or_else(|| format!(\"response lacks {name}.{key}\"))?;\n+        typed(\n+            objects,\n+            &definition.field_type,\n+            &field.selection_set,\n+            value,\n+            &format!(\"{name}.{key}\"),\n+        )?;\n+    }\n+    Ok(())\n+}\n+fn typed(\n+    objects: &BTreeMap<&str, &s::ObjectType<'_, String>>,\n+    kind: &s::Type<'_, String>,\n+    selection: &q::SelectionSet<'_, String>,\n+    value: &Value,\n+    path: &str,\n+) -> Result<(), String> {\n+    match kind {\n+        s::Type::NonNullType(inner) => {\n+            if value.is_null() && path != \"Query.document\" {\n+                return Err(format!(\"response null at required {path}\"));\n+            }\n+            typed(objects, inner, selection, value, path)\n+        }\n+        _ if value.is_null() => Ok(()),\n+        s::Type::ListType(inner) => {\n+            let array = value\n+                .as_array()\n+                .ok_or_else(|| format!(\"response non-list at {path}\"))?;\n+            for item in array {\n+                typed(objects, inner, selection, item, path)?;\n+            }\n+            Ok(())\n+        }\n+        s::Type::NamedType(name) if objects.contains_key(name.as_str()) => {\n+            selected(objects, name, selection, value)\n+        }\n+        s::Type::NamedType(name) => {\n+            let valid = match name.as_str() {\n+                \"Boolean\" => value.is_boolean(),\n+                \"Float\" => value.is_number(),\n+                \"Int\" => value.as_i64().is_some(),\n+                _ => value.is_string(),\n+            };\n+            if valid {\n+                Ok(())\n+            } else {\n+                Err(format!(\"response wrong scalar {name} at {path}\"))\n+            }\n+        }\n+    }\n+}\n+\n+#[test]\n+fn retained_ownership_fields_match_the_recorded_full_linear_schema() {\n+    let output = std::process::Command::new(\"python3\")\n+        .args([\n+            \"-c\",\n+            \"import gzip,sys; print(gzip.open(sys.argv[1], 'rt').read())\",\n+        ])\n+        .arg(concat!(\n+            env!(\"CARGO_MANIFEST_DIR\"),\n+            \"/../onetaskgraph-live-janitor/tests/fixtures/linear-upstream.graphql.gz\"\n+        ))\n+        .output()\n+        .expect(\"read existing pinned upstream schema\");\n+    assert!(output.status.success());\n+    let text = String::from_utf8(output.stdout).unwrap();\n+    let upstream = s::parse_schema::<String>(&text).unwrap();\n+    for (name, field_name) in [\n+        (\"Document\", \"team\"),\n+        (\"Project\", \"teams\"),\n+        (\"Team\", \"key\"),\n+        (\"TeamConnection\", \"pageInfo\"),\n+        (\"DocumentConnection\", \"pageInfo\"),\n+        (\"DocumentConnection\", \"nodes\"),\n+        (\"PageInfo\", \"hasNextPage\"),\n+        (\"PageInfo\", \"endCursor\"),\n+    ] {\n+        let field = |document: &s::Document<'_, String>| {\n+            let object = document\n+                .definitions\n+                .iter()\n+                .find_map(|d| match d {\n+                    s::Definition::TypeDefinition(s::TypeDefinition::Object(o))\n+                        if o.name == name =>\n+                    {\n+                        Some(o)\n+                    }\n+                    _ => None,\n+                })\n+                .unwrap();\n+            let field = object.fields.iter().find(|f| f.name == field_name).unwrap();\n+            (\n+                format!(\"{:?}\", field.field_type),\n+                field\n+                    .arguments\n+                    .iter()\n+                    .map(|a| (a.name.clone(), format!(\"{:?}\", a.value_type)))\n+                    .collect::<BTreeMap<_, _>>(),\n+            )\n+        };\n+        let (expected_type, expected_arguments) = field(&upstream);\n+        let (actual_type, actual_arguments) = field(&SCHEMA);\n+        assert_eq!(actual_type, expected_type, \"{name}.{field_name}\");\n+        for (argument, kind) in actual_arguments {\n+            assert_eq!(\n+                Some(&kind),\n+                expected_arguments.get(&argument),\n+                \"{name}.{field_name}({argument})\"\n+            );\n+        }\n+    }\n+}\n+\n+#[test]\n+fn response_guard_rejects_missing_required_fields_and_wrong_scalar_types() {\n+    let query = \"query($id:String!){document(id:$id){id title url}}\";\n+    assert!(\n+        validate(\n+            query,\n+            &serde_json::json!({\"data\":{\"document\":{\"id\":\"d\",\"title\":\"t\"}}})\n+        )\n+        .unwrap_err()\n+        .contains(\"url\")\n+    );\n+    assert!(validate(query, &serde_json::json!({\"data\":{\"document\":{\"id\":\"d\",\"title\":3,\"url\":\"https://example.test\"}}})).unwrap_err().contains(\"title\"));\n+}\n+\n+#[test]\n+fn response_guard_validates_discovery_pagination_before_wire_fault_injection() {\n+    let query =\n+        \"query { documents(first:100) { nodes { id } pageInfo { hasNextPage endCursor } } }\";\n+    let valid = serde_json::json!({\"data\":{\"documents\":{\"nodes\":[],\"pageInfo\":{\"hasNextPage\":true,\"endCursor\":\"1\"}}}});\n+    validate(query, &valid).expect(\"advancing cursor has the recorded wire types\");\n+    let mut missing = valid.clone();\n+    missing[\"data\"][\"documents\"]\n+        .as_object_mut()\n+        .unwrap()\n+        .remove(\"pageInfo\");\n+    assert!(validate(query, &missing).unwrap_err().contains(\"pageInfo\"));\n+    let mut malformed = valid;\n+    malformed[\"data\"][\"documents\"][\"pageInfo\"][\"hasNextPage\"] = serde_json::json!(\"yes\");\n+    assert!(validate(query, &malformed).unwrap_err().contains(\"Boolean\"));\n+}"},{"sha":"9480b450d1aa871fed7fd814f7ad964d5aa4da3f","filename":"crates/onetaskgraph-linear/tests/fixtures/README.md","status":"modified","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Ffixtures%2FREADME.md","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Ffixtures%2FREADME.md","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Ffixtures%2FREADME.md?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -334,3 +334,15 @@ the same published SDK schema (`packages/sdk/src/schema.graphql` in `linear/line\n documents the query as \"The user's organization.\" The resolution read selects that one id, so\n a source declared private is verified against the workspace its credential reaches inside the\n request a cold write already sends. That date is documentation-derived.\n+\n+The retained-document replay also reads `Document.team`, `Project.teams(first:,after:)`,\n+`Team.key` and `TeamConnection.pageInfo`. These additions to the subset come from the\n+existing pinned full upstream schema at\n+`crates/onetaskgraph-live-janitor/tests/fixtures/linear-upstream.graphql.gz`, whose\n+provenance is recorded beside it. The replay's\n+`retained_ownership_fields_match_the_recorded_full_linear_schema` reconciles their output\n+and argument types against that same artifact. Replay responses start from the recorded\n+`documents.json`, `projects.json`, `issues.json` and `comments.json` shapes and use synthetic\n+identifiers and content; every requested response field is checked against the subset\n+before HTTP delivery. Deliberately uncertain create acknowledgements are the explicit\n+malformed-response case, rather than accepted fixture shapes."},{"sha":"98153bb5d475676f21b0f237cfaf609a5975a166","filename":"crates/onetaskgraph-linear/tests/fixtures/schema.graphql","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Ffixtures%2Fschema.graphql","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Ffixtures%2Fschema.graphql","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Ffixtures%2Fschema.graphql?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -181,6 +181,7 @@ type Issue {\n   comments(before: String, last: Int, first: Int): CommentConnection!\n }\n type Project {\n+  teams(first: Int, after: String): TeamConnection!\n   id: ID!\n   name: String!\n   description: String\n@@ -199,6 +200,7 @@ type Project {\n # Organization, which is why this source reports a document's labels as none rather than\n # standing a slot up beside a first-class type.\n type Document {\n+  team: Team\n   id: ID!\n   title: String!\n   content: String\n@@ -286,10 +288,12 @@ type ProjectRelation {\n   relatedProject: Project\n }\n type Team {\n+  key: String!\n   id: ID!\n   states(first: Int): WorkflowStateConnection!\n }\n type TeamConnection {\n+  pageInfo: PageInfo!\n   nodes: [Team!]!\n }\n type WorkflowStateConnection {"},{"sha":"11de988ee0af742b5f68b5526fb1c68fad1b2680","filename":"crates/onetaskgraph-linear/tests/live.rs","status":"modified","additions":1561,"deletions":106,"changes":1667,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Flive.rs","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/3b6b228f168ab17c94613a831e1eec96a225d949/crates%2Fonetaskgraph-linear%2Ftests%2Flive.rs","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/crates%2Fonetaskgraph-linear%2Ftests%2Flive.rs?ref=3b6b228f168ab17c94613a831e1eec96a225d949","patch":"@@ -15,8 +15,10 @@\n //! `ONETASKGRAPH_LIVE_REQUIRED=1` and each of those skips becomes a failure naming the\n //! variable, so the required lane cannot pass green for want of a credential.\n //!\n-//! Everything it creates it deletes, whether its assertions passed or failed. It also\n-//! recovers what a run killed between its writes and its cleanup left behind — but only\n+//! Ordinary CI reuses three explicitly initialized, team-owned documents and their parent.\n+//! Daily fresh mode removes its disposable documents after exercising creation and deletion.\n+//! Invocation-owned local sets retire on cleanup. Both modes also recover what a run killed\n+//! between its writes and its cleanup left behind — but only\n //! artifacts the kernel says no live run owns, and only once its own journey is over. See\n //! [`sweep_orphans`].\n \n@@ -27,11 +29,14 @@ use onetaskgraph_live::{Credential, Exclusivity, Session, missing, required};\n use onetaskgraph_plugin_api::{\n     Capabilities, DependencyEdge, DependencyEndpoint, DependencyKind, DependencySupport, Direction,\n     Document, DocumentQuery, ItemKind, ItemWrite, Label, LabelFilter, Location, MetadataMatch,\n-    NativeId, PageRequest, Priority, Project, ProjectFilter, SecretResolver, SourceName,\n-    SourcePlugin, Status, StatusCategory, Support, Task, TaskQuery, TaskSource, TextFields,\n-    TextQuery,\n+    NativeId, PageRequest, Priority, Project, ProjectFilter, SecretResolver, SourceError,\n+    SourceName, SourcePlugin, Status, StatusCategory, Support, Task, TaskQuery, TaskSource,\n+    TextFields, TextQuery,\n };\n use secrecy::SecretString;\n+mod document_lifecycle;\n+use document_lifecycle::{Mode, Standing};\n+use onetaskgraph_linear::live_artifact::{Scope, Slot};\n use serde_json::{Value, json};\n \n struct Environment;\n@@ -70,9 +75,9 @@ use cleanup::{\n mod settle;\n \n use settle::{\n-    LINEAR_DOCUMENT_LISTING, LINEAR_INDEX, LINEAR_REPLICA, settled, settled_content,\n-    settled_document_absent, settled_documents, settled_label, settled_projects, settled_tasks,\n-    settled_walk, task_titles, token_moved, walked_task_titles,\n+    Bound, LINEAR_DOCUMENT_LISTING, LINEAR_INDEX, LINEAR_REPLICA, resolving_labels, settled,\n+    settled_content, settled_document_absent, settled_documents, settled_label, settled_projects,\n+    settled_tasks, settled_walk, task_titles, token_moved,\n };\n \n /// The two workflow states this fixture files its issues under.\n@@ -205,8 +210,22 @@ fn sorted(mut titles: Vec<String>) -> Vec<String> {\n     titles\n }\n \n+/// `write`, a task naming labels this run created, through [`resolving_labels`]: Linear's\n+/// label filter has answered such a label with no match on the plugin's own lookup a moment\n+/// after it answered it three times in a row to [`settled_label`], so the write is sent again\n+/// within `bound` while that is its refusal, and ends with that same refusal once `bound` is\n+/// spent rather than creating the label or dropping it.\n+async fn write_labelled_task(\n+    bound: Bound,\n+    source: &dyn TaskSource,\n+    write: &ItemWrite<Task>,\n+) -> Result<NativeId, SourceError> {\n+    resolving_labels(bound, || source.write_task(write)).await\n+}\n+\n /// Everything this lane needs to reach the one team it may write to.\n struct LiveRun {\n+    endpoint: String,\n     key: String,\n     /// Which run this is: the machine that can vouch for it and the process on it. Every\n     /// artifact below carries it, which is what its own cleanup finds them by and what a\n@@ -216,6 +235,14 @@ struct LiveRun {\n     open_state: String,\n     done_state: String,\n     project_status: String,\n+    document_mode: Mode,\n+    standing: Standing,\n+}\n+\n+impl LiveRun {\n+    async fn linear(&self, query: &str, variables: Value, _what: &str) -> Result<Value, String> {\n+        document_lifecycle::send(&self.endpoint, &self.key, query, variables).await\n+    }\n }\n \n /// Drives every field of the source's declared `Capabilities` against Linear's real API.\n@@ -239,7 +266,7 @@ async fn drive_every_declared_capability(\n     // for a while after that may answer it on one read and not the next.\n     for name in [&run_label, &only_label] {\n         settled_label(LINEAR_INDEX, name, |query, variables| {\n-            linear(&run.key, query, variables, \"live label lookup\")\n+            run.linear(query, variables, \"live label lookup\")\n         })\n         .await?;\n     }\n@@ -344,8 +371,10 @@ async fn drive_every_declared_capability(\n         })\n         .await\n         .map_err(|error| format!(\"live project write of {beta:?} failed: {error}\"))?;\n-    let first_id = source\n-        .write_task(&ItemWrite {\n+    let first_id = write_labelled_task(\n+        LINEAR_INDEX,\n+        source,\n+        &ItemWrite {\n             target: None,\n             item: task(\n                 &first,\n@@ -354,25 +383,32 @@ async fn drive_every_declared_capability(\n                 vec![label(&run_label), label(&only_label)],\n             ),\n             depends_on: vec![],\n-        })\n-        .await\n-        .map_err(|error| format!(\"live task write of {first:?} failed: {error}\"))?;\n-    let second_id = source\n-        .write_task(&ItemWrite {\n+        },\n+    )\n+    .await\n+    .map_err(|error| format!(\"live task write of {first:?} failed: {error}\"))?;\n+    let second_id = write_labelled_task(\n+        LINEAR_INDEX,\n+        source,\n+        &ItemWrite {\n             target: None,\n             item: task(&second, &open, Some(&beta_id), vec![label(&run_label)]),\n             depends_on: vec![blocks(&first_id, ItemKind::Task)],\n-        })\n-        .await\n-        .map_err(|error| format!(\"live task write of {second:?} failed: {error}\"))?;\n-    let orphan_id = source\n-        .write_task(&ItemWrite {\n+        },\n+    )\n+    .await\n+    .map_err(|error| format!(\"live task write of {second:?} failed: {error}\"))?;\n+    let orphan_id = write_labelled_task(\n+        LINEAR_INDEX,\n+        source,\n+        &ItemWrite {\n             target: None,\n             item: task(&orphan, &done, None, vec![label(&run_label)]),\n             depends_on: vec![],\n-        })\n-        .await\n-        .map_err(|error| format!(\"live task write of {orphan:?} failed: {error}\"))?;\n+        },\n+    )\n+    .await\n+    .map_err(|error| format!(\"live task write of {orphan:?} failed: {error}\"))?;\n \n     // Linear indexes a created issue before it answers a filtered query over it, so the\n     // reads below wait for the fixture rather than racing it — each one, through `settle`,\n@@ -552,24 +588,11 @@ async fn drive_every_declared_capability(\n     }\n \n     // Paging: a limit smaller than the result set walks to exhaustion, reaching every row\n-    // exactly once and in the order one whole page reports them. The walk is a listing like\n-    // the others and waits out the index the same way, so the order is compared over a set\n-    // the index has already caught up with rather than over a walk that raced it.\n+    // exactly once and in the order one whole page reports them. The walk and the page are\n+    // listings like the others and wait out the index together, so the order is compared over\n+    // a pair read once the index has caught up rather than over two reads that raced it.\n     let walk = \"a walk in pages of one over this run's own three issues\";\n     settled_walk(LINEAR_INDEX, source, &scoped(), 10, walk, &all_three).await?;\n-    let whole = source\n-        .query_tasks(&scoped(), &page(50))\n-        .await\n-        .map_err(|error| format!(\"live whole-page read failed: {error}\"))?\n-        .items\n-        .into_iter()\n-        .map(|task| task.title)\n-        .collect::<Vec<_>>();\n-    let walked = walked_task_titles(source, &scoped(), 10, walk).await?;\n-    ensure!(\n-        walked == whole,\n-        \"a walk in pages of one reached {walked:?} where one whole page reports {whole:?}\"\n-    );\n \n     // `max_page_size`: the source clamps a limit one above its declared ceiling to that\n     // ceiling instead of passing it on, so the read succeeds rather than being refused\n@@ -585,8 +608,7 @@ async fn drive_every_declared_capability(\n     // And that the ceiling itself is a page Linear really serves, rather than a number\n     // this source guessed at. What Linear does with one row *more* is its own business and\n     // is documented nowhere, so nothing here asserts on it.\n-    linear(\n-        &run.key,\n+    run.linear(\n         ISSUE_PAGE_PROBE,\n         json!({\"first\":ceiling}),\n         \"page size probe at the declared maximum\",\n@@ -614,8 +636,7 @@ async fn drive_every_declared_capability(\n         closed_back.status.category\n     );\n \n-    drive_documents(run, source, &alpha_id, &title(5), &title(6)).await?;\n-    drive_follow_ups(run, source, &title(7), &title(8), &title(9), &title(10)).await?;\n+    drive_document_paths(run, source, &alpha_id, None).await?;\n     // Renamed to another of this run's own titles, so the artifact cleanup still knows it.\n     every_field_change_moves_a_linear_tasks_token(\n         source,\n@@ -625,6 +646,52 @@ async fn drive_every_declared_capability(\n     .await\n }\n \n+/// The common document-mode entry used by the real capability lane and HTTP replay.\n+async fn drive_document_paths(\n+    run: &LiveRun,\n+    source: &dyn TaskSource,\n+    alpha_id: &NativeId,\n+    journal: Option<&document_lifecycle::journal::Journal>,\n+) -> Result<(), String> {\n+    let title = |offset: u64| artifact_title(run.id, run.stamp_micros + offset);\n+    let document_parent = run.standing.parent.as_ref().map(|id| NativeId(id.clone()));\n+    let document_parent = document_parent.as_ref().unwrap_or(alpha_id);\n+    let filed_title = run\n+        .standing\n+        .titles\n+        .get(\"filed\")\n+        .cloned()\n+        .unwrap_or_else(|| title(5));\n+    let loose_title = run\n+        .standing\n+        .titles\n+        .get(\"loose\")\n+        .cloned()\n+        .unwrap_or_else(|| title(6));\n+    if let Some(journal) = journal {\n+        journal.journey(\"drive_documents\");\n+    }\n+    drive_documents(run, source, document_parent, &filed_title, &loose_title).await?;\n+    let follow_up_title = run\n+        .standing\n+        .titles\n+        .get(\"follow-up\")\n+        .cloned()\n+        .unwrap_or_else(|| title(9));\n+    if let Some(journal) = journal {\n+        journal.journey(\"drive_follow_ups\");\n+    }\n+    drive_follow_ups(\n+        run,\n+        source,\n+        &title(7),\n+        &title(8),\n+        &follow_up_title,\n+        &title(10),\n+    )\n+    .await\n+}\n+\n /// A Linear task carries a `lin1` change token through every kind of change a copy has to see,\n /// and every change to a member the token covers moves it — to a later one, or to one never\n /// ordered beside the last — and what this lane learns along the way is printed as evidence.\n@@ -754,14 +821,17 @@ async fn every_field_change_moves_a_linear_tasks_token(\n         .await\n         .map_err(|error| format!(\"live dependency read failed: {error}\"))?\n         .items;\n-    source\n-        .write_task(&ItemWrite {\n+    write_labelled_task(\n+        LINEAR_INDEX,\n+        source,\n+        &ItemWrite {\n             target: Some(task.clone()),\n             item: labelled,\n             depends_on: edges,\n-        })\n-        .await\n-        .map_err(|error| format!(\"live label write failed: {error}\"))?;\n+        },\n+    )\n+    .await\n+    .map_err(|error| format!(\"live label write failed: {error}\"))?;\n     let after = token_moved(source, LINEAR_REPLICA, \"a label change\", &before, &read).await?;\n     note(\"a label change\", &before, &after);\n     before = after;\n@@ -833,8 +903,7 @@ async fn every_field_change_moves_a_linear_tasks_token(\n \n /// One issue's raw `d