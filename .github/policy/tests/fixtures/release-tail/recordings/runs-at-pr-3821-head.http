obertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"run_attempt":1,"referenced_workflows":[{"path":"nickderobertis/screencomp/.github/workflows/visual-docs-reusable.yml@v0.4.8","sha":"00e7badc530176605bc6bca25391559a034d3ccf","ref":"refs/tags/v0.4.8"}],"run_started_at":"2026-10-30T02:15:15Z","triggering_actor":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/actions/runs/40990601117/jobs","logs_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/actions/runs/40990601117/logs","check_suite_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/check-suites/111115147250","artifacts_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/actions/runs/40990601117/artifacts","cancel_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/actions/runs/40990601117/cancel","rerun_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/actions/runs/40990601117/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/actions/workflows/366262900","head_commit":{"id":"0c9fa8c795e01faacd6465e9b25fe4ba17773906","tree_id":"0eaa478f21875aa90464ab53119def45e6d7e218","message":"test(linear): keep the asset replay double's connections alive at both ends\n\nThe offline Linear asset workspace answered every request `Connection: close`\nand forwarded each one over a fresh connection to the backend, so every\nrequest cost two loopback connections. This branch routes its standing-set\nreplay journeys through that double, in the same process as the rest of the\nLinear e2e suite, and the Windows check then failed `cache_budget` with\n`error sending request` against a loopback that was listening — the failure\nAGENTS.md attributes to loopback port pressure on that runner. Serve it with\n`loopback::serve_each` and forward through one `loopback::Upstream` per client\nconnection, as AGENTS.md prescribes; the credentialed live observer is\nunchanged.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","timestamp":"2026-10-30T02:11:52Z","author":{"name":"Nick DeRobertis","email":"19440155+nickderobertis@users.noreply.github.com"},"committer":{"name":"Nick DeRobertis","email":"19440155+nickderobertis@users.noreply.github.com"}},"repository":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/nickderobertis/onetaskgraph","description":"Unified SDK and CLI for project-management ticketing systems: a Rust core with a plugin interface, Python and TypeScript wrappers, and pluggable task sources (local Markdown, Linear, GitHub Projects, in-memory).","fork":false,"url":"https://api.github.com/repos/nickderobertis/onetaskgraph","forks_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/forks","keys_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/keys{/key_id}","collaborators_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/collaborators{/collaborator}","teams_url":"https:/