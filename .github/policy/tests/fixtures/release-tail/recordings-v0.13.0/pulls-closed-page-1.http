_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3788"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3788"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3788"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3788/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3788/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3788/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/4df989bac40cb2049286a05487c054bb3987361a"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3783","id":5037039301,"node_id":"PR_kwDOUBBgxs8AAAABLDsexQ","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3783","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3783.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3783.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3783","number":3783,"state":"closed","locked":false,"title":"fix(linear): keep a private home's public projections through a copy's follow-up write","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nCopy follow-up writes now preserve metadata changes made by intervening writes, including additions, updates and removals. Private Linear plan homes retain their public projection records after Markdown normalization, using the same mechanism for member and dependent records.\n\nFixes [#3781](https://github.com/nickderobertis/onetaskgraph/issues/3781).\n\n## Why\n\nThe host’s switch from PyPI to npm adopts an engine that requires a plan-store version affected by this regression. This fix enables adoption alongside the upstream npm launcher fixes, so the host can retire both its local launcher workaround and the regression’s expected-failure marker together.","created_at":"2026-10-27T15:59:07Z","updated_at":"2026-10-27T18:19:27Z","closed_at":"2026-10-27T18:19:24Z","merged_at":"2026-10-27T18:19:24Z","merge_commit_sha":"018a4b614502d4490f6f40d14a5d2065b14963a3","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3783/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3783/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3783/comments