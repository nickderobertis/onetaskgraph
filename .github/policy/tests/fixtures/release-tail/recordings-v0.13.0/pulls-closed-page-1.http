thub.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3631","id":4873575616,"node_id":"PR_kwDOUBBgxs8AAAABInzcwA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3631","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3631.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3631.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3631","number":3631,"state":"closed","locked":false,"title":"chore: clear leftover items from the live test board","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nSwitch judged lint from `gpt-5.5` to `gpt-6.1-sol` and align the accompanying model references. Fallback entries and all other harness settings remain unchanged.\n\n## Why\n\nThe macOS CI budget rollout was blocked by Linux and Windows checks finding 91 items on the shared live board, above the journey’s 90-item ceiling. The accompanying lint requirement adopts `gpt-6.1-sol` without loosening the journey’s workload bounds.\n\n## Additional info\n\nThe board already held 58 items and 14 fields when inspected, following successful scheduled [live janitor runs](https://github.com/nickderobertis/onetaskgraph/actions/runs/38720429404). No additional residue was removed or fields changed. `real_projects_v2_contract_writes_and_leaves_no_residue` subsequently passed; the board still held 58 items and 14 fields afterward.","created_at":"2026-10-15T12:53:58Z","updated_at":"2026-10-15T13:53:29Z","closed_at":"2026-10-15T13:53:26Z","merged_at":"2026-10-15T13:53:26Z","merge_commit_sha":"a7dbf6936704063a4577f49ecea24c8e6ca2a4a5","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3631/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3631/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3631/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/63314d9ee8e05295b1599932e8b3ab7e78fac4ce","head":{"label":"nickderobertis:nick/Every-repository-spends-at-most-one-macOS-job-per-run-and-two-per-change/onetaskgraph-live-board-cleanup","ref":"nick/Every-repository-spends-at-most-one-macOS-job-per-run-and-two-per-change/onetaskgraph-live-board-cleanup","sha":"63314d9ee8e05295b1599932e8b3ab7e78fac4ce","user":{"login":"nickderobertis",