v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3749","id":5002028377,"node_id":"PR_kwDOUBBgxs8AAAABKiTlWQ","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3749","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3749.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3749.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3749","number":3749,"state":"closed","locked":false,"title":"perf(copy): remove redundant screening and hosted reads","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nReduce GitHub requests for plan copies and guarded design approvals through batched writes, bounded placement polling and shared reads. Screen planned exposures together before mutation, reuse screening only within the command, and report withheld private dependencies without contacting unrelated private sources.\n\nExtend existing journeys and quota budgets to cover screened and unscreened operations, delayed placement, concurrent copies and malformed member listings requiring full classification reads. Make loopback placement and search-wait tests independent of host timing and tolerate client connection resets.\n\n## Why\n\nPlan revisions and approvals should finish quickly while preserving the public write boundary and the GitHub allowance shared by every session.","created_at":"2026-10-25T05:11:48Z","updated_at":"2026-10-25T14:33:43Z","closed_at":"2026-10-25T14:33:41Z","merged_at":"2026-10-25T14:33:41Z","merge_commit_sha":"cde14c4fc88914b67adc09131b2d35e66470d805","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3749/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3749/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobe