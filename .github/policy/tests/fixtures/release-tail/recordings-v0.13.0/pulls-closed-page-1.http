ations_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/labels{/name}","releases_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/releases{/id}","deployments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/deployments","created_at":"2026-08-23T00:02:56Z","updated_at":"2026-10-31T23:21:48Z","pushed_at":"2026-11-01T00:47:19Z","git_url":"git://github.com/nickderobertis/onetaskgraph.git","ssh_url":"git@github.com:nickderobertis/onetaskgraph.git","clone_url":"https://github.com/nickderobertis/onetaskgraph.git","svn_url":"https://github.com/nickderobertis/onetaskgraph","homepage":null,"size":16538,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3715"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3715"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3715"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3715/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3715/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3715/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/37f153703b51125217a5dee20d9501e52e5fb912"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3713","id":4957842253,"node_id":"PR_kwDOUBBgxs8AAAABJ4KrTQ","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3713","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3713.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3713.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3713","number":3713,"state":"closed","locked":false,"title":"feat(engine): read the image assets a task holds","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nAdd `Engine::task_assets` to return a task’s held image names and bytes, and `onetaskgraph task assets <SOURCE:ID> --output-dir <DIR>` to export them through the source’s existing asset reads. JSON output lists the names written; Python and TypeScript SDKs expose the command. Tasks holding no assets return an empty list, while missing tasks and unreadable sources fail with the qualified id and reason.\n\n## Why\n\nA task added to a running plan can fail write-back with `asset-not-held` even when its authoring task holds the referenced diagram. This supplies the public read needed by `op-live-add-images` for [onepipeline#805](https://github.com/nickderobertis/onepipeline/issues/805), without coupling it to a plugin’s storage layout.\n\n## Additional info\n\nThe API is additive, preserves existing public type shapes, and leaves copy targeting and scopes unchanged. Schema bundle 43 registers the new response. The SDK rendered-test parent-project fixture repairs are retained.\n\nExports replace matching files. A later filesystem failure can leave earlier files exported, but does not print a success list.\n\nRecorded verification for finished commit `1f68dee2` is retained in the [completion report](/home/whoop/ai-orchestrator/runs/Verify--then-resolve--every-accepted-non-crozier-follow-up-ticket/scratch/2919970-77/completion.md) and its adjacent logs:\n\n| Acceptance criterion | Recorded evidence |\n| --- | --- |\n| Local-md CLI exports two images byte-for-byte under their reference names, exact JSON names, empty and missing cases | `cli-assets.log`: 31 asset journeys passed, including export failure and recovery paths. |\n| GitHub Projects uploaded-image read | `github-assets.log`: 18 asset journeys passed, including the loopback-board task-assets journey checking uploaded bytes, names, empty and missing cases. |\n| Public Rust read and actionable failures | `core-assets.log`: 15 tests passed, covering names and bytes, empty results, assetless plugins, missing tasks, unreadable/unavailable sources, fetch failures and unreferenced held images. CLI journeys cover matching failures. |\n| Additive public API | `cargo semver-checks -p onetaskgraph-core --all-features --baseline-rev v0.9.2`: 196 checks passed, 58 skipped; no semver update required (`semver.log`). |\n| Touched behavior and repaired schema expectations | Core schema: 1 passed; binary schema: 1 passed; CLI surface: 25 passed; no-persistence: 1 passed; Python rendered/artifact: 13 passed; TypeScript client/rendered: 56 passed with an empty `XDG_CONFIG_HOME`. Windows-sensitive assertions ran on Linux; no Windows execution is claimed. |\n| Format, lint and type checks | Rust fmt, clippy with warnings denied, and cargo check passed for the four changed crates. Python Ruff format/check and ty passed; TypeScript Biome format/lint and tsc passed. Both SDK generation checks and `git diff --check` passed. |\n| Judged lint against the branch base | `just lint-llm-diff origin/main` passed: history `20261021T231732Z-50e7f`, 23 rules passed, 0 failed, 24 skipped, 9 not relevant. History `20261021T231527Z-bc22d` found the schema suppression covered a comment instead of the registration; `1f68dee2` corrected that site. Neither attempt was a harness/no-verdict error. |\n| Evidence matches the finished tree | The recorded verification covers `1f68dee2`; the worktree is clean. No complete downstream gate or live API suite is claimed. |\n\nEarlier verification of `927f9067da7fd4b5e7a91c05ccb1b0e8101f08a9` against base `d4b6124ef46d816e91f16ab8cab97dd947b01f0e` remains in [verification logs](/home/whoop/ai-orchestrator/runs/Verify--then-resolve--every-accepted-non-crozier-follow-up-ticket/scratch/2919970-70/verification/): core assets 15, CLI assets 31, core schema 1, CLI unit 8, CLI surface 25, no-persistence 1, Python 13 and isolated TypeScript 56 passed, alongside the GitHub task-assets loopback journey and static/generation checks. Its patch-level semver run reported 223 passed and 31 skipped; judged lint history `20261021T211834Z-b239c` reported 20 passed, 0 failed, 24 skipped and 12 not relevant. These are earlier-tree results, superseded above where applicable.\n\nThe initial TypeScript runs inherited host-local configuration and reported 49 passed / 7 failed; the same modules passed all 56 tests with an empty `XDG_CONFIG_HOME`. SDK test isolation is tracked in follow-up `drafts:Verify--then-resolve--every-accepted-non-crozier-follow-up-ticket/drafts/20261021T212446Z-isolate-the-user-config-layer-in-typescript-sdk`.\n\nSuppressions added or covering changed lines:\n\n- `crates/onetaskgraph-core/src/schema.rs:259`: `code_lands_in_the_domain_that_owns_it` permits central registration for SDK discovery while the response type remains in its owning domain; the versioned golden tracks registration.\n- `crates/onetaskgraph/src/cli.rs`, `TaskAssetsArgs.id`: `invalid_states_unrepresentable` retains the existing qualified-id parser and actionable diagnostics before any read.\n- `sdks/python/src/onetaskgraph_sdk/_generated/task_asset_names.py:1`: generated `ruff: noqa: E501` preserves schema descriptions under the generator’s existing convention.\n- `sdks/python/tests/test_artifact.py:241`: the existing `async_typed_clients_at_boundaries` block covers a synchronous subprocess reading a build artifact, with no service or overlapping requests.","created_at":"2026-10-21T20:22:41Z","updated_at":"2026-10-22T06:14:03Z","closed_at":"2026-10-22T06:14:01Z","merged_at":"2026-10-22T06:14:00Z","merge_commit_sha":"51c5f2b327a1bfd3c0ac99c3fcb7294ee58fdf1f","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3713/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3713/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3713/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/38042622c8ef34f486fbfdc1017980910e56984f","head":{"label":"nickderobertis:nick/3707/otg-task-images","ref":"nick/3707/otg-task-images","sha":"38042622c8ef34f486fbfdc1017980910e56984f","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobe