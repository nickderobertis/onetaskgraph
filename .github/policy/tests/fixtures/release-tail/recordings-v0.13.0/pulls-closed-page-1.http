ickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3776","id":5026970342,"node_id":"PR_kwDOUBBgxs8AAAABK6F65g","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3776","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3776.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3776.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3776","number":3776,"state":"closed","locked":false,"title":"perf(sdk): build only the generated models a process uses","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nLoad Python SDK model modules only when their exports or Client responses are first used, reducing startup and interpreter-exit CPU while preserving public imports, class identity, typing, signatures and validation behaviour. Add compatibility tests and an uncached host import budget; TypeScript is unchanged.\n\n## Why\n\nShort-lived SDK consumers currently pay to build roughly 700 model classes even when they use only a few. That adds about a second of CPU to copying, approving, checking, reviewing and launching plans. Loading only the models needed shortens that wait for every Python SDK consumer.\n\n## Additional info\n\nOn this host, 15 interleaved runs per tree measured import, CopyReport validation and normal exit at **0.367 s median** (IQR 0.346–0.376) on `8367b86d`, versus **1.428 s** (IQR 1.378–1.489) at base `0884f8a7`: a **74.3% reduction**. Load averages moved from 29.45 / 34.84 / 42.78 to 27.03 / 33.45 / 41.93 during the comparison. The subsequent change only makes the measurement script’s POSIX restriction explicit to Windows type checking; SDK runtime code is unchanged.\n\nThe separate host budget run measured 0.3677 s, slightly above the 0.35 s threshold. Host-variable overruns warn in `budgets-host`; direct onebudgetspec checks remain strict. The target is uncached and outside per-change checks.","created_at":"2026-10-27T01:02:07Z","updated_at":"2026-10-27T02:42:32Z","closed_at":"2026-10-27T02:42:30Z","merged_at":"2026-10-27T02:42:30Z","merge_commit_sha":"391184b30ccc38d546251739ace4446efa8b83f7","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3776/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3776/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3776/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/fc6b981daedd0887ce6edbea0c0dbae86d2b3dc1","head":{"label":"nickderobertis:nick/3774/otg-sdk-lazy-models","ref":"nick/3774/otg-sdk-lazy-models","sha":"fc6b981daedd0887ce6edbea0c0dbae86d2b3dc1","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/n