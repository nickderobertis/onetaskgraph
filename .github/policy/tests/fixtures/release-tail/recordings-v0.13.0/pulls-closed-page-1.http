b.com/repos/nickderobertis/onetaskgraph/releases{/id}","deployments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/deployments","created_at":"2026-08-23T00:02:56Z","updated_at":"2026-10-31T23:21:48Z","pushed_at":"2026-11-01T00:47:19Z","git_url":"git://github.com/nickderobertis/onetaskgraph.git","ssh_url":"git@github.com:nickderobertis/onetaskgraph.git","clone_url":"https://github.com/nickderobertis/onetaskgraph.git","svn_url":"https://github.com/nickderobertis/onetaskgraph","homepage":null,"size":16538,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3679"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3679"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3679"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3679/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3679/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3679/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/e2c94d52613f3fb3ea6d5f9464bac7d8357d2923"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3686","id":4928568305,"node_id":"PR_kwDOUBBgxs8AAAABJcP78Q","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3686","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3686.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3686.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3686","number":3686,"state":"closed","locked":false,"title":"chore: release v0.9.0","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.8.0 -> 0.9.0\n* `onetaskgraph-github-projects`: 0.8.0 -> 0.9.0\n* `onetaskgraph-in-memory`: 0.8.0 -> 0.9.0\n* `onetaskgraph-linear`: 0.8.0 -> 0.9.0\n* `onetaskgraph-local-md`: 0.8.0 -> 0.9.0\n* `onetaskgraph-core`: 0.8.0 -> 0.9.0\n* `onetaskgraph`: 0.8.0 -> 0.9.0\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n## [0.9.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.8.0...onetaskgraph-plugin-api-v0.9.0) - 2026-10-19\n\n### Added\n\n- *(status)* [**breaking**] move a project item with its issue's closure and set a project's status ([#3681](https://github.com/nickderobertis/onetaskgraph/pull/3681))\n</blockquote>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.9.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.8.0...onetaskgraph-github-projects-v0.9.0) - 2026-10-19\n\n### Added\n\n- *(status)* [**breaking**] move a project item with its issue's closure and set a project's status ([#3681](https://github.com/nickderobertis/onetaskgraph/pull/3681))\n</blockquote>\n\n## `onetaskgraph-in-memory`\n\n<blockquote>\n\n## [0.9.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-in-memory-v0.8.0...onetaskgraph-in-memory-v0.9.0) - 2026-10-19\n\n### Added\n\n- *(status)* [**breaking**] move a project item with its issue's closure and set a project's status ([#3681](https://github.com/nickderobertis/onetaskgraph/pull/3681))\n</blockquote>\n\n## `onetaskgraph-linear`\n\n<blockquote>\n\n## [0.9.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-linear-v0.8.0...onetaskgraph-linear-v0.9.0) - 2026-10-19\n\n### Added\n\n- *(status)* [**breaking**] move a project item with its issue's closure and set a project's status ([#3681](https://github.com/nickderobertis/onetaskgraph/pull/3681))\n</blockquote>\n\n## `onetaskgraph-local-md`\n\n<blockquote>\n\n## [0.9.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-local-md-v0.8.0...onetaskgraph-local-md-v0.9.0) - 2026-10-19\n\n### Added\n\n- *(status)* [**breaking**] move a project item with its issue's closure and set a project's status ([#3681](https://github.com/nickderobertis/onetaskgraph/pull/3681))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.9.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.8.0...onetaskgraph-core-v0.9.0) - 2026-10-19\n\n### Added\n\n- *(status)* [**breaking**] move a project item with its issue's closure and set a project's status ([#3681](https://github.com/nickderobertis/onetaskgraph/pull/3681))\n</blockquote>\n\n## `onetaskgraph`\n\n<blockquote>\n\n## [0.9.0](https://github.com/nickderobertis/onetaskgraph/compare/v0.8.0...v0.9.0) - 2026-10-19\n\n### Added\n\n- *(status)* [**breaking**] move a project item with its issue's closure and set a project's status ([#3681](https://github.com/nickderobertis/onetaskgraph/pull/3681))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-19T23:04:21Z","updated_at":"2026-10-20T00:34:08Z","closed_at":"2026-10-20T00:34:07Z","merged_at":"2026-10-20T00:34:07Z","merge_commit_sha":"3dd40e93f03d5b1855f6ba6e9c2636451a8d5edb","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3686/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3686/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3686/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/12a7e6fecff5268338fa282fb9fe74c3a242f37e","head":{"label":"nickderobertis:release-plz-2026-10-19T23-04-18Z","ref":"release-plz-2026-10-19T23-04-18Z","sha":"12a7e6fecff5268338fa282fb9fe74c3a242f37e","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickder