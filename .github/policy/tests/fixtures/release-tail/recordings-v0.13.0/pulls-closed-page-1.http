onetaskgraph/issues/3647"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3647/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3647/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3647/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/baf023e92c47d2c9ccc8722bcdcb842ec3797c02"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3802","id":5049818964,"node_id":"PR_kwDOUBBgxs8AAAABLP4fVA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3802","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3802.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3802.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3802","number":3802,"state":"closed","locked":false,"title":"fix(deps): move pulldown-cmark past the wikilink event-growth advisory","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nRaise the `pulldown-cmark` minimum to 0.13.5 for `onetaskgraph-core` and `onetaskgraph-plugin-api`, and update the lockfile to match, excluding releases affected by RUSTSEC-2026-0414 from consumer resolution.\n\n## Why\n\nThe host engine links these crates, and the advisory blocks required dependency audits on pull requests to both the engine and this workspace.\n\n## Additional info\n\nNeither Markdown parser enables wikilinks: `crates/onetaskgraph-plugin-api/src/asset.rs:473` and `crates/onetaskgraph-core/src/engine/copy/projections.rs:448` both use `Options::empty()`. Both parse user-supplied content, but neither enables `ENABLE_WIKILINKS` or `Options::all()`, so these paths are not exposed to the vulnerability described in [RUSTSEC-2026-0414](https://rustsec.org/advisories/RUSTSEC-2026-0414). This addresses the dependency audit without changing Markdown options.","created_at":"2026-10-28T11:37:06Z","updated_at":"2026-10-28T15:05:39Z","closed_at":"2026-10-28T15:05:36Z","merged_at":"2026-10-28T15:05:36Z","merge_commit_sha":"d508ca6ee2da05ef80b905e2d50d7fe2f5a498c0","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3802/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3802/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3802/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/5ceda7952a7abeaf980d9d3f2e543ca63f3c61fa","head":{"label":"nickderobertis:nick/npm-e