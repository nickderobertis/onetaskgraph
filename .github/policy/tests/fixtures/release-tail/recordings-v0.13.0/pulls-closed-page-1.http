icense","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3609"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3609"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3609"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3609/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3609/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3609/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/9b0d6ad6773bacd6075344c1f17b427661b596f1"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3600","id":4836166240,"node_id":"PR_kwDOUBBgxs8AAAABIEIKYA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3600","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3600.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3600.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3600","number":3600,"state":"closed","locked":false,"title":"chore: release v0.6.1","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-github-projects`: 0.6.0 -> 0.6.1\n* `onetaskgraph-local-md`: 0.6.0 -> 0.6.1\n* `onetaskgraph-core`: 0.6.0 -> 0.6.1\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.6.1](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.6.0...onetaskgraph-github-projects-v0.6.1) - 2026-10-14\n\n### Performance\n\n- *(github-live)* keep the complete live lane below 300 GraphQL points ([#3604](https://github.com/nickderobertis/onetaskgraph/pull/3604))\n</blockquote>\n\n## `onetaskgraph-local-md`\n\n<blockquote>\n\n## [0.6.1](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-local-md-v0.6.0...onetaskgraph-local-md-v0.6.1) - 2026-10-14\n\n### Fixed\n\n- *(deps)* read and write task YAML with serde-saphyr in place of serde_norway ([#3607](https://github.com/nickderobertis/onetaskgraph/pull/3607))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.6.1](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.6.0...onetaskgraph-core-v0.6.1) - 2026-10-14\n\n### Fixed\n\n- *(deps)* read and write task YAML with serde-saphyr in place of serde_norway ([#3607](https://github.com/nickderobertis/onetaskgraph/pull/3607))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-12T23:24:09Z","updated_at":"2026-10-14T05:56:49Z","closed_at":"2026-10-14T05:56:47Z","merged_at":"2026-10-14T05:56:47Z","merge_commit_sha":"3f68c9deb9668bfe033e1aa1da66272f27aa46d0","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3600/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3600/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3600/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/0dec39d9c5d33b1b47ec9401ba57e2ca03975a63","head":{"label":"nickderobertis:release-plz-0.6.1","ref":"release-plz-0.6.1","sha":"0dec39d9c5d33b1b47ec9401ba57e2ca03975a63","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderob