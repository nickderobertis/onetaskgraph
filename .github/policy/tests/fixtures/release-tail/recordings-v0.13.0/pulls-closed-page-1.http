api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3607","id":4851023256,"node_id":"PR_kwDOUBBgxs8AAAABISS9mA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3607","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3607.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3607.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3607","number":3607,"state":"closed","locked":false,"title":"fix(deps): read and write task YAML with serde-saphyr in place of serde_norway","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nReplace `serde_norway` with `serde-saphyr` throughout YAML handling, upgrade onebudgetspec to 0.1.5, and ban all seven libyaml-derived crates. Preserve existing store reads, local Markdown formatting, template prompt order and JSON key order, with regression fixtures covering redacted store records, labelled tasks and 28 templates.\n\n## Why\n\nEvery plan and task passes through this engine. Removing the unmaintained unsafe libyaml translation flagged by RUSTSEC-2024-0449 moves YAML handling to safe Rust while protecting long-lived user files from unintended changes on their next write.\n\n## Additional info\n\nOne accepted formatting difference remains: a colon-containing mapping key gains quotes on rewrite without changing its meaning. Answers printed as YAML use serde-saphyr’s native formatting; stored answers retain compatibility formatting. `--var` continues to reject trailing text and multiple YAML documents.","created_at":"2026-10-14T00:00:49Z","updated_at":"2026-10-14T04:59:48Z","closed_at":"2026-10-14T04:59:45Z","merged_at":"2026-10-14T04:59:45Z","merge_commit_sha":"ae31d466406e39caa0fe0efe8bb6e0b25077e285","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3607/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3607/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3607/comments","stat