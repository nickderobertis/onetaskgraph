api.github.com/repos/nickderobertis/onetaskgraph/issues/3802"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3802/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3802/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3802/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/5ceda7952a7abeaf980d9d3f2e543ca63f3c61fa"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3794","id":5046289660,"node_id":"PR_kwDOUBBgxs8AAAABLMhE_A","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3794","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3794.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3794.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3794","number":3794,"state":"closed","locked":false,"title":"chore: release v0.12.9","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.12.8 -> 0.12.9\n* `onetaskgraph-github-projects`: 0.12.8 -> 0.12.9\n* `onetaskgraph-local-md`: 0.12.8 -> 0.12.9\n* `onetaskgraph-core`: 0.12.8 -> 0.12.9\n* `onetaskgraph`: 0.12.8 -> 0.12.9\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n## [0.12.9](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.12.8...onetaskgraph-plugin-api-v0.12.9) - 2026-10-28\n\n### Added\n\n- *(locate)* answer where an item lands, its counterpart and its issue's repository ([#3791](https://github.com/nickderobertis/onetaskgraph/pull/3791))\n</blockquote>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.12.9](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.12.8...onetaskgraph-github-projects-v0.12.9) - 2026-10-28\n\n### Added\n\n- *(locate)* answer where an item lands, its counterpart and its issue's repository ([#3791](https://github.com/nickderobertis/onetaskgraph/pull/3791))\n</blockquote>\n\n## `onetaskgraph-local-md`\n\n<blockquote>\n\n## [0.12.9](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-local-md-v0.12.8...onetaskgraph-local-md-v0.12.9) - 2026-10-28\n\n### Fixed\n\n- *(store)* accept a path inside the configured root on Windows whatever its spelling ([#3793](https://github.com/nickderobertis/onetaskgraph/pull/3793))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.12.9](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.12.8...onetaskgraph-core-v0.12.9) - 2026-10-28\n\n### Added\n\n- *(locate)* answer where an item lands, its counterpart and its issue's repository ([#3791](https://github.com/nickderobertis/onetaskgraph/pull/3791))\n</blockquote>\n\n## `onetaskgraph`\n\n<blockquote>\n\n## [0.12.9](https://github.com/nickderobertis/onetaskgraph/compare/v0.12.8...v0.12.9) - 2026-10-28\n\n### Added\n\n- *(locate)* answer where an item lands, its counterpart and its issue's repository ([#3791](https://github.com/nickderobertis/onetaskgraph/pull/3791))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-28T06:36:08Z","updated_at":"2026-10-28T09:26:03Z","closed_at":"2026-10-28T09:26:01Z","merged_at":"2026-10-28T09:26:01Z","merge_commit_sha":"540c5983ce8af9d1d6570db5ff394af611a8a256","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3794/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3794/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3794/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/ef03a5a4fb64d04aab798d69c834049abdba8fba","head":{"label":"nickderobertis:release-plz-2026-10-28T06-36-05Z","ref":"release-plz-2026-10-28T06-36-05Z","sha":"ef03a5a4fb64d04aab798d69c834049abdba8fba","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.gith