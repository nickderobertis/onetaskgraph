:"git@github.com:nickderobertis/onetaskgraph.git","clone_url":"https://github.com/nickderobertis/onetaskgraph.git","svn_url":"https://github.com/nickderobertis/onetaskgraph","homepage":null,"size":16538,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3811"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3811"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3811"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3811/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3811/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3811/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/6c344077bfb0f5695c7e0ae3ba550fffb5521b0f"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3647","id":4906459104,"node_id":"PR_kwDOUBBgxs8AAAABJHKf4A","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3647","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3647.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3647.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3647","number":3647,"state":"closed","locked":false,"title":"ci!: release onetaskgraph per platform","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nRelease onetaskgraph through six CD jobs: `release-plz`, `build-linux`, `build-linux-arm64`, `build-macos`, `build-windows` and `publish`, each with a 30-minute timeout. Each platform builds one binary for its archive, wheel and npm package, test-installs those files, publishes them, then installs and runs them from the registries. The final `publish` job waits for all four platforms before publishing crates, SDKs and the npm launcher.\n\nThe release PR automatically merges once required checks pass; a refused auto-merge request fails visibly.\n\n## Why\n\nShorten the release tail and free shared job slots by avoiding repeated binary builds, a full test re-run of code CI already passed, and a separate workflow repeating install checks. Each platform now owns its build, publication and install verification.\n\n## Additional info\n\n- Linux x64 and **Linux arm64 remain supported**, with arm64 built natively on `ubuntu-24.04-arm`. macOS releases remain Apple Silicon only; Intel macOS users are directed to `cargo install onetaskgraph`. Windows x64 remains supported.\n- **Package contents change:** `@onetaskgraph/sdk` includes its built `dist/` starting with the next release. Its name, version scheme, registry and target set stay unchanged.\n- Crate publication retains Cargo’s full packaging verification.\n- If a platform job fails, other platforms’ artifacts remain published while crates, SDKs and the launcher remain unpublished until a successful re-run. Publication skips artifacts already present.\n- Updates `pulldown-cmark` from 0.13.4 to 0.13.5 to address RUSTSEC-2026-0414, which caused the [required `deny` check failure](https://github.com/nickderobertis/onetaskgraph/actions/runs/40698041238/job/122849976722). The same lockfile update is also proposed in [#3802](https://github.com/nickderobertis/onetaskgraph/pull/3802).","created_at":"2026-10-18T04:50:10Z","updated_at":"2026-10-28T16:38:17Z","closed_at":"2026-10-28T16:38:15Z","merged_at":"2026-10-28T16:38:15Z","merge_commit_sha":"057b6c30b35314d1c2a70daef1feec3f5b14ef67","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3647/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3647/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3647/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/baf023e92c47d2c9ccc8722bcdcb842ec3797c02","head":{"label":"nickderobertis:nick/3634/onetaskgraph-cd-reshape","ref":"nick/3634/onetaskgraph-cd-reshape","sha":"baf023e92c47d2c9ccc8722bcdcb842ec3797c02","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/