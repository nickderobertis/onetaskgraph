robertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3809","id":5054973765,"node_id":"PR_kwDOUBBgxs8AAAABLUzHRQ","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3809","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3809.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3809.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3809","number":3809,"state":"closed","locked":false,"title":"fix(linear): send no write when an unchanged plan is copied again","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake unchanged plan copies into Linear send no writes after the first copy, keeping provenance and copy versions stable despite Linear’s Markdown rewrites. Editing one task updates only that task and preserves its unchanged dependency links.\n\n## Why\n\nThe orchestration host repeatedly copies private plans after reviews, completion and design approval. Unnecessary writes spend Linear’s API quota, notify followers and churn dependency links even when the visible content is unchanged.\n\n## Additional info\n\nPublic interfaces and data shapes are unchanged. Items copied with the old fingerprints may need one refresh before subsequent copies stabilize.","created_at":"2026-10-28T17:38:47Z","updated_at":"2026-10-29T15:54:08Z","closed_at":"2026-10-29T15:54:05Z","merged_at":"2026-10-29T15:54:05Z","merge_commit_sha":"e01115356673d76d2bfc65159d742c1186a85d4f","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3809/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3809/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3809/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/710b6066ec70cb1e9e207c30ad263e2ca954c6c9","head":{"label":"nickderobertis:nick/linear-stored-content-verification/otg-recopy-zero-write","ref":"nick/linear-stored-content-verification/otg-recopy-zero-write","sha":"710b6066ec70cb1e9e207c30ad263e2ca954c6c9","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/nickderobertis/onetaskgraph","description":"Unified SDK and CLI for project-management ticketing systems: a Rust core with a plugin interface, Python and TypeScript wrappers, and pluggable task sources (local Markdown, Linear, GitHub Projects, in-memory).","fork":false,"url":"https://api.github.com/repos/nickderobertis/onetaskgraph","forks_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/forks","keys_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/keys{/key_id}","collaborators_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/teams","hooks_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/hooks","issue_events_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/events{/number}","events_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/events","assignees_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/assignees{/user}","branches_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/branches{/branch}","tags_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/tags","blobs_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/refs{/sha}","trees_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/git/trees{/sha}","statuses_url":"https://api.github.com/repos/nickderobertis