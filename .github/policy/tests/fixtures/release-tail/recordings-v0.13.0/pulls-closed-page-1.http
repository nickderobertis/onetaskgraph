5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nGitHub Projects home cards now participate in `task status complete` and `task status reconcile`, using project-specific status mappings without additional reads. Closure reports add `kind` to distinguish tasks from projects.\n\nAdds `project status set <ID> <CATEGORY>` across the CLI, engine, Python and TypeScript SDKs, and all built-in plugins, with updated schemas and protocol documentation.\n\n## Why\n\nFinished plans can still appear open because their home cards remain Todo or In Progress after their tasks finish. Keeping those cards aligned with issue closure makes the plans board trustworthy, while a public project status write lets consumers mark a plan finished through the store.\n\n## Additional info\n\nBreaking change to the public Rust APIs in `onetaskgraph-core` and `onetaskgraph-plugin-api`, requiring a pre-1.0 minor release. CLI JSON changes are additive: existing members remain, and readers interpreting `task` as a task ID must inspect `kind` first. Projects deliver no tasks.\n\nPlugins using the 0.8.0 wire shape remain compatible: task-only closure answers read as `kind: \"task\"`, and unsupported project status writes receive the default refusal. The new `set_project_status` wire result is a `Status` object or `null`; the CLI and engine retain their `{id, status}` response.","created_at":"2026-10-19T15:36:01Z","updated_at":"2026-10-19T23:01:27Z","closed_at":"2026-10-19T23:01:24Z","merged_at":"2026-10-19T23:01:24Z","merge_commit_sha":"6dff014762b144315dd3fe440bc160c336051f59","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3681/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3681/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3681/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/a58597a45f85c2c669d44ef6c7a2f1f2717aff3a","head":{"label":"nickderobertis:nick/3680/otg-project-closure","ref":"nick/3680/otg-project-closure","sha":"a58597a45f85c2c669d44ef6c7a2f1f2717aff3a","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https: