m/repos/nickderobertis/onetaskgraph/pulls/3601/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/a31084f146558c3f99e9e122bfe5a222feea8ea6"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3626","id":4867292528,"node_id":"PR_kwDOUBBgxs8AAAABIhz9cA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3626","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3626.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3626.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3626","number":3626,"state":"closed","locked":false,"title":"chore: release v0.7.1","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.7.0 -> 0.7.1\n* `onetaskgraph-linear`: 0.7.0 -> 0.7.1\n* `onetaskgraph-core`: 0.7.0 -> 0.7.1\n* `onetaskgraph`: 0.7.0 -> 0.7.1\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n## [0.7.1](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.7.0...onetaskgraph-plugin-api-v0.7.1) - 2026-10-15\n\n### Added\n\n- *(cache)* serve Linear comments and dependency reads from the cache ([#3619](https://github.com/nickderobertis/onetaskgraph/pull/3619))\n</blockquote>\n\n## `onetaskgraph-linear`\n\n<blockquote>\n\n## [0.7.1](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-linear-v0.7.0...onetaskgraph-linear-v0.7.1) - 2026-10-15\n\n### Added\n\n- *(cache)* serve Linear comments and dependency reads from the cache ([#3619](https://github.com/nickderobertis/onetaskgraph/pull/3619))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.7.1](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.7.0...onetaskgraph-core-v0.7.1) - 2026-10-15\n\n### Added\n\n- *(cache)* serve Linear comments and dependency reads from the cache ([#3619](https://github.com/nickderobertis/onetaskgraph/pull/3619))\n\n### Fixed\n\n- *(plans)* keep a public task's dependency on a private source's task ([#3630](https://github.com/nickderobertis/onetaskgraph/pull/3630))\n- *(copy)* file a private source's documents under the home its copy link names ([#3625](https://github.com/nickderobertis/onetaskgraph/pull/3625))\n</blockquote>\n\n## `onetaskgraph`\n\n<blockquote>\n\n## [0.7.1](https://github.com/nickderobertis/onetaskgraph/compare/v0.7.0...v0.7.1) - 2026-10-15\n\n### Added\n\n- *(cache)* serve Linear comments and dependency reads from the cache ([#3619](https://github.com/nickderobertis/onetaskgraph/pull/3619))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-15T02:25:29Z","updated_at":"2026-10-15T17:26:35Z","closed_at":"2026-10-15T17:26:32Z","merged_at":"2026-10-15T17:26:32Z","merge_commit_s