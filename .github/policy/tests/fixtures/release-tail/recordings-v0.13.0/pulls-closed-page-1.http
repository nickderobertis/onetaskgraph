pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3599/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/1b22d09aac31a711cbb1533d3452d0588a02111b"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3597","id":4834226106,"node_id":"PR_kwDOUBBgxs8AAAABICRvug","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3597","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3597.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3597.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3597","number":3597,"state":"closed","locked":false,"title":"chore: release v0.6.0","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.5.0 -> 0.6.0\n* `onetaskgraph-github-projects`: 0.5.0 -> 0.6.0\n* `onetaskgraph-linear`: 0.5.0 -> 0.6.0\n* `onetaskgraph-core`: 0.5.0 -> 0.6.0\n* `onetaskgraph`: 0.5.0 -> 0.6.0\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n## [0.6.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.5.0...onetaskgraph-plugin-api-v0.6.0) - 2026-10-12\n\n### Added\n\n- *(cache)* [**breaking**] cache remote items and comments per source, served only against a token in hand ([#3595](https://github.com/nickderobertis/onetaskgraph/pull/3595))\n</blockquote>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.6.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.5.0...onetaskgraph-github-projects-v0.6.0) - 2026-10-12\n\n### Added\n\n- *(cache)* [**breaking**] cache remote items and comments per source, served only against a token in hand ([#3595](https://github.com/nickderobertis/onetaskgraph/pull/3595))\n</blockquote>\n\n## `onetaskgraph-linear`\n\n<blockquote>\n\n## [0.6.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-linear-v0.5.0...onetaskgraph-linear-v0.6.0) - 2026-10-12\n\n### Added\n\n- *(cache)* [**breaking**] cache remote items and comments per source, served only against a token in hand ([#3595](https://github.com/nickderobertis/onetaskgraph/pull/3595))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.6.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.5.0...onetaskgraph-core-v0.6.0) - 2026-10-12\n\n### Added\n\n- *(cache)* [**breaking**] cache remote items and comments per source, served only against a token in hand ([#3595](https://github.com/nickderobertis/onetaskgraph/pull/3595))\n</blockquote>\n\n## `onetaskgraph`\n\n<blockquote>\n\n## [0.6.0](https://github.com/nickderobertis/onetaskgraph/compare/v0.5.0...v0.6.0) - 2026-10-12\n\n### Added\n\n- *(cache)* [**breaking**] cache remote items and comments per source, served only against a token in hand ([#3595](https://github.com/nickderobertis/onetaskgraph/pull/3595))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-12T19:45:32Z","updated_at":"2026-10-12T21:50:47Z","closed_at":"2026-10-12T21:50:45Z","merged_at":"2026-10-12T21:50:45Z","merge_commit_sha":"dbc7e4f2d573b2a5f850dd52eb808686ac73cdc2","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3597/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3597/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3597/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/606791ddc8ae383fca34df6743ffdee41b068a5a","head":{"label":"nickderobertis:release-plz-2026-10-12T19-45-29Z","ref":"release-plz-2026-10-12T19-45-29Z","sha":"606791ddc8ae383fca34df6743ffdee41b068a5a","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","event