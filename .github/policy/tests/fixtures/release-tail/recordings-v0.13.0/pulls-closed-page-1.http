m/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3725"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3725"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3725"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3725/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3725/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3725/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/5f7863fb60b3462b13599ea2da5ba4c264e3a1b0"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3726","id":4991764626,"node_id":"PR_kwDOUBBgxs8AAAABKYhIkg","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3726","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3726.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3726.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3726","number":3726,"state":"closed","locked":false,"title":"chore: release v0.12.0","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.11.1 -> 0.12.0\n* `onetaskgraph-github-projects`: 0.11.1 -> 0.12.0\n* `onetaskgraph-in-memory`: 0.11.1 -> 0.12.0\n* `onetaskgraph-linear`: 0.11.1 -> 0.12.0\n* `onetaskgraph-local-md`: 0.11.1 -> 0.12.0\n* `onetaskgraph-core`: 0.11.1 -> 0.12.0\n* `onetaskgraph`: 0.11.1 -> 0.12.0\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n## [0.12.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.11.1...onetaskgraph-plugin-api-v0.12.0) - 2026-10-24\n\n### Added\n\n- [**breaking**] read dependencies from a task's own record, naming private ones opaquely ([#3724](https://github.com/nickderobertis/onetaskgraph/pull/3724))\n</blockquote>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.12.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.11.1...onetaskgraph-github-projects-v0.12.0) - 2026-10-24\n\n### Added\n\n- [**breaking**] read dependencies from a task's own record, naming private ones opaquely ([#3724](https://github.com/nickderobertis/onetaskgraph/pull/3724))\n\n### Performance\n\n- cut backend requests per dependency read, status write and settlement ([#3727](https://github.com/nickderobertis/onetaskgraph/pull/3727))\n</blockquote>\n\n## `onetaskgraph-in-memory`\n\n<blockquote>\n\n## [0.12.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-in-memory-v0.11.1...onetaskgraph-in-memory-v0.12.0) - 2026-10-24\n\n### Added\n\n- [**breaking**] read dependencies from a task's own record, naming private ones opaquely ([#3724](https://github.com/nickderobertis/onetaskgraph/pull/3724))\n</blockquote>\n\n## `onetaskgraph-linear`\n\n<blockquote>\n\n## [0.12.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-linear-v0.11.1...onetaskgraph-linear-v0.12.0) - 2026-10-24\n\n### Added\n\n- [**breaking**] read dependencies from a task's own record, naming private ones opaquely ([#3724](https://github.com/nickderobertis/onetaskgraph/pull/3724))\n\n### Performance\n\n- cut backend requests per dependency read, status write and settlement ([#3727](https://github.com/nickderobertis/onetaskgraph/pull/3727))\n</blockquote>\n\n## `onetaskgraph-local-md`\n\n<blockquote>\n\n## [0.12.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-local-md-v0.11.1...onetaskgraph-local-md-v0.12.0) - 2026-10-24\n\n### Added\n\n- [**breaking**] read dependencies from a task's own record, naming private ones opaquely ([#3724](https://github.com/nickderobertis/onetaskgraph/pull/3724))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.12.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.11.1...onetaskgraph-core-v0.12.0) - 2026-10-24\n\n### Added\n\n- [**breaking**] read dependencies from a task's own record, naming private ones opaquely ([#3724](https://github.com/nickderobertis/onetaskgraph/pull/3724))\n\n### Performance\n\n- cut backend requests per dependency read, status write and settlement ([#3727](https://github.com/nickderobertis/onetaskgraph/pull/3727))\n</blockquote>\n\n## `onetaskgraph`\n\n<blockquote>\n\n## [0.12.0](https://github.com/nickderobertis/onetaskgraph/compare/v0.11.1...v0.12.0) - 2026-10-24\n\n### Added\n\n- [**breaking**] read dependencies from a task's own record, naming private ones opaquely ([#3724](https://github.com/nickderobertis/onetaskgraph/pull/3724))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-24T02:25:10Z","updated_at":"2026-10-24T12:51:17Z","closed_at":"2026-10-24T12:51:16Z","merged_at":"2026-10-24T12:51:16Z","merge_commit_sha":"99aa95d7fa862b6043f64c4d5a427e1860599f87","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3726/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3726/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3726/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/1e84e42b8842be01dab15152f66c7e43d6d5ce38","head":{"label":"nickderobertis:release-plz-2026-10-24T02-25-06Z","ref":"release-plz-2026-10-24T02-25-06Z","sha":"1e84e42b8842be01dab15152f66c7e43d6d5ce38","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"htt