kderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3692/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/ea21ce2e419bd1864e90a375a0a0cea5fcf93654"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3687","id":4929452115,"node_id":"PR_kwDOUBBgxs8AAAABJdF4Uw","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3687","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3687.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3687.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3687","number":3687,"state":"closed","locked":false,"title":"feat(copy)!: record the body_digest of what Linear stores","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nCopies and template create/render writes to Linear now bind task, project and document `body_digest` values to Linear’s declared stored Markdown form, without restamping hand edits. Unchanged re-copies skip updates by comparing normalized content and status, both in process and over stdio.\n\nUnexplained rewrites fail with `stored-content-diverged`, naming the item, first differing line and both texts. Comparison uses mutation responses; an omitted or blanked image line triggers one confirming read, so an incomplete response can be accepted but a missing image cannot. Declared rules cover Linear’s list, link, escaping, image spacing and content-ending behavior, including the trailing line break retained by a final table.\n\n## Why\n\nLinear’s Markdown rewrites made copied designs fail approval checks and copied plans fail rendered-only launch checks. Binding provenance to the content people actually read makes those copies verifiable without weakening approval. Skipping unchanged updates also avoids wasting the workspace’s Linear request quota.\n\n## Additional info\n\nBreaking change (`feat(copy)!`): adds `EngineError::StoredContentDiverged` to the exhaustive enum; downstream exhaustive matches must handle it. The digest definition and metadata key are unchanged. Sources that declare no rewrite retain their existing behavior. The stdio extension is negotiated within protocol version 2, preserving existing behavior for plugins that do not declare it.","created_at":"2026-10-20T00:56:16Z","updated_at":"2026-10-20T12:34:11Z","closed_at":"2026-10-20T12:34:07Z","merged_at":"2026-10-20T12:34:07Z","merge_commit_sha":"ffd9bf375179a28d66de44ac14c5fea2db4d347e","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3687/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3687/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3687/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/782cbf8e2c36aa37467bc9e187ba034694837310","head":{"label":"nickderobertis:nick/3682/otg-linear-stored-digest","ref":"nick/3682/otg-linear-stored-digest","sha":"782cbf8e2c36aa37467bc9e187ba034694837310","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.g