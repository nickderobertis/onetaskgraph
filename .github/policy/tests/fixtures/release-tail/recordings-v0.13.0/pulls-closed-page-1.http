derobertis/onetaskgraph/pulls/3767"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3767"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3767"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3767/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3767/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3767/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/db0b8916600b7ed3187baeb716499a6960ee47ac"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3762","id":5005340138,"node_id":"PR_kwDOUBBgxs8AAAABKldt6g","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3762","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3762.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3762.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3762","number":3762,"state":"closed","locked":false,"title":"fix(linear)!: take what Linear stores from each write's own answer","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nCopy, create and render now use Linear’s write responses to record the content it stored, replacing the Markdown rewrite prediction. Rewritten content takes one follow-up write to update fingerprints without making invalid provenance valid; unchanged copies and renders write nothing. `task content set` returns stored content through CLI JSON and both SDKs.\n\nBatched origin lookups and removal of redundant reads reduce the realistic first plan copy—one project, five tasks and one design document with two new images—from 22 requests to 20.\n\n## Why\n\nLinear’s Markdown normalization caused real rendered plans to fail copying and copied design documents to fail approval, leaving teams without settlement updates in their tracker. Recording Linear’s own answer makes renderings verifiable without maintaining a growing rewrite table, while fewer requests preserve the shared Linear key’s allowance for real work.\n\n## Additional info\n\n- **Breaking plugin API change:** removes `TaskSource::stored_form` and retires the stdio `stored_form` method. The engine no longer sends it; plugins that still answer it are unaffected. `stored_forms` retains its name and now covers `stored_status` and content-write results reporting `stored_content`. This requires a minor release under the pre-1.0 policy.\n- Projects and documents now carry the same copy records as tasks. Existing copies without those records are written once more on their next copy. No new reserved metadata key is introduced.\n- Document copies trust the destination project named by the local copy link without reading it first. A missing project produces a stale-link refusal; `--recreate` recovers the destination link. Repointing the destination project’s reciprocal link is no longer detected when filing a document.\n- Origin batching preserves single-origin lookup behavior for incomplete pages and duplicate matches. Linear’s project filter cannot search descriptions, so the projects portion reads a bounded page within the configured scope and confirms origins locally, falling back to individual walks when incomplete.\n- The retained spike evidence is `linear-stored-content-verification-spike-linear-stored-content-report`. Its small rewrite samples underpin the binary-driven loopback journeys in `plan_copy.rs`, `origin_batch.rs` and `stored_digest.rs`. The plan-copy budget is registered at 20 requests; new images take two requests each against the existing per-image threshold of three. Linear metadata updates return their mutation’s answer without a subsequent item read.\n- Includes a test-only repair for the local Markdown `torn_writes` failure in [the macOS check](https://github.com/nickderobertis/onetaskgraph/actions/runs/40208564581/job/121230767313): the writer blocks `SIGXFSZ` before starting and unblocks it only on the writing thread, preventing another thread from taking the signal while the writer removes its staging file. The test refuses to run if the inherited signal mask is missing.\n\nCloses #3684\nCloses #3146","created_at":"2026-10-25T13:53:08Z","updated_at":"2026-10-25T18:41:32Z","closed_at":"2026-10-25T18:41:29Z","merged_at":"2026-10-25T18:41:29Z","merge_commit_sha":"8977367a48cb7665a70d77e9949d74887af942eb","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3762/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3762/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3762/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/7beebaf7190beca416b27c48e5d04f8c0d9cbea9","head":{"label":"nickderobertis:nick/3744/otg-linear-stored-content","ref":"nick/3744/otg-linear-stored-content","sha":"7beebaf7190beca416b27c48e5d04f8c0d9cbea9","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gis