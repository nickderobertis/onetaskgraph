sions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3728"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3728"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3728"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3728/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3728/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3728/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/7a9d2b28fe3010983abd45b1fa48092f7c58674c"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3727","id":4992844780,"node_id":"PR_kwDOUBBgxs8AAAABKZjD7A","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3727","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3727.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3727.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3727","number":3727,"state":"closed","locked":false,"title":"perf: cut backend requests per dependency read, status write and settlement","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nReduce Linear and GitHub Projects dependency-read costs by querying only the requested direction and returning recorded edges alongside native edges, including GitHub drafts. Remove redundant reads from Linear settlements and GitHub status writes, and remember rate-limit resets within each engine instance so early retries fail locally with the remaining wait.\n\nAdd provider-request budgets and loopback journeys at 1x and 10x data, covering opaque-edge discovery and legacy reverse reads without changing public APIs or stored-edge contracts.\n\n## Why\n\nTracker request allowances are shared with the organization’s own work. Reducing repeated store-operation requests protects that allowance, while budget checks catch cost regressions as workspaces grow.\n\n## Additional info\n\nBoth dependency-read budgets are registered at two requests per source, on the user's ruling to land with higher budgets and reduce them afterwards: a cold opaque edge costs one designator-discovery request and one far-end read to the matching source, and every other dependency-read case stays at one request per source. Reaching one for the cold case needs a public API change, so it is left to a follow-up.\n\nThe write thresholds match the approved bounds: Linear status writes allow two requests cold and one warm; Linear settlements allow two cold or warm; GitHub status writes allow two and settlements three.\n","created_at":"2026-10-24T05:36:56Z","updated_at":"2026-10-24T10:47:45Z","closed_at":"2026-10-24T10:47:42Z","merged_at":"2026-10-24T10:47:42Z","merge_commit_sha":"247c417e1daa92871653800d27f1f1dc3e2c723a","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3727/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3727/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3727/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/85afa15cdac86802b7d0922c98c7fc0137886526","head":{"label":"nickderobertis:nick/3703/store-cost","ref":"nick/3703/store-cost","sha":"85afa15cdac86802b7d0922c98c7fc0137886526","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/nickderobertis/onetaskgraph","description":"Unified SDK and CLI for project-management ticketing systems: a Rust core with a plugin interface, Python and TypeScript wrappers, and pluggable task sources (local Markdown, Linear, GitHub Projects, in-memory).","fork":false,"url":"https://api.github.com/repos/nickderobertis/onetaskgraph","forks_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/forks","keys_url":"https://api.github.com/repos/nickderobertis/onetaskgrap