nts"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3712/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/72f2bacb0b7c1aa74efec0f0ed3576fbbddef391"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3711","id":4955258800,"node_id":"PR_kwDOUBBgxs8AAAABJ1s_sA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3711","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3711.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3711.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3711","number":3711,"state":"closed","locked":false,"title":"perf(github-projects): list a project's members and write metadata in one request each","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake GitHub Projects plan approval possible in 5 GraphQL points across 5 requests. Project member listings cost 1 point per page of up to 23 members and retain complete records, order and document change tokens, eliminating the approval’s separate document read.\n\nAdd `document metadata set --expect` with a fresh version check before writing, refusing stale tokens even after unseen board edits. Register the 5-point `github-approval-calls-points` budget for the approval sequence on a 2,000-item loopback board.\n\n## Why\n\nUsers need to copy a plan onto the board and approve it in a fraction of today’s time. Copying already meets its targets, but approval spends 16 points inside these store verbs; consumer changes alone cannot remove that cost.\n\n## Additional info\n\nThe guarded write takes two requests and needs no cache. GitHub provides no conditional issue write, so an edit arriving between the confirming read and mutation can still be overwritten. ai-orchestrator must adopt the shorter approval sequence; its 7-second budget remains downstream.","created_at":"2026-10-21T16:56:52Z","updated_at":"2026-10-21T18:18:47Z","closed_at":"2026-10-21T18:18:44Z","merged_at":"2026-10-21T18:18:44Z","merge_commit_sha":"8ffc39c66c5da882231307faee1d7af1685446b4","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3711/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3711/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3711/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/eb9076730e44881e60375baa8b71b30011663dd6","head":{"label":"nickderobertis:nick/Copy-a-plan-onto-the-board-and-approve-it-there-in-a-fraction-of-today-s-time/otg-approval-calls","ref":"nick/Copy-a-plan-onto-the-board-and-approve-it-there-in-a-fraction-of-today-s-time/otg-approval-calls","sha":"eb9076730e44881e60375baa8b71b30011663dd6","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/nickderobertis/onetaskgraph","description":"Unified SDK and CLI for project-management ticketing systems: a Rust core with a plugin interface, Python and TypeScript wrappers, and pluggable task sources (local Markdown, Linear, GitHub Projects, in-memory).","fork":false,"url":"https://api.github.com/repos/nickderobertis/onetaskgraph","forks_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/forks","keys_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/keys{/key_id}","collab