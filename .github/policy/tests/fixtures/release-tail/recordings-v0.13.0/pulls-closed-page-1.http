/nickderobertis/onetaskgraph/pull/3594"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3594"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3594/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3594/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3594/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/9d742896a82bb9ff2fcc2ee1a5238e3511b1f6ec"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3588","id":4815015341,"node_id":"PR_kwDOUBBgxs8AAAABHv9NrQ","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3588","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3588.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3588.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3588","number":3588,"state":"closed","locked":false,"title":"chore: release v0.5.0","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.4.0 -> 0.5.0\n* `onetaskgraph-github-projects`: 0.4.0 -> 0.5.0\n* `onetaskgraph-in-memory`: 0.4.0 -> 0.5.0\n* `onetaskgraph-linear`: 0.4.0 -> 0.5.0\n* `onetaskgraph-local-md`: 0.4.0 -> 0.5.0\n* `onetaskgraph-core`: 0.4.0 -> 0.5.0\n* `onetaskgraph`: 0.4.0 -> 0.5.0\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n## [0.5.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.4.0...onetaskgraph-plugin-api-v0.5.0) - 2026-10-12\n\n### Added\n\n- *(copy)* [**breaking**] carry comments, skip items unchanged since the last copy, and copy by query ([#3593](https://github.com/nickderobertis/onetaskgraph/pull/3593))\n</blockquote>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.5.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.4.0...onetaskgraph-github-projects-v0.5.0) - 2026-10-12\n\n### Added\n\n- *(copy)* [**breaking**] carry comments, skip items unchanged since the last copy, and copy by query ([#3593](https://github.com/nickderobertis/onetaskgraph/pull/3593))\n\n### Fixed\n\n- *(tests)* keep the live journey's comment-activity check to the items it wrote ([#3587](https://github.com/nickderobertis/onetaskgraph/pull/3587))\n</blockquote>\n\n## `onetaskgraph-in-memory`\n\n<blockquote>\n\n## [0.5.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-in-memory-v0.4.0...onetaskgraph-in-memory-v0.5.0) - 2026-10-12\n\n### Added\n\n- *(copy)* [**breaking**] carry comments, skip items unchanged since the last copy, and copy by query ([#3593](https://github.com/nickderobertis/onetaskgraph/pull/3593))\n</blockquote>\n\n## `onetaskgraph-linear`\n\n<blockquote>\n\n## [0.5.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-linear-v0.4.0...onetaskgraph-linear-v0.5.0) - 2026-10-12\n\n### Added\n\n- *(copy)* [**breaking**] carry comments, skip items unchanged since the last copy, and copy by query ([#3593](https://github.com/nickderobertis/onetaskgraph/pull/3593))\n</blockquote>\n\n## `onetaskgraph-local-md`\n\n<blockquote>\n\n## [0.5.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-local-md-v0.4.0...onetaskgraph-local-md-v0.5.0) - 2026-10-12\n\n### Added\n\n- *(copy)* [**breaking**] carry comments, skip items unchanged since the last copy, and copy by query ([#3593](https://github.com/nickderobertis/onetaskgraph/pull/3593))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.5.0](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.4.0...onetaskgraph-core-v0.5.0) - 2026-10-12\n\n### Added\n\n- *(copy)* [**breaking**] carry comments, skip items unchanged since the last copy, and copy by query ([#3593](https://github.com/nickderobertis/onetaskgraph/pull/3593))\n</blockquote>\n\n## `onetaskgraph`\n\n<blockquote>\n\n## [0.5.0](https://github.com/nickderobertis/onetaskgraph/compare/v0.4.0...v0.5.0) - 2026-10-12\n\n### Added\n\n- *(copy)* [**breaking**] carry comments, skip items unchanged since the last copy, and copy by query ([#3593](https://github.com/nickderobertis/onetaskgraph/pull/3593))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-10T22:53:41Z","updated_at":"2026-10-12T05:23:07Z","closed_at":"2026-10-12T05:23:05Z","merged_at":"2026-10-12T05:23:05Z","merge_commit_sha":"79434557af67850ae75e3d161488ebca17051be3","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos