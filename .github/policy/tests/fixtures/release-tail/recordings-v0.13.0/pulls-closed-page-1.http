erobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3746","id":5000526204,"node_id":"PR_kwDOUBBgxs8AAAABKg35fA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3746","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3746.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3746.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3746","number":3746,"state":"closed","locked":false,"title":"perf(cli): cut store start-up and plan loading","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nReduce store command start-up costs by building GitHub and Linear HTTP clients only when first used. Read a local Markdown item's outgoing dependencies from its own file instead of scanning unrelated records, while preserving reads during concurrent file replacement on Windows.\n\nAdd a test-only harness for whole-process CPU and wall timing, start-up attribution, and source-contact checks across plan reads and copies, without adding a public CLI or instrumentation surface.\n\n## Why\n\nPeople waiting on a plan copy or approval repeatedly pay for store process start-up and loading before any board request. Avoiding unused client construction and unnecessary file reads reduces that overhead for every host.","created_at":"2026-10-25T00:41:13Z","updated_at":"2026-10-25T04:09:17Z","closed_at":"2026-10-25T04:09:15Z","merged_at":"2026-10-25T04:09:15Z","merge_commit_sha":"3cddf1d0ea0cd79a62010fc09a4c5f8dee0241ba","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3746/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3746/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3746/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/a0c1cda7a0284a9e9dbc14f2053d858d038af0dc","head":{"label":"nickderobertis:nick/3743/otg-cut-store-startup","ref":"nick/3743/otg-cut-store-startup","sha":"a0c1cda7a0284a9e9dbc14f2053d858d038af0dc","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickde