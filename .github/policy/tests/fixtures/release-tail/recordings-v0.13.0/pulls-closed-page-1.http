b.com/repos/nickderobertis/onetaskgraph/downloads","issues_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues{/number}","pulls_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls{/number}","milestones_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/milestones{/number}","notifications_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/labels{/name}","releases_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/releases{/id}","deployments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/deployments","created_at":"2026-08-23T00:02:56Z","updated_at":"2026-10-31T23:21:48Z","pushed_at":"2026-11-01T00:47:19Z","git_url":"git://github.com/nickderobertis/onetaskgraph.git","ssh_url":"git@github.com:nickderobertis/onetaskgraph.git","clone_url":"https://github.com/nickderobertis/onetaskgraph.git","svn_url":"https://github.com/nickderobertis/onetaskgraph","homepage":null,"size":16538,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3642"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3642"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3642"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3642/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3642/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3642/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/911aba509243f5d8fce6b49ecafdf6d9aa2d1938"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3262","id":4754437512,"node_id":"PR_kwDOUBBgxs8AAAABG2L1iA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3262","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3262.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3262.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3262","number":3262,"state":"closed","locked":false,"title":"feat(status)!: scope status_mapping by item kind, refuse unmapped statuses, and drop Linear's by-type fallback","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nUnify GitHub Projects and Linear status mappings for tasks and projects, refusing unmapped writes and reading unmapped names as `unknown`. Report names per kind, let Linear `sources fields --apply` create missing names, and reuse resolution per Linear source instance to remove unnecessary reads from writes.\n\n## Why\n\nRouted plan copies to ExampleOrg’s Linear failed because a project’s `Todo` status was looked up literally in a workspace whose project vocabulary uses `Planned`. Mapping categories separately for tasks and projects fixes that mismatch without changing the workspace, gives both backends the same configuration contract, and reduces traffic on the shared Linear key.\n\n## Additional info\n\nBreaking change for 0.3; see [Migrating to 0.3](README.md#status-mapping). The shared mapping and per-kind reports ship in schema bundle 30 with regenerated Python and TypeScript SDK models. Linear’s `StatusNamesReport` replaces `WorkflowStatesReport`.\n\n- A mapping accepts a non-blank name for both kinds, `null` to disable a category, or an object naming `task`, `project`, or both. An omitted kind stays unmapped; duplicate names across categories are refused case-insensitively within each kind.\n- Linear requires explicit mappings for every status write, including project writes; type and original-name fallbacks are removed. A source without a mapping refuses every status write. Unmapped names read as `unknown`, and status filters follow that mapping.\n- GitHub retains defaults for unconfigured categories, but a per-kind mapping leaves omitted kinds unmapped. Closed issues retain their closed-state category.\n- Linear status-only writes send a mutation without reading the issue first: same-category writes still update, mapped `unknown` replaces an unmapped state, and missing issues are detected by the mutation.\n- A Linear status-only write goes to the item it names wherever that item is filed, while reads, listings and creation stay scoped. Project writes remain restricted to the configured project.\n- Linear `sources fields --apply` creates missing workflow states and project statuses, preserves existing names and types, and reports creations completed before a failure. Retrying creates only names still missing. Without `--apply`, reporting writes nothing. GitHub adds missing options for both kinds while preserving existing option IDs.\n- Copy checks status mappings before recording an overwrite for undo, so a refused status does not trigger a restoring mutation against an untouched item.\n\nLinear resolves its team and both status vocabularies lazily, holds them per source instance, and refreshes on a missing name. Loopback request budgets cap status writes at **2 requests cold / 1 warm** and settlement updates at **3 cold / 2 warm**; settlement updates retain the description read needed to preserve personal text and unrelated metadata. The four budgets and operation-specific measurements against base `c9e75a8` are recorded in [budgets.yaml](crates/onetaskgraph-linear/budgets.yaml), with the budget check wired into Linear’s affected checks. The budget and wrapper checks skip on Windows with an explicit notice because the pinned onebudgetspec distribution has no win32-x64 build; Linux and macOS gate these budgets.\n\nThe resolution query bounds `teams(first:2)`, each team’s `states(first:250)`, and `projectStatuses(first:250)`. Under the Linear complexity model recorded beside the query—properties cost 0.1, objects 1, and connections multiply their children by `first`, defaulting to 50—it scores **1827.2** (`2 × 601.1 + 625`), below the limit of 10000. Two teams preserve ambiguous-team detection; incomplete state or project-status pages are refused rather than silently truncated.\n\nThe earlier resolution document, with the default team page of 50, was refused live at **30905**, versus **30680** under that model (`50 × (1 + 0.1 + 250 × (1.3 + 1.1)) + 250 × (1.4 + 1.1)`). Linear’s reported figures exceeded the model by 225 on both documents observed, including `projects` at 250, reported as **17475**. Even charging another point for each of the bounded resolution’s 752 connection nodes leaves it below **2580**. The other added or widened documents score **70.3** for `ISSUE_UPDATE_READ` (existing `ISSUE`: **69.2**), **352.2 each** for `ISSUE_REWRITE` and `PROJECT_REWRITE` at `first:100`, **2.4** for `WORKFLOW_STATE_CREATE`, and **2.5** for `PROJECT_STATUS_CREATE`.","created_at":"2026-10-06T05:12:14Z","updated_at":"2026-10-30T15:18:28Z","closed_at":"2026-10-06T08:42:35Z","merged_at":"2026-10-06T08:42:35Z","merge_commit_sha":"ce13e41f843a43548c177cb8f9f56cd8431afc22","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3262/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3262/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3262/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/b875ba47527e8356bae5a3b2fd8554bdd573da37","head":{"label":"nickderobertis:nick/3261/otg-status-by-kind","ref":"nick/3261/otg-status-by-kind","sha":"b875ba47527e8356bae5a3b2fd8554bdd573da37","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/nickderobertis/onetaskgraph","description":"Unified SDK and CLI for project-management ticketing systems: a Rust core with a plugin interface