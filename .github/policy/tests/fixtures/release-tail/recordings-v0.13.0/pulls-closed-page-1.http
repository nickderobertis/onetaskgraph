ickderobertis/onetaskgraph.git","ssh_url":"git@github.com:nickderobertis/onetaskgraph.git","clone_url":"https://github.com/nickderobertis/onetaskgraph.git","svn_url":"https://github.com/nickderobertis/onetaskgraph","homepage":null,"size":16538,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3807"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3807"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3807"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3807/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3807/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3807/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/093e22ee768ae3d2cffd557681143baff96b6492"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3818","id":5062179884,"node_id":"PR_kwDOUBBgxs8AAAABLbq8LA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3818","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3818.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3818.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3818","number":3818,"state":"closed","locked":false,"title":"chore: release v0.12.11","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.12.10 -> 0.12.11\n* `onetaskgraph-github-projects`: 0.12.10 -> 0.12.11\n* `onetaskgraph-core`: 0.12.10 -> 0.12.11\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n## [0.12.11](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.12.10...onetaskgraph-plugin-api-v0.12.11) - 2026-10-29\n\n### Fixed\n\n- *(github-projects)* file a private home's public task in a private repository ([#3804](https://github.com/nickderobertis/onetaskgraph/pull/3804))\n</blockquote>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.12.11](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.12.10...onetaskgraph-github-projects-v0.12.11) - 2026-10-29\n\n### Fixed\n\n- *(github-projects)* file a private home's public task in a private repository ([#3804](https://github.com/nickderobertis/onetaskgraph/pull/3804))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.12.11](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.12.10...onetaskgraph-core-v0.12.11) - 2026-10-29\n\n### Fixed\n\n- *(github-projects)* file a private home's public task in a private repository ([#3804](https://github.com/nickderobertis/onetaskgraph/pull/3804))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-29T04:28:42Z","updated_at":"2026-10-29T14:30:38Z","closed_at":"2026-10-29T14:30:37Z","merged_at":"2026-10-29T14:30:37Z","merge_commit_sha":"99463342e36d1a6a29ee49198e1d26810d14468f","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3818/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3818/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3818/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/58ae137d9843d18209f438edcf8c80937e44067f","head":{"label":"nickderobertis:release-plz-0.12.11","ref":"release-plz-0.12.11","sha":"58ae137d9843d18209f438edcf8c80937e44067f","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com