com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3775","id":5026867422,"node_id":"PR_kwDOUBBgxs8AAAABK5_o3g","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3775","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3775.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3775.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3775","number":3775,"state":"closed","locked":false,"title":"perf(copy): batch a private source's origin lookups and reuse carried dependency edges","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake private plan copies to GitHub Projects as economical as public copies by batching origin lookups and issue updates, reusing dependency reads, and avoiding unnecessary document and board-field reads. Preserve screening, withheld references, duplicate prevention and rollback behavior.\n\nExtend all seven plan-copy budgets to cover private sources with board caching and screening enabled at 2,000 and 20,000 items, keeping existing thresholds. Give CLI commands a consistent stack size across platforms to prevent Windows copy stack overflows.\n\n## Why\n\nEvery plan revision reaches the plans board from the host’s private authoring source, which previously spent two to four times the approved GraphQL allowance. Fixing these costs in the store benefits every consumer, while measuring the host’s configuration catches regressions against the quota shared by all sessions.","created_at":"2026-10-27T00:48:54Z","updated_at":"2026-10-27T06:41:34Z","closed_at":"2026-10-27T06:41:31Z","merged_at":"2026-10-27T06:41:31Z","merge_commit_sha":"7b1af0a16629e4a24d7940ff3fee3270e9fd1594","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3775/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3775/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3775/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/cd78a6126bc125b556bece610639237e817ed2ed","head":{"label":"nickderobertis:nick/3773/otg-copy-parity","ref":"nick/3773/otg-copy-parity","sha":"cd78a6126bc125b556bece610639237e817ed2ed","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.github