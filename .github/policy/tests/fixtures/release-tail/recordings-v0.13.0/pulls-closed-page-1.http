ub.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3650","id":4910713964,"node_id":"PR_kwDOUBBgxs8AAAABJLOMbA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3650","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3650.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3650.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3650","number":3650,"state":"closed","locked":false,"title":"fix(config): leave a source no layer defines unconfigured instead of failing","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nSource refinements without a plugin declaration no longer prevent other sources from loading or serving reads and writes. `config show` preserves their settings and origins and marks them incomplete; commands selecting them directly, through defaults or through routing refuse with JSON kind `incomplete-source`, including `cache clear`.\n\n## Why\n\nOrganization-specific routing needs to live in private user configuration while source definitions remain in their repositories. Those refinements previously broke every plan-store command outside the defining checkout, even commands using unrelated sources. This keeps the store usable across repositories without exposing private repository names in tracked configuration.\n\n## Additional info\n\nBreaking Rust API additions: `EffectiveConfig.incomplete_sources` and `EngineError::IncompleteSource`. The schema bundle advances to version 40, with regenerated Python and TypeScript SDK models, preserving version 39's partial dependency-read contract.","created_at":"2026-10-18T16:18:22Z","updated_at":"2026-10-18T23:18:05Z","closed_at":"2026-10-18T23:18:03Z","merged_at":"2026-10-18T23:18:03Z","merge_commit_sha":"ed79789488c62bbec4af948dde85951e788f6c6e","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3650/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3650/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3650/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/c221252adfabe7e32d60724be16c16f7bcf003ae","head":{"label":"nickderobertis:nick/Repository-publication-boundary/store-refinement-overlay","ref":"nick/Repository-publication-boundary/store-refinement-overlay","sha":"c221252adfabe7e32d60724be16c16f7bcf003ae","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/u