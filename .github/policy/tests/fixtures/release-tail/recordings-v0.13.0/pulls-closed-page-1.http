","git_url":"git://github.com/nickderobertis/onetaskgraph.git","ssh_url":"git@github.com:nickderobertis/onetaskgraph.git","clone_url":"https://github.com/nickderobertis/onetaskgraph.git","svn_url":"https://github.com/nickderobertis/onetaskgraph","homepage":null,"size":16538,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3713"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3713"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3713"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3713/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3713/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3713/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/38042622c8ef34f486fbfdc1017980910e56984f"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3712","id":4956323833,"node_id":"PR_kwDOUBBgxs8AAAABJ2t_-Q","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3712","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3712.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3712.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3712","number":3712,"state":"closed","locked":false,"title":"chore: release v0.9.3","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-github-projects`: 0.9.2 -> 0.9.3\n* `onetaskgraph-core`: 0.9.2 -> 0.9.3\n* `onetaskgraph`: 0.9.2 -> 0.9.3\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.9.3](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.9.2...onetaskgraph-github-projects-v0.9.3) - 2026-10-21\n\n### Fixed\n\n- *(e2e)* make the loopback board and the live journey's readiness wait reliable ([#3695](https://github.com/nickderobertis/onetaskgraph/pull/3695))\n\n### Performance\n\n- *(github-projects)* list a project's members and write metadata in one request each ([#3711](https://github.com/nickderobertis/onetaskgraph/pull/3711))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.9.3](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.9.2...onetaskgraph-core-v0.9.3) - 2026-10-21\n\n### Performance\n\n- *(github-projects)* list a project's members and write metadata in one request each ([#3711](https://github.com/nickderobertis/onetaskgraph/pull/3711))\n</blockquote>\n\n## `onetaskgraph`\n\n<blockquote>\n\n## [0.9.3](https://github.com/nickderobertis/onetaskgraph/compare/v0.9.2...v0.9.3) - 2026-10-21\n\n### Performance\n\n- *(github-projects)* list a project's members and write metadata in one request each ([#3711](https://github.com/nickderobertis/onetaskgraph/pull/3711))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-21T18:20:20Z","updated_at":"2026-10-21T19:46:31Z","closed_at":"2026-10-21T19:46:29Z","merged_at":"2026-10-21T19:46:29Z","merge_commit_sha":"7e616f93d2cc3619d45eafe7ad2aac742c6f1812","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3712/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3712/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3712/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/72f2bacb0b7c1aa74efec0f0ed3576fbbddef391","head":{"label":"nickderobertis:release-plz-2026-10-21T18-20-17Z","ref":"release-plz-2026-10-21T18-20-17Z","sha":"72f2bacb0b7c1aa74efec0f0ed3576fbbddef391","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":