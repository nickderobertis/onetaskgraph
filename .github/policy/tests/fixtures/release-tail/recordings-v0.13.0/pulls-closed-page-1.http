erobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3595","id":4830690600,"node_id":"PR_kwDOUBBgxs8AAAABH-59KA","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3595","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3595.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3595.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3595","number":3595,"state":"closed","locked":false,"title":"feat(cache)!: cache remote items and comments per source, served only against a token in hand","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nAdd an opt-in, per-source disk cache shared by the CLI, both SDKs and Rust callers. Pinned reads reuse tasks and comments without remote requests; `--expect` writes reuse cached context, change only intended fields and report mutation outcomes. Includes cache clearing, configuration, schema and documentation updates.\n\n## Why\n\nRepeated plan copies, follow-up reads and write-backs consume the same shared board allowance even when nothing changed. Reusing versions callers already hold reduces quota use without freshness-check requests, preserving that allowance for work that needs the remote.\n\n## Additional info\n\n- Breaking changes to public Rust configuration and report types. Caching defaults to off.\n- A pin guarantees the held version or later; it does not discover unseen remote changes. Uncovered or unsettled versions go remote, including all Linear reads today. The cache does not retain snapshots.\n- `--expect` provides no concurrency protection. A stale cached option can require one extra request; ambiguous mutation outcomes are never retried.\n- Writes retire the old cache entry before sending mutations and refuse to proceed if the filesystem prevents retirement. GitHub’s 60-second settling rule normally leaves a write’s `result.version` null and requires a subsequent read to refresh the entry.","created_at":"2026-10-12T14:16:16Z","updated_at":"2026-10-12T19:43:42Z","closed_at":"2026-10-12T19:43:41Z","merged_at":"2026-10-12T19:43:41Z","merge_commit_sha":"b0b745263db21908fc854733c71f01e51c7c66ba","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3595/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3595/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3595/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/31a60912caa1626d24056015bd9fdbd4664923e0","head":{"label":"nickderobertis:nick/3581/otg-source-cache","ref":"nick/3581/otg-source-cache","sha":"31a60912caa1626d24056015bd9fdbd4664923e0","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u