com:nickderobertis/onetaskgraph.git","clone_url":"https://github.com/nickderobertis/onetaskgraph.git","svn_url":"https://github.com/nickderobertis/onetaskgraph","homepage":null,"size":16538,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3695"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3695"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3695"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3695/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3695/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3695/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/9b67e69b5fc2b47160d207d0742b142e3fea570f"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3689","id":4935807503,"node_id":"PR_kwDOUBBgxs8AAAABJjJyDw","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3689","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3689.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3689.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3689","number":3689,"state":"closed","locked":false,"title":"chore: release v0.9.2","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.9.1 -> 0.9.2\n* `onetaskgraph-github-projects`: 0.9.1 -> 0.9.2\n* `onetaskgraph-in-memory`: 0.9.1 -> 0.9.2\n* `onetaskgraph-linear`: 0.9.1 -> 0.9.2\n* `onetaskgraph-local-md`: 0.9.1 -> 0.9.2\n* `onetaskgraph-core`: 0.9.1 -> 0.9.2\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n## [0.9.2](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.9.1...onetaskgraph-plugin-api-v0.9.2) - 2026-10-20\n\n### Added\n\n- *(copy)* [**breaking**] record the body_digest of what Linear stores ([#3687](https://github.com/nickderobertis/onetaskgraph/pull/3687))\n\n### Performance\n\n- *(github-projects)* write a copied item in fewer requests ([#3692](https://github.com/nickderobertis/onetaskgraph/pull/3692))\n</blockquote>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.9.2](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.9.1...onetaskgraph-github-projects-v0.9.2) - 2026-10-20\n\n### Added\n\n- *(copy)* [**breaking**] home a plan where its repository-naming tasks route, and reuse its member project ([#3685](https://github.com/nickderobertis/onetaskgraph/pull/3685))\n\n### Performance\n\n- *(github-projects)* write a copied item in fewer requests ([#3692](https://github.com/nickderobertis/onetaskgraph/pull/3692))\n</blockquote>\n\n## `onetaskgraph-in-memory`\n\n<blockquote>\n\n## [0.9.2](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-in-memory-v0.9.1...onetaskgraph-in-memory-v0.9.2) - 2026-10-20\n\n### Performance\n\n- *(github-projects)* write a copied item in fewer requests ([#3692](https://github.com/nickderobertis/onetaskgraph/pull/3692))\n</blockquote>\n\n## `onetaskgraph-linear`\n\n<blockquote>\n\n## [0.9.2](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-linear-v0.9.1...onetaskgraph-linear-v0.9.2) - 2026-10-20\n\n### Added\n\n- *(copy)* [**breaking**] record the body_digest of what Linear stores ([#3687](https://github.com/nickderobertis/onetaskgraph/pull/3687))\n</blockquote>\n\n## `onetaskgraph-local-md`\n\n<blockquote>\n\n## [0.9.2](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-local-md-v0.9.1...onetaskgraph-local-md-v0.9.2) - 2026-10-20\n\n### Performance\n\n- *(github-projects)* write a copied item in fewer requests ([#3692](https://github.com/nickderobertis/onetaskgraph/pull/3692))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.9.2](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.9.1...onetaskgraph-core-v0.9.2) - 2026-10-20\n\n### Added\n\n- *(copy)* [**breaking**] home a plan where its repository-naming tasks route, and reuse its member project ([#3685](https://github.com/nickderobertis/onetaskgraph/pull/3685))\n- *(copy)* [**breaking**] record the body_digest of what Linear stores ([#3687](https://github.com/nickderobertis/onetaskgraph/pull/3687))\n\n### Performance\n\n- *(github-projects)* write a copied item in fewer requests ([#3692](https://github.com/nickderobertis/onetaskgraph/pull/3692))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-20T12:36:16Z","updated_at":"2026-10-21T00:12:37Z","closed_at":"2026-10-21T00:12:36Z","merged_at":"2026-10-21T00:12:36Z","merge_commit_sha":"83614e31c7e7906b6b8ad929b51e38387cf97b99","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3689/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3689/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3689/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/26c10d813f28ffd9714c333176efaa38c4e94fe0","head":{"label":"nickderobertis:release-plz-2026-10-20T12-36-13Z","ref":"release-plz-2026-10-20T12-36-13Z","sha":"26c10d813f28ffd9714c333176efaa38c4e94fe0","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/