d":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3588"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3588"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3588"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3588/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3588/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3588/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/090788b744339d9c7ae66393aa2f5135277371d8"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3593","id":4822633095,"node_id":"PR_kwDOUBBgxs8AAAABH3OKhw","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3593","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3593.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3593.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3593","number":3593,"state":"closed","locked":false,"title":"feat(copy)!: carry comments, skip items unchanged since the last copy, and copy by query","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nTask and project copies can now synchronize comments across GitHub Projects, Linear and local Markdown, preserving their original identity through chained copies and leaving destination-native comments alone. Task copies accept query filters; `--no-link` leaves the source untouched.\n\nChange tokens and destination digests let repeat copies skip unchanged tasks while detecting changes at either end. Snapshot reads retry inconsistent items and report those that never settle as failed without writing them. The CLI, schema, both SDKs and plugin protocol expose the new behavior. Repository scripts explicitly read tracked text as UTF-8, fixing Windows checks with non-ASCII files.\n\n## Why\n\nBoard reads consume shared API allowances; exhausting them stalls everyone using the account. Callers can now work from local snapshots containing tasks and comments, then synchronize changes without repeatedly fetching unchanged content or maintaining their own copies outside the store. Freshness takes precedence over saving requests.\n\n## Additional info\n\nBreaking public Rust API change, intended for the next pre-1.0 minor release (0.4). Comment synchronization is opt-in with `--comments`; skipping applies to copies with comments or by query.\n\nGitHub tokens include relationship changes and repository identity and are issued only after a 60-second settling window measured against the response’s server clock. Local Markdown uses file digests. Linear continues without tokens and is always read; older plugins that omit tokens remain readable. Paginated comment reads without a token require two consecutive matching passes, bounded at three passes.","created_at":"2026-10-11T21:50:29Z","updated_at":"2026-10-12T03:51:43Z","closed_at":"2026-10-12T03:51:41Z","merged_at":"2026-10-12T03:51:41Z","merge_commit_sha":"709fa178e5c88b7b8a1227a0a79d159520d1ef47","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3593/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3593/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3593/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/f7426a25a2191d69e297f4d99a61493c92930b46","head":{"label":"nickderobertis:nick/3582/otg-copy-comments","ref":"nick/3582/otg-copy-comments","sha":"f7426a25a2191d69e297f4d99a61493c92930b46","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/