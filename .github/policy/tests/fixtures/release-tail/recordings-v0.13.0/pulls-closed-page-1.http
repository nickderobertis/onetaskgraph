6-10-31T23:21:48Z","pushed_at":"2026-11-01T00:47:19Z","git_url":"git://github.com/nickderobertis/onetaskgraph.git","ssh_url":"git@github.com:nickderobertis/onetaskgraph.git","clone_url":"https://github.com/nickderobertis/onetaskgraph.git","svn_url":"https://github.com/nickderobertis/onetaskgraph","homepage":null,"size":16538,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3727"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3727"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3727"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3727/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3727/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3727/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/85afa15cdac86802b7d0922c98c7fc0137886526"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3724","id":4989611979,"node_id":"PR_kwDOUBBgxs8AAAABKWdvyw","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3724","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3724.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3724.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3724","number":3724,"state":"closed","locked":false,"title":"feat!: read dependencies from a task's own record, naming private ones opaquely","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nDependency reads and project graphs limit legacy reverse lookups to unmarked copy destinations and resolve opaque edges through the tracker they identify. Public tasks can retain private prerequisites as `{designator, id, kind}`; writes and copies reject identifying reference content before writing.\n\nCopies migrate legacy reverse records onto the dependent and mark complete edge records, avoiding future reverse scans. Unresolved trackers appear in `unanswered`; `--complete` refuses an incomplete answer.\n\n## Why\n\nAn exhausted private tracker stalled unrelated public planning for over an hour, while a held node kept consuming credentials shared with the organization’s own work. Restricting dependency reads prevents unrelated trackers from blocking planning. Opaque references preserve private prerequisites without publishing what those items are called.\n\n## Additional info\n\nBreaking API and migration changes:\n\n- `QueryResponse.unanswered` changes from `Vec<SourceFailure>` to `Vec<Unanswered>`, and `ProjectGraph::unanswered()` returns `&[Unanswered]`. Callers must handle unresolved designators alongside source failures; both generated SDKs carry this union.\n- `EngineError` adds `PrivateReferenceContent` and `DesignatorNotConfigured`; exhaustive matches must handle both.\n- `DependencyEndpoint` gains an opaque wire form. `source() == None` no longer implies a local native endpoint; consumers must use `is_native()` or inspect `designator()`. Opaque endpoints display as `<designator>:<id>` and do not compare equal to a `NativeId`.\n- Schema bundle 45 and bumped cache schemas carry the opaque endpoint. Adopt the store, engine/read API and generated SDKs together in the next minor release.\n\nLinear and GitHub Projects derive designators from backend identifiers and retain them across processes, even with the work-data cache disabled. Discovery checks candidates in source-name order and stops at the first match. Local Markdown sources can declare a shared `public_alias`. The new `TaskSource::designator` method defaults to `None`; the spawned-plugin protocol does not carry it.\n\nCopies whose private prerequisites have no designator retain the existing withhold-and-record behavior. Reverse lookup remains limited to tasks carrying `onetaskgraph.copied_destination_version` but lacking `onetaskgraph.edges_on_record`, in sources not declared private.\n\nThe dependency lockfile also upgrades Tokio to 1.54.1 for RUSTSEC-2026-0386. Backend query optimizations and request budgets remain follow-up work for `store-cost`.","created_at":"2026-10-23T21:41:55Z","updated_at":"2026-10-24T02:21:59Z","closed_at":"2026-10-24T02:21:57Z","merged_at":"2026-10-24T02:21:57Z","merge_commit_sha":"c39fe5127b3c4c3127928c6c7385c6f641978434","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3724/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3724/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3724/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/75cfcba5e084152f0fda3c4ee8b9787326824344","head":{"label":"nickderobertis:nick/3702/store","ref":"nick/3702/store","sha":"75cfcba5e084152f0fda3c4ee8b9787326824344","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343