es/a0c1cda7a0284a9e9dbc14f2053d858d038af0dc"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3738","id":4996066686,"node_id":"PR_kwDOUBBgxs8AAAABKcntfg","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3738","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3738.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3738.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3738","number":3738,"state":"closed","locked":false,"title":"chore: release v0.12.1","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"\n\n\n## 🤖 New release\n\n* `onetaskgraph-plugin-api`: 0.12.0 -> 0.12.1\n* `onetaskgraph-github-projects`: 0.12.0 -> 0.12.1\n* `onetaskgraph-core`: 0.12.0 -> 0.12.1\n\n<details><summary><i><b>Changelog</b></i></summary><p>\n\n## `onetaskgraph-plugin-api`\n\n<blockquote>\n\n\n## [0.12.1](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-plugin-api-v0.12.0...onetaskgraph-plugin-api-v0.12.1) - 2026-10-24\n\n### Added\n\n- support task-owned visibility and private coordination projections ([#3725](https://github.com/nickderobertis/onetaskgraph/pull/3725))\n</blockquote>\n\n## `onetaskgraph-github-projects`\n\n<blockquote>\n\n\n## [0.12.1](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-github-projects-v0.12.0...onetaskgraph-github-projects-v0.12.1) - 2026-10-24\n\n### Added\n\n- support task-owned visibility and private coordination projections ([#3725](https://github.com/nickderobertis/onetaskgraph/pull/3725))\n</blockquote>\n\n## `onetaskgraph-core`\n\n<blockquote>\n\n## [0.12.1](https://github.com/nickderobertis/onetaskgraph/compare/onetaskgraph-core-v0.12.0...onetaskgraph-core-v0.12.1) - 2026-10-24\n\n### Added\n\n- support task-owned visibility and private coordination projections ([#3725](https://github.com/nickderobertis/onetaskgraph/pull/3725))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-24T14:05:53Z","updated_at":"2026-10-24T15:41:39Z","closed_at":"2026-10-24T15:41:37Z","merged_at":"2026-10-24T15:41:37Z","merge_commit_sha":"10370c723411da237e72a1c499360d9c8ec44a7b","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3738/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3738/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3738/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/759465f51d10f42f808d7682e3654354657115c7","head":{"label":"nickderobertis:release-plz-2026-10-24T14-05-50Z"