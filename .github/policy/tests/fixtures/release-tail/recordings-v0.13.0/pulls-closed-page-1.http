os/nickderobertis/onetaskgraph/releases{/id}","deployments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/deployments","created_at":"2026-08-23T00:02:56Z","updated_at":"2026-10-31T23:21:48Z","pushed_at":"2026-11-01T00:47:19Z","git_url":"git://github.com/nickderobertis/onetaskgraph.git","ssh_url":"git@github.com:nickderobertis/onetaskgraph.git","clone_url":"https://github.com/nickderobertis/onetaskgraph.git","svn_url":"https://github.com/nickderobertis/onetaskgraph","homepage":null,"size":16538,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":127,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":127,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3689"},"html":{"href":"https://github.com/nickderobertis/onetaskgraph/pull/3689"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3689"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3689/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3689/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3689/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/26c10d813f28ffd9714c333176efaa38c4e94fe0"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3685","id":4928480547,"node_id":"PR_kwDOUBBgxs8AAAABJcKlIw","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3685","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3685.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3685.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3685","number":3685,"state":"closed","locked":false,"title":"feat(copy)!: home a plan where its repository-naming tasks route, and reuse its member project","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nRouted project copies choose their home from repository-bearing tasks and the project's own repositories; repository-less tasks and documents follow it. With the public boundary active, mixed plans home with their private work and place public tasks under screened member projects. Existing homes stay put; conflicting private destinations refuse a new home before writing.\n\nCopies reuse existing member projects even when only one discovery link remains. Promoting a member updates the copy links and removes its former membership, avoiding a duplicate project. The README and library and CLI journeys cover these rules, including repeat copies, dry runs, incomplete links and rollback.\n\n## Why\n\nA single repository-less human step could leave an otherwise private plan on a public board, exposing repository names and file layout. Copying it again to the private tracker then left an empty duplicate. These changes keep private plans in their intended tracker and let people see the plan once without cleanup.\n\n## Additional info\n\nBreaking change (`feat(copy)!`): adds `EngineError::SplitPrivateHome` to the exhaustive enum, requiring downstream Rust consumers to update exhaustive matches. This requires a minor release while pre-1.0.\n\nThe [live reconcile CI failure](https://github.com/nickderobertis/onetaskgraph/actions/runs/39443851981) reproduced locally on both the branch at `c1142acd` and merge base `ffd9bf37`: both reported “the contradicting task was not listed.” GitHub's board index omitted newly closed tasks even while direct reads could find them. The live journey now waits for its two tasks to appear in the board's `is:closed` filter, polling once a minute for up to 45 minutes before testing reconciliation. Its admission estimate increases from 40 to 85 GraphQL points, and malformed pagination metadata is refused. Production reconciliation is unchanged. At final head `4301126d`, the live journey passed after a 1,523-second index wait, and both tasks were cleaned up; an earlier attempt at that head failed with HTTP 502. An intermediate version also passed after a 1,279-second wait. The double-backed `status_reconcile` and `closed_status` suites passed on both branch and merge base, with 10 and 6 tests respectively; the earlier double-board comparison found the journey's task copy identical on both trees.\n\nThe [macOS cache-budget refusal](https://github.com/nickderobertis/onetaskgraph/actions/runs/39349276975) was not reproduced locally. At final head `4301126d` and merge base `ffd9bf37`, the unchanged journey passed in approximately 742 and 736 seconds. Tracing measured 4,442 store invocations, 4,438 simulated-clock attaches, 4,438 successful attachment replies and zero refusals on each tree; invocation argument multisets also matched. This corrects the earlier description's assertion of one attach per invocation. The clock permits five seconds for a previous connection using the same client number to detach, providing a timing mechanism consistent with the CI refusal; the comparisons found no additional invocations or reads attributable to this branch. The test remains unchanged, and the harness timing has a follow-up.\n\nEarlier cache comparisons also passed at `afab253c` and merge base `6dff0147` (708 and 684 seconds), with 4,442 invocations, identical verb counts and identical request/point telemetry; neither invoked copy. Another comparison at `29157bd3` and merge base `dd9882d2` passed on both trees in about 1,123 seconds, again with 4,442 invocations each. The original CI run passed on its second attempt at the same commit. These earlier results remain evidence at their named commits.\n\nThe [Windows required-check refusal](https://github.com/nickderobertis/onetaskgraph/actions/runs/39370806463/job/118458078191) recorded one refused concurrent Linear copy against a budget of zero, after all expected assets landed. Its cause remains unconfirmed. Linux comparisons of the branch and main at `dd9882d2` found identical Linear operations (78), source-file opens (390) and renames (57); 48 runs per tree recorded no refusals. Concurrent-copy budget reports now include each refused command's error, with a journey proving that the detail reaches `onebudgetspec check`. This adds diagnostics; it does not claim to fix the Windows refusal. At `29157bd3`, the recorded Linux run passed all 107 Linear e2e tests and all 14 Linear budgets; formatting and diff-scoped judged lint also passed.\n\nThe [later macOS SDK failure](https://github.com/nickderobertis/onetaskgraph/actions/runs/39396133242) was an empty flag list from a spawned `--help` command in `sdk-typescript:coverage`. Locally, `sdk-typescript:test` passed all 79 tests at `29157bd3`, including the flag-spelling test, with an empty configuration home and host-specific configuration variables unset. An initial run with the host configuration failed a different source-list assertion. The target passed all 79 tests again on the branch after the merge of `ffd9bf37`, using isolated configuration; the corresponding merge-base attempt ended with exit 130 and supplies no passing result. The SDK and CLI help code are unchanged by this branch; the macOS spawn failure remains undiagnosed. Follow-ups record configuration isolation and missing spawn diagnostics.\n\nIn [run 39470993018](https://github.com/nickderobertis/onetaskgraph/actions/runs/39470993018), `check (ubuntu-latest)` passed at `4301126d`. The [Windows job](https://github.com/nickderobertis/onetaskgraph/actions/runs/39470993018/job/118794892841) failed in both cache-budget suites: GitHub Projects could not attach to the simulated clock (`os error 10055`, insufficient socket buffer space or a full queue), while Linear could not reach its loopback GraphQL server. Linux tracing at `4301126d` and merge base `ffd9bf37` found 4,442 store invocations for GitHub Projects on both trees, with 24,828 loopback connections on the branch versus 24,827 and 24,833 in two base runs. Linear made 4,608 invocations and 10,439 loopback connections on both trees. Both journeys passed on both trees; the additional base GitHub run passed too. Socket exhaustion is likely but unproven. The harness remains unchanged, with a follow-up recording the evidence.\n\nThat run's macOS job failed `sdk-typescript:coverage` on a different test, `templateVariables reads the declared set down the chain with its digest`, after its 60-second timeout; the flag-spelling test passed there. At `4301126d`, `sdk-typescript:test --skip-nx-cache` passed all 79 tests with an empty configuration home and host source variables unset. Both named tests also passed individually. With the host configuration inherited, 14 of 79 tests failed; configuration isolation is recorded as a follow-up. These results do not establish that the failed CI jobs subsequently passed.\n\nRecorded local verification passed 1,164 core and e2e tests at `29157bd3`, plus clippy for core, e2e and Linear e2e. After adding five member-reuse edge-case journeys, all 684 e2e tests passed on the content committed as `1a749d37`. The routing-comment change `133a2140` passed all 55 routing journeys, formatting, e2e clippy and `just lint-llm-diff` (21 passed, zero failed; history `20261020T112726Z-93717`). Those are historical runs, not fresh full-suite results at final head. The subsequent live-journey changes passed formatting and GitHub Projects e2e clippy; the final diff-scoped judged lint passed with 21 rules passed and zero failed (history `20261020T170153Z-df10c`).\n\nThe earlier [required-check refusal](https://github.com/nickderobertis/onetaskgraph/actions/runs/39345044633/job/118375581571) was a GitHub Projects live session declining because the account's shared GraphQL allowance was too low: response headers reported 1,239 of 5,000 remaining, leaving 913 where 1,000 was required. The session did not run and tested nothing; this is not evidence of a passing check or a code failure. The prior description records that main's `6dff0147` selected that crate through CI's merge ref. The branch includes merges of `origin/main`; no code change addresses that budget decline.","created_at":"2026-10-19T22:53:47Z","updated_at":"2026-10-20T21:23:20Z","closed_at":"2026-10-20T21:23:18Z","merged_at":"2026-10-20T21:23:18Z","merge_commit_sha":"03e9079144695e1810dc407e5ce4ef6e93be3d6c","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3685/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3685/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3685/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/statuses/4301126d903c0b1c9995e0ebb438921281dbf87c","head":{"label":"nickderobertis:nick/3683/otg-home-placement","ref":"nick/3683/otg-home-placement","sha":"4301126d903c0b1c9995e0ebb438921281dbf87c","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1343250630,"node_id":"R_kgDOUBBgxg","name":"onetaskgraph","full_name":"nickderobertis/onetaskgraph","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public"