0155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onetaskgraph/pulls/3791","id":5044411799,"node_id":"PR_kwDOUBBgxs8AAAABLKudlw","html_url":"https://github.com/nickderobertis/onetaskgraph/pull/3791","diff_url":"https://github.com/nickderobertis/onetaskgraph/pull/3791.diff","patch_url":"https://github.com/nickderobertis/onetaskgraph/pull/3791.patch","issue_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/issues/3791","number":3791,"state":"closed","locked":false,"title":"feat(locate): answer where an item lands, its counterpart and its issue's repository","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nAdd read-only `task locate` to the CLI and both SDKs, reporting classification, routed destination, counterpart and creation repository through copy’s shared placement and lookup paths. Support known counterparts with `--target-native` and skipping counterpart lookup with `--no-counterpart`, without writes or boundary write checks.\n\nExpose reachable destinations through `sources route` and creation repositories through a defaulted plugin method. Include generated SDK models, structured SDK failures, documentation and journeys comparing locate’s answers with subsequent copies.\n\n## Why\n\nTools filing work need the store’s own answer about where an item belongs, which counterpart to update and where a new issue would be filed. Answering from the item lets callers remove duplicated classification, routing and lookup rules that drift as the store changes and can send private work’s lookup to the wrong destination.","created_at":"2026-10-28T02:53:45Z","updated_at":"2026-10-28T08:02:52Z","closed_at":"2026-10-28T08:02:50Z","merged_at":"2026-10-28T08:02:50Z","merge_commit_sha":"1e027053cc1182d73ba72d42f046c13804b95707","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/p