%2Frelease-tail%2Frecordings%2Freleases-listing-unauthorized.http.source.json","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/c6adfa0d0fa7eaa7bc4f3588364d003fd893f418/.github%2Fpolicy%2Ftests%2Ffixtures%2Frelease-tail%2Frecordings%2Freleases-listing-unauthorized.http.source.json","contents_url":"https://api.github.com/repos/nickderobertis/onetaskgraph/contents/.github%2Fpolicy%2Ftests%2Ffixtures%2Frelease-tail%2Frecordings%2Freleases-listing-unauthorized.http.source.json?ref=c6adfa0d0fa7eaa7bc4f3588364d003fd893f418","patch":"@@ -0,0 +1,15 @@\n+{\n+  \"path\": \"repos/nickderobertis/onetaskgraph/releases?per_page=100\",\n+  \"fetched_from\": {\n+    \"release\": \"v0.12.13\",\n+    \"read\": \"the releases listing, answered 401 under an invalid token\"\n+  },\n+  \"repository\": \"nickderobertis/onetaskgraph\",\n+  \"recorded\": {\n+    \"at\": \"Sat, 31 Oct 2026 15:59:15 GMT\",\n+    \"with\": \"gh api --include --method GET 'repos/nickderobertis/onetaskgraph/releases?per_page=100' under an invalid token\",\n+    \"read_only\": true,\n+    \"as\": \"exactly what gh printed: the status line, every response header and the body, unedited\"\n+  },\n+  \"why\": \"The error status a GitHub read can answer, recorded from this repository rather than written: the release tail must exit non-zero on it, never report a figure.\"\n+}"},{"sha":"a04599b9d3c5739f8fdb5c8748dbbbe51ac9817c","filename":".github/policy/tests/fixtures/release-tail/recordings/releases-listing.http","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/nickderobertis/onetaskgraph/blob/c6adfa0d0fa7eaa7bc4f3588364d003fd893f418/.github%2Fpolicy%2Ftests%2Ffixtures%2Frelease-tail%2Frecordings%2Freleases-listing.http","raw_url":"https://github.com/nickderobertis/onetaskgraph/raw/c6adfa0d0fa7eaa7bc4f3588364d003fd893f418/.github%2Fpolicy%2Ftests%2Ffixtures%2Frelease-tail%2Frecordings%2Freleases-listing.http","contents_url":"https://api.github.com/repos/nickderober