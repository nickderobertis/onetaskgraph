{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "github-workflow-policy",
  "projectType": "library",
  "tags": ["lang:javascript", "layer:workspace"],
  "//": "Nx gives a file to the project whose root holds it, so the workflow policy journeys and the macOS budgets live under this root: a crate or SDK edit selects github-workflows' CD journeys without them. tests/inventory.test.mjs reconciles both projects' commands, read sets, inventory and selection, here, where any .github edit selects it. llmlint: ignore-file[external_service_suite_stays_out_of_the_affected_tier] rust-cache-action's journey reads the pinned rust-cache revision's public source from GitHub anonymously — the read every workflow run that uses the action makes — with no credential and no write, so it is not a hosted service suite; it moved here unchanged from github-workflows' test target, which carries the same reasoned exception, and AGENTS.md keeps tests that reach something real inside the required check rather than in a tier a merge does not wait on. JSON has no comment to scope this to that one target.",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/.github/**/*",
      "!{workspaceRoot}/.github/node_modules/**/*",
      "!{workspaceRoot}/.github/.telemetry/**/*",
      "!{workspaceRoot}/.github/linear-documents-policy/**/*",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/screencomp.toml",
      "{workspaceRoot}/scripts/product_versions.py",
      "{workspaceRoot}/scripts/release_products.py",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/scripts/ci-job.sh",
      "{workspaceRoot}/scripts/project.json",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/scripts/check-distribution-contract.sh",
      "{workspaceRoot}/scripts/check-distribution-contract-enforced.sh",
      "{workspaceRoot}/scripts/check-release-packaging.sh",
      "{workspaceRoot}/scripts/check-release-targets.sh",
      "{workspaceRoot}/scripts/check-release-probe.sh",
      "{workspaceRoot}/scripts/check-crate-sibling-resolution.sh",
      "{workspaceRoot}/scripts/check-crate-sibling-resolution-same-second.sh",
      "{workspaceRoot}/scripts/check-store-fixtures.sh",
      "{workspaceRoot}/scripts/check-store-fixtures-enforced.sh",
      "{workspaceRoot}/scripts/check-release-pr-sync.sh",
      "{workspaceRoot}/scripts/check-release-tooling-selection.sh",
      "{workspaceRoot}/scripts/check-real-release-preparation.sh",
      "{workspaceRoot}/scripts/check-npm-publish.sh",
      "{workspaceRoot}/scripts/check-fixture-discrimination.sh"
    ],
    "releaseTail": [
      "{workspaceRoot}/.github/workflows/release.yml",
      "{workspaceRoot}/.github/workflows/rust-cache-warm.yml",
      "{projectRoot}/tests/release-tail.test.mjs",
      "{projectRoot}/tests/fixtures/release-tail/**/*",
      "{workspaceRoot}/.github/package.json",
      "{workspaceRoot}/.github/bun.lock",
      "{workspaceRoot}/budgets.yaml",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/scripts/actions-budget-figures.sh"
    ]
  },
  "targets": {
    "bootstrap": {
      "executor": "nx:noop",
      "dependsOn": ["github-workflows:bootstrap"]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "coverage", "budgets"]
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format .github/policy"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome lint --error-on-warnings .github/policy"
      }
    },
    "policy-tests": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap"],
      "options": {
        "command": "node --test .github/policy/tests/boundaries.test.mjs .github/policy/tests/inventory.test.mjs .github/policy/tests/policy-routing.test.mjs .github/policy/tests/policy.test.mjs .github/policy/tests/release-shortcut.test.mjs .github/policy/tests/reusable.test.mjs .github/policy/tests/rust-cache-warm.test.mjs"
      },
      "cache": false,
      "outputs": ["{workspaceRoot}/.github/.telemetry/macos-policy.json"]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["policy-tests", "rust-cache-action", "release-tail"],
      "cache": false
    },
    "budgets": {
      "executor": "nx:run-commands",
      "dependsOn": ["test"],
      "options": {
        "command": "bun run onebudgetspec check .github/policy/budgets.yaml"
      },
      "cache": false
    },
    "coverage": {
      "executor": "nx:noop",
      "//": "Private declarative workflow policy is verified by executable assertions and real Nx selection; it adds no separate runtime coverage metric."
    },
    "rust-cache-action": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap"],
      "options": {
        "command": "node --test .github/policy/tests/rust-cache.test.mjs"
      },
      "cache": false,
      "//": "The one policy journey that runs the real rust-cache action, which also runs on the Windows and macOS runners; test-windows and test-macos run this target alone, and test-linux runs it with the rest of `test`."
    },
    "release-tail": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap"],
      "options": {
        "command": "node --test .github/policy/tests/release-tail.test.mjs"
      },
      "inputs": ["releaseTail"],
      "cache": true,
      "//": "publish's release tail: its install step and its last step run as release.yml writes them over GitHub answers recorded from this repository (tests/fixtures/release-tail/). Here, in the project no crate or SDK edit selects, and a target of its own keyed on its reads alone, because it installs onevcs and onebudgetspec from npm."
    }
  }
}
