{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "github-workflow-policy",
  "projectType": "library",
  "tags": ["lang:javascript", "layer:workspace"],
  "//": "Nx gives a file to the project whose root holds it, so the workflow policy journeys and the macOS budgets live under this root: a crate or SDK edit selects github-workflows' CD journeys without them. tests/inventory.test.mjs reconciles both projects' commands, read sets, inventory and selection, here, where any .github edit selects it.",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/.github/**/*",
      "!{workspaceRoot}/.github/node_modules/**/*",
      "!{workspaceRoot}/.github/.telemetry/**/*",
      "!{workspaceRoot}/.github/linear-documents-policy/**/*",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/screencomp.toml",
      "{workspaceRoot}/scripts/product_versions.py",
      "{workspaceRoot}/scripts/release_products.py",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/scripts/ci-job.sh",
      "{workspaceRoot}/scripts/project.json",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/scripts/check-*.sh"
    ]
  },
  "targets": {
    "bootstrap": {
      "executor": "nx:noop",
      "dependsOn": ["github-workflows:bootstrap"]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "coverage", "budgets"]
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format .github/policy"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome lint --error-on-warnings .github/policy"
      }
    },
    "policy-tests": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap"],
      "options": {
        "command": "node --test .github/policy/tests/boundaries.test.mjs .github/policy/tests/inventory.test.mjs .github/policy/tests/policy-carriers.test.mjs .github/policy/tests/policy-routing.test.mjs .github/policy/tests/policy.test.mjs .github/policy/tests/release-shortcut.test.mjs .github/policy/tests/reusable.test.mjs .github/policy/tests/rust-cache-warm.test.mjs"
      },
      "cache": false,
      "outputs": ["{workspaceRoot}/.github/.telemetry/macos-policy.json"]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["policy-tests", "rust-cache-action"],
      "cache": false
    },
    "budgets": {
      "executor": "nx:run-commands",
      "dependsOn": ["test"],
      "options": {
        "command": "bun run onebudgetspec check .github/policy/budgets.yaml"
      },
      "cache": false
    },
    "coverage": {
      "executor": "nx:noop",
      "//": "Private declarative workflow policy is verified by executable assertions and real Nx selection; it adds no separate runtime coverage metric."
    },
    "rust-cache-action": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap"],
      "options": {
        "command": "node --test .github/policy/tests/rust-cache.test.mjs"
      },
      "cache": false,
      "//": "The one policy journey that runs the real rust-cache action, which also runs on the Windows and macOS runners; test-windows and test-macos run this target alone, and test-linux runs it with the rest of `test`."
    }
  }
}
