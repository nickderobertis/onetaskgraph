{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "github-workflows",
  "projectType": "library",
  "tags": ["lang:javascript", "layer:workspace"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/node_modules/**/*",
      "!{projectRoot}/.telemetry/**/*"
    ],
    "workflowGraph": [
      "default",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/screencomp.toml",
      "{workspaceRoot}/scripts/product_versions.py",
      "{workspaceRoot}/scripts/release_products.py"
    ],
    "cdJourneys": [
      "default",
      "{workspaceRoot}/config/github-interfaces.toml",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/release-plz.toml",
      "{workspaceRoot}/npm/**/*",
      "{workspaceRoot}/scripts/release_cd.py",
      "{workspaceRoot}/scripts/cli_wheel_lock.py",
      "{workspaceRoot}/scripts/test-distribution.sh",
      "{workspaceRoot}/scripts/file-lock.sh",
      "{workspaceRoot}/scripts/verify-release-products.py",
      "{workspaceRoot}/scripts/release-wheel-binary.py",
      "{workspaceRoot}/scripts/loopback-release-registries.py",
      "{workspaceRoot}/scripts/enable-release-automerge.py",
      "{workspaceRoot}/scripts/publish-npm.sh",
      "{workspaceRoot}/scripts/npm-registry-auth.sh",
      "{workspaceRoot}/scripts/install.sh",
      "{workspaceRoot}/scripts/crate-publication-status.sh",
      "{workspaceRoot}/scripts/crate-sibling-resolution.sh",
      "{workspaceRoot}/scripts/prepare-release-pr.sh",
      "{workspaceRoot}/scripts/select-release-version.sh",
      "{workspaceRoot}/scripts/scoped-release-plz.sh",
      "{workspaceRoot}/scripts/set-version.sh",
      "{workspaceRoot}/scripts/scratch-clone.sh",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/crates/**/*",
      "{workspaceRoot}/sdks/**/*",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/LICENSE",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/package.json"
    ],
    "policyJourneys": ["workflowGraph", "{workspaceRoot}/bun.lock"]
  },
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "just github-workflows-bootstrap"
      }
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "typecheck", "coverage", "budgets"]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format --write .github"
      },
      "cache": false
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format .github"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["bun run biome lint --error-on-warnings .github"],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc -p .github/tsconfig.json"
      }
    },
    "ci-jobs": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap"],
      "options": {
        "command": "node --test .github/tests/ci-jobs.spec.mjs"
      },
      "inputs": ["default"],
      "cache": true,
      "//": "The pull request's four jobs, their keyed caches and the Rust cache warmer, read from the workflow files alone: keyed on this directory alone, it imports nothing that reads outside it, which the spec itself refuses. Whether today's required contexts are still reported needs the run graph, which reads files outside it, and is ci-contexts'."
    },
    "ci-contexts": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap"],
      "options": {
        "command": "node --test .github/tests/ci-contexts.spec.mjs"
      },
      "inputs": ["workflowGraph"],
      "cache": true,
      "//": "The required contexts use the workflow graph read set. This spec also reconciles each journey target with its own external reads and the complete test-file inventory."
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["ci-jobs", "ci-contexts", "policy-tests", "cd-journeys"],
      "cache": false
    },
    "budgets": {
      "executor": "nx:run-commands",
      "dependsOn": ["test"],
      "options": {
        "command": "bun run onebudgetspec check .github/budgets.yaml"
      },
      "cache": false,
      "inputs": ["workflowGraph"]
    },
    "coverage": {
      "executor": "nx:noop",
      "//": "Declared empty to preserve the repository standard target inventory, as scripts:coverage does; this private workflow tooling has executable subprocess and graph contracts but no separate coverage metric or new product coverage threshold."
    },
    "policy-tests": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap"],
      "options": {
        "command": "node --test .github/tests/boundaries.test.mjs .github/tests/policy-carriers.test.mjs .github/tests/policy-routing.test.mjs .github/tests/policy.test.mjs .github/tests/release-shortcut.test.mjs .github/tests/reusable.test.mjs"
      },
      "cache": false,
      "outputs": ["{projectRoot}/.telemetry/macos-policy.json"],
      "inputs": ["policyJourneys"]
    },
    "cd-journeys": {
      "executor": "nx:run-commands",
      "dependsOn": ["bootstrap"],
      "options": {
        "command": "node --test .github/tests/github-interfaces.test.mjs .github/tests/release-cd.test.mjs .github/tests/release-plz.test.mjs .github/tests/release.test.mjs"
      },
      "cache": false,
      "inputs": ["workflowGraph", "cdJourneys"]
    }
  },
  "//": "llmlint: ignore-file[projects_stay_in_one_js_workspace,external_service_suite_stays_out_of_the_affected_tier] The task requires this private workflow-tooling project and lockfile to stay isolated from public SDK dependency resolution; its bootstrap installs only YAML, Actions expressions and budget reporting in .github. Its cdJourneys input names the release plumbing the CD journeys under tests/ drive \u2014 scripts/release_cd.py and every script and manifest a CD job runs (including the justfile the real release recipes read, plus the crates and SDK sources the release builds and packages) \u2014 so a change to how a release is produced selects them, while graph-only checks retain their narrower workflow inputs. The CD journeys' crate publication reads index.crates.io and static.crates.io without a credential \u2014 the public reads every cargo build in the affected tier already makes for its dependencies \u2014 through the double's index proxy and cargo's own verification build; they write only to loopback doubles, and dropping cargo's verification build to avoid them would stop proving each crate builds with its siblings resolved from a registry. JSON has no comment to scope this to the test target."
}
