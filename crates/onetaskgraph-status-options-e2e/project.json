{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "onetaskgraph-status-options-e2e",
  "projectType": "application",
  "tags": ["lang:rust", "layer:e2e", "test-in-coverage:crate"],
  "//": "A test-only member holding only tests/, which spawn the binary onetaskgraph:build made. Its implicitDependencies are the plugin crate it exercises, so a change to that plugin selects it and a change to a sibling plugin does not; the binary, the engine and the shared harness it also exercises are named in its own `default` named input instead, which Nx treats as touching this project when they change without the graph edge that would make every plugin's change select it through them. scripts/check-nx-graph.sh reconciles both halves against the Cargo graph, and scripts/check-affected-selection.sh proves the selection against real Nx.",
  "implicitDependencies": ["onetaskgraph-status-options"],
  "namedInputs": {
    "cargoInputs": [
      {
        "runtime": "node scripts/nx-cargo-closure.mjs --crate onetaskgraph-status-options-e2e --crate onetaskgraph"
      }
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/Cargo.toml",
      "sharedGlobals",
      "{workspaceRoot}/crates/onetaskgraph/**/*",
      "!{workspaceRoot}/crates/onetaskgraph/CHANGELOG.md",
      "!{workspaceRoot}/crates/onetaskgraph/Cargo.toml",
      "{workspaceRoot}/crates/onetaskgraph-core/**/*",
      "!{workspaceRoot}/crates/onetaskgraph-core/CHANGELOG.md",
      "!{workspaceRoot}/crates/onetaskgraph-core/Cargo.toml",
      "{workspaceRoot}/crates/onetaskgraph-e2e-support/**/*",
      "!{workspaceRoot}/crates/onetaskgraph-e2e-support/Cargo.toml",
      "{workspaceRoot}/crates/onetaskgraph-in-memory/**/*",
      "!{workspaceRoot}/crates/onetaskgraph-in-memory/CHANGELOG.md",
      "!{workspaceRoot}/crates/onetaskgraph-in-memory/Cargo.toml",
      "cargoInputs"
    ]
  },
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --locked"
      },
      "//": "Uncached: it reaches the network and writes to the shared cargo registry outside the workspace, so no input in the tree describes its result."
    },
    "check": {
      "executor": "nx:noop"
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-status-options-e2e"
      },
      "cache": false,
      "//": "Uncached: it rewrites the tree in place, so replaying a cached result would be a no-op that silently leaves the tree unformatted."
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-status-options-e2e -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --quiet -p onetaskgraph-status-options-e2e --all-targets --all-features --locked -- -D warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --quiet -p onetaskgraph-status-options-e2e --all-targets --all-features --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --quiet -p onetaskgraph-status-options-e2e --all-features --locked"
      },
      "dependsOn": ["onetaskgraph:build"],
      "//": "Spawns target/debug/onetaskgraph, which onetaskgraph:build alone produces and this target depends on; it never builds the onetaskgraph package itself, so it cannot relink the file another spawner is running. scripts/check-workspace-config.sh holds the arrangement."
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["onetaskgraph:coverage-build"],
      "options": {
        "command": "bash scripts/rust-coverage.sh onetaskgraph-status-options-e2e"
      },
      "outputs": ["{workspaceRoot}/target/coverage-units/onetaskgraph-status-options-e2e.lcov"],
      "cache": true,
      "//": "A coverage unit: its LCOV report is cached, and workspace:coverage merges every unit's and holds the floor. scripts/check-coverage-enforced.sh reconciles the unit with that merge, and .github/nx-policy/tests/coverage-units.test.mjs holds these inputs to every file the run reads. It reaches the instrumented binary through onetaskgraph:coverage-build, never through onetaskgraph:coverage's run, so the journeys find it when that unit replays.",
      "inputs": [
        "versionFreeNpm",
        "{workspaceRoot}/.tool-versions",
        "{projectRoot}/**/*",
        "!{projectRoot}/Cargo.toml",
        "!{projectRoot}/CHANGELOG.md",
        "sharedGlobals",
        "cargoInputs",
        "{workspaceRoot}/crates/onetaskgraph/src/**/*",
        "{workspaceRoot}/crates/onetaskgraph/build.rs",
        "{workspaceRoot}/crates/onetaskgraph-core/src/**/*",
        "{workspaceRoot}/crates/onetaskgraph-core/build.rs",
        "{workspaceRoot}/crates/onetaskgraph-github-projects/src/**/*",
        "{workspaceRoot}/crates/onetaskgraph-github-projects/build.rs",
        "{workspaceRoot}/crates/onetaskgraph-in-memory/src/**/*",
        "{workspaceRoot}/crates/onetaskgraph-in-memory/build.rs",
        "{workspaceRoot}/crates/onetaskgraph-linear/src/**/*",
        "{workspaceRoot}/crates/onetaskgraph-linear/build.rs",
        "{workspaceRoot}/crates/onetaskgraph-local-md/src/**/*",
        "{workspaceRoot}/crates/onetaskgraph-local-md/build.rs",
        "{workspaceRoot}/crates/onetaskgraph-plugin-api/src/**/*",
        "{workspaceRoot}/crates/onetaskgraph-plugin-api/build.rs",
        "{workspaceRoot}/crates/onetaskgraph-status-options/src/**/*",
        "{workspaceRoot}/crates/onetaskgraph-status-options/build.rs",
        "^coverageDependency",
        "coverageUnit",
        "{workspaceRoot}/crates/onetaskgraph-github-projects/tests/github_schema/**/*",
        "{workspaceRoot}/crates/onetaskgraph-github-projects/tests/fixtures/**/*",
        "{workspaceRoot}/crates/onetaskgraph-linear/tests/fixtures/**/*",
        "{workspaceRoot}/scripts/live-crate-test.sh",
        "coverageSdkSources"
      ]
    }
  }
}
