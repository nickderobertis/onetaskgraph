{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "onetaskgraph-github-live",
  "projectType": "library",
  "tags": ["lang:rust", "layer:testing", "test-in-coverage:crate"],
  "//": "The GitHub Projects lane's own names, which its tests and the scheduled janitor read. It depends only on onetaskgraph-live; the GitHub Projects plugin names it as a dev-dependency, so editing it selects that plugin and the janitor and nothing of Linear.",
  "namedInputs": {
    "cargoInputs": [
      {
        "runtime": "node scripts/nx-cargo-closure.mjs --crate onetaskgraph-github-live"
      }
    ]
  },
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --locked"
      },
      "//": "Uncached: it reaches the network and writes to the shared cargo registry outside the workspace, so no input in the tree describes its result."
    },
    "check": {
      "executor": "nx:noop"
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-github-live"
      },
      "cache": false,
      "//": "Uncached: it rewrites the tree in place, so replaying a cached result would be a no-op that silently leaves the tree unformatted."
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-github-live -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --quiet -p onetaskgraph-github-live --all-targets --all-features --locked -- -D warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --quiet -p onetaskgraph-github-live --all-targets --all-features --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --quiet -p onetaskgraph-github-live --all-features --locked"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/rust-coverage.sh onetaskgraph-github-live"
      },
      "outputs": ["{workspaceRoot}/target/coverage-units/onetaskgraph-github-live.lcov"],
      "cache": true,
      "//": "A coverage unit: its LCOV report is cached, and workspace:coverage merges every unit's and holds the floor. scripts/check-coverage-enforced.sh reconciles the unit with that merge, and .github/nx-policy/tests/coverage-units.test.mjs holds these inputs to every file the run reads.",
      "inputs": [
        "versionFreeNpm",
        "default",
        "^coverageDependency",
        "coverageUnit",
        "{workspaceRoot}/.tool-versions",
        {
          "runtime": "node scripts/coverage-read-digest.mjs --unit onetaskgraph-github-live"
        }
      ]
    }
  },
  "implicitDependencies": ["onetaskgraph-live"]
}
