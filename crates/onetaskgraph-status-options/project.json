{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "onetaskgraph-status-options",
  "projectType": "library",
  "tags": ["lang:rust", "layer:plugin-operation"],
  "//": "implicitDependencies mirror this crate's Cargo dependencies; scripts/check-nx-graph.sh fails when the two disagree. llmlint: ignore-file[expensive_tests_stay_behind_their_own_edge] JSON has no comment to scope this to `coverage`: the line floor is one report over every crate's instrumented run, so workspace:coverage runs this crate's whether or not the change reached it. `test` still selects by the graph.",
  "implicitDependencies": ["onetaskgraph-github-projects", "onetaskgraph-plugin-api"],
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo fetch --locked" },
      "cache": false
    },
    "check": { "executor": "nx:noop" },
    "format": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo fmt -p onetaskgraph-status-options" },
      "cache": false
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo fmt -p onetaskgraph-status-options -- --check" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --quiet -p onetaskgraph-status-options --all-targets --all-features --locked -- -D warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --quiet -p onetaskgraph-status-options --all-targets --all-features --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --quiet -p onetaskgraph-status-options --all-features --locked"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["workspace:coverage-clear"],
      "options": {
        "command": "bash scripts/rust-coverage.sh onetaskgraph-status-options"
      },
      "outputs": ["{workspaceRoot}/target/llvm-cov-target/*.profraw"],
      "cache": false,
      "//": "Uncached: cargo-llvm-cov names every raw profile after the workspace, not the crate, so a cache hit would restore a sibling's stale profiles beside its own. workspace:coverage enforces the floor over every crate's run."
    }
  }
}
