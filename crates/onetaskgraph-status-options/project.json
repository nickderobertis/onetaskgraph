{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "onetaskgraph-status-options",
  "projectType": "library",
  "tags": ["lang:rust", "layer:plugin-operation", "test-in-coverage:crate"],
  "//": "implicitDependencies mirror this crate's Cargo dependencies; scripts/check-nx-graph.sh fails when the two disagree. llmlint: ignore-file[expensive_tests_stay_behind_their_own_edge] JSON has no comment to scope this to `coverage`: the line floor is one report over every crate's instrumented run, so workspace:coverage runs this crate's whether or not the change reached it. `test` still selects by the graph.",
  "implicitDependencies": ["onetaskgraph-github-projects", "onetaskgraph-plugin-api"],
  "namedInputs": {
    "cargoInputs": [
      {
        "runtime": "node scripts/nx-cargo-closure.mjs --crate onetaskgraph-status-options"
      }
    ]
  },
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --locked"
      },
      "cache": false
    },
    "check": {
      "executor": "nx:noop"
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-status-options"
      },
      "cache": false
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-status-options -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --quiet -p onetaskgraph-status-options --all-targets --all-features --locked -- -D warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --quiet -p onetaskgraph-status-options --all-targets --all-features --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --quiet -p onetaskgraph-status-options --all-features --locked"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/rust-coverage.sh onetaskgraph-status-options"
      },
      "outputs": ["{workspaceRoot}/target/coverage-units/onetaskgraph-status-options.lcov"],
      "cache": true,
      "//": "A coverage unit: its LCOV report is cached, and workspace:coverage merges every unit's and holds the floor. scripts/check-coverage-enforced.sh reconciles the unit with that merge, and .github/nx-policy/tests/coverage-units.test.mjs holds these inputs to every file the run reads.",
      "inputs": [
        "versionFreeNpm",
        "default",
        "^coverageDependency",
        "coverageUnit",
        "{workspaceRoot}/.tool-versions",
        {
          "runtime": "node scripts/coverage-read-digest.mjs --unit onetaskgraph-status-options"
        }
      ]
    }
  }
}
