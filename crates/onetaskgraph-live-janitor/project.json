{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "onetaskgraph-live-janitor",
  "projectType": "library",
  "tags": ["lang:rust", "layer:testing"],
  "//": "Unpublished scheduled cleanup executable. Test and coverage invoke offline tests only; neither runs the janitor against GitHub.",
  "namedInputs": {
    "cargoInputs": [
      {
        "runtime": "node scripts/nx-cargo-closure.mjs --crate onetaskgraph-live-janitor"
      }
    ]
  },
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --locked"
      },
      "//": "Uncached: it reaches the network and writes to the shared cargo registry outside the workspace, so no input in the tree describes its result."
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "typecheck", "test", "coverage", "budgets"]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-live-janitor"
      },
      "cache": false,
      "//": "Uncached: it rewrites the tree in place, so replaying a cached result would be a no-op that silently leaves the tree unformatted."
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-live-janitor -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --quiet -p onetaskgraph-live-janitor --all-targets --all-features --locked -- -D warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --quiet -p onetaskgraph-live-janitor --all-targets --all-features --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --quiet -p onetaskgraph-live-janitor --all-features --locked"
      },
      "outputs": ["{workspaceRoot}/target/debug/telemetry/onetaskgraph-live-janitor/*.json"]
    },
    "coverage": {
      "//": "llmlint: ignore-block[expensive_tests_stay_behind_their_own_edge] The required coverage union runs every crate's instrumented tests, including this offline suite, when its own inputs change; scripts/check-coverage-enforced.sh reconciles every crate against that union; functional tests still select by the graph. A coverage unit: its LCOV report is cached, and workspace:coverage merges every unit's and holds the floor. scripts/check-coverage-enforced.sh reconciles the unit with that merge, and .github/nx-policy/tests/coverage-units.test.mjs holds these inputs to every file the run reads. Its outputs also carry the telemetry `budgets` reads, which its journeys write here (scripts/ci-job.sh).",
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/rust-coverage.sh onetaskgraph-live-janitor"
      },
      "outputs": [
        "{workspaceRoot}/target/coverage-units/onetaskgraph-live-janitor.lcov",
        "{workspaceRoot}/target/debug/telemetry/onetaskgraph-live-janitor/*.json"
      ],
      "cache": true,
      "// end": "llmlint: ignore-end[expensive_tests_stay_behind_their_own_edge]",
      "inputs": [
        "versionFreeNpm",
        "default",
        "^coverageDependency",
        "coverageUnit",
        "{workspaceRoot}/.tool-versions",
        {
          "runtime": "node scripts/coverage-read-digest.mjs --unit onetaskgraph-live-janitor"
        }
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --quiet -p onetaskgraph-live-janitor --locked"
      },
      "outputs": ["{workspaceRoot}/target/debug/onetaskgraph-live-janitor"]
    },
    "budget-check": {
      "executor": "nx:noop",
      "dependsOn": ["budgets"]
    },
    "budgets": {
      "executor": "nx:run-commands",
      "dependsOn": ["test"],
      "options": {
        "command": "bun run onebudgetspec check crates/onetaskgraph-live-janitor/budgets.yaml --save-results target/budget-results/onetaskgraph-live-janitor-budget-results.json"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "dependentTasksOutputFiles": "**/telemetry/onetaskgraph-live-janitor/*.json"
        },
        {
          "runtime": "node -p process.platform"
        },
        "versionFreeNpm",
        "{workspaceRoot}/.tool-versions"
      ],
      "//": "Judges the request count recorded by the offline test, on every platform. The cache includes the measured code, telemetry and onebudgetspec pins.",
      "outputs": [
        "{workspaceRoot}/target/budget-results/onetaskgraph-live-janitor-budget-results.json"
      ]
    }
  },
  "// ownership": "llmlint: ignore-block[new_command_or_client_gets_its_own_project] The existing scheduled janitor owns both hosted sweeps; this dependency mirrors its GitHub plugin dependency rather than introducing another scheduled command.",
  "implicitDependencies": [
    "onetaskgraph-live",
    "onetaskgraph-linear",
    "onetaskgraph-github-live",
    "onetaskgraph-github-projects"
  ],
  "// ownership end": "llmlint: ignore-end[new_command_or_client_gets_its_own_project]"
}
