{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "onetaskgraph-e2e-support",
  "projectType": "library",
  "tags": ["lang:rust", "layer:testing", "test-in-coverage:crate"],
  "//": "The harness every e2e suite shares; implicitDependencies mirror its Cargo dependencies, as every crate's do. It is never a graph dependency of a plugin suite, which names it in its `default` input instead, because its edges reach both hosted plugins.",
  "implicitDependencies": [
    "onetaskgraph-github-projects",
    "onetaskgraph-linear",
    "onetaskgraph-plugin-api"
  ],
  "namedInputs": {
    "cargoInputs": [
      {
        "runtime": "node scripts/nx-cargo-closure.mjs --crate onetaskgraph-e2e-support"
      }
    ]
  },
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --locked"
      },
      "//": "Uncached: it reaches the network and writes to the shared cargo registry outside the workspace, so no input in the tree describes its result."
    },
    "check": {
      "executor": "nx:noop"
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-e2e-support"
      },
      "cache": false,
      "//": "Uncached: it rewrites the tree in place, so replaying a cached result would be a no-op that silently leaves the tree unformatted."
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-e2e-support -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --quiet -p onetaskgraph-e2e-support --all-targets --all-features --locked -- -D warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --quiet -p onetaskgraph-e2e-support --all-targets --all-features --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --quiet -p onetaskgraph-e2e-support --all-features --locked"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/rust-coverage.sh onetaskgraph-e2e-support"
      },
      "outputs": ["{workspaceRoot}/target/coverage-units/onetaskgraph-e2e-support.lcov"],
      "cache": true,
      "//": "A coverage unit: its LCOV report is cached, and workspace:coverage merges every unit's and holds the floor. scripts/check-coverage-enforced.sh reconciles the unit with that merge, and .github/nx-policy/tests/coverage-units.test.mjs holds these inputs to every file the run reads.",
      "inputs": [
        "versionFreeNpm",
        "{workspaceRoot}/.tool-versions",
        "default",
        "^coverageDependency",
        "coverageUnit",
        "{workspaceRoot}/crates/onetaskgraph-github-projects/tests/github_schema/**/*",
        "{workspaceRoot}/crates/onetaskgraph-github-projects/tests/fixtures/**/*",
        "{workspaceRoot}/crates/onetaskgraph-linear/tests/fixtures/**/*",
        "{workspaceRoot}/scripts/live-crate-test.sh",
        "coverageSdkSources"
      ]
    }
  }
}
