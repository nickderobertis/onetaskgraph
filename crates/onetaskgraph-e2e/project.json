{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "onetaskgraph-e2e",
  "projectType": "application",
  "tags": ["lang:rust", "layer:e2e", "test-in-coverage:crate"],
  "//": "A test-only member holding only tests/, which spawn the binary onetaskgraph:build made: the engine's and the command line's own journeys. Its implicitDependencies are its Cargo dependencies and the crates the binary it drives links, so any change the engine or the binary can see selects it; the binary itself is named in its `default` named input, since a package with only binaries cannot be a Cargo dependency. scripts/check-nx-graph.sh reconciles both against the Cargo graph.",
  "implicitDependencies": [
    "onetaskgraph-core",
    "onetaskgraph-e2e-support",
    "onetaskgraph-github-projects",
    "onetaskgraph-linear",
    "onetaskgraph-plugin-api",
    "onetaskgraph-status-options"
  ],
  "namedInputs": {
    "cargoInputs": [
      {
        "runtime": "node scripts/nx-cargo-closure.mjs --crate onetaskgraph-e2e --crate onetaskgraph"
      }
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/Cargo.toml",
      "sharedGlobals",
      "{workspaceRoot}/crates/onetaskgraph/**/*",
      "!{workspaceRoot}/crates/onetaskgraph/CHANGELOG.md",
      "!{workspaceRoot}/crates/onetaskgraph/Cargo.toml",
      "{workspaceRoot}/README.md",
      "cargoInputs"
    ]
  },
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --locked"
      },
      "//": "Uncached: it reaches the network and writes to the shared cargo registry outside the workspace, so no input in the tree describes its result."
    },
    "check": {
      "executor": "nx:noop"
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-e2e"
      },
      "cache": false,
      "//": "Uncached: it rewrites the tree in place, so replaying a cached result would be a no-op that silently leaves the tree unformatted."
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onetaskgraph-e2e -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --quiet -p onetaskgraph-e2e --all-targets --all-features --locked -- -D warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --quiet -p onetaskgraph-e2e --all-targets --all-features --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --quiet -p onetaskgraph-e2e --all-features --locked"
      },
      "dependsOn": ["onetaskgraph:build"],
      "//": "Spawns target/debug/onetaskgraph, which onetaskgraph:build alone produces and this target depends on; it never builds the onetaskgraph package itself, so it cannot relink the file another spawner is running. scripts/check-workspace-config.sh holds the arrangement.",
      "inputs": [
        "versionFreeNpm",
        "{workspaceRoot}/.tool-versions",
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem python --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem files --keep-version"
        }
      ]
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["workspace:coverage-clear", "onetaskgraph:coverage"],
      "options": {
        "command": "bash scripts/rust-coverage.sh onetaskgraph-e2e"
      },
      "outputs": ["{workspaceRoot}/target/llvm-cov-target/*.profraw"],
      "cache": false,
      "//": "Uncached: cargo-llvm-cov names every raw profile after the workspace, not the crate, so a cache hit would restore a sibling's stale profiles beside its own. It depends on onetaskgraph:coverage because that run is what builds the instrumented binary into target/llvm-cov-target, where these journeys find it, so its lines are attributed to the union workspace:coverage holds to the floor; this run never builds the onetaskgraph package, so it cannot relink that file while it runs.",
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "node -p process.platform"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem cargo --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem npm --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem python --keep-version"
        },
        {
          "runtime": "node scripts/nx-version-free-inputs.mjs --ecosystem files --keep-version"
        }
      ]
    }
  }
}
